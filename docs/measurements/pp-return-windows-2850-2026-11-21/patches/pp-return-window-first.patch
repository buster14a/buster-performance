+static void pp_return_block(Preprocessor* pp, uint32_t at, uint32_t length, __m512i resolved)
+{
+    PPReturnWindow* window = &pp->return_window;
+    const uint32_t end = at + length;
+    window->blocks++;
+    // A previous short keyword range (or a return at the end of a block) can leave at most two.
+    uint32_t still = 0;
+    for (uint32_t p = 0; p < window->pending_count; ++p)
+    {
+        const uint32_t t = window->pending[p];
+        if (t + 2 < end) pp_return_leaf(pp, t);
+        else window->pending[still++] = t;
+    }
+    window->pending_count = still;
+    const __mmask64 live = _bzhi_u64(UINT64_MAX, length);
+    const uint8_t keyword = BUSTER_PP_KIND_KEYWORD + C_NAME_RETURN - 1;
+    const uint64_t returns = _mm512_mask_cmpeq_epi8_mask(live, resolved, _mm512_set1_epi8((char)keyword));
+    const uint64_t hashes = _mm512_mask_cmpeq_epi8_mask(live, resolved, _mm512_set1_epi8(C_TOKEN_HASH));
+    const uint64_t ends = _mm512_mask_cmpeq_epi8_mask(live, resolved, _mm512_set1_epi8((char)BUSTER_PP_KIND_PRAGMA_END));
+    for (uint64_t events = returns | hashes | ends; events != 0; events &= events - 1)
+    {
+        const uint32_t lane = (uint32_t)__builtin_ctzll(events);
+        const uint32_t t = at + lane;
+        const uint64_t bit = UINT64_C(1) << lane;
+        if (ends & bit) window->pragma = false;
+        else if (hashes & bit) window->pragma |= pp->output.locations[t] == pp->hash_location;
+        else if (!window->pragma)
+        {
+            window->observed++;
+            if (t + 2 < end) pp_return_leaf(pp, t);
+            else window->pending[window->pending_count++] = t;
+        }
+    }
+}
