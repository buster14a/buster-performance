+// The bounded grammar accepts one ordinary identifier or a nonnegative decimal int in a return.
+static void pp_return_leaf(Preprocessor* pp, uint32_t statement)
+{
+    const PPTokens* tokens = &pp->output;
+    if (tokens->kinds[statement + 2] != C_TOKEN_SEMI) return;
+    const uint32_t leaf = statement + 1;
+    const uint8_t kind = tokens->kinds[leaf];
+    const bool name = kind == C_TOKEN_RAW_IDENTIFIER;
+    uint32_t value = tokens->values[leaf];
+    if (!name)
+    {
+        if (kind == C_TOKEN_NUMERIC_CONSTANT)
+        {
+            const uint32_t location = tokens->locations[leaf];
+            const uint32_t raw = value - location;
+            if (raw > 10 || raw == 0) return;
+            uint8_t buffer[24];
+            const uint8_t* spelling;
+            const uint32_t length = pp_spelling(pp, kind, value, location, buffer, &spelling);
+            if (length == 0 || (length != 1 && spelling[0] == '0')) return;
+            uint64_t number = 0;
+            for (uint32_t i = 0; i < length; ++i)
+            {
+                const uint32_t digit = (uint32_t)spelling[i] - '0';
+                if (digit > 9) return;
+                number = number * 10 + digit;
+            }
+            if (number > INT32_MAX) return;
+            value = (uint32_t)number;
+        }
+        else if (kind != BUSTER_PP_KIND_INTEGER || value > INT32_MAX) return;
+    }
+    PPReturnWindow* window = &pp->return_window;
+    if (window->count == window->capacity)
+    {
+        const uint32_t next = window->capacity == 0 ? 64 : 2 * window->capacity;
+        PPReturnRow* rows = realloc(window->rows, (size_t)next * sizeof(*rows));
+        if (rows == NULL)
+        {
+            window->failed = true;
+            return;
+        }
+        window->rows = rows;
+        window->capacity = next;
+    }
+    window->rows[window->count++] = (PPReturnRow){.statement = statement, .value = value, .name = name};
+}
