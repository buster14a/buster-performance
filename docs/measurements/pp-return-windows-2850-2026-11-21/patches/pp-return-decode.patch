+    if (names && parser->tokens.names[leaf] != row->value) abort();
+    // A converted return of another integer type can legitimately change the value; use only i32 here.
+    const bool literal = !names && value->type == BUSTER_TYPE_INT && value->constant_kind == CHECK_CONSTANT_INTEGER &&
+                         tape->count == 1 && tape->entries[0].class == BUSTER_TYPED_CLASS_I32 && tape->entries[0].kind == BUSTER_TYPED_CONST;
+    if (literal && (value->integer != row->value || tape->entries[0].value != row->value)) abort();
