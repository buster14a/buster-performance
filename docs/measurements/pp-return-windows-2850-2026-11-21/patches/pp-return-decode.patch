+// Attribute arguments are balanced tokens and may spell "return 3;" without a statement. Scan only
+// the contents of each attribute; a group extending beyond the available output resumes at its next token.
+static void pp_return_skip_attribute(Preprocessor* pp)
+{
+    PPReturnWindow* window = &pp->return_window;
+    const uint8_t open = window->attribute_open;
+    const uint8_t close = open == C_TOKEN_L_SQUARE ? C_TOKEN_R_SQUARE : C_TOKEN_R_PAREN;
+    for (; window->attribute_end < pp->output.count; ++window->attribute_end)
+    {
+        const uint8_t k = pp->output.kinds[window->attribute_end];
+        if (window->attribute_depth == 0 && k != open)
+        {
+            window->attribute_open = 0;
+            break;
+        }
+        window->attribute_depth += k == open;
+        window->attribute_depth -= k == close;
+        if (window->attribute_depth == 0)
+        {
+            window->attribute_end++;
+            window->attribute_open = 0;
+            break;
+        }
+    }
+}
