+        window->perturbed |= fault;
+        value->integer = published;
+        tape->entries[0].value = published;
+    }
+    if (getenv("BUSTER_TEST_PP_RETURN_REPORT") != NULL)
+        fprintf(stderr,"pp-window: source=%u leaf=%u name=%u key=%u native=%u class=%u literal=%u kind=%u type=%u\n",
+                source, parser->tokens.sources[leaf], names, row->value, tape->entries[0].kind, tape->entries[0].class, literal, value->constant_kind, value->type);
