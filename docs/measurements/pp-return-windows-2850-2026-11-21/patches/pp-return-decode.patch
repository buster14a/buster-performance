+    const uint64_t hashes = _mm512_mask_cmpeq_epi8_mask(live, resolved, _mm512_set1_epi8(C_TOKEN_HASH));
+    const uint64_t ends = _mm512_mask_cmpeq_epi8_mask(live, resolved, _mm512_set1_epi8((char)BUSTER_PP_KIND_PRAGMA_END));
+    const uint64_t squares = _mm512_mask_cmpeq_epi8_mask(live, resolved, _mm512_set1_epi8(C_TOKEN_L_SQUARE));
+    const uint64_t standard = squares & ((squares << 1) | (at != 0 && pp->output.kinds[at - 1] == C_TOKEN_L_SQUARE));
+    const uint64_t gnu = _mm512_mask_cmpeq_epi8_mask(live, resolved, _mm512_set1_epi8((char)(BUSTER_PP_KIND_KEYWORD + C_NAME_GNU_ATTRIBUTE - 1))) |
+                         _mm512_mask_cmpeq_epi8_mask(live, resolved, _mm512_set1_epi8((char)(BUSTER_PP_KIND_KEYWORD + C_NAME_GNU_ATTRIBUTE2 - 1)));
+    if (window->attribute_open != 0 && at + length > window->attribute_end) pp_return_skip_attribute(pp);
