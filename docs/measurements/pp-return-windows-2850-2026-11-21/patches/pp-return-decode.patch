+static void node_pp_return_payload(CheckInputReader* reader, uint32_t token, uint32_t leaf, NodeWindowNativeTape* tape, CheckValue* value)
+{
+    PPReturnWindow* window = &reader->pp->return_window;
+    const Parser* parser = reader->parser;
+    const uint32_t source = parser->tokens.sources[token];
+    uint32_t low = 0, high = window->count;
+    while (low < high)
+    {
+        const uint32_t mid = low + (high - low) / 2;
+        if (window->rows[mid].statement < source) low = mid + 1;
+        else high = mid;
+    }
+    if (low >= window->count || window->rows[low].statement != source || parser->tokens.sources[leaf] != source + 1) return;
+    const PPReturnRow* row = window->rows + low;
