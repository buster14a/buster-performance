+// The selection census (#2536's step 2.1, docs/all-core-path.md's "Step 2: the selection after the windows"): each body's
+// candidates' references, the walk of check_program_references started from every expression root of the body (a node of
+// its tokens, its declaration's to its closing brace's, that no node takes as an operand), from its automatic objects'
+// initializer plans (`plan_first`'s lists) and from its cleanups, rather than from the controls it reaches. So a body's
+// candidates' references are its own and those of the arms of a constant `if` its controls leave out, and of what no
+// control evaluates (a root in typeof's operand). Into program->census_references, census_first and census_counts, in
+// `output`, with the bodies whose candidates' references aren't their own (census_differing_bodies) and those with a
+// dropped arm (census_dropped_bodies, of the writer's `dropped` ranges, `dropped_count` of them, each's first token in its
+// key's high half). The walk's marks in `seen` and `nodes` take epochs past the bodies', its `needed` column is its own, and
+// what it writes besides its references (CheckProgram.region_reached, compound_initializers, the status) is put back.
+// Returns false if there's no room.
+static bool check_program_census(CheckProgram* program, const Parser* parser, const uint32_t* token_first, const uint32_t* node_next, const uint32_t* plan_first,
+                                 const uint64_t* planned, const uint32_t* plan_next, const uint64_t* dropped, uint32_t dropped_count, uint32_t* seen, uint32_t* nodes,
+                                 uint32_t* stack, uint64_t* reference_items, uint64_t* reference_sort, bool scalar, Arena* output, Arena* scratch)
+{
+    const CheckInput* input = program->input;
+    const CheckGraph* graph = &input->graph;
+    const uint32_t count = input->token_count;
+    const uint32_t node_count = graph->count;
+    const uint32_t plans = program->initializers != NULL ? program->initializers->count : 0;
+    const uint64_t temporary = scratch->length;
+    uint8_t* operand = BUSTER_ARENA_PUSH_ARRAY(scratch, uint8_t, (uint64_t)node_count + 1);
+    uint8_t* needed = BUSTER_ARENA_PUSH_ARRAY(scratch, uint8_t, (uint64_t)count + 1);
+    CheckControl* roots = BUSTER_ARENA_PUSH_ARRAY(scratch, CheckControl, (uint64_t)node_count + plans + input->cleanup_count + 1);
+    uint8_t* region_reached = program->region_count != 0 ? BUSTER_ARENA_PUSH_ARRAY(scratch, uint8_t, program->region_count) : NULL;
+    uint8_t* compound = program->compound_initializers != NULL && plans != 0 ? BUSTER_ARENA_PUSH_ARRAY(scratch, uint8_t, plans) : NULL;
+    program->census_first = BUSTER_ARENA_PUSH_ARRAY(output, uint32_t, (uint64_t)program->body_count + 1);
+    program->census_counts = BUSTER_ARENA_PUSH_ARRAY(output, uint32_t, (uint64_t)program->body_count + 1);
+    bool valid = operand != NULL && needed != NULL && roots != NULL && (program->region_count == 0 || region_reached != NULL) &&
+                 (program->compound_initializers == NULL || plans == 0 || compound != NULL) && program->census_first != NULL && program->census_counts != NULL;
+    const CheckProgramStatus status = program->status;
+    const uint32_t token = program->token;
+    if (valid)
+    {
+        memset(operand, 0, (uint64_t)node_count + 1);
+        memset(needed, 0, (uint64_t)count + 1);
+        for (uint32_t node = 0; node < node_count; node += 1)
+        {
+            operand[graph->operand0[node] < node_count ? graph->operand0[node] : node_count] = 1;
+            operand[graph->operand1[node] < node_count ? graph->operand1[node] : node_count] = 1;
+            operand[graph->operand2[node] < node_count ? graph->operand2[node] : node_count] = 1;
+        }
+        // A static declaration's initializer is its object's data, which the selection reaches through the object: its
+        // plan's parts and every node over them (the conversions the checker adds for the plan, which no node takes as an
+        // operand) are no body's roots. Operands come before the nodes that take them, so one pass carries the mark up.
+        uint8_t* data_nodes = BUSTER_ARENA_PUSH_ARRAY(scratch, uint8_t, (uint64_t)node_count + 1);
+        valid = data_nodes != NULL;
+        if (valid)
+        {
+            memset(data_nodes, 0, (uint64_t)node_count + 1);
+            for (uint32_t plan = 0; plan < plans; plan += 1)
+            {
+                const uint32_t declaration = program->initializers->declaration_tokens[plan];
+                const CheckInitializer* initializer = program->initializers->plans + plan;
+                for (uint32_t part = 0; declaration < count && check_input_bit(input->declaration_bits, declaration, BUSTER_CHECK_BITS_STATIC) && part < initializer->count;
+                     part += 1)
+                {
+                    const uint32_t node = initializer->parts[part].node;
+                    data_nodes[node < node_count ? node : node_count] = 1;
+                }
+            }
+            data_nodes[node_count] = 0;
+            for (uint32_t node = 0; node < node_count; node += 1)
+            {
+                const uint32_t a = graph->operand0[node] < node_count ? graph->operand0[node] : node_count;
+                const uint32_t c = graph->operand1[node] < node_count ? graph->operand1[node] : node_count;
+                const uint32_t d = graph->operand2[node] < node_count ? graph->operand2[node] : node_count;
+                data_nodes[node] |= data_nodes[a] | data_nodes[c] | data_nodes[d];
+                operand[node] |= data_nodes[node];
+            }
+        }
+        if (region_reached != NULL)
+        {
+            memcpy(region_reached, program->region_reached, program->region_count);
+        }
+        if (compound != NULL)
+        {
+            memcpy(compound, program->compound_initializers, plans);
+        }
+    }
+    uint32_t total = 0;
+    uint64_t probe_setup = __rdtsc();
+    uint64_t probe_roots = 0;
+    uint64_t probe_walk = 0;
+    uint64_t probe_rest = 0;
+    uint64_t probe_root_count = 0;
+    for (uint32_t b = 0; valid && b < program->body_count; b += 1)
+    {
+        const uint64_t probe_a = __rdtsc();
+        const CheckProgramBody* body = program->bodies + b;
+        const uint32_t closing = parser->tree.parents[body->opening];
+        uint32_t root_count = 0;
+        for (uint32_t t = body->declaration; t <= closing && t < count; t += 1)
+        {
+            for (uint32_t node = token_first[t]; node < node_count; node = node_next[node])
+            {
+                if (operand[node] == 0)
+                {
+                    roots[root_count++] = (CheckControl){ .node = node, .token = t, .target = 0, .kind = CHECK_CONTROL_EVALUATE };
+                }
+            }
+            if (check_program_bit(planned, t))
+            {
+                for (uint32_t plan = plan_first[t]; plan < plans; plan = plan_next[plan])
+                {
+                    const uint32_t declaration = program->initializers->declaration_tokens[plan];
+                    if (declaration < count && !check_input_bit(input->declaration_bits, declaration, BUSTER_CHECK_BITS_STATIC))
+                    {
+                        roots[root_count++] = (CheckControl){ .node = BUSTER_CHECK_NONE, .token = t, .target = plan, .kind = CHECK_CONTROL_INITIALIZE };
+                    }
+                }
+            }
+        }
+        for (uint32_t r = 0; r < body->cleanup_count; r += 1)
+        {
+            roots[root_count++] = (CheckControl){ .node = BUSTER_CHECK_NONE, .token = 0, .target = body->cleanup_first + r, .kind = CHECK_CONTROL_CLEANUP };
+        }
+        if (getenv("BUSTER_CENSUS_BODY") != NULL && program->identifiers != NULL)
+        {
+            const uint32_t fname = parser->tokens.names[body->declaration];
+            const char* want = getenv("BUSTER_CENSUS_BODY");
+            if (intern_length(program->identifiers, fname) == strlen(want) && memcmp(intern_bytes(program->identifiers, fname), want, strlen(want)) == 0)
+            {
+                for (uint32_t r = 0; r < root_count; r += 1)
+                {
+                    fprintf(stderr, "root node %u op %u token %u kind %u target %u\n", roots[r].node, roots[r].node < node_count ? (uint32_t)graph->ops[roots[r].node] : 999u, roots[r].token, (uint32_t)roots[r].kind, roots[r].target);
+                }
+                for (uint32_t plan = 0; plan < plans; plan += 1)
+                {
+                    const uint32_t declaration = program->initializers->declaration_tokens[plan];
+                    if (declaration >= body->declaration && declaration <= closing)
+                    {
+                        fprintf(stderr, "plan %u declaration %u static %d parts %u initializer_node %u:", plan, declaration, (int)check_input_bit(input->declaration_bits, declaration, BUSTER_CHECK_BITS_STATIC), program->initializers->plans[plan].count, check_sparse_get(input->initializer_nodes, declaration));
+                        for (uint32_t part = 0; part < program->initializers->plans[plan].count && part < 12; part += 1)
+                        {
+                            fprintf(stderr, " %u", program->initializers->plans[plan].parts[part].node);
+                        }
+                        fprintf(stderr, "\n");
+                    }
+                }
+            }
+        }
+        const uint64_t probe_b = __rdtsc();
+        probe_root_count += root_count;
+        const uint32_t epoch = program->body_count + 1 + b;
+        const uint32_t found = check_program_references(program, roots, root_count, epoch, seen, nodes, stack, reference_items, needed);
+        const uint64_t probe_c = __rdtsc();
+        probe_roots += probe_b - probe_a;
+        probe_walk += probe_c - probe_b;
+        uint32_t varying = 0;
+        for (uint32_t r = 1; r < found; r += 1)
+        {
+            varying |= (uint32_t)((reference_items[0] ^ reference_items[r]) >> 32);
+        }
+        const uint64_t* sorted = c_bindings_sort(reference_items, reference_sort, found, !BUSTER_SCALAR_PATH(scalar), varying);
+        uint32_t* kept = found != 0 ? BUSTER_ARENA_PUSH_ARRAY(output, uint32_t, found) : NULL;
+        valid = found == 0 || kept != NULL;
+        if (valid)
+        {
+            program->census_references = program->census_references == NULL ? kept : program->census_references;
+            program->census_first[b] = total;
+            program->census_counts[b] = found;
+            bool arm = false;
+            for (uint32_t d = 0; d < dropped_count; d += 1)
+            {
+                const uint32_t first = (uint32_t)(dropped[d] >> 32);
+                arm = arm || (first > body->opening && first < closing);
+            }
+            // Both lists are sorted: one merge counts the candidates' references that aren't the body's (extra) and the
+            // body's that the candidates miss (missing, which a superset never has).
+            uint32_t extra = 0;
+            uint32_t missing = 0;
+            uint32_t e = 0;
+            for (uint32_t r = 0; r < found; r += 1)
+            {
+                kept[r] = (uint32_t)(sorted[r] >> 32);
+                while (e < body->reference_count && program->references[body->reference_first + e] < kept[r])
+                {
+                    missing += 1;
+                    e += 1;
+                }
+                const bool matched = e < body->reference_count && program->references[body->reference_first + e] == kept[r];
+                extra += matched ? 0 : 1;
+                e += matched ? 1 : 0;
+                if (!matched && getenv("BUSTER_CENSUS_DEBUG") != NULL && program->identifiers != NULL)
+                {
+                    const uint32_t fname = parser->tokens.names[body->declaration];
+                    const uint32_t oname = parser->tokens.names[kept[r] - 1];
+                    fprintf(stderr, "census-extra\t%.*s\t%.*s\tkind\t%u\tarm\t%d\n", (int)intern_length(program->identifiers, fname),
+                            (const char*)intern_bytes(program->identifiers, fname), (int)intern_length(program->identifiers, oname),
+                            (const char*)intern_bytes(program->identifiers, oname), (uint32_t)parser->tokens.kinds[kept[r] - 1], (int)arm);
+                }
+            }
+            missing += body->reference_count - e;
+            const bool same = extra == 0 && missing == 0;
+            program->census_differing_bodies += same ? 0 : 1;
+            program->census_unarmed_differing_bodies += !same && !arm ? 1 : 0;
+            program->census_missing_bodies += missing != 0 ? 1 : 0;
+            total += found;
+            program->census_dropped_bodies += arm ? 1 : 0;
+        }
+        probe_rest += __rdtsc() - probe_a;
+    }
+    if (getenv("BUSTER_CENSUS_PROBE") != NULL)
+    {
+        uint32_t inversions = 0;
+        uint32_t big = 0;
+        for (uint32_t node = 1; node < node_count; node += 1)
+        {
+            inversions += graph->tokens[node] < graph->tokens[node - 1] ? 1 : 0;
+            big += graph->tokens[node] + 4096 < graph->tokens[node - 1] ? 1 : 0;
+        }
+        uint32_t outside = 0;
+        uint32_t b = 0;
+        for (uint32_t node = 0; node < node_count; node += 1)
+        {
+            const uint32_t t = graph->tokens[node];
+            while (b < program->body_count && parser->tree.parents[program->bodies[b].opening] < t)
+            {
+                b += 1;
+            }
+            outside += b < program->body_count && t >= program->bodies[b].declaration ? 0 : 1;
+        }
+        fprintf(stderr, "census-order\tinversions\t%u\tbig\t%u\toutside-merge\t%u\n", inversions, big, outside);
+        fprintf(stderr, "census-probe\troots\t%llu\twalk\t%llu\tbodies-all\t%llu\troot-count\t%llu\tnodes\t%u\n", (unsigned long long)probe_roots,
+                (unsigned long long)probe_walk, (unsigned long long)probe_rest, (unsigned long long)probe_root_count, node_count);
+    }
+    (void)probe_setup;
+    if (region_reached != NULL)
+    {
+        memcpy(program->region_reached, region_reached, program->region_count);
+    }
+    if (compound != NULL)
+    {
+        memcpy(program->compound_initializers, compound, plans);
+    }
+    program->status = status;
+    program->token = token;
+    arena_pop_to(scratch, temporary);
+    return valid;
+}
+
 static bool check_program(CheckProgram* program, const Parser* parser, const CheckInput* input, CheckStream* stream,
                           const TypeTable* types, CheckProgramOptions options, Arena* output, Arena* scratch)
 {
@@ -4974,6 +5234,7 @@ static bool check_program(CheckProgram* program, const Parser* parser, const Che
