rule backend
  command = /workspace/scratch/6891521e933c/toolchain/llvm/bin/clang -x ir -c -O3 -march=x86-64 -fno-stack-protector -Xclang -disable-llvm-passes $in -o $out -ftime-trace=$out.json -ftime-trace-granularity=1000
  description = O3 native backend $in

build checker.split.0.o: backend checker.split.bc0
build checker.split.1.o: backend checker.split.bc1
build checker.split.2.o: backend checker.split.bc2
build checker.split.3.o: backend checker.split.bc3
build checker.split.4.o: backend checker.split.bc4
build checker.split.5.o: backend checker.split.bc5
build checker.split.6.o: backend checker.split.bc6
build checker.split.7.o: backend checker.split.bc7

default checker.split.0.o checker.split.1.o checker.split.2.o checker.split.3.o checker.split.4.o checker.split.5.o checker.split.6.o checker.split.7.o
