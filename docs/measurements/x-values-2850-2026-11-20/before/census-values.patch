+// EXPERIMENT (the values' census, BUSTER_CENSUS_V=1; not for a commit): a line for each record of each expression the
+// rows take, with what the window has of it and its row's entries as the reference's tape has them, a kind, a class
+// and a value each.
+static int node_rows_census_on = -1;
+static uint64_t node_rows_census_expressions;
+static void node_rows_census(const struct NodeFactsReader* state, const NodeFront* front, uint32_t e)
+{
+    const NodeFrontTypes* types = state->types;
+    const NodeMachine* machine = state->facts.machine;
+    const uint32_t record = state->records[e];
+    const uint32_t operand = state->operands[e];
+    const uint32_t size = front->sizes[operand];
+    const uint32_t first = operand + 1 - size;
+    const uint32_t last = first + size - 1;
+    const bool rooted = state->counts[e] > size;
+    const uint32_t start = node_rows_window_place(state, first);
+    const uint32_t inner = node_rows_window_place(state, last) + node_rows_window_length(state, last) - start;
+    const uint32_t root = state->roots[e];
+    const uint32_t expected = types->tape_counts[root];
+    if (expected != UINT32_MAX)
+    {
+        const uint64_t base = types->tape_firsts[root];
+        for (uint32_t r = 0; r < state->counts[e]; r += 1)
+        {
+            const uint32_t x = r < size ? first + r : record;
+            const NodeFactsRecord* line = state->facts.records + x;
+            const uint32_t length = node_rows_window_length(state, x);
+            const uint32_t at = r < size ? node_rows_window_place(state, x) - start : inner;
+            const uint32_t object = line->object;
+            const bool known = object != 0 && object < machine->object_count;
+            const uint64_t symbol = known ? machine->object_symbols[object] : 0;
+            const bool alive = (state->window_c_masks[BUSTER_NODE_CONTEXTS_MASKS * (uint64_t)(x / 64) + BUSTER_NODE_CONTEXTS_MASK_ALIVE] >> (x & 63) & 1) != 0;
+            const uint64_t stride0 = line->converted[0] != 0 ? check_action_pointer_stride(machine->types, line->converted[0]) : 0;
+            const uint64_t stride_own = line->type != 0 ? check_action_pointer_stride(machine->types, line->type) : 0;
+            printf("xv\t%" PRIu64 "\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%" PRIx64 "\t%" PRIx64 "\t%x\t%x\t%" PRIu64 "\t%u\t%u\t%u\t%u\t%u\t%" PRIu64 "\t%" PRIu64 "\t%x\t%u\t%u\t",
+                   node_rows_census_expressions, r, state->counts[e], (uint32_t)(front->ops[x] & 0x7fu), (uint32_t)state->window_c_templates[x], alive ? 1u : 0u,
+                   (uint32_t)state->window_x_owns[x], (uint32_t)state->window_x_conversions[x], length, (uint32_t)front->window_left[x], (uint32_t)front->window_right[x],
+                   front->sizes[x], rooted && r == size ? 1u : 0u, object, symbol, line->payload, (uint32_t)line->standing, (uint32_t)line->exponent, line->member_offset,
+                   (uint32_t)state->window_c_classes[x], (uint32_t)state->window_c_facts[x], (uint32_t)state->window_x_targets[x], (uint32_t)state->window_x_facts[x],
+                   (uint32_t)state->window_x_operands[x], stride0, stride_own, (uint32_t)state->window_c_flags[x], (uint32_t)state->window_x_senses[x],
+                   (uint32_t)state->window_c_contexts[x]);
+            for (uint32_t j = 0; j < length && at + j < expected; j += 1)
+            {
+                printf("%s%u:%u:%" PRIx64, j == 0 ? "" : ",", (uint32_t)types->tape_kinds[base + at + j], (uint32_t)types->tape_classes[base + at + j], types->tape_values[base + at + j]);
+            }
+            printf("\n");
+        }
+        node_rows_census_expressions += 1;
+    }
+}
