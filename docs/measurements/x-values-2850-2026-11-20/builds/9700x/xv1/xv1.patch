+// (the measurement record's x-values-2850) found each one a function of what the window has: half are zero, and the
+// others a field of a record's line, a type's row's stride or a fixed number, but for the numbers of the few
+// expressions with two calls, two labels or two postfix updates through an address (node_rows_window_number).
+// - The stream starts as zeros: no sweep writes one.
+// - A sweep of masks, 64 records a step, over the two shapes each record has once the updates' and the branches'
+//   loops are done, makes the lists (BUSTER_NODE_ROWS_LIST_*): a record's lists are its own shape's byte of the
+//   values' table (NodeRowsTables.value_owns), but a constant's by its class and its fold (a floating one's and one
+//   folded to bool are the rest's), an update's store by its kind (the updates' loop left a by-name store's in the
+//   bits' column), and a tested value's branch by its owner's bit (the branches' loop's). And a mask a block of the
+//   records with a value that is a number in its expression (the table's bit).
+// - A loop a list writes its values, each a load or two and a store at its row's place, none waiting for another.
+// A value's rule is X's (node_machine_own, node_machine_address, node_machine_fold_conversion,
+// node_machine_update_first and _last, node_machine_branch_hook):
+// - an object's number for a LOCAL, a GLOBAL and their addresses (at reader time a global's entry holds its object,
+//   which stands for its symbol until a splice patches it: node_machine_reader_strings, the shadow's comparison), and
+//   a store's and an update's by name their destination's, their first operand's;
+// - an integer constant's bits by its entry's class, after its own class's where its conversion folded;
+// - a member's offset in bytes and its sum's 1; a pointer's stride, and its update's step's 1;
+// - the control's label for a tested value no operator owns (BUSTER_NODE_MACHINE_CONTROL_LABEL), and zero, an
+//   expression's first label, for one an operator owns; zero, an expression's first call's row, for a CALL;
+// - and zero for an access (a vector's bytes, and C takes no vector's access), a conversion, an operation and a test.
+static __attribute__((noinline)) void node_rows_window_values(struct NodeFactsReader* state, const NodeFront* front, uint32_t count, uint32_t written, uint32_t* listed)
+{
+    const NodeRowsTables* tables = state->x_tables;
+    const NodeFacts* facts = &state->facts;
+    const NodeFactsRecord* records = facts->records;
+    uint64_t* values = state->x_values;
+    uint16_t* named = state->x_lists[BUSTER_NODE_ROWS_LIST_NAMED];
+    uint16_t* stored = state->x_lists[BUSTER_NODE_ROWS_LIST_STORED];
+    uint16_t* constants = state->x_lists[BUSTER_NODE_ROWS_LIST_CONSTANT];
+    uint16_t* members = state->x_lists[BUSTER_NODE_ROWS_LIST_MEMBER];
+    uint16_t* strides = state->x_lists[BUSTER_NODE_ROWS_LIST_STRIDE];
+    uint16_t* controlled = state->x_lists[BUSTER_NODE_ROWS_LIST_CONTROLLED];
+    uint16_t* rest = state->x_lists[BUSTER_NODE_ROWS_LIST_REST];
+    uint32_t named_count = 0;
+    uint32_t stored_count = 0;
+    uint32_t constant_count = 0;
+    uint32_t member_count = 0;
+    uint32_t stride_count = 0;
+    uint32_t controlled_count = 0;
