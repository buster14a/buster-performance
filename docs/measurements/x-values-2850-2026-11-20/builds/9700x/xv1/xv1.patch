+        values[place] = node_rows_extend(node_rows_extend(records[x].payload, state->window_c_classes[x]), state->x_classes[place]);
+    }
+    // A member's offset, its line's, in bits: its CONST's in bytes, and its PTR_ADD's 1.
+    for (uint32_t i = 0; i < member_count; i += 1)
+    {
