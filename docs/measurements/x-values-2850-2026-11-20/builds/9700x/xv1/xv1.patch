+        values[before] = BUSTER_NODE_MACHINE_TEMPORARY;
+        values[before + 1] = BUSTER_NODE_MACHINE_TEMPORARY;
+        values[before + 3] = BUSTER_NODE_MACHINE_TEMPORARY | 1;
+        values[before + 4] = BUSTER_NODE_MACHINE_TEMPORARY;
