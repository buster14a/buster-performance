+        values[place + (slots & BUSTER_NODE_ROWS_SLOT_STRIDE)] = node_rows_stride(facts, x);
+    }
+    // The control's label, a tested value's branch's, its row's last entry's.
+    for (uint32_t i = 0; i < controlled_count; i += 1)
+    {
