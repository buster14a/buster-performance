+        const __mmask64 tested = _mm512_cmplt_epu8_mask(_mm512_sub_epi8(conversions, _mm512_set1_epi8(BUSTER_NODE_ROWS_TESTED)), _mm512_set1_epi8(4));
+        const __mmask64 owned = _mm512_test_epi8_mask(senses, _mm512_set1_epi8(BUSTER_NODE_ROWS_SENSE_OWNED));
