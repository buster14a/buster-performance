+    // Its line's object, its row's first entry's.
+    for (uint32_t i = 0; i < named_count; i += 1)
+    {
+        const uint32_t x = named[i];
+        values[node_rows_window_place(state, x)] = records[x].object;
+    }
+    // Its destination's line's object, its own part's last entry's: a store by name's one entry, and an update's
+    // store, after its step, its operation and its conversion back.
+    for (uint32_t i = 0; i < stored_count; i += 1)
+    {
+        const uint32_t x = stored[i];
