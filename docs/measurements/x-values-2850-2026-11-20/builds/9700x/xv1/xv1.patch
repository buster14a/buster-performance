+// The values of the rest's list's record `x`, by its own shape, a record at a time and out of the lists' loops' way:
+// - a floating constant's bits, and whether a constant folded to bool is not zero;
+// - an address constant's offset, its line's payload: alone, or after its object's address with its sum's 1;
+// - an arithmetic update's step, one of the class it is computed in (its entry's: 1, or a float's or a double's bits);
+// - and a postfix update's destination's temporaries, after its own entries (node_machine_update_first's six: the
+//   address's store and its read, the load, the old value's store, and the two read): the expression's first pair,
+//   which the numbering writes again in an expression with two such updates.
+static __attribute__((noinline)) void node_rows_window_rest(struct NodeFactsReader* state, uint32_t x)
+{
+    const NodeRowsTables* tables = state->x_tables;
+    const NodeFactsRecord* record = state->facts.records + x;
+    const uint32_t own = state->window_x_owns[x];
+    const uint32_t place = node_rows_window_place(state, x);
+    uint64_t* values = state->x_values + place;
+    if (own == BUSTER_TYPED_CONST)
