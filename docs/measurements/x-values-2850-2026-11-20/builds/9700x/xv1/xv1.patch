+// How many of the values' marks (NodeFactsReader.window_x_marks, a word a block) the `size` records from the window's
+// record `first` have. A range of 64 records or fewer is in two words at most, read as one with no branch on where it
+// lies (node_contexts_window_any's way); a longer one goes on a word at a time.
+static inline __attribute__((always_inline)) uint32_t node_rows_window_marked(const uint64_t* marks, uint32_t first, uint32_t size)
+{
