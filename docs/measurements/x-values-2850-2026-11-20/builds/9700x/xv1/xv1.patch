+        const __m512i base = _mm512_set1_epi16((int16_t)x);
+        named_count = node_rows_listed(named, named_count, _mm512_test_epi8_mask(lists, _mm512_set1_epi8(BUSTER_NODE_ROWS_VALUE_NAMED)), places, base);
+        stored_count = node_rows_listed(stored, stored_count, _mm512_test_epi8_mask(lists, _mm512_set1_epi8(BUSTER_NODE_ROWS_VALUE_STORED)) | by_name, places, base);
