== Test the IR and typed-stream lowering
"$BUSTER_COMPILER" test-ir
"$BUSTER_COMPILER" test-ir-simd
"$BUSTER_COMPILER" test-ir-lowering
"$BUSTER_COMPILER" test-ir-source --simd -march=x86-64-v4 tests/ir/vector-i32.c tests/ir/mask-builtins.c tests/ir/bmi-builtins.c tests/ir/vector-rows.c tests/ir/carrier-rows.c
"$BUSTER_COMPILER" test-ir-source --dataflow-self-test
# #1374: qualify the benchmark's corpus preparation and both measured lowerings at each function's own target.
# The fixture adds features on the baseline and removes them at znver5; it never executes generated instructions.
"$BUSTER_COMPILER" test-ir-source --benchmark-self-test -march=x86-64 tests/ir-source/bit-builtins.c
"$BUSTER_COMPILER" test-ir-source --benchmark-self-test -march=znver5 tests/ir-source/bit-builtins.c
"$BUSTER_COMPILER" test-ir-parse
"$BUSTER_COMPILER" test-ir-reduce
"$BUSTER_COMPILER" test-ir-metamorphic --seed 731 --count 6
"$BUSTER_COMPILER" test-interpreter
"$BUSTER_COMPILER" test-interpreter-native
"$BUSTER_COMPILER" test-interpreter-link
"$BUSTER_COMPILER" test-ir-interpreter
# A native that only libm defines, which the compiler's link doesn't take (#652): --bind finds it through dlopen, or in a
# static executable in test_libm.c's table.
"$BUSTER_COMPILER" interpret-ir --result --bind 100=fegetround tests/ir/libm-call.ir
# And one of the C library's, which a static executable's table names too.
"$BUSTER_COMPILER" interpret-ir --result --bind 100=getpid tests/ir/libm-call.ir
== Test selective lowering against its independent oracle and Clang symbols
"$BUSTER_COMPILER" test-lowering --clang
== Test the emission metadata protocol
# Bounded source/frame events and their transactional resolution against a final record layout, by the scalar path and
# the AVX-512 layout twin where the host has it.
"$BUSTER_COMPILER" test-emission-metadata
== Test the tier-neutral emitted function and its frame verifier
# #1056: row programs against the fixed CFI writer for every descriptor; Tier 0's generated programs and the Tier 1
# frame planner's every flag resolved into the previous readers' descriptors byte for byte; the frame verifier on them
# and their mutants; and a probe frame (its CFA in r11 through the loop) under gdb at every instruction.
"$BUSTER_COMPILER" test-emitted-code --cross-check
