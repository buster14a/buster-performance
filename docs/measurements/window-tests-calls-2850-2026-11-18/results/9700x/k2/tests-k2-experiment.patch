+static void abi_test_feed(AbiTestStarved starved)
+{
+    for (uint32_t i = 0; i < BUSTER_SCRATCH_ARENA_COUNT; i += 1)
+    {
+        arena_release(&thread_context.scratch[i]);
+        thread_context.scratch[i] = starved.saved[i];
+    }
