+    uint32_t data[16];
+    uint32_t count = 0;
+    const bool ok = c_direct_test_tokens_mode(text, sizeof(text) - 1u, kinds, data, 16u, &count, false, mode);
+    return ok && count == 6u && memcmp(kinds, expected, 6) == 0;
