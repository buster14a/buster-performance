+typedef struct CDirectDeclarationCase CDirectDeclarationCase;
+struct CDirectDeclarationCase
+{
+    const char* source;
+    const char* name;     // the symbol the case is about
+    const char* absent;   // a name the object must not have, or NULL
+    uint8_t bind;
+    uint8_t visibility;
+    bool defined;
+};
