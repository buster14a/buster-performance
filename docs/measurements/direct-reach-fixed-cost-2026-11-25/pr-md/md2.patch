+// The symbols of a declaration's attributes and of inline definitions, as the full pipeline gives them (#3595)
+
+typedef struct CDirectTestSymbol CDirectTestSymbol;
+struct CDirectTestSymbol
+{
+    uint32_t count;
+    uint8_t bind;
+    uint8_t type;
+    uint8_t visibility;
+    uint16_t section;
+    uint64_t value;
+    uint64_t size;
