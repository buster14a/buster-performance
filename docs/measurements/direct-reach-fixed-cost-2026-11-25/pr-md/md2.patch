+    const uint8_t all[6] = { FTOK_KW_ASM, FTOK_KW_TYPEOF, FTOK_KW_ASM, FTOK_KW_TYPEOF, FTOK_KW_ASM, FTOK_KW_TYPEOF };
+    const uint8_t none[6] = { FTOK_IDENT, FTOK_IDENT, FTOK_KW_ASM, FTOK_KW_TYPEOF, FTOK_KW_ASM, FTOK_KW_TYPEOF };
