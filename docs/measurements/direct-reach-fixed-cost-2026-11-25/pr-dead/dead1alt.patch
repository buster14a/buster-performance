+        "#define G(...) g(0, ## __VA_ARGS__)\n"
+        "#define H(x, ...) h(1, x ## __VA_ARGS__)\n"
+        "#define N(x, rest...) n(x, ## rest)\n"
+        "F(1) F(1,) F(1, 2) F(1, 2, 3) G() G( ) G(2) H() H(3) H(,4) N(1) N(1,) N(1, 2)\n";
