+// The registers an expression's values hold, kept where code stops and given back where it starts again (#3616): a
+// value without code is a placeholder that says rax, and releasing one would free a live value's register. A macro:
+// every `?`, `&&` and `||` keeps them.
+#define BUSTER_FREGISTERS(ex) ((uint32_t)(ex).gp_used | ((uint32_t)(ex).xmm_used << 16u))
+
+static inline void fval_registers_back(FastExprCtx* ex, uint32_t registers)
+{
+    ex->gp_used = (uint16_t)registers;
+    ex->xmm_used = (uint8_t)(registers >> 16u);
+}
