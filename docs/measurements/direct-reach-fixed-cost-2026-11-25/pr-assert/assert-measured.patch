+        "int t_stmt(int x) { assert(x > 0 && (x & 1) == 0); return x * 3; }\n"
+        "int t_expr(int *p, int x) { return ALWAYS(p != 0) ? p[x] : -x; }\n"
+        "int t_dead(int x) { if (0) { assert(x); } else { x += 1; } return x; }\n"
+        "int t_nested(int x) { assert((x ? x : 1) > 0); assert(x != 3); return x; }\n";
