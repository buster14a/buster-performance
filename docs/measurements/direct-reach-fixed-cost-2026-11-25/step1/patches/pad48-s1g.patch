+#define BUSTER_FIDENT_CACHE_BITS  14u    // 16384 entries * 24 B = 384 KB (fits Zen 5 1 MB L2!)
+// A small unit's tables (#3592): the hash table and the cache are written at hashed places, so at their full sizes the
