+// Whether the view has node `node`'s value.
+static inline bool node_view_has(const NodeCensusScratch* s, uint32_t node)
+{
+    return s->records == NULL ? node < s->program->stream->count : node_view_record(s, node) != UINT32_MAX;
+}
