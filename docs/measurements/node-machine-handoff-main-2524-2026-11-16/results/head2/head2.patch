+    bits |= s->missed != 0 ? UINT64_C(1) << NODE_CENSUS_SIZE : 0;
+    tests->types->tested_missed += s->missed;
+    s->missed = 0;
+    *kind = (uint8_t)context;
+    return bits;
+}
