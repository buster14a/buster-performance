+        units[u] = (Preprocessor){ 0 };
+        options.files = u == 2 ? units[0].cache : 0;
+        options.include_directories = u == 3 ? latin_directories : u == 4 ? large_directories : directories;
+        options.include_directory_count = u == 4 ? 1 : 2;
