+// Experimental, deliberately conservative admission: complete, one-byte, alignment-one string sections of the two
+// eligible kinds, with no relocatable contents. No production option or unsupported-input fallback is added here.
+// This is a complete pipeline cost experiment, using the existing producer and its per-contribution interior map.
+static ForeignLinkResult foreign_debug_merge_strings(ForeignDebugPlan* plan, const Foreign* foreign, Arena* arena)
+{
+    ForeignLinkResult result = { 0 };
+    Scratch scratch = scratch_begin(arena);
+    ForeignStringInput* inputs = BUSTER_ARENA_PUSH_ARRAY(scratch.arena, ForeignStringInput, (uint64_t)plan->contribution_count + 1);
+    plan->string_inputs = BUSTER_ARENA_PUSH_ARRAY(arena, uint32_t*, foreign->object_count);
+    result.error = inputs != 0 && plan->string_inputs != 0 ? FOREIGN_LINK_ERROR_NONE : FOREIGN_LINK_ERROR_MEMORY;
+    for (uint32_t id = 0; result.error == FOREIGN_LINK_ERROR_NONE && id < foreign->object_count; id += 1)
+    {
+        plan->string_inputs[id] = 0;
+    }
+    for (uint32_t pool = 0; result.error == FOREIGN_LINK_ERROR_NONE && pool < 2; pool += 1)
+    {
+        const uint32_t kind = (pool == 0 ? EXECUTABLE_SECTION_DEBUG_STR : EXECUTABLE_SECTION_DEBUG_LINE_STR) - EXECUTABLE_SECTION_DEBUG_INFO;
+        uint32_t count = 0;
+        bool eligible = true;
+        for (uint32_t c = 0; eligible && c < plan->contribution_count; c += 1)
+        {
+            const ForeignDebugContribution* contribution = &plan->contributions[c];
+            if (contribution->kind == kind)
+            {
+                const ForeignObject* object = &foreign->objects[contribution->object];
+                const Elf64_Shdr header = import_section_header(&object->elf, contribution->section);
+                uint64_t size = 0;
+                uint64_t alignment = 0;
+                String8 stream = { 0 };
+                foreign_debug_extent(object, &header, &size, &alignment, &stream);
+                eligible = header.sh_entsize == 1 && alignment == 1 && (header.sh_flags & (SHF_MERGE | SHF_STRINGS)) == (SHF_MERGE | SHF_STRINGS);
+                if (eligible)
+                {
+                    inputs[count++] = (ForeignStringInput){ .bytes = plan->bytes[kind] + contribution->base, .size = (uint32_t)size };
+                }
+            }
+        }
+        for (uint32_t r = 0; eligible && r < plan->relocation_count; r += 1)
+        {
+            eligible = plan->relocations[r].kind != kind;
+        }
+        const uint64_t mark = arena->length;
+        ForeignStrings* strings = &plan->string_pools[pool];
+        if (eligible && count > 1)
+        {
+            const ForeignStringsError error = foreign_strings_build(inputs, count, foreign->path, arena, strings);
+            result.error = error == FOREIGN_STRINGS_ERROR_NONE ? FOREIGN_LINK_ERROR_NONE : FOREIGN_LINK_ERROR_UNSUPPORTED;
+        }
+        if (strings->bytes != 0 && strings->size < plan->sizes[kind])
+        {
+            uint32_t index = 0;
+            for (uint32_t c = 0; result.error == FOREIGN_LINK_ERROR_NONE && c < plan->contribution_count; c += 1)
+            {
+                const ForeignDebugContribution* contribution = &plan->contributions[c];
+                if (contribution->kind == kind)
+                {
+                    const uint32_t id = contribution->object;
+                    const uint32_t sections = foreign->objects[id].elf.section_count;
+                    if (plan->string_inputs[id] == 0)
+                    {
+                        plan->string_inputs[id] = BUSTER_ARENA_PUSH_ARRAY(arena, uint32_t, sections);
+                        result.error = plan->string_inputs[id] != 0 ? FOREIGN_LINK_ERROR_NONE : FOREIGN_LINK_ERROR_MEMORY;
+                        if (plan->string_inputs[id] != 0)
+                        {
+                            memset(plan->string_inputs[id], 0, (uint64_t)sections * sizeof(uint32_t));
+                        }
+                    }
+                    if (result.error == FOREIGN_LINK_ERROR_NONE)
+                    {
+                        plan->string_inputs[id][contribution->section] = ((index + 1) << 1) | pool;
+                        index += 1;
+                    }
+                }
+            }
+            plan->bytes[kind] = strings->bytes;
+            plan->sizes[kind] = strings->size;
+        }
+        else
+        {
+            arena_pop_to(arena, mark);
+            *strings = (ForeignStrings){ 0 };
+        }
+    }
+    for (uint32_t id = 0; result.error == FOREIGN_LINK_ERROR_NONE && id < foreign->object_count; id += 1)
+    {
+        const ForeignObject* object = &foreign->objects[id];
+        for (uint32_t symbol = 1; plan->string_inputs[id] != 0 && plan->resolved[id] != 0 && symbol < object->symbols.count; symbol += 1)
+        {
+            const Elf64_Sym value = import_symbol(&object->symbols, symbol);
+            if (value.st_shndx < object->elf.section_count && plan->string_inputs[id][value.st_shndx] != 0)
+            {
+                plan->resolved[id][symbol] = BUSTER_FOREIGN_DEBUG_LEFT << 62;
+            }
+        }
+    }
+    scratch_end(scratch);
+    return result;
+}
