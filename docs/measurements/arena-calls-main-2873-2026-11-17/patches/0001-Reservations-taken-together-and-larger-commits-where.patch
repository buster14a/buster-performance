+// Reservations taken together (#2873). A compile reserves about 33 arenas, each by an mmap of its own: on the 9700X a
+// quarter of a small unit's 98 system calls for its arenas, about 9,000 kernel cycles each. Where the address space is
+// unlimited (arena_limits, fixed by the command), a reservation instead takes its mapping from a region of the address
+// space mapped once, inaccessible, with the same flags: BUSTER_ARENA_REGION_BYTES for each set of flags a reservation
+// maps with (MAP_STACK or not, MAP_NORESERVE or not: arena_reservation_flags, arena_reserve_tables), carved from its
+// start, never given back. What a reservation gets is what its own mmap would have given it: inaccessible bytes,
+// which its commits make writable and its release unmaps (a hole in the region) or its pool keeps. A region that the
+// kernel refuses, or that is full, leaves each reservation to map its own, as do a finite RLIMIT_AS (whose
+// reservations take shares or grow in slots, #1118), a thread switched to compact reservations, a sanitizer's build,
+// which lays the address space out itself, and a pool that makes its arenas inaccessible again as it takes them
+// (bounded commit charge: an inaccessible part that was once written would join its neighbours in the region, and a
+// core dump walk all of them).
+#define BUSTER_ARENA_REGIONS (!BUSTER_SANITIZER_RESOURCES)
+#define BUSTER_ARENA_REGION_KINDS 4
+#define BUSTER_ARENA_REGION_BYTES (8ull << 40)
+// A region: its address, 0 before its first reservation and 1 once the kernel refused it, and the bytes carved from
+// it. Reservations on every thread carve, so both are read and written atomically; main.c's units share them.
+typedef struct ArenaRegion ArenaRegion;
+struct ArenaRegion
+{
+    uintptr_t base;
+    uint64_t carved;
+};
+#define BUSTER_ARENA_REGION_REFUSED ((uintptr_t)1)
+#if defined(BUSTER_UNIT) && BUSTER_UNIT != BUSTER_UNIT_DRIVER
+extern ArenaRegion arena_regions[BUSTER_ARENA_REGION_KINDS];
+#elif defined(BUSTER_UNIT)
+ArenaRegion arena_regions[BUSTER_ARENA_REGION_KINDS];
+#else
+static ArenaRegion arena_regions[BUSTER_ARENA_REGION_KINDS];
+#endif
+
 // The share of a finite RLIMIT_AS that one arena admits, or BUSTER_ARENA_MAX_CAPACITY.
 static uint64_t arena_address_share(void)
 {
@@ -487,7 +522,7 @@ static void arena_pool_limits(ArenaPool* pool)
     if (!pool->limits)
     {
         pool->address_share = arena_limits.fixed ? arena_limits.address_share : arena_address_share();
-        pool->keeps_commits = arena_commit_unbounded();
+        pool->keeps_commits = arena_limits.fixed ? arena_limits.commit_unbounded : arena_commit_unbounded();
         pool->limits = true;
     }
 }
@@ -497,6 +532,7 @@ static __attribute__((unused)) void arena_limits_fix(void)
     arena_limits = (ArenaLimits){
         .fixed = true,
         .address_share = arena_address_share(),
+        .commit_unbounded = arena_commit_unbounded(),
     };
 }
 
@@ -588,6 +624,53 @@ static int arena_reservation_flags(uint64_t capacity, uint64_t small, uint64_t m
     return MAP_PRIVATE | MAP_ANONYMOUS | (advised && arena_stack_base_pages ? MAP_STACK : 0);
 }
 
+// `bytes` of inaccessible address space for a reservation that would map them with `flags`: from the region of those
+// flags (above), mapped at its first reservation, or else by an mmap of the reservation's own, whose failure is the
+// result (MAP_FAILED, with errno). `pool` is the reserving thread's, or null: its limits are read here if they haven't
+// been, as its releases read them.
+static uint8_t* arena_reservation_map(uint64_t bytes, int flags, ArenaPool* pool)
+{
+    uint8_t* result = MAP_FAILED;
+    if (pool != 0)
+    {
+        arena_pool_limits(pool);
+    }
+    const bool together = BUSTER_ARENA_REGIONS && arena_limits.fixed && arena_limits.address_share == BUSTER_ARENA_MAX_CAPACITY && !arena_compact &&
+                          (pool == 0 || pool->keeps_commits) && bytes <= BUSTER_ARENA_REGION_BYTES;
+    if (together)
+    {
+        ArenaRegion* region = &arena_regions[((flags & MAP_STACK) != 0 ? 1 : 0) | ((flags & MAP_NORESERVE) != 0 ? 2 : 0)];
+        uintptr_t base = __atomic_load_n(&region->base, __ATOMIC_ACQUIRE);
+        if (base == 0)
+        {
+            // The first reservation of these flags maps the region; of two threads' at once, one keeps its own.
+            void* mapped = mmap(0, BUSTER_ARENA_REGION_BYTES, PROT_NONE, flags, -1, 0);
+            const uintptr_t made = mapped != MAP_FAILED ? (uintptr_t)mapped : BUSTER_ARENA_REGION_REFUSED;
+            if (__atomic_compare_exchange_n(&region->base, &base, made, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+            {
+                base = made;
+            }
+            else if (mapped != MAP_FAILED)
+            {
+                munmap(mapped, BUSTER_ARENA_REGION_BYTES);
+            }
+        }
+        uint64_t carved = __atomic_load_n(&region->carved, __ATOMIC_RELAXED);
+        bool taken = false;
+        while (base != BUSTER_ARENA_REGION_REFUSED && !taken && bytes <= BUSTER_ARENA_REGION_BYTES - carved)
+        {
+            taken = __atomic_compare_exchange_n(&region->carved, &carved, carved + bytes, true, __ATOMIC_RELAXED, __ATOMIC_RELAXED);
+        }
+        result = taken ? (uint8_t*)base + carved : result;
+    }
+    if (result == MAP_FAILED)
+    {
+        errno = ENOMEM;
+        result = mmap(0, bytes, PROT_NONE, flags, -1, 0);
+    }
+    return result;
+}
+
 // A free slot of the growing arenas', claimed (1), or BUSTER_ARENA_SLOT_COUNT for none.
 static uint32_t arena_slot_claim(void)
 {
@@ -807,7 +890,7 @@ static Arena arena_reserve_policy(uint64_t capacity, uint64_t small, bool bounde
         allowed = allowed && arena_test_reservation_allowed(arena_mapping_bytes(requested));
 #endif
         errno = ENOMEM;
-        uint8_t* mapping = allowed ? mmap(0, mapping_bytes, PROT_NONE, arena_reservation_flags(capacity, small, mapping_bytes), -1, 0) : MAP_FAILED;
+        uint8_t* mapping = allowed ? arena_reservation_map(mapping_bytes, arena_reservation_flags(capacity, small, mapping_bytes), pool) : MAP_FAILED;
         // Do not evade an injected failure. Valgrind may reject a valid oversized mapping with EINVAL rather than
         // ENOMEM. Both layout refusals get a bounded retry, never a greedy half-limit map.
         if (bounded && allowed && mapping == MAP_FAILED && (errno == ENOMEM || errno == EINVAL) && capacity > BUSTER_ARENA_COMPACT_BYTES)
@@ -815,7 +898,7 @@ static Arena arena_reserve_policy(uint64_t capacity, uint64_t small, bool bounde
             arena_compact = true;
             capacity = BUSTER_ARENA_COMPACT_BYTES;
             mapping_bytes = arena_mapping_bytes(capacity);
-            mapping = mmap(0, mapping_bytes, PROT_NONE, arena_reservation_flags(capacity, small, mapping_bytes), -1, 0);
+            mapping = arena_reservation_map(mapping_bytes, arena_reservation_flags(capacity, small, mapping_bytes), pool);
         }
         if (mapping != MAP_FAILED)
         {
@@ -962,7 +1045,7 @@ static Arena arena_reserve_tables(ArenaTable* tables, uint32_t count)
         // (arena_stack_base_pages: MAP_STACK) or else by advice.
         const bool advised = bytes >= BUSTER_ARENA_HUGE_PAGE_BYTES;
         const int flags = MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | (advised && arena_stack_base_pages ? MAP_STACK : 0);
-        uint8_t* mapping = allowed ? mmap(0, mapping_bytes, PROT_NONE, flags, -1, 0) : MAP_FAILED;
+        uint8_t* mapping = allowed ? arena_reservation_map(mapping_bytes, flags, pool) : MAP_FAILED;
         if (mapping != MAP_FAILED)
         {
             // The base, `phase` past a huge-page boundary, a page or more past the mapping's start (and so at most a huge
@@ -1256,8 +1339,22 @@ static void arena_unaccounted(Arena* arena, uint64_t at)
     arena->capacity = room < arena->capacity ? room : arena->capacity;
 }
 
+// The most of an arena's base pages that its first commit makes writable at once where commit charge is unbounded, and
+// the factor its later commits grow by there (arena_commit).
+#define BUSTER_ARENA_COMMIT_BYTES (16ull << 20)
+#define BUSTER_ARENA_COMMIT_GROWTH 4
+
 // Cold path: amortize protection changes geometrically, keeping tiny arenas in base pages and the huge-page region
 // aligned. The descriptor is published only after mprotect succeeds: a failed push changes neither length nor peak.
+//
+// How much a commit takes past what its push needs is a matter of system calls alone where the kernel charges no
+// commit (arena_limits.commit_unbounded, #2873): writable pages that are never written cost nothing, and each
+// mprotect about 6,000 kernel cycles on the 9700X. There the first commit takes all of the arena's base pages, up to
+// BUSTER_ARENA_COMMIT_BYTES (an arena of a few megabytes of base pages committed 64 KB, then a page, then doubled: six
+// calls for 800 KB), and later ones BUSTER_ARENA_COMMIT_GROWTH times what is committed. A core dump walks a written
+// mapping whole, so what is committed stays a small multiple of what is used. Where commit is charged (strict
+// overcommit, a finite RLIMIT_DATA) or the limits aren't fixed, a commit takes 64 KB at first and then doubles, as
+// before, so that the charge stays within twice the use (#1521).
 static bool arena_commit(Arena* arena, uint64_t end)
 {
     const uint64_t offset = arena->mapping_offset;
@@ -1271,7 +1368,11 @@ static bool arena_commit(Arena* arena, uint64_t end)
     else if (arena->mapping_bytes != 0 && needed > committed)
     {
         const uint64_t used = committed > offset ? committed - offset : 0;
-        uint64_t grown = used > BUSTER_ARENA_SMALL_BYTES ? used * 2 : BUSTER_ARENA_SMALL_BYTES;
+        const bool unbounded = arena_limits.fixed && arena_limits.commit_unbounded;
+        const uint64_t base_pages = arena->small < BUSTER_ARENA_COMMIT_BYTES ? arena->small : BUSTER_ARENA_COMMIT_BYTES;
+        const uint64_t charged = used > BUSTER_ARENA_SMALL_BYTES ? used * 2 : BUSTER_ARENA_SMALL_BYTES;
+        const uint64_t free = used < base_pages ? base_pages : used * BUSTER_ARENA_COMMIT_GROWTH;
+        uint64_t grown = unbounded ? free : charged;
         grown = grown > end ? grown : end;
         grown = grown < arena->capacity ? grown : arena->capacity;
         uint64_t target = (offset + grown + BUSTER_ARENA_PAGE_BYTES - 1) & ~(BUSTER_ARENA_PAGE_BYTES - 1);
diff --git a/src/buster/compiler/lane_test.c b/src/buster/compiler/lane_test.c
index 24b123b33..e448ea9e5 100644
--- a/src/buster/compiler/lane_test.c
+++ b/src/buster/compiler/lane_test.c
@@ -595,10 +595,197 @@ static void lane_test_stack_base_pages(LaneTestTally* tally)
     arena_stack_base_pages = was_stack;
 }
 
+// Whether [mapping, mapping + bytes) is inside the region of reservations `kind` (arena_regions), where it was mapped.
+// A mapping of a reservation's own can be there too, in the hole a released arena left: lane_test_carved says which.
+static bool lane_test_in_region(uint32_t kind, uintptr_t mapping, uint64_t bytes)
+{
+    const uintptr_t region = __atomic_load_n(&arena_regions[kind].base, __ATOMIC_ACQUIRE);
+    return region > BUSTER_ARENA_REGION_REFUSED && mapping >= region && mapping + bytes <= region + BUSTER_ARENA_REGION_BYTES;
+}
+
+// The bytes carved so far from the region of reservations `kind`.
+static uint64_t lane_test_carved(uint32_t kind)
+{
+    return __atomic_load_n(&arena_regions[kind].carved, __ATOMIC_RELAXED);
+}
+
+// Reservations taken together (#2873: arena_reservation_map). With the limits fixed and the address space unlimited,
+// as a compile's command has them: two arenas reserved one after the other are next to each other in one region, each
+// zero-filled and writable where it pushed, as an arena of its own mapping is; the first's release unmaps it and
+// leaves the second as it was; an arena of base pages and an arena of tables come from the regions of their own
+// mappings' flags; a pool takes a released arena and gives the same one back; commits take an arena's base pages at
+// once and then four times what is committed where the kernel charges none, 64 KB and then twice where it does
+// (arena_commit); and a region with no room left, a thread
+// switched to compact reservations and limits that aren't fixed each leave a reservation a mapping of its own, in no
+// region. Where the build has no regions (a sanitizer's) or the kernel refused one, every reservation has its own. In
+// a process of its own (lane_test_arena_regions), since a region's bytes count against the address-space limit that
+// the checks after this one lower.
+static void lane_test_arena_regions_child(LaneTestTally* tally)
+{
+    static ArenaPool pool;
+    const ArenaLimits was_limits = arena_limits;
+    const bool was_compact = arena_compact;
+    ArenaPool* was_pool = arena_pool;
+    arena_pool = 0;
+    arena_compact = false;
+    arena_limits = (ArenaLimits){
+        .fixed = true,
+        .address_share = BUSTER_ARENA_MAX_CAPACITY,
+        .commit_unbounded = true,
+    };
+    Arena first = arena_reserve(BUSTER_LANE_TEST_LARGE_ARENA);
+    Arena second = arena_reserve(BUSTER_LANE_TEST_LARGE_ARENA);
+    const uintptr_t first_mapping = (uintptr_t)first.base - first.mapping_offset;
+    const uintptr_t second_mapping = (uintptr_t)second.base - second.mapping_offset;
+    const bool regions = BUSTER_ARENA_REGIONS && lane_test_in_region(0, first_mapping, first.mapping_bytes);
+    const bool together = lane_test_in_region(0, second_mapping, second.mapping_bytes) && second_mapping == first_mapping + first.mapping_bytes;
+    lane_test_expect(tally, first.base != 0 && second.base != 0 && (!regions || together), "two reservations weren't next to each other in a region");
+    lane_test_expect(tally, BUSTER_ARENA_REGIONS || !lane_test_in_region(0, first_mapping, first.mapping_bytes), "a build without regions took a reservation from one");
+    uint8_t* first_bytes = first.base != 0 ? arena_push(&first, 3 * BUSTER_ARENA_PAGE_BYTES, 1) : 0;
+    uint8_t* second_bytes = second.base != 0 ? arena_push(&second, BUSTER_ARENA_SMALL_BYTES + BUSTER_ARENA_HUGE_PAGE_BYTES, 1) : 0;
+    bool zero = first_bytes != 0 && second_bytes != 0;
+    for (uint64_t i = 0; zero && i < 3 * BUSTER_ARENA_PAGE_BYTES; i += 1)
+    {
+        zero = first_bytes[i] == 0 && second_bytes[i] == 0;
+    }
+    if (first_bytes != 0 && second_bytes != 0)
+    {
+        memset(first_bytes, 0x5a, 3 * BUSTER_ARENA_PAGE_BYTES);
+        memset(second_bytes, 0xa5, BUSTER_ARENA_SMALL_BYTES + BUSTER_ARENA_HUGE_PAGE_BYTES);
+    }
+    lane_test_expect(tally, zero, "a reservation from a region wasn't zero-filled where it pushed");
+    // The first's release unmaps its part of the region: the kernel has no page there, and the second keeps its bytes.
+    const uint8_t* first_page = first.base;
+    arena_release(&first);
+    unsigned char vector = 0;
+    const bool unmapped = first_page != 0 && mincore((void*)((uintptr_t)first_page & ~(uintptr_t)(BUSTER_ARENA_PAGE_BYTES - 1)), BUSTER_ARENA_PAGE_BYTES, &vector) != 0 && errno == ENOMEM;
+    const bool kept = second_bytes != 0 && second_bytes[0] == 0xa5 && second_bytes[BUSTER_ARENA_SMALL_BYTES + BUSTER_ARENA_HUGE_PAGE_BYTES - 1] == 0xa5;
+    lane_test_expect(tally, unmapped && kept, "a released reservation of a region stayed mapped, or its neighbour lost its bytes");
+    arena_release(&second);
+    // The other flags' regions: base pages of 2 MB or more (MAP_STACK where the kernel maps them so), and tables.
+    Arena wide = arena_reserve_small(BUSTER_LANE_TEST_LARGE_ARENA, 4 * BUSTER_ARENA_HUGE_PAGE_BYTES);
+    ArenaTable tables[] = {
+        { .bytes = 3 * BUSTER_ARENA_HUGE_PAGE_BYTES, .small = BUSTER_ARENA_HUGE_PAGE_BYTES },
+        { .bytes = BUSTER_ARENA_SMALL_BYTES, .small = BUSTER_ARENA_SMALL_BYTES },
+    };
+    Arena held = arena_reserve_tables(tables, BUSTER_ARRAY_LENGTH(tables));
+    const uint32_t wide_kind = arena_stack_base_pages ? 1 : 0;
+    const uint32_t held_kind = 2 | (arena_stack_base_pages ? 1 : 0);
+    const bool wide_placed = wide.base != 0 && (!regions || lane_test_in_region(wide_kind, (uintptr_t)wide.base - wide.mapping_offset, wide.mapping_bytes));
+    const bool held_placed = held.base != 0 && (!regions || lane_test_in_region(held_kind, (uintptr_t)held.base - held.mapping_offset, held.mapping_bytes));
+    bool found = false;
+    const bool uncharged = held.base != 0 && lane_test_vm_flag((uintptr_t)tables[0].base, "nr", &found) && found;
+    const bool tabled = held.base != 0 && ((uint8_t*)tables[0].base)[0] == 0 && ((uint8_t*)tables[1].base)[BUSTER_ARENA_SMALL_BYTES - 1] == 0;
+    lane_test_expect(tally, wide_placed && held_placed && uncharged && tabled, "an arena of base pages or of tables wasn't in the region of its mapping's flags");
+    arena_release(&wide);
+    arena_release(&held);
+    // A pool takes a released arena of a region and gives the same one back.
+    arena_pool = &pool;
+    Arena pooled = arena_reserve(BUSTER_LANE_TEST_LARGE_ARENA);
+    const uint8_t* pooled_base = pooled.base;
+    uint8_t* pooled_bytes = pooled.base != 0 ? arena_push(&pooled, BUSTER_ARENA_SMALL_BYTES, 1) : 0;
+    const bool pooled_pushed = pooled_bytes != 0;
+    if (pooled_pushed)
+    {
+        memset(pooled_bytes, 0x77, BUSTER_ARENA_SMALL_BYTES);
+    }
+    arena_release(&pooled);
+    Arena again = arena_reserve(BUSTER_LANE_TEST_LARGE_ARENA);
+    const uint8_t* again_bytes = again.base != 0 ? arena_push(&again, BUSTER_ARENA_PAGE_BYTES, 1) : 0;
+    lane_test_expect(tally, pooled_pushed && again.base == pooled_base && again_bytes != 0 && again_bytes[0] == 0, "a pool didn't give a region's arena back, emptied");
+    arena_release(&again);
+    arena_pool_release(&pool);
+    arena_pool = 0;
+    // Commits where the kernel charges none (arena_commit): an arena's base pages at once, up to
+    // BUSTER_ARENA_COMMIT_BYTES of them, then BUSTER_ARENA_COMMIT_GROWTH times what is committed; and where it charges,
+    // 64 KB first, whatever the arena's base pages.
+    for (uint32_t charged = 0; charged < 2; charged += 1)
+    {
+        arena_limits.commit_unbounded = charged == 0;
+        Arena based = arena_reserve_small(8 * BUSTER_ARENA_HUGE_PAGE_BYTES, BUSTER_ARENA_HUGE_PAGE_BYTES + BUSTER_ARENA_SMALL_BYTES);
+        Arena widest = arena_reserve_small(BUSTER_LANE_TEST_LARGE_ARENA, 2 * BUSTER_ARENA_COMMIT_BYTES);
+        Arena plain = arena_reserve(BUSTER_LANE_TEST_LARGE_ARENA);
+        const bool pushed = based.base != 0 && widest.base != 0 && plain.base != 0 && arena_push(&based, 1, 1) != 0 && arena_push(&widest, 1, 1) != 0 && arena_push(&plain, 1, 1) != 0;
+        const uint64_t based_first = pushed ? based.committed - based.mapping_offset : 0;
+        const uint64_t widest_first = pushed ? widest.committed - widest.mapping_offset : 0;
+        const uint64_t plain_first = pushed ? plain.committed - plain.mapping_offset : 0;
+        const bool first_commits = charged == 0 ? based_first == BUSTER_ARENA_HUGE_PAGE_BYTES + BUSTER_ARENA_SMALL_BYTES && widest_first == BUSTER_ARENA_COMMIT_BYTES && plain_first == BUSTER_ARENA_SMALL_BYTES :
+                                                  based_first == BUSTER_ARENA_SMALL_BYTES && widest_first == BUSTER_ARENA_SMALL_BYTES && plain_first == BUSTER_ARENA_SMALL_BYTES;
+        // Past what is committed: four times it where nothing is charged, twice where it is (the plain arena's to its
+        // next huge page boundary, at least).
+        const bool more = pushed && arena_push(&widest, widest_first, 1) != 0 && arena_push(&plain, plain_first, 1) != 0;
+        const uint64_t widest_second = more ? widest.committed - widest.mapping_offset : 0;
+        const uint64_t plain_second = more ? plain.committed - plain.mapping_offset : 0;
+        // Where commit is charged, a commit past the first 64 KB takes what its push needs, within twice what was
+        // committed.
+        const bool widest_grew = charged == 0 ? widest_second == BUSTER_ARENA_COMMIT_GROWTH * widest_first : widest_second > widest_first && widest_second <= 2 * widest_first + BUSTER_ARENA_PAGE_BYTES;
+        const uint64_t factor = charged == 0 ? BUSTER_ARENA_COMMIT_GROWTH : 2;
+        const bool second_commits = widest_grew && plain_second >= factor * plain_first && plain_second < factor * plain_first + BUSTER_ARENA_HUGE_PAGE_BYTES;
+        if (!pushed || !first_commits || !more || !second_commits)
+        {
+            printf("  arenas: with commit %s, first commits of %llu, %llu and %llu bytes, then %llu and %llu\n", charged == 0 ? "uncharged" : "charged", (unsigned long long)based_first,
+                   (unsigned long long)widest_first, (unsigned long long)plain_first, (unsigned long long)widest_second, (unsigned long long)plain_second);
+        }
+        lane_test_expect(tally, pushed && first_commits && more && second_commits, "an arena's commits weren't its base pages and then a multiple of what it had committed");
+        arena_release(&based);
+        arena_release(&widest);
+        arena_release(&plain);
+    }
+    // No room left in the region, compact reservations, and limits that aren't fixed: a mapping of the reservation's own,
+    // which carves nothing.
+    arena_limits.commit_unbounded = true;
+    const uint64_t carved = lane_test_carved(0);
+    __atomic_store_n(&arena_regions[0].carved, BUSTER_ARENA_REGION_BYTES - BUSTER_ARENA_PAGE_BYTES, __ATOMIC_RELAXED);
