+// Throwaway page map (#3586): which 4 KB pages of an arena are resident, by 2 MB region and by allocation site; a
+// page is charged to every site whose allocation overlaps it.
+static void fast_arena_report(const FastArena* a, const char* name)
+{
+    if (a->base != NULL && a->used != 0)
+    {
+        const uint64_t pages = (a->used + 4095u) / 4096u;
+        unsigned char* vec = (unsigned char*)malloc(pages);
+        if (vec != NULL && mincore(a->base, pages * 4096u, vec) == 0)
+        {
+            uint64_t total = 0;
+            for (uint64_t i = 0; i < pages; i += 1) { total += vec[i] & 1u; }
+            fprintf(stderr, "arena %s used %llu pages %llu resident-4k %llu (%.2f MB)\n", name, (unsigned long long)a->used, (unsigned long long)pages, (unsigned long long)total, (double)total * 4096.0 / 1e6);
+            for (uint64_t r = 0; r < (pages + 511u) / 512u; r += 1)
+            {
+                uint64_t n = 0;
+                for (uint64_t i = r * 512u; i < pages && i < (r + 1u) * 512u; i += 1) { n += vec[i] & 1u; }
+                fprintf(stderr, "  region %s %2llu: %3llu of 512 pages\n", name, (unsigned long long)r, (unsigned long long)n);
+            }
+            // Sites in first-allocation order.
+            for (uint32_t t = 0; t < fast_arena_trace_count; t += 1)
+            {
+                const FastArenaTrace* tr = fast_arena_traces + t;
+                bool first = tr->arena == a;
+                for (uint32_t u = 0; first && u < t; u += 1)
+                {
+                    first = !(fast_arena_traces[u].arena == a && fast_arena_traces[u].line == tr->line && strcmp(fast_arena_traces[u].file, tr->file) == 0);
+                }
+                if (first)
+                {
+                    uint64_t count = 0, bytes = 0, span = 0, resident = 0, lo = UINT64_MAX, hi = 0;
+                    for (uint32_t u = t; u < fast_arena_trace_count; u += 1)
+                    {
+                        const FastArenaTrace* x = fast_arena_traces + u;
+                        if (x->arena == a && x->line == tr->line && strcmp(x->file, tr->file) == 0)
+                        {
+                            count += 1;
+                            bytes += x->size;
+                            const uint64_t f = x->offset / 4096u;
+                            const uint64_t l = (x->offset + x->size + 4095u) / 4096u;
+                            if (f < lo) { lo = f; }
+                            if (l > hi) { hi = l; }
+                            span += l - f;
+                            for (uint64_t i = f; i < l && i < pages; i += 1) { resident += vec[i] & 1u; }
+                        }
+                    }
+                    const char* f = strrchr(tr->file, '/');
+                    fprintf(stderr, "  alloc %s %-18s:%-5d n %5llu off %9llu bytes %9llu pages %5llu resident %5llu\n", name, f != NULL ? f + 1 : tr->file, tr->line,
+                            (unsigned long long)count, (unsigned long long)tr->offset, (unsigned long long)bytes, (unsigned long long)span, (unsigned long long)resident);
+                }
+            }
+        }
+        free(vec);
+    }
+}
 
