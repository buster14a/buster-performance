+        case 'e': pp->macros[image->macro_count / 2].location ^= 1; break;
+        case 'n': pp->macro_of[root->ids + 1] = 1; break;
+        case 'p': pp->poisoned[0] = 2; break;
+        case 'r': pp->record_data[BUSTER_PP_MAX_FILES - 1] = 1; break;
