+        const uint8_t* const next = arena_push(&arena, 16, 1);
+        lane_test_expect(tally, rewound && next == memory + 2 * page + 9 && lane_test_zero(next, 16), "a rewound arena didn't keep its bytes to its length and none past it");
+    }
+    arena_release(&arena);
+}
