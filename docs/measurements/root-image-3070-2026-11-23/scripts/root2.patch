+    _Static_assert(BUSTER_ARRAY_LENGTH(all) <= BUSTER_PP_ROOT_TABLES, "a root lists every table of the unit's that has a count");
+    uint32_t count = 0;
+    for (uint32_t i = 0; i < BUSTER_ARRAY_LENGTH(all); i += 1)
+    {
