+    }
+    const uint8_t* named = pp_root_scan(macro_of + ids * sizeof(PPMacroId), macro_of + limit * sizeof(PPMacroId), 0);
+    const uint8_t* marked = pp_root_scan(is_macro + words * sizeof(uint64_t), is_macro + limit / 64 * sizeof(uint64_t), 0);
+    if (named != 0 || marked != 0)
