The census of what a unit's releases hold (section 1): in arena_release (src/buster/compiler/lane.c), after `extent` is
computed and before the discard, with BUSTER_X_RELEASE_LOG set. Applied to main b7d0b5ed for the run and not kept.

        if (pool != 0 && getenv("BUSTER_X_RELEASE_LOG") != 0)
        {
            // Census: the resident pages of the writable prefix, and the last nonzero byte among them, from base.
            const uint64_t pages = (extent - begin) / BUSTER_ARENA_PAGE_BYTES;
            static _Thread_local unsigned char* vec;
            static _Thread_local uint64_t vec_pages;
            if (pages > vec_pages)
            {
                free(vec);
                vec = malloc(pages);
                vec_pages = pages;
            }
            uint64_t resident = 0;
            uint64_t last = 0;
            if (pages != 0 && mincore(mapping + begin, extent - begin, vec) == 0)
            {
                for (uint64_t p = 0; p < pages; p += 1)
                {
                    if (vec[p] & 1)
                    {
                        resident += 1;
                        const uint8_t* page = mapping + begin + p * BUSTER_ARENA_PAGE_BYTES;
                        for (uint64_t b = 0; b < BUSTER_ARENA_PAGE_BYTES; b += 1)
                        {
                            last = page[b] != 0 ? begin + p * BUSTER_ARENA_PAGE_BYTES + b + 1 : last;
                        }
                    }
                }
            }
            const uint64_t offset = arena->mapping_offset;
            fprintf(stderr, "REL map=%llu cap=%llu small=%llu layout=%d peak=%llu length=%llu committed=%llu writable=%llu resident=%llu last=%lld caller=%p\n",
                    (unsigned long long)bytes, (unsigned long long)arena->capacity, (unsigned long long)arena->small, arena->layout != 0,
                    (unsigned long long)arena->peak, (unsigned long long)arena->length, (unsigned long long)(arena->committed - offset),
                    (unsigned long long)(extent - offset), (unsigned long long)resident, last == 0 ? -1ll : (long long)(last - offset), __builtin_return_address(0));
        }
