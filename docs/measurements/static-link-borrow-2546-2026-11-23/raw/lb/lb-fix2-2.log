exclusive.sh: waiting for the 9700X, held by: 2026-11-23T01:52:04+00:00 claude-2830: bash -c state () 
{ 
    echo "--- $(date -u +%FT%TZ) $1";
    cat /proc/loadavg;
    ps -eo psr,pcpu,pid,etimes,user,comm --sort=-pcpu | head -6
}; state kernels; i=0
for k in $(out/kernels/h-base list); do
    if [ $((i % 2)) = 0 ]; then order='base head'; else order='head base'; fi
    for name in $order; do
        H=out/kernels/h-$name
        line=$(taskset -c 2 $H $k 0 2>&1)
        reps=$(echo "$line" | cut -d' ' -f3)
        taskset -c 2 perf stat -x, -e cycles:u,instructions:u -o out/kernels/perf.txt -- $H $k $reps > /dev/null 2>&1
        echo "$name $line | cycles $(grep cycles out/kernels/perf.txt | cut -d, -f1) instructions $(grep instructions out/kernels/perf.txt | cut -d, -f1)"
    done
    i=$((i + 1))
done
state kernels-end
