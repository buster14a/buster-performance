+// #847 diagnostic: each region's state from /proc/self/pagemap at its first byte: 'o' its own page (present and
+// exclusively mapped), 'z' present but not its own (the huge zero page), '-' not present.
+static void check_deferred_diag_regions(uint8_t* begin, uint8_t* end, char* out)
+{
+    const uintptr_t region = (uintptr_t)1 << 21;
+    const int fd = open("/proc/self/pagemap", O_RDONLY);
+    uint32_t n = 0;
+    for (uintptr_t at = (uintptr_t)begin; at < (uintptr_t)end && n < 63; at = (at & ~(region - 1)) + region)
+    {
+        uint64_t entry = 0;
+        const bool read = fd >= 0 && pread(fd, &entry, 8, (off_t)((at >> 12) * 8)) == 8;
+        out[n] = !read ? '?' : (entry >> 63) == 0 ? '-' : ((entry >> 56) & 1) != 0 ? 'o' : 'z';
+        n += 1;
+    }
+    out[n] = 0;
+    if (fd >= 0)
+    {
+        close(fd);
+    }
+}
