+// A measurement's dump (buster#2524's record, not a compile's): with BUSTER_INVENTORY_DUMP naming a file, each body's
+// entries with each one's owner's pop, and every pop's node, parent, entry range, flags, category and key, for a
+// prototype of the node machine's sweeps to read. Called before the body's node_pop entries are reset.
+static void lower_inventory_dump(const LowerInventoryScratch* s, const CheckProgram* program, const Tier0Function* function, const uint32_t* owners,
+                                 const CheckLowerOwnerPop* pops, uint32_t count)
+{
+    static FILE* file;
+    static bool opened;
+    if (!opened)
+    {
+        const char* path = getenv("BUSTER_INVENTORY_DUMP");
+        file = path != NULL ? fopen(path, "wb") : NULL;
+        opened = true;
+    }
+    if (file != NULL)
+    {
+        const uint32_t none = BUSTER_CHECK_NONE;
+        const uint32_t header[3] = { UINT32_C(0x59444f42), count, function->count };
+        fwrite(header, sizeof(header), 1, file);
+        fwrite(function->kinds, 1, function->count, file);
+        fwrite(function->classes, 1, function->count, file);
+        fwrite(function->values, sizeof(uint64_t), function->count, file);
+        for (uint32_t e = 0; e < function->count; e += 1)
+        {
+            // The owner's pop and what the entry is to it: 0 its own, 1 a conversion it asked of an operand, 2 a
+            // control's, 3 a token's, 4 a node's without a pop.
+            const uint32_t owner = owners[e];
+            uint32_t record[2] = { none, 4 };
+            if ((owner & BUSTER_CHECK_LOWER_OWNER_TOKEN) == BUSTER_CHECK_LOWER_OWNER_TOKEN)
+            {
+                record[1] = 3;
+            }
+            else if ((owner & BUSTER_CHECK_LOWER_OWNER_CONTROL) != 0)
+            {
+                record[1] = 2;
+            }
+            else
+            {
+                const uint32_t node = owner & ~BUSTER_CHECK_LOWER_OWNER_CONVERSION;
+                record[0] = node < program->stream->count ? s->node_pop[node] : none;
+                record[1] = record[0] == none ? 4 : (owner & BUSTER_CHECK_LOWER_OWNER_CONVERSION) != 0 ? 1 : 0;
+            }
+            fwrite(record, sizeof(record), 1, file);
+        }
+        for (uint32_t p = 0; p < count; p += 1)
+        {
+            const uint32_t node = pops[p].node;
+            const bool first = s->node_pop[node] == p;
+            uint8_t key[BUSTER_LOWER_INVENTORY_KEY_BYTES] = { 0 };
+            if (first)
+            {
+                lower_inventory_key(key, program, pops + p);
+            }
+            // The node's own type and its first three operands' pops, beside the key's classes.
+            const CheckGraph* graph = &program->input->graph;
+            const uint32_t operands[3] = { graph->operand0[node], graph->operand1[node], graph->operand2[node] };
+            uint32_t fields[12] = { node, s->parent[p], s->low[p], s->high[p], s->own[p], pops[p].flags,
+                                    first ? (uint32_t)lower_inventory_category(program, node, pops[p].flags, s->times[p] > 1) : none, s->times[p],
+                                    check_stream_type(program->stream, node), none, none, none };
+            for (uint32_t i = 0; i < 3; i += 1)
+            {
+                fields[9 + i] = operands[i] < program->stream->count ? s->node_pop[operands[i]] : none;
+            }
+            fwrite(fields, sizeof(fields), 1, file);
+            fwrite(key, sizeof(key), 1, file);
+        }
+        fflush(file);
+    }
+}
