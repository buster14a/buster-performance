"$BUSTER_COMPILER" interpret-c tests/interpreter/units-main.c tests/interpreter/units-library.c > build/typed-units.out && printf 'typed units: 1\n' | cmp - build/typed-units.out
== Typed C suite [4 CPUs]
"$BUSTER_COMPILER" test-ssa-source --typed $(sed -n 's|^\([0-9][0-9]*\)$|/home/david/buster-fast-bench/590-claude/c-testsuite/tests/single-exec/\1.c|p' tests/c-testsuite/subset.txt)
== Independent native source fixtures [2 CPUs]
/usr/bin/clang -std=gnu17 tests/interpreter/source.c -o build/source-clang && build/source-clang > build/source-clang.out && cmp tests/interpreter/source.c.expected build/source-clang.out
"$BUSTER_COMPILER" tests/interpreter/source.c -o build/source-tier0 && build/source-tier0 > build/source-tier0.out && cmp tests/interpreter/source.c.expected build/source-tier0.out
"$BUSTER_COMPILER" --tier1 tests/interpreter/source.c -o build/source-tier1 && build/source-tier1 > build/source-tier1.out && cmp tests/interpreter/source.c.expected build/source-tier1.out
/usr/bin/clang -std=gnu17 tests/interpreter/units-main.c tests/interpreter/units-library.c -o build/units-clang && build/units-clang > build/units-clang.out && cmp build/typed-units.out build/units-clang.out
== Repository syntax check
