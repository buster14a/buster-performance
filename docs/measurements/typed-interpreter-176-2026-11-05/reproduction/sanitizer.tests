== Typed source execution [4 CPUs]
"$BUSTER_COMPILER" test-ssa-source --typed --self-test
"$BUSTER_COMPILER" test-ssa-source --typed --generate 16 --seed 176 --clang /usr/bin/clang
"$BUSTER_COMPILER" test-ssa-source --typed tests/interpreter/source.c
"$BUSTER_COMPILER" interpret-c tests/interpreter/units-main.c tests/interpreter/units-library.c > build/typed-units-asan.out && printf 'typed units: 1\n' | cmp - build/typed-units-asan.out
