== Interpreter regression
"$BUSTER_COMPILER" test-interpreter
"$BUSTER_COMPILER" test-interpreter-link
== Linked units and absent weak addresses [2 CPUs]
"$BUSTER_COMPILER" interpret-c --check-undefined tests/interpreter/units-main.c tests/interpreter/units-library.c > build/units-final.out && printf 'typed units: 1\n' | cmp - build/units-final.out
/usr/bin/clang -std=gnu17 tests/interpreter/units-main.c tests/interpreter/units-library.c -o build/units-final-clang && build/units-final-clang > build/units-final-clang.out && printf 'typed units: 1\n' | cmp - build/units-final-clang.out
"$BUSTER_COMPILER" tests/interpreter/units-main.c tests/interpreter/units-library.c -o build/units-final-tier0 && build/units-final-tier0 > build/units-final-tier0.out && printf 'typed units: 1\n' | cmp - build/units-final-tier0.out
"$BUSTER_COMPILER" --tier1 tests/interpreter/units-main.c tests/interpreter/units-library.c -o build/units-final-tier1 && build/units-final-tier1 > build/units-final-tier1.out && printf 'typed units: 1\n' | cmp - build/units-final-tier1.out
