+// EXPERIMENT (not for merge): whether BUSTER_EXPERIMENT_SKIP's mask leaves `bit`'s work out.
+static bool check_experiment_skipped(uint32_t bit)
+{
+    const char* text = getenv("BUSTER_EXPERIMENT_SKIP");
+    return text != NULL && ((uint32_t)strtoul(text, NULL, 0) & (1u << bit)) != 0;
+}
+
 typedef struct CheckCommonNote CheckCommonNote;
