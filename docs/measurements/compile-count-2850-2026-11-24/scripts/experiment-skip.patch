+        if (!SKIPPED(11)) check_common_sizeof_array_decay(parser, pp, input, stream, types, &spell, scratch);
+        if (!SKIPPED(12)) check_common_shift_sign_overflow(parser, pp, input, stream, types, &spell, scratch);
