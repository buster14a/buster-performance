+        if (!SKIPPED(6)) check_common_parentheses(parser, pp, input, stream, types, scratch);
+        if (!SKIPPED(7)) check_common_chained_comparisons(parser, pp, input, scratch);
+        if (!SKIPPED(8)) check_common_shift_op_parentheses(parser, pp, input, scratch);
+        if (!SKIPPED(9)) check_common_assign_enum(parser, pp, input, stream, types, &spell, program, scratch);
