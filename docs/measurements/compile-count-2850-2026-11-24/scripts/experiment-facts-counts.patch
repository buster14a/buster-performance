+// EXPERIMENT (not for merge): BUSTER_EXPERIMENT_SKIP's mask of work left out, read once.
+static uint32_t check_experiment_mask(void)
+{
+    static uint32_t mask;
+    static bool read;
+    if (!read)
+    {
+        const char* text = getenv("BUSTER_EXPERIMENT_SKIP");
+        mask = text != NULL ? (uint32_t)strtoul(text, NULL, 0) : 0;
+        read = true;
+    }
+    return mask;
+}
+
+static bool check_experiment_skipped(uint32_t bit)
+{
+    return (check_experiment_mask() & (1u << bit)) != 0;
+}
+
+// EXPERIMENT (not for merge): counters, printed at exit where BUSTER_EXPERIMENT_COUNTS is set.
+static uint64_t check_experiment_candidate_ops[1024];
+static uint64_t check_experiment_set_ops[1024];
+static uint64_t check_experiment_bits[256];
+static uint64_t check_experiment_values[32];
+static void check_experiment_dump(void)
+{
+    if (getenv("BUSTER_EXPERIMENT_COUNTS") != NULL)
+    {
+        for (uint32_t i = 0; i < 1024; i += 1)
+        {
+            if (check_experiment_candidate_ops[i] != 0)
+            {
+                fprintf(stderr, "op %u candidates %llu set %llu\n", i, (unsigned long long)check_experiment_candidate_ops[i], (unsigned long long)check_experiment_set_ops[i]);
+            }
+        }
+        for (uint32_t i = 0; i < 256; i += 1)
+        {
+            if (check_experiment_bits[i] != 0)
+            {
+                fprintf(stderr, "bits 0x%02x %llu\n", i, (unsigned long long)check_experiment_bits[i]);
+            }
+        }
+        for (uint32_t i = 0; i < 32; i += 1)
+        {
+            fprintf(stderr, "value %u %llu\n", i, (unsigned long long)check_experiment_values[i]);
+        }
+    }
+}
+static void check_experiment_count(uint32_t index, uint64_t amount)
+{
+    static bool registered;
+    if (!registered)
+    {
+        atexit(check_experiment_dump);
+        registered = true;
+    }
+    check_experiment_values[index] += amount;
+}
