+// EXPERIMENT (not for merge): BUSTER_EXPERIMENT_SKIP's mask of work left out, read once.
+static uint32_t check_experiment_mask(void)
+{
+    static uint32_t mask;
+    static bool read;
+    if (!read)
+    {
+        const char* text = getenv("BUSTER_EXPERIMENT_SKIP");
+        mask = text != NULL ? (uint32_t)strtoul(text, NULL, 0) : 0;
+        read = true;
+    }
+    return mask;
+}
+
+static bool check_experiment_skipped(uint32_t bit)
+{
+    return (check_experiment_mask() & (1u << bit)) != 0;
+}
