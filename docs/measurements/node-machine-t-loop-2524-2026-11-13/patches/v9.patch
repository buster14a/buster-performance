+// What T asks of callee type `source` (a call's callee record's type) at a call, from the type table: its function type
+// (node_machine_callee_function's, 0 for none), that function's return type, and its BUSTER_NODE_MACHINE_CALLEE_* flags.
+static NodeMachineCallee node_machine_callee_answer(const NodeMachine* machine, TypeId source)
+{
+    const TypeTable* types = machine->types;
+    TypeId function = type_strip_aligned(types, source);
+    if (type_kind(types, function) == BUSTER_TYPE_KIND_POINTER)
+    {
+        function = type_strip_aligned(types, type_element(types, function));
+    }
+    function = type_kind(types, function) == BUSTER_TYPE_KIND_FUNCTION ? function : 0;
+    uint32_t answer = BUSTER_NODE_MACHINE_CALLEE_FILLED;
+    TypeId result = 0;
+    if (function != 0)
+    {
+        const uint8_t flags = types->types.flags[type_index(function)];
+        answer |= (flags & BUSTER_TYPE_FLAG_PROTOTYPE) != 0 ? BUSTER_NODE_MACHINE_CALLEE_PROTOTYPE : 0;
+        answer |= (flags & BUSTER_TYPE_FLAG_VARIADIC) != 0 ? BUSTER_NODE_MACHINE_CALLEE_VARIADIC : 0;
+        answer |= type_function_abi_kind(types, function) == TYPE_FUNCTION_ABI_SYSV && !type_function_has_parameter_abis(types, function) ?
+                  BUSTER_NODE_MACHINE_CALLEE_CONVENTION : 0;
+        result = type_return(types, function);
+        // A pointer's call whose first parameter points to a jmp_buf's element (check_lower_indirect_twice).
+        uint32_t parameters = 0;
+        const TypeId* parameter_types = type_parameters(types, function, &parameters);
+        const TypeId first = parameters != 0 ? type_strip_aligned(types, parameter_types[0]) : 0;
+        const TypeId element = first != 0 && type_kind(types, first) == BUSTER_TYPE_KIND_POINTER ? type_unqualified(type_strip_aligned(types, type_element(types, first))) : 0;
+        answer |= element != 0 && type_kind(types, element) == BUSTER_TYPE_KIND_STRUCT && machine->twice_tag != 0 &&
+                  types->tags.name[types->types.index[type_index(element)]] == machine->twice_tag ? BUSTER_NODE_MACHINE_CALLEE_JMP_BUF : 0;
+    }
+    return (NodeMachineCallee){ .source = source, .function = function, .result = result, .answer = answer };
+}
+
+// node_machine_callee_answer for call record `r`'s callee record `a`: from the callee memo (NodeMachine.callee_memo), keyed
+// by the record's type, where the type's first call filled it. Under --verify the table's answer is asked each time too,
+// and an entry that differs from it is the twin's difference.
+static NodeMachineCallee node_machine_callee(NodeMachine* machine, uint32_t a)
+{
+    const TypeId source = machine->columns->value_types[a];
+    NodeMachineCallee* entry = machine->callee_memo + ((source * 0x9e3779b1u) >> (32 - BUSTER_NODE_MACHINE_CALLEE_BITS));
+    NodeMachineCallee answer = *entry;
+    const bool hit = (answer.answer & BUSTER_NODE_MACHINE_CALLEE_FILLED) != 0 && answer.source == source;
+    if (!hit || machine->verify)
+    {
+        const NodeMachineCallee fresh = node_machine_callee_answer(machine, source);
+        machine->twin_differences += hit && (fresh.function != answer.function || fresh.result != answer.result || fresh.answer != answer.answer);
+        machine->callee_fills += !hit;
+        *entry = hit ? answer : fresh;
+        answer = fresh;
+    }
+    return answer;
+}
+
+// Whether function object `object` returns twice (check_lower_calls_twice's test of a direct callee): its program's flag,
+// or its declaration's name one of the unit's names of such functions. From the program's columns the first time, and
+// from NodeMachine.object_twice after; under --verify from both, and a difference is the twin's.
+static bool node_machine_object_twice(NodeMachine* machine, uint32_t object)
+{
+    const uint8_t known = object < machine->object_count ? machine->object_twice[object] : 0;
+    bool twice = known == 2;
+    if (known == 0 || machine->verify)
+    {
+        const CheckProgram* program = machine->program;
+        const uint32_t declaration = program->object_declarations != NULL ? program->object_declarations[object] : BUSTER_CHECK_NONE;
+        const IdentId name = program->parser != NULL && declaration < program->input->token_count ? program->parser->tokens.names[declaration] : 0;
+        bool fresh = program->object_returns_twice != NULL && program->object_returns_twice[object] != 0;
+        for (uint32_t k = 0; k < BUSTER_CHECK_LOWER_TWICE_NAMES; k += 1)
+        {
+            fresh |= name != 0 && machine->twice_names[k] == name;
+        }
+        machine->twin_differences += known != 0 && twice != fresh;
+        if (known == 0 && object < machine->object_count)
+        {
+            machine->object_twice[object] = fresh ? 2 : 1;
+        }
+        twice = fresh;
+    }
+    return twice;
+}
