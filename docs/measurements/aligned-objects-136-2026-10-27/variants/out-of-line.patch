+// The rare declarations of check_lower_part_body's loops over parameters and locals, out of line so that the loops
+// compile as they would without them (#136: inline, they cost -c sqlite3.c 0.06% more instructions): a parameter
+// aligned past 8 bytes (`parameter`), an object of its alignment, which the loop then makes, but refused past 1 GB; and a
+// local value aligned past 8 bytes, whose slot would be aligned to 8, a frame object of its alignment, which LOCAL,
+// STORE_LOCAL and SET_LOCAL of its class read and write (tier0_value_object), but refused as an array no class holds.
+// Returns the local's object (BUSTER_CHECK_NONE for a parameter or a refusal).
+static __attribute__((cold, noinline)) uint32_t check_lower_aligned(CheckLowerWriter* writer, TypeId type, uint32_t alignment_log2, bool parameter)
+{
+    const TypeTable* types = writer->program->types;
+    uint32_t local = BUSTER_CHECK_NONE;
+    if (parameter)
+    {
+        if (alignment_log2 > BUSTER_TIER0_MAX_OBJECT_ALIGNMENT_LOG2)
+        {
+            check_lower_unsupported(writer, "parameters aligned past 1 GB");
+        }
+    }
+    else if (type_kind_is_array(type_kind(types, type_strip_aligned(types, type))))
+    {
+        check_lower_unsupported(writer, "local values aligned past 8 bytes");
+    }
+    else
+    {
+        local = check_lower_object(writer, type_size(types, type), alignment_log2);
+    }
+    return local;
+}
