+// EXPERIMENT (the logical operators' census): the reference's answers of an expression with `&&`, `||`, `?:`, a comma
+// or a selection, a line a record, with its row's entries.
+static __attribute__((noinline)) void node_census_l_reference(const NodeMachine* machine, uint32_t record, uint32_t operand, NodeMachineRefusal swept, uint8_t context,
+                                                              TypeId target, bool tested)
+{
+    const uint32_t count = machine->count;
+    bool any = false;
+    for (uint32_t r = 0; r < count; r += 1)
+    {
+        const CheckOp op = node_machine_record_op(machine, r);
+        any |= op == CHECK_OP_LOGICAL_AND || op == CHECK_OP_LOGICAL_OR || op == CHECK_OP_CONDITIONAL || op == CHECK_OP_COMMA || op == CHECK_OP_SELECT;
+    }
+    if (any)
+    {
+        const bool taken = swept == NODE_MACHINE_TAKEN;
+        printf("le\t%" PRIu64 "\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\n", node_census_l_serial, record, operand, count, (uint32_t)swept, machine->stopped,
+               (uint32_t)context, (uint32_t)target, machine->label_count, taken ? machine->entry_count : 0u, tested ? 1u : 0u,
+               target != 0 ? (uint32_t)node_machine_class(machine, target) : 255u, target != 0 ? (uint32_t)node_machine_facts(machine, target) : 0u);
+        for (uint32_t r = 0; r < count; r += 1)
+        {
+            const uint8_t state = node_machine_record_state(machine, r);
+            const bool evaluated = (state & BUSTER_NODE_MACHINE_EVALUATED) != 0;
+            const TypeId to = node_machine_record_target(machine, r);
+            const TypeId c0 = node_machine_record_converted(machine, r, 0);
+            const TypeId c1 = node_machine_record_converted(machine, r, 1);
+            bool truth = false;
+            const bool known = node_machine_record_constant_kind(machine, r) != CHECK_CONSTANT_NONE && (node_machine_record_flags(machine, r) & BUSTER_CHECK_FP_ENVIRONMENT) == 0 &&
+                               node_machine_record_fault(machine, r) == CHECK_FAULT_NONE && node_machine_record_truth(machine, r, &truth);
+            const bool labeled = evaluated && (state & BUSTER_NODE_MACHINE_BRANCHED) == 0 ? node_machine_record_template(machine, r) == (CheckLowerTemplate)NODE_MACHINE_TEMPLATE_BRANCH :
+                                 evaluated && node_machine_record_past(machine, r);
+            printf("lr\t%" PRIu64 "\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%x\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t", node_census_l_serial, record, operand, r,
+                   (uint32_t)node_machine_record_op(machine, r), node_machine_record_left(machine, r), node_machine_record_right(machine, r),
+                   node_machine_record_op(machine, r) == CHECK_OP_CONDITIONAL ? node_machine_record_third(machine, r) : UINT32_MAX, (uint32_t)state,
+                   (uint32_t)node_machine_record_context(machine, r), evaluated ? (uint32_t)node_machine_record_template(machine, r) : 255u, (uint32_t)to,
+                   (uint32_t)node_machine_record_type(machine, r), (uint32_t)node_machine_record_class(machine, r), (uint32_t)node_machine_record_facts(machine, r),
+                   (uint32_t)c0, (uint32_t)c1, (uint32_t)node_machine_record_constant_kind(machine, r), (uint32_t)node_machine_record_category(machine, r),
+                   node_machine_record_flags(machine, r), evaluated && state > BUSTER_NODE_MACHINE_EVALUATED ? node_machine_record_hook(machine, r) : UINT32_MAX,
+                   labeled ? 1u : 0u, labeled ? node_machine_record_label_base(machine, r) : UINT32_MAX,
+                   to != 0 ? (uint32_t)node_machine_class(machine, to) : 255u, to != 0 ? (uint32_t)node_machine_facts(machine, to) : 0u,
+                   c0 != 0 ? (uint32_t)node_machine_class(machine, c0) : 255u, c1 != 0 ? (uint32_t)node_machine_class(machine, c1) : 255u,
+                   c0 != 0 ? (uint32_t)node_machine_facts(machine, c0) : 0u, c1 != 0 ? (uint32_t)node_machine_facts(machine, c1) : 0u, known ? 1u : 0u, truth ? 1u : 0u);
+            if (taken)
+            {
+                for (uint32_t j = node_census_l_firsts[r]; j < node_census_l_firsts[r + 1]; j += 1)
+                {
+                    printf("%s%u:%u:%" PRIx64, j == node_census_l_firsts[r] ? "" : ",", (uint32_t)machine->kinds[j], (uint32_t)machine->classes[j], machine->tape[j]);
+                }
+            }
+            printf("\n");
+        }
+    }
+}
