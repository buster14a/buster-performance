+// EXPERIMENT (the logical operators' census, BUSTER_CENSUS_L=1; not for a commit): whether it is on, the batch's
+// number, and each record's row's first entry in X's tape.
+static int node_census_l_on = -1;
+static uint64_t node_census_l_serial;
+static uint32_t node_census_l_firsts[4096u + 2u];
+static inline bool node_census_l(void)
+{
+    if (node_census_l_on < 0)
+    {
+        node_census_l_on = getenv("BUSTER_CENSUS_L") != NULL ? 1 : 0;
+    }
+    return node_census_l_on != 0;
+}
