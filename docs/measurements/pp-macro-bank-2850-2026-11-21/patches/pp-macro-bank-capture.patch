+// Each half of the 128-byte bank encodes 64 current macro-name bits. Values above the bank
+// keep their scalar test. Unsigned saturation retains the high bit for all values above 127.
+BUSTER_INLINE uint64_t pp_file_low_bank(const Preprocessor* pp, const uint32_t* values, uint64_t identifiers)
+{
+    const __m128i a = _mm512_cvtusepi32_epi8(_mm512_loadu_si512(values));
+    const __m128i b = _mm512_cvtusepi32_epi8(_mm512_loadu_si512(values + 16));
+    const __m128i c = _mm512_cvtusepi32_epi8(_mm512_loadu_si512(values + 32));
+    const __m128i d = _mm512_cvtusepi32_epi8(_mm512_loadu_si512(values + 48));
+    __m512i indexes = _mm512_inserti32x4(_mm512_castsi128_si512(a), b, 1);
+    indexes = _mm512_inserti32x4(indexes, c, 2);
+    indexes = _mm512_inserti32x4(indexes, d, 3);
+    const __m512i low = _mm512_movm_epi8(pp->is_macro[0]);
+    const __m512i high = _mm512_movm_epi8(pp->is_macro[1]);
+    const __m512i macro = _mm512_permutex2var_epi8(low, indexes, high);
+    return identifiers & _mm512_movepi8_mask(_mm512_or_si512(indexes, macro));
+}
