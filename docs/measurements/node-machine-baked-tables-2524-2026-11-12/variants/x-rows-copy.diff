+// The key of a conversion from a record of class `class` (an aggregate's: `aggregate`) to a type of word `word`.
+static inline uint32_t node_machine_conversion_key(uint8_t class, bool aggregate, uint32_t word)
+{
+    const uint8_t target_class = (uint8_t)word;
+    const uint32_t source = class < BUSTER_TYPED_CLASSES ? class : BUSTER_TYPED_CLASSES;
+    const uint32_t target = target_class < BUSTER_TYPED_CLASSES ? target_class : BUSTER_TYPED_CLASSES;
+    const uint32_t facts = _pext_u32((uint8_t)(word >> 8), BUSTER_NODE_MACHINE_CONVERSION_FACTS);
+    return ((source * BUSTER_NODE_MACHINE_CONVERSION_CLASSES + target) * 2u + (aggregate ? 1u : 0u)) * 16u + facts;
