+// A copy of the machine's unit state and record columns, which a sweep that stores to its own columns between record
+// reads takes before its loop (docs/coding-style.md, "Stable pointer-accessed values"): the build's -fno-strict-aliasing
+// lets any store change the machine as far as the compiler knows, so an accessor reading the machine loads its column's
+// pointer again after each store, where one reading the copy, a local whose address no call takes, keeps it in a
+// register. The copy has no tape, no counters and none of C's or X's own columns but those it reads.
+static inline __attribute__((always_inline)) NodeMachine node_machine_records_copy(const NodeMachine* machine)
+{
+    const NodeMachine copy = {
+        .program = machine->program,
+        .types = machine->types,
+        .graph = machine->graph,
+        .type_words = machine->type_words,
+        .type_count = machine->type_count,
+        .first = machine->first,
+        .count = machine->count,
+        .root = machine->root,
+        .codes = machine->codes,
+        .left = machine->left,
+        .right = machine->right,
+        .values = machine->values,
+        .words = machine->words,
+        .facts = machine->facts,
+        .value_classes = machine->value_classes,
+        .converted = machine->converted,
+        .conversion_flags = machine->conversion_flags,
+        .member_offsets = machine->member_offsets,
+        .states = machine->states,
+        .contexts = machine->contexts,
+        .targets = machine->targets,
+        .templates = machine->templates,
+    };
+    return copy;
+}
