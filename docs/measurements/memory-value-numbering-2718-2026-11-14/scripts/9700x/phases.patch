         {
             ir_memory_addresses_vector(&m);
         }
@@ -1238,6 +1264,7 @@ static bool ir_optimize_memory(IrOptimizeWork* work, Arena* scratch, bool reques
         {
             ir_memory_addresses_scalar(&m);
         }
