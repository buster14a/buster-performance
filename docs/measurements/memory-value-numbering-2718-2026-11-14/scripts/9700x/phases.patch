@@ -1228,8 +1253,9 @@ static bool ir_optimize_memory(IrOptimizeWork* work, Arena* scratch, bool reques
         {
             m.classes[access] = ir_memory_class(&m, m.accesses[access]);
         }
+        PH(0);
 #if BUSTER_HOST_VECTOR
-        if (!scalar)
