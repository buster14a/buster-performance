+static void ir_memory_phase_report(void)
+{
+    for (int v = 0; v < 2; v += 1)
+    {
+        fprintf(stderr, "memory-phases %s calls=%llu:", v ? "scalar" : "vector", (unsigned long long)ir_memory_calls[v]);
