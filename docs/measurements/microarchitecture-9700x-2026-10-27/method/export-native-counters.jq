($catalog[0] | map(select(.EventType == "Kernel PMU event" and ((.Encoding // "") | startswith("cpu/")))) | map({key:.EventName,value:.Encoding}) | from_entries) as $enc |
(["host","scope","event","encoding","count","source_bytes","per_source_byte","per_1000_instructions","per_user_cycle","cycles_u_same_run","instructions_u_same_run","running_percent_min","counter_errors","compile_failures","status","cohort"] | @csv),
(sort_by(.label)[] | ["9700x","user",.raw_event,$enc[.raw_event],.raw_event_count,.completed_bytes,(.raw_event_count/.completed_bytes),(.raw_event_count*1000/.instructions_u),(.raw_event_count/.cycles_u),.cycles_u,.instructions_u,.counter_min_running_pct,.counter_errors,.failures,(if .counter_errors > 0 then "collection_error" elif .failures > 0 then "compile_failure" elif .counter_min_running_pct < 99.9 then "multiplexed" elif .raw_event_count == 0 then "measured_zero" else "measured" end),.label] | @csv)
