+static PPPrepareStatus pp_prepare_structural_primary(Preprocessor* pp, PPFileData* data, const PPPrepare* prepare, uint64_t* ticks)
+{
+    const PPFileData original = *data;
+    const uint8_t* bytes = original.bytes;
+    const uint32_t length = original.length;
+    const uint32_t min_span = 4096;
+    PPDeferredSpan* spans = arena_push_array(&pp->arena, (uint64_t)length / min_span + 1, sizeof(PPDeferredSpan), _Alignof(PPDeferredSpan));
+    uint32_t count = 0, previous_hash = 0, first = 0;
+    bool have_previous = false;
+    for (uint32_t base = 0; spans != NULL && base < length; base += 64)
+    {
+        const __mmask64 valid = length - base < 64 ? _bzhi_u64(~0ull, length - base) : ~0ull;
+        const __m512i row = _mm512_maskz_loadu_epi8(valid, bytes + base);
+        uint64_t hits = _mm512_mask_cmpeq_epi8_mask(valid, row, _mm512_set1_epi8('#'));
+        while (hits != 0)
+        {
+            const uint32_t hash = base + (uint32_t)__builtin_ctzll(hits);
+            hits &= hits - 1;
+            uint32_t line = hash;
+            while (line != 0 && (bytes[line - 1] == ' ' || bytes[line - 1] == '\t')) { line -= 1; }
+            if (line != 0 && bytes[line - 1] != '\n') { continue; }
+            if (have_previous && line >= first && line - first >= min_span && pp_plain_source_range(bytes, first, line, prepare->refine_flags))
+            {
+                spans[count++] = (PPDeferredSpan){ .before = previous_hash, .begin = first, .end = line, .after = hash };
+            }
+            const uint8_t* nl = memchr(bytes + hash, '\n', length - hash);
+            const uint32_t end = nl != NULL ? (uint32_t)(nl - bytes) + 1 : length;
+            have_previous = nl != NULL && (end < 2 || bytes[end - 2] != '\\');
+            previous_hash = hash;
+            first = end;
+        }
+    }
+    uint8_t* masked = count != 0 ? arena_push(&pp->arena, length, 64) : NULL;
+    if (count == 0 || masked == NULL)
+    {
+        return pp_prepare_into(prepare, pp->table, pp->columns, &pp->arena, data, ticks);
+    }
+    memcpy(masked, bytes, length);
+    for (uint32_t i = 0; i < count; i += 1)
+    {
+        const uint32_t begin = spans[i].begin, end = spans[i].end;
+        for (uint32_t j = begin; j < end; j += 64)
+        {
+            const __mmask64 valid = end - j < 64 ? _bzhi_u64(~0ull, end - j) : ~0ull;
+            const __m512i row = _mm512_maskz_loadu_epi8(valid, bytes + j);
+            const __m512i fill = _mm512_mask_mov_epi8(_mm512_set1_epi8(' '), _mm512_cmpeq_epi8_mask(row, _mm512_set1_epi8('\n')), row);
+            _mm512_mask_storeu_epi8(masked + j, valid, fill);
+        }
+        uint32_t marker = begin;
+        while (marker < end && bytes[marker] == '\n') { marker += 1; }
+        spans[i].marker = marker;
+        masked[marker] = '0';
+    }
+    data->bytes = masked;
+    PPPrepareStatus result = pp_prepare_into(prepare, pp->table, pp->columns, &pp->arena, data, ticks);
+    data->bytes = bytes;
+    if (result != PP_PREPARE_DONE) { return result; }
+    PPDeferredSpan** by_next = arena_push_array(&pp->arena, (uint64_t)data->directive_count + 1, sizeof(PPDeferredSpan*), _Alignof(PPDeferredSpan*));
+    if (by_next == NULL) { return PP_PREPARE_NO_MEMORY; }
+    memset(by_next, 0, ((uint64_t)data->directive_count + 1) * sizeof(*by_next));
+    uint32_t d = 0, kept = 0;
+    for (; kept < count; kept += 1)
+    {
+        PPDeferredSpan* span = &spans[kept];
+        while (d < data->directive_count && data->starts[data->directive_hash[d]] < span->after) { d += 1; }
+        if (d == 0 || d >= data->directive_count) { break; }
+        const uint32_t t = data->directive_hash[d] - 1;
+        if (data->starts[data->directive_hash[d]] != span->after || data->starts[data->directive_hash[d - 1]] != span->before ||
+            data->directive_end[d - 1] != t || data->starts[t] != span->marker || data->kinds[t] != (C_TOKEN_NUMERIC_CONSTANT | BUSTER_C_TOKEN_START_OF_LINE)) { break; }
+        span->token = t;
+        by_next[d] = span;
+    }
+    if (kept != count)
+    {
+        *data = original;
+        return pp_prepare_into(prepare, pp->table, pp->columns, &pp->arena, data, ticks);
+    }
+    data->deferred_spans = by_next;
+    data->planned_spans = count;
+    for (uint32_t i = 0; i < count; i += 1) { data->planned_bytes += spans[i].end - spans[i].begin; }
+    return PP_PREPARE_DONE;
+}
