+// A speculative ordinary region between physical directive lines. The complete preprocessor must confirm that
+// the numeric stand-in is the entire ordinary span between those two actual directives before the plan is used.
+static bool pp_plain_source_range(const uint8_t* bytes, uint32_t first, uint32_t end, uint32_t flags)
+{
+    enum { plain, block, line, single, string } state = plain;
+    bool has_token = false;
+    uint32_t cursor = first;
+    for (uint32_t base = first; base < end; base += 64)
+    {
+        const uint32_t left = end - base;
+        const __mmask64 valid = left < 64 ? _bzhi_u64(~0ull, left) : ~0ull;
+        const __mmask64 following = left <= 64 ? _bzhi_u64(~0ull, left - 1) : ~0ull;
+        const __m512i v = _mm512_maskz_loadu_epi8(valid, bytes + base);
+        const __m512i n = _mm512_maskz_loadu_epi8(following, bytes + base + 1);
+#define PP_IS(v, x) _mm512_cmpeq_epi8_mask((v), _mm512_set1_epi8((x)))
+        const uint64_t slash = PP_IS(v, '/'), next_slash = PP_IS(n, '/'), esc = PP_IS(v, '\\');
+        const uint64_t quotes = PP_IS(v, '"'), singles = PP_IS(v, '\''), nl = PP_IS(v, '\n');
+        const uint64_t bad_escape = PP_IS(n, 'N') | PP_IS(n, 'U') | PP_IS(n, 'u') | PP_IS(n, '\t') | PP_IS(n, ' ') | PP_IS(n, '\r') | PP_IS(n, '\n');
+        const uint64_t invalid = _mm512_movepi8_mask(v) | PP_IS(v, 0) | PP_IS(v, '\r') | PP_IS(v, '#') | (PP_IS(v, '%') & PP_IS(n, ':')) |
+            ((flags & C_TOKENIZER_RAW_STRINGS) != 0 ? PP_IS(v, 'R') & PP_IS(n, '"') : 0) |
+            ((flags & C_TOKENIZER_TRIGRAPHS) != 0 ? PP_IS(v, '?') : 0) | (esc & bad_escape);
+        if ((invalid & valid) != 0) { return false; }
+        const uint64_t open_block = slash & PP_IS(n, '*'), close_block = PP_IS(v, '*') & next_slash, open_line = slash & next_slash;
+        const uint64_t special = open_block | open_line | esc | quotes | singles;
+        const uint64_t ink = _mm512_cmpgt_epi8_mask(v, _mm512_set1_epi8(' '));
+#undef PP_IS
+        const uint32_t stop = left < 64 ? end : base + 64;
+        while (cursor < stop)
+        {
+            const uint64_t rest = valid & (~0ull << (cursor - base));
+            const uint64_t relevant = state == plain ? special : state == block ? close_block : state == line ? nl : (state == single ? singles : quotes) | esc | nl;
+            const uint64_t events = rest & relevant;
+            const uint32_t bit = events ? (uint32_t)__builtin_ctzll(events) : 64;
+            if (state == plain) { has_token |= (ink & rest & _bzhi_u64(~0ull, bit)) != 0; }
+            if (events == 0) { cursor = stop; break; }
+            const uint64_t one = (uint64_t)1 << bit;
+            cursor = base + bit + 1;
+            if (state == block) { state = plain; cursor += 1; }
+            else if (state == line) { state = plain; }
+            else if (state != plain)
+            {
+                if (nl & one) { return false; }
+                if (esc & one) { cursor += 1; } else { state = plain; }
+            }
+            else if (open_block & one) { state = block; cursor += 1; }
+            else if (open_line & one) { state = line; cursor += 1; }
+            else if (esc & one) { return false; }
+            else { has_token = true; state = (quotes & one) ? string : single; }
+        }
+    }
+    return has_token && state == plain;
+}
