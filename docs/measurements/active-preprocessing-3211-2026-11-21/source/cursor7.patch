+    }
+    data->source_spans = spans;
+    data->source_span_count = count;
+    FileCacheArenas* lane = data->record != BUSTER_PP_NONE ? file_cache_arenas(pp->cache, lane_index()) : NULL;
+    PPPrepareStatus result = pp_prepare_into(prepare, pp->table, lane != NULL ? lane->columns : pp->columns, lane != NULL ? &lane->arena : &pp->arena, data, ticks);
+    if (data->invalid_source_plan)
+    {
