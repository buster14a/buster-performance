+// A scheduling hint for the next ordinary interval. Actual program state, includes and conditional evaluation
+// remain pp_run_contexts' decision. False positives spend the cost of preparing an active range on entry.
+static void pp_predict_deferred_scope(const uint8_t* bytes, uint32_t hash, uint32_t end, uint32_t* depth, uint32_t* scope)
+{
+    uint32_t p = hash + 1;
+    while (p < end && (bytes[p] == ' ' || bytes[p] == '\t')) { p += 1; }
+    const uint32_t name = p;
+    while (p < end && bytes[p] >= 'a' && bytes[p] <= 'z') { p += 1; }
+    const uint32_t n = p - name;
+#define PP_NAME(text) (n == sizeof(text) - 1 && memcmp(bytes + name, (text), sizeof(text) - 1) == 0)
+    const bool test = PP_NAME("if") || PP_NAME("elif");
+    const bool positive = PP_NAME("ifdef") || PP_NAME("elifdef");
+    const bool alternative = PP_NAME("else") || PP_NAME("elif") || PP_NAME("elifdef") || PP_NAME("elifndef");
+    if (PP_NAME("endif"))
+    {
+        if (*scope == *depth) { *scope = UINT32_MAX; }
+        *depth -= *depth != 0;
+    }
+    else if (test || positive || alternative || PP_NAME("ifndef"))
+    {
+        if (alternative) { if (*scope == *depth) { *scope = UINT32_MAX; } }
+        else { *depth += 1; }
+        bool hint = positive;
+        while (test && !hint && p + 7 <= end)
+        {
+            const uint8_t* d = memchr(bytes + p, 'd', end - p - 6);
+            if (d == NULL) { break; }
+            const uint32_t at = (uint32_t)(d - bytes);
+            uint32_t before = at;
+            while (before > name + n && (bytes[before - 1] == ' ' || bytes[before - 1] == '\t')) { before -= 1; }
+            hint = (before == name + n || bytes[before - 1] != '!') && memcmp(d, "defined", 7) == 0;
+            p = at + 1;
+        }
+        if (hint && *depth < *scope) { *scope = *depth; }
+    }
+#undef PP_NAME
+}
