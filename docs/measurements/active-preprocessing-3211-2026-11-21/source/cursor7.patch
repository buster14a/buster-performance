+            first = end;
+        }
+    }
+    data->plan_ticks = counts ? __rdtsc() - plan_begin : 0;
+    data->checked_source_bytes = checked_bytes;
+    if (count == 0)
+    {
+        if (data->record == BUSTER_PP_NONE) { return pp_prepare_into(prepare, pp->table, pp->columns, &pp->arena, data, ticks); }
+        PPPrepareStatus cached = file_cache_prepare(pp->cache, data->record, lane_index(), ticks);
+        if (cached == PP_PREPARE_DONE) { pp_copy_prepared(data, &pp->cache->records[data->record]); }
+        return cached;
+    }
+    for (uint32_t i = 0; i < count; i += 1)
+    {
+        uint32_t marker = spans[i].begin;
+        while (marker < spans[i].end && bytes[marker] == '\n') { marker += 1; }
