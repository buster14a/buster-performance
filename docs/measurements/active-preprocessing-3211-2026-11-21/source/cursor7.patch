+            const uint32_t end = nl != NULL ? (uint32_t)(nl - bytes) + 1 : length;
+            pp_predict_deferred_scope(bytes, hash, end, &predictive_depth, &predictive_scope);
+            uint32_t tail = nl != NULL ? end - 1 : end;
+            while (tail > line && (bytes[tail - 1] == ' ' || bytes[tail - 1] == '\t' || bytes[tail - 1] == '\v' || bytes[tail - 1] == '\f')) { tail -= 1; }
+            const bool backslash = tail > line && bytes[tail - 1] == '\\';
+            const bool trigraph = (prepare->refine_flags & C_TOKENIZER_TRIGRAPHS) != 0 && tail >= line + 3 && bytes[tail - 3] == '?' && bytes[tail - 2] == '?' && bytes[tail - 1] == '/';
+            have_previous = nl != NULL && !backslash && !trigraph;
