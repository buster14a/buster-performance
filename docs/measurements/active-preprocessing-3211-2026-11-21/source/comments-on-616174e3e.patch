+// Prepare only identifier words requested by the active preprocessor context. The raw token boundaries and
+// gap flags were made by the ordinary lexer and pass A, including in skipped groups.
+static bool pp_materialize_names(InternTable* table, PPFileData* data, uint32_t begin, uint32_t end, uint32_t flags)
+{
+    RefineIdentifiers ids;
+    bool ok = true;
+    const uint32_t first = begin >> 6;
+    const uint32_t limit = (uint32_t)(((uint64_t)end + 63) >> 6);
+    for (uint32_t word = first; ok && word < limit;)
+    {
+        while (word < limit && data->pending_names[word] == 0) { word += 1; }
+        const uint32_t run = word;
+        uint32_t n = 0;
+        for (; word < limit && word - run < BUSTER_REFINE_BLOCK_TOKENS / 64; word += 1)
+        {
+            const uint64_t mask = data->pending_names[word];
+            ids.masks[word - run] = mask;
+            for (uint32_t q = 0; q < 4; q += 1)
+            {
+                const __mmask16 lanes = (__mmask16)(mask >> (q * 16));
+                const uint32_t t = word * 64 + 16 * q;
+                const __m512i starts = _mm512_maskz_loadu_epi32(lanes, data->starts + t);
+                const __m512i ends = _mm512_maskz_loadu_epi32(lanes, data->values + t);
+                _mm512_mask_compressstoreu_epi32(ids.starts + n, lanes, starts);
+                _mm512_mask_compressstoreu_epi32(ids.lengths + n, lanes, _mm512_sub_epi32(ends, starts));
+                n += (uint32_t)__builtin_popcount(lanes);
+            }
+        }
+        if (n != 0)
+        {
+            ids.count = n;
+            ok = (flags & C_TOKENIZER_TRIGRAPHS ? refine_pass_b_64_trigraphs : refine_pass_b_64_plain)(table, data->bytes, data->length, &ids, flags);
+            if (ok)
+            {
+                const uint32_t after = word * 64 < data->token_count ? word * 64 : data->token_count;
+                refine_pass_c(&ids, run * 64, after, data->values);
+                memset(data->pending_names + run, 0, (word - run) * sizeof(uint64_t));
+                data->materialized_names += n;
+            }
+        }
+    }
+    return ok;
+}
