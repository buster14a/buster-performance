     }
+    if (result && data->pending_names != NULL)
+    {
+        // Coalesce complete directive lines that share or touch a 64-token word. Their names and
+        // whole macro bodies are ready before the directive table, guards or any consumer reads them.
+        uint32_t first = 0, stop = 0;
+        for (uint32_t d = 0; result && d < count; d += 1)
+        {
+            const uint32_t hash = data->directive_hash[d];
+            const uint32_t end = pp_next_line(lines, data->token_count, hash);
+            if (hash / 64 > (uint32_t)(((uint64_t)stop + 63) / 64))
+            {
+                result = pp_materialize_names(table, data, first, stop, flags);
+                first = hash;
+            }
+            stop = end;
+        }
+        result = result && pp_materialize_names(table, data, first, stop, flags);
+    }
