+// A speculative ordinary region between physical directive lines. The complete preprocessor must confirm that
+// the numeric stand-in is the entire ordinary span between those two actual directives before the plan is used.
+static bool pp_plain_source_range(const uint8_t* bytes, uint32_t first, uint32_t end, uint32_t flags)
+{
+    bool block = false, line = false, has_token = false;
+    uint8_t quote = 0;
+    for (uint32_t i = first; i < end; i += 1)
+    {
+        const uint8_t c = bytes[i], next = i + 1 < end ? bytes[i + 1] : 0;
+        if (c == 0 || c >= 128 || c == '#' || (c == '%' && next == ':') || c == '\r' ||
+            (c == 'R' && next == '"' && (flags & C_TOKENIZER_RAW_STRINGS) != 0) || (c == '?' && (flags & C_TOKENIZER_TRIGRAPHS) != 0) ||
+            (c == '\\' && (next == 'N' || next == 'u' || next == 'U' || next == '\n' || next == '\r' || next == ' ' || next == '\t')))
+        {
+            return false;
+        }
+        if (block)
+        {
+            if (c == '*' && next == '/') { block = false; i += 1; }
+        }
+        else if (line) { line = c != '\n'; }
+        else if (quote != 0)
+        {
+            if (c == '\n') { return false; }
+            if (c == '\\' && i + 1 < end) { i += 1; }
+            else if (c == quote) { quote = 0; }
+        }
+        else if (c == '/' && (next == '*' || next == '/')) { block = next == '*'; line = !block; i += 1; }
+        else
+        {
+            if (c == '\\') { return false; }
+            has_token |= c > ' ';
+            quote = c == '\'' || c == '"' ? c : 0;
+        }
+    }
+    return has_token && !block && !line && quote == 0;
+}
