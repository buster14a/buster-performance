 // buffer, an invocation per macro whose arguments are collected (here, a token at a time, when they aren't in one
 // context: pp_collect_step) and expanded, and a capture per line expanded for a directive or a builtin, whose
 // continuation runs when its barrier ends (pp_finish_capture).
+static bool pp_enter_structural_run(Preprocessor* pp, PPContext* context, PPFileData* data, const PPDeferredSpan* span)
+{
+    const PPPrepare prepare = pp_prepare_config(pp);
+    PPFileData fragment = { .bytes = data->bytes + span->begin, .length = span->end - span->begin, .record = BUSTER_PP_NONE };
+    const bool ready = pp_prepare_into(&prepare, pp->table, pp->columns, &pp->arena, &fragment, NULL) == PP_PREPARE_DONE;
+    if (!ready || fragment.directive_count != 0 || fragment.raw_error_count != 0 || fragment.unterminated_comment != 0)
+    {
+        pp_diagnose(pp, PP_SEVERITY_FATAL, pp->ranges[context->range].base + span->begin, "failed to materialize an ordinary preprocessing range");
+        return false;
+    }
+    const uint32_t start = pp->expansions.count;
+    const uint32_t base = pp->ranges[context->range].base + span->begin;
+    bool ok = pp_append_file_tokens(pp, &pp->expansions, &fragment, base, 0, fragment.token_count, false);
+    if (ok && fragment.token_count != 0)
+    {
+        pp_history_fill(pp, &pp->expansions, start, pp->expansions.count, 0);
+        pp->expansions.flags[start] |= BUSTER_PP_SPACE;
+        PPContext* run = pp_push_buffer(pp, &pp->expansions, start, pp->expansions.count, 0, 0, false, true);
+        ok = run != NULL;
+        if (ok) { run->pending_flags = context->pending_flags; context->pending_flags = 0; }
+    }
+    context->position += 1;
+    data->entered_spans += 1;
+    data->entered_bytes += fragment.length;
+    data->entered_rows += fragment.token_count;
+    return ok;
+}
