diff --git a/src/buster/compiler/c_check_input.c b/src/buster/compiler/c_check_input.c
index f313981ce..d86116475 100644
--- a/src/buster/compiler/c_check_input.c
+++ b/src/buster/compiler/c_check_input.c
@@ -17516,6 +17516,42 @@ static bool check_input_run(CheckInput* input, const Parser* parser, Preprocesso
     // The huge pages' token columns, which a lane claims a region of before it writes there (check_input_rare_claim).
     reader.rare_begin = valid ? (uint8_t*)reader.specifier_jobs : 0;
     reader.rare_end = valid ? (uint8_t*)(reader.warning_suppressed + count + 1) : 0;
+    // Record-only (#1167's census, kept in buster-performance's record and not merged): with BUSTER_1167_COLUMNS set to a
+    // directory, each column's address and element size and the arena's bounds, and with BUSTER_1167_DUMP set too, at the
+    // reading's end, the arena's pushed bytes (whose reads map every page nothing touched: not for counting faults).
+    const char* census_1167 = getenv("BUSTER_1167_COLUMNS");
+    if (valid && census_1167 != NULL)
+    {
+        char census_path[4096];
+        snprintf(census_path, sizeof(census_path), "%s/columns.txt", census_1167);
+        FILE* census_out = fopen(census_path, "w");
+#define BUSTER_1167_COLUMN(field, type) \
+    if (census_out != NULL) fprintf(census_out, "COL\t%s\t%lu\t%lu\n", #field, (unsigned long)(uintptr_t)reader.field, (unsigned long)sizeof(type));
+        BUSTER_CHECK_SPARSE_SMALL_COLUMNS(BUSTER_1167_COLUMN)
+        BUSTER_CHECK_SPARSE_COLUMNS(BUSTER_1167_COLUMN)
+#undef BUSTER_1167_COLUMN
+#define BUSTER_1167_BINDING(field, type) \
+    if (census_out != NULL) fprintf(census_out, "COL\tbindings.%s\t%lu\t%lu\n", #field, (unsigned long)(uintptr_t)reader.bindings.field, (unsigned long)sizeof(type));
+        BUSTER_1167_BINDING(heads, uint32_t)
+        BUSTER_1167_BINDING(active, uint32_t)
+        BUSTER_1167_BINDING(key, uint32_t)
+        BUSTER_1167_BINDING(declaration, uint32_t)
+        BUSTER_1167_BINDING(point, uint32_t)
+        BUSTER_1167_BINDING(end, uint32_t)
+        BUSTER_1167_BINDING(previous, uint32_t)
+        BUSTER_1167_BINDING(first, uint32_t)
+        BUSTER_1167_BINDING(depth, uint32_t)
+        BUSTER_1167_BINDING(operation, uint8_t)
+        BUSTER_1167_BINDING(kind, uint8_t)
+#undef BUSTER_1167_BINDING
+        if (census_out != NULL)
+        {
+            fprintf(census_out, "COL\tsparse_marks\t%lu\t8\n", (unsigned long)(uintptr_t)reader.sparse_marks);
+            fprintf(census_out, "END\t%lu\nTOKENS\t%u\nBINDINGS\t%u\t%u\n", (unsigned long)(uintptr_t)reader.rare_end, count, reader.bindings.name_capacity,
+                    reader.bindings.capacity);
+            fclose(census_out);
+        }
+    }
     if (valid && deferred == 0)
     {
         const uint64_t granules = ((uintptr_t)(reader.rare_end - 1) >> BUSTER_CHECK_RARE_GRANULE_SHIFT) - ((uintptr_t)reader.rare_begin >> BUSTER_CHECK_RARE_GRANULE_SHIFT) + 1;
@@ -18044,6 +18080,25 @@ static bool check_input_run(CheckInput* input, const Parser* parser, Preprocesso
         input->visit_misses += check_input_rare_verify(&reader);
     }
     arena_pop_to(scratch, mark);
+    if (census_1167 != NULL && sparse.base != NULL)
+    {
+        char census_path[4096];
+        snprintf(census_path, sizeof(census_path), "%s/columns.txt", census_1167);
+        FILE* census_out = fopen(census_path, "a");
+        if (census_out != NULL)
+        {
+            fprintf(census_out, "BASE\t%lu\t%lu\t%lu\t%lu\n", (unsigned long)(uintptr_t)sparse.base, (unsigned long)sparse.length, (unsigned long)sparse.peak,
+                    (unsigned long)sparse.small);
+            fclose(census_out);
+        }
+        snprintf(census_path, sizeof(census_path), "%s/sparse.bin", census_1167);
+        census_out = getenv("BUSTER_1167_DUMP") != NULL ? fopen(census_path, "wb") : NULL;
+        if (census_out != NULL)
+        {
+            fwrite(sparse.base, 1, sparse.peak, census_out);
+            fclose(census_out);
+        }
+    }
     arena_release(&sparse);
     return valid;
 }
