+// The cache's keys and its slots' macro flags (buster#3583). A name of every length up to 40 and each of its prefixes
+// are looked up where the name's last byte is the last readable one (a page without access after it): the key's loads
+// read no byte past a name. Each has its own id, the same from another copy with other bytes after it, and two long
+// names that differ only in their last bytes are told apart. A slot's flag follows fast_ident_set_macro_bit, for the
+// name the slot holds and not for another with the same slot, and a name whose bit was set before its first lookup has
+// the flag from the bit; the cache stays consistent through all of it, and through a #define and an #undef.
+static bool c_direct_test_ident_keys(void)
+{
+    FastArena arena = { 0 };
+    bool ok = fast_arena_init(&arena, UINT64_C(32) * 1024u * 1024u, true);
+    FastIdentTable table;
+    ok = ok && fast_ident_init(&table, &arena, true);
+    const size_t page = (size_t)sysconf(_SC_PAGESIZE);
+    uint8_t* const pages = ok ? (uint8_t*)mmap(NULL, page * 2u, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0) : (uint8_t*)MAP_FAILED;
+    ok = ok && pages != (uint8_t*)MAP_FAILED && mprotect(pages + page, page, PROT_NONE) == 0;
+    enum { longest = 40 };
+    uint32_t ids[longest + 1][longest + 1] = { { 0 } };
+    for (uint32_t length = 1; ok && length <= longest; length += 1)
+    {
+        char name[longest + 1] = { 0 };
+        for (uint32_t j = 0; j < length; j += 1)
+        {
+            name[j] = (char)('a' + (j * 7u + length) % 26u);
+        }
+        uint8_t* const at_end = pages + page - length;
+        memcpy(at_end, name, length);
+        for (uint32_t prefix = 1; ok && prefix <= length; prefix += 1)
+        {
+            // From the page's end, then from a copy with other bytes after it.
+            char copy[longest + 16];
+            memset(copy, 'z', sizeof(copy));
+            memcpy(copy, name, prefix);
+            uint8_t kind = 0;
+            uint8_t macro = 1;
+            const uint32_t id = fast_ident_lookup(&table, prefix == length ? at_end : (const uint8_t*)copy, prefix, &kind, &macro);
+            ids[length][prefix] = id;
+            ok = id != 0 && kind == FTOK_IDENT && macro == 0 && fast_ident_lookup(&table, (const uint8_t*)copy, prefix, &kind, &macro) == id &&
+                 table.entries[id].length == prefix && memcmp(table.strings + table.entries[id].str_offset, name, prefix) == 0;
+            if (prefix == length)
+            {
+                ok = ok && fast_ident_lookup(&table, at_end, prefix, &kind, &macro) == id;
+            }
+        }
+    }
+    // Two names of 24 bytes with the same first sixteen: different ids, each found again.
+    const char* const twins[2] = { "SQLITE_ENABLE_SOMETHING3", "SQLITE_ENABLE_SOMETHING5" };
+    uint32_t twin_ids[2] = { 0 };
+    for (uint32_t round = 0; ok && round < 3u; round += 1)
+    {
+        for (uint32_t i = 0; ok && i < 2u; i += 1)
+        {
+            uint8_t kind = 0;
+            uint8_t macro = 0;
+            const uint32_t id = fast_ident_lookup(&table, (const uint8_t*)twins[i], 24u, &kind, &macro);
+            ok = id != 0 && (round == 0 || id == twin_ids[i]);
+            twin_ids[i] = id;
+        }
+        ok = ok && twin_ids[0] != twin_ids[1];
+    }
+    // The macro flag of a name the slot holds, both ways.
+    for (uint32_t length = 1; ok && length <= longest; length += 1)
+    {
+        char name[longest + 1] = { 0 };
+        for (uint32_t j = 0; j < length; j += 1)
+        {
+            name[j] = (char)('a' + (j * 7u + length) % 26u);
+        }
+        const uint32_t id = ids[length][length];
+        uint8_t kind = 0;
+        uint8_t macro = 0;
+        fast_ident_set_macro_bit(&table, id, true);
+        ok = fast_ident_lookup(&table, (const uint8_t*)name, length, &kind, &macro) == id && macro == 1u && c_direct_test_cache_consistent(&table, table.cache_bits);
+        fast_ident_set_macro_bit(&table, id, false);
+        ok = ok && fast_ident_lookup(&table, (const uint8_t*)name, length, &kind, &macro) == id && macro == 0;
+    }
+    // A name interned without a lookup and made a macro: its first lookup fills its slot with the flag.
+    uint32_t fresh = ok ? fast_ident_intern_cstr(&table, "a_fresh_macro") : 0;
+    if (fresh != 0)
+    {
+        uint8_t kind = 0;
+        uint8_t macro = 0;
+        fast_ident_set_macro_bit(&table, fresh, true);
+        ok = fast_ident_lookup(&table, (const uint8_t*)"a_fresh_macro", 13u, &kind, &macro) == fresh && macro == 1u;
+    }
+    else
+    {
+        ok = false;
+    }
+    // Two names with the same slot: the second's lookup takes the slot, and the first's bit leaves the second's flag.
+    uint32_t pair[2] = { 0 };
+    char pair_names[2][16] = { { 0 } };
+    uint32_t pair_lengths[2] = { 0 };
+    uint32_t seen = 0;
+    uint64_t seen_slots[512] = { 0 };
+    char seen_names[512][16];
+    for (uint32_t i = 0; ok && pair[1] == 0 && i < 512u; i += 1)
+    {
+        char name[16] = { 0 };
+        const uint32_t length = (uint32_t)snprintf(name, sizeof(name), "c%u", i);
+        uint8_t bytes[16] = { 0 };
+        uint64_t first = 0;
+        uint64_t last = 0;
+        memcpy(bytes, name, length);
+        memcpy(&first, bytes, sizeof(first));
+        memcpy(&last, bytes + 8, sizeof(last));
+        const uint64_t slot = BUSTER_FIDENT_CACHE_HASH(first, last, length) >> table.cache_shift;
+        for (uint32_t j = 0; j < seen && pair[1] == 0; j += 1)
+        {
+            if (seen_slots[j] == slot)
+            {
+                uint8_t kind = 0;
+                uint8_t macro = 0;
+                memcpy(pair_names[0], seen_names[j], 16);
+                memcpy(pair_names[1], name, 16);
+                pair_lengths[0] = (uint32_t)strlen(seen_names[j]);
+                pair_lengths[1] = length;
+                pair[0] = fast_ident_lookup(&table, (const uint8_t*)pair_names[0], pair_lengths[0], &kind, &macro);
+                pair[1] = fast_ident_lookup(&table, (const uint8_t*)pair_names[1], pair_lengths[1], &kind, &macro);
+            }
+        }
+        seen_slots[seen] = slot;
+        memcpy(seen_names[seen], name, 16);
+        seen += 1u;
+    }
+    if (ok && pair[0] != 0 && pair[1] != 0 && pair[0] != pair[1])
+    {
+        uint8_t kind = 0;
+        uint8_t macro = 0;
+        fast_ident_set_macro_bit(&table, pair[0], true);
+        ok = fast_ident_lookup(&table, (const uint8_t*)pair_names[1], pair_lengths[1], &kind, &macro) == pair[1] && macro == 0 &&
+             fast_ident_lookup(&table, (const uint8_t*)pair_names[0], pair_lengths[0], &kind, &macro) == pair[0] && macro == 1u &&
+             c_direct_test_cache_consistent(&table, table.cache_bits);
+    }
+    else
+    {
+        ok = false;
+    }
+    if (pages != (uint8_t*)MAP_FAILED)
+    {
+        munmap(pages, page * 2u);
+    }
+    fast_arena_destroy(&arena);
+
+    // Through the preprocessor: a name that is a macro, then not, then a macro again, read where a window emits it.
+    static const char text[] =
+        "int a_name_that_changes;\n#define a_name_that_changes 1\nx = a_name_that_changes;\n#undef a_name_that_changes\n"
+        "y = a_name_that_changes;\n#define a_name_that_changes 2\nz = a_name_that_changes;\n";
