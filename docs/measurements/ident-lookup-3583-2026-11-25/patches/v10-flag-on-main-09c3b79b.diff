+    for (uint32_t i = 0; ok && i < 9000u; i += 1)
+    {
+        char name[24] = { 0 };
+        const uint32_t length = (uint32_t)snprintf(name, sizeof(name), "grown_%u", i);
+        uint8_t kind = 0;
+        uint8_t macro = 0;
+        const uint32_t id = fast_ident_lookup(&table, (const uint8_t*)name, length, &kind, &macro);
+        ok = id != 0 && macro == 0;
