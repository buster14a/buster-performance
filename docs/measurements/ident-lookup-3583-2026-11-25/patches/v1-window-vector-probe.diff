+// `*out_ids`, and its kind in the low byte of `*out_kinds`' lane (FTOK_IDENT where unanswered). The key and the slot
+// are fast_ident_lookup's: the first eight bytes masked to the length, the last eight of a longer name, the length.
+static inline __mmask8 fast_ident_probe8(const FastIdentTable* t, const uint8_t* base, __m512i starts, __m512i lengths, __mmask8 lanes,
+                                         __m512i* out_ids, __m512i* out_kinds)
