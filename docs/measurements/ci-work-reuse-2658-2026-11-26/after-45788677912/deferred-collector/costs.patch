+// Vector draws' once-only work starts after their suite, independent of product waits. Five overlapping commands
+// establish that Fast takes half Slow's time. First tails 30/80 s normalize to 60/80; other tails 10/20 to 20/20:
+// the nearest-rank medians' difference is 40 s. Pre-suite delays and post-cleanup warnings must not enter it.
+static void costs_test_first_draw(CostsTest* test)
+{
+    CostsText inventory = costs_text_of("== C1\nx\n== C2\nx\n== C3\nx\n== C4\nx\n== C5\nx\n== C6\nx\n");
+    const CostsList list = costs_list_parse(inventory);
+    static const char name[] = "Tests on Ubuntu 26.04 (vector, thread, O3) / Vector draw 1, candidate 1 (Clang 23, thread, O3)";
+    static const char fast[] = "C1: passed in 10.0 s, 10.0 s of CPU\nC2: passed in 10.0 s, 10.0 s of CPU\nC3: passed in 10.0 s, 10.0 s of CPU\nC4: passed in 10.0 s, 10.0 s of CPU\nC5: passed in 10.0 s, 10.0 s of CPU\n";
+    static const char slow[] = "C1: passed in 20.0 s, 20.0 s of CPU\nC2: passed in 20.0 s, 20.0 s of CPU\nC3: passed in 20.0 s, 20.0 s of CPU\nC4: passed in 20.0 s, 20.0 s of CPU\nC5: passed in 20.0 s, 20.0 s of CPU\n";
+    CostsText texts[4] = {
+        costs_test_log_ending(name, "Fast CPU", BUSTER_COSTS_TEST_SHA_A, "1 of 2, 5 of 6 commands", fast, "14", "14:38"),
+        costs_test_log_ending(name, "Fast CPU", BUSTER_COSTS_TEST_SHA_A, "2 of 2, 1 of 6 commands", "C6: passed in 10.0 s, 10.0 s of CPU\n", "14", "14:18"),
+        costs_test_log_ending(name, "Slow CPU", BUSTER_COSTS_TEST_SHA_B, "1 of 2, 5 of 6 commands", slow, "40", "41:28"),
+        costs_test_log_ending(name, "Slow CPU", BUSTER_COSTS_TEST_SHA_B, "2 of 2, 1 of 6 commands", "C6: passed in 20.0 s, 20.0 s of CPU\n", "40", "40:28"),
+    };
+    CostsLog logs[4];
+    const char* names[4] = { "fast-first", "fast-other", "slow-first", "slow-other" };
+    bool parsed = true;
+    for (uint32_t i = 0; i < 4; i += 1)
+    {
+        if (i % 2 == 0)
+        {
+            const char* start = i == 0 ? "2026-11-11T01:14:00.1000000Z" : "2026-11-11T01:40:00.1000000Z";
+            CostsText delayed = costs_test_replace(&(CostsBuffer){ .data = texts[i].data, .length = texts[i].length }, start, "2026-11-11T00:00:00.1000000Z");
+            free(texts[i].data);
+            CostsBuffer tail = { .data = delayed.data, .length = delayed.length, .capacity = delayed.length + 1 };
+            costs_append(&tail, "2026-11-11T02:00:00.0000000Z ##[warning]A runner notice after cleanup\n");
+            texts[i] = (CostsText){ .data = tail.data, .length = tail.length };
+        }
+        logs[i] = costs_log_parse(&list, texts[i]);
+        parsed = parsed && logs[i].error == NULL;
+    }
+    const uint32_t row = BUSTER_COSTS_VECTOR * BUSTER_COSTS_SANITIZERS + 2;
+    CostsBuffer tables[BUSTER_COSTS_ROWS] = { 0 };
+    CostsBuffer report = { 0 };
+    const bool collected = parsed && costs_collect_rows(&list, logs, names, 4, tables, &report);
+    costs_expect(test, collected && costs_test_contains(&tables[row], "\n#: first-shard 40.0\n"), "a vector draw's first-shard offset uses normalized post-suite medians, without setup waits or trailing warnings");
+    CostsBuffer problems = { 0 };
+    costs_expect(test, collected && costs_check_text(&list, row, (CostsText){ .data = tables[row].data, .length = tables[row].length }, &problems) == 0, "the collected vector offset checks without changing its commands");
+    free(problems.data);
+    free(report.data);
+    for (uint32_t r = 0; r < BUSTER_COSTS_ROWS; r += 1)
+    {
+        free(tables[r].data);
+    }
+    static const struct
+    {
+        const char* before;
+        const char* after;
+        const char* why;
+    } incomplete[] = {
+        { "2026-11-11T01:14:08.0000000Z parallel:", "parallel:", "an untimestamped summary" },
+        { "2026-11-11T01:14:38.0000000Z Cleaning", "Cleaning", "an untimestamped completion" },
+        { "Cleaning up orphan processes", "Tail truncated", "a missing completion" },
+        { "Cleaning up orphan processes", "Cleaning up orphan processes eventually", "a completion with extra text" },
+        { "01:14:38.0000000Z Cleaning", "01:14:07.0000000Z Cleaning", "a completion before the summary" },
+        { "Cleaning up orphan processes\n", "Cleaning up orphan processes\n2026-11-11T01:14:39.0000000Z Cleaning up orphan processes\n", "two completions" },
+        { "3 passed, 0 failed", "2 passed, 1 failed", "a failed command absent from the current inventory" },
+        { "3 passed, 0 failed", "3 passed, 10 failed", "a failure count ending in zero" },
+        { "0 not started", "1 not started", "a command not started" },
+        { "suite\tpassed", "suite\tmissing", "missing successful qualification after cancellation" },
+        { "2026-11-11T01:14:09.5000000Z suite", "suite", "an untimestamped qualification" },
+        { "01:14:09.5000000Z suite", "01:14:07.5000000Z suite", "qualification before the summary" },
+        { "01:14:09.5000000Z suite", "01:14:39.5000000Z suite", "qualification after completion" },
+        { "suite\tpassed\n", "suite\tpassed\n2026-11-11T01:14:10.0000000Z ##[error]Process completed with exit code 1.\n", "a failed step after the suite" },
+        { "Cleaning up orphan processes\n", "Cleaning up orphan processes\n2026-11-11T01:14:39.0000000Z ##[error]The operation was canceled.\n", "a cancellation error after cleanup" },
+        { "C1: passed in 10.0 s", "C1: failed (exit status 1) in 10.0 s", "a failed command with a misleading summary" },
+    };
+    for (uint32_t i = 0; i < sizeof(incomplete) / sizeof(incomplete[0]); i += 1)
+    {
+        CostsText changed = costs_test_replace(&(CostsBuffer){ .data = texts[0].data, .length = texts[0].length }, incomplete[i].before, incomplete[i].after);
+        CostsLog pair[2] = { costs_log_parse(&list, changed), logs[1] };
+        CostsBuffer partial[BUSTER_COSTS_ROWS] = { 0 };
+        CostsBuffer detail = { 0 };
+        const bool kept = pair[0].error == NULL && costs_collect_rows(&list, pair, names, 2, partial, &detail);
+        char what[160];
+        snprintf(what, sizeof(what), "%s keeps command samples but supplies no vector first-shard offset", incomplete[i].why);
+        costs_expect(test, kept && pair[0].sample_count == 5 && costs_test_contains(&partial[row], "\n#: samples 1 1\n") && !costs_test_contains(&partial[row], "#: first-shard"), what);
+        for (uint32_t r = 0; r < BUSTER_COSTS_ROWS; r += 1)
+        {
+            free(partial[r].data);
+        }
+        free(detail.data);
+        free(pair[0].samples);
+        free(changed.data);
+    }
+    for (uint32_t i = 0; i < 4; i += 1)
+    {
+        free(logs[i].samples);
+        free(texts[i].data);
+    }
+    free(list.commands);
+    free(inventory.data);
+}
