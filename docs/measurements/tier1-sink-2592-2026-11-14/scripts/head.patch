+    uint32_t word = i / 64;
+    uint64_t rest = i < count ? bits[word] & (UINT64_MAX << (i % 64)) : 0;
+    const uint32_t words = (count + 63) / 64;
+    while (rest == 0 && word + 1 < words && i < count)
