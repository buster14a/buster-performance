diff --git a/src/buster/compiler/ir_optimize_unroll_test.c b/src/buster/compiler/ir_optimize_unroll_test.c
index 31029a5..2eedbb0 100644
--- a/src/buster/compiler/ir_optimize_unroll_test.c
+++ b/src/buster/compiler/ir_optimize_unroll_test.c
@@ -411,8 +411,44 @@ static uint32_t ir_unroll_test_parameters(uint32_t bits, uint64_t* parameters, u
 
 // The fixture by both twins: the same function and counts; `expected`'s outcome counted once; an unrolled one verified,
 // optimized and executed against the original on every parameter.
+// ir_unroll_backward's twins agree, and neither misses a branch backward in block order: the oracle reads every edge by
+// ir_successor, as the CFG does. Returns the vector twin's answer.
+static bool ir_unroll_test_backward(IrOptimizeTest* test, const IrFunction* f, const char* label)
+{
+    uint8_t* vector_classes = calloc((size_t)f->instruction_count + BUSTER_IR_UNROLL_BATCH, 1);
+    uint8_t* scalar_classes = calloc((size_t)f->instruction_count + BUSTER_IR_UNROLL_BATCH, 1);
+    bool exact = false;
+    for (uint32_t block = 0; block < f->block_count; block += 1)
+    {
+        const uint32_t end = f->block_offsets[block + 1];
+        const bool terminated = end > f->block_offsets[block];
+        const uint32_t count = terminated ? ir_successor_count(f, end - 1) : 0;
+        exact = exact || !terminated;
+        for (uint32_t edge = 0; edge < count; edge += 1)
+        {
+            exact = exact || ir_successor(f, end - 1, edge) <= block;
+        }
+    }
+    bool vector = false;
+    bool scalar = false;
+    if (vector_classes != NULL && scalar_classes != NULL)
+    {
+        (void)ir_unroll_classify(f, vector_classes, false);
+        (void)ir_unroll_classify(f, scalar_classes, true);
+        vector = ir_unroll_backward(f, vector_classes, false);
+        scalar = ir_unroll_backward(f, scalar_classes, true);
+    }
+    char message[256] = { 0 };
+    snprintf(message, sizeof(message), "%s: the backward-branch test's twins agree (%d, %d) and miss no backward edge (%d)", label, (int)vector, (int)scalar, (int)exact);
+    ir_optimize_test_expect(test, vector_classes != NULL && scalar_classes != NULL && vector == scalar && (vector || !exact), message);
+    free(vector_classes);
+    free(scalar_classes);
+    return vector;
+}
