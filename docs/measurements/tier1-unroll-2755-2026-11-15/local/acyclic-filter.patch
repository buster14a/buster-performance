+// Functions without a loop: a diamond with a phi answers no backward branch and is left as it is without its CFG; a
+// branch to an earlier block of a DAG and a forward switch answer yes, conservatively, and the dominators find no loop.
+// Then random CFGs of up to 40 blocks (a ret, br, cbr or switch each, to any block) check the twins against the exact
+// edges, across the vector path's 16-block groups and its last partial one.
+static void ir_unroll_test_acyclic(IrOptimizeTest* test, uint32_t random_functions)
+{
+    for (uint32_t k = 0; k < 3 + random_functions; k += 1)
+    {
+        IrUnrollTestText* text = calloc(1, sizeof(IrUnrollTestText));
+        Arena input = arena_reserve(UINT64_C(1) << 24);
+        Arena scratch = arena_reserve(UINT64_C(1) << 26);
+        Arena output = arena_reserve(UINT64_C(1) << 24);
+        char label[64] = { 0 };
+        bool expected = true;
+        if (text != NULL)
+        {
+            snprintf(text->header, sizeof(text->header), "function (i64) -> i64 {");
+            ir_unroll_test_label(text, 0);
+            ir_unroll_test_line(text, "p", "param.i64 0");
+            ir_unroll_test_constant(text, "zero", "i64", 64, 0);
+            ir_unroll_test_line(text, "t", "icmp.i1 {p}, {zero} ult");
+        }
+        if (text != NULL && k == 0)
+        {
+            snprintf(label, sizeof(label), "a diamond with a phi");
+            expected = false;
+            ir_unroll_test_line(text, "", "cbr.void {t}, b1, b2");
+            ir_unroll_test_label(text, 1);
+            ir_unroll_test_line(text, "x", "add.i64 {p}, {p}");
+            ir_unroll_test_line(text, "", "br.void b3");
+            ir_unroll_test_label(text, 2);
+            ir_unroll_test_line(text, "y", "sub.i64 {p}, {zero}");
+            ir_unroll_test_line(text, "", "br.void b3");
+            ir_unroll_test_label(text, 3);
+            ir_unroll_test_line(text, "r", "phi.i64 [{x}, b1], [{y}, b2]");
+            ir_unroll_test_line(text, "", "ret.void {r}");
+        }
+        else if (text != NULL && k == 1)
+        {
+            snprintf(label, sizeof(label), "a DAG branching to an earlier block");
+            ir_unroll_test_line(text, "", "cbr.void {t}, b2, b3");
+            ir_unroll_test_label(text, 1);
+            ir_unroll_test_line(text, "", "ret.void {p}");
+            ir_unroll_test_label(text, 2);
+            ir_unroll_test_line(text, "", "br.void b1");
+            ir_unroll_test_label(text, 3);
+            ir_unroll_test_line(text, "r", "phi.i64 [{p}, b0]");
+            ir_unroll_test_line(text, "", "ret.void {r}");
+        }
+        else if (text != NULL && k == 2)
+        {
+            snprintf(label, sizeof(label), "a forward switch");
+            ir_unroll_test_line(text, "", "switch.void {p}, default b1, [0x00000000000000000000000000000002, b2]");
+            ir_unroll_test_label(text, 1);
+            ir_unroll_test_line(text, "", "br.void b2");
+            ir_unroll_test_label(text, 2);
+            ir_unroll_test_line(text, "r", "phi.i64 [{p}, b0], [{zero}, b1]");
+            ir_unroll_test_line(text, "", "ret.void {r}");
+        }
+        else if (text != NULL)
+        {
+            const uint32_t blocks = 2 + (uint32_t)(ir_optimize_test_random(test) % 39);
+            snprintf(label, sizeof(label), "random CFG %" PRIu32 " of %" PRIu32 " blocks", k - 3, blocks);
+            for (uint32_t block = 0; block < blocks; block += 1)
+            {
+                if (block != 0)
+                {
+                    ir_unroll_test_label(text, block);
+                }
+                const uint64_t r = ir_optimize_test_random(test);
+                // Mostly forward targets, so that whole functions answer no as often as yes.
+                const bool forward = block + 1 < blocks && (r >> 8) % 8 != 0;
+                const uint32_t span = forward ? blocks - block - 1 : blocks;
+                const uint32_t first = forward ? block + 1 : 0;
+                const uint32_t x = first + (uint32_t)((r >> 16) % span);
+                const uint32_t y = first + (uint32_t)((r >> 32) % span);
+                const uint32_t kind = block + 1 == blocks ? 0 : (uint32_t)(r % 8);
+                if (kind == 0 || kind == 1)
+                {
+                    ir_unroll_test_line(text, "", "ret.void {p}");
+                }
+                else if (kind <= 4)
+                {
+                    ir_unroll_test_line(text, "", "br.void b%" PRIu32, x);
+                }
+                else if (kind <= 6)
+                {
+                    ir_unroll_test_line(text, "", "cbr.void {t}, b%" PRIu32 ", b%" PRIu32, x, y);
+                }
+                else
+                {
+                    ir_unroll_test_line(text, "", "switch.void {p}, default b%" PRIu32 ", [0x00000000000000000000000000000002, b%" PRIu32 "]", x, y);
+                }
+            }
+        }
+        IrFunction f = { 0 };
+        const bool parsed = text != NULL && ir_unroll_test_parse(text, &input, &scratch, &f);
+        arena_pop_to(&scratch, 0);
+        char message[256] = { 0 };
+        snprintf(message, sizeof(message), "%s: parses", label);
+        ir_optimize_test_expect(test, parsed, message);
+        if (parsed)
+        {
+            const bool backward = ir_unroll_test_backward(test, &f, label);
+            if (k < 3)
+            {
+                snprintf(message, sizeof(message), "%s: the backward-branch test answers %d", label, (int)expected);
+                ir_optimize_test_expect(test, backward == expected, message);
+                for (uint32_t twin = 0; twin < 2; twin += 1)
+                {
+                    IrUnrollOptions options = ir_unroll_options();
+                    options.scalar = twin != 0;
+                    IrUnrollResult result = { 0 };
+                    const IrCheck check = ir_optimize_unroll(&f, &output, &scratch, options, &result);
+                    uint64_t outcomes = 0;
+                    for (uint32_t o = 0; o < IR_UNROLL_OUTCOME_COUNT; o += 1)
+                    {
+                        outcomes += result.outcomes[o];
+                    }
+                    snprintf(message, sizeof(message), "%s: no loop, the input itself, scratch and output returned (twin %u)", label, twin);
+                    ir_optimize_test_expect(test, check.error == IR_OK && outcomes == 0 && result.function.op == f.op && output.length == 0 && scratch.length == 0, message);
+                }
+            }
+        }
+        free(text);
+        arena_release(&input);
+        arena_release(&scratch);
+        arena_release(&output);
+    }
+}
