+// Read only the grammar-kind column until a double square is present. Here these are
+// the actual converted rows, including adjacency created by the removal of a pragma.
+static bool parse_grammar_has_scope(const ParseTokens* tokens)
+{
+    uint64_t last_square = 0;
+    for (uint32_t first = 0; first < tokens->count; first += 64)
+    {
+        // Grammar padding is initialized to END; a partial last block has no false opening.
+        const __m512i kinds = _mm512_loadu_si512(tokens->kinds + first);
+        const uint64_t square = _mm512_cmpeq_epi8_mask(kinds, _mm512_set1_epi8(PARSE_KIND_L_SQUARE));
+        if ((square & ((square << 1) | last_square)) != 0)
+        {
+            return true;
+        }
+        last_square = square >> 63;
+    }
+    return false;
