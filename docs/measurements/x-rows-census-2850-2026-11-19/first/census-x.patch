+static uint32_t census_x_word(const NodeMachine* machine, TypeId type)
+{
+    return type != 0 ? node_machine_word(machine, type) : 0u;
+}
+
+static void census_x_entries(const NodeMachine* machine, uint32_t from, uint32_t to)
+{
+    for (uint32_t at = from; at < to; at += 1)
+    {
+        printf("%s%u:%u", at == from ? "" : ",", (uint32_t)machine->kinds[at], (uint32_t)machine->classes[at]);
+    }
+    if (from == to)
+    {
+        printf("-");
+    }
+}
+
+// A line for each record of an expression X took: what the window has of it and what C answered, then its row's
+// entries, a kind and a class each: its own, its conversion's, and what follows its row.
+static void census_x_print(const NodeMachine* machine)
+{
+    const NodeMachineColumns* columns = machine->columns;
+    const uint32_t count = machine->count;
+    for (uint32_t r = 0; r < count; r += 1)
+    {
+        const uint8_t state = node_machine_record_state(machine, r);
+        if ((state & BUSTER_NODE_MACHINE_EVALUATED) != 0 || census_x_ends[r] != census_x_starts[r])
+        {
+            const CheckOp op = node_machine_record_op(machine, r);
+            const TypeId type = node_machine_record_type(machine, r);
+            const TypeId target = node_machine_record_target(machine, r);
+            const uint32_t object = node_machine_record_object(machine, r);
+            const bool known = object != 0 && object < machine->object_count;
+            const uint32_t object_bits = (object != 0 ? 1u : 0u) | (known ? 2u : 0u) | (known && node_machine_local(machine, object) ? 4u : 0u);
+            const uint32_t template = (state & BUSTER_NODE_MACHINE_EVALUATED) != 0 ? (uint32_t)node_machine_record_template(machine, r) : 255u;
+            const bool hooked = (state & (BUSTER_NODE_MACHINE_AFTER_CONDITION | BUSTER_NODE_MACHINE_AFTER_ARM | BUSTER_NODE_MACHINE_AFTER_BRANCH | BUSTER_NODE_MACHINE_BRANCHED)) != 0;
+            const uint32_t hook = hooked ? node_machine_record_hook(machine, r) : UINT32_MAX;
+            const bool hook_inside = hook < count;
+            const bool member = op == CHECK_OP_MEMBER || op == CHECK_OP_ARROW;
+            uint32_t plan = 0;
+            if (template == (uint32_t)BUSTER_NODE_MACHINE_TEMPLATE_UPDATE || (state & BUSTER_NODE_MACHINE_SPLIT) != 0)
+            {
+                const NodeMachineUpdate* update = node_machine_record_update(machine, r);
+                plan = (update->direct ? 1u : 0u) | (update->increment ? 2u : 0u) | (update->postfix ? 4u : 0u) | (update->subtract ? 8u : 0u) | (update->pointer ? 16u : 0u) |
+                       (update->power ? 32u : 0u) | 64u | ((uint32_t)update->stored_class << 8) | ((uint32_t)update->calculated_class << 16) | ((uint32_t)update->computing << 24);
+            }
+            printf("xx: e=%" PRIu64 " r=%u n=%u op=%u tpl=%u w=%x st=%x fl=%x ctx=%x state=%x tw=%x same=%u c0=%x c1=%x ob=%x off=%u mo=%u fold=%u up=%x hop=%u hw=%x hc0=%x last=%u", census_x_expressions,
+                   r, count, (uint32_t)op, template, columns->words[r], columns->standings[r], columns->value_flags[r], node_machine_record_context(machine, r), state,
+                   census_x_word(machine, target), target == type ? 1u : target == 0 ? 2u : 0u, census_x_word(machine, node_machine_record_converted(machine, r, 0)),
+                   census_x_word(machine, node_machine_record_converted(machine, r, 1)), object_bits, node_machine_record_offset(machine, r) != 0 ? 1u : 0u,
+                   member && node_machine_record_member_offset(machine, r) / 8 != 0 ? 1u : 0u, (uint32_t)census_x_folded[r], plan,
+                   hook_inside ? (uint32_t)node_machine_record_op(machine, hook) : 255u, hook_inside ? columns->words[hook] : 0u,
+                   hook_inside ? census_x_word(machine, node_machine_record_converted(machine, hook, 0)) : 0u, r == count - 1 ? 1u : 0u);
+            printf(" | own=");
+            census_x_entries(machine, census_x_starts[r], census_x_owns[r]);
+            printf(" conv=");
+            census_x_entries(machine, census_x_owns[r], census_x_rows[r]);
+            printf(" after=");
+            census_x_entries(machine, census_x_rows[r], census_x_ends[r]);
+            printf("\n");
+        }
+    }
+    census_x_expressions += 1;
+}
