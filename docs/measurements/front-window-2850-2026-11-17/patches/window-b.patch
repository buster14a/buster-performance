+    NodeFactsInputs* set = &state->window;
+    const uint32_t start = state->run_start;
+    const uint32_t base = state->run_base;
+    const uint32_t size = state->run_count;
+    bool decoded = true;
+    bool room = true;
+    set->argument_count = state->run_arguments != UINT32_MAX ? state->run_arguments : set->argument_count;
+    if (BUSTER_SCALAR_PATH(scalar))
