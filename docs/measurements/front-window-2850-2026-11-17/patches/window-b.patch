+// The window of an expression from the columns the front wrote, for `state`'s window's inputs at the batch's records
+// from `base`: the expression whose root is the front's `record`, with its operand's record `operand`, `count` records
+// as T takes it (node_facts_front_expression's, whose result this is: BUSTER_NODE_FACTS_WHY_GIVEN, or that its
+// records are not there in a row), its calls' arguments at the batch's places from `arguments`. Its operand's subtree's
+// records and its root's (but an initialization's) join the run at hand: as one piece where the root is the record
+// after its operand, as an expression statement's is, and as two where its value waited (a control's condition's, for
+// its body). Consecutive expressions are mostly one run, which is copied whole when a piece doesn't follow it
+// (node_facts_window_run_by) or the batch is run.
+static inline __attribute__((always_inline)) uint32_t node_facts_window_expression_by(struct NodeFactsReader* state, const NodeFront* front, uint32_t base, uint32_t count,
+                                                                                      uint32_t record, uint32_t operand, uint32_t arguments, const bool scalar)
+{
