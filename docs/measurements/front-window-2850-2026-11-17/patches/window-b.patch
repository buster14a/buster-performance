+        memcpy(set->ops + base, front->ops + start, size);
+        memcpy(set->kinds + base, front->window_kinds + start, size);
+        memcpy(set->classes + base, front->window_classes + start, size);
+        memcpy(set->left + base, front->window_left + start, (uint64_t)size * sizeof(uint16_t));
+        memcpy(set->right + base, front->window_right + start, (uint64_t)size * sizeof(uint16_t));
+        memcpy(set->inputs + base, front->window_entries + start, (uint64_t)size * sizeof(uint32_t));
+        memcpy(set->positions + base, front->window_positions + start, (uint64_t)size * sizeof(uint32_t));
+        memset(set->counts + base, 0, (uint64_t)size * sizeof(uint16_t));
+        for (uint32_t r = 0; r < size; r += 1)
+        {
+            const uint8_t kind = front->window_kinds[start + r];
+            if (kind == BUSTER_NODE_FACTS_IDENTIFIER)
+            {
+                node_facts_window_identifier(facts, set, front, start + r, base + r);
+            }
+            else if (kind == BUSTER_NODE_FACTS_LITERAL_LINE)
+            {
+                decoded = node_facts_window_literal(state, set, front, start + r, base + r) && decoded;
+            }
+            else if (front->ops[start + r] == CHECK_OP_CALL)
+            {
+                room = node_facts_window_arguments(facts, set, front, start + r, base + r) && room;
+            }
+        }
+    }
+    else
+    {
+        for (uint32_t i = 0; i < size; i += 16)
+        {
+            const uint32_t live = size - i < 16 ? size - i : 16;
+            const __mmask16 mask = (__mmask16)((1u << live) - 1);
+            const __m128i ops = _mm_loadu_si128((const __m128i*)(const void*)(front->ops + start + i));
+            const __m128i kinds = _mm_loadu_si128((const __m128i*)(const void*)(front->window_kinds + start + i));
+            _mm_storeu_si128((__m128i*)(void*)(set->ops + base + i), ops);
+            _mm_storeu_si128((__m128i*)(void*)(set->kinds + base + i), kinds);
+            _mm_storeu_si128((__m128i*)(void*)(set->classes + base + i), _mm_loadu_si128((const __m128i*)(const void*)(front->window_classes + start + i)));
+            _mm256_storeu_si256((__m256i*)(void*)(set->left + base + i), _mm256_loadu_si256((const __m256i*)(const void*)(front->window_left + start + i)));
+            _mm256_storeu_si256((__m256i*)(void*)(set->right + base + i), _mm256_loadu_si256((const __m256i*)(const void*)(front->window_right + start + i)));
+            _mm512_storeu_si512(set->inputs + base + i, _mm512_loadu_si512(front->window_entries + start + i));
+            _mm512_storeu_si512(set->positions + base + i, _mm512_loadu_si512(front->window_positions + start + i));
+            _mm256_storeu_si256((__m256i*)(void*)(set->counts + base + i), _mm256_setzero_si256());
+            uint32_t identifiers = _mm_mask_cmpeq_epi8_mask(mask, kinds, _mm_set1_epi8(BUSTER_NODE_FACTS_IDENTIFIER));
+            uint32_t literals = _mm_mask_cmpeq_epi8_mask(mask, kinds, _mm_set1_epi8(BUSTER_NODE_FACTS_LITERAL_LINE));
+            uint32_t calls = _mm_mask_cmpeq_epi8_mask(mask, ops, _mm_set1_epi8((char)CHECK_OP_CALL));
