+// A call's record's inputs, as the lean front makes the record `record` at `token`: its callee's record and its
+// arguments' are `values`, `count` of them. Its arguments' places among a batch's are made with its window.
+static inline __attribute__((always_inline)) void node_facts_window_call(NodeFront* front, const CheckInputReader* reader, uint32_t record, uint32_t token,
+                                                                         const uint32_t* values, uint32_t count)
+{
+    const uint32_t code = front->window_op_codes[CHECK_OP_CALL];
+    uint32_t round = 0;
+    bool cut = false;
+    // From its last argument back to its callee: each one's subtree ends where the one after it begins.
+    uint32_t next = record;
+    for (uint32_t k = count; k-- != 0;)
+    {
+        const uint32_t operand = values[k];
+        const uint32_t class = front->window_classes[operand];
+        round = node_facts_round(round, code, class);
+        cut = cut || class == BUSTER_NODE_FACTS_CLASS_CUT || operand + 1 != next;
+        next = operand + 1 - front->sizes[operand];
+    }
+    front->window_kinds[record] = front->window_op_kinds[CHECK_OP_CALL];
+    front->window_classes[record] = (uint8_t)(cut ? BUSTER_NODE_FACTS_CLASS_CUT : node_facts_class(round, code));
+    front->window_left[record] = (uint16_t)(record - values[0]);
+    front->window_right[record] = 0;
+    front->window_entries[record] = 0;
+    front->window_positions[record] = check_input_expression_end(reader, token);
+}
+
+// A name's leaf of a window the front wrote: the front's record `x`, the batch's `w` in `set`, whose input the block's
+// copy left its declaration. Its line's number in its place, or a literal's kind where its line is no leaf's of the
+// columns' (node_facts_front_expression's steps).
+static inline __attribute__((always_inline)) void node_facts_window_identifier(NodeFacts* facts, NodeFactsInputs* set, const NodeFront* front, uint32_t x, uint32_t w)
+{
+    const uint32_t number = node_facts_front_line(facts, front->window_entries[x], front->tokens[x]);
+    const bool high = number != 0 && ((uint32_t)(facts->lines[4 * (uint64_t)number + 3] >> 32) & BUSTER_NODE_FACTS_HIGH) != 0;
+    const bool named = number != 0 && !high;
+    set->kinds[w] = named ? BUSTER_NODE_FACTS_IDENTIFIER : BUSTER_NODE_FACTS_LITERAL;
+    set->inputs[w] = named ? number : 0;
+}
+
+// A literal's or a string's leaf of a window the front wrote, the front's record `x`, the batch's `w` in `set`: its line
+// made, of the type and the value the front's columns have, as node_facts_front_expression makes it. False where the
+// reader doesn't decode the literal again.
+static inline __attribute__((always_inline)) bool node_facts_window_literal(struct NodeFactsReader* state, NodeFactsInputs* set, const NodeFront* front, uint32_t x, uint32_t w)
+{
+    NodeFacts* facts = &state->facts;
+    CheckInputReader* reader = state->reader;
+    const uint32_t token = front->tokens[x];
+    const uint8_t category = front->leaf_categories[x];
+    const TypeId type = front->leaf_types[x];
+    const uint32_t index = type_index(type);
+    bool decoded = true;
+    uint32_t number = 0;
+    if (category == BUSTER_NODE_FRONT_LEAF_LITERAL && index < facts->row_count && (facts->rows[index].flags & BUSTER_NODE_FACTS_INTEGER) != 0)
+    {
+        number = node_facts_front_integer(facts, facts->parser, token, type, index, front->leaf_integers[x]);
+    }
+    else
+    {
+        CheckValue value = { 0 };
+        if (category == BUSTER_NODE_FRONT_LEAF_LITERAL)
+        {
+            CheckLiteral literal = { 0 };
+            decoded = node_front_literal(reader, token, &literal);
+            value = check_input_literal_value(reader, token, literal);
+        }
+        else
+        {
+            const uint32_t object = (uint32_t)front->leaf_integers[x];
+            value = (CheckValue){
+                .type = type,
+                .category = CHECK_LVALUE,
+                .flags = BUSTER_CHECK_STATIC_OBJECT | (object != 0 ? BUSTER_CHECK_NONNULL_ADDRESS : 0),
+                .constant_kind = CHECK_CONSTANT_ADDRESS,
+                .object = object,
+            };
+        }
+        number = decoded ? node_facts_front_literal(facts, &value) : 0;
+    }
+    set->kinds[w] = number != 0 ? BUSTER_NODE_FACTS_LITERAL_LINE : BUSTER_NODE_FACTS_LITERAL;
+    set->inputs[w] = number;
+    return decoded;
+}
+
+// A call of a window the front wrote, the front's record `x`, the batch's `w` in `set`: its arguments' distances at the
+// batch's next places, from the last back, each the record before the subtree of the one after it. False where the
+// batch has no room for them.
+static inline __attribute__((always_inline)) bool node_facts_window_arguments(const NodeFacts* facts, NodeFactsInputs* set, const NodeFront* front, uint32_t x, uint32_t w)
+{
+    // Its callee is one of its operands, which are a byte's count: no more than the front's values (BUSTER_NODE_FRONT_VALUES).
+    const uint32_t argument_count = (uint32_t)front->counts[x] - 1;
+    const bool room = (uint64_t)set->argument_count + argument_count <= facts->record_capacity;
+    uint32_t distance = 1;
+    for (uint32_t k = argument_count; room && k-- != 0;)
+    {
+        set->arguments[set->argument_count + k] = (uint16_t)distance;
+        distance += front->sizes[x - distance];
+    }
+    set->inputs[w] = set->argument_count;
+    set->counts[w] = (uint16_t)argument_count;
+    set->argument_count += room ? argument_count : 0;
+    return room;
+}
+
+// The inputs of the batch's records from `base`, `count` of them, and of their calls' arguments, from `argument_base` to
+// `argument_end`, taken into `set` from the windows' own, node_facts_append's: an expression `set`'s making doesn't give.
+static void node_facts_inputs_take(NodeFactsInputs* set, const NodeFacts* facts, uint32_t base, uint32_t count, uint32_t argument_base, uint32_t argument_end)
+{
+    memcpy(set->ops + base, facts->ops + base, count);
+    memcpy(set->kinds + base, facts->kinds + base, count);
+    memcpy(set->classes + base, facts->classes + base, count);
+    memcpy(set->left + base, facts->left + base, (uint64_t)count * sizeof(uint16_t));
+    memcpy(set->right + base, facts->right + base, (uint64_t)count * sizeof(uint16_t));
+    memcpy(set->inputs + base, facts->inputs + base, (uint64_t)count * sizeof(uint32_t));
+    memcpy(set->counts + base, facts->counts + base, (uint64_t)count * sizeof(uint16_t));
+    memcpy(set->positions + base, facts->positions + base, (uint64_t)count * sizeof(uint32_t));
+    memcpy(set->arguments + argument_base, facts->arguments + argument_base, (uint64_t)(argument_end - argument_base) * sizeof(uint16_t));
+}
+
+// The run at hand of the windows the front wrote, copied into `state`'s window's inputs: the front's records from
+// `run_start`, `run_count` of them, at the batch's from `run_base`. The columns are copied as blocks, sixteen records a
+// step whatever the run's length (the arrays on both sides have a vector's records past their ends, and a step's
+// stores past the run's are the next's to write over); then its leaves' lines and its calls' arguments are made over
+// the copy, each found by a compare of the step's kinds and operators. The scalar path (`scalar`, a constant where
+// this is inlined; a host without the vectors has no other) copies the blocks by memcpy and finds the leaves and the
+// calls by a test a record: the same inputs, which a batch's run makes that way too and compares
+// (node_facts_reader_flush). False where a literal was not decoded again or the batch had no room for a call's
+// arguments, which the callers' own tests rule out.
+static inline __attribute__((always_inline)) bool node_facts_window_run_by(struct NodeFactsReader* state, const NodeFront* front, const bool scalar)
+{
