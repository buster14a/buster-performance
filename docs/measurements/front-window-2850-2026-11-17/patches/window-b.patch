+        node_facts_window_piece_by(state, front, operand + 1 - size, base, size + (after ? 1 : 0), arguments, scalar);
+        if (!initialization && !after)
+        {
+            node_facts_window_piece_by(state, front, record, base + size, 1, UINT32_MAX, scalar);
+        }
+    }
+    return whole ? BUSTER_NODE_FACTS_WHY_GIVEN : BUSTER_NODE_FACTS_WHY_CUT;
+}
+
+static __attribute__((noinline)) bool node_facts_window_run(struct NodeFactsReader* state, const NodeFront* front)
+{
+    return node_facts_window_run_by(state, front, false);
+}
+
+static __attribute__((noinline)) bool node_facts_window_run_scalar(struct NodeFactsReader* state, const NodeFront* front)
+{
+    return node_facts_window_run_by(state, front, true);
+}
+
+static __attribute__((noinline)) uint32_t node_facts_window_expression(struct NodeFactsReader* state, const NodeFront* front, uint32_t base, uint32_t count, uint32_t record,
+                                                                       uint32_t operand, uint32_t arguments)
+{
+    return node_facts_window_expression_by(state, front, base, count, record, operand, arguments, false);
+}
+
+static __attribute__((noinline)) uint32_t node_facts_window_expression_scalar(struct NodeFactsReader* state, const NodeFront* front, uint32_t base, uint32_t count,
+                                                                              uint32_t record, uint32_t operand, uint32_t arguments)
+{
+    return node_facts_window_expression_by(state, front, base, count, record, operand, arguments, true);
+}
