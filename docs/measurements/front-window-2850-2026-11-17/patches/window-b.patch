+
+// The front's records from `start`, `count` of them, for the batch's from `base`: they join the run at hand where they
+// follow it on both sides, and else the run is copied and they begin the next. `arguments`: the batch's argument place
+// the piece's first call takes (UINT32_MAX for a root's record, which has no call).
+static inline __attribute__((always_inline)) void node_facts_window_piece_by(struct NodeFactsReader* state, const NodeFront* front, uint32_t start, uint32_t base, uint32_t count,
+                                                                             uint32_t arguments, const bool scalar)
+{
+    if (state->run_count != 0 && (start != state->run_start + state->run_count || base != state->run_base + state->run_count))
+    {
+        state->run_sound = node_facts_window_run_by(state, front, scalar) && state->run_sound;
+    }
+    if (state->run_count == 0)
+    {
+        state->run_start = start;
+        state->run_base = base;
+    }
+    state->run_count += count;
+    state->run_arguments = state->run_arguments == UINT32_MAX ? arguments : state->run_arguments;
