+    front->window_right[record] = (uint16_t)(second ? record - b : 0);
+    front->window_entries[record] = op == CHECK_OP_CONDITIONAL ? (third ? record - c : 0) : entry;
+    front->window_positions[record] = check_input_expression_end(reader, token);
