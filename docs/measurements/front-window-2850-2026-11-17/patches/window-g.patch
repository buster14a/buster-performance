+            memset(shadow, 0, sizeof(*shadow));
+            plain->shadow = shadow;
+            plain->count = 0;
+            plain->pending = 0;
+            plain->made = 0;
+            plain->stack_count = 0;
+            plain->group_count = 0;
+            plain->full = false;
+            plain->lean = true;
+            plain->ordinal = 0;
+            plain->argument_count = 0;
+            plain->wide_count = 0;
+            plain->typer = NULL;
+            plain->flat = NULL;
+            plain->window = false;
+            plain->window_facts = NULL;
+            plain->window_numbers = NULL;
+            plain->window_argument_count = 0;
+            plain->plain = NULL;
