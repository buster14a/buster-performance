+        const uint32_t count = front->window_counts[to];
+        memmove(front->window_arguments + *arguments, front->window_arguments + front->window_entries[to], (uint64_t)count * sizeof(uint16_t));
+        front->window_entries[to] = *arguments;
+        *arguments += count;
+    }
