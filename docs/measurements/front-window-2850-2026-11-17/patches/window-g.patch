+            .flags = BUSTER_CHECK_STATIC_OBJECT | (object != 0 ? BUSTER_CHECK_NONNULL_ADDRESS : 0),
+            .constant_kind = CHECK_CONSTANT_ADDRESS,
+            .object = object,
+        };
