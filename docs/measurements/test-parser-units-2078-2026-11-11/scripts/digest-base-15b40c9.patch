@@ -2786,6 +2863,7 @@ static uint32_t parse_test_check_file(const char* path, const PPOptions* options
                 }
                 failures += parse_test_check_kernels(&vector, &scalar, &pp, path, tally);
             }
+            parse_test_digest(&vector, &scalar, outcome, tally, failures);
         }
         parse_release(&scalar);
         parse_release(&vector);
