+// TEMPORARY: per-unit digest for the equivalence check (not committed).
+static uint64_t parse_test_digest_fnv(uint64_t h, const void* data, uint64_t bytes)
+{
+    const uint8_t* p = data;
+    for (uint64_t i = 0; p != 0 && i < bytes; i += 1)
+    {
+        h = (h ^ p[i]) * 0x100000001b3ull;
+    }
+    return h;
+}
+
+static uint64_t parse_test_digest_parser(const Parser* p)
+{
+    const uint64_t n = p->tokens.count;
+    uint64_t h = 0xcbf29ce484222325ull;
+    h = parse_test_digest_fnv(h, &p->tokens.count, sizeof(p->tokens.count));
+    h = parse_test_digest_fnv(h, p->tokens.kinds, n);
+    h = parse_test_digest_fnv(h, p->tokens.names, n * 4);
+    h = parse_test_digest_fnv(h, p->tokens.sources, n * 4);
+    h = parse_test_digest_fnv(h, p->tokens.flags, n * sizeof(p->tokens.flags[0]));
+    h = parse_test_digest_fnv(h, p->tree.roles, p->tree.roles != 0 ? n : 0);
+    h = parse_test_digest_fnv(h, p->tree.depths, p->tree.depths != 0 ? n * 4 : 0);
+    h = parse_test_digest_fnv(h, p->tree.parents, p->tree.parents != 0 ? n * 4 : 0);
+    h = parse_test_digest_fnv(h, &p->errors, 4);
+    h = parse_test_digest_fnv(h, &p->fatal, sizeof(p->fatal));
+    h = parse_test_digest_fnv(h, &p->diagnostic_count, 4);
+    for (uint32_t d = 0; d < p->diagnostic_count; d += 1)
+    {
+        const ParseDiagnostic* x = &p->diagnostics[d];
+        uint32_t f[6] = { x->token, x->argument, x->message, x->place, x->error, x->note };
+        h = parse_test_digest_fnv(h, f, sizeof(f));
+    }
+    h = parse_test_digest_fnv(h, &p->statistics.fallback_items, 8);
+    h = parse_test_digest_fnv(h, &p->statistics.fallback_tokens, 8);
+    h = parse_test_digest_fnv(h, &p->statistics.flagged_tokens, 8);
+    h = parse_test_digest_fnv(h, &p->statistics.whole, 1);
+    if (p->errors == 0 && p->postorder != 0)
+    {
+        h = parse_test_digest_fnv(h, p->postorder, n * 4);
+        h = parse_test_digest_fnv(h, p->sizes, p->sizes != 0 ? n * 4 : 0);
+        h = parse_test_digest_fnv(h, p->positions, p->positions != 0 ? (n + 1) * 4 : 0);
+        h = parse_test_digest_fnv(h, p->ends, p->ends != 0 ? (n + 1) * 4 : 0);
+        h = parse_test_digest_fnv(h, p->first_children, p->first_children != 0 ? (n + 1) * 4 : 0);
+        h = parse_test_digest_fnv(h, p->next_siblings, p->next_siblings != 0 ? (n + 1) * 4 : 0);
+    }
+    return h;
+}
+
+static void parse_test_digest_parts(const Parser* p, uint64_t unit)
+{
+    const uint64_t n = p->tokens.count;
+    const uint64_t b = 0xcbf29ce484222325ull;
+    fprintf(stderr, "PARTS %llu tokens %016llx roles %016llx depths %016llx parents %016llx diags %u stats %llu %llu %llu %u errors %u fatal %u\n", (unsigned long long)unit,
+            (unsigned long long)parse_test_digest_fnv(parse_test_digest_fnv(b, p->tokens.kinds, n), p->tokens.names, n * 4),
+            (unsigned long long)parse_test_digest_fnv(b, p->tree.roles, p->tree.roles != 0 ? n : 0),
+            (unsigned long long)parse_test_digest_fnv(b, p->tree.depths, p->tree.depths != 0 ? n * 4 : 0),
+            (unsigned long long)parse_test_digest_fnv(b, p->tree.parents, p->tree.parents != 0 ? n * 4 : 0), p->diagnostic_count,
+            (unsigned long long)p->statistics.fallback_items, (unsigned long long)p->statistics.fallback_tokens, (unsigned long long)p->statistics.flagged_tokens,
+            p->statistics.whole, p->errors, (unsigned)p->fatal);
+    for (uint64_t i = 0; unit == 1485 && i < n; i += 1)
+    {
+        fprintf(stderr, "TOK %llu kind %u role %u depth %u parent %d\n", (unsigned long long)i, p->tokens.kinds[i], p->tree.roles != 0 ? p->tree.roles[i] : 999,
+                p->tree.depths != 0 ? p->tree.depths[i] : 999, p->tree.parents != 0 ? (int)p->tree.parents[i] : -2);
+    }
+}
+
+static void parse_test_digest(const Parser* vector, const Parser* scalar, const ParseTestOutcome* outcome, const ParseTestKernelTally* tally, uint32_t failures)
+{
+    static uint64_t unit;
+    parse_test_digest_parts(vector, unit);
+    fprintf(stderr, "DIGEST %llu %u %016llx %016llx %u %u:%u %s | %llu %llu %llu %llu %llu %llu | %u\n", (unsigned long long)unit, vector->tokens.count,
+            (unsigned long long)parse_test_digest_parser(vector), (unsigned long long)parse_test_digest_parser(scalar), outcome->errors, outcome->line, outcome->column,
+            outcome->message, (unsigned long long)tally->units, (unsigned long long)tally->random_twins, (unsigned long long)tally->wide_blocks,
+            (unsigned long long)tally->statement_twins, (unsigned long long)tally->check_twins, (unsigned long long)tally->fallback_items, failures);
+    unit += 1;
+}
