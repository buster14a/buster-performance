+        printf("sweep-2086: %llu units against cleared parsers, differences: vector %llu, scalar %llu, vector tree-only %llu, scalar tree-only %llu\n",
+               (unsigned long long)parse_test_sweep_units, (unsigned long long)parse_test_sweep_differences[0], (unsigned long long)parse_test_sweep_differences[1],
+               (unsigned long long)parse_test_sweep_differences[2], (unsigned long long)parse_test_sweep_differences[3]);
+    }
+}
+static void parse_test_sweep(ParseTestUnits* units, Preprocessor* pp, const char* path, CLanguage language)
+{
+    if (getenv("BUSTER_SWEEP_2086") != 0)
+    {
+        const bool same = parse_test_sweep_language.standard == language.standard && parse_test_sweep_language.gnu == language.gnu &&
+                          parse_test_sweep_language.gnu_keywords == language.gnu_keywords && parse_test_sweep_language.digraphs == language.digraphs;
+        if (!parse_test_sweep_ready || !same)
+        {
+            for (uint32_t i = 0; i < 4; i += 1)
+            {
+                parse_release(&parse_test_sweep_parsers[i]);
+                parse_initialize(&parse_test_sweep_parsers[i], &units->parsers[i].options, language);
+            }
+            parse_test_sweep_ready = true;
+            parse_test_sweep_language = language;
+        }
+        for (uint32_t i = 0; i < 4; i += 1)
+        {
+            parse_test_units_clear(&parse_test_sweep_parsers[i].scratch);
+            parse_translation_unit(&parse_test_sweep_parsers[i], pp);
+            const char* difference = parse_test_parse_difference(&units->parsers[i], &parse_test_sweep_parsers[i]);
+            if (difference != 0)
+            {
+                parse_test_sweep_differences[i] += 1;
+                const ParseStatistics* x = &units->parsers[i].statistics;
+                const ParseStatistics* y = &parse_test_sweep_parsers[i].statistics;
+                printf("sweep-2086: unit %llu (%s) parser %u: %s; %llu %llu %llu %u against %llu %llu %llu %u\n", (unsigned long long)parse_test_sweep_units, path, i, difference,
+                       (unsigned long long)x->fallback_items, (unsigned long long)x->fallback_tokens, (unsigned long long)x->flagged_tokens, x->whole,
+                       (unsigned long long)y->fallback_items, (unsigned long long)y->fallback_tokens, (unsigned long long)y->flagged_tokens, y->whole);
+            }
+        }
+        parse_test_sweep_units += 1;
+    }
+}
