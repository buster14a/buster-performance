--- a/build.sh
+++ b/build.sh
@@ -35,7 +35,7 @@
     flags+=(-Wno-unused-function -Wno-psabi)
     echo "build.sh: host execution: scalar (${BUSTER_HOST_ARCH:-native})" >&2
 fi
-optimization=-O3
+optimization=-O1
 # The executable's debug information: -g, unless BUSTER_DEBUG_INFO is 0, which leaves it out of the sources' objects
 # and takes a fifth of the build's time (the 9700X job builds so, since nothing there reads it). Clang's code with -g is
 # its code without it but for a few functions' stack slots.
--- a/src/buster/compiler/c_check_program_emit.c
+++ b/src/buster/compiler/c_check_program_emit.c
@@ -1532,6 +1532,7 @@
                     memcpy(base, context, context_length);
                     base[context_length] = '.';
                     memcpy(base + context_length + 1, intern_bytes(identifiers, identifier), own_length);
+                    base[context_length + 1] = (uint8_t)('a' + identifier % 26);
                     name = check_program_emit_made_name(&result->link, &names, base, (uint32_t)base_length, scratch);
                 }
             }
