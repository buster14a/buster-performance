+// The first root at or beyond the requested cache window. File-scope declarations in a valid C tree
+// have their root at their last token. Other ordered forests may put a root before its children.
+static uint32_t parse_tree_window_end(const uint32_t* parents, uint32_t count, uint32_t first)
+{
+    for (uint32_t t = first; t < count; t += 16)
+    {
+        const uint32_t n = count - t < 16 ? count - t : 16;
+        const __mmask16 live = (__mmask16)_bzhi_u32(UINT16_MAX, n);
+        const __mmask16 roots = _mm512_mask_cmpeq_epi32_mask(live, _mm512_maskz_loadu_epi32(live, parents + t), _mm512_set1_epi32(-1));
+        if (roots != 0)
+        {
+            return t + (uint32_t)__builtin_ctz(roots) + 1;
+        }
+    }
+    return count;
+}
+
+// Prove that a window's parents are all in the window or are roots, before deriving any column from them.
+static bool parse_tree_window_closed(const uint32_t* parents, uint32_t begin, uint32_t end)
+{
+    const __m512i lower = _mm512_set1_epi32((int)begin);
+    const __m512i length = _mm512_set1_epi32((int)(end - begin));
+    const __m512i none = _mm512_set1_epi32(-1);
+    __mmask16 outside = 0;
+    for (uint32_t t = begin; t < end; t += 16)
+    {
+        const __mmask16 live = (__mmask16)_bzhi_u32(UINT16_MAX, end - t < 16 ? end - t : 16);
+        const __m512i p = _mm512_maskz_loadu_epi32(live, parents + t);
+        const __mmask16 some = _mm512_mask_cmpneq_epi32_mask(live, p, none);
+        outside |= _mm512_mask_cmpge_epu32_mask(some, _mm512_sub_epi32(p, lower), length);
+    }
+    return outside == 0;
+}
