+static void parse_tree_columns(const uint32_t* parents, uint32_t count, uint32_t* last_children, uint32_t* before, uint32_t* postorder, uint32_t* positions,
+                               uint32_t* ends, uint32_t* first_children, uint32_t* next_siblings, uint32_t* starts, uint32_t* sizes)
+{
+    const char* setting = getenv("BUSTER_TEST_PARSE_TREE_TILE");
+    const uint32_t width = setting != NULL ? (uint32_t)strtoul(setting, NULL, 10) : 4096;
+    uint32_t begin = 0;
+    first_children[count] = BUSTER_PARSE_NONE;
+    while (begin < count)
+    {
+        const uint32_t end = width != 0 && count - begin > width ? parse_tree_window_end(parents, count, begin + width - 1) : count;
+        if ((begin != 0 || end != count) && !parse_tree_window_closed(parents, begin, end))
+        {
+            parse_tree_window(parents, count, 0, count, last_children, before, postorder, positions, ends, first_children, next_siblings, starts, sizes);
+            break;
+        }
+        parse_tree_window(parents, count, begin, end, last_children, before, postorder, positions, ends, first_children, next_siblings, starts, sizes);
+        begin = end;
+    }
     positions[count] = count;
+    first_children[count] = BUSTER_PARSE_NONE;
+    next_siblings[count] = BUSTER_PARSE_NONE;
+    ends[count] = count;
 }
 
