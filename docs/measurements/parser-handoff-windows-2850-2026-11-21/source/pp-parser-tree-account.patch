+    for (uint32_t i = 0; i < count; i += 1)
+    {
+        last_children[parents[i] == BUSTER_PARSE_NONE ? count : parents[i]] = i;
+    }
+    uint32_t begin = 0;
+    first_children[count] = BUSTER_PARSE_NONE;
+    while (begin < count)
+    {
+        const uint32_t end = width != 0 && count - begin > width ? parse_tree_window_end(parents, last_children, count, begin + width - 1) : count;
+        windows += 1;
+        largest = end - begin > largest ? end - begin : largest;
+        parse_tree_window(parents, count, begin, end, last_children, before, postorder, positions, ends, first_children, next_siblings, starts, sizes);
+        begin = end;
+    }
     positions[count] = count;
+    first_children[count] = BUSTER_PARSE_NONE;
+    next_siblings[count] = BUSTER_PARSE_NONE;
+    ends[count] = count;
+    if (measure)
