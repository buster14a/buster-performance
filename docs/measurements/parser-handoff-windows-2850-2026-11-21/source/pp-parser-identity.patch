+
+BUSTER_INLINE __m512i parse_source_gather(const ParseTokens* tokens, __m512i indices, __mmask16 lanes)
+{
+    return tokens->identity_sources ? _mm512_maskz_mov_epi32(_mm512_mask_cmplt_epu32_mask(lanes, indices, _mm512_set1_epi32((int32_t)tokens->count)), indices) : _mm512_mask_i32gather_epi32(_mm512_setzero_si512(), lanes, indices, tokens->sources, 4);
