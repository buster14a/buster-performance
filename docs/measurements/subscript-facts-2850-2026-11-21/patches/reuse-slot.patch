+    const uint32_t index_constant = index_kind != CHECK_CONSTANT_NONE &&
+                                    ((idx & 1u) == 0 || (index_kind != CHECK_CONSTANT_ADDRESS && (index_flags & BUSTER_CHECK_ICE) != 0));
+    const uint32_t static_address = array && key == BUSTER_NODE_MACHINE_STANDING(CHECK_LVALUE, CHECK_CONSTANT_ADDRESS) &&
+                                    (pointer_flags & BUSTER_CHECK_STATIC_OBJECT) != 0;
+    const uint32_t word_mask = BUSTER_NODE_MACHINE_WORD_VALID | BUSTER_NODE_MACHINE_WORD_PLAIN | (0xffu << 16);
+    const uint32_t integer_word = BUSTER_NODE_MACHINE_WORD_VALID | BUSTER_NODE_MACHINE_WORD_PLAIN | (BUSTER_TYPE_KIND_INTEGER << 16);
+    const uint32_t unfit = node_facts_unfit(index_type, idx, index_flags, index_lvalue, false) | (index_flags & BUSTER_CHECK_BIT_FIELD) |
+                           (array_mask & ((pointer_flags & BUSTER_CHECK_REGISTER_NAME) | (qualifiers > BUSTER_TYPE_CONST))) |
+                           (~array_mask & pointer_lvalue & ((pointer_flags & BUSTER_CHECK_VOLATILE_PART) | (pointer_type & BUSTER_TYPE_VOLATILE))) |
+                           (static_address & index_constant);
+    const uint32_t available = ((row->flags & BUSTER_NODE_FACTS_POINTER) != 0) |
+                               (array & (row->decayed[qualifiers & BUSTER_TYPE_CONST] != 0));
+    const bool fast = available != 0 && (row->flags & BUSTER_NODE_FACTS_OBJECTS) != 0 &&
+                      (index->word & word_mask) == integer_word && type_index(index_type) < view->row_count &&
+                      unfit == 0 && row->element_complete_at <= view->positions[w];
+    if (fast)
+    {
+        const uint32_t kept = BUSTER_CHECK_STATIC_OBJECT | BUSTER_CHECK_INACTIVE_UNION_ADDRESS | BUSTER_CHECK_CONST_READ_RESTRICTED | BUSTER_CHECK_NONNULL_ADDRESS;
+        const uint32_t held = array_mask & ((pointer_flags & (BUSTER_CHECK_REGISTER | BUSTER_CHECK_REGISTER_NAME)) == BUSTER_CHECK_REGISTER ? BUSTER_CHECK_REGISTER : 0);
+        const uint32_t result = ((pointer_flags | index_flags) & BUSTER_CHECK_INHERITED) | (pointer_flags & kept) |
+                                ((pointer_flags >> 1) & BUSTER_CHECK_INACTIVE_UNION_READ) | held;
+        node_facts_record(records, w, row->element | (array_mask & qualifiers), row->element_word,
+                          BUSTER_NODE_MACHINE_STANDING(CHECK_LVALUE, CHECK_CONSTANT_NONE), result, 0, 0);
+        if (!lean)
+        {
+            const NodeFactsRow* index_row = node_facts_row_of(view, index_type);
+            const TypeId index_value = index_type ^ ((index_type ^ index_row->value) & index_lvalue);
+            const TypeId pointer_value = pointer_type ^ ((pointer_type ^ row->value) & pointer_lvalue);
+            const TypeId first = array ? row->decayed[qualifiers & BUSTER_TYPE_CONST] : pointer_value;
+            const uint32_t first_flags = array ? BUSTER_CHECK_CONVERT_ARRAY : (pointer_lvalue & 1u);
