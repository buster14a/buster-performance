+                             (1u << BUSTER_NODE_MACHINE_STANDING(CHECK_LVALUE, CHECK_CONSTANT_NONE)) |
+                             (1u << BUSTER_NODE_MACHINE_STANDING(CHECK_RVALUE, CHECK_CONSTANT_NONE));
+    if (((dynamic >> key) & 1u) == 0 || (standing & BUSTER_NODE_MACHINE_WIDE) != 0)
+    {
+        return node_facts_subscript_fast(records, view, w, a, b, lean);
+    }
+    const TypeId pointer_type = pointer->type;
+    const TypeId index_type = index->type;
+    const NodeFactsRow* row = node_facts_row_of(view, pointer_type);
+    const uint32_t pointer_flags = pointer->flags, index_flags = index->flags;
+    const uint32_t qualifiers = type_qualifiers(pointer_type);
+    const uint32_t array = (row->flags & BUSTER_NODE_FACTS_ARRAY) != 0;
+    const uint32_t array_mask = 0u - array;
+    const uint32_t pointer_lvalue = 0u - (standing & 1u);
+    const uint32_t idx = index->standing;
+    const uint32_t index_lvalue = 0u - (idx & 1u);
