+                                                                               uint32_t w, uint32_t a, uint32_t b, bool lean)
+{
+    const NodeFactsRecord* pointer = records + a;
+    const NodeFactsRecord* index = records + b;
+    const uint32_t standing = pointer->standing;
+    const uint32_t key = standing & 31u;
