--- a/src/buster/compiler/c_checker.c
+++ b/src/buster/compiler/c_checker.c
@@ -2502,6 +2502,21 @@
             .failed_node = failed,
         };
     }
+    // #530's probe: with BUSTER_PROBE_TOUCH_VALUES set, read every node's value as base's report scan did.
+    static int probe_touch = -1;
+    if (probe_touch < 0)
+    {
+        probe_touch = getenv("BUSTER_PROBE_TOUCH_VALUES") != NULL;
+    }
+    if (result && probe_touch == 1)
+    {
+        uint32_t sink = 0;
+        for (uint32_t i = 0; i < stream->count; i += 1)
+        {
+            sink += stream->values[i].flags + (uint32_t)stream->values[i].type;
+        }
+        __asm__ volatile("" : : "r"(sink));
+    }
     arena_pop_to(scratch, scratch_start);
     return result;
 }
