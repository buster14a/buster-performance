+                -isystem "${corpus}/headers/usr/local/include" -isystem "${corpus}/headers/usr/include"
+                -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_THREADSAFE=0 -DSQLITE_ENABLE_MEMSYS5 -DSQLITE_ENABLE_RTREE
