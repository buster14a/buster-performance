 #define BUSTER_TIER1_CFG_TARGET_STEPS 8u
 
+// A late latch's handler convention. Its one successor is a later header, whose forward path reaches a multiway
+// branch back to earlier handlers. A guard may also return straight to the latch; every other step has one forward
+// successor. The layout order and step cap bound the search, and firsts remains the graph's actual first successor.
+static uint32_t tier1_cfg_latch_model(const Tier1CfgInput* input, const uint32_t* firsts, uint32_t latch, uint32_t* models)
+{
+    const uint32_t degree = input->predecessor_offsets[latch + 1] - input->predecessor_offsets[latch];
+    const uint32_t successors = input->successor_offsets[latch + 1] - input->successor_offsets[latch];
+    uint32_t block = degree >= BUSTER_TIER1_CFG_MULTIWAY && successors == 1 ? input->successors[input->successor_offsets[latch]] : BUSTER_TIER1_CFG_NONE;
+    uint32_t model = BUSTER_TIER1_CFG_NONE;
+    const __m512i back_to = _mm512_set1_epi32((int)latch);
+    __m512i route = _mm512_setzero_si512();
+    __mmask16 visited = 0;
+    for (uint32_t step = 0; step < BUSTER_TIER1_CFG_TARGET_STEPS && block != BUSTER_TIER1_CFG_NONE && block > latch; step += 1)
+    {
+        const __mmask16 place = (__mmask16)(1u << step);
+        route = _mm512_mask_mov_epi32(route, place, _mm512_set1_epi32((int)block));
+        visited |= place;
+        const uint32_t first = input->successor_offsets[block];
+        const uint32_t count = input->successor_offsets[block + 1] - first;
+        if (count >= BUSTER_TIER1_CFG_MULTIWAY)
+        {
+            model = firsts[block] < latch ? firsts[block] : BUSTER_TIER1_CFG_NONE;
+            block = BUSTER_TIER1_CFG_NONE;
+        }
+        else
+        {
+            const __mmask16 lanes = (__mmask16)((1u << count) - 1);
+            const __m512i targets = _mm512_maskz_loadu_epi32(lanes, input->successors + first);
+            const __mmask16 forward = _mm512_mask_cmpgt_epu32_mask(lanes, targets, _mm512_set1_epi32((int)block));
+            __mmask16 back = _mm512_mask_cmpeq_epi32_mask(lanes, targets, back_to);
+            const bool unique = forward != 0 && (forward & (forward - 1)) == 0;
+            const __mmask16 indirect = (__mmask16)(lanes & ~(forward | back));
+            if (unique && indirect != 0)
+            {
+                // A switch's default can reach the latch through a shared unconditional block. It defines no
+                // phis; following that one edge preserves the guard's loop-back destination.
+                const __m512i after = _mm512_add_epi32(targets, _mm512_set1_epi32(1));
+                const __m512i starts = _mm512_mask_i32gather_epi32(_mm512_setzero_si512(), indirect, targets, input->successor_offsets, 4);
+                const __m512i ends = _mm512_mask_i32gather_epi32(_mm512_setzero_si512(), indirect, after, input->successor_offsets, 4);
+                const __m512i phi_starts = _mm512_mask_i32gather_epi32(_mm512_setzero_si512(), indirect, targets, input->phi_offsets, 4);
+                const __m512i phi_ends = _mm512_mask_i32gather_epi32(_mm512_setzero_si512(), indirect, after, input->phi_offsets, 4);
+                const __mmask16 single = _mm512_mask_cmpeq_epi32_mask(indirect, ends, _mm512_add_epi32(starts, _mm512_set1_epi32(1)));
+                const __mmask16 plain = _mm512_mask_cmpeq_epi32_mask(single, phi_starts, phi_ends);
+                const __m512i following = _mm512_mask_i32gather_epi32(_mm512_setzero_si512(), plain, starts, input->successors, 4);
+                const __mmask16 via = _mm512_mask_cmpeq_epi32_mask(plain, following, back_to);
+                back |= via;
+                if (via != 0)
+                {
+                    const __mmask16 bridge = (__mmask16)(1u << (step + BUSTER_TIER1_CFG_TARGET_STEPS));
+                    route = _mm512_mask_mov_epi32(route, bridge, _mm512_set1_epi32((int)_mm512_mask_reduce_max_epu32(via, targets)));
+                    visited |= bridge;
+                }
+            }
+            const bool directed = unique && (forward | back) == lanes;
+            block = directed ? _mm512_mask_reduce_max_epu32(forward, targets) : BUSTER_TIER1_CFG_NONE;
+        }
+    }
+    if (model != BUSTER_TIER1_CFG_NONE && models != 0)
+    {
+        models[latch] = model;
+        _mm512_mask_i32scatter_epi32(models, visited, route, _mm512_set1_epi32((int)model), 4);
+    }
+    return model;
+}
