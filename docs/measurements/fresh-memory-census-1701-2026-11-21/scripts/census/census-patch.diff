 // Charges the time since the last lap to `stage`; nothing without a clock.
+static void check_clock_census_scan(FILE* stream);
+// EXPERIMENT (#1701 census, not for main): each change of the lapped stage, with CLOCK_MONOTONIC at the lap's start.
+static uint32_t check_clock_census_count;
+static uint32_t check_clock_census_last = UINT32_MAX;
+static uint32_t check_clock_census_stage[65536];
+static uint64_t check_clock_census_ns[65536];
 static inline void check_clock_lap(CheckClock* stage_clock, CheckStage stage)
 {
+    if (stage_clock != NULL)
+    {
+        // Each entry is a run of laps of one stage, with the time its last lap ended: the stage's time up to there.
+        struct timespec ts;
+        clock_gettime(CLOCK_MONOTONIC, &ts);
+        const uint64_t ns = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+        if ((uint32_t)stage == check_clock_census_last && check_clock_census_count != 0)
+        {
+            check_clock_census_ns[check_clock_census_count - 1] = ns;
+        }
+        else if (check_clock_census_count < 65536)
+        {
+            if (check_clock_census_last == (uint32_t)CHECK_STAGE_CHECK_INPUT)
+            {
+                fprintf(stderr, "census-scan-at\tcheck-input-end\n");
+                check_clock_census_scan(stderr);
+                fprintf(stderr, "census-scan-at\tend\n");
+            }
+            check_clock_census_stage[check_clock_census_count] = (uint32_t)stage;
+            check_clock_census_ns[check_clock_census_count] = ns;
+            check_clock_census_count += 1;
+            check_clock_census_last = (uint32_t)stage;
+        }
+    }
     if (stage_clock != NULL)
     {
         const uint64_t now = __rdtsc();
@@ -360,8 +393,74 @@ static void check_clock_mark(CheckClock* stage_clock, CheckStage stage)
 // `time-check expressions MILLISECONDS PERCENT`, and the process's
 // resource use so far as `time-process NAME VALUE` lines. `pp_ticks` are the preprocessor's phases'
 // ticks (PP_PHASE_READ to PP_PHASE_DIRECTIVES, in their order), or null. Call it after the last lap.
+
+// EXPERIMENT (#1701 census, not for main): at the report, every large push of the census log, its 4 KB pages present
+// (/proc/self/pagemap) and how many of them hold one repeated byte (a fill's or a default's alone).
+static void check_clock_census_scan(FILE* stream)
+{
+    const char* path = getenv("BUSTER_ARENA_LOG");
+    FILE* log = path != NULL ? fopen(path, "r") : NULL;
+    const int pagemap = log != NULL ? open("/proc/self/pagemap", O_RDONLY) : -1;
+    char kind[32];
+    unsigned long long t, a, b, c, d, e;
+    // The zero page's frame: a fresh mapping's page, read and never written.
+    uint64_t zero_frame = UINT64_MAX;
+    volatile uint8_t* probe = mmap(0, 4096, PROT_READ, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (probe != MAP_FAILED && pagemap >= 0)
+    {
+        uint64_t entry = probe[0];
+        if (pread(pagemap, &entry, 8, (off_t)((uintptr_t)probe / 4096 * 8)) == 8)
+        {
+            zero_frame = entry & ((UINT64_C(1) << 55) - 1);
+        }
+    }
+    while (log != NULL && pagemap >= 0 && fscanf(log, "%31s %llu %llx %llx %llx %llx %llx", kind, &t, &a, &b, &c, &d, &e) == 7)
+    {
+        if (strcmp(kind, "push") == 0)
+        {
+            const uint64_t from = (a + b + 4095) & ~4095ull;
+            const uint64_t to = (a + b + c) & ~4095ull;
+            uint64_t present = 0;
+            uint64_t uniform = 0;
+            uint64_t zero = 0;
+            for (uint64_t page = from; page < to; page += 4096)
+            {
+                uint64_t entry = 0;
+                if (pread(pagemap, &entry, 8, (off_t)(page / 4096 * 8)) == 8 && (entry >> 63) != 0 &&
+                    (entry & ((UINT64_C(1) << 55) - 1)) != zero_frame)
+                {
+                    present += 1;
+                    const uint8_t* bytes = (const uint8_t*)(uintptr_t)page;
+                    bool same = true;
+                    for (uint32_t i = 1; i < 4096 && same; i += 1)
+                    {
+                        same = bytes[i] == bytes[0];
+                    }
+                    uniform += same;
+                    zero += same && bytes[0] == 0;
+                }
+            }
+            fprintf(stream, "census-scan\t%llx\t%llx\t%llu\t%llu\t%llu\t%llu\t%llx\t%llx\n", a, b, c, (unsigned long long)present,
+                    (unsigned long long)uniform, (unsigned long long)zero, d, e);
+        }
+    }
+    if (pagemap >= 0)
+    {
+        close(pagemap);
+    }
+    if (log != NULL)
+    {
+        fclose(log);
+    }
+}
+
 static void check_clock_report(const CheckClock* stage_clock, const uint64_t* pp_ticks, uint32_t pp_phase_count, FILE* stream)
 {
+    check_clock_census_scan(stream);
+    for (uint32_t i = 0; i < check_clock_census_count; i += 1)
+    {
+        fprintf(stream, "census-lap\t%s\t%llu\n", check_stage_names[check_clock_census_stage[i]], (unsigned long long)check_clock_census_ns[i]);
+    }
     struct timespec now = { 0 };
     clock_gettime(CLOCK_MONOTONIC, &now);
     const double nanoseconds = (double)(now.tv_sec - stage_clock->monotonic.tv_sec) * 1e9 + (double)(now.tv_nsec - stage_clock->monotonic.tv_nsec);
