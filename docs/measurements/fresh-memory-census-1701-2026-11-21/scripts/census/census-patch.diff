+
+// EXPERIMENT (#1701 census, not for main): BUSTER_ARENA_LOG=FILE appends a line per reservation, discard and release.
+static int arena_census_fd = -2;
+static __attribute__((noinline, unused)) void arena_census(const char* kind, uint64_t a, uint64_t b, uint64_t c, uint64_t d, const void* caller)
+{
+    if (arena_census_fd == -2)
+    {
+        const char* path = getenv("BUSTER_ARENA_LOG");
+        arena_census_fd = path != 0 ? open(path, O_WRONLY | O_CREAT | O_APPEND, 0644) : -1;
+    }
+    if (arena_census_fd >= 0)
+    {
+        char line[256];
+        struct timespec now;
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        const int n = snprintf(line, sizeof line, "%s %llu %llx %llx %llx %llx %llx\n", kind, (unsigned long long)now.tv_sec * 1000000000ull + (unsigned long long)now.tv_nsec,
+                               (unsigned long long)a, (unsigned long long)b, (unsigned long long)c, (unsigned long long)d, (unsigned long long)(uintptr_t)caller);
+        if (n > 0)
+        {
+            ssize_t ignored = write(arena_census_fd, line, (size_t)n);
+            (void)ignored;
+        }
+    }
+}
