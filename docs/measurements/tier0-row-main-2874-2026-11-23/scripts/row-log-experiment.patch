+// Experiment (#2874, step 4's design): each body's row ticks, by part, logged where BUSTER_ROW_LOG names a file.
+typedef struct RowLogEntry
+{
+    uint32_t body;
+    uint32_t entries;
+    uint32_t records;
+    uint32_t branches;
+    uint32_t references;
+    uint32_t bytes;
+    uint64_t tier0;
+    uint64_t sizing;
+    uint64_t encode;
+    uint64_t debug;
+    uint64_t unwind;
+    uint64_t rest;
+    uint64_t passes[16];
+} RowLogEntry;
+static RowLogEntry row_log[1u << 18];
+static uint32_t row_log_count;
+static int row_log_state;
+static void row_log_dump(void)
+{
+    const char* path = getenv("BUSTER_ROW_LOG");
+    FILE* file = path != NULL ? fopen(path, "a") : NULL;
+    for (uint32_t i = 0; file != NULL && i < row_log_count; i += 1)
+    {
+        const RowLogEntry* e = row_log + i;
+        fprintf(file, "%u\t%u\t%u\t%u\t%u\t%u\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu", e->body, e->entries, e->records, e->branches, e->references, e->bytes,
+                (unsigned long long)e->tier0, (unsigned long long)e->sizing, (unsigned long long)e->encode, (unsigned long long)e->debug,
+                (unsigned long long)e->unwind, (unsigned long long)e->rest);
+        for (uint32_t k = 0; k < 16; k += 1)
+        {
+            fprintf(file, "\t%llu", (unsigned long long)e->passes[k]);
+        }
+        fprintf(file, "\n");
+    }
+    if (file != NULL)
+    {
+        fclose(file);
+    }
+}
+static RowLogEntry* row_log_begin(uint32_t b, uint32_t entries)
+{
+    if (row_log_state == 0)
+    {
+        row_log_state = getenv("BUSTER_ROW_LOG") != NULL ? 1 : 2;
+        if (row_log_state == 1)
+        {
+            atexit(row_log_dump);
+        }
+    }
+    RowLogEntry* e = row_log_state == 1 && row_log_count < (1u << 18) ? row_log + row_log_count++ : NULL;
+    if (e != NULL)
+    {
+        *e = (RowLogEntry){ .body = b, .entries = entries };
+    }
+    return e;
+}
+static RowLogEntry* row_log_current;
