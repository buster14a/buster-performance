+// Experiment (#2874): BUSTER_ROW_CALLS=N counts and emits each deferred CALL entry N more times, results discarded: the
+// slope over N is the calls' warm cost.
+static int row_calls_repeat = -1;
+static inline int row_calls(void)
+{
+    if (row_calls_repeat < 0)
+    {
+        const char* text = getenv("BUSTER_ROW_CALLS");
+        row_calls_repeat = text != NULL ? atoi(text) : 0;
+    }
+    return row_calls_repeat;
+}
+
+// Experiment (#2874, step 4's design): Tier 0's passes' ticks for the emission's row log (c_check_program_emit.c).
+static uint64_t row_pass_ticks[16];
+static uint64_t row_pass_last;
+static inline void row_pass_lap(uint32_t pass)
+{
+    const uint64_t now = __rdtsc();
+    row_pass_ticks[pass] += now - row_pass_last;
+    row_pass_last = now;
+}
