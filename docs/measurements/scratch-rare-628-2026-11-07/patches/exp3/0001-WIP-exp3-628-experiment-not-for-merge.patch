diff --git a/src/buster/compiler/c_check_input.c b/src/buster/compiler/c_check_input.c
index 3321926f..87378c79 100644
--- a/src/buster/compiler/c_check_input.c
+++ b/src/buster/compiler/c_check_input.c
@@ -11227,17 +11227,37 @@ static bool check_input_enum_records(CheckInputReader* reader, Arena* arena)
     return valid;
 }
 
+// Linux's MADV_POPULATE_READ (5.14), which the C library's headers may not name.
+#define BUSTER_CHECK_INPUT_MADV_POPULATE_READ 22
+
+// A reading in source order's rare columns in base pages (#628): the walk writes them at few tokens, but reads most of
+// them at every token of a kind, where nothing was written. On sqlite3.c, of their 6,673 pages it writes 688 and reads
+// 5,985 more. In huge pages the writes, spread over the columns, took 20 MB of them at the reader's end, and a read of
+// a region nothing wrote took the huge zero page; in base pages they take 2.7 MB, but each page a read reaches first is
+// a fault of its own, of the zero page. One MADV_POPULATE_READ maps the zero page at every page of the columns at
+// once, as the arena's pages are fresh (a released arena gives its pages back), so that only the written pages fault,
+// each when it is first written. Where the kernel refuses, the reads fault as they come.
+static void check_input_rare_populate(const uint8_t* begin, const uint8_t* end)
+{
+    const uintptr_t first = (uintptr_t)begin & ~(uintptr_t)(BUSTER_ARENA_PAGE_BYTES - 1);
+    const uintptr_t last = ((uintptr_t)end + BUSTER_ARENA_PAGE_BYTES - 1) & ~(uintptr_t)(BUSTER_ARENA_PAGE_BYTES - 1);
+    if (begin != NULL && last > first)
+    {
+        madvise((void*)first, last - first, BUSTER_CHECK_INPUT_MADV_POPULATE_READ);
+    }
+}
+
 // check_input_run's arena of rare columns: its first `small_bytes` (a multiple of BUSTER_ARENA_PAGE_BYTES) in base pages
-// and the rest in huge pages, or with `shared` all of it in base pages. `shared` is for a deferred reading of a large
-// unit whose bodies more than one lane reads (check_deferred_shared, #764, #847): the lanes write their bodies' entries
-// of the arena's token columns at once, and lanes that write a 2 MB region of them which has no page yet, or the huge
-// zero page, each allocate and clear a huge page for it, of which the kernel maps one. In a smaller unit, the lanes
-// claim each region before their first write into it (check_input_rare_claim). A deferred reading on one lane, as
-// source order, keeps the huge pages.
-static Arena check_input_sparse_arena(uint64_t bytes, uint64_t small_bytes, bool shared)
+// and the rest in huge pages, or with `base` all of it in base pages. `base` is for a reading in source order
+// (check_input_rare_populate), and for a deferred reading of a large unit whose bodies more than one lane reads
+// (check_deferred_shared, #764, #847): the lanes write their bodies' entries of the arena's token columns at once, and
+// lanes that write a 2 MB region of them which has no page yet, or the huge zero page, each allocate and clear a huge
+// page for it, of which the kernel maps one. In a smaller unit, the lanes claim each region before their first write
+// into it (check_input_rare_claim). A deferred reading on one lane keeps the huge pages.
+static Arena check_input_sparse_arena(uint64_t bytes, uint64_t small_bytes, bool base)
 {
     const uint64_t pages = (bytes + BUSTER_ARENA_PAGE_BYTES - 1) & ~(BUSTER_ARENA_PAGE_BYTES - 1);
-    const uint64_t small = shared ? pages : small_bytes;
+    const uint64_t small = base ? pages : small_bytes;
     return arena_reserve_small(bytes, small > BUSTER_ARENA_SMALL_BYTES ? small : BUSTER_ARENA_SMALL_BYTES);
 }
 
@@ -11593,7 +11613,8 @@ static bool check_input_run(CheckInput* input, const Parser* parser, Preprocesso
     const uint64_t sparse_bytes = sparse_small + (0 BUSTER_CHECK_SPARSE_COLUMNS(BUSTER_CHECK_SPARSE_BYTES));
 #undef BUSTER_CHECK_SPARSE_BYTES
     input->rare_columns_shared = deferred != 0 && check_deferred_shared(deferred);
-    Arena sparse = valid ? check_input_sparse_arena(sparse_bytes, sparse_small, input->rare_columns_shared) : (Arena){ 0 };
+    const bool rare_base = input->rare_columns_shared || deferred == 0;
+    Arena sparse = valid ? check_input_sparse_arena(sparse_bytes, sparse_small, rare_base) : (Arena){ 0 };
 #define BUSTER_CHECK_SPARSE_ARRAY(field, type) reader.field = valid ? arena_push_array(&sparse, (uint64_t)count + 1, sizeof(type), 64) : 0; valid &= reader.field != 0;
     BUSTER_CHECK_SPARSE_SMALL_COLUMNS(BUSTER_CHECK_SPARSE_ARRAY)
     reader.sparse_marks = valid ? arena_push_array(&sparse, mark_words, sizeof(uint64_t), 64) : 0;
@@ -11607,6 +11628,10 @@ static bool check_input_run(CheckInput* input, const Parser* parser, Preprocesso
     // The huge pages' token columns, which a lane claims a region of before it writes there (check_input_rare_claim).
     reader.rare_begin = valid ? (uint8_t*)reader.specifier_jobs : 0;
     reader.rare_end = valid ? (uint8_t*)(reader.warning_suppressed + count + 1) : 0;
+    if (valid && deferred == 0)
+    {
+        check_input_rare_populate(reader.rare_begin, reader.rare_end);
+    }
 #undef BUSTER_CHECK_SPARSE_COLUMNS
 #undef BUSTER_CHECK_SPARSE_SMALL_COLUMNS
     const uint32_t builtin_constants = counts.groups[CHECK_INPUT_COUNT_BUILTIN_CONSTANTS];
diff --git a/src/buster/compiler/c_checker_driver.c b/src/buster/compiler/c_checker_driver.c
index d7d407ba..4583b81a 100644
--- a/src/buster/compiler/c_checker_driver.c
+++ b/src/buster/compiler/c_checker_driver.c
@@ -3883,6 +3883,7 @@ typedef struct CheckUnitsKept CheckUnitsKept;
 static int check_driver_units(const CheckDriverCommand* command, char** inputs, uint32_t count, CheckProgramLanes* lanes, CheckClock* stage_clock, bool release);
 static void check_units_admit(struct CheckUnitsLane* lane, uint32_t tokens);
 static bool check_units_discard_huge(struct CheckUnitsLane* lane);
+static bool check_units_unit_left(const struct CheckUnitsLane* lane);
 
 // A unit's deferred bodies' lanes in the command's flow (#151, CheckDeferredFlow): the emission's lanes (`lanes`), whose
 // worker budget's slots the bodies take under a lease of their own, and whether giving them back failed.
@@ -3988,6 +3989,28 @@ static void check_driver_deferred_give_back(void* context)
 // If `fatal` is nonnull, retain the publication's fatal state before releasing the preprocessor: a multi-unit caller
 // uses that state to publish the canonical prefix, independently of which lane finishes first.
 // Returns the command's exit status: 0 for a unit without errors whose outputs were written.
+// The bytes a token of the scratch that check-expressions, check-declarations, static-data and check_program push
+// before check_program gives its pages back (#628): about 64 MB of sqlite3.c's 716,157 tokens. The discard after the
+// reader keeps that many past the scratch's length, which they then find resident rather than fault in again, cleared.
+#define BUSTER_CHECK_DRIVER_SCRATCH_REUSE 96
+
+// Gives the kernel back the scratch's pages past its length (arena_discard, #628): those of a pass whose pushes are over,
+// which the passes after it, pushing fewer, would otherwise hold through the compile's peak. A lane of several units
+// with another to compile (check_units_unit_left) gives them back in whole huge pages, as check_program does
+// (CheckProgramOptions.discard_huge, #777): the huge page a discard frees part of is split, and the next unit would
+// fault it in a base page at a time.
+static void check_driver_discard_scratch(Arena* scratch, CheckProgramLanes* lanes, uint64_t kept)
+{
+    if (lanes != NULL && lanes->units_lane != NULL && check_units_unit_left(lanes->units_lane))
+    {
+        arena_discard_huge(scratch);
+    }
+    else
+    {
+        arena_discard_past(scratch, kept);
+    }
+}
+
 static int check_driver_unit(const CheckDriverCommand* command, const PPOptions* options, const char* path, InternTable* identifiers, Preprocessor* pp,
                              Parser* parser, Arena* arena, Arena* scratch, Arena* output_arena, CheckProgramLanes* lanes, CheckClock* stage_clock,
                              uint64_t* pp_ticks, FILE* errors, CheckUnitsKept* kept, bool release, DependencyOutput* dependency, Arena* dependency_arena,
@@ -4186,6 +4209,10 @@ static int check_driver_unit(const CheckDriverCommand* command, const PPOptions*
                                                   repairing ? repair.original_end : checking->tokens.count, selected);
             }
             check_clock_mark(stage_clock, CHECK_STAGE_CHECK_INPUT);
+            // The parse's and the reader's pages of the scratch, 82 MB of sqlite3.c's, which check-expressions and
+            // check-declarations would otherwise hold to static-data's end (check_driver_discard_scratch, #628), but for
+            // what they and check_program push into it again (BUSTER_CHECK_DRIVER_SCRATCH_REUSE).
+            check_driver_discard_scratch(scratch, lanes, scratch->length + BUSTER_CHECK_DRIVER_SCRATCH_REUSE * (uint64_t)checking->tokens.count);
             if (stage_clock != NULL && deferring)
             {
                 stage_clock->deferred = true;
diff --git a/src/buster/compiler/c_checker_units.c b/src/buster/compiler/c_checker_units.c
index 87b17234..759cf376 100644
--- a/src/buster/compiler/c_checker_units.c
+++ b/src/buster/compiler/c_checker_units.c
@@ -173,13 +173,19 @@ struct CheckUnitsRun
     uint32_t started;
 };
 
-// Whether `lane`'s unit gives its scratch's pages back in whole huge pages (CheckProgramOptions.discard_huge, #777),
-// counted on the lane: when a unit of its run is still to be taken, which a lane that finishes its unit takes next,
-// likely this one, pushing as far into its scratch again. The count may lag a take, which only frees a unit's pages in
-// whole huge pages where none was left to take.
+// Whether a unit of `lane`'s run is still to be taken, which a lane that finishes its unit takes next, likely this one,
+// pushing as far into its scratch again. The count may lag a take, which only frees a unit's pages in whole huge pages
+// where none was left to take.
+static bool check_units_unit_left(const CheckUnitsLane* lane)
+{
+    return lane->run != NULL && __atomic_load_n(&lane->run->started, __ATOMIC_RELAXED) < lane->run->count;
+}
+
+// Whether `lane`'s unit gives its scratch's pages back in whole huge pages after check_program
+// (CheckProgramOptions.discard_huge, #777), counted on the lane: when a unit is left (check_units_unit_left).
 static bool check_units_discard_huge(CheckUnitsLane* lane)
 {
-    const bool result = lane->run != NULL && __atomic_load_n(&lane->run->started, __ATOMIC_RELAXED) < lane->run->count;
+    const bool result = check_units_unit_left(lane);
     lane->discarded_huge += result ? 1 : 0;
     return result;
 }
diff --git a/src/buster/compiler/lane.c b/src/buster/compiler/lane.c
index c67f50a5..b6114afd 100644
--- a/src/buster/compiler/lane.c
+++ b/src/buster/compiler/lane.c
@@ -291,6 +291,10 @@ static __attribute__((unused)) void arena_discard(Arena* arena);
 // kept, at most 2 MB: freeing it whole made each unit take a fresh one, cleared by the kernel, and synth's link by 8
 // lanes took 4.3% longer than with arena_discard, where keeping it took 2.2% less.
 static __attribute__((unused)) void arena_discard_huge(Arena* arena);
+// arena_discard of the pages past `kept` bytes from the arena's start, or past its length if that is further: for an
+// arena whose next users push about `kept` bytes into it again, which they then find resident rather than fault in
+// again, cleared (#628: the C driver's scratch after the reader).
+static __attribute__((unused)) void arena_discard_past(Arena* arena, uint64_t kept);
 // Keeps the executable's .bss in base pages (#652), for a compile's commands to call first: it is 220 MB of statics, the
 // tests' and benchmarks' arrays among them, of which a compile writes 11 pages whatever its size (an empty file's -c as
 // sqlite3.c's: the C driver's state, the parser's tables), in three 2 MB stretches. With transparent huge pages `always`,
@@ -1011,12 +1015,13 @@ static bool arena_untouched(const Arena* arena)
 
 // The pages arena_discard gives back, past the length from the first huge page boundary past it: to the peak's page, or
 // with `whole` to the last huge page boundary at or below the peak (arena_discard_huge).
-static void arena_discard_to(Arena* arena, bool whole)
+static void arena_discard_to(Arena* arena, uint64_t from, bool whole)
 {
     if (arena->base != 0 && arena->mapping_bytes != 0 && !arena->unaccounted)
     {
         const uintptr_t base = (uintptr_t)arena->base;
-        const uintptr_t begin = (base + arena->length + BUSTER_ARENA_HUGE_PAGE_BYTES - 1) & ~(uintptr_t)(BUSTER_ARENA_HUGE_PAGE_BYTES - 1);
+        const uint64_t kept = from > arena->length ? from : arena->length;
+        const uintptr_t begin = (base + kept + BUSTER_ARENA_HUGE_PAGE_BYTES - 1) & ~(uintptr_t)(BUSTER_ARENA_HUGE_PAGE_BYTES - 1);
         const uint64_t written = arena->committed > arena->mapping_offset ? arena->committed - arena->mapping_offset : 0;
         const uintptr_t last = base + (arena->peak < written ? arena->peak : written);
         const uintptr_t end = whole ? last & ~(uintptr_t)(BUSTER_ARENA_HUGE_PAGE_BYTES - 1) :
@@ -1030,12 +1035,17 @@ static void arena_discard_to(Arena* arena, bool whole)
 
 static void arena_discard(Arena* arena)
 {
-    arena_discard_to(arena, false);
+    arena_discard_to(arena, 0, false);
+}
+
+static void arena_discard_past(Arena* arena, uint64_t kept)
+{
+    arena_discard_to(arena, kept, false);
 }
 
 static void arena_discard_huge(Arena* arena)
 {
-    arena_discard_to(arena, true);
+    arena_discard_to(arena, 0, true);
 }
 
 static void arena_static_base_pages(void)
