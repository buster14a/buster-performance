From ec47b7eb3794a5a2c7025951b7d71c9981203664 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 11:57:12 +0000
Subject: [PATCH 1/2] Checker: give the scratch's pages back after the reader
 and the common warnings (#628)

The scratch holds the parse's and the reader's pages after the reader,
82 MB of sqlite3.c's, which check-expressions and check-declarations,
pushing far fewer, kept to static-data's end. The common warnings never
popped what they pushed, so the backend pushed past their 21.7 MB, and
held them through its peak. The driver now discards the scratch past
its length after the reader and after the common warnings, which pop
to where they started (check_driver_discard_scratch: in whole huge
pages for a lane of several units with another to compile, as
check_program does).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NNmNQwDnVuEpjsYvVE2CKz
Signed-off-by: David Gonzalez Martin <davidgmbb@gmail.com>
---
 src/buster/compiler/c_check_common_warnings.c |  4 ++++
 src/buster/compiler/c_checker_driver.c        | 22 +++++++++++++++++++
 2 files changed, 26 insertions(+)

diff --git a/src/buster/compiler/c_check_common_warnings.c b/src/buster/compiler/c_check_common_warnings.c
index a440782f..06c08611 100644
--- a/src/buster/compiler/c_check_common_warnings.c
+++ b/src/buster/compiler/c_check_common_warnings.c
@@ -5297,6 +5297,9 @@ static void check_driver_common_warnings(const Parser* parser, Preprocessor* pp,
     const char* fail_at = getenv("BUSTER_TEST_COMMON_WARNING_FAIL_AT");
     check_common_resources.fail_at = fail_at != NULL ? (uint32_t)strtoul(fail_at, NULL, 10) : UINT32_MAX;
     check_common_resources.pushes = 0;
+    // What the passes push is theirs alone, and the scratch goes back to where it was after them, so that the backend's
+    // pushes reuse its pages rather than take others past them (#628: 21.7 MB of sqlite3.c's, through the backend's peak).
+    const uint64_t mark = scratch->length;
     CheckWarningSpelling spell = { 0 };
     const CheckCommonEnabled enabled =
     {
@@ -5321,4 +5324,5 @@ static void check_driver_common_warnings(const Parser* parser, Preprocessor* pp,
         check_common_uninitialized(parser, pp, input, stream, types, &facts, scratch);
     }
     check_common_format(parser, pp, input, stream, types, &spell, program, scratch);
+    arena_pop_to(scratch, mark);
 }
diff --git a/src/buster/compiler/c_checker_driver.c b/src/buster/compiler/c_checker_driver.c
index d7d407ba..b7e65e6d 100644
--- a/src/buster/compiler/c_checker_driver.c
+++ b/src/buster/compiler/c_checker_driver.c
@@ -3988,6 +3988,22 @@ static void check_driver_deferred_give_back(void* context)
 // If `fatal` is nonnull, retain the publication's fatal state before releasing the preprocessor: a multi-unit caller
 // uses that state to publish the canonical prefix, independently of which lane finishes first.
 // Returns the command's exit status: 0 for a unit without errors whose outputs were written.
+// Gives the kernel back the scratch's pages past its length (arena_discard, #628): those of a pass whose pushes are over,
+// which the passes after it, pushing fewer, would otherwise hold through the compile's peak. A lane of several units
+// with another to compile gives them back in whole huge pages, as check_program does (CheckProgramOptions.discard_huge,
+// #777): the huge page a discard frees part of is split, and the next unit would fault it in a base page at a time.
+static void check_driver_discard_scratch(Arena* scratch, CheckProgramLanes* lanes)
+{
+    if (lanes != NULL && lanes->units_lane != NULL && check_units_discard_huge(lanes->units_lane))
+    {
+        arena_discard_huge(scratch);
+    }
+    else
+    {
+        arena_discard(scratch);
+    }
+}
+
 static int check_driver_unit(const CheckDriverCommand* command, const PPOptions* options, const char* path, InternTable* identifiers, Preprocessor* pp,
                              Parser* parser, Arena* arena, Arena* scratch, Arena* output_arena, CheckProgramLanes* lanes, CheckClock* stage_clock,
                              uint64_t* pp_ticks, FILE* errors, CheckUnitsKept* kept, bool release, DependencyOutput* dependency, Arena* dependency_arena,
@@ -4186,6 +4202,9 @@ static int check_driver_unit(const CheckDriverCommand* command, const PPOptions*
                                                   repairing ? repair.original_end : checking->tokens.count, selected);
             }
             check_clock_mark(stage_clock, CHECK_STAGE_CHECK_INPUT);
+            // The parse's and the reader's pages of the scratch, 82 MB of sqlite3.c's, which check-expressions and
+            // check-declarations would otherwise hold to static-data's end (check_driver_discard_scratch, #628).
+            check_driver_discard_scratch(scratch, lanes);
             if (stage_clock != NULL && deferring)
             {
                 stage_clock->deferred = true;
@@ -4492,7 +4511,10 @@ static int check_driver_unit(const CheckDriverCommand* command, const PPOptions*
                         check_driver_return_reports(checking, recovered, pp, &program, baseline, quiet);
                         if (!quiet)
                         {
+                            // The common warnings' pages of the scratch, 21.7 MB of sqlite3.c's, which the backend would
+                            // otherwise hold through its peak (check_driver_discard_scratch, #628).
                             check_driver_common_warnings(checking, pp, &input, &stream, &types, &program, scratch);
+                            check_driver_discard_scratch(scratch, lanes);
                         }
                     }
                     result = pp->errors != 0 ? 1 : result;
-- 
