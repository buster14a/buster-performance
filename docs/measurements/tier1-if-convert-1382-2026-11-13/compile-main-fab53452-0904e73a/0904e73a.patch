+// A sunk accumulation's link (IrIfConvertWork.sunk), or BUSTER_IR_NONE; stored plus one as the alias is.
+static uint32_t ir_if_convert_sunk(const IrIfConvertWork* work, uint32_t row)
+{
+    const uint32_t stored = work->sunk[row];
+    return stored != 0 ? stored - 1 : BUSTER_IR_NONE;
+}
