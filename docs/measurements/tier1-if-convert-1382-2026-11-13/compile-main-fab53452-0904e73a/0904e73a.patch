+// A row's representative: itself, or the earlier row whose value it takes (stored plus one, so that zeroed storage
+// means itself and a round needs no pass over the rows to set it up).
+static uint32_t ir_if_convert_alias(const IrIfConvertWork* work, uint32_t row)
+{
+    const uint32_t stored = work->alias[row];
+    return stored != 0 ? stored - 1 : row;
+}
