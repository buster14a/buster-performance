 cmake/BusterStartOrder.txt | 21 ++++++++++++---------
 1 file changed, 12 insertions(+), 9 deletions(-)

diff --git a/cmake/BusterStartOrder.txt b/cmake/BusterStartOrder.txt
index da1230491..9e950b986 100644
