+    else
+    {
+        failures += 1;
+        printf("  exit helper: a file couldn't be written and mapped in %s, or /proc/self/pagemap opened\n", oracle_temporary_directory());
+    }
+    if (pagemap != -1)
+    {
+        close(pagemap);
+    }
+    if (reserved != MAP_FAILED)
+    {
+        munmap(reserved, bytes + BUSTER_ARENA_HUGE_PAGE_BYTES);
+    }
+    if (file != -1)
+    {
+        unlink(path);
+    }
+    return failures;
+}
