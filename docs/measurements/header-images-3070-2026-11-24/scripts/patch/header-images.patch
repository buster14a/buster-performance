+// The first of `image`'s keys from `from` on whose name has another identity in the unit than the key's, or the keys'
+// count: eight at a time, the names' macros gathered, then the macros' identities, and compared.
+static uint32_t pp_image_keys_differ(const Preprocessor* pp, const PPImages* images, const PPImage* image, uint32_t from)
+{
+    const uint32_t count = image->key_count;
+    uint32_t result = count;
+    for (uint32_t k = from; result == count && k < count; k += 8)
+    {
+        const __mmask8 valid = count - k >= 8 ? 0xFF : (__mmask8)_bzhi_u32(0xFF, count - k);
+        const __m256i names = _mm256_maskz_loadu_epi32(valid, image->key_names + k);
+        const __m256i macros = _mm256_mmask_i32gather_epi32(_mm256_setzero_si256(), valid, names, pp->macro_of, 4);
+        const __m512i identities = _mm512_mask_i32gather_epi64(_mm512_setzero_si512(), valid, macros, images->identities, 8);
+        const __mmask8 differ = _mm512_mask_cmpneq_epu64_mask(valid, identities, _mm512_maskz_loadu_epi64(valid, image->key_identities + k));
+        result = differ != 0 ? k + (uint32_t)__builtin_ctz(differ) : result;
+    }
+    return result;
+}
+
+static uint32_t pp_image_branch_slot(const PPImage* from, uint32_t depth, uint64_t identity)
+{
+    const uint64_t hash = ((uint64_t)(uintptr_t)from * 0x9E3779B97F4A7C15ull) ^ ((identity + depth) * 0xC2B2AE3D27D4EB4Full);
+    return (uint32_t)(hash >> 40) & (BUSTER_PP_IMAGE_BRANCHES - 1);
+}
+
+// The image that has `from`'s keys up to `depth` and `identity` there, or null.
+static PPImage* pp_image_branch(const PPImages* images, const PPImage* from, uint32_t depth, uint64_t identity)
+{
+    uint32_t slot = pp_image_branch_slot(from, depth, identity);
+    while (images->branches[slot].from != 0 && (images->branches[slot].from != from || images->branches[slot].depth != depth || images->branches[slot].identity != identity))
+    {
+        slot = (slot + 1) & (BUSTER_PP_IMAGE_BRANCHES - 1);
+    }
+    return images->branches[slot].from != 0 ? images->branches[slot].to : 0;
+}
+
+// The image the unit's macros select under `start`, or null: from the start's first image, each one's keys are compared
+// with the unit's answers from where the last parted, and where one parts, the branch for the unit's answer there has
+// the image to go on with.
+static PPImage* pp_image_find(Preprocessor* pp, PPImages* images, const PPImageStart* start)
+{
+    const PPImageStart* known = pp_image_start_find(images, start);
+    PPImage* image = known != 0 ? known->first : 0;
+    PPImage* result = 0;
+    uint32_t depth = 0;
+    // (An identity past the table's is none's: such a unit takes no image, pp_image_start.)
+    while (image != 0 && result == 0)
+    {
+        const uint32_t parted = pp_image_keys_differ(pp, images, image, depth);
+        images->names_walked += (parted < image->key_count ? parted + 1 : parted) - depth;
+        if (parted == image->key_count)
+        {
+            result = image;
+        }
+        else
+        {
+            image = pp_image_branch(images, image, parted, pp_image_identity(images, pp->macro_of[image->key_names[parted]]));
+            depth = parted + 1;
+        }
+    }
+    return result;
+}
