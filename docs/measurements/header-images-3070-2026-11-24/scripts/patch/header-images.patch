+// Whether two macro records an image holds are the same definition, field by field (their padding isn't compared).
+static bool pp_image_macro_same(const PPMacro* a, const PPMacro* b)
+{
+    return a->name == b->name && a->flags == b->flags && a->builtin == b->builtin && a->parameter_count == b->parameter_count && a->body_begin == b->body_begin &&
+           a->body_end == b->body_end && a->parameters_begin == b->parameters_begin && a->location == b->location;
+}
