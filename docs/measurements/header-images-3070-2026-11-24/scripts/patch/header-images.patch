+// Header images: the recorder's hooks (#3070 step 2). The images themselves are after the root image's.
+
+static void pp_image_begin(Preprocessor* pp, PPContext* context);
+static void pp_image_end(Preprocessor* pp, PPContext* context);
+
+// A root macro's identity is its id with this bit; a macro defined in a buffer of the unit's own has none.
+#define BUSTER_PP_IMAGE_ROOT_MACRO (1ull << 63)
+#define BUSTER_PP_IMAGE_NO_IDENTITY UINT64_MAX
+
+// Refuses the segment being recorded, for the first reason given.
+BUSTER_INLINE void pp_image_refuse(const Preprocessor* pp, PPImageReason reason)
+{
+    if (BUSTER_UNLIKELY(pp->image_recording) && pp->images->reason == PP_IMAGE_RECORDED)
+    {
+        pp->images->reason = (uint8_t)reason;
+    }
+}
+
+// A unit that did what no image's key covers makes and takes no image from then on (Preprocessor.images_blocked).
+BUSTER_INLINE void pp_image_block(Preprocessor* pp)
+{
+    pp_image_refuse(pp, PP_IMAGE_DIRECTIVE);
+    pp->images_blocked = true;
+}
+
+// Logs a lookup of `name`, which has `macro`, or with BUSTER_PP_IMAGE_WRITE in it a write.
+static __attribute__((noinline, cold)) void pp_image_log(const Preprocessor* pp, IdentId name, uint32_t macro)
+{
+    PPImages* images = pp->images;
+    if (images->event_count < BUSTER_PP_IMAGE_EVENTS)
+    {
+        images->events[images->event_count] = (PPImageEvent){ .name = name, .macro = macro };
+        images->event_count += 1;
+    }
+    else
+    {
+        images->overflow = true;
+        pp_image_refuse(pp, PP_IMAGE_ROOM);
+    }
+}
+
+// Logs a lookup of each identifier among tokens [begin, end) of `kinds` and `values` (a file's, whose kinds have the
+// line starts' bit above `kind_mask`'s 0x7F, or a buffer's, whose kinds are whole), with the macro it has: the tokens a run's kernel tested (pp_copy_file_run_vector,
+// pp_copy_buffer_run_vector), which doesn't log them one by one. Eight at a time: the names' macros gathered, each pair
+// a quadword, the identifiers' compressed in a register and stored whole (the log has eight events' slack).
+static __attribute__((noinline, cold)) void pp_image_log_run(const Preprocessor* pp, const uint8_t* kinds, uint8_t kind_mask, const uint32_t* values, uint32_t begin,
+                                                             uint32_t end)
+{
+    PPImages* images = pp->images;
+    uint32_t count = images->event_count;
+    bool room = true;
+    for (uint32_t i = begin; room && i < end; i += 8)
+    {
+        const __mmask8 valid = end - i >= 8 ? 0xFF : (__mmask8)_bzhi_u32(0xFF, end - i);
+        const __m128i tokens = _mm_and_si128(_mm_maskz_loadu_epi8(valid, kinds + i), _mm_set1_epi8((char)kind_mask));
+        const __mmask8 identifiers = (__mmask8)_mm_mask_cmpeq_epi8_mask(valid, tokens, _mm_set1_epi8(C_TOKEN_RAW_IDENTIFIER));
+        room = count + 8 <= BUSTER_PP_IMAGE_EVENTS;
+        if (identifiers != 0 && room)
+        {
+            const __m256i names = _mm256_maskz_loadu_epi32(identifiers, values + i);
+            const __m256i macros = _mm256_mmask_i32gather_epi32(_mm256_setzero_si256(), identifiers, names, pp->macro_of, 4);
+            const __m512i pairs = _mm512_or_si512(_mm512_cvtepu32_epi64(names), _mm512_slli_epi64(_mm512_cvtepu32_epi64(macros), 32));
+            _mm512_storeu_si512(images->events + count, _mm512_maskz_compress_epi64(identifiers, pairs));
+            count += (uint32_t)__builtin_popcount(identifiers);
+        }
+    }
+    images->event_count = count;
+    if (!room)
+    {
+        images->overflow = true;
+        pp_image_refuse(pp, PP_IMAGE_ROOM);
+    }
+}
