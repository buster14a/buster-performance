+static bool pp_image_apply(Preprocessor* pp, PPContext* context, const PPImage* image);
+
+// A segment starts at `context`: with an image for it, a hit (`on`); else the recorder begins.
+static void pp_image_begin(Preprocessor* pp, PPContext* context)
+{
+    PPImages* images = pp->images;
+    PPImageStart start;
+    pp->image_recording = false;
+    images->start_valid = false;
+    if (pp_image_start(pp, context, &start))
+    {
+        images->segments += 1;
+        PPImage* image = pp_image_find(pp, images, &start);
+        if (image != 0 && images->mode == PP_IMAGES_ON && image->refused != PP_IMAGE_RECORDED)
+        {
+            // Its keys made no image in an earlier unit: the segment runs, unrecorded.
+            images->declined += 1;
+        }
+        else if (image != 0 && images->mode == PP_IMAGES_ON && pp_image_apply(pp, context, image))
+        {
+            image->hits += 1;
+            images->hits += 1;
+            images->hit_tokens += image->token_count;
+        }
+        else
+        {
+            // The recorder: the state before, the logs empty, and every template's names found again, so that each
+            // lookup of theirs is logged (pp_template_names takes them from its cache while no macro was written).
+            images->start = start;
+            images->start_valid = true;
+            images->known = image;
+            images->reason = PP_IMAGE_RECORDED;
+            images->event_count = 0;
+            images->spelling_count = 0;
+            images->spelling_byte_count = 0;
+            images->chunks = 0;
+            images->macro_first = pp->macro_count;
+            images->macro_count = 0;
+            images->overflow = false;
+            images->use_count = 0;
+            images->context = (uint32_t)(context - pp->contexts);
+            images->before_tokens = pp->output.count;
+            images->before_context = *context;
+            images->before_once = pp->datas[pp->files[context->file].data].once;
+            pp->macro_epoch += 1;
+            *images->before = *pp;
+            pp->image_recording = true;
+        }
+    }
+    else
+    {
+        images->unstarted += 1;
+    }
+}
