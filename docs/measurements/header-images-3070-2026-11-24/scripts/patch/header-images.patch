+// The count before `label` in the header images' report line of `errors` (--time-stages), or UINT64_MAX without one.
+static uint64_t check_units_test_images_count(const char* errors, const char* label)
+{
+    uint64_t result = UINT64_MAX;
+    const char* line = errors != NULL ? strstr(errors, "header images: ") : NULL;
+    const char* end = line != NULL ? strchr(line, '\n') : NULL;
+    const char* at = line != NULL ? strstr(line, label) : NULL;
+    if (at != NULL && end != NULL && at < end)
+    {
+        // The number that ends right before the label.
+        const char* digits = at;
+        while (digits > line && digits[-1] >= '0' && digits[-1] <= '9')
+        {
+            digits -= 1;
+        }
+        result = digits < at ? strtoull(digits, NULL, 10) : UINT64_MAX;
+    }
+    return result;
+}
+
+// #3070's header images (--header-images, PPImages): units that read two headers under the same macros and under
+// others compile to the objects and the diagnostics each has alone, with the images taken (on), with each segment
+// compared with the image its key has (verify), and by several lanes; a lane's later units take the images its earlier
+// ones made; a fault in an image (BUSTER_TEST_IMAGE_DIRT) fails verify's command; and without a root image there are none.
+static void check_units_test_header_images(CheckUnitsTestTally* tally, const char* executable, const char* directory)
+{
+    // A guarded header that reads a macro of its includer's, defines macros (one pastes, one stringizes) and is read
+    // once; and one without a guard, read under other macros each time, whose inclusion of the first is inside a
+    // condition it leaves open.
+    static const char first[] = "#ifndef IMAGES_FIRST_H\n"
+                                "#define IMAGES_FIRST_H\n"
+                                "#pragma once\n"
+                                "#ifdef IMAGES_WIDE\n"
+                                "typedef long images_word;\n"
+                                "#define IMAGES_BITS 64\n"
+                                "#else\n"
+                                "typedef int images_word;\n"
+                                "#define IMAGES_BITS 32\n"
+                                "#endif\n"
+                                "#define IMAGES_JOIN(a, b) a##b\n"
+                                "#define IMAGES_TEXT(text) #text\n"
+                                "#define IMAGES_DECLARE(name) images_word IMAGES_JOIN(images_get_, name)(images_word)\n"
+                                "IMAGES_DECLARE(first);\n"
+                                "IMAGES_DECLARE(IMAGES_BITS);\n"
+                                "static const char images_text[] = IMAGES_TEXT(IMAGES_BITS bits);\n"
+                                "#endif\n";
+    static const char second[] = "#if defined(IMAGES_NEED_PAIR) && !defined(IMAGES_HAVE_PAIR)\n"
+                                 "#define IMAGES_HAVE_PAIR 1\n"
+                                 "#include \"images_first.h\"\n"
+                                 "typedef struct images_pair { images_word left; images_word right; } images_pair;\n"
+                                 "#endif\n"
+                                 "#if defined(IMAGES_NEED_FLOAT) && !defined(IMAGES_HAVE_FLOAT)\n"
+                                 "#define IMAGES_HAVE_FLOAT __FLT_EVAL_METHOD__\n"
+                                 "typedef double images_float;\n"
+                                 "#endif\n"
+                                 "#undef IMAGES_NEED_PAIR\n"
+                                 "#undef IMAGES_NEED_FLOAT\n";
+    // Two headers that ask the second for one thing each: the macro it reads is theirs, the same definition in every unit
+    // (a macro a unit's own file defines is another definition in each, and its readers' images are that unit's alone).
+    static const char pair[] = "#define IMAGES_NEED_PAIR\n#include \"images_second.h\"\n";
+    static const char real[] = "#define IMAGES_NEED_FLOAT\n#include \"images_second.h\"\n";
+    // The units: %u is each one's number, %s what it defines before its headers.
+    static const char unit[] = "%s"
+                               "#include \"images_pair.h\"\n"
+                               "#include \"images_float.h\"\n"
+                               "#include \"images_first.h\"\n"
+                               "images_word images_unit_%u(images_pair pair, images_float real)\n"
+                               "{\n"
+                               "    return images_get_first(pair.left) + (images_word)real + IMAGES_BITS + IMAGES_HAVE_FLOAT + images_text[%u] + (images_word)sizeof(images_word);\n"
+                               "}\n";
+    static const char* const before[] = { "", "", "#define IMAGES_WIDE\n", "", "#define IMAGES_WIDE\n", "#define images_get_first images_get_other\n" };
+    enum { units = BUSTER_ARRAY_LENGTH(before) };
+    char root[PATH_MAX];
+    char alone[PATH_MAX];
+    char together[PATH_MAX];
+    char errors_path[PATH_MAX];
+    char path[PATH_MAX];
+    char text[2048];
+    char names[units][24];
+    snprintf(root, sizeof(root), "%s/images", directory);
+    snprintf(alone, sizeof(alone), "%s/images/alone", directory);
+    snprintf(together, sizeof(together), "%s/images/together", directory);
+    snprintf(errors_path, sizeof(errors_path), "%s/images/errors.txt", directory);
+    bool written = mkdir(root, 0755) == 0 && mkdir(alone, 0755) == 0 && mkdir(together, 0755) == 0;
+    snprintf(path, sizeof(path), "%s/images_first.h", root);
+    written = written && parse_test_write(path, first, strlen(first));
+    snprintf(path, sizeof(path), "%s/images_second.h", root);
+    written = written && parse_test_write(path, second, strlen(second));
+    snprintf(path, sizeof(path), "%s/images_pair.h", root);
+    written = written && parse_test_write(path, pair, strlen(pair));
+    snprintf(path, sizeof(path), "%s/images_float.h", root);
+    written = written && parse_test_write(path, real, strlen(real));
+    for (uint32_t u = 0; written && u < units; u += 1)
+    {
+        snprintf(text, sizeof(text), unit, before[u], u, u % 4);
+        snprintf(names[u], sizeof(names[u]), "../images_%u.c", u);
+        snprintf(path, sizeof(path), "%s/images_%u.c", root, u);
+        written = parse_test_write(path, text, strlen(text));
+    }
+    check_units_test_expect(tally, written, "write the header images' units", root);
+    // Each unit alone: its object, and its diagnostics (none).
+    bool compiled = written;
+    for (uint32_t u = 0; compiled && u < units; u += 1)
+    {
+        char* arguments[] = { (char*)executable, "-c", names[u], NULL };
+        compiled = check_units_test_run(alone, arguments, "/dev/null", errors_path, false) == 0;
+    }
+    check_units_test_expect(tally, compiled, "the header images' units compile alone", root);
+    // The commands: the mode, the lanes, and whether the report must say that segments were taken or verified.
+    static const struct
+    {
+        const char* name;
+        const char* mode;
+        const char* lanes;
+        const char* root;
+        bool taken;
+        bool verified;
+        bool reported;
+    } commands[] = {
+        { "the images taken", "--header-images=on", "1", "--root-image=on", true, false, true },
+        { "each segment compared with its image", "--header-images=verify", "1", "--root-image=on", false, true, true },
+        { "the images taken by several lanes", "--header-images=on", "3", "--root-image=on", false, false, true },
+        { "no images", "--header-images=off", "1", "--root-image=on", false, false, false },
+        { "no images without a root image", "--header-images=on", "1", "--root-image=off", false, false, false },
+    };
+    for (uint32_t c = 0; compiled && c < BUSTER_ARRAY_LENGTH(commands); c += 1)
+    {
+        char* arguments[16 + units];
+        uint32_t used = 0;
+        arguments[used++] = (char*)executable;
+        arguments[used++] = "-c";
+        arguments[used++] = "--time-stages";
+        arguments[used++] = "--lanes";
+        arguments[used++] = (char*)commands[c].lanes;
+        arguments[used++] = (char*)commands[c].root;
+        arguments[used++] = (char*)commands[c].mode;
+        for (uint32_t u = 0; u < units; u += 1)
+        {
+            arguments[used++] = names[u];
+        }
+        arguments[used] = NULL;
+        const int status = check_units_test_run(together, arguments, "/dev/null", errors_path, false);
+        uint64_t length = 0;
+        char* report = check_units_test_read(errors_path, &length);
+        check_units_test_expect(tally, status == 0, "a command of the header images' units succeeds", commands[c].name);
+        const uint64_t taken = check_units_test_images_count(report, " taken (");
+        const uint64_t recorded = check_units_test_images_count(report, " recorded (");
+        const uint64_t verified = check_units_test_images_count(report, " (");
+        const uint64_t differed = check_units_test_images_count(report, " differed");
+        (void)verified;
+        if (!commands[c].reported)
+        {
+            check_units_test_expect(tally, report != NULL && strstr(report, "header images: ") == NULL, "a command without header images reports none", commands[c].name);
+        }
+        else
+        {
+            check_units_test_expect(tally, recorded != UINT64_MAX && recorded != 0 && differed == 0, "its lanes record images, and none differs", commands[c].name);
+        }
+        if (commands[c].taken)
+        {
+            // One lane: three of the units read the headers under the same macros, so two of them take the first's images,
+            // and the two that define IMAGES_WIDE share theirs.
+            check_units_test_expect(tally, taken != UINT64_MAX && taken >= 12, "a lane's later units take its earlier units' images", commands[c].name);
+        }
+        if (commands[c].verified)
+        {
+            check_units_test_expect(tally, report != NULL && strstr(report, "verified 0 (") == NULL && taken == 0, "verify takes none and compares those it has",
+                                    commands[c].name);
+        }
+        free(report);
+        for (uint32_t u = 0; u < units; u += 1)
+        {
+            char object[32];
+            char in_command[PATH_MAX];
+            char by_itself[PATH_MAX];
+            snprintf(object, sizeof(object), "images_%u.o", u);
+            snprintf(in_command, sizeof(in_command), "%s/%s", together, object);
+            snprintf(by_itself, sizeof(by_itself), "%s/%s", alone, object);
+            check_units_test_expect(tally, check_test_driver_same_files(in_command, by_itself), "a unit's object in the command is its object alone", commands[c].name);
+            unlink(in_command);
+        }
+    }
+    // Verify itself: each kind of fault in a new image (BUSTER_TEST_IMAGE_DIRT, pp_image_test_dirt) fails the unit that
+    // reaches its key next, with the check's message; without the fault the command succeeds; and a command that takes
+    // images reads no fault.
+    static const char dirt[] = "kfvlrmwcedgos";
+    for (uint32_t d = 0; compiled && d <= strlen(dirt); d += 1)
+    {
+        char value[2] = { dirt[d], 0 };
+        const bool set = d == strlen(dirt) ? unsetenv("BUSTER_TEST_IMAGE_DIRT") == 0 : setenv("BUSTER_TEST_IMAGE_DIRT", value, 1) == 0;
+        char* checked[] = { (char*)executable, "-c", "--lanes", "1", "--header-images=verify", names[0], names[1], names[2], names[3], NULL };
+        const int status = set ? check_units_test_run(together, checked, "/dev/null", errors_path, false) : -1;
+        uint64_t length = 0;
+        char* diagnostics = check_units_test_read(errors_path, &length);
+        const bool reported = diagnostics != NULL && strstr(diagnostics, "fatal error: a header's segment differs from its image") != NULL;
+        check_units_test_expect(tally, d == strlen(dirt) ? status == 0 && !reported : status == 1 && reported,
+                                "verify reports an image that isn't what its segment did, and nothing without one", d == strlen(dirt) ? "no fault" : value);
+        free(diagnostics);
+    }
+    const bool unread = compiled && setenv("BUSTER_TEST_IMAGE_DIRT", "v", 1) == 0;
+    char* taking[] = { (char*)executable, "-c", "--lanes", "1", "--header-images=on", names[0], names[1], names[2], names[3], NULL };
+    check_units_test_expect(tally, !compiled || (unread && check_units_test_run(together, taking, "/dev/null", errors_path, false) == 0),
+                            "a command that takes images reads no fault", NULL);
+    unsetenv("BUSTER_TEST_IMAGE_DIRT");
+    // An option's value that is none of on, off and verify is refused.
+    char* refused[] = { (char*)executable, "-c", "--header-images=sometimes", names[0], names[1], NULL };
+    const int refusal = compiled ? check_units_test_run(together, refused, "/dev/null", errors_path, false) : 1;
+    check_units_test_expect(tally, refusal != 0, "--header-images takes on, off or verify alone", NULL);
+    printf("  header images: %u commands' units, objects as alone, the images taken and verified, and %u faults verify reports\n", (uint32_t)BUSTER_ARRAY_LENGTH(commands),
+           (uint32_t)strlen(dirt));
+}
