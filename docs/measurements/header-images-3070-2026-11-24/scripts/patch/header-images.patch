+// Header images (#3070 step 2): c_preprocessor.c, at PPImages, has what they are.
+
+// What a key names macro `macro`'s definition by (0 for none): the lane's table's entry for the unit's record.
+BUSTER_INLINE uint64_t pp_image_identity(const PPImages* images, PPMacroId macro)
+{
+    return macro == 0 ? 0 : macro < BUSTER_PP_IMAGE_IDENTITIES ? images->identities[macro] : BUSTER_PP_IMAGE_NO_IDENTITY;
