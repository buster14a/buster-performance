+// Forgets every image and the segment under way: the store back to its fixed buffers, the starts' table empty. For a
+// root captured anew, whose macros' ids the old images' keys named.
+static void pp_images_reset(PPImages* images, const Preprocessor* root)
+{
+    const uint32_t root_macros = root != 0 ? root->macro_count : 0;
+    const uint32_t root_ranges = root != 0 ? root->range_count : 0;
+    for (uint32_t c = 0; c < 2; c += 1)
+    {
+        images->root_scratch[c] = root != 0 ? root->scratch_range[c] : BUSTER_PP_NONE;
+        images->root_spelled[c] = root != 0 ? root->scratch_used[c] : 0;
+    }
+    arena_rewind(&images->storage, images->fixed);
+    memset(images->starts, 0, BUSTER_PP_IMAGE_STARTS * sizeof(*images->starts));
+    memset(images->branches, 0, BUSTER_PP_IMAGE_BRANCHES * sizeof(*images->branches));
+    images->branch_count = 0;
+    // (No macro has no identity: a key's name that isn't one.)
+    images->identities[0] = 0;
+    images->root_macros = root_macros;
+    images->root_ranges = root_ranges;
+    images->start_valid = false;
+    images->image_count = 0;
+    for (uint32_t m = 1; m < root_macros && m < BUSTER_PP_IMAGE_IDENTITIES; m += 1)
+    {
+        images->identities[m] = BUSTER_PP_IMAGE_ROOT_MACRO | m;
+    }
