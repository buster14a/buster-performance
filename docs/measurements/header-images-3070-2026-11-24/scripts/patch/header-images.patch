+// ---------------------------------------------------------------------------------------------------------------------
+// Header images (#3070 step 2; docs/translation-units.md, "Header images")
+//
+// A command's units include the same headers, and each unit's preprocessor ran every one of them again: its
+// conditions, its definitions and its expansions, over tokens the file cache had lexed once. On the 9700X that is most
+// of the preprocessor's 18% of musl's command (buster-performance's docs/measurements/header-work-3070-2026-11-23).
+//
+// A segment is a file's processing from its entry, or from its return from a nested inclusion, to its next inclusion or
+// its end: what it does is a function of where it starts (the file's record, the token, the conditions open, the
+// inclusion's system level) and of the macros it looks up before it sets them. A lane's images (PPImages, its root's)
+// keep, for each start and each set of answers to those lookups, what the segment did: the tokens it put out, the
+// macros it set, the conditions it left open and where it stopped. A unit that reaches a start with the same answers
+// (pp_image_find walks them, a name a step) appends the image's tokens and applies its effects (pp_image_apply)
+// instead of running the segment. The unit's stream is then what it would have been, token for token.
+//
+// What a key names a macro's definition by (an identity): nothing; the root image's macro id, for the predefines' and
+// the command line's, which every unit of the lane has under the same id; or the cache record of the file that defines
+// it and the place of its name there, which hold the same tokens in every unit. So only a unit started from the root
+// makes or takes images.
+//
+// A segment is never recorded where its run is more than that function (PPImageReason): it reported or weighed a
+// diagnostic, read a directive or a builtin that depends on the unit (#line, #pragma, __FILE__, __COUNTER__, ...),
+// began or ended with anything open, or changed any state of the preprocessor that an image doesn't hold: the
+// recorder compares the Preprocessor before and after against the fields it knows (pp_image_state_same), so that what
+// it doesn't know refuses the image rather than being lost.
+//
+// PPImagesMode: `on` takes hits; `verify` takes none, records every segment, and compares a segment whose key an image
+// has with that image (a difference is counted, and fails the unit as a root's mismatch does).
+
+typedef enum PPImagesMode
+{
+    PP_IMAGES_OFF,
+    PP_IMAGES_ON,
+    PP_IMAGES_VERIFY,
+} PPImagesMode;
+
+// Why a segment wasn't recorded (the first that held), or that it was.
+typedef enum PPImageReason
+{
+    PP_IMAGE_RECORDED,
+    // A diagnostic was given, or a warning's severity depended on more than the command line.
+    PP_IMAGE_DIAGNOSTIC,
+    // A directive other than a definition, an #undef, a condition or #pragma once.
+    PP_IMAGE_DIRECTIVE,
+    // A builtin macro whose answer depends on the unit, the place or the time.
+    PP_IMAGE_BUILTIN,
+    // Something was open at its start or its end: a capture, an invocation, pending flags, a context that isn't plain.
+    PP_IMAGE_OPEN,
+    // The preprocessor's state changed in a field no image holds (PPImages.state_offset says which).
+    PP_IMAGE_STATE,
+    // A token's place is in no range an image can name, or its spelling in another range than its place.
+    PP_IMAGE_PLACE,
+    // A macro it looked up has no identity (defined in a buffer of the unit's own).
+    PP_IMAGE_IDENTITY,
+    // The recorder's logs or the lane's store had no room.
+    PP_IMAGE_ROOM,
+    // Its key disagrees with the keys already under its start: the lookups' order differed.
+    PP_IMAGE_ORDER,
+    PP_IMAGE_REASONS,
+} PPImageReason;
+
+typedef struct PPImage PPImage;
+
+// Where two images of one start part: a unit whose answers are `from`'s up to its key `depth`, and `identity` there, has
+// `to`'s up to there and at it. A slot of the lane's table of them (PPImages.branches), empty where `from` is null.
+typedef struct PPImageBranch PPImageBranch;
+struct PPImageBranch
+{
+    const PPImage* from;
+    PPImage* to;
+    uint64_t identity;
+    uint32_t depth;
+};
+
+// Where a segment starts: the file's cache record, its token and next directive there, the inclusion's system level,
+// whether its guard's group was taken, and the conditions open above the file's base (how many, and three bits each:
+// taken, its #else read, skipping). `first` is the first image made for it, from which the others branch.
+typedef struct PPImageStart PPImageStart;
+struct PPImageStart
+{
+    PPImageStart* next;
+    uint32_t record;
+    uint32_t position;
+    uint32_t next_directive;
+    uint32_t conditional_count;
+    uint64_t conditionals;
+    uint8_t system;
+    bool guard_taken;
+    PPImage* first;
+};
+
+// A name the segment looked up before setting it, and the identity of what it had.
+typedef struct PPImageKey PPImageKey;
+struct PPImageKey
+{
+    uint64_t identity;
+    IdentId name;
+};
+
+// A generated spelling the segment made (pp_scratch_in), in order: `length` bytes at `offset` of the image's spelling
+// bytes, for the clean scratch space or the other.
+typedef struct PPImageSpelling PPImageSpelling;
+struct PPImageSpelling
+{
+    uint32_t offset;
+    uint32_t length;
+    bool clean;
+};
+
+// A macro name's last write in the segment: its record among the image's (an index + 1), or 0 for an #undef.
+typedef struct PPImageWrite PPImageWrite;
+struct PPImageWrite
+{
+    IdentId name;
+    uint32_t macro;
+};
+
+// A condition the segment left open: its flags, and its place from the file's start.
+typedef struct PPImageConditional PPImageConditional;
+struct PPImageConditional
+{
+    uint32_t location;
+    bool taken;
+    bool seen_else;
+    bool skipping;
+};
+
+// A use of __FLT_EVAL_METHOD__ the segment recorded (PPEvalMethodUse): the output's tokens before it, counted from the
+// segment's first, and where its name is, from the base `ref` names as a token's place is.
+typedef struct PPImageUse PPImageUse;
+struct PPImageUse
+{
+    uint32_t position;
+    uint32_t location;
+    uint32_t ref;
+};
+
+// What a segment did. Its tokens' values (for a token that isn't a name) and places are offsets from a base that
+// `refs` names: 0 none (a root range's location, the same in every unit), 1 the inclusion's own range, then for each
+// of `foreign_count` a key macro's defining range (`foreign_keys`: its place in `keys`), then each spelling's place.
+struct PPImage
+{
+    // Its keys, in the order the segment looked them up: each name, and the identity it had (eight entries' slack past
+    // them, which pp_image_keys_differ's whole loads read).
+    const IdentId* key_names;
+    const uint64_t* key_identities;
+    uint32_t key_count;
+    uint32_t token_count;
+    const uint8_t* kinds;
+    const uint8_t* flags;
+    const uint32_t* values;
+    const uint32_t* locations;
+    const uint16_t* refs;
+    uint32_t foreign_count;
+    const uint32_t* foreign_keys;
+    uint32_t spelling_count;
+    const PPImageSpelling* spellings;
+    const uint8_t* spelling_bytes;
+    uint32_t spelling_byte_count;
+    // The macro records it made, as their definitions left them (data and base zero, their place from the file's
+    // start), the names' last writes, and how many writes there were (macro_epoch's steps).
+    uint32_t macro_count;
+    const PPMacro* macros;
+    uint32_t write_count;
+    const PPImageWrite* writes;
+    uint32_t epoch_steps;
+    uint32_t conditional_count;
+    const PPImageConditional* conditionals;
+    uint32_t use_count;
+    const PPImageUse* uses;
+    // Its file's cache record (its macros' identities'), where it stopped, whether its guard's group was taken by then,
+    // and whether it read #pragma once.
+    uint32_t record;
+    uint32_t end_position;
+    uint32_t end_directive;
+    bool end_guard_taken;
+    bool once;
+    // Why the segment made no image (a PPImageReason), where its keys are all it holds: a unit that reaches them runs
+    // the segment without recording it again.
+    uint8_t refused;
+    // How many units took it.
+    uint64_t hits;
+};
+
+// The recorder's log of a segment, in order: a lookup (the name and the macro it had), or with BUSTER_PP_IMAGE_WRITE a
+// write (the name and the macro it got).
+#define BUSTER_PP_IMAGE_WRITE (1u << 31)
+typedef struct PPImageEvent PPImageEvent;
+struct PPImageEvent
+{
+    IdentId name;
+    uint32_t macro;
+};
+_Static_assert(sizeof(PPImageEvent) == 8, "the run's logger stores an event as a quadword: the name low, the macro high");
+
+#define BUSTER_PP_IMAGES_BYTES (1ull << 32)
+#define BUSTER_PP_IMAGE_STARTS (1u << 12)
+// The branches' table's slots: an image past the first of its start has one, so the lane keeps at most half as many.
+#define BUSTER_PP_IMAGE_BRANCHES (1u << 16)
+#define BUSTER_PP_IMAGE_EVENTS (1u << 20)
+#define BUSTER_PP_IMAGE_SPELLINGS (1u << 14)
+#define BUSTER_PP_IMAGE_SPELLING_BYTES (1u << 20)
+#define BUSTER_PP_IMAGE_MACROS (1u << 14)
+#define BUSTER_PP_IMAGE_CONDITIONALS 20u
+#define BUSTER_PP_IMAGE_USES 16u
+// The macro records whose identities a lane's images keep (PPImages.identities): one past them has none.
+#define BUSTER_PP_IMAGE_IDENTITIES (1u << 20)
+// A segment's most base references: a halfword each (PPImage.refs).
+#define BUSTER_PP_IMAGE_REFS 4096u
+
+struct PPImages
+{
+    uint8_t mode;
+    // The root's macros when its images began: an id below it is its own identity. And its ranges, whose locations are
+    // every unit's, but for what a unit spells in the root's last scratch chunks past what the root had used of them
+    // (`root_scratch`, the chunks' ranges, and `root_spelled`).
+    uint32_t root_macros;
+    uint32_t root_ranges;
+    uint32_t root_scratch[2];
+    uint32_t root_spelled[2];
+    // The store: the starts' table, the keys' steps, the images and the recorder's buffers.
+    Arena storage;
+    uint64_t fixed;
+    PPImageStart** starts;
+    PPImageBranch* branches;
+    uint32_t branch_count;
+    uint64_t image_count;
+    // The bytes of Preprocessor a segment may change (pp_image_state_mask).
+    uint8_t* state_mask;
+    // Each macro record's identity in the unit under way, by its id: the root's are theirs for good, and a unit's are
+    // written as it makes each record (pp_new_macro, pp_define, pp_image_apply), so that a key's step is two loads.
+    uint64_t* identities;
+    // The segment under way: where it starts, the image its key has (verify), the preprocessor and the context before
+    // it, the log, the spellings and the fresh macro records, and why it can't be an image, if anything.
+    PPImageStart start;
+    bool start_valid;
+    uint8_t reason;
+    PPImage* known;
+    uint32_t context;
+    Preprocessor* before;
+    PPContext before_context;
+    uint32_t before_tokens;
+    bool before_once;
+    PPImageEvent* events;
+    uint32_t event_count;
+    PPImageSpelling* spellings;
+    uint32_t* spelling_places;
+    uint32_t spelling_count;
+    uint8_t* spelling_bytes;
+    uint32_t spelling_byte_count;
+    uint32_t chunks;
+    PPMacro* macros;
+    uint32_t macro_first;
+    uint32_t macro_count;
+    // Whether the log lost a lookup, and the segment's uses of __FLT_EVAL_METHOD__ (their positions from its first token).
+    bool overflow;
+    PPImageUse uses[BUSTER_PP_IMAGE_USES];
+    uint32_t use_count;
+    // The first field whose change refused an image, by its offset in Preprocessor (PP_IMAGE_STATE), for the report.
+    uint32_t state_offset;
+    uint64_t state_offsets[8];
+    uint64_t state_counts[8];
+    // The counts: segments begun, those an image was taken for and their tokens, those recorded and their tokens, those
+    // refused by reason and their tokens, the keys' names walked, and verify's segments that had an image and those that
+    // differed from it.
+    uint64_t segments;
+    uint64_t hits;
+    uint64_t hit_tokens;
+    uint64_t recorded;
+    uint64_t recorded_tokens;
+    uint64_t refused[PP_IMAGE_REASONS];
+    uint64_t refused_tokens[PP_IMAGE_REASONS];
+    uint64_t unstarted;
+    uint64_t declined;
+    uint64_t names_walked;
+    uint64_t verified;
+    uint64_t verified_tokens;
+    uint64_t differed;
+    uint32_t mismatches;
+    char mismatch[192];
+};
+
+// Gives `root` images of `mode` (PPImagesMode), for its owner; without them, or where they can't be reserved, its units
