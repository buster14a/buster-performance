+BUSTER_PREPROCESSOR_ENTRY void pp_root_images(PPRoot* root, uint8_t mode)
+{
+    if (root != 0 && root->images == 0 && mode != PP_IMAGES_OFF)
+    {
+        Arena storage = arena_reserve(BUSTER_PP_IMAGES_BYTES);
+        PPImages* images = arena_push(&storage, sizeof(PPImages), _Alignof(PPImages));
+        if (images != 0)
+        {
+            memset(images, 0, sizeof(*images));
+            images->mode = mode;
+            images->storage = storage;
+            images->starts = arena_push_array(&images->storage, BUSTER_PP_IMAGE_STARTS, sizeof(*images->starts), _Alignof(PPImageStart*));
+            images->branches = arena_push_array(&images->storage, BUSTER_PP_IMAGE_BRANCHES, sizeof(PPImageBranch), _Alignof(PPImageBranch));
+            images->before = arena_push(&images->storage, sizeof(Preprocessor), _Alignof(Preprocessor));
+            images->state_mask = arena_push(&images->storage, sizeof(Preprocessor), 64);
+            // (Eight events' slack for the run's logger's whole stores.)
+            images->events = arena_push_array(&images->storage, (uint64_t)BUSTER_PP_IMAGE_EVENTS + 8, sizeof(PPImageEvent), _Alignof(PPImageEvent));
+            images->spellings = arena_push_array(&images->storage, BUSTER_PP_IMAGE_SPELLINGS, sizeof(PPImageSpelling), _Alignof(PPImageSpelling));
+            images->spelling_places = arena_push_array(&images->storage, BUSTER_PP_IMAGE_SPELLINGS, sizeof(uint32_t), _Alignof(uint32_t));
+            images->spelling_bytes = arena_push(&images->storage, BUSTER_PP_IMAGE_SPELLING_BYTES, 1);
+            images->macros = arena_push_array(&images->storage, BUSTER_PP_IMAGE_MACROS, sizeof(PPMacro), _Alignof(PPMacro));
+            images->identities = arena_push_array(&images->storage, BUSTER_PP_IMAGE_IDENTITIES, sizeof(uint64_t), 64);
+            images->fixed = images->storage.length;
+            const bool reserved = images->starts != 0 && images->branches != 0 && images->before != 0 && images->state_mask != 0 && images->events != 0 && images->spellings != 0 &&
+                                  images->spelling_places != 0 && images->spelling_bytes != 0 && images->macros != 0 && images->identities != 0;
+            if (reserved)
+            {
+                pp_image_state_mask(images->state_mask);
+                root->images = images;
+            }
+            else
+            {
+                storage = images->storage;
+                arena_release(&storage);
+            }
+        }
+        else
+        {
+            arena_release(&storage);
+        }
+    }
+}
