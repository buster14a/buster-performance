+// The first byte of Preprocessor that differs between `before` and `after` outside `mask`, or its size if none does:
+// 64 bytes at a time.
+static uint32_t pp_image_state_differs(const Preprocessor* before, const Preprocessor* after, const uint8_t* mask)
+{
+    const uint8_t* a = (const uint8_t*)before;
+    const uint8_t* b = (const uint8_t*)after;
+    uint32_t result = sizeof(Preprocessor);
+    for (uint32_t i = 0; result == sizeof(Preprocessor) && i < sizeof(Preprocessor); i += 64)
+    {
+        const __mmask64 valid = sizeof(Preprocessor) - i >= 64 ? ~0ull : _bzhi_u64(~0ull, sizeof(Preprocessor) - i);
+        const __m512i changed = _mm512_xor_si512(_mm512_maskz_loadu_epi8(valid, a + i), _mm512_maskz_loadu_epi8(valid, b + i));
+        const uint64_t differs = _mm512_test_epi8_mask(_mm512_andnot_si512(_mm512_maskz_loadu_epi8(valid, mask + i), changed), _mm512_set1_epi8(-1));
+        result = differs != 0 ? i + (uint32_t)__builtin_ctzll(differs) : result;
+    }
+    return result;
+}
+
+// Whether a file context is one a segment can start or end in: the file's own data and no other view of it, nothing
+// pending and nothing lexed again, and in the unit nothing open that a token goes to or is counted by.
+static bool pp_image_plain(Preprocessor* pp, const PPContext* context)
+{
+    return context->kind == BUSTER_PP_CONTEXT_FILE && !context->barrier && context->pending_flags == 0 && context->trailing_flags == 0 && !context->hidden_directives &&
+           !context->relexed && context->relex_position == 0 && !context->comment_read && context->opaque_spans == 0 && context->macro == 0 &&
+           context->data == pp->files[context->file].data && pp_target(pp) == &pp->output && (pp->capture_count | pp->stream_count | pp->limit_count | pp->invocation_count) == 0 &&
+           !pp_collecting(pp) && !pp->fatal;
+}
+
+// Where a segment starting at `context` starts (PPImageStart), or false where none can: in the main file or a file the
+// unit made, in a unit whose options or state an image doesn't cover (its history recorded as it runs, preprocessed
+// input, -Wunused-macros' tracking, a poisoned name, a line remapped in this inclusion), or with too many conditions open.
+static bool pp_image_start(Preprocessor* pp, const PPContext* context, PPImageStart* start)
+{
+    const PPFileData* data = &pp->datas[pp->files[context->file].data];
+    const uint32_t open = pp->conditional_count - context->conditional_base;
+    bool result = !pp->images_blocked && pp->context_count >= 2 && context->file != pp->main_file && pp->macro_count < BUSTER_PP_IMAGE_IDENTITIES && pp->options.no_history && !pp->options.preprocessed &&
+                  !pp->options.expansion_starts && !pp->unused_tracking && pp->poison_count == 0 && data->record != BUSTER_PP_NONE && open <= BUSTER_PP_IMAGE_CONDITIONALS &&
+                  pp->ranges[context->range].first_line_directive == BUSTER_PP_NONE && pp_image_plain(pp, context);
+    if (result)
+    {
+        uint64_t conditionals = 0;
+        for (uint32_t c = 0; c < open; c += 1)
+        {
+            const PPConditional* conditional = &pp->conditionals[context->conditional_base + c];
+            conditionals |= (uint64_t)(conditional->taken | (conditional->seen_else << 1) | (conditional->skipping << 2)) << (3 * c);
+        }
+        *start = (PPImageStart){
+            .record = data->record,
+            .position = context->position,
+            .next_directive = context->next_directive,
+            .conditional_count = open,
+            .conditionals = conditionals,
+            .system = pp->ranges[context->range].system,
+            .guard_taken = context->guard_taken,
+        };
+    }
+    return result;
+}
+
+static uint32_t pp_image_start_slot(const PPImageStart* start)
+{
+    uint64_t hash = ((uint64_t)start->record << 32 | start->position) * 0x9E3779B97F4A7C15ull;
+    hash ^= (start->conditionals + start->conditional_count + ((uint64_t)start->system << 8) + ((uint64_t)start->guard_taken << 16) + ((uint64_t)start->next_directive << 24)) *
+            0xC2B2AE3D27D4EB4Full;
+    return (uint32_t)(hash >> 40) & (BUSTER_PP_IMAGE_STARTS - 1);
+}
+
+static bool pp_image_start_same(const PPImageStart* a, const PPImageStart* b)
+{
+    return a->record == b->record && a->position == b->position && a->next_directive == b->next_directive && a->conditional_count == b->conditional_count &&
+           a->conditionals == b->conditionals && a->system == b->system && a->guard_taken == b->guard_taken;
+}
+
+// The lane's record of `start`, or null.
+static PPImageStart* pp_image_start_find(const PPImages* images, const PPImageStart* start)
+{
+    PPImageStart* result = images->starts[pp_image_start_slot(start)];
+    while (result != 0 && !pp_image_start_same(result, start))
+    {
+        result = result->next;
+    }
+    return result;
+}
