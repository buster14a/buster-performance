+// The fields of Preprocessor a segment may change and still be an image: those an image's effects give back (the output,
+// the macros, the conditions, the scratch spellings), the stacks and the arenas they grow in (their counts are tested
+// apart), and what only caches or counts (the compiled macros' items, the keywords resolved, the command line's
+// severities read, the statistics). Every other byte must be as it was (pp_image_end).
+#define BUSTER_PP_IMAGE_ALLOW(mask, field) memset((mask) + offsetof(Preprocessor, field), 0xFF, sizeof(((Preprocessor*)0)->field))
+static void pp_image_state_mask(uint8_t* mask)
+{
+    memset(mask, 0, sizeof(Preprocessor));
+    BUSTER_PP_IMAGE_ALLOW(mask, arena);
+    BUSTER_PP_IMAGE_ALLOW(mask, columns);
+    BUSTER_PP_IMAGE_ALLOW(mask, arrays);
+    BUSTER_PP_IMAGE_ALLOW(mask, scratch);
+    BUSTER_PP_IMAGE_ALLOW(mask, output);
+    BUSTER_PP_IMAGE_ALLOW(mask, arguments);
+    BUSTER_PP_IMAGE_ALLOW(mask, captures);
+    BUSTER_PP_IMAGE_ALLOW(mask, expansions);
+    BUSTER_PP_IMAGE_ALLOW(mask, argument_links);
+    BUSTER_PP_IMAGE_ALLOW(mask, argument_indexed);
+    BUSTER_PP_IMAGE_ALLOW(mask, argument_link_arena);
+    BUSTER_PP_IMAGE_ALLOW(mask, range_count);
+    BUSTER_PP_IMAGE_ALLOW(mask, location_top);
+    BUSTER_PP_IMAGE_ALLOW(mask, scratch_range);
+    BUSTER_PP_IMAGE_ALLOW(mask, scratch_used);
+    BUSTER_PP_IMAGE_ALLOW(mask, macro_count);
+    BUSTER_PP_IMAGE_ALLOW(mask, item_count);
+    BUSTER_PP_IMAGE_ALLOW(mask, item_peak);
+    BUSTER_PP_IMAGE_ALLOW(mask, parameter_count);
+    BUSTER_PP_IMAGE_ALLOW(mask, template_count);
+    BUSTER_PP_IMAGE_ALLOW(mask, macro_epoch);
+    BUSTER_PP_IMAGE_ALLOW(mask, conditional_count);
+    BUSTER_PP_IMAGE_ALLOW(mask, keywords_resolved);
+    BUSTER_PP_IMAGE_ALLOW(mask, warning_commands);
+    BUSTER_PP_IMAGE_ALLOW(mask, warnings_possible);
+    BUSTER_PP_IMAGE_ALLOW(mask, ticks);
+    BUSTER_PP_IMAGE_ALLOW(mask, input_tokens);
