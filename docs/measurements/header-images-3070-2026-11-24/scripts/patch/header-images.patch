+// Whether two images of one key are the same: verify's test that an image is a function of its key.
+static bool pp_image_same(const PPImage* a, const PPImage* b, const char** what)
+{
+    const char* differs = 0;
+    differs = a->token_count != b->token_count ? "token count" : differs;
+    differs = differs == 0 && memcmp(a->kinds, b->kinds, a->token_count) != 0 ? "kinds" : differs;
+    differs = differs == 0 && memcmp(a->flags, b->flags, a->token_count) != 0 ? "flags" : differs;
+    differs = differs == 0 && memcmp(a->refs, b->refs, (uint64_t)a->token_count * sizeof(uint16_t)) != 0 ? "bases" : differs;
+    differs = differs == 0 && memcmp(a->values, b->values, (uint64_t)a->token_count * sizeof(uint32_t)) != 0 ? "values" : differs;
+    differs = differs == 0 && memcmp(a->locations, b->locations, (uint64_t)a->token_count * sizeof(uint32_t)) != 0 ? "places" : differs;
+    differs = differs == 0 && (a->foreign_count != b->foreign_count || memcmp(a->foreign_keys, b->foreign_keys, (uint64_t)a->foreign_count * sizeof(uint32_t)) != 0) ?
+              "ranges" : differs;
+    differs = differs == 0 && (a->spelling_count != b->spelling_count || a->spelling_byte_count != b->spelling_byte_count ||
+                               memcmp(a->spelling_bytes, b->spelling_bytes, a->spelling_byte_count) != 0) ? "spellings" : differs;
+    for (uint32_t s = 0; differs == 0 && s < a->spelling_count; s += 1)
+    {
+        differs = a->spellings[s].offset != b->spellings[s].offset || a->spellings[s].length != b->spellings[s].length || a->spellings[s].clean != b->spellings[s].clean ?
+                  "spellings" : differs;
+    }
+    differs = differs == 0 && a->macro_count != b->macro_count ? "macro count" : differs;
+    for (uint32_t m = 0; differs == 0 && m < a->macro_count; m += 1)
+    {
+        differs = !pp_image_macro_same(a->macros + m, b->macros + m) ? "macros" : differs;
+    }
+    differs = differs == 0 && (a->write_count != b->write_count || a->epoch_steps != b->epoch_steps) ? "write count" : differs;
+    for (uint32_t w = 0; differs == 0 && w < a->write_count; w += 1)
+    {
+        differs = a->writes[w].name != b->writes[w].name || a->writes[w].macro != b->writes[w].macro ? "writes" : differs;
+    }
+    differs = differs == 0 && a->conditional_count != b->conditional_count ? "condition count" : differs;
+    for (uint32_t c = 0; differs == 0 && c < a->conditional_count; c += 1)
+    {
+        const PPImageConditional* x = a->conditionals + c;
+        const PPImageConditional* y = b->conditionals + c;
+        differs = x->location != y->location || x->taken != y->taken || x->seen_else != y->seen_else || x->skipping != y->skipping ? "conditions" : differs;
+    }
+    differs = differs == 0 && a->use_count != b->use_count ? "uses" : differs;
+    for (uint32_t u = 0; differs == 0 && u < a->use_count; u += 1)
+    {
+        differs = a->uses[u].position != b->uses[u].position || a->uses[u].location != b->uses[u].location || a->uses[u].ref != b->uses[u].ref ? "uses" : differs;
+    }
+    differs = differs == 0 && (a->end_position != b->end_position || a->end_directive != b->end_directive || a->end_guard_taken != b->end_guard_taken || a->once != b->once) ?
+              "end" : differs;
+    *what = differs;
+    return differs == 0;
+}
+
+// Puts `image` under its start, by its keys: the start's first, or a branch of the image its keys part from. Returns the
+// image there: `image`, or the one its keys already had; or null where the keys under the start don't agree with its
+// own (another name where they part, or one's keys the other's beginning), or the lane has no room, which makes no image
+// of it.
+static PPImage* pp_image_insert(PPImages* images, const PPImageStart* start, PPImage* image)
+{
+    PPImageStart* known = pp_image_start_find(images, start);
+    PPImage* result = 0;
+    if (known == 0)
+    {
+        known = arena_push(&images->storage, sizeof(PPImageStart), _Alignof(PPImageStart));
+        if (known != 0)
+        {
+            const uint32_t slot = pp_image_start_slot(start);
+            *known = *start;
+            known->first = image;
+            known->next = images->starts[slot];
+            images->starts[slot] = known;
+            result = image;
+        }
+    }
+    else
+    {
+        PPImage* at = known->first;
+        uint32_t depth = 0;
+        bool agrees = true;
+        while (agrees && result == 0)
+        {
+            // Where the two keys part.
+            const uint32_t shared = at->key_count < image->key_count ? at->key_count : image->key_count;
+            uint32_t parted = depth;
+            while (parted < shared && at->key_names[parted] == image->key_names[parted] && at->key_identities[parted] == image->key_identities[parted])
+            {
+                parted += 1;
+            }
+            if (parted == at->key_count && parted == image->key_count)
+            {
+                result = at;
+            }
+            else if (parted == shared || at->key_names[parted] != image->key_names[parted])
+            {
+                agrees = false;
+            }
+            else
+            {
+                PPImage* next = pp_image_branch(images, at, parted, image->key_identities[parted]);
+                if (next != 0)
+                {
+                    at = next;
+                    depth = parted + 1;
+                }
+                else if (images->branch_count < BUSTER_PP_IMAGE_BRANCHES / 2)
+                {
+                    uint32_t slot = pp_image_branch_slot(at, parted, image->key_identities[parted]);
+                    while (images->branches[slot].from != 0)
+                    {
+                        slot = (slot + 1) & (BUSTER_PP_IMAGE_BRANCHES - 1);
+                    }
+                    images->branches[slot] = (PPImageBranch){ .from = at, .to = image, .identity = image->key_identities[parted], .depth = parted };
+                    images->branch_count += 1;
+                    result = image;
+                }
+                else
+                {
+                    agrees = false;
+                }
+            }
+        }
+    }
+    images->image_count += result == image ? 1 : 0;
+    return result;
+}
+
+// A spelling's reference while a segment's ranges are still being met (pp_image_end gives it its place after theirs).
+#define BUSTER_PP_IMAGE_SPELLING_REF (1u << 20)
+
+// The base a token at `location` is counted from, as an image names it (PPImage.refs: none, the inclusion's own range, a
+// key macro's defining range, a spelling the segment made), with the base itself in `*base` and the bounds of what
+// holds the location in `*low` and `*extent`; BUSTER_PP_NONE where an image can't name one. `foreign_bases` and
+// `foreign_keys` (the ranges met, and for each a key whose macro is defined there) grow as new ranges are met.
+static uint32_t pp_image_place(const Preprocessor* pp, const PPImages* images, const PPContext* context, const PPMacroId* key_macros, uint32_t key_count,
+                               uint32_t* foreign_bases, uint32_t* foreign_keys, uint32_t* foreign_count, uint32_t location, uint32_t* base, uint32_t* low, uint32_t* extent)
+{
+    const PPRange* own = &pp->ranges[context->range];
+    uint32_t result = BUSTER_PP_NONE;
+    *base = 0;
+    *low = 0;
+    *extent = 0;
+    if (location - own->base < own->length)
+    {
+        result = 1;
+        *base = own->base;
+        *low = own->base;
+        *extent = own->length;
+    }
+    else
+    {
+        const uint32_t range = location != 0 ? pp_find_range(pp, location) : BUSTER_PP_NONE;
+        if (range != BUSTER_PP_NONE && pp->ranges[range].file == BUSTER_PP_NONE)
+        {
+            // A spelling's place: one the segment made, the latest first; else one the root made, in a chunk of its
+            // own or in its last chunk's part that it had used (a unit's spellings go on from there, each unit's its own).
+            for (uint32_t s = images->spelling_count; result == BUSTER_PP_NONE && s != 0; s -= 1)
+            {
+                if (location - images->spelling_places[s - 1] <= images->spellings[s - 1].length)
+                {
+                    result = BUSTER_PP_IMAGE_SPELLING_REF + (s - 1);
+                    *base = images->spelling_places[s - 1];
+                    *low = *base;
+                    *extent = images->spellings[s - 1].length;
+                }
+            }
+            const uint32_t offset = location - pp->ranges[range].base;
+            const bool rooted = range < images->root_ranges && (range != images->root_scratch[0] || offset < images->root_spelled[0]) &&
+                                (range != images->root_scratch[1] || offset < images->root_spelled[1]);
+            if (result == BUSTER_PP_NONE && rooted)
+            {
+                result = 0;
+                *low = pp->ranges[range].base;
+                *extent = pp->ranges[range].length;
+            }
+        }
+        else if (range != BUSTER_PP_NONE && range < images->root_ranges)
+        {
+            // A root range's locations are every unit's.
+            result = 0;
+            *low = pp->ranges[range].base;
+            *extent = pp->ranges[range].length;
+        }
+        else if (range != BUSTER_PP_NONE)
+        {
+            const uint32_t range_base = pp->ranges[range].base;
+            for (uint32_t f = 0; result == BUSTER_PP_NONE && f < *foreign_count; f += 1)
+            {
+                result = foreign_bases[f] == range_base ? 2 + f : result;
+            }
+            for (uint32_t k = 0; result == BUSTER_PP_NONE && k < key_count && *foreign_count < BUSTER_PP_IMAGE_REFS; k += 1)
+            {
+                if (key_macros[k] >= images->root_macros && pp->macros[key_macros[k]].base == range_base)
+                {
+                    foreign_bases[*foreign_count] = range_base;
+                    foreign_keys[*foreign_count] = k;
+                    result = 2 + *foreign_count;
+                    *foreign_count += 1;
+                }
+            }
+            *base = range_base;
+            *low = range_base;
+            *extent = pp->ranges[range].length;
+        }
+    }
+    return result;
+}
+
+// Whether a file context is, at a segment's end, what it was at its start but for where it is and its guard's group.
+static bool pp_image_context_same(const PPContext* a, const PPContext* b)
+{
+    return a->kind == b->kind && a->barrier == b->barrier && a->pending_flags == b->pending_flags && a->trailing_flags == b->trailing_flags &&
+           a->hidden_directives == b->hidden_directives && a->relexed == b->relexed && a->relex_position == b->relex_position && a->relex_file == b->relex_file &&
+           a->comment_read == b->comment_read && a->opaque_spans == b->opaque_spans && a->header_gap_data == b->header_gap_data &&
+           a->header_gap_token == b->header_gap_token && a->macro == b->macro && a->end == b->end && a->expansion_end == b->expansion_end &&
+           a->search_index == b->search_index && a->file == b->file && a->data == b->data && a->range == b->range && a->conditional_base == b->conditional_base &&
+           a->tokens == b->tokens && a->begin == b->begin;
+}
+
+static void pp_image_readable(const void* bytes, uint64_t size)
+{
+#if __has_feature(memory_sanitizer)
+    __msan_unpoison(bytes, (size_t)size);
+#else
+    (void)bytes;
+    (void)size;
+#endif
+}
+
+// Counts a segment that made no image, for `reason`, with its `tokens`.
+static void pp_image_refused(PPImages* images, PPImageReason reason, uint32_t tokens, uint32_t offset)
+{
+    images->refused[reason] += 1;
+    images->refused_tokens[reason] += tokens;
+    if (reason == PP_IMAGE_STATE)
+    {
+        // The field, among the first few met.
+        uint32_t slot = 0;
+        while (slot < BUSTER_ARRAY_LENGTH(images->state_offsets) && images->state_counts[slot] != 0 && images->state_offsets[slot] != offset)
+        {
+            slot += 1;
+        }
+        if (slot < BUSTER_ARRAY_LENGTH(images->state_offsets))
+        {
+            images->state_offsets[slot] = offset;
+            images->state_counts[slot] += 1;
+        }
+    }
+}
+
+// test-check-units' faults in an image (BUSTER_TEST_IMAGE_DIRT): one of its parts changed, where it has that part.
+static void pp_image_test_dirt(PPImage* image, char kind)
+{
+    switch (kind)
+    {
+        case 'k': if (image->token_count != 0) { ((uint8_t*)image->kinds)[0] ^= 1; } break;
+        case 'f': if (image->token_count != 0) { ((uint8_t*)image->flags)[image->token_count - 1] ^= BUSTER_PP_SPACE; } break;
+        case 'v': if (image->token_count != 0) { ((uint32_t*)image->values)[image->token_count / 2] += 1; } break;
+        case 'l': if (image->token_count != 0) { ((uint32_t*)image->locations)[0] += 1; } break;
+        case 'r': if (image->token_count != 0) { ((uint16_t*)image->refs)[image->token_count - 1] ^= 1; } break;
+        case 'm': if (image->macro_count != 0) { ((PPMacro*)image->macros)[image->macro_count - 1].body_end += 1; } break;
+        case 'w': if (image->write_count != 0) { ((PPImageWrite*)image->writes)[0].macro ^= 1; } break;
+        case 'c': if (image->conditional_count != 0) { ((PPImageConditional*)image->conditionals)[0].seen_else ^= 1; } break;
+        case 'e': image->end_position += 1; break;
+        case 'd': image->end_directive += 1; break;
+        case 'g': image->end_guard_taken ^= 1; break;
+        case 'o': image->once ^= 1; break;
+        case 's': if (image->spelling_byte_count != 0) { ((uint8_t*)image->spelling_bytes)[0] ^= 1; } break;
+        default: break;
+    }
+}
+
+// The segment being recorded ends at `context`, before its next inclusion's directive or its file's end: an image of
+// it, under its start and its keys, unless something refuses it; a refused one whose keys are whole leaves them with
+// its reason (PPImage.refused), so that the lane's later units don't record it again. With verify, an image its key
+// already had is compared with the new one.
+static void pp_image_end(Preprocessor* pp, PPContext* context)
+{
+    PPImages* images = pp->images;
+    if (pp->image_recording)
+    {
+        pp->image_recording = false;
+        const Preprocessor* before = images->before;
+        const uint32_t first = images->before_tokens;
+        const uint32_t tokens = pp->output.count - first;
+        PPImageReason reason = (PPImageReason)images->reason;
+        uint32_t offset = 0;
+        // Nothing open, in a context that is the one it began in and is still plain, and no state changed that an image
+        // doesn't hold.
+        PPContext was = images->before_context;
+        const bool closed = images->start_valid && images->context == (uint32_t)(context - pp->contexts) && pp->context_count == before->context_count &&
+                            pp_image_plain(pp, context) && pp_image_context_same(&was, context) && pp->arguments.count == before->arguments.count &&
+                            pp->captures.count == before->captures.count && pp->expansions.count == before->expansions.count &&
+                            pp->conditional_count >= context->conditional_base && pp->conditional_count - context->conditional_base <= BUSTER_PP_IMAGE_CONDITIONALS;
+        reason = reason == PP_IMAGE_RECORDED && !closed ? PP_IMAGE_OPEN : reason;
+        if (reason == PP_IMAGE_RECORDED)
+        {
+            pp_image_readable(before, sizeof(*before));
+            pp_image_readable(pp, sizeof(*pp));
+            offset = pp_image_state_differs(before, pp, images->state_mask);
+            const bool same = offset == sizeof(Preprocessor) && pp->range_count - before->range_count == images->chunks &&
+                              pp->macro_count - images->macro_first == images->macro_count && pp->output.count >= first &&
+                              pp->eval_method_use_count - before->eval_method_use_count == images->use_count;
+            reason = same ? reason : PP_IMAGE_STATE;
+        }
+        Scratch scratch = scratch_begin(0);
+        const uint32_t events = images->event_count;
+        const uint32_t own_base = pp->ranges[context->range].base;
+        // The keys and the writes, from the log in order: a name's first lookup before any write of it is a key, and a
+        // name's last write is its write. A set of the names met, open addressing, each with its key's or write's place.
+        uint32_t slots = 64;
+        while (slots < 2 * (events + 1))
+        {
+            slots *= 2;
+        }
+        IdentId* set_names = arena_push_array(scratch.arena, slots, sizeof(IdentId), 64);
+        uint32_t* set_writes = arena_push_array(scratch.arena, slots, sizeof(uint32_t), 64);
+        uint8_t* set_flags = arena_push(scratch.arena, slots, 64);
+        PPImageKey* keys = arena_push_array(scratch.arena, (uint64_t)events + 1, sizeof(PPImageKey), _Alignof(PPImageKey));
+        PPMacroId* key_macros = arena_push_array(scratch.arena, (uint64_t)events + 1, sizeof(PPMacroId), _Alignof(PPMacroId));
+        PPImageWrite* writes = arena_push_array(scratch.arena, (uint64_t)events + 1, sizeof(PPImageWrite), _Alignof(PPImageWrite));
+        uint32_t* refs = arena_push_array(scratch.arena, (uint64_t)tokens + 1, sizeof(uint32_t), 64);
+        uint32_t* bases = arena_push_array(scratch.arena, (uint64_t)tokens + 1, sizeof(uint32_t), 64);
+        uint32_t* foreign_bases = arena_push_array(scratch.arena, BUSTER_PP_IMAGE_REFS, sizeof(uint32_t), 64);
+        uint32_t* foreign_keys = arena_push_array(scratch.arena, BUSTER_PP_IMAGE_REFS, sizeof(uint32_t), 64);
+        const bool room = set_names != 0 && set_writes != 0 && set_flags != 0 && keys != 0 && key_macros != 0 && writes != 0 && refs != 0 && bases != 0 &&
+                          foreign_bases != 0 && foreign_keys != 0;
+        reason = reason == PP_IMAGE_RECORDED && !room ? PP_IMAGE_ROOM : reason;
+        // Whether the keys are the segment's whole: the log held every lookup, and each key's macro has an identity.
+        bool keyed = room && !images->overflow;
+        uint32_t key_count = 0;
+        uint32_t write_count = 0;
+        uint32_t epoch_steps = 0;
+        if (keyed)
+        {
+            // (A name's entry is its id plus one: zero is an empty slot.)
+            memset(set_names, 0, (uint64_t)slots * sizeof(IdentId));
+            memset(set_flags, 0, slots);
+        }
+        for (uint32_t e = 0; keyed && e < events; e += 1)
+        {
+            const IdentId name = images->events[e].name;
+            const bool write = (images->events[e].macro & BUSTER_PP_IMAGE_WRITE) != 0;
+            const PPMacroId macro = images->events[e].macro & ~BUSTER_PP_IMAGE_WRITE;
+            uint32_t slot = (uint32_t)(((uint64_t)name * 0x9E3779B97F4A7C15ull) >> 40) & (slots - 1);
+            while (set_names[slot] != 0 && set_names[slot] != name + 1)
+            {
+                slot = (slot + 1) & (slots - 1);
+            }
+            set_names[slot] = name + 1;
+            if (write)
+            {
+                // A write gives the name a record the segment made, or none.
+                const bool made = macro == 0 || macro >= images->macro_first;
+                reason = reason == PP_IMAGE_RECORDED && !made ? PP_IMAGE_STATE : reason;
+                if ((set_flags[slot] & 2) == 0)
+                {
+                    set_flags[slot] |= 2;
+                    set_writes[slot] = write_count;
+                    writes[write_count] = (PPImageWrite){ .name = name };
+                    write_count += 1;
+                }
+                writes[set_writes[slot]].macro = macro != 0 && made ? macro - images->macro_first + 1 : 0;
+                epoch_steps += 1;
+            }
+            else if (set_flags[slot] == 0)
+            {
+                set_flags[slot] = 1;
+                const uint64_t identity = pp_image_identity(images, macro);
+                keyed = identity != BUSTER_PP_IMAGE_NO_IDENTITY;
+                keys[key_count] = (PPImageKey){ .identity = identity, .name = name };
+                key_macros[key_count] = macro;
+                key_count += 1;
+            }
+        }
+        reason = reason == PP_IMAGE_RECORDED && !keyed ? (images->overflow ? PP_IMAGE_ROOM : PP_IMAGE_IDENTITY) : reason;
+        // The tokens: their keywords' kinds first (a chunk's pass would give them the same later), then each one's base.
+        uint32_t foreign_count = 0;
+        if (reason == PP_IMAGE_RECORDED)
+        {
+            pp_resolve_keywords_range(pp, first, pp->output.count);
+        }
+        for (uint32_t t = 0; reason == PP_IMAGE_RECORDED && t < tokens; t += 1)
+        {
+            const uint8_t kind = pp->output.kinds[first + t];
+            const uint32_t location = pp->output.locations[first + t];
+            const uint32_t value = pp->output.values[first + t];
+            const bool spelled = kind < C_TOKEN_KIND_COUNT && kind != C_TOKEN_RAW_IDENTIFIER;
+            const bool named = kind == C_TOKEN_RAW_IDENTIFIER || (kind >= BUSTER_PP_KIND_KEYWORD && kind < BUSTER_PP_KIND_PRAGMA_END) || kind == BUSTER_PP_KIND_INTEGER;
+            uint32_t base = 0;
+            uint32_t low = 0;
+            uint32_t extent = 0;
+            const uint32_t ref = pp_image_place(pp, images, context, key_macros, key_count, foreign_bases, foreign_keys, &foreign_count, location, &base, &low, &extent);
+            // A spelled token's value is its spelling's end, in what holds its place.
+            const bool placed = ref != BUSTER_PP_NONE && (named || (spelled && value >= low && value - low <= extent));
+            reason = placed ? reason : PP_IMAGE_PLACE;
+            refs[t] = ref;
+            bases[t] = base;
+        }
+        // Where its uses of __FLT_EVAL_METHOD__ were named, as the tokens' places are.
+        uint32_t use_refs[BUSTER_PP_IMAGE_USES];
+        uint32_t use_bases[BUSTER_PP_IMAGE_USES];
+        for (uint32_t u = 0; reason == PP_IMAGE_RECORDED && u < images->use_count; u += 1)
+        {
+            uint32_t low = 0;
+            uint32_t extent = 0;
+            use_refs[u] = pp_image_place(pp, images, context, key_macros, key_count, foreign_bases, foreign_keys, &foreign_count, images->uses[u].location, &use_bases[u], &low,
+                                         &extent);
+            reason = use_refs[u] != BUSTER_PP_NONE ? reason : PP_IMAGE_PLACE;
+        }
+        // The spellings' references follow the ranges', whose count is final now.
+        const uint32_t references = 2 + foreign_count + images->spelling_count;
+        reason = reason == PP_IMAGE_RECORDED && references > BUSTER_PP_IMAGE_REFS ? PP_IMAGE_ROOM : reason;
+        // The macro records the segment made are this file's, read in this inclusion's range.
+        for (uint32_t m = 0; reason == PP_IMAGE_RECORDED && m < images->macro_count; m += 1)
+        {
+            const PPMacro* macro = images->macros + m;
+            reason = macro->data == context->data && macro->base == own_base && macro->builtin == 0 && macro->disabled == 0 && macro->unused == 0 &&
+                     (macro->flags & (BUSTER_PP_MACRO_COMPILED | BUSTER_PP_MACRO_BUILTIN | BUSTER_PP_MACRO_REDEFINABLE)) == 0 ? reason : PP_IMAGE_STATE;
+        }
+        // The image, in the store: whole, or its keys alone with why it has no more.
+        const uint64_t mark = images->storage.length;
+        const uint32_t open = pp->conditional_count - context->conditional_base;
+        const bool whole = reason == PP_IMAGE_RECORDED;
+        const uint32_t held = whole ? tokens : 0;
+        PPImage* image = 0;
+        if (keyed)
+        {
+            Arena* store = &images->storage;
+            image = arena_push(store, sizeof(PPImage), _Alignof(PPImage));
+            IdentId* key_names = arena_push_array(store, (uint64_t)key_count + 8, sizeof(IdentId), 64);
+            uint64_t* key_identities = arena_push_array(store, (uint64_t)key_count + 8, sizeof(uint64_t), 64);
+            uint8_t* kinds = arena_push(store, (uint64_t)held + 64, 64);
+            uint8_t* flags = arena_push(store, (uint64_t)held + 64, 64);
+            uint32_t* values = arena_push_array(store, (uint64_t)held + 16, sizeof(uint32_t), 64);
+            uint32_t* locations = arena_push_array(store, (uint64_t)held + 16, sizeof(uint32_t), 64);
+            uint16_t* image_refs = arena_push_array(store, (uint64_t)held + 32, sizeof(uint16_t), 64);
+            uint32_t* image_foreign = arena_push_array(store, (uint64_t)foreign_count + 1, sizeof(uint32_t), _Alignof(uint32_t));
+            PPImageSpelling* spellings = arena_push_array(store, (uint64_t)images->spelling_count + 1, sizeof(PPImageSpelling), _Alignof(PPImageSpelling));
+            uint8_t* spelling_bytes = arena_push(store, (uint64_t)images->spelling_byte_count + 1, 1);
+            PPMacro* macros = arena_push_array(store, (uint64_t)images->macro_count + 1, sizeof(PPMacro), _Alignof(PPMacro));
+            PPImageWrite* image_writes = arena_push_array(store, (uint64_t)write_count + 1, sizeof(PPImageWrite), _Alignof(PPImageWrite));
+            PPImageConditional* conditionals = arena_push_array(store, (uint64_t)open + 1, sizeof(PPImageConditional), _Alignof(PPImageConditional));
+            PPImageUse* uses = arena_push_array(store, (uint64_t)images->use_count + 1, sizeof(PPImageUse), _Alignof(PPImageUse));
+            const bool stored = image != 0 && key_names != 0 && key_identities != 0 && kinds != 0 && flags != 0 && values != 0 && locations != 0 && image_refs != 0 && image_foreign != 0 &&
+                                spellings != 0 && spelling_bytes != 0 && macros != 0 && image_writes != 0 && conditionals != 0 && uses != 0;
+            reason = stored ? reason : PP_IMAGE_ROOM;
+            image = stored ? image : 0;
+            if (stored)
+            {
+                for (uint32_t k = 0; k < key_count; k += 1)
+                {
+                    key_names[k] = keys[k].name;
+                    key_identities[k] = keys[k].identity;
+                }
+                *image = (PPImage){ .key_names = key_names, .key_identities = key_identities, .key_count = key_count, .refused = (uint8_t)reason };
+            }
+            if (stored && whole)
+            {
+                memcpy(kinds, pp->output.kinds + first, tokens);
+                memcpy(flags, pp->output.flags + first, tokens);
+                for (uint32_t t = 0; t < tokens; t += 1)
+                {
+                    const uint8_t kind = kinds[t];
+                    const bool spelled = kind < C_TOKEN_KIND_COUNT && kind != C_TOKEN_RAW_IDENTIFIER;
+                    const uint32_t ref = refs[t] >= BUSTER_PP_IMAGE_SPELLING_REF ? 2 + foreign_count + (refs[t] - BUSTER_PP_IMAGE_SPELLING_REF) : refs[t];
+                    image_refs[t] = (uint16_t)ref;
+                    locations[t] = pp->output.locations[first + t] - bases[t];
+                    values[t] = pp->output.values[first + t] - (spelled ? bases[t] : 0);
+                }
+                // (The references past the last token's, which pp_image_apply's whole loads gather by: none.)
+                memset(image_refs + tokens, 0, 32 * sizeof(uint16_t));
+                memcpy(image_foreign, foreign_keys, (uint64_t)foreign_count * sizeof(uint32_t));
+                memcpy(spellings, images->spellings, (uint64_t)images->spelling_count * sizeof(PPImageSpelling));
+                memcpy(spelling_bytes, images->spelling_bytes, images->spelling_byte_count);
+                for (uint32_t m = 0; m < images->macro_count; m += 1)
+                {
+                    macros[m] = images->macros[m];
+                    macros[m].data = 0;
+                    macros[m].base = 0;
+                    macros[m].location -= own_base;
+                }
+                memcpy(image_writes, writes, (uint64_t)write_count * sizeof(PPImageWrite));
+                bool placed = true;
+                for (uint32_t c = 0; c < open; c += 1)
+                {
+                    const PPConditional* conditional = &pp->conditionals[context->conditional_base + c];
+                    conditionals[c] = (PPImageConditional){
+                        .location = conditional->location - own_base,
+                        .taken = conditional->taken,
+                        .seen_else = conditional->seen_else,
+                        .skipping = conditional->skipping,
+                    };
+                    placed = placed && conditional->location - own_base < pp->ranges[context->range].length;
+                }
+                for (uint32_t u = 0; u < images->use_count; u += 1)
+                {
+                    uses[u] = (PPImageUse){
+                        .position = images->uses[u].position,
+                        .location = images->uses[u].location - use_bases[u],
+                        .ref = use_refs[u] >= BUSTER_PP_IMAGE_SPELLING_REF ? 2 + foreign_count + (use_refs[u] - BUSTER_PP_IMAGE_SPELLING_REF) : use_refs[u],
+                    };
+                }
+                const PPFileData* file = &pp->datas[pp->files[context->file].data];
+                *image = (PPImage){
+                    .key_names = key_names,
+                    .key_identities = key_identities,
+                    .key_count = key_count,
+                    .token_count = tokens,
+                    .kinds = kinds,
+                    .flags = flags,
+                    .values = values,
+                    .locations = locations,
+                    .refs = image_refs,
+                    .foreign_count = foreign_count,
+                    .foreign_keys = image_foreign,
+                    .spelling_count = images->spelling_count,
+                    .spellings = spellings,
+                    .spelling_bytes = spelling_bytes,
+                    .spelling_byte_count = images->spelling_byte_count,
+                    .macro_count = images->macro_count,
+                    .macros = macros,
+                    .write_count = write_count,
+                    .writes = image_writes,
+                    .epoch_steps = epoch_steps,
+                    .conditional_count = open,
+                    .conditionals = conditionals,
+                    .use_count = images->use_count,
+                    .uses = uses,
+                    .record = images->start.record,
+                    .end_position = context->position,
+                    .end_directive = context->next_directive,
+                    .end_guard_taken = context->guard_taken,
+                    .once = file->once && !images->before_once,
+                    // (A condition placed outside its file's range makes no image: its keys keep that.)
+                    .refused = placed ? PP_IMAGE_RECORDED : PP_IMAGE_PLACE,
+                };
+                reason = placed ? reason : PP_IMAGE_PLACE;
+            }
+        }
+        if (image != 0)
+        {
+            PPImage* placed = pp_image_insert(images, &images->start, image);
+            if (placed == 0)
+            {
+                reason = reason == PP_IMAGE_RECORDED ? PP_IMAGE_ORDER : reason;
+            }
+            else if (placed != image)
+            {
+                // Its key had an image: the same one (refused for the same kind of reason, or whole and equal), or with
+                // verify a difference to report.
+                const char* what = 0;
+                const bool both = placed->refused == PP_IMAGE_RECORDED && image->refused == PP_IMAGE_RECORDED;
+                const bool same = both ? pp_image_same(placed, image, &what) : (placed->refused != PP_IMAGE_RECORDED) == (image->refused != PP_IMAGE_RECORDED);
+                images->verified += both ? 1 : 0;
+                images->verified_tokens += both ? tokens : 0;
+                if (!same)
+                {
+                    images->differed += 1;
+                    if (images->mismatches == 0)
+                    {
+                        snprintf(images->mismatch, sizeof(images->mismatch), "a segment of %.*s from its token %u differs from its image in its %s",
+                                 (int)pp->files[context->file].path_length, pp->files[context->file].path, images->start.position, what != 0 ? what : "refusal");
+                    }
+                    images->mismatches += 1;
+                }
+                arena_pop_to(&images->storage, mark);
+            }
+            else if (reason == PP_IMAGE_RECORDED)
+            {
+                images->recorded += 1;
+                images->recorded_tokens += tokens;
+                // A test's fault (test-check-units): a part of the new image that isn't what its segment did, which
+                // verify must report when the lane's next unit reaches its key. Read only with verify, which no
+                // compile's own command asks for.
+                const char* dirt = images->mode == PP_IMAGES_VERIFY ? getenv("BUSTER_TEST_IMAGE_DIRT") : 0;
+                if (dirt != 0)
+                {
+                    pp_image_test_dirt(image, dirt[0]);
+                }
+            }
+        }
+        if (reason != PP_IMAGE_RECORDED)
+        {
+            pp_image_refused(images, reason, tokens, offset);
+        }
+        scratch_end(scratch);
+    }
+}
+
+// Takes `image` at `context` in the place of its segment's run: its tokens appended to the output, each value and
+// place on its base here (the inclusion's range, the ranges its key macros are defined in, the spellings made again in
+// the scratch space, in order), its macro records appended and its names' last writes made, its conditions left open,
+// and the context where the segment stopped. Returns false, with nothing changed, where the unit has no room for it:
+// the segment's own run then reports that.
+static bool pp_image_apply(Preprocessor* pp, PPContext* context, const PPImage* image)
+{
+    PPTokens* out = &pp->output;
+    const uint32_t tokens = image->token_count;
+    const uint32_t own_base = pp->ranges[context->range].base;
+    const uint32_t references = 2 + image->foreign_count + image->spelling_count;
+    Scratch scratch = scratch_begin(0);
+    uint32_t* bases = arena_push_array(scratch.arena, (uint64_t)references + 16, sizeof(uint32_t), 64);
+    bool result = bases != 0 && (uint64_t)out->count + tokens + BUSTER_PP_TOKEN_SLACK <= out->capacity &&
+                  (uint64_t)pp->macro_count + image->macro_count < (BUSTER_PP_MAX_MACROS >> pp->capacity_shift) &&
+                  (uint64_t)context->conditional_base + image->conditional_count < (BUSTER_PP_MAX_CONTEXTS >> pp->capacity_shift);
+    if (result)
+    {
+        bases[0] = 0;
+        bases[1] = own_base;
+        for (uint32_t f = 0; f < image->foreign_count; f += 1)
+        {
+            bases[2 + f] = pp->macros[pp->macro_of[image->key_names[image->foreign_keys[f]]]].base;
+        }
+        for (uint32_t s = 0; s < image->spelling_count; s += 1)
+        {
+            const PPImageSpelling* spelling = image->spellings + s;
+            bases[2 + image->foreign_count + s] = pp_scratch_in(pp, image->spelling_bytes + spelling->offset, spelling->length, spelling->clean);
+        }
+        result = !pp->fatal;
+    }
+    if (result)
+    {
+        // The tokens: kinds and flags as they are; of each sixteen, the bases gathered by their references, added to the
+        // places and to the values of the tokens that are spelled (not a name's id, nor an integer's value).
+        const uint32_t at = out->count;
+        memcpy(out->kinds + at, image->kinds, tokens);
+        memcpy(out->flags + at, image->flags, tokens);
+        for (uint32_t t = 0; t < tokens; t += 16)
+        {
+            const __m128i kinds = _mm_loadu_si128((const __m128i*)(image->kinds + t));
+            const __mmask16 spelled = _mm_cmplt_epu8_mask(kinds, _mm_set1_epi8((char)C_TOKEN_KIND_COUNT)) & _mm_cmpneq_epi8_mask(kinds, _mm_set1_epi8(C_TOKEN_RAW_IDENTIFIER));
+            const __m512i refs = _mm512_cvtepu16_epi32(_mm256_loadu_si256((const __m256i*)(image->refs + t)));
+            const __m512i based = _mm512_i32gather_epi32(refs, bases, 4);
+            const __m512i values = _mm512_loadu_si512(image->values + t);
+            _mm512_storeu_si512(out->values + at + t, _mm512_mask_add_epi32(values, spelled, values, based));
+            _mm512_storeu_si512(out->locations + at + t, _mm512_add_epi32(_mm512_loadu_si512(image->locations + t), based));
+        }
+        out->count = at + tokens;
+        // The macro records, and each name's last write.
+        const PPMacroId first = pp->macro_count;
+        for (uint32_t m = 0; m < image->macro_count; m += 1)
+        {
+            PPMacro* macro = &pp->macros[first + m];
+            *macro = image->macros[m];
+            macro->data = context->data;
+            macro->base = own_base;
+            macro->location += own_base;
+            if (first + m < BUSTER_PP_IMAGE_IDENTITIES)
+            {
+                pp->images->identities[first + m] = ((uint64_t)image->record << 32) | image->macros[m].location;
+            }
+        }
+        pp->macro_count = first + image->macro_count;
+        for (uint32_t w = 0; w < image->write_count; w += 1)
+        {
+            const IdentId name = image->writes[w].name;
+            const PPMacroId id = image->writes[w].macro != 0 ? first + image->writes[w].macro - 1 : 0;
+            pp->macro_of[name] = id;
+            const uint64_t bit = 1ull << (name % 64);
+            pp->is_macro[name / 64] = id != 0 ? pp->is_macro[name / 64] | bit : pp->is_macro[name / 64] & ~bit;
+        }
+        pp->macro_epoch += image->epoch_steps;
+        // The conditions it left open, and where it stopped.
+        for (uint32_t c = 0; c < image->conditional_count; c += 1)
+        {
+            const PPImageConditional* conditional = image->conditionals + c;
+            pp->conditionals[context->conditional_base + c] = (PPConditional){
+                .taken = conditional->taken,
+                .seen_else = conditional->seen_else,
+                .skipping = conditional->skipping,
+                .location = conditional->location + own_base,
+            };
+        }
+        pp->conditional_count = context->conditional_base + image->conditional_count;
+        context->position = image->end_position;
+        context->next_directive = image->end_directive;
+        context->guard_taken = image->end_guard_taken;
+        if (image->once)
+        {
+            pp->datas[pp->files[context->file].data].once = true;
+        }
+        for (uint32_t u = 0; u < image->use_count; u += 1)
+        {
+            pp_eval_method_record(pp, at + image->uses[u].position, image->uses[u].location + bases[image->uses[u].ref], 0);
+        }
+    }
+    scratch_end(scratch);
+    return result;
+}
+
+// The lane's images' counts, for --time-stages.
+BUSTER_PREPROCESSOR_ENTRY void pp_images_report(const PPImages* images, FILE* stream)
+{
+    static const char* const reasons[PP_IMAGE_REASONS] = { "recorded", "diagnostic", "directive", "builtin", "open", "state", "place", "identity", "room", "order" };
+    unsigned long long refused = 0;
+    unsigned long long refused_tokens = 0;
+    for (uint32_t r = 1; r < PP_IMAGE_REASONS; r += 1)
+    {
+        refused += images->refused[r];
+        refused_tokens += images->refused_tokens[r];
+    }
+    fprintf(stream, "header images: %llu segments, %llu taken (%llu tokens), %llu recorded (%llu tokens), %llu refused (%llu tokens), %llu run unrecorded, %llu not started, "
+            "%llu images, %llu names walked; verified %llu (%llu tokens), %llu differed\n",
+            (unsigned long long)images->segments, (unsigned long long)images->hits, (unsigned long long)images->hit_tokens, (unsigned long long)images->recorded,
+            (unsigned long long)images->recorded_tokens, refused, refused_tokens, (unsigned long long)images->declined, (unsigned long long)images->unstarted,
+            (unsigned long long)images->image_count, (unsigned long long)images->names_walked, (unsigned long long)images->verified,
+            (unsigned long long)images->verified_tokens, (unsigned long long)images->differed);
+    for (uint32_t r = 1; r < PP_IMAGE_REASONS; r += 1)
+    {
+        if (images->refused[r] != 0)
+        {
+            fprintf(stream, "header images: refused for %s: %llu segments, %llu tokens\n", reasons[r], (unsigned long long)images->refused[r],
+                    (unsigned long long)images->refused_tokens[r]);
+        }
+    }
+    // (The byte's field: offsetof(Preprocessor, FIELD), which pp_image_state_mask allows or doesn't.)
+    for (uint32_t s = 0; s < BUSTER_ARRAY_LENGTH(images->state_offsets) && images->state_counts[s] != 0; s += 1)
+    {
+        fprintf(stream, "header images: state: the byte at %llu of the preprocessor changed in %llu segments\n", (unsigned long long)images->state_offsets[s],
+                (unsigned long long)images->state_counts[s]);
+    }
+}
