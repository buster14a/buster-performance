+#if BUSTER_IN_UNIT(BUSTER_UNIT_CHECKER)
+// This optional local probe runs at the ordinary C driver's adapter boundary.
+static void probe_driver_rows(const Tier0Code* code, const EmissionFrameRow* fixed, uint32_t count)
+{
+    EmissionFrameRow rows[2][256];
+    const uint32_t kept = emitted_tier0_preserved(code);
+    if (count + 3 * kept > BUSTER_ARRAY_LENGTH(rows[0])) abort();
+    uint32_t total[2];
+    for (uint32_t v = 0; v < 2; ++v)
+    {
+        memcpy(rows[v], fixed, count * sizeof(*fixed));
+        probe_moves = probe_gp = probe_vec = 0;
+        total[v] = v == 0 ? base_preserve_rows(code, rows[v], count) : head_preserve_rows(code, rows[v], count);
+        fprintf(stderr, "driver %s: %u fixed, %u total, %u moves, %u GP visits, %u vector visits, %u new rows\n",
+                v == 0 ? "base" : "head", count, total[v], probe_moves, probe_gp, probe_vec, 3 * kept);
+    }
+    if (total[0] != total[1] || memcmp(rows[0], rows[1], total[0] * sizeof(*fixed)) != 0) abort();
+}
