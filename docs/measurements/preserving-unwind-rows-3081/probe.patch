@@ -505,6 +505,74 @@ static void emitted_test_preserve_moves(EmittedTest* test, const Tier0Code* code
 // The rows at record boundaries for a frame that pushes rbx, rcx and r10, then stores xmm15, xmm16 and xmm31.
 // Only rbx and rbp belong to the fixed descriptor. Pin the tied rules at entry and at rbp's push and pop, as
 // well as the two DWARF vector number ranges and the different restore orders of general and vector registers.
+// Compiled only into a temporary copy of emitted_code_test.c.
+static void compare_frame_rows(EmittedTest* test, const Tier0Code* code, const EmittedCode* emitted, const EmittedTestLayout* layout, uint64_t id)
+{
+    UnwindFunction fixed;
+    if (unwind_tier0_frame_tails(code, 0, code->count, &fixed, 0) != UNWIND_OK)
+    {
+        abort();
+    }
+    EmissionFrameRow rows[BUSTER_EMITTED_TEST_ROWS];
+    EmissionFrameEvent events[BUSTER_EMITTED_TEST_ROWS];
+    const uint32_t gp = (uint32_t)__builtin_popcount(code->frame_preserved);
+    const uint32_t vec = (uint32_t)__builtin_popcount(code->frame_preserve_vectors);
+    for (uint32_t version = 0; version < 2; ++version)
+    {
+        memset(rows, version == 0 ? 0x5a : 0xa5, sizeof(rows));
+        const uint32_t fixed_count = unwind_function_rows(&fixed, rows, BUSTER_ARRAY_LENGTH(rows));
+        uint32_t count = emitted_tier0_probe_rows(code, rows, fixed_count, BUSTER_ARRAY_LENGTH(rows));
+        probe_moves = probe_gp = probe_vec = 0;
+        const uint32_t registers = emitted_tier0_preserved(code);
+        if (registers != 0)
+        {
+            count = version == 0 ? base_preserve_rows(code, rows, count) : head_preserve_rows(code, rows, count);
+        }
+        if (code->frame_interrupt == BUSTER_TIER0_INTERRUPT_ERROR_CODE)
+        {
+            count = emitted_tier0_interrupt_rows(code, rows, count);
+        }
+        if (count > BUSTER_ARRAY_LENGTH(rows) || count != emitted->frame_count)
+        {
+            abort();
+        }
+        for (uint32_t r = 0; r < count; ++r)
+        {
+            const EmissionFrameEvent* actual = &emitted->frames[r];
+            const EmissionFrameRow row = rows[r];
+            events[r] = (EmissionFrameEvent){ .at = { .boundary = row.offset, .side = EMISSION_LEFT }, .value = row.value, .reg = row.reg, .kind = row.kind };
+            emitted_test_expect(test, actual->at.side == EMISSION_LEFT && actual->at.boundary == row.offset && actual->kind == row.kind &&
+                                      actual->reg == row.reg && actual->value == row.value && row.reserved == 0, "adapter event agrees with replay", id);
+        }
+        EmittedCode replay = *emitted;
+        replay.frames = events;
+        replay.frame_count = count;
+        UnwindFunction function;
+        EmissionFrameRow resolved[BUSTER_EMITTED_TEST_ROWS];
+        uint8_t bytes[8192];
+        if (emitted_unwind(&replay, layout->offsets, layout->length, false, resolved, &function) != UNWIND_OK)
+        {
+            abort();
+        }
+        const size_t size = (size_t)emitted_test_write(&function, true, true, bytes, sizeof(bytes));
+        if (size == 0)
+        {
+            abort();
+        }
+        const char* label = version == 0 ? "base" : "head";
+        char path[64];
+        snprintf(path, sizeof(path), "%s-%05" PRIx64 ".rows", label, id);
+        FILE* file = fopen(path, "wb");
+        if (file == NULL || fwrite(rows, sizeof(*rows), count, file) != count || fclose(file) != 0) abort();
+        snprintf(path, sizeof(path), "%s-%05" PRIx64 ".eh", label, id);
+        file = fopen(path, "wb");
+        if (file == NULL || fwrite(bytes, 1, size, file) != size || fclose(file) != 0) abort();
+        printf("PROBE %05" PRIx64 " %s %u %u %u %u %u %u %u %u %u %u %zu\n",
+               id, label, code->frame_interrupt, gp, vec, registers - gp - vec, fixed_count, count, probe_moves, probe_gp, probe_vec, 3 * registers, size);
+    }
+}
