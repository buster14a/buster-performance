+// Exploration: T on the actual front's columns, before the ordinary reader has emitted this chunk's graph.
+// The kernel reads declaration lines, type rows and available operand records. The comparison after ordinary checking
+// reports which named calls and arguments actually had a derivation, including their retained payload fields.
+static void node_window_probe(NodeFront* front)
+{
+    struct NodeFactsReader* state = front->typer->facts;
+    NodeFacts run = state->facts;
+    const CheckGraph environment = { .extensions = run.machine->graph->extensions };
+    NodeMachine machine = {
+        .types = run.machine->types, .graph = &environment, .type_words = run.machine->type_words,
+        .type_count = run.machine->type_count, .overloads = run.machine->overloads,
+    };
+    run.machine = &machine;
+    const bool mutate_argument = getenv("NODE_PROOF_FAULT_ARGUMENT") != NULL;
+    const bool trace_calls = getenv("NODE_PROOF_TRACE_CALL") != NULL;
+    run.argument_slots = state->proof_arg_cache;
+    run.input = NULL;
+    run.nodes = NULL;
+    const bool pointers = getenv("NODE_PROOF_POINTERS") != NULL;
+    const bool no_floating = getenv("NODE_PROOF_NO_FP") != NULL;
+    const bool calls = getenv("NODE_PROOF_CALLS") != NULL;
+    const uint32_t count = front->count;
+    uint8_t kinds[BUSTER_NODE_FRONT_RECORDS + 64] = { 0 };
+    uint32_t bounds[2] = { 0, count };
+    memset(state->proof_records, 0, (size_t)count * sizeof(NodeFactsRecord));
+    for (uint32_t x = 0; x < count; x += 1)
+    {
+        const CheckOp op = (CheckOp)front->ops[x];
+        const uint8_t kind = front->window_kinds[x];
+        const uint32_t entry = front->window_entries[x];
+        bool chosen = false;
+        if (op == CHECK_OP_VALUE && (kind == BUSTER_NODE_FACTS_LITERAL_LINE || kind == BUSTER_NODE_FACTS_IDENTIFIER) && entry != 0 && entry < run.line_capacity)
+        {
+            const TypeId type = (TypeId)run.lines[4 * (uint64_t)entry];
+            const uint32_t index = type_index(type);
+            chosen = pointers || (type == type_unqualified(type) && index < BUSTER_NODE_MACHINE_KINDS && node_machine_integer_widths[index] != 0);
+        }
+        else if ((kind == BUSTER_NODE_FACTS_OPERATOR || kind == BUSTER_NODE_FACTS_LOOKUP) && front->window_classes[x] != BUSTER_NODE_FACTS_CLASS_CUT)
+        {
+            const uint32_t left = front->window_left[x], right = front->window_right[x];
+            const bool operands = left != 0 && left <= x && kinds[x - left] != 0 && (!right || (right <= x && kinds[x - right] != 0));
+            const bool cast = op == CHECK_OP_CONVERT || op == CHECK_OP_CAST;
+            const bool arithmetic = (op >= CHECK_OP_POSITIVE && op <= CHECK_OP_LOGICAL_OR) || op == CHECK_OP_ASSIGN || op == CHECK_OP_COMMA ||
+                                    op == CHECK_OP_CONDITION || (op >= CHECK_OP_PRE_INCREMENT && op <= CHECK_OP_BIT_XOR_ASSIGN);
+            const bool destination = type_index(entry) < BUSTER_NODE_MACHINE_KINDS && (entry == BUSTER_TYPE_VOID || node_machine_integer_widths[type_index(entry)] != 0);
+            const bool pointer = pointers && (op == CHECK_OP_ADDRESS || op == CHECK_OP_DEREFERENCE || op == CHECK_OP_SUBSCRIPT || op == CHECK_OP_MEMBER || op == CHECK_OP_ARROW);
+            bool direct = calls && op == CHECK_OP_CALL && operands && front->ops[x - left] == CHECK_OP_VALUE &&
+                          front->leaf_categories[x - left] == BUSTER_NODE_FRONT_LEAF_IDENTIFIER &&
+                          entry <= front->window_argument_count && front->window_counts[x] <= front->window_argument_count - entry;
+            if (direct)
+            {
+                const uint32_t callee = front->window_entries[x - left];
+                direct = callee != 0 && callee < run.line_capacity &&
+                         type_kind(run.machine->types, (TypeId)run.lines[4 * (uint64_t)callee]) == BUSTER_TYPE_KIND_FUNCTION;
+            }
+            for (uint32_t i = 0; direct && i < front->window_counts[x]; ++i)
+            {
+                const uint32_t distance = front->window_arguments[entry + i];
+                direct = distance != 0 && distance <= x && kinds[x - distance] != BUSTER_NODE_FACTS_GIVEN;
+            }
+            chosen = operands && (arithmetic || (cast && (destination || pointers)) || pointer || direct);
+        }
+        kinds[x] = chosen ? kind : BUSTER_NODE_FACTS_GIVEN;
+    }
+    run.expected_types = NULL;
+    run.expected_flags = NULL;
+    run.expected_objects = NULL;
+    run.expected_payloads = NULL;
+    run.expected_standings = NULL;
+    run.expected_exponents = NULL;
+    run.expected_words = NULL;
+    run.expected_converted = NULL;
+    run.expected_conversion_flags = NULL;
+    run.expected_member_offsets = NULL;
+    run.expected_arguments = NULL;
+    run.records = state->proof_records;
+    run.windows = bounds;
+    run.ops = front->ops;
+    run.kinds = kinds;
+    run.classes = front->window_classes;
+    run.left = front->window_left;
+    run.right = front->window_right;
+    run.inputs = front->window_entries;
+    run.counts = front->window_counts;
+    run.positions = front->window_positions;
+    run.arguments = front->window_arguments;
+    run.argument_count = front->window_argument_count;
+    run.fits = state->place_fits;
+    node_facts_window(&run, 0, BUSTER_NODE_FACTS_WHOLE, false);
+    uint32_t tally[5][3] = { 0 };
+    uint32_t refused[5][CHECK_OP_COUNT + 5] = { 0 };
+    uint32_t accepted[5][CHECK_OP_COUNT][2] = { 0 };
+    uint32_t voids[3][2] = { 0 };
+    uint16_t reason[BUSTER_NODE_FRONT_RECORDS] = { 0 };
+    for (uint32_t x = 0; x < count; x += 1)
+    {
+        const uint32_t left = front->window_left[x], right = front->window_right[x];
+        const bool floating = ((run.records[x].word >> 16) & 0xffu) == BUSTER_TYPE_KIND_FLOATING;
+        bool made = (!no_floating || !floating) && kinds[x] != 0 && run.records[x].taken != BUSTER_NODE_FACTS_LEFT &&
+                          (front->ops[x] == CHECK_OP_VALUE || (state->proof_made[x - left] && (!right || state->proof_made[x - right])));
+        if (made && front->ops[x] == CHECK_OP_CALL)
+        {
+            made = (run.records[x].exponent & BUSTER_NODE_FACTS_CONVERTED_CALL) != 0;
+            for (uint32_t i = 0; made && i < front->window_counts[x]; ++i)
+            {
+                made = state->proof_made[x - front->window_arguments[front->window_entries[x] + i]];
+            }
+        }
+        if (front->ops[x] == CHECK_OP_CALL && left != 0 && left <= x && trace_calls)
+        {
+            const TypeId callee = run.records[x - left].type;
+            const uint32_t row = type_index(callee);
+            const NodeFactsRow* answer = run.rows + (row < run.row_count ? row : run.row_count);
+            fprintf(stderr, "probe-trace token=%u selected-kind=%u callee-kind=%u callee-type=%u available-rows=%u prototype=%u returned=%u admitted=%u\n",
+                    front->tokens[x], kinds[x], kinds[x - left], row, run.row_count, answer->function, answer->returned, (unsigned)made);
+        }
+        if (made && front->ops[x] == CHECK_OP_CALL && mutate_argument && front->window_counts[x] != 0)
+        {
+            const uint32_t index = front->window_entries[x] + (x % front->window_counts[x]);
+            const uint32_t argument = x - front->window_arguments[index];
+            run.records[argument].spare ^= (x & 1) ? UINT64_C(1) : (UINT64_C(1) << 32);
+        }
+        state->proof_made[x] = made;
+        if (!made)
+        {
+            const bool leaf = front->ops[x] == CHECK_OP_VALUE;
+            const bool cut = front->window_classes[x] == BUSTER_NODE_FACTS_CLASS_CUT;
+            reason[x] = cut ? CHECK_OP_COUNT : left && left <= x && reason[x-left] ? reason[x-left] :
+                        right && right <= x && reason[x-right] ? reason[x-right] :
+                        leaf ? CHECK_OP_COUNT + (front->leaf_categories[x] == BUSTER_NODE_FRONT_LEAF_IDENTIFIER ? 1 :
+                                                 front->leaf_categories[x] == BUSTER_NODE_FRONT_LEAF_LITERAL ? 2 : 3) : front->ops[x];
+        }
+        if (x >= front->made && front->roots[x])
+        {
+            const CheckOp op = (CheckOp)front->ops[x];
+            const bool data = left != 0 && left <= x && node_machine_reader_discard(state->reader, front, x, x - left);
+            const uint32_t bucket = data ? 4 : op == CHECK_OP_CAST ? 0 : op == CHECK_OP_CONDITION ? 1 : op == CHECK_OP_CONVERT ? 2 : 3;
+            tally[bucket][0]++;
+            tally[bucket][1] += made;
+            tally[bucket][2] += made ? front->sizes[x] : 0;
+            refused[bucket][reason[x]] += !made;
+            if (made && left <= x)
+            {
+                const uint32_t operand_op = front->ops[x - left];
+                accepted[bucket][operand_op][0] += 1;
+                accepted[bucket][operand_op][1] += front->sizes[x];
+                const uint32_t child = x - left;
+                if (bucket == 0 && operand_op == CHECK_OP_CAST && front->window_entries[child] == BUSTER_TYPE_VOID)
+                {
+                    const uint32_t payload = child - front->window_left[child];
+                    const uint32_t group = front->ops[payload] != CHECK_OP_VALUE ? 2 :
+                                           front->leaf_categories[payload] == BUSTER_NODE_FRONT_LEAF_LITERAL ? 0 : 1;
+                    voids[group][0] += 1;
+                    voids[group][1] += front->sizes[x];
+                }
+            }
+        }
+    }
+    for (uint32_t v = 0; v < 3; v += 1)
+    {
+        if (voids[v][0])
+        {
