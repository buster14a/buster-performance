--- a/src/buster/compiler/assembler_lines.c
+++ b/src/buster/compiler/assembler_lines.c
@@ -53,14 +53,33 @@
     return a.length == b.length && memcmp(a.pointer, b.pointer, a.length) == 0;
 }
 
+// Local deterministic probe. Only the numbered .file directory lookup is counted.
+static uint64_t dir_lookups, dir_candidates, dir_memcmps, dir_hashes, dir_probes, dir_clear_bytes;
+
+static bool dir_counted_equal(String8 a, String8 b)
+{
+    dir_candidates += 1;
+    dir_memcmps += a.length == b.length;
+    return asm_line_same(a, b);
+}
+
+__attribute__((destructor)) static void dir_emit_counts(void)
+{
+    if (dir_lookups != 0)
+    {
+        fprintf(stderr, "DIR_COUNTS %llu %llu %llu %llu %llu %llu\n", (unsigned long long)dir_lookups, (unsigned long long)dir_candidates, (unsigned long long)dir_memcmps, (unsigned long long)dir_hashes, (unsigned long long)dir_probes, (unsigned long long)dir_clear_bytes);
+    }
+}
+
 // A directory's index in the table, or the table's count where it isn't there; its name without a trailing '/'.
 static uint32_t asm_line_find_directory(const AsmParser* parser, String8* name)
 {
+    dir_lookups += 1;
     name->length = name->length != 0 && name->pointer[name->length - 1] == '/' ? name->length - 1 : name->length;
     uint32_t result = parser->line_directory_count;
     for (uint32_t d = 0; d < parser->line_directory_count && result == parser->line_directory_count; d += 1)
     {
-        result = parser->line_directories[d].pointer != 0 && asm_line_same(parser->line_directories[d], *name) ? d : result;
+        result = parser->line_directories[d].pointer != 0 && dir_counted_equal(parser->line_directories[d], *name) ? d : result;
     }
     return result;
 }
