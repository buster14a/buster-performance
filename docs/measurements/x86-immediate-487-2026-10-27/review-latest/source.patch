diff --git a/src/buster/compiler/c_check_x86_diagnostic.c b/src/buster/compiler/c_check_x86_diagnostic.c
new file mode 100644
index 00000000..521f38fe
--- /dev/null
+++ b/src/buster/compiler/c_check_x86_diagnostic.c
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+//
+// Resolve pending runtime range diagnostics on the checked control/expression graph, before lowering. This cold
+// worklist exists only for an out-of-range immediate. Each control/node enters it once, with no recursion, token
+// reparsing or dependence on target features. Unknown conditions retain both edges. Scratch has exactly one byte
+// and one u64 slot per control/node; no padding is read. Failure publishes no partially resolved events.
+
+typedef struct CheckX86DiagnosticWalk CheckX86DiagnosticWalk;
+struct CheckX86DiagnosticWalk
+{
+    CheckProgram* program;
+    const CheckProgramBody* body;
+    uint8_t* seen;
+    uint64_t* stack;
+    uint64_t depth;
+};
+
+static void check_x86_diagnostic_push(CheckX86DiagnosticWalk* walk, uint32_t index, bool control)
+{
+    const uint32_t nodes = walk->program->input->graph.count;
+    const bool valid = control ? index < walk->body->count : index < nodes;
+    const uint64_t item = control ? (uint64_t)nodes + walk->body->first + index : index;
+    if (valid && walk->seen[item] == 0)
+    {
+        walk->seen[item] = 1;
+        walk->stack[walk->depth++] = item;
+    }
+}
+
+static void check_x86_diagnostic_switch(CheckX86DiagnosticWalk* walk, uint32_t index)
+{
+    const CheckProgram* program = walk->program;
+    const CheckControl* controls = program->controls + walk->body->first;
+    const uint32_t node = controls[index].node;
+    uint32_t next = index + 1;
+    uint32_t selected = BUSTER_CHECK_NONE;
+    unsigned __int128 value = 0;
+    const bool known = check_program_case_value(program, node, program->stream->values[node].type, &value);
+    while (next < walk->body->count && controls[next].kind == CHECK_CONTROL_CASE)
+    {
+        const CheckProgramCase* item = program->cases + controls[next].target;
+        uint32_t width = 0;
+        bool sign = false;
+        check_action_integer_type(program->types, item->type, &width, &sign);
+        const unsigned __int128 ordered = value ^ (sign ? (unsigned __int128)1 << (width - 1) : 0);
+        const bool matches = ordered >= check_program_case_order(program, item, false) &&
+                             ordered <= check_program_case_order(program, item, true);
+        if (!known || matches)
+        {
+            check_x86_diagnostic_push(walk, item->target, true);
+            selected = item->target;
+        }
+        next += 1;
+    }
+    // The control after the case table jumps to the default label or the switch's end.
+    if (!known || selected == BUSTER_CHECK_NONE)
+    {
+        check_x86_diagnostic_push(walk, next, true);
+    }
+}
+
+static void check_x86_diagnostic_initializer(CheckX86DiagnosticWalk* walk, const CheckInitializer* plan)
+{
+    for (uint32_t part = 0; part < plan->count; part += 1)
+    {
+        if (plan->parts[part].kind == CHECK_INIT_VALUE)
+        {
+            check_x86_diagnostic_push(walk, plan->parts[part].node, false);
+        }
+    }
+}
+
+static void check_x86_diagnostic_control(CheckX86DiagnosticWalk* walk, uint32_t index)
+{
+    const CheckProgram* program = walk->program;
+    const CheckInput* input = program->input;
+    const CheckControl* entry = program->controls + walk->body->first + index;
+    check_x86_diagnostic_push(walk, entry->node, false);
+    if (entry->kind == CHECK_CONTROL_INITIALIZE)
+    {
+        const CheckInitializer* plan = program->initializers->plans + entry->target;
+        check_x86_diagnostic_initializer(walk, plan);
+    }
+    if (entry->kind == CHECK_CONTROL_ASM)
+    {
+        const CheckInputAsm* assembly = input->asm_statements + entry->target;
+        for (uint32_t i = 0; i < assembly->output_count + assembly->input_count; i += 1)
+        {
+            check_x86_diagnostic_push(walk, assembly->operands[i].node, false);
+        }
+        for (uint32_t i = program->asm_offsets[entry->target]; i < program->asm_offsets[entry->target + 1]; i += 1)
+        {
+            check_x86_diagnostic_push(walk, program->asm_targets[i], true);
+        }
+    }
+    bool falls = entry->kind != CHECK_CONTROL_RETURN && entry->kind != CHECK_CONTROL_END;
+    if (entry->kind == CHECK_CONTROL_SWITCH)
+    {
+        check_x86_diagnostic_switch(walk, index);
+        falls = false;
+    }
+    else if (entry->kind == CHECK_CONTROL_JUMP_INDIRECT)
+    {
+        for (uint32_t i = 0; i < walk->body->count; i += 1)
+        {
+            if (program->controls[walk->body->first + i].kind == CHECK_CONTROL_LABEL)
+            {
+                check_x86_diagnostic_push(walk, i, true);
+            }
+        }
+        falls = false;
+    }
+    else if (entry->kind >= CHECK_CONTROL_BRANCH_FALSE)
+    {
+        bool truth = false;
+        const bool jump = entry->kind == CHECK_CONTROL_JUMP;
+        const bool known = !jump && check_program_runtime_truth(program, entry->node, entry->node, &truth);
+        const bool taken = truth == (entry->kind == CHECK_CONTROL_BRANCH_TRUE);
+        if (jump || !known || taken)
+        {
+            check_x86_diagnostic_push(walk, entry->target, true);
+        }
+        falls = !jump && (!known || !taken);
+    }
+    if (entry->kind == CHECK_CONTROL_END && entry->token < input->token_count)
+    {
+        const uint32_t region = input->expression_regions[entry->token];
+        if (region != 0 && region <= program->region_count)
+        {
+            check_x86_diagnostic_push(walk, program->regions[region - 1].result, false);
+        }
+    }
+    if (falls)
+    {
+        check_x86_diagnostic_push(walk, index + 1, true);
+    }
+}
+
+static void check_x86_diagnostic_expression(CheckX86DiagnosticWalk* walk, uint32_t node)
+{
+    CheckProgram* program = walk->program;
+    const CheckGraph* graph = &program->input->graph;
+    const CheckOp op = graph->ops[node];
+    if (op == CHECK_OP_VALUE)
+    {
+        // Automatic compound literals execute an initializer plan, outside the value leaf's operand columns.
+        const CheckValue value = graph->leaves[node];
+        if (value.object != 0 && value.object < program->object_count && program->input->compound_objects[value.object - 1] &&
+            !program->input->static_objects[value.object - 1])
+        {
+            const uint32_t selected = program->initializers != NULL ? program->initializers->declaration_plans[value.object - 1] : 0;
+            if (selected == 0 || selected > program->initializers->count)
+            {
+                check_program_fail(program, CHECK_PROGRAM_INVALID, value.object - 1);
+            }
+            else
+            {
+                check_x86_diagnostic_initializer(walk, program->initializers->plans + selected - 1);
+            }
+        }
+    }
+    else if (op == CHECK_OP_STATEMENT_VALUE)
+    {
+        const uint32_t region = program->input->expression_regions[graph->tokens[node]];
+        if (region != 0 && region <= program->region_count)
+        {
+            check_x86_diagnostic_push(walk, program->regions[region - 1].first, true);
+        }
+    }
+    else if (op != CHECK_OP_SIZEOF && op != CHECK_OP_ALIGNOF)
+    {
+        uint32_t operands[] = { graph->operand0[node], graph->operand1[node], graph->operand2[node] };
+        bool truth = false;
+        if ((op == CHECK_OP_LOGICAL_AND || op == CHECK_OP_LOGICAL_OR || op == CHECK_OP_CONDITIONAL) &&
+            check_program_runtime_truth(program, node, operands[0], &truth))
+        {
+            if (op == CHECK_OP_CONDITIONAL)
+            {
+                operands[truth ? 2 : 1] = BUSTER_CHECK_NONE;
+            }
+            else if (truth == (op == CHECK_OP_LOGICAL_OR))
+            {
+                operands[1] = BUSTER_CHECK_NONE;
+            }
+        }
+        for (uint32_t i = 0; i < BUSTER_ARRAY_LENGTH(operands); i += 1)
+        {
+            check_x86_diagnostic_push(walk, operands[i], false);
+        }
+        if (check_graph_has_arguments(op))
+        {
+            const uint32_t mask = check_program_argument_mask(program, node);
+            for (uint32_t i = 0; i < graph->argument_counts[node]; i += 1)
+            {
+                if (op == CHECK_OP_CALL || op == CHECK_OP_BUILTIN_X86 || (i < 32 && (mask & (1u << i)) != 0))
+                {
+                    check_x86_diagnostic_push(walk, graph->argument_nodes[graph->argument_offsets[node] + i], false);
+                }
+            }
+        }
+    }
+}
+
+static bool check_program_x86_diagnostics(CheckProgram* program, CheckStream* stream, Arena* scratch)
+{
+    bool pending = false;
+    for (uint32_t i = 0; !pending && i < stream->x86_count; i += 1)
+    {
+        for (uint32_t e = 0; e < stream->x86[i].range_event_count; e += 1)
+        {
+            pending |= stream->x86[i].range_events[e].disposition == CHECK_BUILTIN_X86_DEFERRED;
+        }
+    }
+    const uint64_t mark = scratch->length;
+    const uint64_t count = (uint64_t)program->input->graph.count + program->control_count;
+    CheckX86DiagnosticWalk walk = { .program = program };
+    if (pending)
+    {
+        walk.seen = BUSTER_ARENA_PUSH_ARRAY(scratch, uint8_t, count);
+        walk.stack = BUSTER_ARENA_PUSH_ARRAY(scratch, uint64_t, count);
+    }
+    const bool valid = !pending || (walk.seen != NULL && walk.stack != NULL);
+    if (pending && valid)
+    {
+        memset(walk.seen, 0, count);
+        for (uint32_t b = 0; program->status == CHECK_PROGRAM_OK && b < program->body_count; b += 1)
+        {
+            walk.body = program->bodies + b;
+            check_x86_diagnostic_push(&walk, 0, true);
+            while (walk.depth != 0 && program->status == CHECK_PROGRAM_OK)
+            {
+                const uint64_t item = walk.stack[--walk.depth];
+                if (item < program->input->graph.count)
+                {
+                    check_x86_diagnostic_expression(&walk, (uint32_t)item);
+                }
+                else
+                {
+                    check_x86_diagnostic_control(&walk, (uint32_t)(item - program->input->graph.count) - walk.body->first);
+                }
+            }
+        }
+        for (uint32_t i = 0; program->status == CHECK_PROGRAM_OK && i < stream->x86_count; i += 1)
+        {
+            CheckBuiltinX86Effect* effect = stream->x86 + i;
+            for (uint32_t e = 0; e < effect->range_event_count; e += 1)
+            {
+                CheckBuiltinX86RangeEvent* event = effect->range_events + e;
+                if (event->disposition == CHECK_BUILTIN_X86_DEFERRED)
+                {
+                    event->disposition = walk.seen[effect->node] != 0 ? CHECK_BUILTIN_X86_READY : CHECK_BUILTIN_X86_SUPPRESSED;
+                }
+            }
+        }
+    }
+    arena_pop_to(scratch, mark);
+    return valid;
+}
diff --git a/src/buster/compiler/c_check_x86_diagnostic_test.c b/src/buster/compiler/c_check_x86_diagnostic_test.c
new file mode 100644
index 00000000..c702f49d
--- /dev/null
+++ b/src/buster/compiler/c_check_x86_diagnostic_test.c
@@ -0,0 +1,202 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+// Original source fixtures, each in its own translation unit: an earlier Clang error disables its deferred CFG
+// analysis. Both production driver schedules must agree on exit status, range message, severity and location.
+
+typedef struct CheckX86TestDiagnostic CheckX86TestDiagnostic;
+struct CheckX86TestDiagnostic
+{
+    uint32_t count;
+    uint32_t line;
+    uint32_t column;
+    bool error;
+    char message[256];
+};
+
+static CheckX86TestDiagnostic check_test_x86_diagnostic_read(const char* path)
+{
+    CheckX86TestDiagnostic result = { 0 };
+    FILE* file = fopen(path, "r");
+    char line[2048];
+    while (file != NULL && fgets(line, sizeof(line), file) != NULL)
+    {
+        const char* message = strstr(line, "argument value ");
+        if (message != NULL && strstr(message, "outside the valid range") != NULL)
+        {
+            result.count += 1;
+            result.error = strstr(line, "error: ") != NULL;
+            sscanf(line, "%*[^:]:%u:%u:", &result.line, &result.column);
+            const char* end = strstr(message, " [-W");
+            end = end != NULL ? end : strchr(message, '\n');
+            const uint32_t length = end != NULL ? (uint32_t)(end - message) : (uint32_t)strlen(message);
+            snprintf(result.message, sizeof(result.message), "%.*s", (int)length, message);
+        }
+    }
+    if (file != NULL)
+    {
+        fclose(file);
+    }
+    else
+    {
+        result.count = UINT32_MAX;
+    }
+    return result;
+}
+
+static void check_test_x86_diagnostic_storage(CheckTest* test)
+{
+    Arena scratch = arena_reserve(4096);
+    check_test_expect(test, scratch.base != NULL, "x86 diagnostic scratch allocation");
+    if (scratch.base != NULL)
+    {
+        CheckOp op = CHECK_OP_VALUE;
+        uint32_t none = BUSTER_CHECK_NONE;
+        CheckValue leaf = { 0 };
+        CheckInput input = { .graph = { .count = 1, .ops = &op, .leaves = &leaf, .operand0 = &none, .operand1 = &none, .operand2 = &none } };
+        CheckBuiltinX86Effect effect = { .range_event_count = 1 };
+        CheckStream stream = { .x86 = &effect, .x86_count = 1 };
+        CheckControl control = { .kind = CHECK_CONTROL_RETURN, .node = 0 };
+        CheckProgramBody body = { .count = 1, .entry_count = 1 };
+        CheckProgram program = { .input = &input, .stream = &stream, .controls = &control, .control_count = 1, .bodies = &body, .body_count = 1 };
+        const uint64_t capacity = scratch.capacity;
+        bool succeeded = false;
+        for (uint32_t limit = 17; limit <= 64; limit += 1)
+        {
+            memset(scratch.base, 0xa5, capacity);
+            scratch.length = 17;
+            scratch.capacity = limit;
+            effect.range_events[0].disposition = CHECK_BUILTIN_X86_DEFERRED;
+            const bool resolved = check_program_x86_diagnostics(&program, &stream, &scratch);
+            bool prefix = scratch.length == 17;
+            for (uint32_t i = 0; i < 17; i += 1)
+            {
+                prefix &= scratch.base[i] == 0xa5;
+            }
+            succeeded |= resolved;
+            check_test_expect(test, prefix && effect.range_events[0].disposition ==
+                                   (resolved ? CHECK_BUILTIN_X86_READY : CHECK_BUILTIN_X86_DEFERRED),
+                              "x86 diagnostic exhaustion preserves deferred events and the scratch prefix");
+        }
+        check_test_expect(test, succeeded, "x86 diagnostic worklist fits its exact bounded allocation");
+        scratch.capacity = capacity;
+        program.body_count = 0;
+        effect.range_events[0].disposition = CHECK_BUILTIN_X86_DEFERRED;
+        check_test_expect(test, check_program_x86_diagnostics(&program, &stream, &scratch) &&
+                               effect.range_events[0].disposition == CHECK_BUILTIN_X86_SUPPRESSED,
+                          "an unevaluated graph node has no executable root");
+        scratch.capacity = 0;
+        scratch.length = 0;
+        check_test_expect(test, check_program_x86_diagnostics(&program, &stream, &scratch) && scratch.length == 0,
+                          "resolved x86 events need no scratch or second traversal");
+        effect.range_event_count = 0;
+        check_test_expect(test, check_program_x86_diagnostics(&program, &stream, &scratch) && scratch.length == 0,
+                          "in-range x86 calls need no diagnostic worklist");
+        scratch.capacity = capacity;
+    }
+    arena_release(&scratch);
+}
+
+static void check_test_x86_diagnostics(CheckTest* test, const char* clang)
+{
+    check_test_x86_diagnostic_storage(test);
+    static const struct
+    {
+        const char* name;
+        const char* source;
+        uint32_t diagnostics;
+        bool rejected;
+    } fixtures[] =
+    {
+        { "issue 487", "unsigned long long f(W a){return __builtin_ia32_ucmpb512_mask(a,a,8,~0ull);}", 1, true },
+        { "negative immediate", "unsigned f(V a){return __builtin_ia32_cmpb128_mask(a,a,-1,65535);}", 1, true },
+        { "in range", "unsigned f(V a){return __builtin_ia32_cmpb128_mask(a,a,7,65535);}", 0, false },
+        { "unknown if", "unsigned f(V a,int n){if(n)return BAD;return 0;}", 1, true },
+        { "live if", "unsigned f(V a){if(1)return BAD;return 0;}", 1, true },
+        { "dead if", "unsigned f(V a){if(0)return BAD;return 0;}", 0, false },
+        { "dead else", "unsigned f(V a){if(1)return 0;else return BAD;}", 0, false },
+        { "after return", "unsigned f(V a){return 0;return BAD;}", 0, false },
+        { "goto skips call", "unsigned f(V a){goto out;return BAD;out:return 0;}", 0, false },
+        { "goto enters dead arm", "unsigned f(V a){goto in;if(0){in:return BAD;}return 0;}", 1, true },
+        { "dead while", "unsigned f(V a){while(0)return BAD;return 0;}", 0, false },
+        { "dead for", "unsigned f(V a){for(;0;)return BAD;return 0;}", 0, false },
+        { "live do", "unsigned f(V a){do{return BAD;}while(0);}", 1, true },
+        { "after break", "unsigned f(V a){while(1){break;return BAD;}return 0;}", 0, false },
+        { "after continue", "unsigned f(V a,int n){while(n--){continue;return BAD;}return 0;}", 0, false },
+        { "dead switch case", "unsigned f(V a){switch(0){case 1:return BAD;default:return 0;}}", 0, false },
+        { "live switch case", "unsigned f(V a){switch(0){case 0:return BAD;default:return 0;}}", 1, true },
+        { "live switch default", "unsigned f(V a){switch(0){case 1:return 0;default:return BAD;}}", 1, true },
+        { "switch fallthrough", "unsigned f(V a){switch(0){case 0:;case 1:return BAD;default:return 0;}}", 1, true },
+        { "unknown switch", "unsigned f(V a,int n){switch(n){case 1:return BAD;default:return 0;}}", 1, true },
+        { "short circuit and", "unsigned f(V a){return 0&&BAD;}", 0, false },
+        { "short circuit or", "unsigned f(V a){return 1||BAD;}", 0, false },
+        { "live and", "unsigned f(V a){return 1&&BAD;}", 1, true },
+        { "unknown and", "unsigned f(V a,int n){return n&&BAD;}", 1, true },
+        { "dead conditional arm", "unsigned f(V a){return 1?0:BAD;}", 0, false },
+        { "live conditional arm", "unsigned f(V a){return 0?0:BAD;}", 1, true },
+        { "sizeof", "unsigned f(V a){return sizeof(BAD);}", 0, false },
+        { "alignof", "unsigned f(V a){return __alignof__(BAD);}", 0, false },
+        { "selected choose", "unsigned f(V a){return __builtin_choose_expr(1,BAD,0);}", 1, true },
+        { "initializer", "unsigned f(V a){unsigned x=BAD;return x;}", 1, true },
+        { "dead initializer", "unsigned f(V a){if(0){unsigned x=BAD;return x;}return 0;}", 0, false },
+        { "scalar compound literal", "unsigned f(V a){return (unsigned){BAD};}", 1, true },
+        { "array compound literal", "unsigned f(V a){return ((unsigned[]){BAD,0})[0];}", 1, true },
+        { "record compound literal", "struct S{unsigned x;};unsigned f(V a){return ((struct S){.x=BAD}).x;}", 1, true },
+        { "nested compound literal", "unsigned f(V a){return (unsigned){(unsigned){BAD}};}", 1, true },
+        { "in-range compound literal", "unsigned f(V a){return (unsigned){__builtin_ia32_cmpb128_mask(a,a,7,65535)};}", 0, false },
+        { "dead compound literal", "unsigned f(V a){if(0)return (unsigned){BAD};return 0;}", 0, false },
+        { "sizeof compound literal", "unsigned f(V a){return sizeof((unsigned){BAD});}", 0, false },
+        { "short-circuited compound literal", "unsigned f(V a){return 0&&((unsigned){BAD});}", 0, false },
+        { "ordinary call argument", "void take(unsigned);void f(V a){take(BAD);}", 1, true },
+        { "statement expression", "unsigned f(V a){return ({BAD;});}", 1, true },
+        { "dead statement expression", "unsigned f(V a){return 0&&({BAD;});}", 0, false },
+        { "warning policy", "#pragma clang diagnostic warning \"-Wargument-outside-range\"\nunsigned f(V a){return BAD;}", 1, false },
+        { "ignored policy", "#pragma clang diagnostic ignored \"-Wargument-outside-range\"\nunsigned f(V a){return BAD;}", 0, false },
+        { "push pop policy", "#pragma GCC diagnostic push\n#pragma GCC diagnostic ignored \"-Wargument-outside-range\"\nunsigned f(V a){return BAD;}\n#pragma GCC diagnostic pop\nunsigned g(V a){return BAD;}", 1, true },
+        { "ICE stays hard in dead code", "unsigned f(V a,int n){if(0)return __builtin_ia32_cmpb128_mask(a,a,n,65535);return 0;}", 0, true },
+        { "ICE stays hard in sizeof", "unsigned f(V a,int n){return sizeof(__builtin_ia32_cmpb128_mask(a,a,n,65535));}", 0, true },
+    };
+    char directory[] = "/tmp/buster-x86-diagnostic-XXXXXX";
+    const bool ready = mkdtemp(directory) != NULL;
+    check_test_expect(test, ready, "x86 range diagnostic directory");
+    char path[256];
+    char output[256];
+    char errors[256];
+    snprintf(path, sizeof(path), "%s/source.c", directory);
+    snprintf(output, sizeof(output), "%s/output", directory);
+    snprintf(errors, sizeof(errors), "%s/errors", directory);
+    const char prefix[] = "typedef char V __attribute__((vector_size(16)));\n"
+                          "typedef char W __attribute__((vector_size(64)));\n"
+                          "#define BAD __builtin_ia32_cmpb128_mask(a,a,8,65535)\n";
+    for (uint32_t i = 0; ready && i < BUSTER_ARRAY_LENGTH(fixtures); i += 1)
+    {
+        char source[2048];
+        const int length = snprintf(source, sizeof(source), "%s%s\n", prefix, fixtures[i].source);
+        const bool written = length > 0 && (size_t)length < sizeof(source) && parse_test_write(path, source, (size_t)length);
+        char* arguments[] = { (char*)clang, "-std=gnu17", "-fsyntax-only", "-fno-color-diagnostics", path, NULL };
+        const int oracle_status = written ? object_test_run(arguments, output, errors) : -1;
+        const CheckX86TestDiagnostic oracle = check_test_x86_diagnostic_read(errors);
+        char description[512];
+        snprintf(description, sizeof(description), "x86 %s: Clang status %d/ranges %u, expected %u/%u", fixtures[i].name,
+                 oracle_status, oracle.count, fixtures[i].rejected, fixtures[i].diagnostics);
+        check_test_expect(test, oracle_status == (fixtures[i].rejected ? 1 : 0) && oracle.count == fixtures[i].diagnostics, description);
+        for (uint32_t scalar = 0; scalar < 2; scalar += 1)
+        {
+            const int status = written ? check_test_packed_run(NULL, path, output, errors, scalar != 0) : -1;
+            const CheckX86TestDiagnostic actual = check_test_x86_diagnostic_read(errors);
+            const bool same = status == oracle_status && actual.count == oracle.count &&
+                              (actual.count == 0 || (actual.line == oracle.line && actual.column == oracle.column &&
+                               actual.error == oracle.error && strcmp(actual.message, oracle.message) == 0));
+            snprintf(description, sizeof(description), "x86 %s, scalar %u: status %d/ranges %u at %u:%u, Clang %d/%u at %u:%u: %.200s",
+                     fixtures[i].name, scalar, status, actual.count, actual.line, actual.column, oracle_status, oracle.count,
+                     oracle.line, oracle.column, actual.message);
+            check_test_expect(test, same, description);
+        }
+    }
+    if (ready)
+    {
+        unlink(path);
+        unlink(output);
+        unlink(errors);
+        rmdir(directory);
+    }
+}
diff --git a/src/buster/compiler/c_checker_driver.c b/src/buster/compiler/c_checker_driver.c
index 753d2b6d..467182bb 100644
--- a/src/buster/compiler/c_checker_driver.c
+++ b/src/buster/compiler/c_checker_driver.c
@@ -168,0 +169,41 @@ static void check_driver_packed_report(const Parser* parser, Preprocessor* pp, c
+static void check_driver_x86_reports(const Parser* parser, Preprocessor* pp, const CheckInput* input, const CheckStream* stream,
+                                      const TypeTable* types, bool quiet)
+{
+    for (uint32_t i = 0; !quiet && !pp->fatal && i < stream->x86_count; i += 1)
+    {
+        const CheckBuiltinX86Effect* effect = stream->x86 + i;
+        for (uint32_t e = 0; !pp->fatal && e < effect->range_event_count; e += 1)
+        {
+            const uint32_t token = check_diagnostic_x86_token(input, effect->node);
+            const CheckWarningSeverity severity = check_diagnostic_severity(input, token, CHECK_WARNING_ARGUMENT_OUTSIDE_RANGE);
+            const CheckBuiltinX86RangeEvent* event = effect->range_events + e;
+            // A failed/incomplete program cannot prove deadness. Report any still-deferred event conservatively.
+            if (event->disposition != CHECK_BUILTIN_X86_SUPPRESSED && severity != CHECK_WARNING_IGNORE && token < parser->tokens.count)
+            {
+                uint32_t width = 0;
+                bool sign = false;
+                check_action_integer_type(types, event->value.type, &width, &sign);
+                const bool negative = sign && (event->value.integer >> (width - 1)) != 0;
+                unsigned __int128 magnitude = negative ? (0 - event->value.integer) & check_action_mask(width) : event->value.integer;
+                char digits[42];
+                char* text = digits + sizeof(digits) - 1;
+                *text = 0;
+                do
+                {
+                    *--text = '0' + magnitude % 10;
+                    magnitude /= 10;
+                }
+                while (magnitude != 0);
+                if (negative)
+                {
+                    *--text = '-';
+                }
+                const PPSeverity pp_severity = severity == CHECK_WARNING_FATAL ? PP_SEVERITY_FATAL :
+                                               severity == CHECK_WARNING_ERROR ? PP_SEVERITY_ERROR : PP_SEVERITY_WARNING;
+                pp_diagnose_output(pp, pp_severity, parser->tokens.sources[token],
+                                   "argument value %s is outside the valid range [%u, %u]", text, event->low, event->high);
+            }
+        }
+    }
+}
+
@@ -1356,0 +1398,2 @@ static int run_check_command(int count, char** arguments, bool executable)
+                        check_driver_x86_reports(checking, &pp, &input, &stream, &types, quiet);
+                        result = pp.errors != 0 ? 1 : result;
