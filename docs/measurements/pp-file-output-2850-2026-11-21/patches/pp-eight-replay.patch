+    const __m512i offsets = _mm512_and_si512(addresses,_mm512_set1_epi64(7));
+    const __m512i lengths = _mm512_cvtepu32_epi64(lengths32);
+    const __m512i aligned = _mm512_andnot_si512(_mm512_set1_epi64(7),addresses);
+    const __m512i first = _mm512_mask_i64gather_epi64(zero,active,aligned,(const void*)0,1);
+    const __mmask8 crosses = _mm512_mask_cmpgt_epu64_mask(active,_mm512_add_epi64(offsets,lengths),eight);
+    const __m512i second = _mm512_mask_i64gather_epi64(zero,crosses,_mm512_add_epi64(aligned,eight),(const void*)0,1);
+    const __m512i shift = _mm512_slli_epi64(offsets,3);
+    const __m512i chars = _mm512_or_si512(_mm512_srlv_epi64(first,shift),
+                                         _mm512_sllv_epi64(second,_mm512_sub_epi64(_mm512_set1_epi64(64),shift)));
+    const __m512i bits = _mm512_slli_epi64(_mm512_min_epu64(lengths,eight),3);
+    const __m512i live = _mm512_sub_epi64(_mm512_sllv_epi64(one,bits),one);
+    const __m512i digits = _mm512_sub_epi8(chars,_mm512_set1_epi8('0'));
+    const __m512i bad = _mm512_movm_epi8(_mm512_cmpgt_epu8_mask(digits,_mm512_set1_epi8(9)));
+    __mmask8 valid = _mm512_mask_testn_epi64_mask(active,live,bad);
+    const __mmask8 multiple = _mm512_mask_cmpgt_epu64_mask(valid,lengths,one);
+    valid &= ~_mm512_mask_testn_epi64_mask(multiple,digits,_mm512_set1_epi64(255));
