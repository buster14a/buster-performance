+    const __m512i padded = _mm512_sllv_epi64(_mm512_and_si512(digits,live),_mm512_sub_epi64(_mm512_set1_epi64(64),bits));
+    const __m512i pairs = _mm512_maddubs_epi16(padded,_mm512_set1_epi16(0x010a));
+    const __m512i fours = _mm512_madd_epi16(pairs,_mm512_set1_epi32(0x00010064));
+    const __m512i reduced = _mm512_add_epi32(_mm512_mullo_epi32(fours,_mm512_set1_epi32(10000)),_mm512_srli_epi64(fours,32));
+    __m256i result = _mm512_cvtepi64_epi32(reduced);
