+// A complete unmodified 64-row slice of a prepared source file. Adjacent compatible slices share one descriptor.
+typedef struct PPFileLocationRun
+{
+    const uint32_t* starts;
+    uint32_t output, count, base;
+} PPFileLocationRun;
+
+static bool pp_borrow_file_locations(Preprocessor* pp, uint32_t at, const uint32_t* starts, uint32_t base)
+{
+    PPFileLocationRun* previous = pp->location_run_count ? &pp->location_runs[pp->location_run_count - 1] : NULL;
+    if (previous != NULL && previous->output + previous->count == at && previous->base == base && previous->starts + previous->count == starts)
+    {
+        previous->count += 64;
+    }
+    else
+    {
+        if (pp->location_run_count == pp->location_capacity)
+        {
+            const uint32_t capacity = pp->location_capacity ? pp->location_capacity * 2 : 64;
+            PPFileLocationRun* rows = realloc(pp->location_runs, sizeof(*rows) * (size_t)capacity);
+            if (rows == NULL) return false;
+            pp->location_runs = rows;
+            pp->location_capacity = capacity;
+        }
+        pp->location_runs[pp->location_run_count++] = (PPFileLocationRun){starts, at, 64, base};
+    }
+    pp->location_rows += 64;
+    return true;
+}
+
+// Expose one ordered consumer block into fixed scratch, advancing over the immutable source runs.
+static const uint32_t* pp_file_location_block(const Preprocessor* pp, uint32_t* cursor, uint32_t begin, uint32_t count, uint32_t tmp[64])
+{
+    const uint32_t end = begin + count;
+    uint32_t row = *cursor;
+    while (row < pp->location_run_count && pp->location_runs[row].output + pp->location_runs[row].count <= begin) ++row;
+    *cursor = row;
+    if (row == pp->location_run_count || pp->location_runs[row].output >= end) return pp->output.locations + begin;
+    uint32_t t = begin;
+    while (t < end && row < pp->location_run_count && pp->location_runs[row].output < end)
+    {
+        const PPFileLocationRun* r = &pp->location_runs[row];
+        if (t < r->output)
+        {
+            memcpy(tmp + (t - begin), pp->output.locations + t, (r->output - t) * sizeof(*tmp));
+            t = r->output;
+        }
+        const uint32_t last = r->output + r->count < end ? r->output + r->count : end;
+        for (; t < last;)
+        {
+            const uint32_t width = last - t < 16 ? last - t : 16;
+            const __mmask16 live = (__mmask16)_bzhi_u32(UINT32_MAX, width);
+            const __m512i starts = _mm512_maskz_loadu_epi32(live, r->starts + (t - r->output));
+            _mm512_mask_storeu_epi32(tmp + (t - begin), live, _mm512_add_epi32(starts, _mm512_set1_epi32(r->base)));
+            t += width;
+        }
+        row += t == r->output + r->count;
+    }
+    if (t < end) memcpy(tmp + (t - begin), pp->output.locations + t, (end - t) * sizeof(*tmp));
+    *cursor = row;
+    return tmp;
+}
+
+static void pp_materialize_file_locations(Preprocessor* pp)
+{
+    for (uint32_t i = 0; i < pp->location_run_count; ++i)
+    {
+        const PPFileLocationRun* run = &pp->location_runs[i];
+        for (uint32_t j = 0; j < run->count; j += 16)
+        {
+            const __m512i starts = _mm512_loadu_si512(run->starts + j);
+            _mm512_storeu_si512(pp->output.locations + run->output + j, _mm512_add_epi32(starts, _mm512_set1_epi32(run->base)));
+        }
+    }
+    // The canonical output now owns these locations. Recording may be replayed after prepared columns
+    // have been returned; no remaining location view may reference those relinquished pages.
+    pp->location_run_count = 0;
+}
