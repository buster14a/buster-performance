+// A selected span of actual final-output file tokens, after the macro stop and direct replacements are known.
+static void pp_publish_file_digits(Preprocessor* pp, const PPFileData* data, uint32_t p, uint32_t count, uint64_t replaced, __m512i kinds)
+{
+    uint64_t numbers = _mm512_cmpeq_epi8_mask(kinds, _mm512_set1_epi8(C_TOKEN_NUMERIC_CONSTANT)) & _bzhi_u64(~replaced,count);
+    const uint32_t at = pp->output.count;
+    if (numbers == 0 || at > INT32_MAX - 64) return;
+    if (at + count > pp->single_digit_capacity)
+    {
+        uint32_t capacity = pp->single_digit_capacity == 0 ? 1024 : pp->single_digit_capacity;
+        while (capacity < at + count) capacity *= 2;
+        // check_input_gather_bytes reads a word at a byte position, including at the last initialized byte.
+        uint8_t* digits = realloc(pp->single_digits, (size_t)capacity + 4);
+        if (digits == NULL) return;
+        memset(digits + pp->single_digit_capacity, 0, (size_t)capacity - pp->single_digit_capacity + 4);
+        pp->single_digits = digits;
+        pp->single_digit_capacity = capacity;
+    }
+    for (; numbers != 0; numbers &= numbers - 1)
+    {
+        const uint32_t lane = (uint32_t)__builtin_ctzll(numbers);
+        const uint32_t begin = data->starts[p + lane], end = data->values[p + lane];
+        if (end - begin == 1 && begin < data->length)
+        {
+            const uint32_t digit = (uint32_t)data->bytes[begin] - '0';
+            if (digit <= 9)
+            {
+                pp->single_digits[at + lane] = (uint8_t)(digit + 1);
+                ++pp->single_digit_count;
+            }
+        }
+    }
+}
