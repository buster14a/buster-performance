diff --git a/src/buster/compiler/c_checker_driver.c b/src/buster/compiler/c_checker_driver.c
index 95adc3a96..6a550ca82 100644
--- a/src/buster/compiler/c_checker_driver.c
+++ b/src/buster/compiler/c_checker_driver.c
@@ -12707,7 +12707,46 @@ static int check_driver_unit(const CheckDriverCommand* command, const PPOptions*
             // A repaired fragment (check_input_fragment), a prefix (check_input_prefix), a unit with its system headers'
             // bodies deferred (check_input_selected) or the whole unit (check_input). A whole unit's bodies are read apart
             // on the command's lanes (#151) where it asks for that and has more than one lane.
-            const uint8_t* selected = lazy_system_headers && !prefix_only && lazy.deferred_count != 0 ? lazy.deferred_tokens : 0;
+            // EXPERIMENT (#2850's redesign; not for merge): with BUSTER_EXPERIMENT_MASK_BODIES set, every function body is
+            // masked as -flazy-system-headers' deferred bodies are: what the unit costs with its body tokens in place and
+            // no stage reading them.
+            uint8_t* experiment_mask = NULL;
+            if (getenv("BUSTER_EXPERIMENT_MASK_BODIES") != NULL && !prefix_only)
+            {
+                const uint32_t experiment_count = checking->tokens.count;
+                experiment_mask = BUSTER_ARENA_PUSH_ARRAY(arena, uint8_t, (uint64_t)experiment_count + 1);
+                uint32_t experiment_bodies = 0;
+                uint32_t experiment_ordinal = 0;
+                // "N" masks every body, "N:K" those whose ordinal modulo N is K.
+                const char* const experiment_text = getenv("BUSTER_EXPERIMENT_MASK_BODIES");
+                const uint32_t experiment_modulus = (uint32_t)strtoul(experiment_text, NULL, 10) != 0 ? (uint32_t)strtoul(experiment_text, NULL, 10) : 1;
+                const uint32_t experiment_residue = strchr(experiment_text, ':') != NULL ? (uint32_t)strtoul(strchr(experiment_text, ':') + 1, NULL, 10) : 0;
+                uint64_t experiment_tokens = 0;
+                if (experiment_mask != NULL)
+                {
+                    memset(experiment_mask, 0, (uint64_t)experiment_count + 1);
+                    for (uint32_t t = 0; t < experiment_count; t += 1)
+                    {
+                        if (checking->tree.roles[t] == PARSE_ROLE_OPEN_BODY)
+                        {
+                            const uint32_t closing = checking->tree.parents[t];
+                            if (closing > t && closing < experiment_count)
+                            {
+                                if (experiment_ordinal % experiment_modulus == experiment_residue % experiment_modulus)
+                                {
+                                    memset(experiment_mask + t, 1, closing - t + 1);
+                                    experiment_bodies += 1;
+                                    experiment_tokens += closing - t + 1;
+                                }
+                                experiment_ordinal += 1;
+                                t = closing;
+                            }
+                        }
+                    }
+                }
+                fprintf(errors, "experiment-mask: bodies=%u tokens=%llu of %u\n", experiment_bodies, (unsigned long long)experiment_tokens, experiment_count);
+            }
+            const uint8_t* selected = experiment_mask != NULL ? experiment_mask : lazy_system_headers && !prefix_only && lazy.deferred_count != 0 ? lazy.deferred_tokens : 0;
             const bool deferring = deferred != NULL && lanes != NULL && lanes->flow != NULL && !prefix_only && selected == NULL;
             const uint32_t deferred_lanes = deferring ? check_driver_deferred_lanes(lanes) : 1;
             CheckDriverDeferred grants = { .lanes = lanes };
