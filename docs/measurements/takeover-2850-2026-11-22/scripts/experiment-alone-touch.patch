diff --git a/src/buster/compiler/c_check_node_machine_alone.c b/src/buster/compiler/c_check_node_machine_alone.c
index f0204bee3..f24aefa45 100644
--- a/src/buster/compiler/c_check_node_machine_alone.c
+++ b/src/buster/compiler/c_check_node_machine_alone.c
@@ -507,6 +507,10 @@ static struct NodeAlone* node_alone_begin(NodeFront* front, CheckInputReader* re
     NodeFrontShadow* shadow = front->shadow;
     const uint32_t capacity = reader->output->graph.capacity;
     const uint32_t words = capacity / 64 + 1;
+    // EXPERIMENT (not for merge): what the piece takes from the reader's two arenas at its start, to touch before any
+    // timed run where BUSTER_EXPERIMENT_ALONE_TOUCH is set.
+    const uint64_t experiment_scratch = reader->scratch->length;
+    const uint64_t experiment_arena = reader->arena->length;
     struct NodeAlone* alone = arena_push_array(reader->scratch, 1, sizeof(struct NodeAlone), _Alignof(struct NodeAlone));
     NodeFront* own = arena_push_array(reader->scratch, 1, sizeof(NodeFront), 64);
     NodeFrontShadow* report = arena_push_array(reader->scratch, 1, sizeof(NodeFrontShadow), _Alignof(NodeFrontShadow));
@@ -635,6 +639,24 @@ static struct NodeAlone* node_alone_begin(NodeFront* front, CheckInputReader* re
         shadow->alone_roots = roots;
         shadow->alone_chains = chains;
     }
+    if (room && getenv("BUSTER_EXPERIMENT_ALONE_TOUCH") != NULL)
+    {
+        uint64_t touched = 0;
+        for (uint64_t at = experiment_scratch & ~UINT64_C(4095); at < reader->scratch->length; at += 4096)
+        {
+            volatile uint8_t* byte = reader->scratch->base + at;
+            *byte = *byte;
+            touched += 1;
+        }
+        for (uint64_t at = experiment_arena & ~UINT64_C(4095); at < reader->arena->length; at += 4096)
+        {
+            volatile uint8_t* byte = reader->arena->base + at;
+            *byte = *byte;
+            touched += 1;
+        }
+        fprintf(stderr, "experiment-alone-touch: %" PRIu64 " pages of 4 KB (%" PRIu64 " MB of the scratch arena, %" PRIu64 " MB of the reader's)\n", touched,
+                (reader->scratch->length - experiment_scratch) >> 20, (reader->arena->length - experiment_arena) >> 20);
+    }
     return room ? alone : NULL;
 }
 
