+// actions warned in, by the same.
+static uint64_t experiment_whole[3][2][2];
+static uint64_t experiment_warned[2][2];
+
+static __attribute__((destructor)) void experiment_slice_report(void)
+{
+    static const char* const classes[3] = { "nothing-listed", "listed-then-silent", "refused-by-the-tests" };
+    uint64_t total[2] = { 0, 0 };
+    for (uint32_t c = 0; c < 3; c += 1)
+    {
+        for (uint32_t m = 0; m < 16; m += 1)
