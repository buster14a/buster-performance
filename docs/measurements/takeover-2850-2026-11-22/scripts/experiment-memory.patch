+static __attribute__((noinline)) bool experiment_scan(const uint8_t* from, uint64_t bytes, bool nonzero, uint64_t* resident, uint64_t* filled)
+{
+    experiment_scan_informative = 0;
+    static unsigned char vector[(1u << 30) / 4096];
+    static uint8_t buffer[1u << 20];
+    bytes = bytes < (1u << 30) ? bytes : (1u << 30);
+    const uintptr_t start = (uintptr_t)from & ~(uintptr_t)4095;
+    const uint64_t page_count = ((uintptr_t)from + bytes - start + 4095) / 4096;
+    *resident = 0;
+    *filled = 0;
+    const bool mapped = page_count != 0 && mincore((void*)start, page_count * 4096, vector) == 0;
+    for (uint64_t page = 0; mapped && page < page_count; page += 1)
+    {
+        *resident += vector[page] & 1;
+    }
+    for (uint64_t page = 0; mapped && nonzero && page < page_count;)
+    {
+        if ((vector[page] & 1) == 0)
+        {
+            page += 1;
+            continue;
+        }
+        uint64_t run = 0;
+        while (page + run < page_count && run < sizeof(buffer) / 4096 && (vector[page + run] & 1) != 0)
+        {
+            run += 1;
+        }
+        struct iovec local = { .iov_base = buffer, .iov_len = run * 4096 };
+        struct iovec remote = { .iov_base = (void*)(start + page * 4096), .iov_len = run * 4096 };
+        const long got = syscall(SYS_process_vm_readv, (long)getpid(), &local, 1L, &remote, 1L, 0L);
+        for (uint64_t k = 0; got > 0 && k < (uint64_t)got / 4096; k += 1)
+        {
+            const uint64_t* words = (const uint64_t*)(const void*)(buffer + k * 4096);
+            uint64_t any = 0;
+            uint64_t all = UINT64_MAX;
+            bool mixed = false;
+            for (uint32_t w = 0; w < 512; w += 1)
+            {
+                any |= words[w];
+                all &= words[w];
+                mixed |= words[w] != 0 && words[w] != UINT64_MAX;
+            }
+            *filled += any != 0;
+            experiment_scan_informative += mixed || (any != 0 && all != UINT64_MAX);
+        }
+        page += run;
+    }
+    return mapped;
+}
