+// The mappings of 1 MB or more resident, as /proc/self/smaps has them at the mark: start, end, permissions, resident
+// kB, anonymous huge pages' kB and the path.
+static char experiment_smaps[1u << 16];
+static uint32_t experiment_smaps_length;
+
+static void experiment_memory_smaps(const char* name)
+{
+    FILE* smaps = fopen("/proc/self/smaps", "r");
+    char line[512];
+    char header[512] = "";
+    unsigned long rss = 0;
+    while (smaps != NULL && fgets(line, sizeof(line), smaps) != NULL)
+    {
+        unsigned long value = 0;
+        if (strchr(line, '-') != NULL && strchr(line, '-') < line + 17 && line[0] != 'V' && strstr(line, " kB") == NULL)
+        {
+            snprintf(header, sizeof(header), "%s", line);
+            header[strcspn(header, "\n")] = 0;
+            rss = 0;
+        }
+        else if (sscanf(line, "Rss: %lu kB", &value) == 1)
+        {
+            rss = value;
+        }
+        else if (sscanf(line, "AnonHugePages: %lu kB", &value) == 1 && rss >= 1024 && experiment_smaps_length + 600 < sizeof(experiment_smaps))
+        {
+            experiment_smaps_length += (uint32_t)snprintf(experiment_smaps + experiment_smaps_length, sizeof(experiment_smaps) - experiment_smaps_length,
+                                                          "experiment-smaps\t%s\t%lu\t%lu\t%s\n", name, rss, value, header);
+        }
+    }
+    if (smaps != NULL)
+    {
+        fclose(smaps);
+    }
+}
