+// EXPERIMENT (#2850's memory attribution; not for merge): every memset the sources call, by its caller: calls and bytes.
+#define BUSTER_EXPERIMENT_MEMSETS 4096
+typedef struct ExperimentMemset ExperimentMemset;
+struct ExperimentMemset
+{
+    const void* caller;
+    uint64_t calls;
+    uint64_t bytes;
+};
+#if defined(BUSTER_UNIT) && BUSTER_UNIT != BUSTER_UNIT_DRIVER
+extern ExperimentMemset experiment_memsets[BUSTER_EXPERIMENT_MEMSETS];
+extern bool experiment_memset_on;
+#elif defined(BUSTER_UNIT)
+ExperimentMemset experiment_memsets[BUSTER_EXPERIMENT_MEMSETS];
+bool experiment_memset_on;
+#else
+static ExperimentMemset experiment_memsets[BUSTER_EXPERIMENT_MEMSETS];
+static bool experiment_memset_on;
+#endif
+static __attribute__((noinline, unused)) void* experiment_memset(void* destination, int value, size_t bytes)
+{
+    // (Not before the command asks for it: the build bakes the tables the initializers make, and they may write no other page.)
+    if (!experiment_memset_on)
+    {
+        return (memset)(destination, value, bytes);
+    }
+    const void* caller = __builtin_return_address(0);
+    uint32_t slot = (uint32_t)(((uintptr_t)caller * UINT64_C(0x9e3779b97f4a7c15)) >> 52) % BUSTER_EXPERIMENT_MEMSETS;
+    for (uint32_t probe = 0; probe < BUSTER_EXPERIMENT_MEMSETS && experiment_memsets[slot].caller != NULL && experiment_memsets[slot].caller != caller; probe += 1)
+    {
+        slot = (slot + 1) % BUSTER_EXPERIMENT_MEMSETS;
+    }
+    experiment_memsets[slot].caller = caller;
+    experiment_memsets[slot].calls += 1;
+    experiment_memsets[slot].bytes += bytes;
+    return (memset)(destination, value, bytes);
+}
+#define memset(destination, value, bytes) experiment_memset((destination), (value), (bytes))
