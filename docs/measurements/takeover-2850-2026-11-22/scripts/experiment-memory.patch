+            {
+                fprintf(stream, "experiment-memset\t%p\t%llu\t%llu\n", experiment_memsets[slot].caller, (unsigned long long)experiment_memsets[slot].calls,
+                        (unsigned long long)experiment_memsets[slot].bytes);
+            }
+        }
+        for (uint32_t push = 0; push < experiment_push_count; push += 1)
+        {
+            const ExperimentPush* row = &experiment_pushes[push];
+            uint32_t arena = 0;
+            while (arena < experiment_arena_count && experiment_arenas[arena].mapping != row->mapping)
+            {
+                arena += 1;
+            }
+            fprintf(stream, "experiment-push\t%s\t%u\t%llu\t%llu\t%p\t%u/%u\t%u/%u\t%u\t%u\t%u\t%u\t%u\t%u\n", row->stage, arena, (unsigned long long)row->begin,
+                    (unsigned long long)row->bytes, row->caller, row->resident_kb[0], row->nonzero_kb[0], row->resident_kb[1], row->nonzero_kb[1], row->informative_kb[0],
+                    row->informative_kb[1], row->fresh_kb, row->own_resident_kb, row->own_nonzero_kb, row->own_informative_kb);
+        }
+        fprintf(stream, "experiment-marks");
+        for (uint32_t m = 0; m < experiment_mark_count; m += 1)
+        {
+            fprintf(stream, "\t%s", experiment_mark_names[m]);
+        }
+        fprintf(stream, "\nexperiment-rss-kb");
+        for (uint32_t m = 0; m < experiment_mark_count; m += 1)
+        {
+            fprintf(stream, "\t%u", experiment_mark_rss_kb[m]);
