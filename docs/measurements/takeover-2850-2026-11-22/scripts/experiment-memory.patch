+// EXPERIMENT (#2850's memory attribution; not for merge): at a mark, each registered mapping's resident bytes (mincore
+// over its first GB) and, at the marks that ask, the bytes of its resident 4 KB pages that hold a nonzero byte, read
+// through process_vm_readv so that a page the arena made inaccessible is skipped rather than faulted on.
+static uint32_t experiment_mark_count;
+static const char* experiment_mark_names[BUSTER_EXPERIMENT_MARKS];
+static uint32_t experiment_mark_rss_kb[BUSTER_EXPERIMENT_MARKS];
+
+static void experiment_memory_mark(const char* name, bool nonzero)
+{
+    if (experiment_on && experiment_mark_count < BUSTER_EXPERIMENT_MARKS)
+    {
+        const uint32_t mark = experiment_mark_count;
+        experiment_mark_names[mark] = name;
+        FILE* statm = fopen("/proc/self/statm", "r");
+        unsigned long pages = 0, resident_pages = 0;
+        if (statm != NULL)
+        {
+            if (fscanf(statm, "%lu %lu", &pages, &resident_pages) != 2)
+            {
+                resident_pages = 0;
+            }
+            fclose(statm);
+        }
+        experiment_mark_rss_kb[mark] = (uint32_t)(resident_pages * 4);
+        for (uint32_t a = 0; a < experiment_arena_count; a += 1)
+        {
+            ExperimentArena* arena = &experiment_arenas[a];
+            uint64_t resident = 0;
+            uint64_t filled = 0;
+            if (arena->dead || !experiment_scan(arena->mapping, arena->mapping_bytes, nonzero, &resident, &filled))
+            {
+                arena->dead = true;
+            }
+            arena->resident_kb[mark] = (uint32_t)(resident * 4);
+            arena->nonzero_kb[mark] = (uint32_t)(filled * 4);
+        }
+        const int slot = strcmp(name, "check-declarations") == 0 ? 0 : strcmp(name, "object-write") == 0 ? 1 : -1;
+        for (uint32_t push = 0; slot >= 0 && push < experiment_push_count; push += 1)
+        {
+            ExperimentPush* row = &experiment_pushes[push];
+            uint64_t resident = 0;
+            uint64_t filled = 0;
+            uint32_t a = 0;
+            while (a < experiment_arena_count && experiment_arenas[a].mapping != row->mapping)
+            {
+                a += 1;
+            }
+            if (a < experiment_arena_count && !experiment_arenas[a].dead && row->begin + row->bytes <= (1u << 30) &&
+                experiment_scan(row->address, row->bytes, true, &resident, &filled))
+            {
+                row->resident_kb[slot] = (uint32_t)(resident * 4);
+                row->nonzero_kb[slot] = (uint32_t)(filled * 4);
+                row->informative_kb[slot] = (uint32_t)(experiment_scan_informative * 4);
+            }
+        }
+        for (uint32_t push = 0; push < experiment_push_count; push += 1)
+        {
+            ExperimentPush* row = &experiment_pushes[push];
+            uint64_t resident = 0;
+            uint64_t filled = 0;
+            uint32_t a = 0;
+            while (a < experiment_arena_count && experiment_arenas[a].mapping != row->mapping)
+            {
+                a += 1;
+            }
+            if (!row->own_scanned && a < experiment_arena_count && !experiment_arenas[a].dead && row->begin + row->bytes <= (1u << 30) &&
+                experiment_scan(row->address, row->bytes, true, &resident, &filled))
+            {
+                row->own_resident_kb = (uint32_t)(resident * 4);
+                row->own_nonzero_kb = (uint32_t)(filled * 4);
+                row->own_informative_kb = (uint32_t)(experiment_scan_informative * 4);
