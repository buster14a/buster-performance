+                    (unsigned long long)arena->capacity, arena->takes);
+            for (uint32_t m = 0; m < experiment_mark_count; m += 1)
+            {
+                fprintf(stream, "\t%u/%u", arena->resident_kb[m], arena->nonzero_kb[m]);
+            }
+            fprintf(stream, "\n");
+        }
+    }
+}
