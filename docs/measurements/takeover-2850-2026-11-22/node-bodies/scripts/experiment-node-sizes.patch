diff --git a/src/buster/compiler/lane.c b/src/buster/compiler/lane.c
index 19ff4f6ff..6b271cc33 100644
--- a/src/buster/compiler/lane.c
+++ b/src/buster/compiler/lane.c
@@ -174,6 +174,46 @@ struct Arena
 // BUSTER_ARENA_SMALL_BYTES in base pages, and the rest in huge pages. Returns an arena without capacity, in which every
 // push fails, if the address space can't be reserved.
 static __attribute__((unused)) Arena arena_reserve(uint64_t capacity);
+// EXPERIMENT (not for merge): named ranges of arenas, and what of each is resident.
+typedef struct { const char* name; const uint8_t* begin; const uint8_t* end; } ExperimentRange;
+static ExperimentRange experiment_ranges[128];
+static uint32_t experiment_range_count;
+static __attribute__((unused)) void experiment_note(const char* name, const Arena* arena, uint64_t start)
+{
+    if (experiment_range_count < 128)
+    {
+        experiment_ranges[experiment_range_count++] = (ExperimentRange){ name, arena->base + start, arena->base + arena->length };
+    }
+}
+static __attribute__((unused)) void experiment_report(const char* at)
+{
+    if (getenv("BUSTER_EXPERIMENT_NODE_SIZES") == NULL)
+    {
+        return;
+    }
+    static unsigned char vector[1 << 18];
+    for (uint32_t i = 0; i < experiment_range_count; i += 1)
+    {
+        const uintptr_t begin = (uintptr_t)experiment_ranges[i].begin & ~(uintptr_t)4095;
+        const uintptr_t end = ((uintptr_t)experiment_ranges[i].end + 4095) & ~(uintptr_t)4095;
+        uint64_t resident = 0;
+        for (uintptr_t place = begin; place < end;)
+        {
+            uintptr_t chunk = end - place;
+            chunk = chunk > ((uintptr_t)sizeof(vector) << 12) ? ((uintptr_t)sizeof(vector) << 12) : chunk;
+            if (mincore((void*)place, chunk, vector) == 0)
+            {
+                for (uintptr_t page = 0; page < chunk >> 12; page += 1)
+                {
+                    resident += vector[page] & 1;
+                }
+            }
+            place += chunk;
+        }
+        fprintf(stderr, "experiment-size\t%s\t%s\treserved-kb=%llu\tresident-kb=%llu\n", at, experiment_ranges[i].name,
+                (unsigned long long)((uint64_t)(experiment_ranges[i].end - experiment_ranges[i].begin) >> 10), (unsigned long long)(resident << 2));
+    }
+}
 // arena_reserve with the first `small` bytes in base pages (a multiple of BUSTER_ARENA_PAGE_BYTES, at least
 // BUSTER_ARENA_SMALL_BYTES), for a table that usually stays below what a huge page is worth: the kernel clears a huge
 // page whole when it is first touched, which costs as much as about 750 KB of base pages on the 9700X. The thread's
