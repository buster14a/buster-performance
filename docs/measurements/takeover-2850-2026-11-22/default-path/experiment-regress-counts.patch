--- a/src/buster/compiler/lane.c
+++ b/src/buster/compiler/lane.c
@@ -174,6 +174,41 @@ struct Arena
 // BUSTER_ARENA_SMALL_BYTES in base pages, and the rest in huge pages. Returns an arena without capacity, in which every
 // push fails, if the address space can't be reserved.
 static __attribute__((unused)) Arena arena_reserve(uint64_t capacity);
+// EXPERIMENT (not for merge): calls, ticks and distinct keys of a few of the checker's functions.
+enum { EXPERIMENT_CONST_INTEGER, EXPERIMENT_EMISSION_TRUTH, EXPERIMENT_BRANCH_TRUTH, EXPERIMENT_FOLD_TRUTH, EXPERIMENT_EMIT_SEQUENCE, EXPERIMENT_LOGICAL_BOOLEAN,
+       EXPERIMENT_LOGICAL_OTHER, EXPERIMENT_LOGICAL_FILTERED, EXPERIMENT_KINDS };
+static const char* const experiment_names[EXPERIMENT_KINDS] = { "const-integer", "emission-truth", "branch-truth", "fold-truth", "emit-sequence", "logical-boolean-right",
+                                                                "logical-other-right", "logical-filtered-out" };
+static uint64_t experiment_calls[EXPERIMENT_KINDS];
+static uint64_t experiment_ticks[EXPERIMENT_KINDS];
+static uint64_t experiment_true[EXPERIMENT_KINDS];
+static uint64_t experiment_distinct[EXPERIMENT_KINDS];
+static uint64_t experiment_seen[EXPERIMENT_KINDS][1 << 15];
+static __attribute__((unused)) void experiment_count(uint32_t kind, uint64_t ticks, bool truth, uint32_t key)
+{
+    experiment_calls[kind] += 1;
+    experiment_ticks[kind] += ticks;
+    experiment_true[kind] += truth;
+    if (key < (1u << 21) && (experiment_seen[kind][key >> 6] >> (key & 63) & 1) == 0)
+    {
+        experiment_seen[kind][key >> 6] |= UINT64_C(1) << (key & 63);
+        experiment_distinct[kind] += 1;
+    }
+}
+static __attribute__((destructor, unused)) void experiment_print(void)
+{
+    if (getenv("BUSTER_EXPERIMENT_REGRESS") != NULL)
+    {
+        for (uint32_t kind = 0; kind < EXPERIMENT_KINDS; kind += 1)
+        {
+            if (experiment_calls[kind] != 0)
+            {
+                fprintf(stderr, "experiment-regress\t%s\tcalls=%llu\tdistinct=%llu\ttrue=%llu\tticks=%llu\n", experiment_names[kind], (unsigned long long)experiment_calls[kind],
+                        (unsigned long long)experiment_distinct[kind], (unsigned long long)experiment_true[kind], (unsigned long long)experiment_ticks[kind]);
+            }
+        }
+    }
+}
