diff --git a/src/buster/compiler/c_check_program.c b/src/buster/compiler/c_check_program.c
index 2bc03866a..4f1508ca1 100644
--- a/src/buster/compiler/c_check_program.c
+++ b/src/buster/compiler/c_check_program.c
@@ -6567,11 +6567,13 @@ static bool check_program_begin(CheckProgramRun* run, CheckProgram* program, con
     // peak. A lane of several units that has another to compile gives them back in whole huge pages
     // (CheckProgramOptions.discard_huge, #777): the huge page a discard frees part of is split, and its next unit's
     // parse and reader fault the part in again a base page at a time, as each later unit does.
-    if (valid && options.discard_huge)
+    const char* proto = getenv("PROTO_NO_DISCARD");
+    const bool proto_keep = proto != NULL && (proto[0] == '2' || proto[0] == '3');
+    if (valid && options.discard_huge && !proto_keep)
     {
         arena_discard_past(scratch, scratch->length + options.discard_keep, true);
     }
-    else if (valid)
+    else if (valid && !proto_keep)
     {
         arena_discard(scratch);
     }
diff --git a/src/buster/compiler/c_checker_driver.c b/src/buster/compiler/c_checker_driver.c
index e4534db04..584f5bcf8 100644
--- a/src/buster/compiler/c_checker_driver.c
+++ b/src/buster/compiler/c_checker_driver.c
@@ -12841,6 +12841,11 @@ static uint32_t check_driver_typo_errors(const CheckDriverTypoEdits* edits, cons
 // next unit would fault it in a base page at a time.
 static void check_driver_discard_scratch(Arena* scratch, CheckProgramLanes* lanes, uint64_t kept)
 {
+    const char* proto = getenv("PROTO_NO_DISCARD");
+    if (proto != NULL && (proto[0] == '1' || proto[0] == '3'))
+    {
+        return;
+    }
     arena_discard_past(scratch, kept, lanes != NULL && lanes->units_lane != NULL && check_units_unit_left(lanes->units_lane));
 }
 
