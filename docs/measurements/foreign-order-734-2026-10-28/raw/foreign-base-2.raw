exclusive.sh: waiting for the 9700X, held by: 2026-10-28T21:33:52+00:00 claude-solve-147: bash -c 
    B=~/buster-fast-bench
    D=$B/solve147-claude
    Q=$B/preprocessor-corpora-astra-01a158dd/sqlite
    for round in 1 2 3 4 5 6 7 8; do
        if [ $((round % 2)) = 1 ]; then order="main head"; else order="head main"; fi
        for tree in $order; do
            taskset -c 2 perf stat -r 3 -x, -e instructions:u,cycles:u,task-clock $D/$tree/build/compiler -c -I$Q -o $D/ab-$tree.o $Q/sqlite3.c 2> $D/ab.tmp
            echo "$round $tree $(grep instructions:u $D/ab.tmp | cut -d, -f1) $(grep cycles:u $D/ab.tmp | cut -d, -f1) $(grep task-clock $D/ab.tmp | cut -d, -f1)"
        done
    done
    rm -f $D/ab.tmp

