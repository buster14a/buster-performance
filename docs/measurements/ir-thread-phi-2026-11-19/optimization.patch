+// Only br and cbr predecessors request an incoming value. A switch with more successors can keep its edge to the
+// join, but never needs an indexed row. The CFG gives a cbr with equal targets a single edge.
+static uint32_t ir_thread_input_edge(const IrCfg* cfg, uint32_t predecessor, uint32_t block)
+{
+    const uint32_t first = cfg->successor_offsets[predecessor];
+    const uint32_t end = cfg->successor_offsets[(uint64_t)predecessor + 1];
+    const uint32_t edge = first + (first != end && cfg->successors[first] != block);
+    return end - first <= 2 && edge < end && cfg->successors[edge] == block ? edge : BUSTER_IR_NONE;
+}
+
+// Index a wide join once. A lone phi's edge points straight into the immutable input. For several phis the first's
+// order numbers the rows; every other phi places its own pairs by predecessor, irrespective of their order.
+// The round's reachability queue is free to hold these row numbers until this call returns.
+static bool ir_thread_index(IrThreadWork* work, uint32_t block, uint32_t* positions, Arena* scratch)
+{
+    const IrFunction* f = work->function;
+    const uint32_t first = f->block_offsets[block];
+    uint32_t phis = 1;
+    while (f->op[first + phis] == IR_PHI)
+    {
+        phis += 1;
+    }
+    const uint32_t width = f->b[first];
+    bool ok = true;
+    if (work->inputs == NULL)
+    {
+        work->inputs = ir_allocate(scratch, work->cfg.edge_count, sizeof(*work->inputs), &ok);
+    }
+    uint32_t* rows = phis > 1 ? ir_allocate(scratch, (uint64_t)phis * width, sizeof(*rows), &ok) : NULL;
+    for (uint32_t i = 0; ok && i < phis; i += 1)
+    {
+        const uint32_t* pairs = f->extra + f->a[first + i];
+        for (uint32_t k = 0; k < width; k += 1)
+        {
+            const uint32_t predecessor = pairs[2 * k];
+            if (i == 0)
+            {
+                const uint32_t edge = ir_thread_input_edge(&work->cfg, predecessor, block);
+                if (edge != BUSTER_IR_NONE)
+                {
+                    work->inputs[edge] = phis == 1 ? pairs + 2 * k + 1 : rows + (uint64_t)k * phis;
+                }
+                if (phis > 1)
+                {
+                    positions[predecessor] = k;
+                }
+            }
+            if (phis > 1)
+            {
+                rows[(uint64_t)positions[predecessor] * phis + i] = pairs[2 * k + 1];
+            }
+        }
+    }
+    return ok;
+}
