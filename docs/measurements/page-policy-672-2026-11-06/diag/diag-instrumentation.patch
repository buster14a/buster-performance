diff --git a/src/buster/compiler/c_check_clock.c b/src/buster/compiler/c_check_clock.c
index 823419f1..1e8073f0 100644
--- a/src/buster/compiler/c_check_clock.c
+++ b/src/buster/compiler/c_check_clock.c
@@ -331,6 +331,25 @@ static void check_clock_mark(CheckClock* stage_clock, CheckStage stage)
         stage_clock->system_us = system_us;
         stage_clock->minor_faults = minor_faults;
         stage_clock->peak_kb += added;
+        // DIAGNOSTIC ONLY: copy smaps at each mark.
+        {
+            const char* dir = getenv("BUSTER_SMAPS_DIR");
+            if (dir != 0)
+            {
+                char path[512];
+                snprintf(path, sizeof(path), "%s/%llu-%s.txt", dir, (unsigned long long)__rdtsc(), check_stage_names[stage]);
+                FILE* in = fopen("/proc/self/smaps", "r");
+                FILE* out = fopen(path, "w");
+                char buffer[65536];
+                size_t got = 0;
+                while (in != 0 && out != 0 && (got = fread(buffer, 1, sizeof(buffer), in)) != 0)
+                {
+                    fwrite(buffer, 1, got, out);
+                }
+                if (in) fclose(in);
+                if (out) fclose(out);
+            }
+        }
         // Both resource reads belong to this stage's time, not the next stage's.
         check_clock_lap(stage_clock, stage);
     }
diff --git a/src/buster/compiler/lane.c b/src/buster/compiler/lane.c
index 1728ea29..61c667ae 100644
--- a/src/buster/compiler/lane.c
+++ b/src/buster/compiler/lane.c
@@ -457,6 +457,28 @@ static Arena arena_pool_take(ArenaPool* pool, uint32_t slot, uint64_t capacity,
 // (arena_commit), which a host whose transparent huge pages are `madvise` needs. An arena that stays in its base pages,
 // as most of a small unit's 70 do, takes one mmap and one mprotect, without the two madvise calls, which also split its
 // mapping in three, that each reservation made before.
+
+#include <execinfo.h>
+#include <x86intrin.h>
+// DIAGNOSTIC ONLY (not for commit): logs each arena mapping with its call stack and the TSC.
+static void arena_diag_log(const void* mapping, uint64_t bytes)
+{
+    const char* path = getenv("BUSTER_ARENA_LOG");
+    FILE* log = path != 0 ? fopen(path, "a") : 0;
+    if (log != 0)
+    {
+        extern char __executable_start;
+        void* frames[14];
+        const int n = backtrace(frames, 14);
+        fprintf(log, "map %llu %p %llu %p", (unsigned long long)__rdtsc(), mapping, (unsigned long long)bytes, (void*)&__executable_start);
+        for (int i = 1; i < n; i += 1)
+        {
+            fprintf(log, " %p", frames[i]);
+        }
+        fprintf(log, "\n");
+        fclose(log);
+    }
+}
 static Arena arena_reserve_policy(uint64_t capacity, uint64_t small, bool bounded)
