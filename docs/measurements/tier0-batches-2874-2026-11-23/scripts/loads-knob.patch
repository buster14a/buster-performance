+// EXPERIMENT (#2874): which gathers are eight loads (bit 0 selection's slot words, bit 1 the homes past 32 locals, bit 2
+// measuring's case words), from BUSTER_TIER0_LOADS.
+static uint32_t tier0_knob_loads = 0;
+static __attribute__((constructor)) void tier0_knobs_read(void)
+{
+    const char* loads = getenv("BUSTER_TIER0_LOADS");
+    tier0_knob_loads = loads != 0 ? (uint32_t)atoi(loads) : 0;
+}
+
+// Eight quadwords of `table`, each at its dword of `index` (every index within the table), by eight loads put together
+// in registers: the 9700X runs a gather of eight as about 40 microcoded uops (#2874).
+static inline __attribute__((always_inline)) __m512i tier0_load_qwords(const void* table, __m256i index)
+{
+    uint32_t at[8];
+    _mm256_storeu_si256((__m256i*)at, index);
+    const uint8_t* base = table;
+    const __m128i q0 = _mm_loadl_epi64((const __m128i*)(base + 8 * (uint64_t)at[0]));
+    const __m128i q1 = _mm_loadl_epi64((const __m128i*)(base + 8 * (uint64_t)at[1]));
+    const __m128i q2 = _mm_loadl_epi64((const __m128i*)(base + 8 * (uint64_t)at[2]));
+    const __m128i q3 = _mm_loadl_epi64((const __m128i*)(base + 8 * (uint64_t)at[3]));
+    const __m128i q4 = _mm_loadl_epi64((const __m128i*)(base + 8 * (uint64_t)at[4]));
+    const __m128i q5 = _mm_loadl_epi64((const __m128i*)(base + 8 * (uint64_t)at[5]));
+    const __m128i q6 = _mm_loadl_epi64((const __m128i*)(base + 8 * (uint64_t)at[6]));
+    const __m128i q7 = _mm_loadl_epi64((const __m128i*)(base + 8 * (uint64_t)at[7]));
+    const __m256i low = _mm256_inserti128_si256(_mm256_castsi128_si256(_mm_unpacklo_epi64(q0, q1)), _mm_unpacklo_epi64(q2, q3), 1);
+    const __m256i high = _mm256_inserti128_si256(_mm256_castsi128_si256(_mm_unpacklo_epi64(q4, q5)), _mm_unpacklo_epi64(q6, q7), 1);
+    return _mm512_inserti64x4(_mm512_castsi256_si512(low), high, 1);
+}
