+                parents[operands[k]] = c;
+                slots[operands[k]] = (uint8_t)k;
+            }
+        }
+        if (node_machine_record_op(machine, c) == CHECK_OP_CALL)
+        {
+            for (uint32_t i = 0; i < node_machine_record_argument_count(machine, c); i += 1)
+            {
+                const uint32_t argument = node_machine_record_argument(machine, c, i);
+                if (argument < c)
