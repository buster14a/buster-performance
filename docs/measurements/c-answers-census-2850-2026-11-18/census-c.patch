+               right < r ? (uint32_t)node_machine_record_op(machine, right) : 255u, right < r ? columns->words[right] : 0u, right < r ? columns->standings[right] : 0u,
+               right < r ? columns->value_flags[right] : 0u, right < r ? columns->exponents[right] : 0u, third < r ? (uint32_t)node_machine_record_op(machine, third) : 255u,
