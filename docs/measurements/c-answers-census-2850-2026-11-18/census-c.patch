+               census_c_word(machine, given), given_flags, sibling < count ? (uint32_t)node_machine_record_op(machine, sibling) : 255u, sibling < count ? columns->words[sibling] : 0u,
+               sibling < count ? columns->standings[sibling] : 0u, sibling < count ? columns->value_flags[sibling] : 0u, sibling < count ? columns->exponents[sibling] : 0u);
+        printf(" lob=%x ro=%x caop=%u cast=%x cafl=%x caex=%x", left_object_bits, rooted ? census_c_object_bits(machine, root_object) : 0u,
