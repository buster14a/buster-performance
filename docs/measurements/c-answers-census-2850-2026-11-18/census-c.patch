+               refusal, stopped, (uint32_t)op, columns->words[r], columns->standings[r], columns->value_flags[r], columns->exponents[r], object_bits, truth_bits, member_odd,
+               arguments, direct, census_c_word(machine, node_machine_record_converted(machine, r, 0)), census_c_word(machine, node_machine_record_converted(machine, r, 1)),
