+        const TypeId target = node_machine_record_target(machine, r);
+        const TypeId parent_target = rooted ? root_target : node_machine_record_target(machine, parent);
+        const uint32_t left = node_machine_record_left(machine, r);
+        const uint32_t right = node_machine_record_right(machine, r);
