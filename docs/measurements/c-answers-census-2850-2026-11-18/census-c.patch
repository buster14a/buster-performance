+static uint32_t census_c_word(const NodeMachine* machine, TypeId type)
+{
+    return type != 0 ? node_machine_word(machine, type) : 0u;
+}
+
+static uint32_t census_c_object_bits(const NodeMachine* machine, uint32_t object)
+{
+    const bool known = object != 0 && object < machine->object_count;
+    return (object != 0 ? 1u : 0u) | (known ? 2u : 0u) | (known && node_machine_local(machine, object) ? 4u : 0u) |
+           (known && check_input_bit(machine->declaration_bits, object - 1, BUSTER_CHECK_BITS_COMPOUND) ? 8u : 0u) |
+           (known && check_input_bit(machine->declaration_bits, object - 1, BUSTER_CHECK_BITS_STATIC) ? 16u : 0u) |
+           (known && check_input_bit(machine->declaration_bits, object - 1, BUSTER_CHECK_BITS_REGISTER) ? 32u : 0u);
+}
