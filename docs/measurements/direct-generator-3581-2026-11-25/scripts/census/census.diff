+        fprintf(f, "shapes %u distinct, %llu longer than 32; expr ticks %llu; top 120 by ticks (count ticks/expr cum-ticks%%):\n", n, (unsigned long long)dcen.shape_long, (unsigned long long)dcen.expr_ticks);
