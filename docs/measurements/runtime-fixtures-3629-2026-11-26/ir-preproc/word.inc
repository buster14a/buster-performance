static bool ir_parse_test_word(const char* text)
{
    const size_t length = strlen(text);
    bool word = length != 0 && length <= 128;
    for (size_t i = 0; word && i < length; i += 1)
    {
        const char c = text[i];
        word = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '.' || c == '_' || c == '-';
    }
    return word;
}
