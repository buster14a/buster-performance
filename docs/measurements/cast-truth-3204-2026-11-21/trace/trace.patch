diff --git a/src/buster/compiler/c_check_node_machine_window.c b/src/buster/compiler/c_check_node_machine_window.c
index 9d4f76878..9f86b5d2f 100644
--- a/src/buster/compiler/c_check_node_machine_window.c
+++ b/src/buster/compiler/c_check_node_machine_window.c
@@ -496,6 +496,7 @@ struct NodeContextsLoopCounts
 // where no register lives across it but a mask's, and the far lanes' bytes go through a block of the frame, which
 // aligns the frame to 64 bytes for whatever is spilled all the same. It starts at a cache line's first byte, as the
 // fact words' kernel does (node_facts_window), so that a build's layout doesn't move its ticks.
+static uint32_t trace_token = UINT32_MAX;
 static __attribute__((noinline, aligned(64))) void node_contexts_window_loop(struct NodeFactsReader* state, const NodeFront* front, uint32_t count, NodeContextsLoopCounts* counts)
 {
     const NodeContextsTables* tables = state->c_tables;
@@ -966,6 +967,16 @@ static __attribute__((noinline, aligned(64))) void node_contexts_window_loop(str
         passed_count += (uint64_t)_mm_popcnt_u64(passes_truth);
         const __mmask64 listed = placed & (is_uncased | (is_wrap & union_type) | divisor | wide | odd_leaf | (is_call & ~converted_call) | (called & ~is_value) |
                                            (update_asked & ~made_update) | unbranched | (is_conditional & ~open_conditional) | uncommaed | passes_truth);
+        for (uint64_t bits = passes_truth; bits; bits &= bits - 1)
+        {
+            const uint32_t lane = (uint32_t)__builtin_ctzll(bits);
+            const uint32_t at = x + lane;
+            const uint64_t bit = UINT64_C(1) << lane;
+            trace_token = front->tokens[at];
+            fprintf(stderr, "cast mask token=%u at=%u op=%u placed=%u other-reason=%u\n", trace_token, at, front->ops[at], (placed & bit) != 0,
+                    ((is_uncased | (is_wrap & union_type) | divisor | wide | odd_leaf | (is_call & ~converted_call) | (called & ~is_value) |
+                      (update_asked & ~made_update) | unbranched | (is_conditional & ~open_conditional) | uncommaed) & bit) != 0);
+        }
         // A template's number is four bits: each bit's records, one mask a bit. A comma's is a wrapper's.
         const __mmask64 passed = made_pass | made_comma;
         const __mmask64 bit0 = made_constant | made_global | made_dereference | made_unary | made_binary | made_store_local | made_store;
@@ -1215,6 +1226,31 @@ static __attribute__((noinline)) void node_contexts_window_part(struct NodeFacts
             }
             verdict = (uint8_t)(listed || sunk ? BUSTER_NODE_CONTEXTS_LISTED : refused ? BUSTER_NODE_CONTEXTS_REFUSED : BUSTER_NODE_CONTEXTS_TAKEN);
         }
+        if (trace_token != UINT32_MAX)
+        {
+            const uint32_t operand = state->operands[e];
+            const uint32_t size = front->sizes[operand];
+            const uint32_t first = operand + 1 - size;
+            bool traced = false;
+            for (uint32_t r = 0; r < state->counts[e]; r += 1)
+            {
+                const uint32_t pos = r < size ? first + r : state->records[e];
+                traced |= front->tokens[pos] == trace_token;
+            }
+            if (traced)
+            {
+                fprintf(stderr, "cast expression e=%u placed=%u reference=%u verdict=%u size=%u\n", e, state->placed[e], state->c_ran[e], verdict, size);
+                for (uint32_t r = 0; r < state->counts[e]; r += 1)
+                {
+                    const uint32_t pos = r < size ? first + r : state->records[e];
+                    const uint64_t listed_bit = state->window_c_masks[BUSTER_NODE_CONTEXTS_MASKS * (uint64_t)(pos / 64) + BUSTER_NODE_CONTEXTS_MASK_LISTED];
+                    if (listed_bit & (UINT64_C(1) << (pos & 63)))
+                    {
+                        fprintf(stderr, "listed token=%u at=%u op=%u reason=%u\n", front->tokens[pos], pos, front->ops[pos], node_contexts_window_reason(state, pos));
+                    }
+                }
+            }
+        }
         state->c_verdicts[e] = verdict;
     }
 }
