     {
         foreign_unwind_test_successes(&tally, &arena);
         foreign_unwind_test_failures(&tally, &arena);
+        foreign_unwind_test_order_errors(&tally, &arena);
     }
     arena_release(&arena);
     return foreign_test_report(&tally);
