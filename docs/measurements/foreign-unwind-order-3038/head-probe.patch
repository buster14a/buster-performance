+static uint32_t probe_owner_at(const ForeignUnwind* output, uint64_t offset, uint64_t* calls, uint64_t* comparisons)
+{
+    *calls += 1;
+    uint32_t low = 0;
+    uint32_t high = output->record_count;
+    while (low < high)
+    {
+        const uint32_t middle = low + (high - low) / 2;
+        const ForeignUnwindRecord* record = &output->records[middle];
+        *comparisons += 1;
+        if (record->old_offset + record->length <= offset)
+        {
+            low = middle + 1;
+        }
+        else
+        {
+            high = middle;
+        }
+    }
+    return low;
+}
+
+static uint32_t* probe_sort(const String8 entries, uint32_t* order, uint32_t* spare, uint64_t n, uint64_t* passes, uint64_t* comparisons)
+{
+    uint32_t* from = order;
+    uint32_t* to = spare;
+    for (uint64_t width = 1; width < n; width *= 2)
+    {
+        *passes += 1;
+        for (uint64_t start = 0; start < n; start += 2 * width)
+        {
+            const uint64_t middle = start + width < n ? start + width : n;
+            const uint64_t end = start + 2 * width < n ? start + 2 * width : n;
+            uint64_t left = start;
+            uint64_t right = middle;
+            for (uint64_t out = start; out < end; out += 1)
+            {
+                bool take_left = left < middle;
+                if (take_left && right < end)
+                {
+                    Elf64_Rela a;
+                    Elf64_Rela b;
+                    memcpy(&a, entries.pointer + (uint64_t)from[left] * sizeof(Elf64_Rela), sizeof(a));
+                    memcpy(&b, entries.pointer + (uint64_t)from[right] * sizeof(Elf64_Rela), sizeof(b));
+                    *comparisons += 1;
+                    take_left = a.r_offset <= b.r_offset;
+                }
+                to[out] = take_left ? from[left] : from[right];
+                left += take_left ? 1 : 0;
+                right += take_left ? 0 : 1;
+            }
+        }
+        uint32_t* swap = from;
+        from = to;
+        to = swap;
+    }
+    return from;
+}
