+
+static inline uint32_t node_machine_object(const NodeMachine* machine, uint32_t r)
+{
+    return machine->objects[r];
+}
+
+static inline CheckCategory node_machine_category(const NodeMachine* machine, uint32_t r)
+{
+    return (CheckCategory)(machine->standings[r] & 0x03u);
