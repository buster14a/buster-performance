+
+// An integer's low 64 bits.
+static inline uint64_t node_machine_integer(const NodeMachine* machine, uint32_t r)
+{
+    const CheckValue* wide = node_machine_wide(machine, r);
+    return wide != NULL ? (uint64_t)wide->integer : (machine->standings[r] & BUSTER_NODE_MACHINE_FIELD) == 0 ? machine->payloads[r] : 0;
+}
+
+static inline int64_t node_machine_offset(const NodeMachine* machine, uint32_t r)
