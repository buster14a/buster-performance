     stage_clock->initial_peak_kb = stage_clock->peak_kb;
@@ -311,6 +322,22 @@ static inline void check_clock_lap(CheckClock* stage_clock, CheckStage stage)
         const uint64_t now = __rdtsc();
         stage_clock->ticks[stage] += now - stage_clock->last;
         stage_clock->last = now;
+        const uint32_t count = stage_clock->lap_count;
+        const bool same = count != 0 && stage_clock->lap_stages[count - 1] == (uint8_t)stage;
+        if (same)
+        {
+            stage_clock->lap_ticks[count - 1] = now;
+        }
+        else if (count < BUSTER_CHECK_CLOCK_LAPS && stage_clock->lap_ticks != NULL && stage_clock->lap_stages != NULL)
+        {
+            stage_clock->lap_ticks[count] = now;
+            stage_clock->lap_stages[count] = (uint8_t)stage;
+            stage_clock->lap_count = count + 1;
+        }
+        else
+        {
+            stage_clock->laps_dropped += 1;
+        }
     }
 }
 
