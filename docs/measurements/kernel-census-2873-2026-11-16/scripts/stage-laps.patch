 };
 
+#define BUSTER_CHECK_CLOCK_LAPS (1u << 17)
+
 // The expressions' walk's parts, as CheckInput.expression_part_ticks holds them (BUSTER_CHECK_EXPRESSION_PART_*).
 static const char* const check_clock_walk_parts[BUSTER_CHECK_CLOCK_WALK_PARTS] __attribute__((unused)) = { "classes", "prepare", "actions", "visits" };
 
@@ -295,6 +304,8 @@ static bool check_clock_usage(uint64_t* system_us, uint64_t* minor_faults, bool*
 static void check_clock_start(CheckClock* stage_clock)
 {
     *stage_clock = (CheckClock){ 0 };
+    stage_clock->lap_ticks = malloc(BUSTER_CHECK_CLOCK_LAPS * sizeof(uint64_t));
+    stage_clock->lap_stages = malloc(BUSTER_CHECK_CLOCK_LAPS);
     stage_clock->peak_available = check_clock_usage(&stage_clock->system_us, &stage_clock->minor_faults, &stage_clock->usage_available,
