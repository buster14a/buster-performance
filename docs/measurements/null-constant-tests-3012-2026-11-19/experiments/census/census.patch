diff --git a/src/buster/compiler/c_check_node_machine_type.c b/src/buster/compiler/c_check_node_machine_type.c
index ed32a7a51..2bfd04a3a 100644
--- a/src/buster/compiler/c_check_node_machine_type.c
+++ b/src/buster/compiler/c_check_node_machine_type.c
@@ -407,6 +407,33 @@ static inline __attribute__((always_inline)) void node_machine_record(NodeMachin
 
 // Record `r`'s value from `value`: into its columns where they hold it whole (node_machine_record_value gives it back
 // field for field: node_machine_whole), and else into `wides`.
+// EXPERIMENT (#3014's census): what node_machine_put_value is given, by its constant kind and by which of its storages
+// are no zero.
+static uint64_t node_x_fields[8][2][2][2][2];
+__attribute__((destructor)) static void node_x_fields_print(void)
+{
+    for (uint32_t kind = 0; kind < 8; kind += 1)
+    {
+        for (uint32_t rare = 0; rare < 2; rare += 1)
+        {
+            for (uint32_t floating = 0; floating < 2; floating += 1)
+            {
+                for (uint32_t offset = 0; offset < 2; offset += 1)
+                {
+                    for (uint32_t integer = 0; integer < 2; integer += 1)
+                    {
+                        const uint64_t count = node_x_fields[kind][rare][floating][offset][integer];
+                        if (count != 0)
+                        {
+                            fprintf(stderr, "XFIELDS kind=%u integer=%u offset=%u floating=%u rare=%u count=%llu\n", kind, integer, offset, floating, rare, (unsigned long long)count);
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
 static void node_machine_put_value(NodeMachine* machine, uint32_t r, const CheckValue* value)
 {
     NodeMachineColumns* columns = machine->columns;
@@ -420,6 +447,7 @@ static void node_machine_put_value(NodeMachine* machine, uint32_t r, const Check
     const bool rare = high != 0 || value->imaginary_storage[0] != 0 || (value->imaginary_storage[1] & 0xffffu) != 0 || value->overload_head != 0 ||
                       value->bit_width != 0 || value->fault != CHECK_FAULT_NONE || value->fault_node != 0 || value->object_bit_offset != 0 ||
                       (uint32_t)value->category > 0x03u || (uint32_t)kind > 0x07u;
+    node_x_fields[(uint32_t)kind & 7u][rare ? 1 : 0][floating ? 1 : 0][offset != 0 ? 1 : 0][low != 0 ? 1 : 0] += 1;
     const bool whole = !rare && node_machine_whole(kind, low, offset, floating);
     columns->value_types[r] = value->type;
     columns->value_flags[r] = value->flags;
