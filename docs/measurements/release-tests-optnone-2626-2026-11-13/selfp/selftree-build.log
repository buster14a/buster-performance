          echo "$(date +%s) $used" >> "$OUT/memory.txt"
          sleep 1
      done
      echo "start $start MiB, peak $peak MiB, peak over start $((peak - start)) MiB" > "$OUT/memory-peak.txt" ) &
    TIMEFORMAT="wall %R user %U system %S"
