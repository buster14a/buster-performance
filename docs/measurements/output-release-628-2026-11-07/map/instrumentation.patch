+static void poison_handler(int sig, siginfo_t* info, void* context)
+{
+    (void)sig;
+    const ucontext_t* uc = context;
+    char line[160];
+    const int n = snprintf(line, sizeof(line), "poison-fault addr %p rip 0x%llx\n", info->si_addr, (unsigned long long)uc->uc_mcontext.gregs[16]);
+    write(2, line, (size_t)n);
+    void* frames[12];
+    const int depth = backtrace(frames, 12);
+    backtrace_symbols_fd(frames, depth, 2);
+    _exit(99);
+}
+static void poison_install(void)
+{
+    struct sigaction action = { 0 };
+    action.sa_sigaction = poison_handler;
+    action.sa_flags = SA_SIGINFO;
+    sigaction(SIGSEGV, &action, NULL);
