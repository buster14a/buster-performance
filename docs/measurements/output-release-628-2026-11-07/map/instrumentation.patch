+#include <fcntl.h>
+__attribute__((weak)) void peak_dump(const char* where);
+__attribute__((weak)) void peak_dump(const char* where)
+{
+    if (getenv("BUSTER_PEAK_MAP") == NULL) return;
+    FILE* out = fopen(getenv("BUSTER_PEAK_MAP"), "a");
+    if (out == NULL) return;
+    char line[512];
+    FILE* status = fopen("/proc/self/status", "r");
+    while (status != NULL && fgets(line, sizeof(line), status)) if (strncmp(line, "VmHWM", 5) == 0 || strncmp(line, "VmRSS", 5) == 0) fprintf(out, "%s %s", where, line);
+    if (status) fclose(status);
+    if (strncmp(where, "rss:", 4) == 0) { fclose(out); return; }
+    FILE* smaps = fopen("/proc/self/smaps", "r");
+    char range[128] = { 0 };
+    while (smaps != NULL && fgets(line, sizeof(line), smaps))
+    {
+        unsigned long a, b;
+        if (sscanf(line, "%lx-%lx", &a, &b) == 2 && strchr(line, ':') != NULL && line[0] != ' ' && !strncmp(line + strcspn(line, " "), " ", 1)) { snprintf(range, sizeof(range), "%lx-%lx", a, b); }
+        unsigned long kb;
+        if (sscanf(line, "Rss: %lu kB", &kb) == 1 && kb >= 512) fprintf(out, "map %s rss %lu\n", range, kb);
+        if (sscanf(line, "AnonHugePages: %lu kB", &kb) == 1 && kb >= 2048) fprintf(out, "map %s huge %lu\n", range, kb);
+    }
+    if (smaps) fclose(smaps);
+    int pm = open("/proc/self/pagemap", O_RDONLY);
+    // latest push wins each page: walk from the last to the first, skipping pages already claimed.
+    static uintptr_t claimed_begin[65536];
+    static uintptr_t claimed_end[65536];
+    uint32_t claimed = 0;
+    for (int64_t i = (int64_t)(peak_push_count < 65536 ? peak_push_count : 65536) - 1; i >= 0; i -= 1)
+    {
+        const PeakPush* p = peak_pushes + i;
+        uintptr_t first = p->begin & ~(uintptr_t)4095;
+        uintptr_t last = (p->begin + p->bytes + 4095) & ~(uintptr_t)4095;
+        uint64_t present = 0, pages = 0;
+        for (uintptr_t page = first; page < last; page += 4096)
+        {
+            bool taken = false;
+            for (uint32_t c = 0; c < claimed && !taken; c += 1) taken = page >= claimed_begin[c] && page < claimed_end[c];
+            if (taken) continue;
+            pages += 1;
+            uint64_t entry = 0;
+            if (pread(pm, &entry, 8, (off_t)(page / 4096 * 8)) == 8 && (entry >> 63) != 0) present += 1;
+        }
+        if (claimed < 65536) { claimed_begin[claimed] = first; claimed_end[claimed] = last; claimed += 1; }
+        if (present == 0) continue;
+        fprintf(out, "push %ld %lx bytes %lu own_pages %lu present_kb %lu frames", (long)i, (unsigned long)p->begin, (unsigned long)p->bytes, (unsigned long)pages, (unsigned long)present * 4);
+        for (int f = 0; f < p->depth; f += 1) fprintf(out, " %p", p->frames[f]);
+        fprintf(out, "\n");
+    }
+    close(pm);
+    fprintf(out, "end %s\n", where);
+    fclose(out);
+}
