diff --git a/src/buster/compiler/pp_image_census.h b/src/buster/compiler/pp_image_census.h
new file mode 100644
index 000000000..48040376d
--- /dev/null
+++ b/src/buster/compiler/pp_image_census.h
@@ -0,0 +1,281 @@
+// Experiment for buster#3070/#3212. A single serial process owns the dictionary and one active segment.
+#include <search.h>
+
+#define BUSTER_PP_CENSUS_MACRO_STACK 64u
+#define BUSTER_PP_CENSUS_LINE_NOTE 128u
+
+// Keep the original low five context bits readable in the version 2 trace.
+static const uint8_t pp_census_builtin_context[PP_BUILTIN_POISONED + 1] =
+{
+    [PP_BUILTIN_COUNTER] = 1,
+    [PP_BUILTIN_INCLUDE_LEVEL] = 2,
+    [PP_BUILTIN_BASE_FILE] = 4,
+    [PP_BUILTIN_DATE] = 8,
+    [PP_BUILTIN_TIME] = 8,
+    [PP_BUILTIN_TIMESTAMP] = 16,
+    [PP_BUILTIN_FILE] = 32,
+    [PP_BUILTIN_FILE_NAME] = 32,
+    [PP_BUILTIN_LINE] = 32,
+};
+
+typedef struct PPCensusBytes
+{
+    size_t size;
+    const void* data;
+    uint32_t id;
+} PPCensusBytes;
+
+typedef struct PPCensusPair
+{
+    uint32_t first;
+    uint32_t second;
+} PPCensusPair;
+
+typedef struct PPCensusPairs
+{
+    PPCensusPair* data;
+    uint32_t count;
+    uint32_t capacity;
+} PPCensusPairs;
+
+static struct
+{
+    FILE* stream;
+    void* dictionary;
+    uint32_t next_id;
+    bool checked;
+    bool active;
+    bool in_walk;
+    uint32_t walk;
+    uint32_t stamp;
+    uint32_t* marks;
+    uint32_t mark_capacity;
+    PPCensusPairs reads;
+    PPCensusPairs writes;
+    PPCensusPairs output;
+    uint32_t depth;
+    uint64_t device;
+    uint64_t inode;
+    uint32_t start;
+    uint32_t output_begin;
+    uint32_t dynamic;
+} pp_census;
+
+static void pp_census_fail(const char* why)
+{
+    fprintf(stderr, "header image census: %s\n", why);
+    exit(EXIT_FAILURE);
+}
+
+static int pp_census_compare(const void* left, const void* right)
+{
+    const PPCensusBytes* a = left;
+    const PPCensusBytes* b = right;
+    int order = (a->size > b->size) - (a->size < b->size);
+    if (order == 0 && a->size != 0)
+    {
+        order = memcmp(a->data, b->data, a->size);
+    }
+    return order;
+}
+
+// Equality of IDs means equality of the *entire* byte sequences within this process.
+static uint32_t pp_census_id(const void* data, size_t size)
+{
+    const PPCensusBytes key = { .size = size, .data = data };
+    PPCensusBytes* const* slot = tfind(&key, &pp_census.dictionary, pp_census_compare);
+    if (slot == NULL)
+    {
+        if (size > SIZE_MAX - sizeof(PPCensusBytes) || pp_census.next_id == UINT32_MAX)
+        {
+            pp_census_fail("dictionary limit");
+        }
+        PPCensusBytes* entry = malloc(sizeof(*entry) + size);
+        if (entry == NULL)
+        {
+            pp_census_fail("cannot grow dictionary");
+        }
+        *entry = (PPCensusBytes){ .size = size, .data = entry + 1, .id = ++pp_census.next_id };
+        if (size != 0)
+        {
+            memcpy(entry + 1, data, size);
+        }
+        slot = tsearch(entry, &pp_census.dictionary, pp_census_compare);
+        if (slot == NULL)
+        {
+            pp_census_fail("cannot index dictionary entry");
+        }
+    }
+    return (*slot)->id;
+}
+
+static void* pp_census_array(void* data, uint32_t* capacity, uint32_t index, size_t width)
+{
+    if (index >= *capacity)
+    {
+        uint64_t room = 2ull * ((uint64_t)index + 1);
+        if (room > UINT32_MAX)
+        {
+            pp_census_fail("segment too large");
+        }
+        data = reallocarray(data, room, width);
+        if (data == NULL)
+        {
+            pp_census_fail("cannot grow segment");
+        }
+        memset((char*)data + *capacity * width, 0, (room - *capacity) * width);
+        *capacity = (uint32_t)room;
+    }
+    return data;
+}
+
+static void pp_census_append(PPCensusPairs* pairs, uint32_t first, uint32_t second)
+{
+    pairs->data = pp_census_array(pairs->data, &pairs->capacity, pairs->count, sizeof(*pairs->data));
+    pairs->data[pairs->count++] = (PPCensusPair){ .first = first, .second = second };
+}
+
+static uint32_t pp_census_sequence(const PPCensusPairs* pairs)
+{
+    _Static_assert(sizeof(PPCensusPair) == 2 * sizeof(uint32_t), "sequence has no padding");
+    return pp_census_id(pairs->data, pairs->count * sizeof(*pairs->data));
+}
+
+static bool pp_census_on(void)
+{
+    if (!pp_census.checked)
+    {
+        pp_census.checked = true;
+        const char* path = getenv("BUSTER_PP_IMAGE_CENSUS_FILE");
+        if (path != NULL)
+        {
+            pp_census.stream = fopen(path, "w");
+            if (pp_census.stream == NULL || fputs("V\t2\n", pp_census.stream) == EOF)
+            {
+                pp_census_fail("cannot open trace");
+            }
+        }
+    }
+    return pp_census.stream != NULL;
+}
+
+static uint32_t pp_census_definition(const Preprocessor* pp, IdentId name)
+{
+    uint32_t result = 0; // undefined
+    if ((pp->is_macro[name / 64] >> (name % 64)) & 1)
+    {
+        const PPMacro* macro = &pp->macros[pp->macro_of[name]];
+        uint32_t fields[] = { macro->flags, macro->builtin, macro->parameter_count, 0, 0 };
+        if (macro->builtin == 0)
+        {
+            const uint32_t first = (macro->flags & BUSTER_PP_MACRO_FUNCTION) ? macro->parameters_begin : macro->body_begin;
+            fields[3] = macro->body_begin - first;
+            if (first < macro->body_end)
+            {
+                const PPFileData* d = &pp->datas[macro->data];
+                const uint32_t last = macro->body_end - 1;
+                const uint32_t from = d->starts[first];
+                const uint32_t end = (d->kinds[last] & 0x7f) == C_TOKEN_RAW_IDENTIFIER ?
+                    pp_identifier_end(pp, d->bytes, d->length, d->starts[last]) : d->values[last];
+                fields[4] = pp_census_id(d->bytes + from, end - from);
+            }
+        }
+        result = pp_census_id(fields, sizeof(fields));
+    }
+    return result;
+}
+
+static void pp_census_macro(const Preprocessor* pp, IdentId name, bool write)
+{
+    pp_census.marks = pp_census_array(pp_census.marks, &pp_census.mark_capacity, name, sizeof(*pp_census.marks));
+    if (write || pp_census.marks[name] != pp_census.stamp)
+    {
+        pp_census.marks[name] = pp_census.stamp;
+        const uint32_t spelling = pp_census_id(intern_bytes(pp->table, name), intern_length(pp->table, name));
+        pp_census_append(write ? &pp_census.writes : &pp_census.reads, spelling, pp_census_definition(pp, name));
+    }
+}
+
+static void pp_census_end(Preprocessor* pp)
+{
+    if (pp_census.active)
+    {
+        Scratch scratch = scratch_begin(0);
+        uint32_t pragma = BUSTER_PP_PRAGMA_OUTSIDE;
+        for (uint32_t i = pp_census.output_begin; i < pp->output.count; i += 1)
+        {
+            const uint8_t kind = pp->output.kinds[i];
+            const uint32_t value = pp->output.values[i];
+            const uint32_t location = pp->output.locations[i];
+            const bool named = kind == C_TOKEN_RAW_IDENTIFIER || (kind >= BUSTER_PP_KIND_KEYWORD && kind < BUSTER_PP_KIND_KEYWORD + C_NAME_KEYWORD_COUNT);
+            const uint64_t mark = scratch.arena->length;
+            const uint8_t* spelling = NULL;
+            uint32_t length = 0;
+            if (named && pragma == BUSTER_PP_PRAGMA_TOKENS)
+            {
+                length = pp_written_spelling(pp, value, location, scratch.arena, &spelling);
+                if (spelling == NULL)
+                {
+                    pp_census_fail("cannot spell pragma identifier");
+                }
+            }
+            else if (kind == BUSTER_PP_KIND_EMBED)
+            {
+                const PPEmbed* embed = &pp->embeds[value];
+                spelling = pp->datas[embed->data].bytes + embed->offset;
+                length = embed->length;
+            }
+            else if (kind != BUSTER_PP_KIND_PRAGMA_END)
+            {
+                const size_t room = named || kind == BUSTER_PP_KIND_INTEGER ? 24 : (size_t)(value - location) + 1;
+                uint8_t* buffer = arena_push(scratch.arena, room, 1);
+                if (buffer == NULL)
+                {
+                    pp_census_fail("cannot spell token");
+                }
+                length = pp_spelling(pp, kind, value, location, buffer, &spelling);
+            }
+            pp_census_append(&pp_census.output, kind | ((uint32_t)pp->output.flags[i] << 8), pp_census_id(spelling, length));
+            pragma = pp_pragma_state(pp, pragma, kind, location);
+            arena_pop_to(scratch.arena, mark);
+        }
+        scratch_end(scratch);
+        fprintf(pp_census.stream, "S\t%u\t%u\t%llu:%llu\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t", pp_census.walk, pp_census.depth,
+                (unsigned long long)pp_census.device, (unsigned long long)pp_census.inode, pp_census.start, pp_census.output.count,
+                pp_census_sequence(&pp_census.output), pp_census.dynamic, pp_census.writes.count, pp_census_sequence(&pp_census.writes), pp_census.reads.count);
+        for (uint32_t i = 0; i < pp_census.reads.count; i += 1)
+        {
+            const PPCensusPair read = pp_census.reads.data[i];
+            fprintf(pp_census.stream, "%s%u:%u", i == 0 ? "" : ",", read.first, read.second);
+        }
+        fputc('\n', pp_census.stream);
+        pp_census.active = false;
+    }
+}
+
+static void pp_census_begin(const Preprocessor* pp, const PPContext* context)
+{
+    if (pp_census.in_walk && context != 0 && context->kind == BUSTER_PP_CONTEXT_FILE)
+    {
+        const PPFileData* d = &pp->datas[context->data];
+        pp_census.active = true;
+        if (++pp_census.stamp == 0)
+        {
+            pp_census_fail("segment counter overflow");
+        }
+        pp_census.reads.count = 0;
+        pp_census.writes.count = 0;
+        pp_census.output.count = 0;
+        pp_census.dynamic = 0;
+        pp_census.device = d->device;
+        pp_census.inode = d->inode;
+        pp_census.start = context->position;
+        pp_census.output_begin = pp->output.count;
+        uint32_t depth = 0;
+        for (uint32_t c = 0; c < pp->context_count; c += 1)
+        {
+            depth += pp->contexts[c].kind == BUSTER_PP_CONTEXT_FILE;
+        }
+        pp_census.depth = depth;
+    }
+}
