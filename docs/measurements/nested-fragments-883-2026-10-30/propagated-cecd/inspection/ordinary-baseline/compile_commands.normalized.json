      "-Wall",
      "-Werror",
      "-D",
      "BUSTER_CLANG_DEFAULT_TARGET=\"x86_64-pc-linux-gnu\"",
      "-Wno-unused-function",
      "-Wno-psabi",
      "-O3",
      "--target=x86_64-pc-linux-gnu"
    ]
  }
]
