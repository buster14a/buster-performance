== Test the functions' lanes [8 CPUs]
./build/compiler test-check-lanes
== Test c-testsuite's programs end to end [4 CPUs]
./build/compiler test-c-testsuite --cross-check --clang /usr/bin/clang --jobs "$BUSTER_PARALLEL_CPUS" --subset tests/c-testsuite/subset.txt build/c-testsuite
== Test typed postorder checking and source fixtures [2 CPUs]
./build/compiler test-checker --seed 133
== Compare -c's functions and objects with clang -O0 -c's on frozen musl sources
unset CPATH C_INCLUDE_PATH
export SOURCE_DATE_EPOCH=1792454400
corpus=/var/lib/buster-9700x/corpora/preprocessor-391e729af658
musl="$corpus/libc/musl"
./build/compiler test-checker-corpus --clang /usr/bin/clang --symbols-minimum 354 --no-default-config --target=x86_64-linux-gnu -march=znver5 -std=c99 -ffreestanding -nostdinc -D_XOPEN_SOURCE=700 -Os -pipe \
  -I "$musl/arch/x86_64" -I "$musl/arch/generic" -I "$corpus/musl-generated/obj/src/internal" -I "$musl/src/include" -I "$musl/src/internal" -I "$corpus/musl-generated/obj/include" -I "$musl/include" \
  "$musl/src/math" "$musl/src/string" "$musl/src/stdlib" "$musl/src/fenv" "$musl/src/legacy" "$musl/src/process" "$musl/src/signal" "$musl/src/multibyte"
== Check semantic mutants of the frozen SQLite and musl sources against Clang
unset CPATH C_INCLUDE_PATH
export SOURCE_DATE_EPOCH=1792454400
corpus=/var/lib/buster-9700x/corpora/preprocessor-391e729af658
system=(-nostdinc -isystem "$corpus/headers/usr/lib/clang/23/include" -isystem "$corpus/headers/usr/local/include" -isystem "$corpus/headers/usr/include")
musl="$corpus/libc/musl"
./build/compiler test-checker-corpus --clang /usr/bin/clang --semantic-mutations 8 --seed 133 --minimize 0 --no-default-config --target=x86_64-linux-gnu -march=znver5 -std=gnu17 "${system[@]}" "$corpus/sqlite/sqlite3.c"
./build/compiler test-checker-corpus --clang /usr/bin/clang --semantic-mutations 96 --seed 133 --minimize 0 --no-default-config --target=x86_64-linux-gnu -march=znver5 -std=c99 -ffreestanding -nostdinc -D_XOPEN_SOURCE=700 -Os -pipe \
  -I "$musl/arch/x86_64" -I "$musl/arch/generic" -I "$corpus/musl-generated/obj/src/internal" -I "$musl/src/include" -I "$musl/src/internal" -I "$corpus/musl-generated/obj/include" -I "$musl/include" \
  --files-from tests/preprocessor-oracle/musl-subset.txt --root "$musl"
== Test GNU inline assembly's semantic fixtures against clang
./build/compiler test-checker-asm
== Test deferred function bodies against source order
./build/compiler test-checker-deferred
== Check c-testsuite's programs with their bodies read apart on 8 lanes
unset CPATH C_INCLUDE_PATH
./build/compiler test-checker-corpus --clang /usr/bin/clang --deferred 8 build/c-testsuite/tests/single-exec
== Test the semantic driver's diagnostics and emission against clang
./build/compiler test-checker-driver --executable ./build/compiler
== Test the semantic driver's diagnostics and emission against clang, with lazy system headers
./build/compiler test-checker-driver --executable ./build/compiler --lazy-system-headers
== Test the C driver's source rows and DWARF
./build/compiler test-check-debug --cross-check
== Check the frozen SQLite source against Clang
unset CPATH C_INCLUDE_PATH
export SOURCE_DATE_EPOCH=1792454400
corpus=/var/lib/buster-9700x/corpora/preprocessor-391e729af658
./build/compiler test-checker-corpus --clang /usr/bin/clang --deferred 8 --symbols --report build/checker-sqlite.tsv --no-default-config --target=x86_64-linux-gnu -march=znver5 -std=gnu17 -nostdinc -isystem "$corpus/headers/usr/lib/clang/23/include" -isystem "$corpus/headers/usr/local/include" -isystem "$corpus/headers/usr/include" "$corpus/sqlite/sqlite3.c"
== Compare source binding columns on the frozen SQLite input
corpus=/var/lib/buster-9700x/corpora/preprocessor-391e729af658
./build/compiler test-parser-bindings --clang -march=znver5 -nostdinc -isystem "$corpus/headers/usr/lib/clang/23/include" -isystem "$corpus/headers/usr/local/include" -isystem "$corpus/headers/usr/include" "$corpus/sqlite/sqlite3.c"
== Test C-source binding identities and scope semantics
./build/compiler test-parser-bindings --clang
== Test deferred-body source-position environments
./build/compiler test-environments
== Test scoped name-resolution kernels
./build/compiler test-bindings
