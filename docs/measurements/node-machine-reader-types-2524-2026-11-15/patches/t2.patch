+                   first, records, node_machine_refusal_names[refusal], node_machine_refusal_names[earlier < NODE_MACHINE_REFUSALS ? earlier : NODE_MACHINE_TAKEN],
+                   s->machine->stopped);
+        }
+    }
+    else
+    {
