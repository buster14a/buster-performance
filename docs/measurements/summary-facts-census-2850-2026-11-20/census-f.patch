diff --git a/src/buster/compiler/c_check_node_machine.c b/src/buster/compiler/c_check_node_machine.c
index 923278ef4..a2cecdf5c 100644
--- a/src/buster/compiler/c_check_node_machine.c
+++ b/src/buster/compiler/c_check_node_machine.c
@@ -73,6 +73,50 @@
 #ifndef BUSTER_C_CHECK_NODE_MACHINE_INCLUDED
 #define BUSTER_C_CHECK_NODE_MACHINE_INCLUDED
 
+// EXPERIMENT (the side facts' census, BUSTER_CENSUS_F=1; not for a commit): whether it is on, and the unit's roots the
+// window takes whole, in the order the reader met them.
+static int node_census_f_on = -1;
+static uint32_t* node_census_f_roots;
+static uint32_t node_census_f_count;
+static uint32_t node_census_f_capacity;
+static inline bool node_census_f(void)
+{
+    if (node_census_f_on < 0)
+    {
+        node_census_f_on = getenv("BUSTER_CENSUS_F") != NULL ? 1 : 0;
+    }
+    return node_census_f_on != 0;
+}
+static const CheckInput* node_census_f_input;
+static const Parser* node_census_f_parser;
+static const InternTable* node_census_f_table;
+static uint8_t check_program_return_library_search(const InternTable* identifiers, uint32_t name);
+// A call's callee's facts, as the return flow reads them of a direct call's declaration: 1 it is declared noreturn,
+// 2 its name is one of the library's the flow leaves unknown, 4 the callee is a name's leaf with a declaration.
+static inline uint32_t node_census_f_callee(uint32_t token)
+{
+    const CheckInput* input = node_census_f_input;
+    uint32_t facts = 0;
+    if (input != NULL && input->declarations != NULL && token < input->token_count)
+    {
+        const uint32_t declaration = input->declarations[token];
+        const bool function = declaration < input->token_count && input->declaration_kinds[declaration] == C_BINDING_FUNCTION && input->function_flags != NULL;
+        facts |= function ? 4u : 0u;
+        facts |= function && (input->function_flags[declaration] & CHECK_INPUT_FUNCTION_NORETURN) != 0 ? 1u : 0u;
+        facts |= function && node_census_f_table != NULL && check_program_return_library_search(node_census_f_table, node_census_f_parser->tokens.names[declaration]) != 0 ? 2u : 0u;
+    }
+    return facts;
+}
+static inline void node_census_f_root(uint32_t root)
+{
+    if (node_census_f_count == node_census_f_capacity)
+    {
+        node_census_f_capacity = node_census_f_capacity != 0 ? 2 * node_census_f_capacity : 65536;
+        node_census_f_roots = realloc(node_census_f_roots, (uint64_t)node_census_f_capacity * sizeof(uint32_t));
+    }
+    node_census_f_roots[node_census_f_count++] = root;
+}
+
 // The most records an expression the machine takes has (docs/node-machine.md, "The records and the tapes").
 #define BUSTER_NODE_MACHINE_MOST 4096u
 // The most entries one record's row writes: its own and its conversion's (BUSTER_CHECK_LOWER_TEMPLATE_MOST).
