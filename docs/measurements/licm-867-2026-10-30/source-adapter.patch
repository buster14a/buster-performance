+// Evidence-only adapter: prepare one original C loop through the normal checker,
+// typed lowering and SSA promotion before the existing public-pass timing begins.
+static bool ir_pass_benchmark_source(Arena* arena, IrFunction* f, const char* source)
+{
+    Arena lowered = arena_reserve(64ull << 20);
+    Arena table = arena_reserve(64ull << 20);
+    Arena output = arena_reserve(64ull << 20);
+    Arena twin = arena_reserve(64ull << 20);
+    Arena scratch = arena_reserve(128ull << 20);
+    IrSourceFile file = { 0 };
+    bool valid = lowered.base != 0 && table.base != 0 && output.base != 0 && twin.base != 0 && scratch.base != 0;
+    if (valid)
+    {
+        ir_source_prepare(&file, source, NULL, 0, &lowered, &table);
+        valid = file.status == IR_SOURCE_PREPARED && file.count == 1;
+    }
+    IrFunction input = { 0 };
+    IrFunction scalar = { 0 };
+    if (valid)
+    {
+        const IrSourceFunction* function = &file.functions[0];
+        valid = ir_lower_typed(function->function, function->result_type, function->symbol_count, &output, &scratch, &input).error == IR_OK;
+        valid = valid && ir_lower_typed_scalar(function->function, function->result_type, function->symbol_count, &twin, &scratch, &scalar).error == IR_OK;
+        valid = valid && ir_lower_test_equal(&input, &scalar) && input.parameter_count == 1;
+    }
+    if (valid)
+    {
+        valid = ssa_ir_promote(&input, arena, &scratch, f).error == IR_OK;
+    }
+    printf("licm-source file=%s prepared=%u functions=%u instructions=%u\n", source, valid, file.count, valid ? f->instruction_count : 0);
+    arena_release(&scratch);
+    arena_release(&twin);
+    arena_release(&output);
+    arena_release(&table);
+    arena_release(&lowered);
+    return valid;
+}
