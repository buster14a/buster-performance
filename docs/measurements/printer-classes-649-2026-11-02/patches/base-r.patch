diff -ruN clean/src/buster/compiler/c_preprocessor_benchmark.c base-r/src/buster/compiler/c_preprocessor_benchmark.c
--- a/src/buster/compiler/c_preprocessor_benchmark.c	2026-11-02 17:24:16.000000000 +0100
+++ b/src/buster/compiler/c_preprocessor_benchmark.c	2026-11-02 18:35:01.960719302 +0100
@@ -200,6 +200,25 @@
         const uint64_t printing = pp_benchmark_nanoseconds();
         result = result && null_stream != 0 && pp_print(&pp, null_stream, markers);
         sample->print_nanoseconds += pp_benchmark_nanoseconds() - printing;
+        {
+            static int repeat = -1;
+            if (repeat < 0)
+            {
+                const char* text = getenv("BUSTER_PP_PRINT_REPEAT");
+                repeat = text != 0 ? atoi(text) : 0;
+            }
+            for (int n = 0; result && n < repeat; n += 1)
+            {
+                const uint64_t t = pp_benchmark_nanoseconds();
+                const uint64_t cy = pp_benchmark_read_counter(cycles_fd);
+                const uint64_t in = pp_benchmark_read_counter(instructions_fd);
+                result = pp_print(&pp, null_stream, markers);
+                const uint64_t in2 = pp_benchmark_read_counter(instructions_fd);
+                const uint64_t cy2 = pp_benchmark_read_counter(cycles_fd);
+                fprintf(stderr, "repeat %.3f ms %.2f cycles/token %.2f instructions/token\n", (pp_benchmark_nanoseconds() - t) / 1e6,
+                        (double)(cy2 - cy) / pp.output.count, (double)(in2 - in) / pp.output.count);
+            }
+        }
         char* text = 0;
         size_t text_length = 0;
         FILE* memory = result && print_digest ? open_memstream(&text, &text_length) : 0;
