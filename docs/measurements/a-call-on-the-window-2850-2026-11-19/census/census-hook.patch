+// EXPERIMENT (not for a commit): a line per argument of each call T types, to BUSTER_CALL_CENSUS's file.
+#include <stdio.h>
+#include <stdlib.h>
+static FILE* node_machine_call_census_file;
+static int node_machine_call_census_asked;
+static __attribute__((noinline, cold)) void node_machine_call_census(NodeMachine* machine, uint32_t r, uint32_t node, uint32_t a, bool action)
+{
+    if (!node_machine_call_census_asked)
+    {
+        const char* path = getenv("BUSTER_CALL_CENSUS");
+        node_machine_call_census_file = path != NULL ? fopen(path, "a") : NULL;
+        node_machine_call_census_asked = 1;
+    }
+    FILE* file = node_machine_call_census_file;
+    if (file != NULL)
+    {
+        TypeTable* types = machine->types;
+        const NodeMachineColumns* columns = machine->columns;
+        const TypeId function = node_machine_callee_function(machine, a);
+        uint32_t parameters = 0;
+        const TypeId* parameter_types = function != 0 ? type_parameters(types, function, &parameters) : NULL;
+        const uint8_t function_flags = function != 0 ? types->types.flags[type_index(function)] : 0;
+        const uint32_t count = columns->argument_counts[r];
+        const uint32_t first = columns->argument_first[r];
+        const TypeId result = function != 0 ? type_return(types, function) : 0;
+        fprintf(file, "CALL %p %u %u at=%u count=%u parameters=%u flags=%x action=%d reader=%d direct=%u result=%x resultword=%x standing=%x calleeword=%x\n", (void*)machine->graph, node, r, machine->graph->source_positions != NULL ? machine->graph->source_positions[node] : 0, count, parameters,
+                function_flags, action, machine->program == NULL, node_machine_direct_callee(machine, a), result, node_machine_word(machine, result), columns->standings[r],
+                node_machine_word(machine, columns->value_types[a]));
+        for (uint32_t i = 0; i < count; i += 1)
+        {
+            const uint32_t g = machine->arguments[first + i];
+            const TypeId own = columns->value_types[g];
+            const TypeId parameter = i < parameters ? parameter_types[i] : 0;
+            const TypeId destination = parameter != 0 ? type_conversion_operand(types, parameter) : 0;
+            const CheckConversion conversion = machine->argument_conversions[first + i];
+            const TypeId plain = type_strip_aligned(types, own);
+            const uint8_t kind = type_kind(types, plain);
+            // The operand's value's type, as check_action_operand_value makes it (a new pointer type is not made here).
+            const TypeId value = type_kind_is_array(kind) || kind == BUSTER_TYPE_KIND_FUNCTION ? 0 : type_conversion_operand(types, own);
+            const TypeId promoted = value != 0 ? type_conversion_operand(types, type_default_argument_promote(types, value)) : 0;
+            const bool both_pointers = destination != 0 && value != 0 && check_action_kind(types, destination) == BUSTER_TYPE_KIND_POINTER && check_action_kind(types, value) == BUSTER_TYPE_KIND_POINTER;
+            const bool assignable = both_pointers && node_machine_pointer_assignable(machine, destination, value);
+            const bool arithmetic = destination != 0 && value != 0 && node_machine_arithmetic_assignable(machine, destination, value);
+            fprintf(file, "ARG %p %u %u i=%u record=%u own=%x ownword=%x standing=%x flags=%x exponent=%u parameter=%x parameterword=%x destination=%x destinationword=%x conversion=%x conversionword=%x conversionflags=%x "
+                          "value=%x promoted=%x pointers=%d assignable=%d arithmetic=%d kind=%u\n",
+                    (void*)machine->graph, node, r, i, g, own, columns->words[g], columns->standings[g], columns->value_flags[g], columns->exponents[g], parameter,
+                    parameter != 0 ? node_machine_word(machine, parameter) : 0, destination, destination != 0 ? node_machine_word(machine, destination) : 0, conversion.type,
+                    node_machine_word(machine, conversion.type), conversion.flags, value, promoted, both_pointers, assignable, arithmetic, kind);
+        }
+    }
+}
