+        inside = (owner & BUSTER_CHECK_LOWER_OWNER_CONTROL) == 0 && ((node >= first && node <= last && records > 1) || node == root);
         if (inside)
         {
             const uint8_t kind = function->kinds[e];
@@ -2026,14 +2036,14 @@ static void node_shadow_expression(NodeShadow* shadow, NodeCensusScratch* s, con
     }
     shadow->refused_expressions[refusal] += 1;
