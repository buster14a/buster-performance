 }
 
-// Each of the file's taken expressions through the sweeps of set `sweeps` (0: T, 1: T and C, 2: all three).
-static void node_shadow_sweep(NodeMachine* machine, const NodeShadow* shadow, uint32_t sweeps)
+// An expression's result after a sweep, for node_shadow_batch_check: its refusal and the record it stopped at from its
+// base, and where X took it, its tape, its `labels` labels' entries (C's count) and its calls' records from its base.
+static uint64_t node_shadow_result(const NodeMachine* machine, NodeMachineRefusal refusal, uint32_t labels)
 {
-    for (uint32_t i = 0; i < shadow->timed_count; i += 1)
+    uint64_t hash = UINT64_C(0xcbf29ce484222325);
+    const uint64_t prime = UINT64_C(0x100000001b3);
+    hash = (hash ^ (uint64_t)refusal) * prime;
+    hash = (hash ^ (uint64_t)(machine->stopped - machine->base)) * prime;
+    for (uint32_t e = 0; refusal == NODE_MACHINE_TAKEN && e < machine->entry_count; e += 1)
     {
-        const NodeShadowExpression* expression = shadow->timed + i;
-        // --repeat: each expression's sweeps again at once, its inputs in the caches as the reader leaves them in step 2.
+        hash = (hash ^ ((uint64_t)machine->kinds[e] << 8 | machine->classes[e])) * prime;
+        hash = (hash ^ machine->tape[e]) * prime;
+    }
+    for (uint32_t l = 0; refusal == NODE_MACHINE_TAKEN && l < labels; l += 1)
+    {
+        hash = (hash ^ machine->label_entries[l]) * prime;
+    }
+    for (uint32_t c = 0; refusal == NODE_MACHINE_TAKEN && c < machine->call_count; c += 1)
+    {
+        hash = (hash ^ (uint64_t)(machine->call_records[c] - machine->base)) * prime;
+    }
+    hash = refusal == NODE_MACHINE_TAKEN ? (hash ^ ((uint64_t)machine->entry_count << 32 | machine->temporary_count)) * prime : hash;
+    return hash;
+}
+
+// Each of the file's taken expressions through the sweeps of set `sweeps` (0: T, 1: T and C, 2: all three), by batches of
+// up to `batch` expressions whose records fit the machine's columns together: T over the batch's expressions, each after
+// the one before in the columns, then C over them, then X, each as node_machine_select picks it. --repeat runs a batch's
+// sweeps again at once, its inputs in the caches as the reader leaves them in step 2. With `results`, each expression's
+// result after all three sweeps (node_shadow_result), by its place among the file's.
+static void node_shadow_sweep(NodeMachine* machine, const NodeShadow* shadow, uint32_t sweeps, uint32_t batch, uint64_t* results)
+{
+    uint32_t bases[BUSTER_NODE_SHADOW_BATCH_MOST];
+    NodeMachineRefusal refusals[BUSTER_NODE_SHADOW_BATCH_MOST];
+    uint32_t labels[BUSTER_NODE_SHADOW_BATCH_MOST];
+    const NodeShadowExpression* expressions = shadow->timed;
+    uint32_t i = 0;
+    while (i < shadow->timed_count)
+    {
+        // The batch: expressions i to j - 1, each from the end of the one before.
+        uint32_t j = i;
+        uint32_t end = 0;
+        while (j < shadow->timed_count && j - i < batch && (j == i || expressions[j].count <= BUSTER_NODE_MACHINE_MOST - end))
+        {
+            bases[j - i] = end;
+            end += expressions[j].count;
+            j += 1;
+        }
         for (uint32_t time = 0; time < shadow->repeat; time += 1)
         {
-            NodeMachineRefusal refusal = node_machine_type(machine, expression->first, expression->root, expression->count);
-            if (sweeps >= 1 && refusal == NODE_MACHINE_TAKEN)
+            for (uint32_t k = i; k < j; k += 1)
             {
-                refusal = node_machine_contexts(machine, expression->context, expression->target, expression->object);
+                const NodeShadowExpression* expression = expressions + k;
+                refusals[k - i] = node_machine_type(machine, bases[k - i], expression->first, expression->root, expression->count);
+                if (results != NULL)
+                {
+                    results[k] = node_shadow_result(machine, refusals[k - i], 0);
+                }
             }
-            if (sweeps >= 2 && refusal == NODE_MACHINE_TAKEN)
+            for (uint32_t k = i; sweeps >= 1 && k < j; k += 1)
             {
-                node_machine_expand(machine, expression->object);
+                const NodeShadowExpression* expression = expressions + k;
+                if (refusals[k - i] == NODE_MACHINE_TAKEN)
+                {
+                    node_machine_select(machine, bases[k - i], expression->first, expression->root, expression->count);
+                    refusals[k - i] = node_machine_contexts(machine, expression->context, expression->target, expression->object);
+                    labels[k - i] = machine->label_count;
+                    if (results != NULL)
+                    {
+                        results[k] = node_shadow_result(machine, refusals[k - i], 0);
+                    }
+                }
+            }
+            for (uint32_t k = i; sweeps >= 2 && k < j; k += 1)
+            {
+                const NodeShadowExpression* expression = expressions + k;
+                if (refusals[k - i] == NODE_MACHINE_TAKEN)
+                {
+                    node_machine_select(machine, bases[k - i], expression->first, expression->root, expression->count);
+                    refusals[k - i] = node_machine_expand(machine, expression->object);
+                    if (results != NULL)
+                    {
+                        results[k] = node_shadow_result(machine, refusals[k - i], labels[k - i]);
+                    }
+                }
             }
         }
+        i = j;
+    }
+}
+
+// --verify with --batch: the file's taken expressions through all three sweeps alone and by batches, each expression's
+// result compared (node_shadow_result), the differences counted. The machine's counts are the comparison's.
+static void node_shadow_batch_check(NodeShadow* shadow, NodeMachine* machine)
+{
+    uint64_t* alone = calloc((size_t)shadow->timed_count + 1, sizeof(uint64_t));
+    uint64_t* batched = calloc((size_t)shadow->timed_count + 1, sizeof(uint64_t));
+    if (alone != NULL && batched != NULL)
+    {
+        node_machine_forget(machine);
+        node_shadow_sweep(machine, shadow, BUSTER_NODE_SHADOW_SWEEPS - 1, 1, alone);
+        node_machine_forget(machine);
+        node_shadow_sweep(machine, shadow, BUSTER_NODE_SHADOW_SWEEPS - 1, shadow->batch, batched);
+        for (uint32_t k = 0; k < shadow->timed_count; k += 1)
+        {
+            shadow->batch_differences += alone[k] != batched[k];
+        }
+        shadow->batch_checked = true;
+    }
+    else
+    {
+        shadow->batch_differences += shadow->timed_count;
     }
+    free(alone);
+    free(batched);
 }
 
 // The timing passes over the file's taken expressions (`nodes` evaluated nodes in them): each sweep set `passes` times,
@@ -2147,7 +2252,7 @@ static void node_shadow_time(NodeShadow* shadow, NodeMachine* machine, uint64_t
             const uint64_t c0 = node_shadow_read(cycles);
             const uint64_t i0 = node_shadow_read(instructions);
             const uint64_t t0 = __rdtsc();
-            node_shadow_sweep(machine, shadow, sweeps);
+            node_shadow_sweep(machine, shadow, sweeps, shadow->batch, NULL);
             const uint64_t t1 = __rdtsc();
             const uint64_t i1 = node_shadow_read(instructions);
             const uint64_t c1 = node_shadow_read(cycles);
@@ -2164,6 +2269,10 @@ static void node_shadow_time(NodeShadow* shadow, NodeMachine* machine, uint64_t
         shadow->instructions[sweeps] += least[sweeps][1];
         shadow->ticks[sweeps] += least[sweeps][2];
     }
+    if (verify && shadow->batch > 1)
+    {
+        node_shadow_batch_check(shadow, machine);
+    }
     shadow->timed_nodes += shadow->passes != 0 ? nodes : 0;
     shadow->counted = cycles >= 0;
     machine->verify = verify;
@@ -2211,12 +2320,16 @@ static void node_shadow_report(const NodeShadow* shadow, const uint64_t* action_
             printf("node-shadow: action-typed op=%s nodes=%" PRIu64 "\n", lower_inventory_op_names[op] != NULL ? lower_inventory_op_names[op] : "?", action_ops[op]);
         }
     }
+    if (shadow->batch_checked)
+    {
+        printf("node-shadow: batch=%u expressions whose result by batches differs from theirs alone=%" PRIu64 "\n", shadow->batch, shadow->batch_differences);
+    }
     static const char* const sweep_names[BUSTER_NODE_SHADOW_SWEEPS] = { "T", "T+C", "T+C+X" };
     for (uint32_t k = 0; shadow->timed_nodes != 0 && k < BUSTER_NODE_SHADOW_SWEEPS; k += 1)
     {
-        printf("node-shadow: time sweeps=%s passes=%u repeat=%u cycles=%" PRIu64 " instructions=%" PRIu64 " ticks=%" PRIu64 " per-evaluated-node: cycles=%.1f instructions=%.1f "
-               "ticks=%.1f%s\n",
-               sweep_names[k], shadow->passes, shadow->repeat, shadow->cycles[k], shadow->instructions[k], shadow->ticks[k], (double)shadow->cycles[k] / (double)shadow->timed_nodes,
+        printf("node-shadow: time sweeps=%s passes=%u batch=%u repeat=%u cycles=%" PRIu64 " instructions=%" PRIu64 " ticks=%" PRIu64 " per-evaluated-node: cycles=%.1f "
+               "instructions=%.1f ticks=%.1f%s\n",
+               sweep_names[k], shadow->passes, shadow->batch, shadow->repeat, shadow->cycles[k], shadow->instructions[k], shadow->ticks[k], (double)shadow->cycles[k] / (double)shadow->timed_nodes,
                (double)shadow->instructions[k] / (double)shadow->timed_nodes, (double)shadow->ticks[k] / (double)shadow->timed_nodes,
                shadow->counted ? "" : " (no cycle counter)");
     }
@@ -2472,7 +2585,7 @@ static int run_node_census(int count, char** arguments)
     uint32_t file_count = 0;
     bool valid = options != 0 && files != 0;
     bool shadowed = false;
-    NodeShadow shadow = { .passes = 5, .repeat = 1 };
+    NodeShadow shadow = { .passes = 5, .repeat = 1, .batch = 1 };
     for (int i = 0; valid && i < count; i += 1)
     {
         if (strcmp(arguments[i], "--list") == 0)
@@ -2505,6 +2618,12 @@ static int run_node_census(int count, char** arguments)
             valid = i + 1 < count && check_corpus_number(arguments[++i], &number) && number >= 1 && number <= 16;
             shadow.repeat = (uint32_t)number;
         }
+        else if (strcmp(arguments[i], "--batch") == 0)
+        {
+            uint64_t number = 0;
+            valid = i + 1 < count && check_corpus_number(arguments[++i], &number) && number >= 1 && number <= BUSTER_NODE_SHADOW_BATCH_MOST;
+            shadow.batch = (uint32_t)number;
+        }
         else if (strcmp(arguments[i], "--no-default-config") == 0)
         {
             // Clang's option, which the corpora's command lines take: nothing for pp_parse_options to read.
@@ -2540,11 +2659,11 @@ static int run_node_census(int count, char** arguments)
     }
     else
     {
-        fprintf(stderr, "usage: compiler measure-node-machine [--list N] [--shadow [--scalar] [--verify] [--passes N] [--repeat N]] [preprocessor options] file...\n");
+        fprintf(stderr, "usage: compiler measure-node-machine [--list N] [--shadow [--scalar] [--verify] [--passes N] [--batch N] [--repeat N]] [preprocessor options] file...\n");
     }
     free(files);
     free(options);
-    const bool differences = shadowed && (shadow.value_differences != 0 || shadow.entry_differences != 0 || shadow.twin_differences != 0);
+    const bool differences = shadowed && (shadow.value_differences != 0 || shadow.entry_differences != 0 || shadow.twin_differences != 0 || shadow.batch_differences != 0);
     return valid && census.failures == 0 && census.files != 0 && !differences ? 0 : 1;
 }
 
