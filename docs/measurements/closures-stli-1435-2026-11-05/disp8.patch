From a5a0ac97cfca32f279d0cbf88746a0897ecc07f8 Mon Sep 17 00:00:00 2001
From: exp <exp@example.invalid>
Date: Thu, 5 Nov 2026 19:59:41 +0000
Subject: [PATCH] experiment 1435: rsp disp8 (not for merging)

Signed-off-by: David Gonzalez Martin <davidgmbb@gmail.com>
---
 src/buster/compiler/x86_64_encoder.c | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/src/buster/compiler/x86_64_encoder.c b/src/buster/compiler/x86_64_encoder.c
index c7120dea..ccbe0153 100644
--- a/src/buster/compiler/x86_64_encoder.c
+++ b/src/buster/compiler/x86_64_encoder.c
@@ -81,8 +81,10 @@
 #include <stdint.h>
 #include <stdbool.h>
 #include <string.h>
+#include <stdlib.h>
 #include "host_isa.h"
 #include "baked.h"
+static int x86_experiment_rsp_disp8(void);
 
 // OS-dependent includes
 #include <sys/mman.h>
@@ -6796,7 +6798,7 @@ static uint32_t encode_one(const X86Instruction* instruction, uint8_t* out, X86E
                 const int32_t scaled = instruction->displacement / scale;
                 rm_field = (index || (rm & 7) == 4) ? 4 : (rm & 7);
                 sib = index || (rm & 7) == 4;
-                if (instruction->displacement == 0 && (rm & 7) != 5)
+                if (instruction->displacement == 0 && (rm & 7) != 5 && !(x86_experiment_rsp_disp8() && rm == 4))
                 {
                     mod = 0;
                 }
@@ -7105,6 +7107,17 @@ static const uint32_t x86_mode_presence_16[16] __attribute__((aligned(64))) = {
 // and R12's 4 and 12 (and R20's and R28's, with APX), which need a SIB byte, and bit 15 (here 7) for RBP's and R13's 5
 // and 13, which need a displacement (see compute_fields).
 static const uint8_t x86_base_kinds[64] __attribute__((aligned(64))) = { BUSTER_X86_LANES(0, 0, 0, 0, 2, 0x80, 0, 0, 0, 0, 0, 0, 2, 0x80, 0, 0) };
+// Experiment #1435 only, not for merging: an rsp base's zero displacement as an 8-bit zero.
+static int x86_experiment_rsp_disp8(void)
+{
+    static int value = -1;
+    if (value < 0)
+    {
+        const char* text = getenv("BUSTER_EXPERIMENT_RSP_DISP8");
+        value = text != 0 && text[0] == '1';
+    }
+    return value;
+}
 static const uint8_t x86_rm16[64] __attribute__((aligned(64))) = { BUSTER_X86_LANES(0, 0, 0, 7, 0, 6, 4, 5, 0, 0, 0, 6, 0, 4, 0, 0) };
 static const uint8_t x86_overrides[64] __attribute__((aligned(64))) = { BUSTER_X86_LANES(0, 0x26, 0x2e, 0x36, 0x3e, 0x64, 0x65, 0, 0, 0, 0, 0, 0, 0, 0, 0) };
 #undef BUSTER_X86_LANES
@@ -7217,7 +7230,9 @@ BUSTER_INLINE X86Fields compute_fields(__m512i operands, __m512i displacement, _
     const __m512i address16 = _mm512_srai_epi32(_mm512_slli_epi32(mode_presence, 31 - 21), 31);
     const __m512i has_index = _mm512_srai_epi32(_mm512_slli_epi32(operands, 31 - 28), 31);
     const __m512i sized_displacement = legacy ? _mm512_ternarylogic_epi32(_mm512_srai_epi32(_mm512_slli_epi32(displacement, 16), 16), displacement, address16, BUSTER_X86_C_SELECTS_A_OVER_B) : displacement;
-    const __m512i needs_displacement = legacy ? _mm512_ternarylogic_epi32(rm_5, address16, has_index, BUSTER_X86_A_AND_NOT_B_AND_C_BOTH) : rm_5;
+    __m512i needs_displacement = legacy ? _mm512_ternarylogic_epi32(rm_5, address16, has_index, BUSTER_X86_A_AND_NOT_B_AND_C_BOTH) : rm_5;
+    const __mmask16 rsp_base = x86_experiment_rsp_disp8() ? _mm512_cmpeq_epi32_mask(_mm512_and_epi32(_mm512_srli_epi32(operands, 8), _mm512_set1_epi32(0x1f)), _mm512_set1_epi32(4)) : 0;
+    needs_displacement = _mm512_mask_mov_epi32(needs_displacement, rsp_base, _mm512_set1_epi32(-1));
     const __m512i nonzero = _mm512_srai_epi32(_mm512_or_epi32(sized_displacement, _mm512_sub_epi32(_mm512_setzero_si512(), sized_displacement)), 31);
     // All ones after a base with a displacement, 8-bit or 32-bit.
     const __m512i base_displacement = _mm512_ternarylogic_epi32(base, nonzero, needs_displacement, BUSTER_X86_A_WHERE_B_OR_C);
-- 
