diff --git a/cmake/BusterCodegen.cmake b/cmake/BusterCodegen.cmake
index fdba804bb..05f29b09b 100644
--- a/cmake/BusterCodegen.cmake
+++ b/cmake/BusterCodegen.cmake
@@ -199,7 +199,7 @@ function(buster_codegen_unit name)
     foreach(part RANGE ${BUSTER_CODEGEN_PARTITIONS})
         set(object "${directory}/part${part}.o")
         add_custom_command(OUTPUT "${object}"
-            COMMAND "${CMAKE_C_COMPILER}" -x ir ${buster_host_flags} ${debug} -fno-stack-protector -O3 -Wall -Werror
+            COMMAND "${CMAKE_C_COMPILER}" -x ir ${buster_host_flags} ${debug} -fno-stack-protector -O1 -Wall -Werror
                 -Xclang -disable-llvm-passes -Wno-unused-command-line-argument -c "${directory}/part${part}.bc" -o "${object}"
             DEPENDS "${directory}/part${part}.bc"
             COMMENT "Generating ${name}'s native part ${part}"
diff --git a/cmake/BusterSettings.cmake b/cmake/BusterSettings.cmake
index e8605f8a1..130856911 100644
--- a/cmake/BusterSettings.cmake
+++ b/cmake/BusterSettings.cmake
@@ -382,7 +382,7 @@ function(buster_settings_tools clang)
         message(NOTICE "buster: host execution: scalar (${buster_arch})")
     endif()
 
-    set(optimization -O3)
+    set(optimization -O1)
     # The executable's debug information: -g, unless BUSTER_DEBUG_INFO is 0, which leaves it out of the sources'
     # objects and takes a fifth of the build's time (the 9700X job builds so, since nothing there reads it). Clang's
     # code with -g is its code without it but for a few functions' stack slots.
