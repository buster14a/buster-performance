+// Qualification only: #483's loader cleanup, with its exact per-import version scans. The driver-generated
+// benchmark has no named libraries, so no forced dependency is needed in this baseline.
+static void bind_qualification_keep_loader(Bind* bind, Link* link)
+{
+    LinkSymbols* symbols = &link->symbols;
+    bool needed = false;
+    for (uint32_t i = 0; i < bind->import_count; i += 1)
+    {
+        const SymbolId symbol = bind->imports[i];
+        const bool strong = (symbols->flags[symbol] & BUSTER_LINK_SYMBOL_BINDING) == BUSTER_LINK_SYMBOL_GLOBAL;
+        needed = needed || (strong && runtime_library_version(&bind->runtime->loader, symbols->version[symbol]));
+    }
+    uint32_t kept = 0;
+    for (uint32_t i = 0; i < bind->import_count; i += 1)
+    {
+        const SymbolId symbol = bind->imports[i];
+        const bool dropped = !needed && runtime_library_version(&bind->runtime->loader, symbols->version[symbol]);
+        symbols->source[symbol] = dropped ? BUSTER_LINK_SOURCE_NONE : symbols->source[symbol];
+        symbols->version[symbol] = dropped ? 0 : symbols->version[symbol];
+        bind->imports[kept] = symbol;
+        kept += dropped ? 0 : 1;
+    }
+    bind->import_count = kept;
+}
