+                                          (x86_target_requirement(expected.form) & ~BUSTER_X86_TARGET_KNOWN) | (mask_bytes == 1 ? BUSTER_X86_FEATURE(AVX512DQ) : 0) |
+                                          (mask_bytes >= 4 ? BUSTER_X86_FEATURE(AVX512BW) : 0);
