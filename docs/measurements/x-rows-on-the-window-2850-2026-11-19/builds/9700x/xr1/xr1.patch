+        const __m512i facts = _mm512_loadu_si512(state->window_c_facts + x);
+        const __m512i standings = _mm512_loadu_si512(state->window_c_standings + x);
+        const __m512i flags = _mm512_loadu_si512(state->window_c_flags + x);
