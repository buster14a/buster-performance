+// The words of `entry` in the store, its header's included.
+static uint64_t node_shadow_shape_words(const NodeShapeEntry* entry)
+{
+    return sizeof(NodeShapeEntry) / 8 + entry->words + (uint64_t)entry->entry_count + 2 * (uint64_t)node_shape_padded(entry->entry_count) +
+           node_shape_padded(4 * (uint32_t)entry->patch_count) + node_shape_padded(4 * (uint32_t)entry->label_count) + node_shape_padded(4 * (uint32_t)entry->call_count);
+}
+
+static int node_shadow_shape_order(const void* left, const void* right)
+{
+    const uint64_t a = *(const uint64_t*)left;
+    const uint64_t b = *(const uint64_t*)right;
+    return a < b ? 1 : a > b ? -1 : 0;
+}
+
+// --shapes, at a unit's end: its store's bytes, those of the shapes used again, and the hits' nodes its most used shapes
+// gave. `weights` has room for each shape's.
+static void node_shadow_shape_unit(NodeShadow* shadow, const NodeShapes* shapes, uint64_t* weights)
+{
+    uint64_t at = 0;
+    uint32_t count = 0;
+    while (at < shapes->store_words)
+    {
+        const NodeShapeEntry* entry = (const NodeShapeEntry*)(shapes->store + at);
+        const uint64_t words = node_shadow_shape_words(entry);
+        weights[count] = (uint64_t)entry->uses * entry->nodes;
+        count += 1;
+        shadow->shape_used += entry->uses != 0;
+        shadow->shape_used_bytes += entry->uses != 0 ? 8 * words : 0;
+        at += words;
+    }
+    shadow->shape_store_bytes += 8 * shapes->store_words;
+    qsort(weights, count, sizeof(uint64_t), node_shadow_shape_order);
+    uint64_t covered = 0;
+    uint32_t top = 16;
+    uint32_t k = 0;
+    for (uint32_t i = 0; i <= count && k < BUSTER_NODE_SHADOW_TOPS; i += 1)
+    {
+        while (k < BUSTER_NODE_SHADOW_TOPS && (i == top || i == count))
+        {
+            shadow->shape_tops[k] += covered;
+            k += 1;
+            top *= 4;
+        }
+        covered += i < count ? weights[i] : 0;
+    }
+}
