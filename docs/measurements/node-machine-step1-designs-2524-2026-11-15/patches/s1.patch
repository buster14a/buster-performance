diff --git a/src/buster/compiler/c_check_node_machine_shape.c b/src/buster/compiler/c_check_node_machine_shape.c
new file mode 100644
index 000000000..566a07aee
--- /dev/null
+++ b/src/buster/compiler/c_check_node_machine_shape.c
@@ -0,0 +1,534 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+//
+// #2524's node machine's shapes (c_check_node_machine.c has the machine): a whole expression's entries from the first
+// expression of its shape in the unit, with no sweep (docs/node-machine.md, "Shapes"). An expression's shape is all the
+// sweeps read of it that isn't an object's identity: each record's operator, its operands' places, its cast's or its
+// member's action data, and a leaf's type, flags, category, constant and object's kind (node_shape_object_kind); the
+// leaves' objects only up to renaming, as which leaves name the same object and which the same symbol; and the root's
+// context, target and initialized object. The sweeps' answer is a function of it, with the leaves' objects and their
+// symbols carried to the entries that name them: T, C and X read an object only for whether it is none, for its kind and
+// for its symbol, and copy it.
+//
+// - node_shape_key: the expression's key, from the graph alone (what T reads of it), and its leaves' objects.
+// - node_shape_find: the unit's earlier expression of that key (NodeShapes, an open-addressing table of entries).
+// - node_shape_instantiate: its entries onto the machine's tape, with this expression's objects and symbols in the
+//   entries that name one (the entry's patches), its labels' entries and its calls' rows.
+// - node_shape_insert: after the sweeps took an expression, its entry: the tape as it is, and a patch for each entry
+//   whose value is a leaf's object or its symbol. An expression whose answer the key doesn't decide isn't kept: one T
+//   typed a node of by the action (which reads the node's own context), one with a wide value, one whose rule asked a
+//   type's completeness at the node and found it incomplete (a later node may find it complete), one whose entry names an
+//   object no leaf does.
+//
+// The sweeps are the shapes' exact twin: the shadow's --shapes instantiates every hit and then runs the sweeps on the same
+// expression, and compares the two tapes, their labels and their calls (c_check_node_census.c).
+#ifndef BUSTER_C_CHECK_NODE_MACHINE_SHAPE_INCLUDED
+#define BUSTER_C_CHECK_NODE_MACHINE_SHAPE_INCLUDED
+
+// The most records of an expression the shapes key, and the most leaves with an object (the root's among them).
+#define BUSTER_NODE_SHAPE_RECORDS 256u
+#define BUSTER_NODE_SHAPE_LEAVES 64u
+// A key's words at most: three a record, a call's arguments four a word, and the root's two.
+#define BUSTER_NODE_SHAPE_WORDS (4u * BUSTER_NODE_SHAPE_RECORDS + 8u)
+// An object's kind (node_shape_object_kind): what the sweeps ask of an object but its identity and its symbol.
+#define BUSTER_NODE_SHAPE_OBJECT 0x80u
+#define BUSTER_NODE_SHAPE_KNOWN 0x01u
+#define BUSTER_NODE_SHAPE_LOCAL 0x02u
+#define BUSTER_NODE_SHAPE_COMPOUND 0x04u
+#define BUSTER_NODE_SHAPE_STATIC 0x08u
+#define BUSTER_NODE_SHAPE_REGISTER 0x10u
+#define BUSTER_NODE_SHAPE_TWICE 0x20u
+#define BUSTER_NODE_SHAPE_LABELLED 0x40u
+// A patch: its entry, the leaf whose object it names, and whether it holds that object's symbol.
+#define BUSTER_NODE_SHAPE_PATCH_SYMBOL 0x80000000u
+#define BUSTER_NODE_SHAPE_NO_LEAF 0x7fffu
+
+// Why an expression has no key (node_shape_key) or its answer isn't kept (node_shape_insert).
+typedef enum NodeShapeReason
+{
+    NODE_SHAPE_KEPT,
+    // Past BUSTER_NODE_SHAPE_RECORDS records, or not one range of the graph.
+    NODE_SHAPE_SIZE,
+    // A node in a constant context or a floating-point environment, which T refuses.
+    NODE_SHAPE_CONTEXT,
+    // A leaf the graph holds whole (a payload row, an overload set).
+    NODE_SHAPE_LEAF,
+    // Past BUSTER_NODE_SHAPE_LEAVES leaves with an object.
+    NODE_SHAPE_OBJECTS,
+    // T typed one of its nodes by the action.
+    NODE_SHAPE_ACTION,
+    // One of its values is wide.
+    NODE_SHAPE_WIDE,
+    // A rule found a type incomplete at one of its nodes.
+    NODE_SHAPE_INCOMPLETE,
+    // An entry names an object or a symbol that no leaf's object is or has.
+    NODE_SHAPE_UNRESOLVED,
+    // No room in the store or the table.
+    NODE_SHAPE_ROOM,
+    NODE_SHAPE_REASONS,
+} NodeShapeReason;
+
+static const char* const node_shape_reason_names[NODE_SHAPE_REASONS] = {
+    [NODE_SHAPE_KEPT] = "kept",
+    [NODE_SHAPE_SIZE] = "size",
+    [NODE_SHAPE_CONTEXT] = "context",
+    [NODE_SHAPE_LEAF] = "leaf",
+    [NODE_SHAPE_OBJECTS] = "objects",
+    [NODE_SHAPE_ACTION] = "action",
+    [NODE_SHAPE_WIDE] = "wide",
+    [NODE_SHAPE_INCOMPLETE] = "incomplete",
+    [NODE_SHAPE_UNRESOLVED] = "unresolved",
+    [NODE_SHAPE_ROOM] = "room",
+};
+
+// One shape's entry in the store, then its words: its key (`words`), its entries' values (`entry_count`), their kinds
+// and their classes (each padded to a word), its patches (`patch_count` of 32 bits), its labels' entries (`label_count`)
+// and its calls (`call_count`: the call's record, and above it the leaf whose object's symbol it calls or
+// BUSTER_NODE_SHAPE_NO_LEAF).
+typedef struct NodeShapeEntry NodeShapeEntry;
+struct NodeShapeEntry
+{
+    uint64_t hash;
+    uint32_t words;
+    uint32_t entry_count;
+    uint16_t patch_count;
+    uint16_t label_count;
+    uint16_t call_count;
+    uint16_t temporary_count;
+    // The census's: the expressions instantiated from it and its expression's evaluated nodes.
+    uint32_t uses;
+    uint32_t nodes;
+};
+
+_Static_assert(sizeof(NodeShapeEntry) == 32, "a shape's entry header is four words");
+
+// The unit's shapes and the current expression's key.
+typedef struct NodeShapes NodeShapes;
+struct NodeShapes
+{
+    // The table: a slot's tag (its entry's hash's high half with bit 0 set; 0 for none) and its entry's place in the
+    // store, in words.
+    uint32_t* tags;
+    uint32_t* offsets;
+    uint32_t slot_mask;
+    uint32_t filled;
+    uint64_t* store;
+    uint64_t store_words;
+    uint64_t store_capacity;
+    // Every object's kind, by object: 0 until asked.
+    uint8_t* object_kinds;
+    uint32_t object_count;
+    // The current expression's key, its hash, and its leaves with an object in record order (the root's initialized
+    // object last): their objects and symbols.
+    uint64_t* key;
+    uint32_t words;
+    uint64_t hash;
+    uint32_t leaf_count;
+    uint32_t leaf_objects[BUSTER_NODE_SHAPE_LEAVES + 1];
+    uint32_t leaf_symbols[BUSTER_NODE_SHAPE_LEAVES + 1];
+    NodeShapeReason reason;
+    // A hit's calls' symbols, by row (the machine's call_records hold their records).
+    uint32_t* call_symbols;
+};
+
+static inline __attribute__((always_inline)) uint64_t node_shape_mix(uint64_t hash, uint64_t word)
+{
+    const uint64_t mixed = (hash ^ word) * UINT64_C(0x9e3779b97f4a7c15);
+    return mixed ^ (mixed >> 32);
+}
+
+// The table's and the store's room for a unit of `expressions` expressions, from `arena`: whether there was room.
+static bool node_shapes_begin(NodeShapes* shapes, const CheckProgram* program, uint64_t expressions, Arena* arena)
+{
+    uint32_t slots = 64;
+    while (slots < 2 * expressions && slots < (UINT32_C(1) << 30))
+    {
+        slots *= 2;
+    }
+    *shapes = (NodeShapes){
+        .slot_mask = slots - 1,
+        .object_count = program->object_count,
+    };
+    // An entry is its key, about three words a record, and its tape, about a word and a quarter an entry.
+    shapes->store_capacity = 64 * expressions + 65536;
+    shapes->tags = BUSTER_ARENA_PUSH_ARRAY(arena, uint32_t, slots);
+    shapes->offsets = BUSTER_ARENA_PUSH_ARRAY(arena, uint32_t, slots);
+    shapes->store = BUSTER_ARENA_PUSH_ARRAY(arena, uint64_t, shapes->store_capacity);
+    shapes->object_kinds = BUSTER_ARENA_PUSH_ARRAY(arena, uint8_t, (uint64_t)program->object_count + 1);
+    shapes->key = BUSTER_ARENA_PUSH_ARRAY(arena, uint64_t, BUSTER_NODE_SHAPE_WORDS);
+    shapes->call_symbols = BUSTER_ARENA_PUSH_ARRAY(arena, uint32_t, BUSTER_NODE_MACHINE_MOST);
+    const bool room = shapes->tags != NULL && shapes->offsets != NULL && shapes->store != NULL && shapes->object_kinds != NULL && shapes->key != NULL &&
+                      shapes->call_symbols != NULL;
+    if (room)
+    {
+        memset(shapes->tags, 0, (uint64_t)slots * sizeof(uint32_t));
+        memset(shapes->object_kinds, 0, (uint64_t)program->object_count + 1);
+    }
+    return room;
+}
+
+// Forgets the unit's shapes and its objects' kinds, as a unit starts without them.
+static void node_shapes_forget(NodeShapes* shapes)
+{
+    memset(shapes->tags, 0, ((uint64_t)shapes->slot_mask + 1) * sizeof(uint32_t));
+    memset(shapes->object_kinds, 0, (uint64_t)shapes->object_count + 1);
+    shapes->filled = 0;
+    shapes->store_words = 0;
+}
+
+// Object `object`'s kind (no 0): what T, C and X ask of an object but its identity and its symbol. Whether it is the
+// unit's (node_machine_address_takes), a local (node_machine_local), a compound literal's, static or a register variable
+// (the declaration's bits C reads), a function that returns twice (node_machine_callee_refused's) or one with an asm
+// label (check_program_call_marked's).
+static __attribute__((noinline)) uint8_t node_shape_object_kind_make(const NodeMachine* machine, uint32_t object)
+{
+    const CheckProgram* program = machine->program;
+    uint8_t kind = BUSTER_NODE_SHAPE_OBJECT;
+    if (object < program->object_count)
+    {
+        const uint8_t bits = program->input->declaration_bits[object - 1];
+        const uint32_t declaration = program->object_declarations != NULL ? program->object_declarations[object] : BUSTER_CHECK_NONE;
+        const IdentId name = program->parser != NULL && declaration < program->input->token_count ? program->parser->tokens.names[declaration] : 0;
+        bool twice = program->object_returns_twice != NULL && program->object_returns_twice[object] != 0;
+        for (uint32_t k = 0; k < BUSTER_CHECK_LOWER_TWICE_NAMES; k += 1)
+        {
+            twice |= name != 0 && machine->twice_names[k] == name;
+        }
+        kind |= BUSTER_NODE_SHAPE_KNOWN;
+        kind |= program->object_symbols[object] == 0 ? BUSTER_NODE_SHAPE_LOCAL : 0;
+        kind |= (bits & BUSTER_CHECK_BITS_COMPOUND) != 0 ? BUSTER_NODE_SHAPE_COMPOUND : 0;
+        kind |= (bits & BUSTER_CHECK_BITS_STATIC) != 0 ? BUSTER_NODE_SHAPE_STATIC : 0;
+        kind |= (bits & BUSTER_CHECK_BITS_REGISTER) != 0 ? BUSTER_NODE_SHAPE_REGISTER : 0;
+        kind |= twice ? BUSTER_NODE_SHAPE_TWICE : 0;
+        kind |= program->object_labelled != NULL && program->object_labelled[object] != 0 ? BUSTER_NODE_SHAPE_LABELLED : 0;
+    }
+    return kind;
+}
+
+static inline __attribute__((always_inline)) uint8_t node_shape_object_kind(const NodeMachine* machine, NodeShapes* shapes, uint32_t object)
+{
+    uint8_t kind = object < shapes->object_count ? shapes->object_kinds[object] : 0;
+    if (__builtin_expect(kind == 0, 0))
+    {
+        kind = node_shape_object_kind_make(machine, object);
+        if (object < shapes->object_count)
+        {
+            shapes->object_kinds[object] = kind;
+        }
+    }
+    return kind;
+}
+
+// An operand `operand` of record `r` as its distance below it (0 for none, UINT16_MAX outside the expression's range).
+static inline __attribute__((always_inline)) uint64_t node_shape_operand(uint32_t operand, uint32_t first, uint32_t r)
+{
+    const uint32_t record = operand - first;
+    return operand == BUSTER_CHECK_NONE ? 0 : operand >= first && record < r ? r - record : UINT16_MAX;
+}
+
+// A leaf's object's word of the key, and the object among the expression's leaves: its kind, the first leaf with the same
+// object and the first with the same symbol (itself, for a new one).
+static inline __attribute__((always_inline)) uint64_t node_shape_leaf_object(const NodeMachine* machine, NodeShapes* shapes, uint32_t object, uint32_t* leaves)
+{
+    const CheckProgram* program = machine->program;
+    const uint32_t count = *leaves;
+    const uint8_t kind = node_shape_object_kind(machine, shapes, object);
+    const uint32_t symbol = (kind & BUSTER_NODE_SHAPE_KNOWN) != 0 ? program->object_symbols[object] : 0;
+    uint32_t same_object = 0;
+    while (same_object < count && shapes->leaf_objects[same_object] != object)
+    {
+        same_object += 1;
+    }
+    uint32_t same_symbol = UINT16_MAX;
+    if (symbol != 0)
+    {
+        same_symbol = 0;
+        while (same_symbol < count && shapes->leaf_symbols[same_symbol] != symbol)
+        {
+            same_symbol += 1;
+        }
+    }
+    shapes->leaf_objects[count] = object;
+    shapes->leaf_symbols[count] = symbol;
+    *leaves = count + (count < BUSTER_NODE_SHAPE_LEAVES);
+    return (uint64_t)kind << 24 | (uint64_t)same_object << 32 | (uint64_t)same_symbol << 48;
+}
+
+// The key of the expression of `count` records, graph nodes `first` to first + count - 2 and `root`, which its consumer
+// evaluates with `context` and converts to `target` (`object`: what a root INITIALIZE initializes): whether it has one
+// (else shapes->reason). Three words a record: a leaf's type and flags, its integer, and its operator, category, constant
+// kind and object; any other record's action data (its type name and its member), its operands' places and its
+// arguments' count, and its operator, then a call's arguments' places.
+static bool node_shape_key(const NodeMachine* machine, NodeShapes* shapes, uint32_t first, uint32_t root, uint32_t count, uint8_t context, TypeId target,
+                           uint32_t object)
+{
+    const CheckGraph* graph = machine->graph;
+    uint64_t* key = shapes->key;
+    NodeShapeReason reason = count != 0 && count <= BUSTER_NODE_SHAPE_RECORDS && root >= first + count - 1 && graph->dense_leaves == NULL ? NODE_SHAPE_KEPT : NODE_SHAPE_SIZE;
+    const uint32_t records = reason == NODE_SHAPE_KEPT ? count : 0;
+    uint32_t words = 0;
+    uint32_t leaves = 0;
+    uint64_t hash0 = UINT64_C(0x243f6a8885a308d3);
+    uint64_t hash1 = UINT64_C(0x13198a2e03707344);
+    uint64_t hash2 = UINT64_C(0xa4093822299f31d0);
+    uint32_t flagged = 0;
+    uint32_t whole = 0;
+    uint32_t placed = 0;
+    for (uint32_t r = 0; r < records; r += 1)
+    {
+        const uint32_t node = r + 1 == records ? root : first + r;
+        const CheckOp op = graph->ops[node];
+        flagged |= graph->contexts != NULL ? graph->contexts[node] : 0;
+        flagged |= graph->fp_environments != NULL ? graph->fp_environments[node] & (BUSTER_CHECK_FP_ENV_ACCESS | BUSTER_CHECK_FP_EVAL_MASK) : 0;
+        uint64_t word0 = 0;
+        uint64_t word1 = 0;
+        uint64_t word2 = (uint64_t)op;
+        uint32_t call_arguments = 0;
+        if (op == CHECK_OP_VALUE)
+        {
+            const CheckGraphLeaf* leaf = graph->leaf_records + graph->leaf_slots[node];
+            whole |= leaf->row | leaf->overload_head | (leaf->category > CHECK_FUNCTION) | (leaf->constant_kind > CHECK_CONSTANT_LABEL_DIFFERENCE);
+            word0 = (uint64_t)leaf->type | (uint64_t)leaf->flags << 32;
+            word1 = leaf->integer;
+            word2 |= (uint64_t)leaf->category << 8 | (uint64_t)leaf->constant_kind << 16;
+            if (leaf->object != 0)
+            {
+                word2 |= node_shape_leaf_object(machine, shapes, leaf->object, &leaves);
+            }
+        }
+        else
+        {
+            const uint32_t arguments = graph->argument_counts[node];
+            word0 = (uint64_t)(graph->types != NULL ? graph->types[node] : 0) | (uint64_t)(graph->members != NULL ? graph->members[node] : 0) << 32;
+            word1 = node_shape_operand(graph->operand0[node], first, r) | node_shape_operand(graph->operand1[node], first, r) << 16 |
+                    node_shape_operand(graph->operand2[node], first, r) << 32 | (uint64_t)(arguments < UINT16_MAX ? arguments : UINT16_MAX) << 48;
+            call_arguments = op == CHECK_OP_CALL ? arguments : 0;
+        }
+        key[words] = word0;
+        key[words + 1] = word1;
+        key[words + 2] = word2;
+        hash0 = node_shape_mix(hash0, word0);
+        hash1 = node_shape_mix(hash1, word1);
+        hash2 = node_shape_mix(hash2, word2);
+        words += 3;
+        if (__builtin_expect(call_arguments != 0, 0))
+        {
+            // A call's arguments' places, four a word, after its three: every call's together at most the records.
+            const uint32_t offset = graph->argument_offsets[node];
+            const uint32_t kept = call_arguments <= BUSTER_NODE_SHAPE_RECORDS - placed ? call_arguments : 0;
+            whole |= kept != call_arguments;
+            placed += kept;
+            for (uint32_t i = 0; i < kept; i += 4)
+            {
+                uint64_t places = 0;
+                for (uint32_t k = 0; k < 4 && i + k < kept; k += 1)
+                {
+                    places |= node_shape_operand(graph->argument_nodes[offset + i + k], first, r) << (16 * k);
+                }
+                key[words] = places;
+                hash1 = node_shape_mix(hash1, places);
+                words += 1;
+            }
+        }
+    }
+    // The root's: its context, its target, and the object it initializes as one more leaf's.
+    uint64_t rooted = (uint64_t)context | (uint64_t)count << 8;
+    if (object != 0)
+    {
+        rooted |= node_shape_leaf_object(machine, shapes, object, &leaves);
+    }
+    key[words] = rooted;
+    key[words + 1] = target;
+    hash0 = node_shape_mix(hash0, rooted);
+    hash1 = node_shape_mix(hash1, target);
+    words += 2;
+    reason = reason != NODE_SHAPE_KEPT ? reason : flagged != 0 ? NODE_SHAPE_CONTEXT : whole != 0 ? NODE_SHAPE_LEAF : leaves >= BUSTER_NODE_SHAPE_LEAVES ? NODE_SHAPE_OBJECTS : NODE_SHAPE_KEPT;
+    shapes->words = words;
+    shapes->leaf_count = leaves;
+    shapes->hash = node_shape_mix(node_shape_mix(hash0, hash1), hash2 + words);
+    shapes->reason = reason;
+    return reason == NODE_SHAPE_KEPT;
+}
+
+// The unit's entry of the current key, or null.
+static inline __attribute__((always_inline)) NodeShapeEntry* node_shape_find(const NodeShapes* shapes)
+{
+    const uint32_t tag = (uint32_t)(shapes->hash >> 32) | 1;
+    const uint32_t words = shapes->words;
+    uint32_t slot = (uint32_t)shapes->hash & shapes->slot_mask;
+    NodeShapeEntry* found = NULL;
+    while (found == NULL && shapes->tags[slot] != 0)
+    {
+        if (shapes->tags[slot] == tag)
+        {
+            NodeShapeEntry* entry = (NodeShapeEntry*)(shapes->store + shapes->offsets[slot]);
+            if (entry->words == words && memcmp(entry + 1, shapes->key, (uint64_t)words * sizeof(uint64_t)) == 0)
+            {
+                found = entry;
+            }
+        }
+        slot = (slot + 1) & shapes->slot_mask;
+    }
+    return found;
+}
+
+// The words of `bytes` bytes.
+static inline uint32_t node_shape_padded(uint32_t bytes)
+{
+    return (bytes + 7) / 8;
+}
+
+// `entry`'s entries onto the machine's tape for the current expression, whose key found it: its values, kinds and
+// classes as they are, then this expression's leaves' objects and symbols into the entries its patches name; its labels'
+// entries; its calls' records and their symbols; and its counts.
+static inline __attribute__((always_inline)) void node_shape_instantiate(NodeMachine* machine, NodeShapes* shapes, const NodeShapeEntry* entry)
+{
+    const uint32_t count = entry->entry_count;
+    const uint64_t* values = (const uint64_t*)(entry + 1) + entry->words;
+    const uint8_t* kinds = (const uint8_t*)(values + count);
+    const uint8_t* classes = kinds + 8 * (uint64_t)node_shape_padded(count);
+    const uint32_t* patches = (const uint32_t*)(classes + 8 * (uint64_t)node_shape_padded(count));
+    const uint32_t* labels = patches + 2 * (uint64_t)node_shape_padded(4 * (uint32_t)entry->patch_count);
+    const uint32_t* calls = labels + 2 * (uint64_t)node_shape_padded(4 * (uint32_t)entry->label_count);
+    // Whole words: the store pads each, and the tape has a row's room past its last entry.
+    for (uint32_t i = 0; i < count; i += 8)
+    {
+        memcpy(machine->tape + i, values + i, 64);
+        memcpy(machine->kinds + i, kinds + i, 8);
+        memcpy(machine->classes + i, classes + i, 8);
+    }
+    for (uint32_t p = 0; p < entry->patch_count; p += 1)
+    {
+        const uint32_t patch = patches[p];
+        const uint32_t leaf = (patch >> 16) & BUSTER_NODE_SHAPE_NO_LEAF;
+        machine->tape[patch & UINT16_MAX] = (patch & BUSTER_NODE_SHAPE_PATCH_SYMBOL) != 0 ? shapes->leaf_symbols[leaf] : shapes->leaf_objects[leaf];
+    }
+    for (uint32_t l = 0; l < entry->label_count; l += 1)
+    {
+        machine->label_entries[l] = labels[l];
+    }
+    for (uint32_t c = 0; c < entry->call_count; c += 1)
+    {
+        const uint32_t leaf = calls[c] >> 16;
+        machine->call_records[c] = calls[c] & UINT16_MAX;
+        shapes->call_symbols[c] = leaf != BUSTER_NODE_SHAPE_NO_LEAF ? shapes->leaf_symbols[leaf] : 0;
+    }
+    machine->entry_count = count;
+    machine->label_count = entry->label_count;
+    machine->call_count = entry->call_count;
+    machine->temporary_count = entry->temporary_count;
+}
+
+// Whether an entry of kind `kind` names a local's object, and whether a global's symbol.
+static inline bool node_shape_names_object(uint8_t kind)
+{
+    return kind == BUSTER_TYPED_LOCAL || kind == BUSTER_TYPED_LOCAL_ADDRESS || kind == BUSTER_TYPED_STORE_LOCAL || kind == BUSTER_TYPED_SET_LOCAL;
+}
+
+static inline bool node_shape_names_symbol(uint8_t kind)
+{
+    return kind == BUSTER_TYPED_GLOBAL || kind == BUSTER_TYPED_GLOBAL_ADDRESS || kind == BUSTER_TYPED_STORE_GLOBAL || kind == BUSTER_TYPED_SET_GLOBAL;
+}
+
+// The current expression's entry, after the sweeps took it with `actions` nodes typed by the action since its T began:
+// kept in the unit's shapes where its key decides the sweeps' answer (the file's comment), with `nodes` its evaluated
+// nodes. An entry that names an object or a symbol takes a patch from the first leaf with that object or symbol: the key
+// holds which leaves share one, so any expression of the key has the same there.
+static __attribute__((noinline)) NodeShapeReason node_shape_insert(NodeMachine* machine, NodeShapes* shapes, uint64_t actions, uint32_t nodes)
+{
+    const uint32_t count = machine->entry_count;
+    const uint32_t labels = machine->label_count;
+    const uint32_t calls = machine->call_count;
+    const uint32_t leaves = shapes->leaf_count;
+    NodeShapeReason reason = shapes->reason != NODE_SHAPE_KEPT ? shapes->reason :
+                             actions != 0 ? NODE_SHAPE_ACTION :
+                             machine->wide_count != 0 ? NODE_SHAPE_WIDE :
+                             machine->incomplete != 0 ? NODE_SHAPE_INCOMPLETE :
+                             count > UINT16_MAX || labels > UINT16_MAX || calls > UINT16_MAX || machine->temporary_count > UINT16_MAX ? NODE_SHAPE_ROOM : NODE_SHAPE_KEPT;
+    const uint64_t most = sizeof(NodeShapeEntry) / 8 + shapes->words + (uint64_t)count + 2 * (uint64_t)node_shape_padded(count) + node_shape_padded(4 * count) +
+                          node_shape_padded(4 * labels) + node_shape_padded(4 * calls);
+    reason = reason == NODE_SHAPE_KEPT && (shapes->store_words + most > shapes->store_capacity || shapes->store_words + most > UINT32_MAX || 2 * shapes->filled > shapes->slot_mask) ?
+             NODE_SHAPE_ROOM : reason;
+    if (reason == NODE_SHAPE_KEPT)
+    {
+        NodeShapeEntry* entry = (NodeShapeEntry*)(shapes->store + shapes->store_words);
+        uint64_t* values = (uint64_t*)(entry + 1) + shapes->words;
+        uint8_t* kinds = (uint8_t*)(values + count);
+        uint8_t* classes = kinds + 8 * (uint64_t)node_shape_padded(count);
+        uint32_t* patches = (uint32_t*)(classes + 8 * (uint64_t)node_shape_padded(count));
+        uint32_t patch_count = 0;
+        memcpy(entry + 1, shapes->key, (uint64_t)shapes->words * sizeof(uint64_t));
+        memset(kinds, 0, 16 * (uint64_t)node_shape_padded(count));
+        for (uint32_t i = 0; i < count; i += 1)
+        {
+            const uint8_t kind = machine->kinds[i];
+            const uint64_t value = machine->tape[i];
+            const bool object = node_shape_names_object(kind) && (value & BUSTER_NODE_MACHINE_TEMPORARY) == 0;
+            const bool symbol = node_shape_names_symbol(kind);
+            values[i] = value;
+            kinds[i] = kind;
+            classes[i] = machine->classes[i];
+            if (object || symbol)
+            {
+                const uint32_t* named = object ? shapes->leaf_objects : shapes->leaf_symbols;
+                uint32_t leaf = 0;
+                while (leaf < leaves && named[leaf] != value)
+                {
+                    leaf += 1;
+                }
+                reason = leaf == leaves || value == 0 ? NODE_SHAPE_UNRESOLVED : reason;
+                patches[patch_count] = i | leaf << 16 | (symbol ? BUSTER_NODE_SHAPE_PATCH_SYMBOL : 0);
+                patch_count += 1;
+            }
+        }
+        uint32_t* label_entries = patches + 2 * (uint64_t)node_shape_padded(4 * patch_count);
+        uint32_t* call_rows = label_entries + 2 * (uint64_t)node_shape_padded(4 * labels);
+        for (uint32_t l = 0; l < labels; l += 1)
+        {
+            label_entries[l] = machine->label_entries[l];
+        }
+        for (uint32_t c = 0; c < calls; c += 1)
+        {
+            // Its symbol is its direct callee's object's, a leaf's.
+            const uint32_t record = machine->call_records[c];
+            const uint32_t callee = node_machine_direct_callee(machine, node_machine_record_left(machine, record));
+            uint32_t leaf = BUSTER_NODE_SHAPE_NO_LEAF;
+            if (callee != 0)
+            {
+                leaf = 0;
+                while (leaf < leaves && shapes->leaf_objects[leaf] != callee)
+                {
+                    leaf += 1;
+                }
+                reason = leaf == leaves ? NODE_SHAPE_UNRESOLVED : reason;
+            }
+            call_rows[c] = record | leaf << 16;
+        }
+        if (reason == NODE_SHAPE_KEPT)
+        {
+            const uint64_t used = (uint64_t)((uint64_t*)(call_rows + 2 * (uint64_t)node_shape_padded(4 * calls)) - shapes->store);
+            *entry = (NodeShapeEntry){
+                .hash = shapes->hash,
+                .words = shapes->words,
+                .entry_count = count,
+                .patch_count = (uint16_t)patch_count,
+                .label_count = (uint16_t)labels,
+                .call_count = (uint16_t)calls,
+                .temporary_count = (uint16_t)machine->temporary_count,
+                .nodes = nodes,
+            };
+            uint32_t slot = (uint32_t)shapes->hash & shapes->slot_mask;
+            while (shapes->tags[slot] != 0)
+            {
+                slot = (slot + 1) & shapes->slot_mask;
+            }
+            shapes->tags[slot] = (uint32_t)(shapes->hash >> 32) | 1;
+            shapes->offsets[slot] = (uint32_t)shapes->store_words;
+            shapes->store_words = used;
+            shapes->filled += 1;
+        }
+    }
+    return reason;
+}
+
+#endif
