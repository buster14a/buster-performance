+// The fused sweep's census (docs/node-machine.md, "A fused sweep: what it would settle later"): for a taken expression,
+// what a T that classified each record's operands, as C does, at the record's own visit, up the postorder, would leave to
+// a later step. A record's consumer decides its context and target, but where they are the consumer's own context (a
+// SELECT's operand and a comma's second operand, check_lower_template_classify's), which its consumer's consumer gives
+// later; a record its consumer doesn't evaluate costs that visit nothing, but one whose consumer isn't evaluated either
+// was classified for nothing; and a call's depth among the evaluated calls, which numbers its row, is its ancestors'.
+static void node_shadow_fusion(NodeShadow* shadow, NodeCensusScratch* s, const NodeMachine* machine)
+{
+    const uint32_t count = machine->count;
+    uint32_t* consumers = s->consumers;
+    for (uint32_t r = 0; r < count; r += 1)
+    {
+        consumers[r] = UINT32_MAX;
+    }
+    for (uint32_t r = 0; r < count; r += 1)
+    {
+        const CheckOp op = node_machine_record_op(machine, r);
+        const uint32_t operands[3] = {
+            node_machine_record_left(machine, r),
+            node_machine_record_right(machine, r),
+            op == CHECK_OP_CONDITIONAL ? node_machine_record_third(machine, r) : UINT32_MAX,
+        };
+        for (uint32_t k = 0; k < 3; k += 1)
+        {
+            if (operands[k] < r)
+            {
+                consumers[operands[k]] = r;
+            }
+        }
+        for (uint32_t i = 0; op == CHECK_OP_CALL && i < node_machine_record_argument_count(machine, r); i += 1)
+        {
+            const uint32_t argument = node_machine_record_argument(machine, r, i);
+            if (argument < r)
+            {
+                consumers[argument] = r;
+            }
+        }
+    }
+    uint64_t settled = 0;
+    for (uint32_t r = 0; r < count; r += 1)
+    {
+        const uint8_t state = node_machine_record_state(machine, r);
+        const bool evaluated = (state & BUSTER_NODE_MACHINE_EVALUATED) != 0;
+        const uint32_t consumer = consumers[r];
+        const bool consumer_evaluated = consumer < count && (node_machine_record_state(machine, consumer) & BUSTER_NODE_MACHINE_EVALUATED) != 0;
+        const CheckOp consumer_op = consumer < count ? node_machine_record_op(machine, consumer) : CHECK_OP_COUNT;
+        const bool inherited = evaluated && (consumer_op == CHECK_OP_SELECT || (consumer_op == CHECK_OP_COMMA && r == node_machine_record_right(machine, consumer)));
+        const bool wasted = !evaluated && consumer < count && !consumer_evaluated;
+        const bool nested = evaluated && node_machine_record_op(machine, r) == CHECK_OP_CALL && node_machine_record_call_depth(machine, r) != 0;
+        shadow->fusion_evaluated += evaluated;
+        shadow->fusion_unevaluated += !evaluated;
+        shadow->fusion_wasted += wasted;
+        shadow->fusion_inherited += inherited;
+        shadow->fusion_inherited_other += inherited && node_machine_record_context(machine, r) != 0;
+        shadow->fusion_calls += evaluated && node_machine_record_op(machine, r) == CHECK_OP_CALL;
+        shadow->fusion_nested_calls += nested;
+        shadow->fusion_hooked += evaluated && state > BUSTER_NODE_MACHINE_EVALUATED;
+        settled += inherited || wasted || nested;
+    }
+    shadow->fusion_updates += machine->update_count;
+    shadow->fusion_settled_expressions += settled != 0;
+}
+
+// --shapes: the current expression's key and, where the unit's shapes have it, its tape from them, kept aside for
+// node_shadow_shape's comparison. The entry, or null.
+static NodeShapeEntry* node_shadow_shape_ask(NodeCensusScratch* s, uint32_t first, uint32_t root, uint32_t records, uint8_t context, TypeId target, uint32_t object)
+{
+    NodeMachine* machine = s->machine;
+    NodeShapes* shapes = s->shapes;
+    NodeShapeEntry* entry = node_shape_key(machine, shapes, first, root, records, context, target, object) ? node_shape_find(shapes) : NULL;
+    if (entry != NULL)
+    {
+        node_shape_instantiate(machine, shapes, entry);
+        memcpy(s->shape_kinds, machine->kinds, machine->entry_count);
+        memcpy(s->shape_classes, machine->classes, machine->entry_count);
+        memcpy(s->shape_tape, machine->tape, (uint64_t)machine->entry_count * sizeof(uint64_t));
+        memcpy(s->shape_labels, machine->label_entries, (uint64_t)machine->label_count * sizeof(uint32_t));
+        memcpy(s->shape_calls, machine->call_records, (uint64_t)machine->call_count * sizeof(uint32_t));
+        memcpy(s->shape_symbols, shapes->call_symbols, (uint64_t)machine->call_count * sizeof(uint32_t));
+        s->shape_counts[0] = machine->entry_count;
+        s->shape_counts[1] = machine->label_count;
+        s->shape_counts[2] = machine->call_count;
+        s->shape_counts[3] = machine->temporary_count;
+    }
+    return entry;
+}
+
+// --shapes' census of looser keys, for a taken expression of `nodes` evaluated nodes whose key is the shapes' current one
+// (three words a record, then the root's two; a call's arguments' words aren't told apart from records', which only
+// moves which words a variant drops): each variant's hash, counted where the unit had it before.
+static void node_shadow_shape_variants(NodeShadow* shadow, NodeCensusScratch* s, uint32_t nodes)
+{
+    const NodeShapes* shapes = s->shapes;
+    const uint64_t* key = shapes->key;
+    const uint32_t words = shapes->words;
+    for (uint32_t v = 0; v < BUSTER_NODE_SHADOW_VARIANTS; v += 1)
+    {
+        uint64_t hash = UINT64_C(0x9e3779b97f4a7c15) + v;
+        for (uint32_t w = 0; w + 2 < words; w += 3)
+        {
+            const bool leaf = (uint8_t)key[w + 2] == CHECK_OP_VALUE;
+            uint64_t word0 = key[w];
+            uint64_t word1 = key[w + 1];
+            uint64_t word2 = key[w + 2];
+            if (v >= 1 && v <= 3 && leaf)
+            {
+                word1 = 0;
+            }
+            if (v >= 2 && v <= 3 && !leaf)
+            {
+                word0 = 0;
+            }
+            if (v == 3 && leaf)
+            {
+                word0 = 0;
+            }
+            if (v == 4 && leaf)
+            {
+                word2 &= 0xffffffu;
+            }
+            hash = node_shape_mix(node_shape_mix(node_shape_mix(hash, word0), word1), word2);
+        }
+        hash = node_shape_mix(node_shape_mix(hash, key[words - 2] & (v == 4 ? UINT64_C(0xffffff) : UINT64_MAX)), key[words - 1]);
+        hash |= 1;
+        uint64_t* set = s->shape_variants[v];
+        uint32_t slot = (uint32_t)(hash >> 20) & s->shape_variant_mask;
+        while (set[slot] != 0 && set[slot] != hash)
+        {
+            slot = (slot + 1) & s->shape_variant_mask;
+        }
+        shadow->shape_variant_hits[v] += set[slot] == hash;
+        shadow->shape_variant_nodes[v] += set[slot] == hash ? nodes : 0;
+        set[slot] = hash;
+    }
+}
+
+// --shapes, after the sweeps ran on the expression (`refusal`, `actions` of its nodes typed by the action, `records`
+// records, `nodes` evaluated nodes): a hit's tape, labels and calls compared with the sweeps', which are its exact twin;
+// any other taken expression kept as a new shape where its key decides its answer.
+static void node_shadow_shape(NodeShadow* shadow, NodeCensusScratch* s, NodeShapeEntry* entry, NodeMachineRefusal refusal, uint64_t actions, uint32_t records, uint32_t nodes)
+{
+    NodeMachine* machine = s->machine;
+    const uint32_t size = records <= 5 ? records - 1 : records <= 8 ? 5 : records <= 16 ? 6 : records <= 32 ? 7 : 8;
+    shadow->shape_probes += 1;
+    shadow->shape_sizes[size][0] += refusal == NODE_MACHINE_TAKEN;
+    shadow->shape_sizes[size][2] += refusal == NODE_MACHINE_TAKEN ? nodes : 0;
+    if (entry != NULL)
+    {
+        bool same = refusal == NODE_MACHINE_TAKEN && machine->entry_count == s->shape_counts[0] && machine->label_count == s->shape_counts[1] &&
+                    machine->call_count == s->shape_counts[2] && machine->temporary_count == s->shape_counts[3];
+        same = same && memcmp(s->shape_kinds, machine->kinds, machine->entry_count) == 0 && memcmp(s->shape_classes, machine->classes, machine->entry_count) == 0 &&
+               memcmp(s->shape_tape, machine->tape, (uint64_t)machine->entry_count * sizeof(uint64_t)) == 0 &&
+               memcmp(s->shape_labels, machine->label_entries, (uint64_t)machine->label_count * sizeof(uint32_t)) == 0 &&
+               memcmp(s->shape_calls, machine->call_records, (uint64_t)machine->call_count * sizeof(uint32_t)) == 0;
+        for (uint32_t c = 0; same && c < machine->call_count; c += 1)
+        {
+            same = s->shape_symbols[c] == node_machine_call_target(machine, machine->call_records[c]);
+        }
+        entry->uses += 1;
+        shadow->shape_hits += 1;
+        shadow->shape_hit_nodes += nodes;
+        shadow->shape_hit_entries += s->shape_counts[0];
+        shadow->shape_differences += !same;
+        shadow->shape_sizes[size][1] += 1;
+        shadow->shape_sizes[size][3] += nodes;
+        if (!same && shadow->listed < node_census_list)
+        {
+            shadow->listed += 1;
+            printf("node-shadow: shape difference file=%s line=%u refusal=%s entries=%u (shape %u) labels=%u (%u) calls=%u (%u)\n", s->file,
+                   node_census_line(s->pp, s->program->parser, s->program->input->graph.tokens[node_machine_node(machine, machine->count - 1)]),
+                   node_machine_refusal_names[refusal], machine->entry_count, s->shape_counts[0], machine->label_count, s->shape_counts[1], machine->call_count,
+                   s->shape_counts[2]);
+        }
+    }
+    else if (refusal == NODE_MACHINE_TAKEN)
+    {
+        const NodeShapeReason reason = node_shape_insert(machine, s->shapes, actions, nodes);
+        shadow->shape_reasons[reason] += 1;
+        shadow->shape_reason_nodes[reason] += nodes;
+    }
+    if (refusal == NODE_MACHINE_TAKEN && s->shapes->reason != NODE_SHAPE_SIZE)
+    {
+        node_shadow_shape_variants(shadow, s, nodes);
+    }
+}
