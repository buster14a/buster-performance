+// any other taken expression kept as a new shape where its key decides its answer.
+static void node_shadow_shape(NodeShadow* shadow, NodeCensusScratch* s, NodeShapeEntry* entry, NodeMachineRefusal refusal, uint64_t actions, uint32_t records, uint32_t nodes)
