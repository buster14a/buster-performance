+    hash = node_shape_mix(hash, (uint64_t)columns->value_types[r] | (uint64_t)columns->value_flags[r] << 32);
+    hash = node_shape_mix(hash, (uint64_t)columns->objects[r] | (uint64_t)columns->lowest[r] << 32);
+    if ((standing & BUSTER_NODE_MACHINE_WIDE) != 0)
+    {
+        CheckValue value;
+        node_machine_record_value(machine, r, &value);
+        hash = node_shape_mix(hash, (uint64_t)value.type | (uint64_t)value.flags << 32);
+        hash = node_shape_mix(hash, (uint64_t)value.category | (uint64_t)value.constant_kind << 8 | (uint64_t)value.fault << 16 | (uint64_t)value.bit_width << 32);
+        hash = node_shape_mix(hash, (uint64_t)value.integer);
+        hash = node_shape_mix(hash, (uint64_t)(value.integer >> 64));
+        hash = node_shape_mix(hash, value.floating_storage[0]);
+        hash = node_shape_mix(hash, value.floating_storage[1] & 0xffffu);
+        hash = node_shape_mix(hash, value.imaginary_storage[0]);
+        hash = node_shape_mix(hash, value.imaginary_storage[1] & 0xffffu);
+        hash = node_shape_mix(hash, (uint64_t)value.object | (uint64_t)value.overload_head << 32);
+        hash = node_shape_mix(hash, (uint64_t)value.offset);
+        hash = node_shape_mix(hash, (uint64_t)value.fault_node | (uint64_t)value.object_bit_offset << 32);
+    }
+    else
+    {
+        hash = node_shape_mix(hash, columns->payloads[r]);
+        hash = node_shape_mix(hash, (standing & BUSTER_NODE_MACHINE_FIELD) == BUSTER_NODE_MACHINE_FLOATING ? columns->exponents[r] : 0);
+    }
+    hash = node_shape_mix(hash, (uint64_t)columns->converted[2 * r] | (uint64_t)columns->converted[2 * r + 1] << 32);
+    hash = node_shape_mix(hash, (uint64_t)columns->conversion_flags[2 * r] | (uint64_t)columns->conversion_flags[2 * r + 1] << 32);
+    hash = node_shape_mix(hash, columns->member_offsets[r]);
