+        const uint32_t count = columns->argument_counts[r];
+        hash = node_shape_mix(hash, count);
+        for (uint32_t i = 0; i < count; i += 1)
+        {
+            hash = node_shape_mix(hash, (uint64_t)node_machine_record_argument(machine, r, i) | (uint64_t)node_machine_record_argument_converted(machine, r, i) << 32);
+            hash = node_shape_mix(hash, node_machine_record_argument_conversion_flags(machine, r, i));
+        }
+    }
+    return hash;
+}
