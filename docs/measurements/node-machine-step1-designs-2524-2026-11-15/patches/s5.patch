+// A record's class for --lanes: the operators one vector step could take together.
+static uint32_t node_shadow_lane_class(const CheckGraph* graph, uint32_t node)
+{
+    const CheckOp op = graph->ops[node];
+    uint32_t class = 11;
+    switch (op)
+    {
+        case CHECK_OP_VALUE: class = 0; break;
+        case CHECK_OP_CAST: class = graph->types != NULL && graph->types[node] == BUSTER_TYPE_VOID ? 1 : 2; break;
+        case CHECK_OP_MEMBER: case CHECK_OP_ARROW: class = 3; break;
+        case CHECK_OP_CALL: class = 4; break;
+        case CHECK_OP_CONDITION: case CHECK_OP_NOT: class = 5; break;
+        case CHECK_OP_ASSIGN: case CHECK_OP_INITIALIZE: case CHECK_OP_CONVERT: class = 6; break;
+        case CHECK_OP_ADD: case CHECK_OP_SUBTRACT: case CHECK_OP_SUBSCRIPT: class = 7; break;
+        case CHECK_OP_ADDRESS: case CHECK_OP_DEREFERENCE: class = 9; break;
+        case CHECK_OP_LOGICAL_AND: case CHECK_OP_LOGICAL_OR: class = 10; break;
+        default: class = node_machine_row_operators[op] != NODE_MACHINE_ROW_NONE ? 8 : 11; break;
+    }
+    return class;
+}
