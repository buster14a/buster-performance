+static int node_shadow_shape_order(const void* left, const void* right)
+{
+    const uint64_t a = *(const uint64_t*)left;
+    const uint64_t b = *(const uint64_t*)right;
+    return a < b ? 1 : a > b ? -1 : 0;
+}
