+        tests->types = types;
+        tests->program.input = input;
+        tests->program.parser = reader->parser;
+        tests->program.types = reader->types;
+        tests->program.object_symbols = (SymbolId*)machine->object_symbols;
+        tests->program.object_count = machine->object_count;
