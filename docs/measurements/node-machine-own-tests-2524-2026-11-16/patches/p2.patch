+            shadow->tested_listed += 1;
+            printf("node-shadow: reader-time tests difference file=%s line=%u %s tests=%#" PRIx64 " (reader %#" PRIx64 ") kind=%s (reader %s) reader-takes=%s%s\n", s->file,
