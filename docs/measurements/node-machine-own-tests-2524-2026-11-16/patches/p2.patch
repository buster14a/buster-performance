+        tests->pragma_openings = arena_push_array(arena, (uint64_t)pragmas + 1, sizeof(uint32_t), _Alignof(uint32_t));
+        tests->pragma_closings = arena_push_array(arena, (uint64_t)pragmas + 1, sizeof(uint32_t), _Alignof(uint32_t));
