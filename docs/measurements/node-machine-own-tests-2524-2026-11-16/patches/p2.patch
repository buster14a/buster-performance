+        {
+            shadow->tested_reader_alone[__builtin_ctzll(bits)] += 1;
+        }
+        for (uint64_t bits = census_alone | (census & lowering); bits != 0; bits &= bits - 1)
+        {
+            shadow->tested_census_alone[__builtin_ctzll(bits)] += 1;
+        }
