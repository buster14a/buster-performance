+static inline uint64_t node_machine_mix(uint64_t digest, uint64_t value)
+{
+    const uint64_t mixed = (digest ^ value) * UINT64_C(0x9e3779b97f4a7c15);
+    return mixed ^ (mixed >> 29);
+}
