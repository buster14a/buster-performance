== test-checker-deferred [3 CPUs]
unset CPATH C_INCLUDE_PATH
./build/compiler test-checker-deferred
== test-check-lanes [3 CPUs]
unset CPATH C_INCLUDE_PATH
./build/compiler test-check-lanes
== checker-corpus deferred c-testsuite
unset CPATH C_INCLUDE_PATH
./build/compiler test-checker-corpus --clang clang --deferred 8 --id-order 153 build/c-testsuite/tests/single-exec
== c-testsuite cross-check [4 CPUs]
unset CPATH C_INCLUDE_PATH
./build/compiler test-c-testsuite --cross-check --clang clang --jobs "$BUSTER_PARALLEL_CPUS" --subset tests/c-testsuite/subset.txt build/c-testsuite
== test-check-units corpus [4 CPUs]
unset CPATH C_INCLUDE_PATH
./build/compiler test-check-units --corpus build/c-testsuite/tests/single-exec
== check-call-graph [4 CPUs]
./build.sh check-call-graph
