./build/compiler test-checker --seed 133 --part 1/4
== test-checker part 2/4
unset CPATH C_INCLUDE_PATH
./build/compiler test-checker --seed 133 --part 2/4
== test-checker part 3/4
unset CPATH C_INCLUDE_PATH
./build/compiler test-checker --seed 133 --part 3/4
== test-checker part 4/4
