diff --git a/CMakeLists.txt b/CMakeLists.txt
index c7b22969..fe877cb6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -268,7 +268,14 @@ endforeach()
 # doesn't load libm.so.6 at its start, 24 microseconds and 12 page faults on the 9700X; a build whose code still calls
 # libm (the baseline host's rounding functions, a fuzzing runtime) takes it.
 function(buster_link_arguments before after)
-    set(${before} ${buster_link_mode} ${buster_sanitizer_flags} ${buster_linker_flags} PARENT_SCOPE)
+    set(script "")
+    if(DEFINED ENV{BUSTER_LINK_SCRIPT} AND NOT "$ENV{BUSTER_LINK_SCRIPT}" STREQUAL "")
+        set(script "-Wl,-T,$ENV{BUSTER_LINK_SCRIPT}")
+    endif()
+    if(DEFINED ENV{BUSTER_LINK_SYMBOLS} AND NOT "$ENV{BUSTER_LINK_SYMBOLS}" STREQUAL "")
+        list(APPEND script "-Wl,--symbol-ordering-file=$ENV{BUSTER_LINK_SYMBOLS}" -Wl,--no-warn-symbol-ordering)
+    endif()
+    set(${before} ${buster_link_mode} ${buster_sanitizer_flags} ${buster_linker_flags} ${script} PARENT_SCOPE)
     set(${after} ${buster_fuzz_libraries} -Wl,--push-state,--as-needed -lm -Wl,--pop-state -ldl PARENT_SCOPE)
 endfunction()
 
