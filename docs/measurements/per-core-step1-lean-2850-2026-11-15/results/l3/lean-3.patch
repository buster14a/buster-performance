+
+// The kernel over window `window` as variant `mode`: by classes (WHOLE, LEAN, LOADS) or the loads in order (ORDERED).
+static void node_facts_window(NodeFacts* facts, uint32_t window, uint32_t mode, bool split)
+{
+    if (mode == BUSTER_NODE_FACTS_ORDERED)
+    {
+        node_facts_window_ordered(facts, window, split);
+    }
+    else
+    {
+        node_facts_window_classes(facts, window, mode, split);
+    }
