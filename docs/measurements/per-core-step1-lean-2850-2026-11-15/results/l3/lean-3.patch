+        // arguments' count.
+        const uint32_t wanted = BUSTER_NODE_FACTS_FUNCTION | BUSTER_NODE_FACTS_RETURNS | BUSTER_TYPE_FLAG_PROTOTYPE << 8;
+        const uint32_t exact = ~(function >> 8) & BUSTER_TYPE_FLAG_VARIADIC;
+        const uint32_t refused = (~function & wanted) | (count < parameters ? 1u : 0u) | (count != parameters ? exact : 0u);
+        const uint32_t unfit = (fits[w] == 0 ? 1u : 0u) | (~(row->flags >> 16) & load.wanted) | ((ready > position ? 1u : 0u) & timed) | (missing & member) | (refused & called) |
+                               ((right[w] == 0 ? 1u : 0u) & indexed);
