+// The loads' kernel in order over window `window`: its leaves, then its lookups as the list has them, with no class
+// and no dispatch (node_facts_loads_run), a lookup that isn't its load's by its rule where it comes.
+static __attribute__((noinline)) void node_facts_window_ordered(NodeFacts* facts, uint32_t window, bool split)
+{
+    const uint32_t first = facts->windows[window];
+    const uint32_t count = facts->windows[window + 1] - first;
+    uint32_t leaves = 0;
+    uint32_t lookups = 0;
+    const uint64_t t0 = split ? __rdtsc() : 0;
+    node_facts_list(facts->leaf_list, facts->lookup_list, facts->keys, facts->kinds + first, facts->classes + first, count, false, &leaves, &lookups);
