+// The loads' kernel in order: the window's lookups from the list's `from`, as the list has them (their records' order,
+// so that a lookup's operands are made before it), each by one body that has no branch on its operator. What the
+// operator asks of its operand's type's row comes from the operator's word (node_facts_load_of); a member's slot is
+// its place or the next, probed with no loop (an access whose slot is further is its rule's); and the result's type,
+// its word and a member's offset are stored whatever the tests say, since a lookup that fails one is made whole by its
+// rule. Where in the list the first lookup that isn't its load's is, or `lookups`: the caller makes that one by its
+// rule and goes on after it, so that no call is in this loop.
+static __attribute__((noinline)) uint32_t node_facts_loads_run(NodeFacts* facts, uint32_t first, uint32_t from, uint32_t lookups)
+{
+    NodeFactsRecord* const records = facts->records;
+    const uint32_t* const lookup_list = facts->lookup_list;
+    const uint8_t* const ops = facts->ops + first;
+    const uint8_t* const fits = facts->fits + first;
+    const uint16_t* const left = facts->left + first;
+    const uint16_t* const right = facts->right + first;
+    const NodeFactsView view = node_facts_view(facts, first);
+    const uint64_t last = (UINT64_C(1) << view.member_bits) - 1;
+    uint32_t i = from;
+    bool fit = true;
+    while (fit && i < lookups)
+    {
+        const uint32_t w = lookup_list[i];
+        const NodeFactsLoad load = node_facts_load_of[ops[w]];
+        const uint32_t shape = load.shape;
+        const TypeId type = records[w - left[w]].type;
+        const NodeFactsRow* row = node_facts_row_of(&view, type);
+        const uint32_t position = view.positions[w];
+        const uint32_t count = view.counts[w];
+        const uint32_t function = row->function;
+        const uint32_t parameters = function >> 16;
+        uint32_t ready = 0;
+        memcpy(&ready, (const uint8_t*)row + load.ready, sizeof(ready));
+        // The operator's shape as masks: each choice below is arithmetic, where a branch on the operator would be one the
+        // predictor misses.
+        const uint32_t member = 0u - (shape & 1u);
+        const uint32_t element = 0u - (shape >> 1 & 1u);
+        const uint32_t indexed = 0u - (shape >> 2 & 1u);
+        const uint32_t called = 0u - (shape >> 3 & 1u);
+        const uint32_t timed = 0u - (shape >> 4 & 1u);
+        // A member's slot: its record's and its name's place, or the next. A lookup of no member reads the first two.
+        const TypeId holder = type ^ ((type ^ row->element) & element);
+        const uint64_t key = (uint64_t)holder << 32 | view.inputs[w];
+        const uint64_t home = ((key * UINT64_C(0x9e3779b97f4a7c15)) >> (64 - view.member_bits)) & (uint64_t)(int64_t)(int32_t)member;
+        const NodeFactsMember* slot = view.members + home;
+        const NodeFactsMember* next = view.members + ((home + 1) & last);
+        const uintptr_t first_hit = 0 - (uintptr_t)(slot->key == key ? 1u : 0u);
+        const NodeFactsMember* kept = (const NodeFactsMember*)((uintptr_t)next ^ (((uintptr_t)next ^ (uintptr_t)slot) & first_hit));
+        const uint32_t missing = (kept->key != key ? 1u : 0u) | ((kept->flags ^ BUSTER_NODE_FACTS_MEMBER_FOUND) & (BUSTER_NODE_FACTS_MEMBER_FOUND | BUSTER_NODE_FACTS_MEMBER_BIT_FIELD));
