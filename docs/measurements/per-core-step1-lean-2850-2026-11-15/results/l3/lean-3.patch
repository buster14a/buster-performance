+        const uint64_t qualified = type_qualifiers(type) & indexed & (0u - (row->flags >> 18 & 1u));
+        uint64_t made = 0;
+        uint64_t offset = 0;
+        memcpy(&made, source, sizeof(made));
+        memcpy(&offset, source + sizeof(made), sizeof(offset));
+        node_facts_store(records + w, 0, made | qualified);
+        node_facts_store(records + w, 48, offset & (uint64_t)(int64_t)(int32_t)member);
+        // The place moves on whatever the tests say: a place that waited for them would have each lookup wait for the
+        // one before it, its loads and all.
+        fit = unfit == 0;
