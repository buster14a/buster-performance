+
+// An expression's stop/unknown facts only matter when its body's control flow can reach the
+// implicit return with all expressions returning. Cache the demanded operands in postorder.
+// A deep tree uses the existing dense pass and reuses the same fact buffer.
+#define CHECK_RETURN_FACT_READY 0x80u
+
+typedef struct CheckReturnDemand CheckReturnDemand;
+struct CheckReturnDemand
+{
+    bool enabled;
+    bool dense;
+    bool allowed;
+    Arena storage;
+    bool report;
+    uint8_t* facts;
+    const uint8_t* ordinary;
+    const uint8_t* oracle;
+    const uint32_t* unknowns;
+    const uint8_t* names;
+    uint64_t* work;
+    uint64_t bodies, sealed, coarse, exact, controls, demanded, roots, deep;
+};
+
+static uint8_t check_program_return_demand(CheckProgram* program, CheckReturnDemand* demand, uint32_t root)
+{
+    const CheckGraph* graph = &program->input->graph;
+    if (root >= graph->count)
+        return 0;
+    if (!demand->enabled || !demand->allowed)
+        return demand->ordinary != NULL ? demand->ordinary[root] : 0;
+    if (demand->facts == NULL)
+    {
+        // Acquire the warning's working storage only after a body can fall through. One region
+        // owns the cache across interleaved body windows and is released with the control writer.
+        const uint64_t names = program->identifiers != NULL ? program->identifiers->count : 0;
+        const uint64_t size = (uint64_t)graph->count + 1u + ((uint64_t)program->input->token_count + 1u) * sizeof(uint32_t) + names + 3u * 64u;
+        demand->storage = arena_reserve(size);
+        demand->facts = BUSTER_ARENA_PUSH_ARRAY(&demand->storage, uint8_t, (uint64_t)graph->count + 1u);
+        uint32_t* first_unknown = NULL;
+        if (demand->facts == NULL || !check_program_return_unknowns(program, &demand->storage, &first_unknown))
+        {
+            check_program_fail(program, CHECK_PROGRAM_RESOURCE, 0);
+            demand->allowed = false;
+            return 0;
+        }
+        demand->unknowns = first_unknown;
+        demand->names = check_program_return_library_names(program->identifiers, &demand->storage);
+        memset(demand->facts, 0, (uint64_t)graph->count + 1u);
+    }
+    ++demand->roots;
+    uint8_t* facts = demand->facts;
+    if (!demand->dense && (facts[root] & CHECK_RETURN_FACT_READY) == 0)
+    {
+        struct { uint32_t node, next; } frames[128];
+        uint32_t depth = 1;
+        frames[0].node = root;
+        frames[0].next = 0;
+        while (depth != 0)
+        {
+            const uint32_t node = frames[depth - 1].node;
+            const CheckOp op = graph->ops[node];
+            const bool arguments = graph->argument_offsets != NULL && graph->argument_counts != NULL && check_graph_has_arguments(op);
+            const uint32_t count = arguments ? graph->argument_counts[node] : 0;
+            uint32_t pos = frames[depth - 1].next;
+            uint32_t child = BUSTER_CHECK_NONE;
+            while (pos < 3u + count)
+            {
+                child = pos == 0 ? graph->operand0[node] : pos == 1 ? graph->operand1[node] : pos == 2 ? graph->operand2[node] :
+                        graph->argument_nodes[graph->argument_offsets[node] + pos - 3u];
+                ++pos;
+                if (child < node && (facts[child] & CHECK_RETURN_FACT_READY) == 0)
+                    break;
+                child = BUSTER_CHECK_NONE;
+            }
+            frames[depth - 1].next = pos;
+            if (child != BUSTER_CHECK_NONE)
+            {
+                if (depth == BUSTER_ARRAY_LENGTH(frames))
+                {
+                    check_program_return_sparse(program, facts, demand->unknowns, demand->names, demand->work);
+                    demand->dense = true;
+                    ++demand->deep;
+                    break;
+                }
+                frames[depth].node = child;
+                frames[depth].next = 0;
+                ++depth;
+            }
+            else
+            {
+                facts[node] = (uint8_t)(CHECK_RETURN_FACT_READY | check_program_return_node(program, facts, node, demand->unknowns, demand->names));
+                ++demand->demanded;
+                if (demand->work != NULL)
+                    ++*demand->work;
+                --depth;
+            }
+        }
+    }
+    const uint8_t fact = facts[root] & (BUSTER_CHECK_RETURN_STOPS | BUSTER_CHECK_RETURN_UNKNOWN);
+    if (demand->oracle != NULL && demand->oracle[root] != fact)
+    {
+        fprintf(stderr,"return-demand node %u expected %u got %u\n",root,demand->oracle[root],fact);
+        abort();
+    }
+    return fact;
+}
