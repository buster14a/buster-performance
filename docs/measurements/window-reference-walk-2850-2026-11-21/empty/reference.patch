+// Each bit certifies that the reference walker would return from the node without publishing
+// an object, reaching a statement region, visiting a compound initializer, or raising an error.
+static uint16_t check_reference_window_operand(__m512i operand, __m512i base, __m512i previous, __m512i current)
+{
+    const __m512i offset = _mm512_sub_epi32(operand, base);
+    const __mmask16 near = _mm512_cmplt_epu32_mask(offset, _mm512_set1_epi32(32));
+    const __m512i known = _mm512_permutex2var_epi32(previous, offset, current);
+    return _mm512_cmpeq_epi32_mask(operand, _mm512_set1_epi32(-1)) | (near & _mm512_movepi32_mask(known));
+}
+
+static uint16_t* check_reference_windows(const CheckProgram* program, Arena* scratch)
+{
+    const CheckGraph* graph=&program->input->graph;
+    if (!graph->count || !graph->leaf_slots || !program->input->declaration_bits || program->stream->overload_address_count) return NULL;
+    _Static_assert(sizeof(CheckOp)==4,"graph operators are dword lanes");
+    const uint32_t words=graph->count/16+(graph->count%16!=0);
+    uint16_t* bits=BUSTER_ARENA_PUSH_ARRAY(scratch,uint16_t,words);
+    if (!bits) return NULL;
+    __m512i previous=_mm512_setzero_si512();
+    uint64_t proven=0;
+    for(uint32_t at=0;at<graph->count;at+=16)
+    {
+        const uint32_t left=graph->count-at;
+        const __mmask16 valid=left>=16 ? UINT16_MAX : (__mmask16)((1u<<left)-1);
+        const __m512i ops=_mm512_maskz_loadu_epi32(valid,graph->ops+at);
+        const __m512i base=_mm512_set1_epi32((int32_t)(at-16));
+        const __m512i a=_mm512_maskz_loadu_epi32(valid,graph->operand0+at);
+        const __m512i b=_mm512_maskz_loadu_epi32(valid,graph->operand1+at);
+        const __m512i c=_mm512_maskz_loadu_epi32(valid,graph->operand2+at);
+        // Require all operands neutral, even when ordinary C would discard one arm.
+        const __mmask16 pure=valid & (_mm512_cmple_epu32_mask(ops,_mm512_set1_epi32(CHECK_OP_SUBSCRIPT)) |
+             _mm512_cmpeq_epi32_mask(ops,_mm512_set1_epi32(CHECK_OP_MEMBER)) |
+             _mm512_cmpeq_epi32_mask(ops,_mm512_set1_epi32(CHECK_OP_ARROW)) |
+             (_mm512_cmpge_epu32_mask(ops,_mm512_set1_epi32(CHECK_OP_INITIALIZE)) &
+              _mm512_cmple_epu32_mask(ops,_mm512_set1_epi32(CHECK_OP_SELECT))));
+        const __mmask16 leaves=valid & _mm512_cmpeq_epi32_mask(ops,_mm512_set1_epi32(CHECK_OP_VALUE));
+        const __mmask16 derived=pure & ~leaves;
+        __mmask16 safe=valid & (_mm512_cmpeq_epi32_mask(ops,_mm512_set1_epi32(CHECK_OP_SIZEOF)) |
+                          _mm512_cmpeq_epi32_mask(ops,_mm512_set1_epi32(CHECK_OP_ALIGNOF)));
+        for(uint32_t todo=leaves;todo;todo&=todo-1)
+        {
+            const uint32_t lane=(uint32_t)__builtin_ctz(todo),node=at+lane;
+            const uint32_t object=check_graph_leaf_object(graph,node);
+            if (!object || object>=program->object_count ||
+                (!(check_graph_leaf_flags(graph,node)&BUSTER_CHECK_STATIC_OBJECT) &&
+                 !(program->input->declaration_bits[object-1] & (BUSTER_CHECK_BITS_STATIC|BUSTER_CHECK_BITS_COMPOUND))))
+                safe|=(__mmask16)(1u<<lane);
+        }
+        for (uint32_t pass=0;pass<6;++pass)
+        {
+            const __m512i known=_mm512_movm_epi32(safe);
+            const __mmask16 more=derived & check_reference_window_operand(a,base,previous,known) &
+                 check_reference_window_operand(b,base,previous,known) & check_reference_window_operand(c,base,previous,known);
+            if (!(more & ~safe)) break;
+            safe|=more;
+        }
+        if(program->reference_fault) safe |= leaves;
+        bits[at/16]=safe;
+        previous=_mm512_movm_epi32(safe);
+        proven+=__builtin_popcount((unsigned)safe);
+    }
+    if(getenv("NODE_REF_REPORT")) fprintf(stderr,"reference-proof nodes=%u safe=%llu\n",graph->count,(unsigned long long)proven);
+    return bits;
+}
