diff --git a/src/buster/compiler/lane.c b/src/buster/compiler/lane.c
index b172e7e5..45428793 100644
--- a/src/buster/compiler/lane.c
+++ b/src/buster/compiler/lane.c
@@ -1131,6 +1131,9 @@ static void arena_discard_huge(Arena* arena)
     arena_discard_to(arena, 0, true);
 }
 
+// Whether arena_static_base_pages has advised .bss, written only after its advice, so that the write is a base page's.
+static bool arena_static_advised;
+
 static void arena_static_base_pages(void)
 {
     // The linker's bounds of .bss; its first page may hold .data's last bytes, which are file-backed.
@@ -1138,9 +1141,10 @@ static void arena_static_base_pages(void)
     extern char _end[];
     const uintptr_t begin = ((uintptr_t)__bss_start + BUSTER_ARENA_PAGE_BYTES - 1) & ~(uintptr_t)(BUSTER_ARENA_PAGE_BYTES - 1);
     const uintptr_t end = ((uintptr_t)_end + BUSTER_ARENA_PAGE_BYTES - 1) & ~(uintptr_t)(BUSTER_ARENA_PAGE_BYTES - 1);
-    if (end > begin)
+    if (!arena_static_advised && end > begin)
     {
         madvise((void*)begin, end - begin, MADV_NOHUGEPAGE);
+        arena_static_advised = true;
     }
 }
 
diff --git a/src/buster/compiler/main.c b/src/buster/compiler/main.c
index 2ae3c7c0..a1ac0d56 100644
--- a/src/buster/compiler/main.c
+++ b/src/buster/compiler/main.c
@@ -2524,6 +2524,13 @@ extern int __lsan_do_recoverable_leak_check(void) __attribute__((weak));
 #endif
 static int main_driver(int argc, char** argv)
 {
+    // A source command's .bss in base pages (arena_static_base_pages) before its first write: arena_page_policy's
+    // variables are statics, and their page, written before the advice, took a 2 MB huge page with transparent huge pages
+    // `always` (#1444), one of an empty file's two.
+    if (argc >= 2 && argv[1][0] == '-')
+    {
+        arena_static_base_pages();
+    }
     // Base pages on a virtual machine, or as BUSTER_HUGE_PAGES says (#1109), before any arena is reserved.
     arena_page_policy(getenv("BUSTER_HUGE_PAGES"));
 #if BUSTER_SANITIZER_RESOURCES
