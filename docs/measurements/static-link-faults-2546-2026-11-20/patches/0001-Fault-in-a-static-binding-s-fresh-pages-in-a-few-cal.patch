+// Whether the page at `address` is resident.
+static bool bind_test_resident(const void* address)
+{
+    unsigned char vector = 0;
+    const uintptr_t page = (uintptr_t)address & ~(uintptr_t)(BUSTER_ARENA_PAGE_BYTES - 1);
+    return mincore((void*)page, BUSTER_ARENA_PAGE_BYTES, &vector) == 0 && (vector & 1) != 0;
+}
+
+// Whether a column's pages for `added` records past `count`, `element` bytes each, are resident: its first and its last.
+static bool bind_test_column_resident(const void* records, uint64_t element, uint32_t count, uint32_t added)
+{
+    const uint8_t* first = (const uint8_t*)records + count * element;
+    return added == 0 || (bind_test_resident(first) && bind_test_resident(first + added * element - 1));
+}
+
+// bind_populate (#2546), against a static runtime: after bind_begin on a link of fresh arenas, with every 37th member
+// needed as a closure would mark them, the members' atoms' rooms are committed past the bytes' length and their names'
+// bytes past the name arena's (the peaks there, the lengths kept), and each table's first column's pages for their
+// records faulted in; where the bytes arena has held as much before, nothing: both peaks stay.
+static bool bind_test_populate(const Runtime* runtime)
+{
+    BindTestTally tally = {
+        .check = "populate",
+    };
+    for (uint32_t held = 0; held < 2; held += 1)
+    {
+        BindTestLink test;
+        bool result = bind_test_link_begin(&test, runtime, bind_test_room(runtime));
+        const SymbolId main = result ? bind_test_symbol(&test, "main", BUSTER_LINK_SYMBOL_GLOBAL | BUSTER_LINK_SYMBOL_FUNCTION, BUSTER_LINK_SOURCE_PROGRAM) : 0;
+        result = main != 0 && bind_test_define(&test, main) && bind_begin(&test.bind, &test.link, runtime, BIND_PATH_VECTOR, &test.bytes, 1, &test.arena);
+        bind_test_expect(&tally, result, "a link to populate", held);
+        LinkCapacity added = { 0 };
+        uint64_t name_bytes = 0;
+        uint64_t atom_bytes = 0;
+        for (uint32_t m = 0; result && m < runtime->member_count; m += 37)
+        {
+            const RuntimePiece* piece = &runtime->pieces[RUNTIME_OBJECTS + m];
+            test.bind.members_needed[m / 64] |= 1ull << (m % 64);
+            added.names += piece->end.names - piece->begin.names;
+            added.atoms += piece->end.atoms - piece->begin.atoms;
+            added.symbols += piece->end.symbols - piece->begin.symbols;
+            added.fixups += piece->end.fixups - piece->begin.fixups;
+            added.wide_addends += piece->end.wide_addends - piece->begin.wide_addends;
+            added.priorities += piece->end.priorities - piece->begin.priorities;
+            name_bytes += piece->end.name_bytes - piece->begin.name_bytes;
+            atom_bytes += piece->atom_room;
+        }
+        if (result && held != 0)
+        {
+            const uint64_t length = test.bytes.length;
+            result = arena_push(&test.bytes, atom_bytes, 1) != 0;
+            arena_pop_to(&test.bytes, length);
+        }
+        const uint64_t bytes_length = test.bytes.length;
+        const uint64_t bytes_peak = test.bytes.peak;
+        const uint64_t names_length = test.names.length;
+        if (result)
+        {
+            bind_populate(&test.bind, &test.link);
+        }
+        const Link* link = &test.link;
+        const bool columns = bind_test_column_resident(link->names.bytes, sizeof(*link->names.bytes), link->names.count, added.names) &&
+                             bind_test_column_resident(link->atoms.class, sizeof(*link->atoms.class), link->atoms.count, added.atoms) &&
+                             bind_test_column_resident(link->symbols.name, sizeof(*link->symbols.name), link->symbols.count, added.symbols) &&
+                             bind_test_column_resident(link->fixups.offset, sizeof(*link->fixups.offset), link->fixups.count, added.fixups) &&
+                             bind_test_column_resident(link->fixups.wide_addends, sizeof(*link->fixups.wide_addends), link->fixups.wide_count, added.wide_addends) &&
+                             bind_test_column_resident(link->priorities.atom, sizeof(*link->priorities.atom), link->priorities.count, added.priorities);
+        const bool kept = test.bytes.length == bytes_length && test.names.length == names_length;
+        const bool fresh = test.bytes.peak == bytes_length + atom_bytes && test.names.peak == names_length + name_bytes && columns;
+        const bool untouched = test.bytes.peak == bytes_peak && test.names.peak == names_length;
+        bind_test_expect(&tally, result && atom_bytes != 0 && name_bytes != 0 && kept && (held == 0 ? fresh : untouched),
+                         held == 0 ? "the members' pages weren't faulted in, or the arenas' lengths moved" : "pages were faulted in where the bytes had been held",
+                         held);
+        bind_test_link_end(&test);
+    }
+    // bind_end populates main's members so: after it, the byte arena's peak is at least its length before them plus
+    // their atoms' rooms (bind_populate's push), which their bytes alone don't reach: the rooms hold more than a page of
+    // slack for alignments.
+    BindTestLink bound;
+    bool result = bind_test_link_begin(&bound, runtime, bind_test_room(runtime));
+    const SymbolId main = result ? bind_test_symbol(&bound, "main", BUSTER_LINK_SYMBOL_GLOBAL | BUSTER_LINK_SYMBOL_FUNCTION, BUSTER_LINK_SOURCE_PROGRAM) : 0;
+    result = main != 0 && bind_test_define(&bound, main) && bind_begin(&bound.bind, &bound.link, runtime, BIND_PATH_VECTOR, &bound.bytes, 1, &bound.arena);
+    const uint64_t before = bound.bytes.length;
+    result = result && bind_end(&bound.bind, &bound.link);
+    uint64_t rooms = 0;
+    uint64_t actual = 0;
+    for (uint32_t m = 0; result && m < runtime->member_count; m += 1)
+    {
+        const RuntimePiece* piece = &runtime->pieces[RUNTIME_OBJECTS + m];
+        const bool joined = bind_test_has(bound.bind.members_joined, m);
+        rooms += joined ? piece->atom_room : 0;
+        for (AtomId atom = piece->begin.atoms; joined && atom < piece->end.atoms; atom += 1)
+        {
+            actual += runtime_atom_bytes(runtime, atom) != 0 ? runtime->link.atoms.size[atom] : 0;
+        }
+    }
+    bind_test_expect(&tally, result && rooms > actual + BUSTER_ARENA_PAGE_BYTES && bound.bytes.peak >= before + rooms, "a static binding didn't fault its members' pages in", rooms - actual);
+    bind_test_link_end(&bound);
+    return bind_test_report(&tally);
+}
