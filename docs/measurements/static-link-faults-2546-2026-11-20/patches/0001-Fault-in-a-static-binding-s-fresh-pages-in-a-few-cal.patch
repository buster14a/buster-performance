-// A static runtime's members: the closure by the path's way, then each needed member joined in archive order.
+// The pages the joins of the members the closure needs are about to write, faulted in a few calls rather than a fault
+// at a time (#2546): their atoms' bytes in `bytes`, by the members' rooms, and where those pages were fresh, their names'
+// bytes and the link's columns past their counts, which a process that bound nothing before hasn't touched either. In a
+// cloud VM, whose arenas are base pages, a fresh process's static hello world took 314 faults for them, 1.26 MB, and
+// its `executable` stage 1.37 ms, 1.20 with them populated (docs/object-writer-and-linker.md, "The runtime snapshot").
+// Where `bytes` has held as much before, as when a link is bound again (the benchmarks'), its pages are there, and
+// nothing is faulted in: the advice would only walk them.
+static void bind_populate(Bind* bind, Link* link)
+{
+    const Runtime* runtime = bind->runtime;
+    const uint32_t words = (runtime->member_count + 63) / 64;
+    LinkCapacity added = { 0 };
+    uint64_t name_bytes = 0;
+    uint64_t atom_bytes = 0;
+    for (uint32_t w = 0; w < words; w += 1)
+    {
+        for (uint64_t pending = bind->members_needed[w]; pending != 0; pending &= pending - 1)
+        {
+            bind_capacity_piece(runtime, RUNTIME_OBJECTS + w * 64 + (uint32_t)__builtin_ctzll(pending), &added, &name_bytes, &atom_bytes);
+        }
+    }
+    if (arena_populate(bind->bytes, atom_bytes))
+    {
+        arena_populate(link->name_arena, name_bytes);
+        link_populate(link, added);
+    }
+}
+
