+// Whether the kernel takes MADV_POPULATE_WRITE (Linux 5.14), which arena_fault_in asks for: where it doesn't, as before
+// 5.14 or where a sandbox refuses it, nothing is faulted in until the joins write it, and the pages' residency isn't
+// checked.
+static bool bind_test_populates(void)
+{
+    const uint64_t page = BUSTER_ARENA_PAGE_BYTES;
+    void* probe = mmap(0, page, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    const bool result = probe != MAP_FAILED && madvise(probe, page, BUSTER_ARENA_MADV_POPULATE_WRITE) == 0;
+    if (probe != MAP_FAILED)
+    {
+        munmap(probe, page);
+    }
+    return result;
+}
