+// lets them be huge, as where transparent huge pages are on for the process: whether arena_base_pages then says so.
+static bool bind_test_base_pages(bool base)
+{
+    arena_pages_busy = base;
+    if (!base && prctl(PR_GET_THP_DISABLE, 0, 0, 0, 0) == 1)
+    {
+        prctl(PR_SET_THP_DISABLE, 0, 0, 0, 0);
+    }
+    return arena_base_pages() == base;
+}
