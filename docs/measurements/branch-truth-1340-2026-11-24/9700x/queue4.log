exclusive.sh: waiting for the 9700X, held by: 2026-11-24T15:36:57+00:00 antigravity-2850: timeout -k 5 120 bash -c 
set -euo pipefail
WORK=~/buster-fast-bench/2850-antigravity
BIN=$WORK/compiler-head
SQLITE=/var/lib/buster-9700x/corpora/preprocessor-391e729af658/sqlite
OUT=$WORK/holdA_v2.log
{
echo "=== TIMESTAMP ==="
date -u -Is
echo "=== LOADAVG BEFORE ==="
cat /proc/loadavg
echo "=== TOP PS BEFORE ==="
ps -eo pid,pcpu,pmem,comm --sort=-pcpu | head -n 10
echo "=== BINARY ==="
sha256sum "$BIN"
ls -la "$BIN"
echo "=== MEASURE-COMPILE (CPU 2, runs=7) ==="
taskset -c 2 "$BIN" measure-compile --runs 7 \
  --variant --no-direct \
  --reference /usr/bin/tcc \
  --reference /usr/bin/clang --reference-option -O0 \
  --reference /usr/bin/gcc --reference-option -O0 \
  -- -c -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_THREADSAFE=0 -DSQLITE_ENABLE_MEMSYS5 -DSQLITE_ENABLE_RTREE -I"$SQLITE" "$SQLITE/sqlite3.c"
echo "=== TIME-STAGES DIRECT ==="
taskset -c 2 "$BIN" --time-stages -c -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_THREADSAFE=0 -DSQLITE_ENABLE_MEMSYS5 -DSQLITE_ENABLE_RTREE -I"$SQLITE" "$SQLITE/sqlite3.c" -o /tmp/v2_direct.o 2>&1
echo "=== TIME-STAGES NO-DIRECT ==="
taskset -c 2 "$BIN" --no-direct --time-stages -c -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_THREADSAFE=0 -DSQLITE_ENABLE_MEMSYS5 -DSQLITE_ENABLE_RTREE -I"$SQLITE" "$SQLITE/sqlite3.c" -o /tmp/v2_nodirect.o 2>&1
echo "=== OBJECT SIZES ==="
ls -la /tmp/v2_direct.o /tmp/v2_nodirect.o
size /tmp/v2_direct.o /tmp/v2_nodirect.o
echo "=== PERF STAT DIRECT (5 runs) ==="
for i in 1 2 3 4 5; do
  echo "--- direct run $i ---"
  taskset -c 2 perf stat -e instructions:u,cycles:u,cycles:k,cycles,instructions,branches,branch-misses,L1-dcache-load-misses,L1-icache-load-misses \
    "$BIN" -c -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_THREADSAFE=0 -DSQLITE_ENABLE_MEMSYS5 -DSQLITE_ENABLE_RTREE -I"$SQLITE" "$SQLITE/sqlite3.c" -o /tmp/v2_direct.o 2>&1
done
echo "=== PERF STAT NO-DIRECT (3 runs) ==="
for i in 1 2 3; do
  echo "--- nodirect run $i ---"
  taskset -c 2 perf stat -e instructions:u,cycles:u,cycles:k,cycles,instructions,branches,branch-misses,L1-dcache-load-misses,L1-icache-load-misses \
    "$BIN" --no-direct -c -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_THREADSAFE=0 -DSQLITE_ENABLE_MEMSYS5 -DSQLITE_ENABLE_RTREE -I"$SQLITE" "$SQLITE/sqlite3.c" -o /tmp/v2_nodirect.o 2>&1
done
echo "=== PEAK RSS ==="
/usr/bin/time -v taskset -c 2 "$BIN" -c -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_THREADSAFE=0 -DSQLITE_ENABLE_MEMSYS5 -DSQLITE_ENABLE_RTREE -I"$SQLITE" "$SQLITE/sqlite3.c" -o /tmp/v2_direct.o 2>&1 | grep -E "Maximum resident|Minor|Major|Elapsed|User|System"
/usr/bin/time -v taskset -c 2 "$BIN" --no-direct -c -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_THREADSAFE=0 -DSQLITE_ENABLE_MEMSYS5 -DSQLITE_ENABLE_RTREE -I"$SQLITE" "$SQLITE/sqlite3.c" -o /tmp/v2_nodirect.o 2>&1 | grep -E "Maximum resident|Minor|Major|Elapsed|User|System"
echo "=== LOADAVG AFTER ==="
cat /proc/loadavg
echo "=== TOP PS AFTER ==="
ps -eo pid,pcpu,pmem,comm --sort=-pcpu | head -n 10
} | tee "$OUT"

  title: 2850 v2 Hold A: measure-compile and perf stat on sqlite3.c
