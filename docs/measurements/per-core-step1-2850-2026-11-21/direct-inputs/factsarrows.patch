+// A miss executes the full rule on the current operand. A successful answer is
+// reusable for exactly that type, member, standing and flags until the pass ends.
+static __attribute__((noinline)) bool node_facts_arrow_fill(NodeFactsRecord* records, const NodeFactsView* view, uint32_t w, uint32_t a, NodeFactsArrowResult* slot, uint64_t key)
+{
+    if (!node_facts_arrow_uncached(records, view, w, a, false))
+    {
+        return false;
+    }
+    const NodeFactsRecord* result = records + w;
+    *slot = (NodeFactsArrowResult) {
+        .type_name = key,
+        .operand_flags = records[a].flags,
+        .operand_standing = records[a].standing,
+        .complete_at = node_facts_row_of(view, records[a].type)->element_complete_at,
+        .generation = view->arrow_generation,
+        .type_word = (uint64_t)result->type | (uint64_t)result->word << 32,
+        .offset = result->member_offset,
+        .flags = result->flags,
+        .converted = result->converted[0],
+        .converted_flags = result->conversion_flags[0],
+    };
+    return true;
+}
+
+static inline __attribute__((always_inline)) bool node_facts_arrow_fast(NodeFactsRecord* records, const NodeFactsView* view, uint32_t w, uint32_t a, bool lean)
+{
+    if (view->arrow_results == NULL)
+    {
+        return node_facts_arrow_uncached(records, view, w, a, lean);
+    }
+    const uint32_t name = view->inputs[w];
+    const uint64_t key = (uint64_t)records[a].type << 32 | name;
+    NodeFactsArrowResult* slot = view->arrow_results + (name & (NODE_FACTS_ARROW_SLOTS - 1));
+    if (slot->generation != view->arrow_generation || slot->type_name != key ||
+        slot->operand_flags != records[a].flags || slot->operand_standing != records[a].standing ||
+        slot->complete_at > view->positions[w])
+    {
+        return node_facts_arrow_fill(records, view, w, a, slot, key);
+    }
+    node_facts_record(records, w, (TypeId)slot->type_word, (uint32_t)(slot->type_word >> 32),
+                      BUSTER_NODE_MACHINE_STANDING(CHECK_LVALUE, CHECK_CONSTANT_NONE), slot->flags, 0, 0);
+    if (lean)
+    {
+        node_facts_store(records + w, 48, slot->offset);
+    }
+    else
+    {
+        node_facts_conversions(records, w, slot->converted, slot->converted_flags, 0, 0, slot->offset);
+    }
+    return true;
+}
