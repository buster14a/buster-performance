+static inline __attribute__((always_inline)) void node_split_leaves_of(NodeFacts* facts, uint32_t first, uint32_t leaves, bool lean)
+{
+    NodeFactsHot* const records = facts->hot_values;
+    const uint32_t* const leaf_list = facts->leaf_list;
+    const NodeFactsView view = node_facts_view(facts, first);
+    for (uint32_t i = 0; i < leaves; i += 1)
+    {
+        const uint32_t w = leaf_list[i];
+        if (__builtin_expect(!node_split_leaf(records, &view, w, lean), 0))
+        {
+            node_split_leave(facts, (uint64_t)first + w, w);
+        }
+    }
+}
