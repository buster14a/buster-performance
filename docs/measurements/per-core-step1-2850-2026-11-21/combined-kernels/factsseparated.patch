+static inline __attribute__((always_inline)) void node_split_store(NodeFactsHot* record, uint32_t offset, uint64_t value)
+{
+    memcpy((uint8_t*)record + offset + (offset >= 32 ? (BUSTER_NODE_FACTS_WINDOW-1u)*32u : 0u), &value, sizeof(value));
+}
