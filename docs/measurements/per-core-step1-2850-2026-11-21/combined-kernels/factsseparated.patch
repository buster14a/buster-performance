+// Finish a call before a dependent call can read it. This pass follows window
+// order within a class and handles the arguments at the same position as the callee.
+static inline __attribute__((always_inline)) bool node_facts_call_once(NodeFacts* facts, NodeFactsRecord* records,
+        const NodeFactsView* view, uint32_t w, uint32_t a, bool lean)
+{
+    const TypeId type = records[a].type;
+    const uint32_t standing = records[a].standing;
+    const uint32_t flags = records[a].flags;
+    const NodeFactsRow* row = node_facts_row_of(view, type);
+    const uint32_t function = row->function;
+    const uint32_t parameters = function >> 16;
+    const uint32_t count = view->counts[w];
+    const uint16_t* arguments = view->arguments + view->inputs[w];
+    const bool designator = (function & BUSTER_NODE_FACTS_DESIGNATOR) != 0;
+    const TypeId pointer = row->decayed[0];
+    const uint32_t lvalue = 0u - (standing & 0x01u);
+    const uint32_t as_designator = (standing & BUSTER_NODE_MACHINE_WIDE) | (pointer == 0 ? 1u : 0u);
+    const uint32_t as_value = node_facts_unfit(type, standing, flags, lvalue, false) | (~row->flags & BUSTER_NODE_FACTS_SCALAR);
+    const uint32_t wanted = BUSTER_NODE_FACTS_FUNCTION | BUSTER_NODE_FACTS_RETURNS | BUSTER_TYPE_FLAG_PROTOTYPE << 8;
+    const uint32_t unfit=(designator ? as_designator : as_value) | (~function & wanted);
+    if (unfit || row->returned_ready_at>view->positions[w] || count<parameters ||
+        (!(function >> 8 & BUSTER_TYPE_FLAG_VARIADIC) && count!=parameters)) return false;
+    uint32_t gathered=flags;
+    NodeFactsArguments asked={0};
+    if (count<4) node_facts_argument(&asked,records+a);
+    const uint64_t* targets = view->targets + row->parameters;
+    uint32_t outcome = BUSTER_NODE_FACTS_ARGUMENT_KEPT | BUSTER_NODE_FACTS_ARGUMENT_MADE | BUSTER_NODE_FACTS_ARGUMENT_PLAIN | BUSTER_NODE_FACTS_ARGUMENT_QUIET;
+#pragma clang loop vectorize(disable) interleave(disable) unroll(disable)
+    for (uint32_t i = 0; i < parameters; i += 1)
+    {
+        const uint32_t g = w - arguments[i];
+        if (records[g].standing & BUSTER_NODE_MACHINE_WIDE) return false;
+        gathered |= records[g].flags;
+        node_facts_argument(&asked,records+g);
+        const uint64_t target = targets[i];
+        const uint64_t key_types = (uint64_t)records[g].type << 32 | (TypeId)target;
+        const uint64_t key_standing = node_facts_argument_standing(records + g);
+        const NodeFactsArgumentSlot* slot = view->argument_slots + node_facts_argument_slot(key_types, key_standing);
+        if (__builtin_expect(slot->types != key_types || slot->standing != key_standing, 0))
+        {
+            slot = node_facts_argument_fill(facts, records, view, g, target, true, key_types, key_standing);
+        }
+        outcome &= slot->outcome;
+        if (!lean)
+        {
+            node_facts_store(records + g, 56, slot->conversion);
+        }
+    }
+#pragma clang loop vectorize(disable) interleave(disable) unroll(disable)
+    for (uint32_t i = parameters; i < count; i += 1)
+    {
+        const uint32_t g = w - arguments[i];
+        if (records[g].standing & BUSTER_NODE_MACHINE_WIDE) return false;
+        gathered |= records[g].flags;
+        node_facts_argument(&asked,records+g);
+        const uint64_t key_types = (uint64_t)records[g].type << 32 | BUSTER_NODE_FACTS_NO_PARAMETER;
+        const uint64_t key_standing = node_facts_argument_standing(records + g);
+        const NodeFactsArgumentSlot* slot = view->argument_slots + node_facts_argument_slot(key_types, key_standing);
+        if (__builtin_expect(slot->types != key_types || slot->standing != key_standing, 0))
+        {
+            slot = node_facts_argument_fill(facts, records, view, g, 0, false, key_types, key_standing);
+        }
+        outcome &= slot->outcome;
+        if (!lean)
+        {
+            node_facts_store(records + g, 56, slot->conversion);
+        }
+    }
+    if (!(outcome & BUSTER_NODE_FACTS_ARGUMENT_KEPT)) return false;
+    const uint8_t made=BUSTER_NODE_MACHINE_STANDING(CHECK_RVALUE,CHECK_CONSTANT_NONE);
+    const uint32_t quiet=(outcome & BUSTER_NODE_FACTS_ARGUMENT_QUIET) ? node_facts_arguments_quiet(&asked,function) : 0u;
+    const uint32_t says=lean ? 0u : node_facts_call_says(outcome,function);
+    node_facts_record(records,w,row->returned,row->returned_word,made,BUSTER_CHECK_SIDE_EFFECT | (gathered & BUSTER_CHECK_INHERITED),0,0);
+    node_facts_store(records+w,24,(uint64_t)made | 0x100u | (uint64_t)(quiet | says)<<16);
