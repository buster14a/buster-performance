+static inline NodeFactsTail* node_split_side(NodeFactsHot* hot)
+{
+    return (NodeFactsTail*)(void*)(hot+BUSTER_NODE_FACTS_WINDOW);
+}
+static inline void node_split_put(NodeFactsHot* hot, NodeFactsRecord logical)
+{
+    memcpy(hot, &logical, 32);
+    memcpy(node_split_side(hot), (const uint8_t*)&logical+32, 32);
+}
+static void node_split_for_comparison(NodeFacts* facts, uint32_t window)
+{
+    uint32_t count=facts->windows[window+1]-facts->windows[window];
+    for(uint32_t i=0;i<count;++i) {
+        memcpy(facts->records+i,facts->hot_values+i,32);
+        memcpy((uint8_t*)(facts->records+i)+32,node_split_side(facts->hot_values+i),32);
+    }
+}
