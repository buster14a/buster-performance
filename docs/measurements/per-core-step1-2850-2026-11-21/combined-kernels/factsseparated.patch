+static void node_split_given(NodeFacts* facts, uint32_t window, uint32_t poison)
+{
+    NodeFactsHot* records = facts->hot_values;
+    const uint32_t first = facts->windows[window];
+    const uint32_t count = facts->windows[window + 1] - first;
+    for (uint32_t i = 0; i < count; i += 1)
+    {
+        const uint8_t kind = facts->kinds[first + i];
+        const bool made = (kind & 0x02u) != 0;
+        if (made && (poison == BUSTER_NODE_FACTS_POISON_RECORDS || (poison == BUSTER_NODE_FACTS_POISON_LOADS && (kind & 0x03u) == 0x02u)))
+        {
+            memset(records + i, BUSTER_NODE_FACTS_POISON, 32);
+            memset(node_split_side(records+i), BUSTER_NODE_FACTS_POISON, 32);
+        }
+        else
+        {
+            node_split_put(records+i, node_facts_expected(facts, (uint64_t)first + i));
+            // A record's last quadword is written for a call's argument alone: what reads another's reads this.
+            memset(&node_split_side(records+i)->spare, BUSTER_NODE_FACTS_POISON, sizeof(node_split_side(records+i)->spare));
+            if (made && poison == BUSTER_NODE_FACTS_POISON_LOADS)
+            {
+                memset(&records[i].type, BUSTER_NODE_FACTS_POISON, sizeof(records[i].type));
+                memset(&records[i].word, BUSTER_NODE_FACTS_POISON, sizeof(records[i].word));
+                memset(&node_split_side(records+i)->member_offset, BUSTER_NODE_FACTS_POISON, sizeof(node_split_side(records+i)->member_offset));
+            }
+            else if (made && poison == BUSTER_NODE_FACTS_POISON_DECOY)
+            {
+                records[i].flags ^= BUSTER_CHECK_SIDE_EFFECT;
+            }
+        }
+    }
+}
