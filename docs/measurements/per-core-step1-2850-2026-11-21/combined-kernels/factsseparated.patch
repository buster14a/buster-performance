+static __attribute__((noinline)) void node_split_rows_made(NodeFacts* facts, uint32_t first, const uint32_t* batch, uint32_t batched, bool lean)
+{
+    NodeFactsHot* const records = facts->hot_values;
+    uint32_t* const rare = facts->rare;
+    uint32_t rare_count = 0;
+    const uint16_t* const right = facts->right + first;
+    const uint8_t* const ops = facts->ops + first;
+    const NodeFactsView view = node_facts_view(facts, first);
+    for (uint32_t i = 0; i < batched; i += 1)
+    {
+        // A unary operator's second operand is its first, read and masked away.
+        const uint32_t w = (uint16_t)batch[i];
+        const uint32_t second = right[w];
+        const uint32_t a = (batch[i] >> 16);
+        const uint32_t b = second != 0 ? w - second : a;
+        const bool taken = node_split_row_made(records, &view, w, a, b, second != 0 ? 1u : 0u, (CheckOp)ops[w], lean, true);
+        rare[rare_count] = w;
+        rare_count += taken ? 0u : 1u;
+    }
+    if (rare_count != 0)
+    {
+        node_split_rows_rest(facts, first, rare_count);
+    }
+}
