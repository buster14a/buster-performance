+static inline __attribute__((always_inline)) bool node_split_leaf(NodeFactsHot* records, const NodeFactsView* view, uint32_t w, bool lean)
+{
+    const uint64_t* line = view->lines + 4 * (uint64_t)view->inputs[w];
+    const bool taken = (uint32_t)(line[3] >> 32) == 0;
+    const __m256i half = _mm256_loadu_si256((const __m256i*)(const void*)line);
+    if (taken && lean)
+    {
+        _mm256_storeu_si256((__m256i*)(void*)(records + w), half);
+    }
+    else if (taken)
+    {
+        _mm256_storeu_si256((__m256i*)(void*)(records+w),half);
+        _mm256_storeu_si256((__m256i*)(void*)node_split_side(records+w), _mm256_zextsi128_si256(_mm_cvtsi32_si128((int)(uint32_t)line[0])));
+    }
+    return taken;
+}
