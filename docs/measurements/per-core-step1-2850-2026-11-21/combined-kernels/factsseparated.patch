+static inline __attribute__((always_inline)) void node_split_record(NodeFactsHot* records, uint32_t w, TypeId type, uint32_t word, uint8_t standing, uint32_t flags,
+                                                                     uint32_t object, uint64_t payload)
+{
+    NodeFactsHot* record = records + w;
+    node_split_store(record, 0, (uint64_t)type | (uint64_t)word << 32);
+    node_split_store(record, 8, (uint64_t)flags | (uint64_t)object << 32);
+    node_split_store(record, 16, payload);
+    node_split_store(record, 24, (uint64_t)standing | 0x100u);
+}
+
+static inline __attribute__((always_inline)) void node_split_record_integer(NodeFactsHot* records, uint32_t w, TypeId type, uint32_t word, uint8_t standing, uint32_t flags,
+                                                                             uint32_t object, uint64_t payload)
+{
+    NodeFactsHot* record = records + w;
+    node_split_store(record, 0, (uint64_t)type | (uint64_t)word << 32);
+    node_split_store(record, 8, (uint64_t)flags | (uint64_t)object << 32);
+    node_split_store(record, 16, payload);
+    node_split_store(record, 24, (uint64_t)standing | 0x100u | (uint64_t)node_facts_small(payload) << 16);
+}
