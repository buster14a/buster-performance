+static inline __attribute__((always_inline)) void node_split_conversions(NodeFactsHot* records, uint32_t w, TypeId first, uint32_t first_flags, TypeId second,
+                                                                          uint32_t second_flags, uint64_t member_offset)
+{
+    NodeFactsHot* record = records + w;
+    node_split_store(record, 32, (uint64_t)first | (uint64_t)second << 32);
+    node_split_store(record, 40, (uint64_t)first_flags | (uint64_t)second_flags << 32);
+    node_split_store(record, 48, member_offset);
+}
