+static __attribute__((noinline)) void node_split_slow_each(NodeFacts* facts, uint32_t first, uint32_t count)
+{
+    for (uint32_t i = 0; i < count; i += 1)
+    {
+        node_split_slow(facts, first, facts->rare[i]);
+    }
+}
