+static inline __attribute__((always_inline)) void node_split_arrows_of(NodeFacts* facts, uint32_t first, const uint32_t* batch, uint32_t batched, uint32_t mode)
+{
+    NodeFactsHot* const records = facts->hot_values;
+    uint32_t* const rare = facts->rare;
+    uint32_t rare_count = 0;
+    const uint8_t* const fits = facts->fits + first;
+    const NodeFactsView view = node_facts_view(facts, first);
+    for (uint32_t i = 0; i < batched; i += 1)
+    {
+        const uint32_t w = (uint16_t)batch[i];
+        const uint32_t a = (batch[i] >> 16);
+        const bool taken = mode == BUSTER_NODE_FACTS_LOADS ? fits[w] != 0 && node_split_arrow_load(records, &view, w, a)
+                                                           : node_split_arrow_fast(records, &view, w, a, mode == BUSTER_NODE_FACTS_LEAN);
+        if (__builtin_expect(!taken, 0))
+        {
+            rare[rare_count] = w;
+            rare_count += 1;
+            records[w].standing = BUSTER_NODE_MACHINE_WIDE;
+        }
+    }
+    if (rare_count != 0)
+    {
+        node_split_slow_each(facts, first, rare_count);
+    }
+}
