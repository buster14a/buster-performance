+static __attribute__((noinline)) void node_split_slow_list(NodeFacts* facts, uint32_t first, const uint32_t* list, uint32_t count)
+{
+    for (uint32_t i = 0; i < count; i += 1)
+    {
+        node_split_slow(facts, first, (uint16_t)list[i]);
+    }
+}
