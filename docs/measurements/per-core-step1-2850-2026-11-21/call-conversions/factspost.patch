+// Use the compact lookup positions in the order of the source postorder. Every
+// operand has been written before its consumer, including the arguments of a nested call.
+static inline __attribute__((always_inline)) void node_facts_postorder(NodeFacts* facts,uint32_t window,bool split,bool lean)
+{
+    const uint32_t first=facts->windows[window],count=facts->windows[window+1]-first;
+    const uint64_t t0=split ? __rdtsc() : 0;
+    uint32_t leaves=0,lookups=0,rounds=0;
+    node_facts_list(facts->leaf_list,facts->lookup_list,facts->keys,facts->kinds+first,facts->classes+first,
+                    count,&leaves,&lookups,&rounds);
+    if(lean) node_facts_leaves_lean(facts,first,leaves);
+    else node_facts_leaves(facts,first,leaves);
+    const uint64_t t1=split ? __rdtsc() : 0;
+    const NodeFactsView view=node_facts_view(facts,first);
+    NodeFactsRecord* records=facts->records;
+    const bool plain=!facts->machine->overloads;
+    for (uint32_t i=0;i<lookups;++i) {
+        const uint32_t w=facts->lookup_list[i],a=w-facts->left[first+w];
+        bool taken=false;
+        const uint32_t key=facts->keys[i];
+        if (key<16u*BUSTER_NODE_FACTS_ROUNDS) {
+            switch(key & 15u) {
+                case BUSTER_NODE_FACTS_CODE_ARROW: taken=node_facts_arrow_fast(records,&view,w,a,lean); break;
+                case BUSTER_NODE_FACTS_CODE_DOT: taken=node_facts_dot_fast(records,&view,w,a,lean); break;
+                case BUSTER_NODE_FACTS_CODE_DEREFERENCE: taken=node_facts_dereference_fast(records,&view,w,a,lean); break;
+                case BUSTER_NODE_FACTS_CODE_SUBSCRIPT: {
+                    const uint32_t right=facts->right[first+w];
+                    taken=right && node_facts_subscript_fast(records,&view,w,a,w-right,lean);
+                    break;
+                }
+                case BUSTER_NODE_FACTS_CODE_CALL: taken=node_facts_call_once(facts,records,&view,w,a,lean); break;
+                case BUSTER_NODE_FACTS_CODE_DISCARD: taken=node_facts_discard_fast(records,&view,plain,w,a); break;
+            }
+        }
+        if (__builtin_expect(!taken,0)) node_facts_slow(facts,first,w);
+    }
+    const uint64_t t2=split ? __rdtsc() : 0;
+    facts->leaf_ticks+=t1-t0;
+    facts->lookup_ticks+=t2-t1;
+    facts->leaf_count=leaves;
+    facts->lookup_count=lookups;
+    facts->lookup_postorder=true;
+}
+static __attribute__((noinline,aligned(64))) void node_facts_lookup_whole(NodeFacts* facts, uint32_t window, bool split)
+{
+    node_facts_postorder(facts,window,split,false);
+}
+
+static __attribute__((noinline,aligned(64))) void node_facts_lookup_lean(NodeFacts* facts, uint32_t window, bool split)
+{
+    node_facts_postorder(facts,window,split,true);
+}
+
+static __attribute__((noinline,aligned(64))) void node_facts_window(NodeFacts* facts, uint32_t window, uint32_t mode, bool split)
+{
+    if (!facts->operators && mode == BUSTER_NODE_FACTS_WHOLE) node_facts_lookup_whole(facts, window, split);
+    else if (!facts->operators && mode == BUSTER_NODE_FACTS_LEAN) node_facts_lookup_lean(facts, window, split);
+    else node_facts_window_of(facts,window,mode,split,true);
+}
