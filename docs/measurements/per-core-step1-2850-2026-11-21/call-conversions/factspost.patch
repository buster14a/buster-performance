+// Finish a call before a dependent call can read it. This pass follows window
+// order within a class and handles the arguments at the same position as the callee.
+static inline __attribute__((always_inline)) bool node_facts_call_once(NodeFacts* facts, NodeFactsRecord* records,
+        const NodeFactsView* view, uint32_t w, uint32_t a, bool lean)
+{
+    if (!node_facts_call_fast(records,view,w,a,lean)) return false;
+    const NodeFactsRow* row=node_facts_row_of(view,records[a].type);
+    const uint32_t outcome=node_facts_call_arguments(facts,records,view,w,row,lean);
+    if (!(outcome & BUSTER_NODE_FACTS_ARGUMENT_KEPT)) return false;
+    const uint32_t loud=(outcome & BUSTER_NODE_FACTS_ARGUMENT_QUIET) ? 0u : (uint32_t)BUSTER_NODE_FACTS_QUIET_CALL;
+    const uint32_t says=lean ? 0u : node_facts_call_says(outcome,row->function);
+    records[w].exponent=(uint16_t)((records[w].exponent & ~loud) | says);
+    return true;
+}
