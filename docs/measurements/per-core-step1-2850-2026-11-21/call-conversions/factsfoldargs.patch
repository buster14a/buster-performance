+static __attribute__((noinline,aligned(64))) void node_facts_lookup_whole(NodeFacts* facts, uint32_t window, bool split)
+{
+    node_facts_window_of(facts, window, BUSTER_NODE_FACTS_WHOLE, split, false);
+}
+
+static __attribute__((noinline,aligned(64))) void node_facts_lookup_lean(NodeFacts* facts, uint32_t window, bool split)
+{
+    node_facts_window_of(facts, window, BUSTER_NODE_FACTS_LEAN, split, false);
+}
+
+static __attribute__((noinline,aligned(64))) void node_facts_window(NodeFacts* facts, uint32_t window, uint32_t mode, bool split)
+{
+    if (!facts->operators && mode == BUSTER_NODE_FACTS_WHOLE) node_facts_lookup_whole(facts, window, split);
+    else if (!facts->operators && mode == BUSTER_NODE_FACTS_LEAN) node_facts_lookup_lean(facts, window, split);
+    else node_facts_window_of(facts,window,mode,split,true);
+}
