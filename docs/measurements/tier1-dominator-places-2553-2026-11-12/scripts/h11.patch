+// Whether an interval named by an exit hint (BUSTER_TIER1_ALLOCATE_HINT_EXIT) has a value the scan last left in memory
+// (#2553): one without uses then rests there too, as a value's own hint keeps it, rather than taking the register of the
+// exit it names, which a block it passes through untouched would only carry, saved around its calls.
+static bool tier1_allocation_left_in_memory(const Tier1AllocationInput* columns, const uint8_t* last, uint32_t interval)
+{
+    const uint32_t named = last != 0 && columns->hint_intervals != 0 ? columns->hint_intervals[interval] : UINT32_MAX;
+    return named != UINT32_MAX && (named & BUSTER_TIER1_ALLOCATE_HINT_EXIT) != 0 && last[columns->values[interval]] == BUSTER_TIER1_ALLOCATE_MEMORY_HINT;
+}
