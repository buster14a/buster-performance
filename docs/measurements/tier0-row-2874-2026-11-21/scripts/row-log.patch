+// Experiment (#2874, step 4's design): Tier 0's passes' ticks for the emission's row log (c_check_program_emit.c).
+static uint64_t row_pass_ticks[16];
+static uint64_t row_pass_last;
+static inline void row_pass_lap(uint32_t pass)
+{
+    const uint64_t now = __rdtsc();
+    row_pass_ticks[pass] += now - row_pass_last;
+    row_pass_last = now;
+}
