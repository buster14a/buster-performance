== Large automatic initializer regressions
./build/compiler test-checker --program-initializers
== Complete checker and native fixtures [2 CPUs]
./build/compiler test-checker --seed 133
== Tier 0 native and Clang comparisons [2 CPUs]
./build/compiler test-tier0 --cross-check
== Function lanes and resource rollback [8 CPUs]
./build/compiler test-check-lanes --executable ./build/compiler
== Call graph and shared-state check [8 CPUs]
./build.sh check-call-graph
== Driver diagnostics and emission
./build/compiler test-checker-driver --executable ./build/compiler
== Driver with lazy system headers
./build/compiler test-checker-driver --executable ./build/compiler --lazy-system-headers
== Deferred checking
./build/compiler test-checker-deferred
== Frozen C test programs
./build/compiler test-c-testsuite --cross-check --subset tests/c-testsuite/subset.txt build/c-testsuite
== Frozen SQLite symbols and deferred bodies [8 CPUs]
unset CPATH C_INCLUDE_PATH
export SOURCE_DATE_EPOCH=1792454400
corpus=/var/lib/buster-9700x/corpora/preprocessor-391e729af658
./build/compiler test-checker-corpus --clang /usr/bin/clang --deferred 8 --symbols --report build/checker-sqlite.tsv --no-default-config --target=x86_64-linux-gnu -march=znver5 -std=gnu17 -nostdinc -isystem "$corpus/headers/usr/lib/clang/23/include" -isystem "$corpus/headers/usr/local/include" -isystem "$corpus/headers/usr/include" "$corpus/sqlite/sqlite3.c"
