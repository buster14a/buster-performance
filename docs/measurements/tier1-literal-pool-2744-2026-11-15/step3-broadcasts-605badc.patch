 9 files changed, 162 insertions(+), 119 deletions(-)

diff --git a/docs/tier1-selection.md b/docs/tier1-selection.md
index ddf9307..a737d2f 100644
--- a/docs/tier1-selection.md
+++ b/docs/tier1-selection.md
@@ -1199,8 +1199,8 @@ or 64 bytes, the xmm, ymm or zmm one (`tier1_select_vector_forms`):
 | --- | --- | --- |
 | `vconst` of zeros, `undef` | `ZERO` | `vpxord x, x, x` |
 | `vconst` of every bit | `ONES` | `vpternlogd x, x, x, 0xff` |
-| `vconst` of one lane in all | `SPLAT` | `mov r11d, imm32` and `vpbroadcastd x, r11d` |
-| a `vconst` whose quadwords are one value, at an EVEX target | `CONSTANT` | the quadword into the scratch general register by the shortest `mov` that holds it and `vpbroadcastq` from it (`tier1_emit_cfg_vector_constant`, #2744's step 1: `_mm512_set1_epi64(63)`) |
+| `vconst` of one lane in all | `SPLAT` | at an EVEX target `vpbroadcastd x, [rip + literal]` of the lane's 4-byte literal (`tier1_emit_cfg_vector_constant`, #2744's step 3); below it, `mov r11d, imm32` and a broadcast from it |
+| a `vconst` whose quadwords are one value, at an EVEX target | `CONSTANT` | `vpbroadcastq x, [rip + literal]` of the quadword's 8-byte literal (`tier1_emit_cfg_vector_constant`, #2744: `_mm512_set1_epi64(63)`) |
 | any other `vconst` | `CONSTANT` | its literal's load, `vmovdqu32` of `[rip + literal]` (`tier1_emit_cfg_vector_constant`, #2744's step 2; "The literal pool" below) |
 | `copy` | `COPY` | `vmovdqa64` (`movaps` for 16 bytes), none where allocation gave both one register |
 | `add`, `sub`, `mul`, `and`, `or`, `xor` | `BINARY` | `vpaddd`, `vpsubd`, `vpmulld`, `vpandq`, `vporq`, `vpxord`: three operands, the destination any register |
@@ -1243,8 +1243,9 @@ store, so that none forwarded: on the compiler's own lexer by `--tier1`, 22
 constants were built so per 64-byte chunk of `c_tokenize`.
 
 - **In the function** (`tier1_emit_cfg_literal`): each constant at each width
-  it is loaded at is one literal of the function's (`Tier1EmitResult.literals`,
-  its bytes the constant's first 16, 32 or 64 and zero past them), and its load's
+  it is read at is one literal of the function's (`Tier1EmitResult.literals`,
+  its bytes the constant's first 16, 32 or 64, or a broadcast's 4 or 8, and zero
+  past them), and its load's
   reference names it by a provisional target, `BUSTER_TIER1_EMIT_LITERAL` plus
   its index, past every symbol a function's access column has: the function
   compiles on a lane and numbers no unit symbol, as the lowering's jump tables
@@ -1257,8 +1258,7 @@ constants were built so per 64-byte chunk of `c_tokenize`.
   body to its entry's symbol, after the runtime functions' and the jump tables'
   provisional symbols, which no symbol below the tag reaches. Each entry is an
   atom of its own, aligned to its width so that no load splits a line, in the
-  mergeable section of its width, `.rodata.cst16`, `.rodata.cst32` or
-  `.rodata.cst64` (`SHF_MERGE`, the width the entry size, as GCC's constants
+  mergeable section of its width, `.rodata.cst4` to `.rodata.cst64` (`SHF_MERGE`, the width the entry size, as GCC's constants
   are; clang puts its 64-byte ones in `.rodata`), with a local symbol
   `.Lbuster_literal_N`, which `-c`'s object keeps as clang keeps `.LCPI` labels:
   a PC-relative relocation into a merged section needs the symbol, not its
diff --git a/src/buster/compiler/c_check_program_emit.c b/src/buster/compiler/c_check_program_emit.c
index 72e0f93..95d932b 100644
--- a/src/buster/compiler/c_check_program_emit.c
+++ b/src/buster/compiler/c_check_program_emit.c
@@ -3519,18 +3519,22 @@ struct CheckEmitLiterals
 };
 
 // The pool's sections (#2744), as GCC's mergeable constants have them: read-only data of entries of one width, which a
-// linker merges across objects (SHF_MERGE, the width the entry size): a 16-byte literal's, a 32-byte one's, a 64-byte
-// one's. clang puts its 64-byte constants in .rodata, unmerged.
-static const ObjectAtomSection check_program_literal_sections[3] = {
+// linker merges across objects (SHF_MERGE, the width the entry size): a broadcast's 4- and 8-byte literals', and a 16-,
+// 32- and 64-byte vector's. clang puts its 64-byte constants in .rodata, unmerged.
+static const ObjectAtomSection check_program_literal_sections[5] = {
+    { .name = { .pointer = (char*)".rodata.cst4", .length = sizeof(".rodata.cst4") - 1 }, .type = SHT_PROGBITS, .flags = SHF_ALLOC | SHF_MERGE, .entry_size = 4 },
+    { .name = { .pointer = (char*)".rodata.cst8", .length = sizeof(".rodata.cst8") - 1 }, .type = SHT_PROGBITS, .flags = SHF_ALLOC | SHF_MERGE, .entry_size = 8 },
     { .name = { .pointer = (char*)".rodata.cst16", .length = sizeof(".rodata.cst16") - 1 }, .type = SHT_PROGBITS, .flags = SHF_ALLOC | SHF_MERGE, .entry_size = 16 },
     { .name = { .pointer = (char*)".rodata.cst32", .length = sizeof(".rodata.cst32") - 1 }, .type = SHT_PROGBITS, .flags = SHF_ALLOC | SHF_MERGE, .entry_size = 32 },
     { .name = { .pointer = (char*)".rodata.cst64", .length = sizeof(".rodata.cst64") - 1 }, .type = SHT_PROGBITS, .flags = SHF_ALLOC | SHF_MERGE, .entry_size = 64 },
 };
 
-// A literal's width, 16, 32 or 64 bytes, as its pool's section's index (check_program_literal_sections); 3 for another.
+// A literal's width, 4, 8, 16, 32 or 64 bytes, as its pool's section's index (check_program_literal_sections), which is
+// its alignment's log2 less 2; 5 for another.
 static uint32_t check_program_literal_class(const EmittedLiteral* literal)
 {
-    return literal->width == 16 ? 0u : literal->width == 32 ? 1u : literal->width == 64 ? 2u : 3u;
+    const uint32_t width = literal->width;
+    return width == 4 ? 0u : width == 8 ? 1u : width == 16 ? 2u : width == 32 ? 3u : width == 64 ? 4u : 5u;
 }
 
 // A literal's hash, of its width and its words up to it (those past it are zero): each word mixed in by a multiply, and
@@ -3577,7 +3581,7 @@ static bool check_program_emit_literals(CheckEmitLiterals* literals, const Emitt
         for (uint32_t k = 0; valid && k < own; k += 1)
         {
             const EmittedLiteral* literal = codes[b].literals + k;
-            valid = check_program_literal_class(literal) < 3;
+            valid = check_program_literal_class(literal) < 5;
             uint64_t slot = valid ? check_program_literal_hash(literal) & (capacity - 1) : 0;
             uint32_t entry = valid ? UINT32_MAX : 0;
             while (entry == UINT32_MAX)
@@ -5511,7 +5515,7 @@ static bool check_program_emit_timed(CheckProgramCode* result, const CheckProgra
         const uint32_t class = check_program_literal_class(literal);
         const uint32_t width = literal->width;
         uint8_t* data = arena_push(bytes, width, width);
-        const AtomId atom = data != 0 ? link_add_atom(&result->link, BUSTER_LINK_CLASS_RODATA, (uint8_t)(4 + class), width, memcpy(data, literal->words, width), 0) : 0;
+        const AtomId atom = data != 0 ? link_add_atom(&result->link, BUSTER_LINK_CLASS_RODATA, (uint8_t)(2 + class), width, memcpy(data, literal->words, width), 0) : 0;
         const SymbolId symbol = literals.symbol_base + u;
         valid = atom != 0 && link_define_symbol(&result->link, symbol, atom, 0, width);
         if (valid)
diff --git a/src/buster/compiler/emitted_code.c b/src/buster/compiler/emitted_code.c
index e88fe04..8768ebe 100644
--- a/src/buster/compiler/emitted_code.c
+++ b/src/buster/compiler/emitted_code.c
@@ -82,11 +82,11 @@ struct EmittedInline
     uint32_t call;
 };
 
-// A literal of a body's code (#2744): read-only bytes its code loads rip-relative, a vector constant of `width` bytes (16,
-// 32 or 64), its words little-endian, those past the width zero. A reference whose target is BUSTER_EMITTED_LITERAL + k
+// A literal of a body's code (#2744): read-only bytes its code loads rip-relative, a vector constant's of `width` bytes (16,
+// 32 or 64, or a broadcast's 4 or 8), its words little-endian, those past the width zero. A reference whose target is BUSTER_EMITTED_LITERAL + k
 // is to the code's literal k while the body compiles on its lane, which numbers no unit symbol: the emission's merge
-// gives each distinct literal of the unit an entry of its pool (.rodata.cst16, .rodata.cst32 or .rodata.cst64, aligned
-// to its width) and its symbol, and renames the references to it (check_program_emit_literals). No symbol of a unit
+// gives each distinct literal of the unit an entry of its pool (.rodata.cst4 to .rodata.cst64, aligned to its width) and
+// its symbol, and renames the references to it (check_program_emit_literals). No symbol of a unit
 // reaches the tag: the merge refuses a unit of as many.
 typedef struct EmittedLiteral EmittedLiteral;
 struct EmittedLiteral
