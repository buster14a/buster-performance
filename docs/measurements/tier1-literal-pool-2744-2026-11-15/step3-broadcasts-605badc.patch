             const uint32_t literal = claimed != 0 && claimed - 1 < emitted->literal_count ? claimed - 1 : UINT32_MAX;
             IrSimdValue expected = { 0 };
-            if (literal != UINT32_MAX && (width == 16 || width == 32 || width == 64))
