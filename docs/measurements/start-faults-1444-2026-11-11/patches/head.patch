+        const bool busy_base = busy_pushed && lane_test_vm_flag((uintptr_t)busy.base, "nh", &found) && found &&
+                               lane_test_vm_flag((uintptr_t)busy.base + 2 * BUSTER_ARENA_HUGE_PAGE_BYTES, "nh", &found) && found &&
