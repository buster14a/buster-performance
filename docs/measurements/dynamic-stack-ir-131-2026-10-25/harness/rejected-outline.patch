+// The rare stack operations do not expose the caller's sink/counter to an out-of-line call.
+static __attribute__((noinline, cold)) uint32_t ir_typed_stack(IrFunction* output, uint64_t first, uint8_t kind, uint32_t operand)
+{
+    IrTypedSink sink = {
+        .output = output,
+        .sizes = {
+            .instruction_count = first,
+        },
+    };
+    uint32_t value = BUSTER_IR_NONE;
+    if (kind == BUSTER_TYPED_ALLOCA)
+    {
+        const uint32_t address = ir_typed_emit(&sink, IR_ALLOCA, IR_PTR, operand, BUSTER_IR_NONE, BUSTER_IR_NONE, 0);
+        value = ir_typed_emit(&sink, IR_PTRTOINT, IR_I64, address, BUSTER_IR_NONE, BUSTER_IR_NONE, 0);
+    }
+    else if (kind == BUSTER_TYPED_STACK_SAVE)
+    {
+        value = ir_typed_emit(&sink, IR_STACK_SAVE, IR_I64, BUSTER_IR_NONE, BUSTER_IR_NONE, BUSTER_IR_NONE, 0);
+    }
+    else
+    {
+        ir_typed_emit(&sink, IR_STACK_RESTORE, IR_VOID, operand, BUSTER_IR_NONE, BUSTER_IR_NONE, 0);
+    }
+    return value;
+}
