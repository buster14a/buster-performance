+// Stage the final default64 tail here and return the final byte count. The caller retains no staging array or
+// cursor address across this call, and has no remaining work after its result. Each case uses only its real quads.
+__attribute__((noinline, unused)) static int64_t encode_tail64(const X86Instruction* instructions, uint8_t* out, const uint8_t* output, uint32_t* offsets,
+                                                             uint32_t count, uint32_t* fixup_ends)
+{
+    X86Instruction tail[BUSTER_X86_GROUP_INSTRUCTIONS] __attribute__((aligned(64))) = { 0 };
+    memcpy(tail, instructions, count * sizeof(X86Instruction));
+    uint32_t* cursor = fixup_ends;
+    uint32_t** fixups = fixup_ends != 0 ? &cursor : 0;
+    const uint32_t lanes = (1u << count) - 1;
+    uint8_t* end;
+    if (count <= 4)
+    {
+        end = encode_group(tail, 1, out, output, offsets, lanes, fixups, X86_GATHER_INSERTS, X86_STORE_FULL, X86_FIXUP_STORE_FULL, X86_ENCODER_MODE_64);
+    }
+    else if (count <= 8)
+    {
+        end = encode_group(tail, 2, out, output, offsets, lanes, fixups, X86_GATHER_INSERTS, X86_STORE_FULL, X86_FIXUP_STORE_FULL, X86_ENCODER_MODE_64);
+    }
+    else if (count <= 12)
+    {
+        end = encode_group(tail, 3, out, output, offsets, lanes, fixups, X86_GATHER_INSERTS, X86_STORE_FULL, X86_FIXUP_STORE_FULL, X86_ENCODER_MODE_64);
+    }
+    else
+    {
+        end = encode_group(tail, 4, out, output, offsets, lanes, fixups, X86_GATHER_INSERTS, X86_STORE_FULL, X86_FIXUP_STORE_FULL, X86_ENCODER_MODE_64);
+    }
+    return (int64_t)(end - output);
+}
