+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+//
+// Policy-owned checks included by x86_target_test.c. Enumerate every subset of every distinct requirement mask,
+// every single-feature removal from each profile, and unknown rows even with every feature bit set. The independent
+// named-form expectations and external compiler/assembler checks establish ISA facts; the matrix checks the kernels.
+
+static bool x86_target_test_templates(void)
+{
+    const size_t span = BUSTER_X86_FORM_TEMPLATES * sizeof(X86TemplateEntry);
+    const size_t extent = (BUSTER_X86_FORM_FIXUP + BUSTER_X86_FORM_TEMPLATES) * sizeof(X86TemplateEntry);
+    uint8_t* storage = malloc(extent + 129);
+    X86FormDescription* descriptions = malloc(sizeof(x86_form_descriptions));
+    bool passed = storage != 0 && descriptions != 0 && x86_encoder_initialize();
+    if (passed)
+    {
+        memcpy(descriptions, x86_form_descriptions, sizeof(x86_form_descriptions));
+    }
+    uint32_t checks = 0;
+    const X86EncoderMode modes[] = { X86_ENCODER_MODE_64, X86_ENCODER_MODE_ADDRESS32, X86_ENCODER_MODE_APX, X86_ENCODER_MODE_ADDRESS32 };
+    for (uint32_t mode = 0; passed && mode < BUSTER_ARRAY_LENGTH(modes); mode += 1)
+    {
+        const X86EncoderMode encoder = modes[mode];
+        // A deliberately unaligned, dirty destination checks the shared constructor's complete writes and bounds.
+        memset(storage, 0xa5, extent + 129);
+        X86TemplateEntry* copied = (X86TemplateEntry*)(storage + 65);
+        const X86FormDescription* source = mode == 3 ? 0 : descriptions;
+        passed &= x86_build_nonlegacy_templates(encoder, source, copied);
+        for (uint32_t form = 0; passed && form < BUSTER_X86_FORM_TEMPLATES; form += 1)
+        {
+            X86TemplateEntry expected;
+            memset(&expected, 0xa5, sizeof(expected));
+            const bool ready = build_mode_template(form, encoder, &expected.template);
+            memcpy(expected.layout, expected.template.layout, sizeof(expected.layout));
+            memcpy(expected.bytes, expected.template.bytes, sizeof(expected.bytes));
+            passed &= ready && memcmp(&expected, &copied[form], sizeof(expected)) == 0;
+            passed &= memcmp(&expected, &copied[BUSTER_X86_FORM_FIXUP + form], sizeof(expected)) == 0;
+            checks += 2;
+            if (encoder == X86_ENCODER_MODE_64)
+            {
+                passed &= memcmp(&expected, &x86_templates[form], sizeof(expected)) == 0;
+                passed &= memcmp(&expected, &x86_templates[BUSTER_X86_FORM_FIXUP + form], sizeof(expected)) == 0;
+                checks += 2;
+            }
+        }
+        if (passed && encoder == X86_ENCODER_MODE_64)
+        {
+            // An isolated opcode change proves that the shared home uses the supplied table, not its own copy.
+            // NOP's template keeps an optional REX slot before its opcode.
+            descriptions[X86_FORM_NOP].opcode = 0x91;
+            passed &= x86_build_nonlegacy_templates(encoder, descriptions, copied);
+            passed &= copied[X86_FORM_NOP].template.bytes[1] == 0x91 && copied[X86_FORM_NOP].bytes[1] == 0x91;
+            passed &= copied[BUSTER_X86_FORM_FIXUP + X86_FORM_NOP].template.bytes[1] == 0x91 && copied[BUSTER_X86_FORM_FIXUP + X86_FORM_NOP].bytes[1] == 0x91;
+            passed &= x86_form_descriptions[X86_FORM_NOP].opcode == 0x90;
+            descriptions[X86_FORM_NOP].opcode = x86_form_descriptions[X86_FORM_NOP].opcode;
+        }
+        for (size_t i = 0; i < 65; i += 1)
+        {
+            passed &= storage[i] == 0xa5;
+        }
+        for (size_t i = 65 + extent; i < extent + 129; i += 1)
+        {
+            passed &= storage[i] == 0xa5;
+        }
+        for (size_t i = 65 + span; i < 65 + BUSTER_X86_FORM_FIXUP * sizeof(X86TemplateEntry); i += 1)
+        {
+            passed &= storage[i] == 0xa5;
+        }
+    }
+    X86TemplateEntry rejected;
+    memset(&rejected, 0xa5, sizeof(rejected));
+    const X86TemplateEntry original = rejected;
+    passed &= !x86_build_nonlegacy_templates(X86_ENCODER_MODE_32, 0, &rejected);
+    passed &= !x86_build_nonlegacy_templates(X86_ENCODER_MODE_16, 0, &rejected);
+    passed &= !x86_build_nonlegacy_templates((X86EncoderMode)UINT32_MAX, 0, &rejected);
+    passed &= !x86_build_nonlegacy_templates(X86_ENCODER_MODE_64, 0, &rejected);
+    passed &= !x86_build_nonlegacy_templates(X86_ENCODER_MODE_APX, 0, &rejected);
+    passed &= memcmp(&original, &rejected, sizeof(original)) == 0;
+    free(storage);
+    free(descriptions);
+    printf("target complete native-mode templates against direct builder: %s (%u entries, all byte/layout halves and fixups; caller descriptions, dirty unaligned destinations and refusal guards)\n", passed ? "pass" : "FAIL", checks);
+    return passed;
+}
