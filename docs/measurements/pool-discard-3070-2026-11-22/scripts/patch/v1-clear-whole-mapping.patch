+// A pool's releases that keep their arenas' pages, cleared (#3070, arena_pool_clear). A released arena keeps the pages
+// it wrote, those a copy of it wrote past its own peak too, resident, and a reservation takes it again with every byte
+// zero; a page it only read stays the kernel's zero page, counted as nothing kept. The same arena, once it writes more
+// than BUSTER_ARENA_POOL_CLEAR_BYTES, or once it is released past the pool's BUSTER_ARENA_POOL_KEPT_BYTES, frees its
+// pages as before, and is taken again zero. An arena of tables' scattered writes are kept as an arena's, and
+// arena_pool_trim frees what the pool keeps. Where the kernel has no PAGEMAP_SCAN (before Linux 6.7) every release frees
+// its pages, and reuse still reads zero. In a process of its own (lane_test_arena_pool_clear), as the regions' checks
+// are: its reservations' regions count against the address-space limit that later checks lower.
+static void lane_test_arena_pool_clear_child(LaneTestTally* tally)
+{
+    const uint64_t page = BUSTER_ARENA_PAGE_BYTES;
+    struct utsname kernel;
+    const bool scans = uname(&kernel) == 0 && arena_kernel_maps_stack_base_pages(kernel.release);
+    arena_limits = (ArenaLimits){
+        .fixed = true,
+        .address_share = BUSTER_ARENA_MAX_CAPACITY,
+        .commit_unbounded = true,
+    };
+    static ArenaPool pool;
+    arena_pool = &pool;
+    // Three pages written, then a copy of the arena writes two more past them and reads a sixth.
+    Arena arena = arena_reserve(BUSTER_LANE_TEST_LARGE_ARENA);
+    uint8_t* const bytes = arena.base != 0 ? arena_push(&arena, 3 * page, page) : 0;
+    Arena copy = arena;
+    uint8_t* const beyond = bytes != 0 ? arena_push(&copy, 3 * page, page) : 0;
+    lane_test_expect(tally, beyond == bytes + 3 * page && arena.peak == 3 * page, "an arena and its copy couldn't be pushed");
+    if (beyond != 0)
+    {
+        memset(bytes, 0x5a, 3 * page);
+        memset(beyond, 0xa5, 2 * page);
+        volatile const uint8_t* const read = beyond + 2 * page;
+        lane_test_expect(tally, *read == 0, "a page that was only read wasn't zero");
+    }
+    const uint8_t* const base = arena.base;
+    arena_release(&arena);
+    const uint64_t resident = pool.count == 1 ? pool.resident[0] : UINT64_MAX;
+    const uint64_t kept_pages = scans ? 5 * page : 0;
+    if (scans)
+    {
+        const bool kept = resident == kept_pages && pool.kept == resident && lane_test_resident(bytes) && lane_test_resident(beyond + page) &&
+                          lane_test_zero(bytes, 5 * page) && lane_test_zero_page(beyond + 2 * page);
+        if (!kept)
+        {
+            printf("  arena pool: a release kept %llu bytes resident, %llu in all\n", (unsigned long long)resident, (unsigned long long)pool.kept);
+        }
+        lane_test_expect(tally, kept, "a pooled arena's written pages weren't kept resident and cleared, or a page it only read was written");
+    }
+    else
+    {
+        lane_test_expect(tally, resident == 0 && pool.kept == 0, "a pool kept pages where the kernel has no PAGEMAP_SCAN");
+    }
+    // Taken again: every byte zero, and its release keeps the same five pages, cleared again.
+    Arena again = arena_reserve(BUSTER_LANE_TEST_LARGE_ARENA);
+    const uint8_t* const again_bytes = again.base == base && base != 0 ? arena_push(&again, 6 * page, page) : 0;
+    lane_test_expect(tally, again_bytes == bytes && pool.count == 0 && pool.kept == 0 && lane_test_zero(again_bytes, 6 * page),
+                     "a pooled arena wasn't taken again with every byte zero");
+    arena_release(&again);
+    lane_test_expect(tally, pool.count == 1 && pool.resident[0] == kept_pages && pool.kept == kept_pages, "a pooled arena's second release didn't keep its pages");
+    // More than a release clears: its pages are freed, and the arena is taken again zero.
+    Arena large = arena_reserve(BUSTER_LANE_TEST_LARGE_ARENA);
+    const uint64_t large_bytes = BUSTER_ARENA_POOL_CLEAR_BYTES + page;
+    uint8_t* const large_base = large.base == base && base != 0 ? arena_push(&large, large_bytes, page) : 0;
+    if (large_base != 0)
+    {
+        memset(large_base, 0x33, large_bytes);
+    }
+    arena_release(&large);
+    const bool large_freed = large_base != 0 && pool.count == 1 && pool.resident[0] == 0 && pool.kept == 0 && !lane_test_resident(large_base) &&
+                             !lane_test_resident(large_base + large_bytes - page);
+    lane_test_expect(tally, large_freed, "a pooled arena that wrote more than a release clears kept its pages");
+    large = arena_reserve(BUSTER_LANE_TEST_LARGE_ARENA);
+    uint8_t* const large_again = large.base == large_base && large_base != 0 ? arena_push(&large, large_bytes, page) : 0;
+    lane_test_expect(tally, large_again != 0 && large_again[0] == 0 && large_again[large_bytes / 2] == 0 && large_again[large_bytes - 1] == 0,
+                     "a pooled arena whose pages were freed wasn't taken again zero");
+    // A release past what the pool keeps frees its pages, few as they are.
+    if (large_again != 0)
+    {
+        memset(large_again, 0x44, 2 * page);
+    }
+    pool.kept = BUSTER_ARENA_POOL_KEPT_BYTES - page;
+    arena_release(&large);
+    const bool capped_freed = large_again != 0 && pool.count == 1 && pool.resident[0] == 0 && pool.kept == BUSTER_ARENA_POOL_KEPT_BYTES - page &&
+                              !lane_test_resident(large_base);
+    lane_test_expect(tally, capped_freed, "a release past what the pool keeps kept its pages");
+    pool.kept = 0;
+    // An arena of tables, written at three scattered pages.
+    ArenaTable tables[] = {
+        { .bytes = 1ull << 20, .small = 1ull << 20 },
+        { .bytes = 1ull << 20, .small = 1ull << 20 },
+    };
+    Arena held = arena_reserve_tables(tables, BUSTER_ARRAY_LENGTH(tables));
+    uint8_t* const first_table = tables[0].base;
+    uint8_t* const second_table = tables[1].base;
+    if (held.base != 0)
+    {
+        first_table[0] = 1;
+        first_table[700 << 10] = 2;
+        second_table[tables[1].bytes - 1] = 3;
+    }
+    const uint8_t* const held_base = held.base;
+    arena_release(&held);
+    lane_test_expect(tally, held_base != 0 && pool.count == 2 && pool.resident[1] == (scans ? 3 * page : 0) &&
+                     (!scans || lane_test_resident(first_table + (700 << 10))),
+                     "a pooled arena of tables didn't keep its three written pages");
+    held = arena_reserve_tables(tables, BUSTER_ARRAY_LENGTH(tables));
+    lane_test_expect(tally, held.base == held_base && held_base != 0 && first_table[0] == 0 && first_table[700 << 10] == 0 && second_table[tables[1].bytes - 1] == 0,
+                     "a pooled arena of tables wasn't taken again zero");
+    second_table[5] = 4;
+    arena_release(&held);
+    // arena_pool_trim frees what the pool keeps; its arenas stay in it.
+    const uint32_t count = pool.count;
+    arena_pool_trim(&pool);
+    bool trimmed = pool.kept == 0 && pool.count == count && !lane_test_resident(second_table) && !lane_test_resident(first_table);
+    for (uint32_t i = 0; i < pool.count; i += 1)
+    {
+        trimmed &= pool.resident[i] == 0;
+    }
+    lane_test_expect(tally, trimmed, "arena_pool_trim left pages the pool kept");
+    held = arena_reserve_tables(tables, BUSTER_ARRAY_LENGTH(tables));
+    lane_test_expect(tally, held.base == held_base && held_base != 0 && second_table[5] == 0, "a trimmed pool's arena wasn't taken again zero");
+    arena_release(&held);
+    arena_pool = 0;
+    arena_pool_release(&pool);
+    lane_test_expect(tally, !pool.opened && pool.count == 0 && pool.kept == 0, "a released pool kept its pagemap or its pages");
+}
+
+// lane_test_arena_pool_clear_child in a process of its own: one check here, that every check of its passed.
+static void lane_test_arena_pool_clear(LaneTestTally* tally)
+{
+    fflush(stdout);
+    const pid_t child = fork();
+    if (child == 0)
+    {
+        LaneTestTally own = { 0 };
+        lane_test_arena_pool_clear_child(&own);
+        fflush(stdout);
+        _exit(own.failures == 0 && own.checks != 0 ? 0 : 1);
+    }
+    int status = 0;
+    const bool waited = child > 0 && waitpid(child, &status, 0) == child;
+    lane_test_expect(tally, waited && WIFEXITED(status) && WEXITSTATUS(status) == 0, "the checks of a pool's kept pages failed in their process");
+}
