+// Whether the page at `address` is the kernel's shared zero page (PAGEMAP_SCAN's PAGE_IS_PFNZERO): mapped by a read,
+// never written. False where the scan can't say.
+static bool lane_test_zero_page(const uint8_t* address)
+{
+    bool result = false;
+    const int pagemap = open("/proc/self/pagemap", O_RDONLY | O_CLOEXEC);
+    if (pagemap >= 0)
+    {
+        PagemapRegion region = { 0 };
+        PagemapScan scan = {
+            .size = sizeof(scan),
+            .start = (uint64_t)(uintptr_t)address,
+            .end = (uint64_t)(uintptr_t)address + BUSTER_ARENA_PAGE_BYTES,
+            .vector = (uint64_t)(uintptr_t)&region,
+            .vector_length = 1,
+            .category_mask = BUSTER_PAGE_IS_PRESENT,
+            .return_mask = BUSTER_PAGE_IS_PFNZERO,
+        };
+        result = ioctl(pagemap, BUSTER_PAGEMAP_SCAN, &scan) == 1 && (region.categories & BUSTER_PAGE_IS_PFNZERO) != 0;
+        close(pagemap);
+    }
+    return result;
+}
+
+// Whether `count` bytes at `bytes` are all zero.
+static bool lane_test_zero(const uint8_t* bytes, uint64_t count)
+{
+    bool zero = bytes != 0;
+    for (uint64_t i = 0; zero && i < count; i += 1)
+    {
+        zero = bytes[i] == 0;
+    }
+    return zero;
+}
