+// EXPERIMENT (not for merge, #2850): which pushes need the zeros a fresh arena promises. A push's site is the file and
+// line of the call (the macros below set them); the bytes of a push past the arena's peak, which no push took before,
+// are counted by site, and filled with 0xA5 for the sites the list file marks G. BUSTER_EXPERIMENT_FRESH_LIST names the
+// list ("basename:line G" or "basename:line Z" a line), BUSTER_EXPERIMENT_FRESH_LOG the file each unit appends its
+// sites to at exit ("basename:line bytes pushes garbage").
+#include <stdatomic.h>
+#include <fcntl.h>
+typedef struct ArenaExperimentSite ArenaExperimentSite;
+struct ArenaExperimentSite
+{
+    const char* file;
+    uint32_t line;
+    uint8_t garbage;
+    uint64_t bytes;
+    uint64_t pushes;
+    uint64_t resident;
+};
+typedef struct ArenaExperimentRange ArenaExperimentRange;
+struct ArenaExperimentRange
+{
+    const uint8_t* base;
+    uint64_t bytes;
+    uint32_t slot;
+};
+static ArenaExperimentRange arena_experiment_ranges[65536];
+static uint32_t arena_experiment_range_count;
+static _Thread_local const char* arena_experiment_file;
+static _Thread_local uint32_t arena_experiment_line;
+static ArenaExperimentSite arena_experiment_sites[8192];
+static atomic_flag arena_experiment_lock = ATOMIC_FLAG_INIT;
+static int arena_experiment_state;
+static char* arena_experiment_list;
+
+static const char* arena_experiment_basename(const char* file)
+{
+    const char* slash = strrchr(file, '/');
+    return slash != NULL ? slash + 1 : file;
+}
+
+// The resident pages of the recorded pushes within [address, address + bytes), added to their sites: called before
+// the range is given back, and for everything at exit.
+static void arena_experiment_account(const uint8_t* address, uint64_t bytes)
+{
+    while (atomic_flag_test_and_set(&arena_experiment_lock))
+    {
+    }
+    for (uint32_t r = 0; r < arena_experiment_range_count; r += 1)
+    {
+        const ArenaExperimentRange* range = arena_experiment_ranges + r;
+        const uintptr_t low = (uintptr_t)(range->base > address ? range->base : address);
+        const uintptr_t range_end = (uintptr_t)range->base + range->bytes;
+        const uintptr_t asked_end = (uintptr_t)address + bytes;
+        const uintptr_t high = range_end < asked_end ? range_end : asked_end;
+        // A page is its first byte's push's: the pages that start within the range.
+        uintptr_t at = (low + 4095) & ~(uintptr_t)4095;
+        while (low < high && at < high)
+        {
+            static unsigned char pages[16384];
+            const uintptr_t span = high - at < sizeof(pages) * 4096 ? ((high - at + 4095) & ~(uintptr_t)4095) : sizeof(pages) * 4096;
+            if (mincore((void*)at, span, pages) == 0)
+            {
+                uint64_t resident = 0;
+                for (uintptr_t i = 0; i < span / 4096; i += 1)
+                {
+                    resident += pages[i] & 1;
+                }
+                arena_experiment_sites[range->slot].resident += resident * 4096;
+            }
+            at += span;
+        }
+    }
+    atomic_flag_clear(&arena_experiment_lock);
+}
+
+static void arena_experiment_dump(void)
+{
+    arena_experiment_account((const uint8_t*)0, UINT64_MAX / 2);
+    const char* path = getenv("BUSTER_EXPERIMENT_FRESH_LOG");
+    const int fd = path != NULL ? open(path, O_WRONLY | O_CREAT | O_APPEND, 0644) : -1;
+    for (uint32_t i = 0; fd >= 0 && i < 8192; i += 1)
+    {
+        const ArenaExperimentSite* site = arena_experiment_sites + i;
+        if (site->file != NULL)
+        {
+            char line[512];
+            const int length = snprintf(line, sizeof(line), "%s:%u %llu %llu %u %llu\n", arena_experiment_basename(site->file), site->line, (unsigned long long)site->bytes,
+                                        (unsigned long long)site->pushes, site->garbage, (unsigned long long)site->resident);
+            if (write(fd, line, (size_t)length) < 0)
+            {
+                break;
+            }
+        }
+    }
+    if (fd >= 0)
+    {
+        close(fd);
+    }
+}
+
+// (lane.c's own pushes, site "internal", are never filled.)
+static bool arena_experiment_file_known(const char* file)
+{
+    return strcmp(file, "internal") != 0;
+}
+
+static void arena_experiment_fresh(uint8_t* bytes, uint64_t count)
+{
+    const char* file = arena_experiment_file != NULL ? arena_experiment_file : "internal";
+    const uint32_t line = arena_experiment_file != NULL ? arena_experiment_line : 0;
+    arena_experiment_file = NULL;
+    while (atomic_flag_test_and_set(&arena_experiment_lock))
+    {
+    }
+    if (arena_experiment_state == 0)
+    {
+        const char* path = getenv("BUSTER_EXPERIMENT_FRESH_LIST");
+        const int fd = path != NULL ? open(path, O_RDONLY) : -1;
+        arena_experiment_state = 1;
+        if (fd >= 0)
+        {
+            static char text[1u << 20];
+            const ssize_t length = read(fd, text + 1, sizeof(text) - 2);
+            text[0] = '\n';
+            text[length > 0 ? length + 1 : 1] = 0;
+            arena_experiment_list = text;
+            close(fd);
+        }
+        if (path != NULL || getenv("BUSTER_EXPERIMENT_FRESH_LOG") != NULL)
+        {
+            arena_experiment_state = 2;
+            atexit(arena_experiment_dump);
+        }
+    }
+    bool garbage = false;
+    if (arena_experiment_state == 2)
+    {
+        uint32_t slot = (uint32_t)(((uintptr_t)file >> 3) * 2654435761u + line * 40503u) & 8191;
+        while (arena_experiment_sites[slot].file != NULL && (arena_experiment_sites[slot].file != file || arena_experiment_sites[slot].line != line))
+        {
+            slot = (slot + 1) & 8191;
+        }
+        ArenaExperimentSite* site = arena_experiment_sites + slot;
+        if (site->file == NULL)
+        {
+            site->file = file;
+            site->line = line;
+            char key[512];
+            // BUSTER_EXPERIMENT_FRESH_DEFAULT=G: every site garbage but those the list marks Z.
+            const char* fallback = getenv("BUSTER_EXPERIMENT_FRESH_DEFAULT");
+            const bool inverted = fallback != NULL && fallback[0] == 'G';
+            snprintf(key, sizeof(key), "\n%s:%u %c", arena_experiment_basename(file), line, inverted ? 'Z' : 'G');
+            const bool listed = arena_experiment_list != NULL && strstr(arena_experiment_list, key) != NULL;
+            site->garbage = inverted ? !listed && arena_experiment_file_known(file) : listed;
+        }
+        site->bytes += count;
+        site->pushes += 1;
+        garbage = site->garbage != 0;
+        if (arena_experiment_range_count < 65536)
+        {
+            arena_experiment_ranges[arena_experiment_range_count++] = (ArenaExperimentRange){ .base = bytes, .bytes = count, .slot = slot };
+        }
+    }
+    atomic_flag_clear(&arena_experiment_lock);
+    if (garbage)
+    {
+        memset(bytes, 0xA5, count);
+    }
+}
