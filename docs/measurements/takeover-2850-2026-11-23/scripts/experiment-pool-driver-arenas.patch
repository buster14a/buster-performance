diff --git a/src/buster/compiler/c_checker_driver.c b/src/buster/compiler/c_checker_driver.c
index 73aa62e8..37eba2e4 100644
--- a/src/buster/compiler/c_checker_driver.c
+++ b/src/buster/compiler/c_checker_driver.c
@@ -15097,6 +15097,40 @@ static int check_driver_command(int count, char** arguments, bool executable, bo
     Arena arena = arena_reserve(reservation_bytes);
     Arena scratch = arena_reserve(reservation_bytes);
     Arena output_arena = arena_reserve(reservation_bytes);
+    // EXPERIMENT (not for merge, #2850). BUSTER_EXPERIMENT_TOUCHED: the reader's and the run's arenas read as used before
+    // (their peaks at their capacities), so that what asks whether they are untouched clears for itself.
+    // BUSTER_EXPERIMENT_POOL_FILE=PATH: that, and their memory is the file's, mapped shared over their reservations at a
+    // place of the file congruent with their addresses (2 MB), so that a previous compile's huge pages are found again.
+    {
+        const char* pool_file = getenv("BUSTER_EXPERIMENT_POOL_FILE");
+        const int pool = pool_file != NULL ? open(pool_file, O_RDWR | O_CREAT, 0600) : -1;
+        Arena* const pooled[] = { &arena, &output_arena };
+        for (uint32_t i = 0; i < 2 && (pool_file != NULL || getenv("BUSTER_EXPERIMENT_TOUCHED") != NULL); i += 1)
+        {
+            Arena* one = pooled[i];
+            if (one->base != NULL && pool >= 0)
+            {
+                uint8_t* mapping = one->base - one->mapping_offset;
+                const uint64_t slot = (uint64_t)i * (UINT64_C(1) << 37);
+                const uint64_t place = slot + ((uintptr_t)mapping & (BUSTER_ARENA_HUGE_PAGE_BYTES - 1));
+                const bool sized = ftruncate(pool, (off_t)(UINT64_C(1) << 38)) == 0;
+                const bool shared = sized && mmap(mapping, one->mapping_bytes, PROT_NONE, MAP_SHARED | MAP_NORESERVE | MAP_FIXED, pool, (off_t)place) == mapping;
+                if (shared)
+                {
+                    madvise(mapping, one->mapping_bytes, MADV_HUGEPAGE);
+                }
+                else
+                {
+                    fprintf(stderr, "experiment: the pool file could not be mapped\n");
+                }
+            }
+            one->peak = one->capacity;
+        }
+        if (pool >= 0)
+        {
+            close(pool);
+        }
+    }
     // The command fails at once if one of them can't be reserved, though a command of several units uses only the first.
     const bool reserved = arena.base != NULL && scratch.base != NULL && output_arena.base != NULL;
     char** filtered = arena_push_array(&arena, (uint64_t)count + 1, sizeof(char*), _Alignof(char*));
