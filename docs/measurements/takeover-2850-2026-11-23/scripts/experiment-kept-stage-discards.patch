+static int arena_experiment_keep_state;
+static bool arena_experiment_keep(void)
+{
+    int state = __atomic_load_n(&arena_experiment_keep_state, __ATOMIC_RELAXED);
+    if (state == 0)
+    {
+        const char* value = getenv("BUSTER_EXPERIMENT_KEEP_PAGES");
+        state = value != NULL && value[0] == '1' ? 2 : value != NULL && value[0] == '2' ? 3 : 1;
+        __atomic_store_n(&arena_experiment_keep_state, state, __ATOMIC_RELAXED);
+    }
+    return state >= 2;
+}
+
+// EXPERIMENT: a push's site (the macros at the file's end set it; lane.c's own pushes have none), and whether a kept
+// page's bytes are cleared for it: always with BUSTER_EXPERIMENT_KEEP_PAGES=1; with 2, only at the sites
+// BUSTER_EXPERIMENT_FRESH_LIST's file names ("basename:line Z" a line) and at lane.c's own.
+typedef struct ArenaExperimentSite ArenaExperimentSite;
+struct ArenaExperimentSite
+{
+    const char* file;
+    uint32_t line;
+    bool zero;
+};
+static _Thread_local const char* arena_experiment_site_file;
+static _Thread_local uint32_t arena_experiment_site_line;
+static ArenaExperimentSite arena_experiment_sites[4096];
+static char arena_experiment_list[1u << 16];
+static int arena_experiment_list_state;
+
+static bool arena_experiment_clears(void)
+{
+    bool clears = true;
+    const char* file = arena_experiment_site_file;
+    if (arena_experiment_keep_state == 3 && file != NULL)
+    {
+        const uint32_t line = arena_experiment_site_line;
+        uint32_t slot = (uint32_t)(((uintptr_t)file >> 3) * 2654435761u + line * 40503u) & 4095;
+        while (arena_experiment_sites[slot].file != NULL && (arena_experiment_sites[slot].file != file || arena_experiment_sites[slot].line != line))
+        {
+            slot = (slot + 1) & 4095;
+        }
+        ArenaExperimentSite* site = arena_experiment_sites + slot;
+        if (site->file == NULL)
+        {
+            if (arena_experiment_list_state == 0)
+            {
+                const char* path = getenv("BUSTER_EXPERIMENT_FRESH_LIST");
+                const int fd = path != NULL ? open(path, O_RDONLY) : -1;
+                arena_experiment_list[0] = '\n';
+                const ssize_t length = fd >= 0 ? read(fd, arena_experiment_list + 1, sizeof(arena_experiment_list) - 2) : 0;
+                arena_experiment_list[length > 0 ? length + 1 : 1] = 0;
+                if (fd >= 0)
+                {
+                    close(fd);
+                }
+                arena_experiment_list_state = 1;
+            }
+            const char* slash = strrchr(file, '/');
+            char key[512];
+            snprintf(key, sizeof(key), "\n%s:%u Z", slash != NULL ? slash + 1 : file, line);
+            site->line = line;
+            site->zero = strstr(arena_experiment_list, key) != NULL;
+            site->file = file;
+        }
+        clears = site->zero;
+    }
+    return clears;
+}
