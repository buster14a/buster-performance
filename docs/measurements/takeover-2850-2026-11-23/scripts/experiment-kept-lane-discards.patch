diff --git a/src/buster/compiler/c_checker_units.c b/src/buster/compiler/c_checker_units.c
index 840eae4b..db85c8da 100644
--- a/src/buster/compiler/c_checker_units.c
+++ b/src/buster/compiler/c_checker_units.c
@@ -2164,9 +2164,27 @@ static void check_units_memory_give(CheckUnitsLane* lane)
 {
     if (lane->held != 0)
     {
-        arena_discard(&lane->arena);
-        arena_discard(&lane->scratch);
-        arena_discard(&lane->output);
+        // EXPERIMENT (not for merge, #2850): BUSTER_EXPERIMENT_KEEP_UNITS=1 keeps the three arenas' pages for the lane's next
+        // unit; 2 keeps them and fills what the unit pushed past each arena's length with 0xA5, so that a later unit that
+        // reads what it did not write reads no zero.
+        const char* keep = getenv("BUSTER_EXPERIMENT_KEEP_UNITS");
+        Arena* const arenas[] = { &lane->arena, &lane->scratch, &lane->output };
+        for (uint32_t a = 0; a < 3; a += 1)
+        {
+            if (keep == NULL || keep[0] == '0')
+            {
+                arena_discard(arenas[a]);
+            }
+            else if (keep[0] == '2' && arenas[a]->base != 0 && arenas[a]->peak > arenas[a]->length)
+            {
+                const uint64_t written = arenas[a]->committed > arenas[a]->mapping_offset ? arenas[a]->committed - arenas[a]->mapping_offset : 0;
+                const uint64_t end = arenas[a]->peak < written ? arenas[a]->peak : written;
+                if (end > arenas[a]->length)
+                {
+                    memset(arenas[a]->base + arenas[a]->length, 0xA5, end - arenas[a]->length);
+                }
+            }
+        }
         check_units_memory_return(lane);
     }
 }
