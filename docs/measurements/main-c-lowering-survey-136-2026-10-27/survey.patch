+    for (uint32_t b = part->first; b < part->end && (status->status == CHECK_PROGRAM_OK || survey); b += 1)
     {
+        if (survey && b != part->first)
+        {
+            survey_failed |= check_lower_survey_print(program, b - 1, status);
+        }
