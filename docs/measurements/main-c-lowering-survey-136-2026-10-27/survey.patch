--- a/src/buster/compiler/c_check_program_lower.c
+++ b/src/buster/compiler/c_check_program_lower.c
@@ -5696,6 +5696,21 @@
 // `sources`, each body's entries' source tokens too: a constant in each copy (check_lower_part and
 // check_lower_part_sources), so that the plain lowering, every compile's without -g, carries none of the tokens' state
 // through its loops: a flag clang can't fold there made it spill more in them, which every compile paid (#426).
+// The survey (not part of the compiler): with BUSTER_LOWER_SURVEY set, every body's lowering is written to standard
+// error with its status and its first refusal's reason, and the part goes on past a refusal; a part with one stops
+// before Tier 0, so that -c fails once every body has been lowered.
+static bool check_lower_survey_print(const CheckProgram* program, uint32_t b, CheckProgramLowered* status)
+{
+    const uint32_t declaration = program->bodies[b].declaration;
+    const IdentId name = program->parser->tokens.names[declaration];
+    fprintf(stderr, "survey\t%.*s\t%u\t%s\n", (int)intern_length(program->identifiers, name), (const char*)intern_bytes(program->identifiers, name),
+            status->status, status->status == CHECK_PROGRAM_OK ? "ok" : status->reason != NULL ? status->reason : "-");
+    const bool failed = status->status != CHECK_PROGRAM_OK;
+    status->status = CHECK_PROGRAM_OK;
+    status->reason = NULL;
+    return failed;
+}
+
 static inline __attribute__((always_inline)) void check_lower_part_body(CheckLowerWriter* writer, const CheckLowerShared* shared, CheckLowerPart* part,
                                                                        bool sources, Arena* output, Arena* scratch)
 {
