+        const bool stored = zero_right || small_right;
+        const bool converted = zero_left || small_left;
+        const bool null = (left == BUSTER_NODE_TESTS_KIND_POINTER && zero_right) || (right == BUSTER_NODE_TESTS_KIND_POINTER && zero_left);
