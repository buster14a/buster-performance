+// A skipped directive's name, read from its '#' at `at`: the conditional it is (FPP_KW_*, 0 for any other directive),
+// where the name ends, and the newlines before that (a splice's or a comment's, #3577).
+typedef struct FastSkippedDirective FastSkippedDirective;
+struct FastSkippedDirective
+{
+    const uint8_t* next;
+    uint32_t keyword;
+    uint32_t lines;
+};
