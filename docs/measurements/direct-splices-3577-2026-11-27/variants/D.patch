+// The name of a skipped directive that a backslash follows, or whose '#' and blanks a backslash or a '/' follows (#3577),
+// as the full pipeline reads it: past the line splices in it, and the blanks, splices and block comments before it
+// (`#el\` + newline + `se` is an #else, `#\` + newline + `endif` an #endif, `#/**/else` an #else). `p` is the first byte
+// after the '#' and its blanks. A backslash in the name that starts no splice (a UCN's), or a comment that doesn't end,
+// leaves the direct path, and the name then runs to the file's end. Out of line and cold: the skip asks it only where
+// those bytes follow.
+static __attribute__((noinline, cold)) FastSkippedDirective fast_skipped_directive_spliced(FastPP* pp, const uint8_t* p, const uint8_t* end)
+{
+    const uint8_t* at = p;
+    uint32_t newlines = 0;
+    bool leave = false;
+    bool before = true;
+    while (before && !leave && at < end)
+    {
+        uint32_t spliced = 0;
+        const uint8_t* const joined = fast_pass_splices(at, end, &spliced);
+        newlines += spliced;
+        if (joined != at)
+        {
+            at = joined;
+        }
+        else if ((fast_char_class[*at] & 8u) != 0)
+        {
+            at += 1;
+        }
+        else if (*at == '/' && at + 1 < end && at[1] == '*')
+        {
+            uint32_t comment_lines = 0;
+            const uint8_t* const after = fast_skip_block_comment(at + 2, end, &comment_lines);
+            newlines += comment_lines;
+            leave = after == NULL;
+            at = after == NULL ? end : after;
+        }
+        else
+        {
+            before = false;
+        }
+    }
+    uint8_t name[8] = { 0 };
+    uint32_t length = 0;
+    bool more = true;
+    while (more && !leave && at < end)
+    {
+        if ((fast_char_class[*at] & 1u) != 0)
+        {
+            name[length & 7u] = *at;
+            length += 1;
+            at += 1;
+        }
+        else if (*at == '\\')
+        {
+            uint32_t spliced = 0;
+            const uint8_t* const joined = fast_pass_splices(at, end, &spliced);
+            newlines += spliced;
+            leave = joined == at;
+            at = joined;
+        }
+        else
+        {
+            more = false;
+        }
+    }
+    if (leave)
+    {
+        fast_pp_bail(pp, "directive name across a backslash in a skipped group");
+    }
+    return (FastSkippedDirective){
+        .next = leave ? end : at,
+        .keyword = leave ? 0u : fast_conditional_keyword(name, length),
+        .lines = newlines,
+    };
+}
