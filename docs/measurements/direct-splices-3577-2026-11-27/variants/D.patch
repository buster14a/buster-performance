+// The skip's read of a directive whose '#' is at `at`. Out of line, so that the skip's loop keeps its registers: each
+// skipped directive calls it once.
+static __attribute__((noinline)) FastSkippedDirective fast_skipped_directive(FastPP* pp, const uint8_t* at, const uint8_t* end)
+{
+    const uint8_t* const name = fast_skip_hspace(at + 1, end);
+    FastSkippedDirective read = { .next = name, .keyword = 0, .lines = 0 };
+    if (name < end && (fast_char_class[*name] & 2u) != 0)
+    {
+        const uint32_t length = fast_scan_ident_len(name, end);
+        read.keyword = fast_conditional_keyword(name, length);
+        read.next = name + length;
+        // #3577: a backslash after the name may be a line splice that the name goes on past.
+        if (__builtin_expect(read.next < end && *read.next == '\\', 0))
+        {
+            read = fast_skipped_directive_spliced(pp, name, end);
+        }
+    }
+    else if (__builtin_expect(name < end && (*name == '\\' || *name == '/'), 0))
+    {
+        // #3577: a line splice or a comment before the name.
+        read = fast_skipped_directive_spliced(pp, name, end);
+    }
+    return read;
+}
