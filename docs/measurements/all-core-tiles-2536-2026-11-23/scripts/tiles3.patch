+        .typedef_names = BUSTER_ARENA_PUSH_ARRAY(arena, uint8_t, name_capacity),
+        .typedef_first = BUSTER_ARENA_PUSH_ARRAY(arena, uint32_t, name_capacity),
+        .typedef_heads = BUSTER_ARENA_PUSH_ARRAY(arena, uint32_t, name_capacity),
+    };
