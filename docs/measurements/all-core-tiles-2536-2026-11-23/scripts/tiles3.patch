+        memset(names.typedef_names, 0, name_capacity);
+        memset(names.typedef_first, 0, (uint64_t)name_capacity * sizeof(uint32_t));
+        memset(names.typedef_heads, 0, (uint64_t)name_capacity * sizeof(uint32_t));
