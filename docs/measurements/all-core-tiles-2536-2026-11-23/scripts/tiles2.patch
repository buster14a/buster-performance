+    memset(kernels->roles - BUSTER_PARSE_TOKEN_PADDING, PARSE_ROLE_NONE, slots);
+    memset(kernels->flags - BUSTER_PARSE_TOKEN_PADDING, 0, slots);
+    memset(kernels->node_depths - BUSTER_PARSE_TOKEN_PADDING, 0, slots * sizeof(uint32_t));
+    kernels->typedef_count = 0;
+}
