+// The kernels' state as parse_kernels_reserve_tree left it, for a unit's parse after its tiles' gave up.
+static void parse_kernels_again(ParseKernels* kernels, uint32_t count, uint32_t name_capacity)
+{
+    const uint64_t slots = (uint64_t)count + 2 * BUSTER_PARSE_TOKEN_PADDING;
+    memset(kernels->typedef_names, 0, name_capacity);
+    memset(kernels->typedef_first, 0, (uint64_t)name_capacity * sizeof(uint32_t));
+    memset(kernels->typedef_heads, 0, (uint64_t)name_capacity * sizeof(uint32_t));
