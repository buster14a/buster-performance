+    prepass->visits = prepass->syntax != NULL ? arena_push_array(prepass->scratch, slots + BUSTER_CHECK_VISITS_PADDING, sizeof(uint8_t), 64) : NULL;
+    prepass->prefixes = prepass->visits != NULL ? arena_push_array(prepass->scratch, slots, sizeof(uint8_t), 64) : NULL;
+    uint32_t* const traversal = prepass->traversal && prepass->prefixes != NULL ? arena_push_array(prepass->scratch, 6 * slots, sizeof(uint32_t), 64) : NULL;
+    prepass->postorder = traversal;
+    prepass->positions = traversal != NULL ? traversal + slots : NULL;
+    prepass->ends = traversal != NULL ? traversal + 2 * slots : NULL;
+    prepass->first_children = traversal != NULL ? traversal + 3 * slots : NULL;
+    prepass->next_siblings = traversal != NULL ? traversal + 4 * slots : NULL;
