+        CheckInputPrefixBits following = (uint64_t)(block + 1) << 6 < count ? check_input_prefix_bits(token_kinds, token_roles, (block + 1) << 6, count) : (CheckInputPrefixBits){ 0 };
+        bool more = true;
+        while (more)
+        {
+            const uint32_t first = block << 6;
+            const CheckInputPrefixBits bits = check_input_prefix_bits(token_kinds, token_roles, first, count);
+            const unsigned __int128 specifier = bits.specifiers | ((unsigned __int128)following.specifiers << 64);
+            const unsigned __int128 star = bits.stars | ((unsigned __int128)following.stars << 64);
+            const unsigned __int128 name = (bits.names | ((unsigned __int128)following.names << 64)) & ((bits.delimiters | ((unsigned __int128)following.delimiters << 64)) >> 1);
+            const unsigned __int128 single_pointer = star & (name >> 1);
+            const unsigned __int128 double_pointer = star & (single_pointer >> 1);
+            uint64_t prefix = bits.specifiers;
+            __m512i result = _mm512_setzero_si512();
+            #pragma clang loop unroll(full)
+            for (uint32_t length = 1; length <= 4; length += 1)
+            {
+                result = _mm512_mask_set1_epi8(result, prefix & (uint64_t)(name >> length), (char)length);
+                result = _mm512_mask_set1_epi8(result, prefix & (uint64_t)(single_pointer >> length), (char)(8 + length));
+                result = _mm512_mask_set1_epi8(result, prefix & (uint64_t)(double_pointer >> length), (char)(16 + length));
+                prefix &= (uint64_t)(specifier >> length);
+            }
+            // The block's lanes in the range: from `begin` where the block starts before it, to `end` where it ends past it.
+            const uint32_t from = begin > first ? begin - first : 0;
+            const uint32_t to = end - first < 64 ? end - first : 64;
