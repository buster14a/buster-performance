+        "__builtin_va_copy",
+        "__builtin_va_end",
+        "__builtin_ms_va_start",
+        "__builtin_ms_va_end",
+        "__builtin_ms_va_copy",
+        "__builtin_zos_va_start",
+        "__builtin_zos_va_end",
+        "__builtin_zos_va_copy",
