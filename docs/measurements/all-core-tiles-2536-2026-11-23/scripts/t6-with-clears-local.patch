+// The masks check_input_named_prefixes reads of the 64 tokens from `first`: the specifiers, the stars, the names and
+// the delimiters among those before `count`.
+typedef struct CheckInputPrefixBits CheckInputPrefixBits;
+struct CheckInputPrefixBits
+{
+    uint64_t specifiers;
+    uint64_t stars;
+    uint64_t names;
+    uint64_t delimiters;
