+// How far past a token its prefix's byte reads: four specifiers, two stars, a name and its delimiter.
+#define BUSTER_CHECK_PREFIX_REACH 8u
+
+// check_input_named_prefixes for the tokens [begin, end) of a unit of `count`: the same blocks of 64 from the unit's
+// first token, from the range's last down, each given the block after it, so each token's byte is the unit's pass's.
+// It reads the kinds and roles of the tokens up to BUSTER_CHECK_PREFIX_REACH - 1 past the range's last.
+static void check_input_named_prefixes_range(const uint8_t* token_kinds, const uint8_t* token_roles, uint32_t count, uint8_t* prefixes, uint32_t begin, uint32_t end)
+{
