+static CheckInputPrefixBits check_input_prefix_bits(const uint8_t* token_kinds, const uint8_t* token_roles, uint32_t first, uint32_t count)
+{
+    CheckInputPrefixBits result = { 0 };
+    if (first < count)
+    {
+        const __mmask64 lanes = check_input_scan_all(first, count);
+        const __m512i kinds = _mm512_maskz_loadu_epi8(lanes, token_kinds + first);
+        const __m512i roles = _mm512_maskz_loadu_epi8(lanes, token_roles + first);
+        result.specifiers = _mm512_mask_cmpeq_epi8_mask(lanes, roles, _mm512_set1_epi8(PARSE_ROLE_SPECIFIER));
+        result.stars = _mm512_mask_cmpeq_epi8_mask(lanes, kinds, _mm512_set1_epi8(PARSE_KIND_STAR));
+        result.names = _mm512_cmpeq_epi8_mask(roles, _mm512_set1_epi8(PARSE_ROLE_OPERAND)) & _mm512_mask_cmpeq_epi8_mask(lanes, kinds, _mm512_set1_epi8(PARSE_KIND_IDENTIFIER));
+        result.delimiters = lanes & (_mm512_cmpeq_epi8_mask(kinds, _mm512_set1_epi8(PARSE_KIND_SEMI)) | _mm512_cmpeq_epi8_mask(kinds, _mm512_set1_epi8(PARSE_KIND_COMMA)) |
+                                     _mm512_cmpeq_epi8_mask(kinds, _mm512_set1_epi8(PARSE_KIND_EQUAL)) | _mm512_cmpeq_epi8_mask(kinds, _mm512_set1_epi8(PARSE_KIND_R_PAREN)) |
+                                     _mm512_cmpeq_epi8_mask(roles, _mm512_set1_epi8(PARSE_ROLE_OPEN_FUNCTION)));
+    }
+    return result;
+}
