+// The reader's passes before its walk a tile of the parse at a time (#2536, check_input_prepass_tile): how many bytes
+// and counts differ from the unit's passes' over the same tokens, in three readings: every token a tile, tiles of
+// random lengths, and tiles until one past the unit's middle is refused and the unit is given as one. While a tile's
+// call runs, the roles past its end hold a byte that isn't theirs (`poison`), as the parse hasn't written them.
+static uint32_t check_test_scan_tiles(CheckTest* test, const uint8_t* kinds, uint8_t* roles, const uint32_t* names, uint32_t count, const uint32_t* sought,
+                                      const uint8_t* groups, uint32_t sought_count, uint8_t poison)
+{
+    uint32_t differences = 0;
+    Parser parser = { 0 };
+    parser.tokens.count = count;
+    parser.tokens.kinds = (uint8_t*)kinds;
+    parser.tokens.names = (uint32_t*)names;
+    parser.tree.roles = roles;
+    const uint64_t slots = (uint64_t)count + 1;
+    uint8_t* const columns = malloc(7 * slots + BUSTER_CHECK_VISITS_PADDING);
+    uint8_t* const unit_syntax = columns;
+    uint8_t* const unit_visits = columns + slots;
+    uint8_t* const unit_prefixes = columns + 2 * slots;
+    uint8_t* const tile_syntax = columns + 3 * slots;
+    uint8_t* const tile_prefixes = columns + 4 * slots;
+    uint8_t* const saved = columns + 5 * slots;
+    uint8_t* const tile_visits = columns + 6 * slots;
+    if (columns != NULL)
+    {
+        const CheckInputTokenCounts unit = check_input_count_tokens(&parser, sought, groups, sought_count, unit_syntax, unit_visits);
+        check_input_named_prefixes(&parser, unit_prefixes);
+        for (uint32_t reading = 0; reading < 3; reading += 1)
+        {
+            CheckInputPrepass prepass = { .parser = &parser, .count = count, .syntax = tile_syntax, .visits = tile_visits, .prefixes = tile_prefixes, .name_count = sought_count };
+            memcpy(prepass.names, sought, sought_count * sizeof(uint32_t));
+            memcpy(prepass.groups, groups, sought_count);
+            memset(tile_syntax, 0xa5, slots);
+            memset(tile_visits, 0xa5, slots);
+            memset(tile_prefixes, 0xa5, slots);
+            bool refuse = reading == 2;
+            uint32_t begin = 0;
+            while (!prepass.complete)
+            {
+                const uint32_t length = reading == 0 ? 1 : 1 + check_test_random(test) % 70;
+                uint32_t end = count - begin < length ? count : begin + length;
+                if (refuse && begin > count / 2)
+                {
+                    // The unit over again, as one.
+                    refuse = false;
+                    begin = 0;
+                    end = count;
+                }
+                memcpy(saved, roles + end, count - end);
+                memset(roles + end, poison, count - end);
+                check_input_prepass_tile(&prepass, &parser.tree, begin, end);
+                memcpy(roles + end, saved, count - end);
+                begin = end;
+            }
+            differences += memcmp(tile_syntax, unit_syntax, slots) != 0;
+            differences += memcmp(tile_visits, unit_visits, slots) != 0;
+            differences += count != 0 && memcmp(tile_prefixes, unit_prefixes, count) != 0;
+            const CheckInputTokenCounts* const tiles = &prepass.state.counts;
+            differences += tiles->subscripts != unit.subscripts || tiles->asms != unit.asms || tiles->asm_groups != unit.asm_groups || tiles->size_queries != unit.size_queries ||
+                           tiles->vector_members != unit.vector_members || tiles->pretty_function_name != unit.pretty_function_name || tiles->operands != unit.operands ||
+                           tiles->calls != unit.calls || memcmp(tiles->groups, unit.groups, sizeof(unit.groups)) != 0;
+            differences += prepass.counted != count || prepass.prefixed != count;
+        }
+        free(columns);
+    }
+    return differences + (columns == NULL);
+}
