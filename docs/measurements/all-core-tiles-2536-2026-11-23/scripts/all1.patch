+// The sink's columns for a reading of `parser` on `scratch`, or null: they followed that parse to its end, are on that
+// scratch, and no reading has taken them yet.
+static CheckInputPrepass* check_input_prepass_take(const Parser* parser, const Arena* scratch)
+{
+    CheckInputPrepass* const prepass = parser->options.sink.done == check_input_prepass_tile ? parser->options.sink.context : NULL;
+    const bool usable = prepass != NULL && prepass->parser == parser && prepass->count == parser->tokens.count && prepass->scratch == scratch && prepass->complete &&
+                        !prepass->taken && parser->tree.roles != NULL;
+    if (usable)
+    {
+        prepass->taken = true;
+    }
+    return usable ? prepass : NULL;
+}
