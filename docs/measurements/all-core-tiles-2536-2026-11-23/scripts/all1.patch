+        // temporaries a tile's, placed so that the tile's tokens' entries are theirs.
+        const uint64_t mark = prepass->scratch->length;
+        const uint64_t room = (uint64_t)(end - begin) + 1;
+        uint32_t* const passes = arena_push_array(prepass->scratch, 3 * room, sizeof(uint32_t), 64);
+        if (passes != NULL)
+        {
+            const uintptr_t bias = (uintptr_t)begin * sizeof(uint32_t);
+            uint32_t* const last_children = (uint32_t*)((uintptr_t)passes - bias);
+            uint32_t* const before = (uint32_t*)((uintptr_t)(passes + room) - bias);
+            uint32_t* const starts = (uint32_t*)((uintptr_t)(passes + 2 * room) - bias);
+            parse_tree_columns_range(tree->parents, begin, end, last_children, before, prepass->postorder, prepass->positions, prepass->ends, prepass->first_children,
+                                     prepass->next_siblings, starts, prepass->sizes);
+            if (end == count)
+            {
+                parse_tree_columns_sentinel(count, prepass->positions, prepass->ends, prepass->first_children, prepass->next_siblings);
+                prepass->sizes[count] = 0;
+            }
+        }
+        prepass->underived = passes == NULL;
+        arena_pop_to(prepass->scratch, mark);
+    }
+    // A tile that isn't the unit's last has tokens after it whose roles the parse hasn't written: each pass stops as far
+    // before the tile's end as it reads ahead, and the next tile's call takes it from there.
+    const bool last = end == count;
+    const uint32_t counted = last ? count : end - 1 > prepass->counted ? end - 1 : prepass->counted;
+    check_input_count_range(tokens->kinds, tree->roles, tokens->names, count, prepass->names, prepass->groups, prepass->name_count, prepass->syntax, prepass->visits,
+                            &prepass->state, prepass->counted, counted);
+    prepass->counted = counted;
+    const uint32_t prefixed = last ? count : end > prepass->prefixed + BUSTER_CHECK_PREFIX_REACH ? end - BUSTER_CHECK_PREFIX_REACH : prepass->prefixed;
+    check_input_named_prefixes_range(tokens->kinds, tree->roles, count, prepass->prefixes, prepass->prefixed, prefixed);
+    prepass->prefixed = prefixed;
+    if (last)
+    {
+        prepass->syntax[count] = 0;
+        prepass->visits[count] = 0;
+        prepass->tile_ends[0] = prepass->tile_count > prepass->tile_capacity ? count : prepass->tile_ends[0];
+        prepass->tile_count = prepass->tile_count > prepass->tile_capacity ? 1 : prepass->tile_count;
+        prepass->complete = true;
+    }
+}
