+// The names check_input_count_tokens counts for a reading of `pp`'s unit, each with its group: returns how many.
+static uint32_t check_input_count_names(Preprocessor* pp, uint32_t* names, uint8_t* groups)
+{
+    const char* const vararg_spellings[] =
+    {
+        "__builtin_va_start",
+        "__builtin_stdarg_start",
+        "__builtin_c23_va_start",
+        "__builtin_va_arg",
+        "__builtin_va_copy",
+        "__builtin_va_end",
+        "__builtin_ms_va_start",
+        "__builtin_ms_va_end",
+        "__builtin_ms_va_copy",
+        "__builtin_zos_va_start",
+        "__builtin_zos_va_end",
+        "__builtin_zos_va_copy",
+    };
+    const char* const spellings[] =
+    {
+        "transparent_union",
+        "__transparent_union__",
+        "overloadable",
+        "__overloadable__",
+    };
+    // The builtins of constants the walk works out (check_input_builtin_constant_prepare) size its table of them: the
+    // type queries' names here, and the place's and the type queries' keywords by their span, which the count tests itself
+    // (BUSTER_CHECK_SOURCE_BUILTIN_SPAN).
+    names[0] = C_NAME_BUILTIN_TYPES_COMPATIBLE_P;
+    names[1] = C_NAME_BUILTIN_OFFSETOF;
+    names[2] = C_NAME_GENERIC;
+    names[3] = C_NAME_BUILTIN_CHOOSE_EXPR;
+    groups[0] = CHECK_INPUT_COUNT_BUILTIN_CONSTANTS;
+    groups[1] = CHECK_INPUT_COUNT_BUILTIN_CONSTANTS;
+    groups[2] = CHECK_INPUT_COUNT_SELECTIONS;
+    groups[3] = CHECK_INPUT_COUNT_SELECTIONS;
+    // A spelling the unit never interned counts no token, so it takes no comparison: most units name few of these.
+    uint32_t name_count = 4;
+    for (uint32_t i = 0; i < BUSTER_ARRAY_LENGTH(vararg_spellings); i += 1)
+    {
+        names[name_count] = intern_find(pp->table, (const uint8_t*)vararg_spellings[i], (uint32_t)strlen(vararg_spellings[i]));
+        groups[name_count] = CHECK_INPUT_COUNT_VARARGS;
+        name_count += names[name_count] != 0;
+    }
+    for (uint32_t i = 0; i < BUSTER_ARRAY_LENGTH(spellings); i += 1)
+    {
+        names[name_count] = intern_find(pp->table, (const uint8_t*)spellings[i], (uint32_t)strlen(spellings[i]));
+        groups[name_count] = i < 2 ? CHECK_INPUT_COUNT_TRANSPARENT_UNIONS : CHECK_INPUT_COUNT_OVERLOADABLE;
