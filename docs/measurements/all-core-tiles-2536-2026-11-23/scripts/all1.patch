+    if (prepass->parser != NULL && prepass->scratch->length == prepass->end && prepass->end != prepass->mark)
+    {
+        arena_pop_to(prepass->scratch, prepass->mark);
+        prepass->end = prepass->mark;
+        prepass->complete = false;
+    }
