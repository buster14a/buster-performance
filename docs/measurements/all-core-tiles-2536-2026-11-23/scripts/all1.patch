+static void check_input_prepass_tile(void* context, const ParseTree* tree, uint32_t begin, uint32_t end)
+{
+    CheckInputPrepass* const prepass = context;
+    const ParseTokens* const tokens = &prepass->parser->tokens;
+    const uint32_t count = prepass->count;
+    if (begin == 0)
+    {
+        // The unit's first tokens, or the unit over again after one of its tiles was refused.
+        prepass->state = (CheckInputCountState){ 0 };
+        prepass->counted = 0;
+        prepass->prefixed = 0;
+        prepass->complete = false;
+        prepass->underived = false;
+        prepass->tile_count = 0;
+    }
+    // The tile's end, or with no room for it (a tile shorter than the fewest tokens) the unit as one tile.
+    if (prepass->tile_count < prepass->tile_capacity)
+    {
+        prepass->tile_ends[prepass->tile_count] = end;
+        prepass->tile_count += 1;
+    }
+    else
+    {
+        prepass->tile_ends[0] = count;
+        prepass->tile_count = prepass->tile_capacity + 1;
+    }
