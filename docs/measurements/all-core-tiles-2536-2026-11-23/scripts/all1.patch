+// Gives the scratch back what the sink pushed, once the reading that took its columns is over: where the scratch is as
+// long as the sink left it, so nothing after it is in the way. The stages after the reader take the pages again.
+static void check_input_prepass_release(CheckInputPrepass* prepass)
