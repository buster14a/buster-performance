+// The reader's passes before its walk whose inputs are the parse's alone, made a tile of the parse at a time (#2536): the
+// parse's sink (ParseTileSink) for check_input_count_tokens' counts and columns and check_input_named_prefixes' column.
+// Each tile's kinds, names and roles are read while the parse's writes of them are in the cache, where a pass over the
+// unit after the parse took them from memory again. check_input_run takes the columns for its own
+// (check_input_prepass_take) where the parse it reads is the one they followed; the unit as one makes them in one
+// call, and a reading without them makes its own, the twin.
+typedef struct CheckInputPrepass CheckInputPrepass;
+struct CheckInputPrepass
+{
+    // Whose names are counted, and where the columns go, the parse's scratch: set by who starts the parse.
+    Preprocessor* pp;
+    Arena* scratch;
+    // The parse followed, and its tokens.
+    const Parser* parser;
+    uint32_t count;
+    // check_input_count_tokens' columns, count + 1 bytes each (the marks' with their padding), and
+    // check_input_named_prefixes', count + 1.
+    uint8_t* syntax;
+    uint8_t* visits;
+    uint8_t* prefixes;
+    // The names counted (check_input_count_names).
+    uint32_t names[BUSTER_CHECK_INPUT_COUNT_NAMES];
+    uint8_t groups[BUSTER_CHECK_INPUT_COUNT_NAMES];
+    uint32_t name_count;
+    // The counts of the tokens before `counted`, and the tokens the prefixes' pass has done: the first stays a token behind
+    // a tile's end, whose successor's role the next tile writes, and the second BUSTER_CHECK_PREFIX_REACH behind.
+    CheckInputCountState state;
+    uint32_t counted;
+    uint32_t prefixed;
+    // The tree's traversal (parse_tree_columns' columns and the subtrees' sizes, count + 1 entries each), derived from
+    // each tile's parents as the parse leaves them, or null: `traversal`, set by who starts the parse, asks for it. Its
+    // passes' temporaries are a tile's, pushed past the parse's own and popped again in each call. `underived` says a
+    // call had no memory for them, and the columns aren't the unit's.
+    bool traversal;
+    bool underived;
+    uint32_t* postorder;
+    uint32_t* positions;
+    uint32_t* ends;
+    uint32_t* first_children;
+    uint32_t* next_siblings;
+    uint32_t* sizes;
+    // Where each of the parse's tiles ended, in order, the last at the unit's count: the tiles the reading's own passes
+    // then take one at a time (CheckInputReader.tile_ends). A unit parsed as one has one. `tile_tokens`, set by who starts
+    // the parse, is the fewest tokens a tile but the last has (ParseOptions.tile_tokens), which bounds their number; a
+    // parse that gives more leaves the unit one tile.
+    uint32_t tile_tokens;
+    uint32_t* tile_ends;
+    uint32_t tile_count;
+    uint32_t tile_capacity;
+    // The scratch's length before the columns and after them: a reading that leaves the scratch as long as it found it
+    // lets who started the parse pop them (check_input_prepass_release).
+    uint64_t mark;
+    uint64_t end;
+    // Whether the unit's last tokens were given, so the columns are the unit's; and whether a reading took them, whose
+    // walk then writes its marks in them.
+    bool complete;
+    bool taken;
+};
+
+static bool check_input_prepass_begin(void* context, const Parser* parser)
+{
+    CheckInputPrepass* const prepass = context;
+    const uint64_t slots = (uint64_t)parser->tokens.count + 1;
+    prepass->parser = parser;
+    prepass->count = parser->tokens.count;
+    prepass->name_count = check_input_count_names(prepass->pp, prepass->names, prepass->groups);
+    prepass->mark = prepass->scratch->length;
+    prepass->syntax = arena_push_array(prepass->scratch, slots, sizeof(uint8_t), 64);
+    prepass->visits = prepass->syntax != NULL ? arena_push_array(prepass->scratch, slots + BUSTER_CHECK_VISITS_PADDING, sizeof(uint8_t), 64) : NULL;
+    prepass->prefixes = prepass->visits != NULL ? arena_push_array(prepass->scratch, slots, sizeof(uint8_t), 64) : NULL;
+    uint32_t* const traversal = prepass->traversal && prepass->prefixes != NULL ? arena_push_array(prepass->scratch, 6 * slots, sizeof(uint32_t), 64) : NULL;
+    prepass->postorder = traversal;
+    prepass->positions = traversal != NULL ? traversal + slots : NULL;
+    prepass->ends = traversal != NULL ? traversal + 2 * slots : NULL;
+    prepass->first_children = traversal != NULL ? traversal + 3 * slots : NULL;
+    prepass->next_siblings = traversal != NULL ? traversal + 4 * slots : NULL;
+    prepass->sizes = traversal != NULL ? traversal + 5 * slots : NULL;
+    prepass->tile_capacity = prepass->tile_tokens != 0 ? prepass->count / prepass->tile_tokens + 2 : 2;
+    prepass->tile_ends = prepass->prefixes != NULL ? arena_push_array(prepass->scratch, prepass->tile_capacity, sizeof(uint32_t), 64) : NULL;
+    prepass->tile_count = 0;
+    prepass->end = prepass->scratch->length;
+    prepass->underived = false;
+    prepass->state = (CheckInputCountState){ 0 };
+    prepass->counted = 0;
+    prepass->prefixed = 0;
+    prepass->complete = false;
+    prepass->taken = false;
+    return prepass->tile_ends != NULL && (!prepass->traversal || traversal != NULL);
+}
