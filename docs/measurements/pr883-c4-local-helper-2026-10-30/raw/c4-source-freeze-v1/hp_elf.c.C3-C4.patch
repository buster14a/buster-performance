+static bool hp_null_section_profile(const HpElf *elf, const unsigned char *row)
+{
+    unsigned char empty[64] = {0};
+    bool supported = memcmp(row, empty, sizeof(empty)) == 0;
+    if (!supported)
+    {
+        // Pinned Wild 0.10 EXEC output retains these two layout-derived fields.
+        // All other null-row fields stay zero; extended numbering stays refused.
+        supported = elf->elf_type == ET_EXEC && hp_u32(row) == 0 && hp_u32(row + 4) == SHT_NULL && hp_u64(row + 8) == SHF_ALLOC && hp_u64(row + 16) == UINT64_C(0x400000) && hp_u64(row + 24) == 0 && hp_u64(row + 32) == 0 && hp_u32(row + 40) == 0 && hp_u32(row + 44) == 0 && hp_u64(row + 48) == 0 && hp_u64(row + 56) == 0;
+    }
+    return supported;
+}
