+const HpSection *hp_elf_section_named(const HpElf *elf, const char *name)
+{
+    const HpSection *result = NULL;
+    for (size_t i = 0; i < elf->section_count; i += 1)
+    {
+        if (hp_string_is(elf->sections[i].name, name))
+        {
+            result = &elf->sections[i];
+        }
+    }
+    return result;
