+    BUSTER_MALFORMED_SHOFF_OVERFLOW,
+    BUSTER_MALFORMED_SHSIZE_OVERFLOW,
+    BUSTER_MALFORMED_SECTION_OFFSET_OVERFLOW,
+    BUSTER_MALFORMED_SECTION_SIZE_OVERFLOW,
+    BUSTER_MALFORMED_SECTION_PAYLOAD_OVERLAP,
+    BUSTER_MALFORMED_SECTION_HEADER_OVERLAP,
+    BUSTER_MALFORMED_ALIGNMENT_NONPOWER,
+    BUSTER_MALFORMED_SECTION_MISALIGNED,
+    BUSTER_MALFORMED_SHNUM_EXTENDED,
+    BUSTER_MALFORMED_SHSTR_EXTENDED,
+    BUSTER_MALFORMED_SHSTR_RANGE,
+    BUSTER_MALFORMED_NULL_SECTION,
+    BUSTER_MALFORMED_MACHINE,
+    BUSTER_MALFORMED_CLASS,
+    BUSTER_MALFORMED_ENDIAN,
+    BUSTER_MALFORMED_VERSION,
+    BUSTER_MALFORMED_IDENT_VERSION,
+    BUSTER_MALFORMED_HEADER_SIZE,
+    BUSTER_MALFORMED_SECTION_ENTRY_SIZE,
+    BUSTER_MALFORMED_SECTION_NAME_OFFSET,
+    BUSTER_MALFORMED_SECTION_NAME_UNTERMINATED,
+    BUSTER_MALFORMED_DUPLICATE_SECTION_NAME,
+    BUSTER_MALFORMED_SECTION_LINK,
+    BUSTER_MALFORMED_SYMTAB_LINK,
+    BUSTER_MALFORMED_SYMTAB_ENTRY_SIZE,
+    BUSTER_MALFORMED_SYMTAB_PARTIAL_ENTRY,
+    BUSTER_MALFORMED_SYMBOL_NAME_OFFSET,
