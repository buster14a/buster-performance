+    BUSTER_LINK_NOP,
+    BUSTER_LINK_FINAL_MISSING,
+    BUSTER_LINK_FINAL_AMBIGUOUS,
+    BUSTER_LINK_FINAL_WRONG_SIZE,
+    BUSTER_LINK_NONUNIFORM_DELTA,
+    BUSTER_LINK_RANGE_SHORT,
