+static bool method_normalize(HpMethod* method, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    char raw_path[BUSTER_HP_PATH_CAPACITY] = {0}, canonical_path[BUSTER_HP_PATH_CAPACITY] = {0}, receipt_path[BUSTER_HP_PATH_CAPACITY] = {0};
+    char raw_sha[65] = {0}, canonical_sha[65] = {0}, object_sha[65] = {0};
+    HpBuffer raw = {0}, object = {0}, canonical = {0};
+    HpNormalizationProof proof = {0};
+    const char* object_path = method->objects.values[method->plan.checker_index];
+    bool result = method_path(raw_path, method, "checker.raw.s", error) && method_path(canonical_path, method, "checker.s", error) &&
+        method_path(receipt_path, method, "normalization.json", error) && hp_sha256_file(raw_path, raw_sha, error) && hp_sha256_file(object_path, object_sha, error) &&
+        hp_read_file(raw_path, BUSTER_HP_FILE_LIMIT, &raw, error) && hp_read_file(object_path, BUSTER_HP_FILE_LIMIT, &object, error) &&
+        hp_normalize_checker((HpBytes){raw.data, raw.size}, (HpBytes){object.data, object.size}, method->manifest_sha, method->normal_sha, &canonical, &proof, error) &&
+        method_file_buffer_equal(raw_path, (HpBytes){raw.data, raw.size}, error) && method_hash(raw_path, raw_sha, error) &&
+        method_file_buffer_equal(object_path, (HpBytes){object.data, object.size}, error) && method_hash(object_path, object_sha, error) &&
+        hp_write_file(canonical_path, (HpBytes){canonical.data, canonical.size}, error) &&
+        method_file_buffer_equal(canonical_path, (HpBytes){canonical.data, canonical.size}, error) && hp_sha256_file(canonical_path, canonical_sha, error);
