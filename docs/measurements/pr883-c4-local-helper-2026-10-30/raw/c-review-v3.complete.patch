+static void receipt_path(ReceiptSuite *suite, char path[BUSTER_HP_PATH_CAPACITY], const char *leaf)
+{
+    char error[BUSTER_HP_ERROR_CAPACITY] = {0};
+    bool valid = hp_join_path(path, suite->root, leaf, error);
+    assert(valid);
+    return;
+}
