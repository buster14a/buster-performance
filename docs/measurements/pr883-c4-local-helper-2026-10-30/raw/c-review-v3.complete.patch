+static void driver_append_quote(DriverBuffer *buffer, const char *text)
+{
+    driver_append_text(buffer, "\"");
+    for (size_t i = 0; text[i] != 0; i += 1)
+    {
+        if (text[i] == '"' || text[i] == '\\')
+        {
+            driver_append_text(buffer, "\\");
+        }
+        driver_append(buffer, text + i, 1);
+    }
+    driver_append_text(buffer, "\" ");
+    return;
+}
