+    FILE* output = descriptor >= 0 ? fdopen(descriptor, "w") : NULL;
+    if (result && output == NULL)
+    {
+        result = hp_error(error, "cannot exclusively create normalization receipt");
+    }
+    if (descriptor >= 0 && output == NULL)
+    {
+        close(descriptor);
+    }
+    if (result)
+    {
+        result = hp_normalization_write(output, &proof, raw_sha, canonical_sha, object_sha, error);
+    }
+    if (output != NULL)
+    {
+        bool flushed = fflush(output) == 0 && ferror(output) == 0;
+        bool closed = fclose(output) == 0;
+        result = flushed && closed && result;
+    }
+    if (!result && error[0] == '\0')
+    {
+        hp_error(error, "normalization or its exclusive receipt failed");
+    }
+    hp_buffer_free(&raw);
+    hp_buffer_free(&object);
+    hp_buffer_free(&canonical);
+    return result;
+}
