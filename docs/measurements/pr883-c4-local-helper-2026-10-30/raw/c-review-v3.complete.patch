+    return;
+}
+
+static Elf64_Rela control_relocation(const ControlFixture *fixture, ControlSection id, size_t index)
+{
+    Elf64_Shdr section = control_section(fixture, id);
+    Elf64_Rela relocation;
+    assert((index + 1) * sizeof(relocation) <= section.sh_size);
+    memcpy(&relocation, fixture->bytes.data + section.sh_offset + index * sizeof(relocation), sizeof(relocation));
+    return relocation;
+}
+
+static void control_set_relocation(ControlFixture *fixture, ControlSection id, size_t index, Elf64_Rela relocation)
+{
+    Elf64_Shdr section = control_section(fixture, id);
+    assert((index + 1) * sizeof(relocation) <= section.sh_size);
+    memcpy(fixture->bytes.data + section.sh_offset + index * sizeof(relocation), &relocation, sizeof(relocation));
+    return;
+}
+
+static Elf64_Rela control_make_relocation(const ControlFixture *fixture, uint64_t offset, unsigned type, ControlSymbol symbol, int64_t addend)
+{
