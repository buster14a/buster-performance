+static void plan_rejected(PlanSuite *suite, const char *name, bool accepted, const HpPlanArguments *output, const char *error)
+{
+    plan_record(suite, name, !accepted && plan_zero(output, sizeof(*output)) && error[0] != 0, error);
+    return;
+}
