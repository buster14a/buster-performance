+} ControlMalformed;
+
+static void control_malformed(ControlFixture *fixture, ControlMalformed kind)
+{
+    Elf64_Ehdr header = control_header(fixture);
+    Elf64_Shdr hot = control_section(fixture, BUSTER_SECTION_HOT);
+    Elf64_Shdr data = control_section(fixture, BUSTER_SECTION_DATA);
+    Elf64_Shdr symbols = control_section(fixture, BUSTER_SECTION_SYMTAB);
+    Elf64_Shdr strings = control_section(fixture, BUSTER_SECTION_STRTAB);
+    Elf64_Shdr names = control_section(fixture, BUSTER_SECTION_SHSTRTAB);
+    Elf64_Shdr rela = control_section(fixture, BUSTER_SECTION_RELA_HOT);
+    Elf64_Sym foo = control_symbol(fixture, BUSTER_SYMBOL_FOO);
+    Elf64_Rela relocation = control_relocation(fixture, BUSTER_SECTION_RELA_HOT, 0);
+    switch (kind)
+    {
+        case BUSTER_MALFORMED_SHORT_HEADER:
+        {
+            fixture->bytes.size = 63;
+        } break;
+        case BUSTER_MALFORMED_SHOFF_OVERFLOW:
+        {
+            header.e_shoff = UINT64_MAX - 31;
+        } break;
+        case BUSTER_MALFORMED_SHSIZE_OVERFLOW:
+        {
+            header.e_shnum = UINT16_MAX;
+        } break;
+        case BUSTER_MALFORMED_SECTION_OFFSET_OVERFLOW:
+        {
+            data.sh_offset = UINT64_MAX - 7;
+        } break;
+        case BUSTER_MALFORMED_SECTION_SIZE_OVERFLOW:
+        {
+            data.sh_size = UINT64_MAX;
+        } break;
+        case BUSTER_MALFORMED_SECTION_PAYLOAD_OVERLAP:
+        {
+            data.sh_offset = hot.sh_offset;
+        } break;
+        case BUSTER_MALFORMED_SECTION_HEADER_OVERLAP:
+        {
+            data.sh_offset = fixture->section_headers;
+        } break;
+        case BUSTER_MALFORMED_ALIGNMENT_NONPOWER:
+        {
+            data.sh_addralign = 3;
+        } break;
+        case BUSTER_MALFORMED_SECTION_MISALIGNED:
+        {
+            hot.sh_offset += 1;
+        } break;
+        case BUSTER_MALFORMED_SHNUM_EXTENDED:
+        {
+            header.e_shnum = 0;
+        } break;
+        case BUSTER_MALFORMED_SHSTR_EXTENDED:
+        {
+            header.e_shstrndx = SHN_XINDEX;
+        } break;
+        case BUSTER_MALFORMED_SHSTR_RANGE:
+        {
+            header.e_shstrndx = header.e_shnum;
+        } break;
+        case BUSTER_MALFORMED_NULL_SECTION:
+        {
+            fixture->bytes.data[fixture->section_headers + 32] = 1;
+        } break;
+        case BUSTER_MALFORMED_MACHINE:
+        {
+            header.e_machine = EM_AARCH64;
+        } break;
+        case BUSTER_MALFORMED_CLASS:
+        {
+            header.e_ident[EI_CLASS] = ELFCLASS32;
+        } break;
+        case BUSTER_MALFORMED_ENDIAN:
+        {
+            header.e_ident[EI_DATA] = ELFDATA2MSB;
+        } break;
+        case BUSTER_MALFORMED_VERSION:
+        {
+            header.e_version = EV_NONE;
+        } break;
+        case BUSTER_MALFORMED_IDENT_VERSION:
+        {
+            header.e_ident[EI_VERSION] = EV_NONE;
+        } break;
+        case BUSTER_MALFORMED_HEADER_SIZE:
+        {
+            header.e_ehsize = 63;
+        } break;
+        case BUSTER_MALFORMED_SECTION_ENTRY_SIZE:
+        {
+            header.e_shentsize = 63;
+        } break;
+        case BUSTER_MALFORMED_SECTION_NAME_OFFSET:
+        {
+            data.sh_name = UINT32_MAX;
+        } break;
+        case BUSTER_MALFORMED_SECTION_NAME_UNTERMINATED:
+        {
+            memset(fixture->bytes.data + names.sh_offset, 'N', (size_t)names.sh_size);
+        } break;
+        case BUSTER_MALFORMED_DUPLICATE_SECTION_NAME:
+        {
+            data.sh_name = hot.sh_name;
+        } break;
+        case BUSTER_MALFORMED_SECTION_LINK:
+        {
+            data.sh_link = (Elf64_Word)fixture->section_count;
+        } break;
+        case BUSTER_MALFORMED_SYMTAB_LINK:
+        {
+            symbols.sh_link = (Elf64_Word)fixture->section_index[BUSTER_SECTION_DATA];
+        } break;
+        case BUSTER_MALFORMED_SYMTAB_ENTRY_SIZE:
+        {
+            symbols.sh_entsize = 23;
+        } break;
+        case BUSTER_MALFORMED_SYMTAB_PARTIAL_ENTRY:
+        {
+            symbols.sh_size -= 1;
+        } break;
+        case BUSTER_MALFORMED_SYMBOL_NAME_OFFSET:
+        {
+            foo.st_name = UINT32_MAX;
+        } break;
+        case BUSTER_MALFORMED_SYMBOL_NAME_UNTERMINATED:
+        {
+            memset(fixture->bytes.data + strings.sh_offset, 'S', (size_t)strings.sh_size);
+        } break;
+        case BUSTER_MALFORMED_SYMBOL_EXTENDED_SECTION:
+        {
+            foo.st_shndx = SHN_XINDEX;
+        } break;
+        case BUSTER_MALFORMED_SYMBOL_BAD_SECTION:
+        {
+            foo.st_shndx = (Elf64_Section)fixture->section_count;
+        } break;
+        case BUSTER_MALFORMED_RELA_LINK:
+        {
+            rela.sh_link = (Elf64_Word)fixture->section_index[BUSTER_SECTION_DATA];
+        } break;
+        case BUSTER_MALFORMED_RELA_INFO:
+        {
+            rela.sh_info = (Elf64_Word)fixture->section_count;
+        } break;
+        case BUSTER_MALFORMED_RELA_INFO_ZERO:
+        {
+            rela.sh_info = 0;
+        } break;
+        case BUSTER_MALFORMED_RELA_SYMBOL:
+        {
+            relocation.r_info = ELF64_R_INFO(fixture->symbol_count, R_X86_64_PC32);
+        } break;
+        case BUSTER_MALFORMED_RELA_ENTRY_SIZE:
+        {
+            rela.sh_entsize = 23;
+        } break;
+        case BUSTER_MALFORMED_RELA_PARTIAL_ENTRY:
+        {
+            rela.sh_size -= 1;
+        } break;
+        case BUSTER_MALFORMED_PROGRAM_OFFSET:
+        {
+            header.e_phnum = 1;
+            header.e_phentsize = sizeof(Elf64_Phdr);
+            header.e_phoff = UINT64_MAX - 7;
+        } break;
+        case BUSTER_MALFORMED_PROGRAM_ENTRY_SIZE:
+        {
+            header.e_phnum = 1;
+            header.e_phentsize = sizeof(Elf64_Phdr) - 1;
+            header.e_phoff = 64;
+        } break;
+        case BUSTER_MALFORMED_PROGRAM_OVERLAP:
+        {
+            header.e_phnum = 1;
+            header.e_phentsize = sizeof(Elf64_Phdr);
+            header.e_phoff = hot.sh_offset;
+        } break;
+    }
+    control_set_header(fixture, header);
+    control_set_section(fixture, BUSTER_SECTION_HOT, hot);
+    control_set_section(fixture, BUSTER_SECTION_DATA, data);
+    control_set_section(fixture, BUSTER_SECTION_SYMTAB, symbols);
+    control_set_section(fixture, BUSTER_SECTION_RELA_HOT, rela);
+    // These writes use original fixture offsets even when section metadata is
+    // intentionally corrupted. No malformed reader controls write out of bounds.
+    if (kind == BUSTER_MALFORMED_SYMBOL_NAME_OFFSET || kind == BUSTER_MALFORMED_SYMBOL_EXTENDED_SECTION || kind == BUSTER_MALFORMED_SYMBOL_BAD_SECTION)
+    {
+        control_set_symbol(fixture, BUSTER_SYMBOL_FOO, foo);
+    }
+    if (kind == BUSTER_MALFORMED_RELA_SYMBOL)
+    {
+        control_set_relocation(fixture, BUSTER_SECTION_RELA_HOT, 0, relocation);
+    }
+    return;
+}
