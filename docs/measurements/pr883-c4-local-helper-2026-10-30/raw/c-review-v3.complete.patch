+static void control_json_string(FILE *file, const char *value)
+{
+    fputc('"', file);
+    for (size_t i = 0; value[i] != 0; i += 1)
+    {
+        unsigned char byte = (unsigned char)value[i];
+        if (byte == '"' || byte == '\\')
+        {
+            fputc('\\', file);
+            fputc(byte, file);
+        }
+        else if (byte < 0x20 || byte >= 0x7f)
+        {
+            fprintf(file, "\\u%04x", byte);
+        }
+        else
+        {
+            fputc(byte, file);
+        }
+    }
+    fputc('"', file);
+    return;
+}
+
+static bool control_write_results(const ControlSuite *suite, const char *path)
+{
+    FILE *file = fopen(path, "wx");
+    bool ok = file != NULL;
+    if (ok)
+    {
+        fprintf(file, "{\n  \"kind\": \"fresh C byte-constructed ELF controls\",\n  \"cases\": %zu,\n  \"failures\": %zu,\n  \"results\": [\n", suite->count, suite->failures);
+        for (size_t i = 0; i < suite->count; i += 1)
+        {
+            const ControlResult *result = &suite->results[i];
+            fprintf(file, "    {\"name\": ");
+            control_json_string(file, result->name);
+            fprintf(file, ", \"expected_accept\": %s, \"accepted\": %s, \"passed\": %s, \"error\": ", result->expected ? "true" : "false", result->accepted ? "true" : "false", result->passed ? "true" : "false");
+            control_json_string(file, result->error);
+            fprintf(file, "}%s\n", i + 1 < suite->count ? "," : "");
+        }
+        fprintf(file, "  ]\n}\n");
+        ok = ferror(file) == 0;
+        ok = fclose(file) == 0 && ok;
+    }
+    return ok;
+}
+
+int main(int argc, char **argv)
+{
+    const char *output = NULL;
+    bool valid = argc == 1 || (argc == 3 && strcmp(argv[1], "--output") == 0);
+    int status = 2;
+    if (valid)
+    {
+        output = argc == 3 ? argv[2] : NULL;
+        const uint16_t endian = 1;
+        valid = *(const unsigned char *)&endian == 1;
+        if (valid)
+        {
+            ControlSuite suite = {0};
+            control_frozen_cases(&suite);
+            control_extra_pairs(&suite);
+            control_reader_faults(&suite);
+            control_proof_contracts(&suite);
+            control_reader_symbol_mapping(&suite);
+            printf("Synthetic C ELF controls: %zu cases, %zu failures; no compiler/assembler or target images executed.\n", suite.count, suite.failures);
+            bool wrote = output == NULL || control_write_results(&suite, output);
+            if (!wrote)
+            {
+                perror("write fresh results file");
+            }
+            status = suite.failures != 0 || !wrote ? 1 : 0;
+        }
+    }
+    if (!valid)
+    {
+        fprintf(stderr, "usage: elf-controls [--output NEW_RESULTS_FILE]; host must be little endian\n");
+    }
+    return status;
+}
