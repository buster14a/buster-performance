+} LinkedFault;
+
+typedef struct LinkedBuffer LinkedBuffer;
+struct LinkedBuffer
+{
+    unsigned char data[BUSTER_LINK_CAPACITY];
+    size_t size;
+};
+
+typedef struct LinkedOptions LinkedOptions;
+struct LinkedOptions
+{
+    uint64_t shift;
+    LinkedFault fault;
+    bool extra;
+    bool zero;
+    bool zero_at_end;
+    bool original;
+};
+
+typedef struct LinkedSymbol LinkedSymbol;
+struct LinkedSymbol
+{
+    const char *name;
+    uint16_t section;
+    uint64_t value;
+    uint64_t size;
+    unsigned char type;
+    unsigned char bind;
+    unsigned char other;
+};
+
+typedef struct LinkedCase LinkedCase;
+struct LinkedCase
+{
+    const char *name;
