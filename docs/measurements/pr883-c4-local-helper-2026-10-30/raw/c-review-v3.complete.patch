+static bool normalize_digest(const char *value)
+{
+    bool valid = value != NULL;
+    for (size_t index = 0; valid && index < 64; index += 1)
+    {
+        valid = (value[index] >= '0' && value[index] <= '9') || (value[index] >= 'a' && value[index] <= 'f');
+    }
+    valid = valid && value[64] == 0;
+    return valid;
+}
