+
+static void control_append(ControlBuffer *buffer, const void *data, size_t size)
+{
+    assert(size <= sizeof(buffer->data) - buffer->size);
+    if (size != 0)
+    {
+        memcpy(buffer->data + buffer->size, data, size);
+    }
+    buffer->size += size;
+    return;
+}
+
+static void control_align(ControlBuffer *buffer, size_t align)
+{
+    assert(align != 0 && (align & (align - 1)) == 0);
+    size_t padding = (align - buffer->size % align) % align;
+    assert(padding <= sizeof(buffer->data) - buffer->size);
+    memset(buffer->data + buffer->size, 0, padding);
+    buffer->size += padding;
+    return;
+}
+
+static uint32_t control_append_string(ControlBuffer *strings, const char *value)
+{
+    uint32_t offset = (uint32_t)strings->size;
+    control_append(strings, value, strlen(value) + 1);
+    return offset;
+}
+
+static Elf64_Ehdr control_header(const ControlFixture *fixture)
+{
+    Elf64_Ehdr header;
+    assert(fixture->bytes.size >= sizeof(header));
+    memcpy(&header, fixture->bytes.data, sizeof(header));
+    return header;
+}
+
+static void control_set_header(ControlFixture *fixture, Elf64_Ehdr header)
+{
+    memcpy(fixture->bytes.data, &header, sizeof(header));
+    return;
+}
+
+static Elf64_Shdr control_section(const ControlFixture *fixture, ControlSection id)
+{
+    Elf64_Shdr section;
+    size_t index = fixture->section_index[id];
+    assert(index != SIZE_MAX && index < fixture->section_count);
+    memcpy(&section, fixture->bytes.data + fixture->section_headers + index * sizeof(section), sizeof(section));
+    return section;
+}
+
+static void control_set_section(ControlFixture *fixture, ControlSection id, Elf64_Shdr section)
+{
+    size_t index = fixture->section_index[id];
+    assert(index != SIZE_MAX && index < fixture->section_count);
+    memcpy(fixture->bytes.data + fixture->section_headers + index * sizeof(section), &section, sizeof(section));
+    return;
+}
+
+static Elf64_Sym control_symbol(const ControlFixture *fixture, ControlSymbol id)
+{
+    Elf64_Shdr section = control_section(fixture, BUSTER_SECTION_SYMTAB);
+    Elf64_Sym symbol;
+    size_t index = fixture->symbol_index[id];
+    assert(index != SIZE_MAX && index < fixture->symbol_count);
+    memcpy(&symbol, fixture->bytes.data + section.sh_offset + index * sizeof(symbol), sizeof(symbol));
+    return symbol;
+}
+
+static void control_set_symbol(ControlFixture *fixture, ControlSymbol id, Elf64_Sym symbol)
+{
+    Elf64_Shdr section = control_section(fixture, BUSTER_SECTION_SYMTAB);
+    size_t index = fixture->symbol_index[id];
