+static void control_record(ControlSuite *suite, const char *name, bool expected, bool accepted, const char *error)
+{
+    assert(suite->count < BUSTER_ARRAY_COUNT(suite->results));
+    ControlResult *result = &suite->results[suite->count++];
+    result->name = name;
+    result->expected = expected;
+    result->accepted = accepted;
+    result->passed = expected == accepted;
+    snprintf(result->error, sizeof(result->error), "%s", error);
+    suite->failures += result->passed ? 0 : 1;
+    printf("%s %s%s%s\n", result->passed ? "PASS" : "FAIL", name, !result->passed && error[0] != 0 ? ": " : "", !result->passed ? error : "");
+    return;
+}
+
+static void control_run(ControlSuite *suite, const char *name, const ControlFixture *base, const ControlFixture *variant, uint64_t shift, bool expected, ControlMode mode)
+{
+    HpElf left = {0};
+    HpElf right = {0};
+    HpObjectProof proof = {0};
+    char error[BUSTER_HP_ERROR_CAPACITY] = {0};
+    HpBytes left_bytes =
+    {
+        base->bytes.data,
+        base->bytes.size
+    };
+    HpBytes right_bytes =
+    {
+        variant->bytes.data,
+        variant->bytes.size
+    };
+    bool accepted = hp_elf_read(left_bytes, &left, error);
+    if (accepted && mode == BUSTER_CONTROL_COMPARE)
+    {
+        accepted = hp_elf_read(right_bytes, &right, error);
+        if (accepted)
+        {
+            accepted = hp_elf_compare_objects(&left, &right, BUSTER_CONTROL_HOT, shift, &proof, error);
+        }
+    }
+    control_record(suite, name, expected, accepted, error);
+    hp_object_proof_free(&proof);
+    hp_elf_free(&left);
+    hp_elf_free(&right);
+    return;
+}
+
+static void control_pair(ControlSuite *suite, const char *name, ControlOptions base_options, ControlOptions variant_options, bool expected)
+{
+    ControlFixture base;
+    ControlFixture variant;
+    control_fixture(&base, base_options);
+    control_fixture(&variant, variant_options);
+    control_run(suite, name, &base, &variant, variant_options.shift, expected, BUSTER_CONTROL_COMPARE);
+    return;
+}
