+        hot_bytes.data[options.shift] = 'X';
+    }
+    if (options.fault == BUSTER_FAULT_PREFIX_BYTE && options.shift != 0)
+    {
+        hot_bytes.data[0] = 'X';
+    }
+    unsigned char data_bytes[16];
+    memset(data_bytes, 'D', sizeof(data_bytes));
+    if (options.fault == BUSTER_FAULT_DATA_BYTE)
+    {
+        data_bytes[0] = 'X';
+    }
+    unsigned char addrsig[12] = {0};
+    size_t addrsig_size = 1;
+    addrsig[0] = (unsigned char)fixture->symbol_index[options.fault == BUSTER_FAULT_ADDRSIG_TARGET ? BUSTER_SYMBOL_EXTERNAL : BUSTER_SYMBOL_FOO];
+    if (options.multi_addrsig)
+    {
+        addrsig_size = 3;
+        addrsig[0] = (unsigned char)fixture->symbol_index[options.reverse_addrsig ? BUSTER_SYMBOL_EXTERNAL : BUSTER_SYMBOL_FOO];
+        addrsig[1] = (unsigned char)fixture->symbol_index[options.reverse_addrsig ? BUSTER_SYMBOL_FOO : BUSTER_SYMBOL_EXTERNAL];
+        addrsig[2] = (unsigned char)fixture->symbol_index[BUSTER_SYMBOL_FOO];
+    }
+    if (options.fault == BUSTER_FAULT_ADDRSIG_DUPLICATE_LOSS)
+    {
+        addrsig_size = 2;
+    }
+    if (options.fault == BUSTER_FAULT_ADDRSIG_TRUNCATED)
+    {
+        addrsig[0] = 0x80;
+    }
+    if (options.fault == BUSTER_FAULT_ADDRSIG_OVERFLOW)
+    {
+        memset(addrsig, 0xff, 10);
+        addrsig[10] = 1;
+        addrsig_size = 11;
+    }
+    if (options.fault == BUSTER_FAULT_ADDRSIG_BAD_SYMBOL)
+    {
+        addrsig[0] = 127;
+    }
+
+    Elf64_Shdr sections[BUSTER_CONTROL_SECTION_COUNT] = {0};
+    memset(fixture->bytes.data, 0, sizeof(Elf64_Ehdr));
+    fixture->bytes.size = sizeof(Elf64_Ehdr);
+    for (size_t i = 1; i < order_count; i += 1)
+    {
+        ControlSection id = order[i];
+        Elf64_Shdr *section = &sections[i];
+        const unsigned char *payload = NULL;
+        size_t payload_size = 0;
+        section->sh_name = name_offsets[id];
+        section->sh_type = SHT_PROGBITS;
+        section->sh_addralign = 1;
+        if (id == BUSTER_SECTION_HOT)
+        {
+            section->sh_flags = SHF_ALLOC | SHF_EXECINSTR;
+            section->sh_addralign = options.fault == BUSTER_FAULT_ALIGNMENT ? 2048 : 4096;
+            payload = hot_bytes.data;
+            payload_size = hot_bytes.size;
+        }
+        else if (id == BUSTER_SECTION_DATA || id == BUSTER_SECTION_BSS)
+        {
+            section->sh_flags = SHF_ALLOC | SHF_WRITE;
+            section->sh_addralign = 8;
+            payload = data_bytes;
+            payload_size = sizeof(data_bytes);
+            if (id == BUSTER_SECTION_BSS)
+            {
+                section->sh_type = SHT_NOBITS;
+                payload_size = options.fault == BUSTER_FAULT_BSS_SIZE ? 9 : 8;
+            }
+            else if (options.fault == BUSTER_FAULT_GROUP)
+            {
+                section->sh_type = SHT_GROUP;
+                section->sh_flags = SHF_GROUP;
+            }
+        }
+        else if (id == BUSTER_SECTION_SYMTAB)
+        {
+            section->sh_type = SHT_SYMTAB;
+            section->sh_flags = options.fault == BUSTER_FAULT_ALLOC_SYMTAB ? SHF_ALLOC : 0;
+            section->sh_link = (Elf64_Word)fixture->section_index[BUSTER_SECTION_STRTAB];
+            section->sh_info = (Elf64_Word)(symbol_order_count - 2);
+            section->sh_addralign = 8;
+            section->sh_entsize = sizeof(Elf64_Sym);
+            payload = symbol_bytes.data;
+            payload_size = symbol_bytes.size;
+        }
+        else if (id == BUSTER_SECTION_STRTAB || id == BUSTER_SECTION_SHSTRTAB)
+        {
+            section->sh_type = SHT_STRTAB;
+            section->sh_flags = id == BUSTER_SECTION_STRTAB && options.fault == BUSTER_FAULT_ALLOC_STRTAB ? SHF_ALLOC : 0;
+            payload = id == BUSTER_SECTION_STRTAB ? strings.data : section_names.data;
+            payload_size = id == BUSTER_SECTION_STRTAB ? strings.size : section_names.size;
+        }
+        else if (id == BUSTER_SECTION_RELA_HOT || id == BUSTER_SECTION_RELA_DATA)
+        {
+            section->sh_type = id == BUSTER_SECTION_RELA_HOT && options.fault == BUSTER_FAULT_REL ? SHT_REL : SHT_RELA;
+            section->sh_flags = SHF_INFO_LINK | (options.fault == BUSTER_FAULT_ALLOC_RELA ? SHF_ALLOC : 0);
+            section->sh_link = (Elf64_Word)fixture->section_index[BUSTER_SECTION_SYMTAB];
+            section->sh_info = (Elf64_Word)fixture->section_index[id == BUSTER_SECTION_RELA_HOT ? BUSTER_SECTION_HOT : BUSTER_SECTION_DATA];
+            section->sh_addralign = 8;
+            section->sh_entsize = sizeof(Elf64_Rela);
+            payload = id == BUSTER_SECTION_RELA_HOT ? hot_relocations.data : data_relocations.data;
+            payload_size = id == BUSTER_SECTION_RELA_HOT ? hot_relocations.size : data_relocations.size;
+        }
+        else if (id == BUSTER_SECTION_ADDRSIG)
+        {
+            section->sh_type = BUSTER_HP_ADDRSIG;
+            section->sh_flags = SHF_EXCLUDE;
+            section->sh_link = (Elf64_Word)fixture->section_index[BUSTER_SECTION_SYMTAB];
+            payload = addrsig;
+            payload_size = addrsig_size;
+        }
+        else if (id == BUSTER_SECTION_COMMENT)
+        {
+            section->sh_flags = SHF_MERGE | SHF_STRINGS | (options.fault == BUSTER_FAULT_ALLOC_COMMENT ? SHF_ALLOC : 0);
+            section->sh_entsize = 1;
+            section->sh_link = options.fault == BUSTER_FAULT_UNKNOWN_LINKED_METADATA ? (Elf64_Word)fixture->section_index[BUSTER_SECTION_SYMTAB] : 0;
+            payload = (const unsigned char *)options.comment;
+            payload_size = strlen(options.comment) + 1;
+        }
+        else if (id == BUSTER_SECTION_STACK)
+        {
+            section->sh_flags = options.fault == BUSTER_FAULT_EXEC_STACK ? SHF_EXECINSTR : 0;
+        }
+        control_align(&fixture->bytes, section->sh_addralign);
+        section->sh_offset = fixture->bytes.size;
+        section->sh_size = payload_size;
+        if (section->sh_type != SHT_NOBITS)
+        {
+            control_append(&fixture->bytes, payload, payload_size);
+        }
+    }
+    control_align(&fixture->bytes, 8);
+    fixture->section_headers = fixture->bytes.size;
+    control_append(&fixture->bytes, sections, order_count * sizeof(sections[0]));
+    Elf64_Ehdr header = {0};
+    memcpy(header.e_ident, ELFMAG, SELFMAG);
+    header.e_ident[EI_CLASS] = ELFCLASS64;
+    header.e_ident[EI_DATA] = ELFDATA2LSB;
+    header.e_ident[EI_VERSION] = EV_CURRENT;
+    header.e_type = ET_REL;
+    header.e_machine = EM_X86_64;
+    header.e_version = EV_CURRENT;
+    header.e_shoff = fixture->section_headers;
+    header.e_ehsize = sizeof(header);
+    header.e_shentsize = sizeof(Elf64_Shdr);
+    header.e_shnum = (Elf64_Half)order_count;
+    header.e_shstrndx = (Elf64_Half)fixture->section_index[BUSTER_SECTION_SHSTRTAB];
+    control_set_header(fixture, header);
+    if (options.fault == BUSTER_FAULT_BAD_MAGIC)
+    {
+        fixture->bytes.data[0] = 0;
+    }
+    if (options.fault == BUSTER_FAULT_TRUNCATE)
+    {
+        fixture->bytes.size -= 1;
+    }
+    return;
+}
