+// Values emitted alongside the compacted kinds for eight records. The first slot of each carried row
+// gets its record's payload. A PTR_ADD defaults to one. The remaining slots start at zero before the
+// specific stride, constant, store and control fixups. Only rows with a carried value load that column.
+static inline __attribute__((always_inline)) void node_rows_write_values(uint64_t* out, const uint64_t* records,
+                                                                         __m512i kinds, uint64_t entries, uint32_t count, __mmask8 carried)
+{
+    const uint64_t first_slots = _pdep_u64(carried, UINT64_C(0x0101010101010101));
+    uint64_t payload_slots = _pext_u64(first_slots, entries);
+    uint64_t ones = _pext_u64(_mm512_cmpeq_epi8_mask(kinds, _mm512_set1_epi8(BUSTER_TYPED_PTR_ADD)), entries);
+    __m512i payloads = _mm512_maskz_compress_epi64(carried, _mm512_maskz_loadu_epi64(carried, records));
+    for (uint32_t at = 0; at < count; at += 8)
+    {
+        const __mmask8 takes = (__mmask8)payload_slots;
+        const __m512i base = _mm512_maskz_mov_epi64((__mmask8)ones, _mm512_set1_epi64(1));
+        _mm512_storeu_si512(out + at, _mm512_mask_expand_epi64(base, takes, payloads));
+        const uint32_t used = (uint32_t)_mm_popcnt_u32(takes);
+        payloads = _mm512_maskz_compress_epi64((__mmask8)(0xffu << used), payloads);
+        payload_slots >>= 8;
+        ones >>= 8;
+    }
+}
