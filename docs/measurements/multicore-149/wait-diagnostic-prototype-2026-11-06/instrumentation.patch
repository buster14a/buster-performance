+// UINT64_MAX denotes a failed clock read; preserve errno because these observations are not compiler behavior.
+static uint64_t lane_diagnostic_now(void)
+{
+    struct timespec time;
+    const int previous = errno;
+    const bool ok = clock_gettime(CLOCK_MONOTONIC_RAW, &time) == 0 && time.tv_sec >= 0 && time.tv_nsec >= 0 && time.tv_nsec < 1000000000;
+    const uint64_t value = ok ? (uint64_t)time.tv_sec * 1000000000ull + (uint64_t)time.tv_nsec : UINT64_MAX;
+    errno = previous;
+    return value;
+}
+
+static void lane_diagnostic_record(LaneWaitMetric* metric, uint64_t begin, uint64_t end, long result, int error)
+{
+    const unsigned outcome = result == 0 ? BUSTER_WAIT_COMPLETED : error == EAGAIN ? BUSTER_WAIT_EAGAIN :
+                             error == EINTR ? BUSTER_WAIT_INTERRUPTED : BUSTER_WAIT_OTHER;
+    LaneWaitDuration* duration = &metric->outcomes[outcome];
+    duration->calls += 1;
+    if (begin == UINT64_MAX || end == UINT64_MAX || end < begin)
+    {
+        duration->clock_errors += 1;
+    }
+    else
+    {
+        const uint64_t elapsed = end - begin;
+        static const uint64_t boundaries[] = { 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000 };
+        size_t bucket = 0;
+        while (bucket < sizeof(boundaries) / sizeof(boundaries[0]) && elapsed >= boundaries[bucket])
+        {
+            bucket += 1;
+        }
+        duration->buckets[bucket] += 1;
+        duration->elapsed_ns += elapsed;
+        duration->max_ns = elapsed > duration->max_ns ? elapsed : duration->max_ns;
+    }
+}
+
+static long lane_diagnostic_futex(uint32_t* word, uint32_t value, unsigned kind)
+{
+    LaneWaitDiagnostic* diagnostic = &thread_context.wait_diagnostic;
+    const uint64_t begin = diagnostic->active ? lane_diagnostic_now() : UINT64_MAX;
+    const long result = syscall(SYS_futex, word, FUTEX_WAIT_PRIVATE, value, 0, 0, 0);
+    const int error = errno;
+    if (diagnostic->active)
+    {
+        lane_diagnostic_record(&diagnostic->metrics[kind], begin, lane_diagnostic_now(), result, error);
+    }
+    errno = error;
+    return result;
+}
+
+static void lane_diagnostic_begin(uint32_t index, uint32_t expected_cpu, bool enabled)
+{
+    thread_context.wait_diagnostic = (LaneWaitDiagnostic){ .index = index, .expected_cpu = expected_cpu, .active = enabled };
+}
+
+static void lane_diagnostic_finish(void)
+{
+    LaneWaitDiagnostic* diagnostic = &thread_context.wait_diagnostic;
+    if (diagnostic->active)
+    {
+        const int saved_errno = errno;
+        // A thousand clock pairs, after the flow, record instrumentation cost without mixing it into the wait counts.
+        uint64_t minimum = UINT64_MAX, maximum = 0, total = 0, failures = 0;
+        for (unsigned i = 0; i < 1000; i += 1)
+        {
+            const uint64_t begin = lane_diagnostic_now();
+            const uint64_t end = lane_diagnostic_now();
+            if (begin == UINT64_MAX || end == UINT64_MAX || end < begin)
+            {
+                failures += 1;
+            }
+            else
+            {
+                const uint64_t elapsed = end - begin;
+                minimum = elapsed < minimum ? elapsed : minimum;
+                maximum = elapsed > maximum ? elapsed : maximum;
+                total += elapsed;
+            }
+        }
+        unsigned observed = UINT_MAX;
+        const long cpu_status = syscall(SYS_getcpu, &observed, NULL, NULL);
+        static const char* const names[] = { "initial-spin", "mwaitx", "fallback-spin", "barrier-futex", "other-futex" };
+        static const char* const outcomes[] = { "completed", "eagain", "eintr", "other" };
+        flockfile(stderr);
+        fprintf(stderr, "wait-diagnostic\tlane=%u\ttid=%ld\texpected-cpu=%u\tobserved-cpu=%u\tcpu-status=%ld\tscope=start-through-flow\tend-policy=forced-join\n",
+                diagnostic->index, syscall(SYS_gettid), diagnostic->expected_cpu, observed, cpu_status);
+        for (unsigned kind = 0; kind < BUSTER_WAIT_CLASSES; kind += 1)
+        {
+            for (unsigned outcome = 0; outcome < BUSTER_WAIT_OUTCOMES; outcome += 1)
+            {
+                const LaneWaitDuration* duration = &diagnostic->metrics[kind].outcomes[outcome];
+                fprintf(stderr, "wait-diagnostic-metric\tlane=%u\tkind=%s\toutcome=%s\tcalls=%lu\tclock-errors=%lu\telapsed-ns=%lu\tmax-ns=%lu\tbuckets=",
+                        diagnostic->index, names[kind], outcomes[outcome], (unsigned long)duration->calls, (unsigned long)duration->clock_errors,
+                        (unsigned long)duration->elapsed_ns, (unsigned long)duration->max_ns);
+                for (unsigned i = 0; i < BUSTER_WAIT_BUCKETS; i += 1)
+                {
+                    fprintf(stderr, "%s%lu", i == 0 ? "" : ",", (unsigned long)duration->buckets[i]);
+                }
+                fputc('\n', stderr);
+            }
+        }
+        fprintf(stderr, "wait-diagnostic-calibration\tlane=%u\tpairs=1000\tfailures=%lu\tmin-ns=%lu\tmax-ns=%lu\ttotal-ns=%lu\n",
+                diagnostic->index, (unsigned long)failures, (unsigned long)(minimum == UINT64_MAX ? 0 : minimum), (unsigned long)maximum, (unsigned long)total);
+        funlockfile(stderr);
+        diagnostic->active = false;
+        errno = saved_errno;
+    }
+}
+#endif
+
