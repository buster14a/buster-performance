diff --git a/src/buster/compiler/lane_test.c b/src/buster/compiler/lane_test.c
index 9c26de8e..fa2c6d38 100644
--- a/src/buster/compiler/lane_test.c
+++ b/src/buster/compiler/lane_test.c
@@ -3411,0 +3412,157 @@ static uint64_t lane_test_sessions(void)
+#if defined(BUSTER_LANE_WAIT_DIAGNOSTIC) && BUSTER_LANE_WAIT_DIAGNOSTIC
+typedef struct LaneDiagnosticTest LaneDiagnosticTest;
+struct LaneDiagnosticTest
+{
+    uint32_t word, ready, finished;
+    LaneWaitDiagnostic diagnostic;
+    long result;
+    int error;
+    bool signal_unblocked;
+};
+
+static void* lane_diagnostic_test_worker(void* argument)
+{
+    LaneDiagnosticTest* test = argument;
+    lane_diagnostic_begin(7, 2, true);
+    sigset_t unblocked;
+    sigemptyset(&unblocked);
+    sigaddset(&unblocked, SIGUSR2);
+    test->signal_unblocked = pthread_sigmask(SIG_UNBLOCK, &unblocked, 0) == 0;
+    __atomic_store_n(&test->ready, 1, __ATOMIC_RELEASE);
+    test->result = lane_diagnostic_futex(&test->word, 0, BUSTER_WAIT_PARK_FUTEX);
+    test->error = errno;
+    test->diagnostic = thread_context.wait_diagnostic;
+    __atomic_store_n(&test->finished, 1, __ATOMIC_RELEASE);
+    thread_context.wait_diagnostic.active = false;
+    return 0;
+}
+
+static void lane_diagnostic_test_signal(int number)
+{
+    (void)number;
+}
+
+static bool lane_diagnostic_test(void)
+{
+    uint32_t failures = 0;
+    LaneWaitMetric metric = { 0 };
+    lane_diagnostic_record(&metric, 10, 30, 0, 0);
+    lane_diagnostic_record(&metric, 10, 30, -1, EAGAIN);
+    lane_diagnostic_record(&metric, 10, 30, -1, EINTR);
+    lane_diagnostic_record(&metric, 10, 30, -1, EINVAL);
+    lane_diagnostic_record(&metric, UINT64_MAX, 30, 0, 0);
+    const LaneWaitDuration* completed = &metric.outcomes[BUSTER_WAIT_COMPLETED];
+    failures += completed->calls != 2 || completed->clock_errors != 1 || completed->elapsed_ns != 20 || completed->max_ns != 20 || completed->buckets[0] != 1 ||
+                metric.outcomes[BUSTER_WAIT_EAGAIN].calls != 1 || metric.outcomes[BUSTER_WAIT_EAGAIN].elapsed_ns != 20 ||
+                metric.outcomes[BUSTER_WAIT_INTERRUPTED].calls != 1 || metric.outcomes[BUSTER_WAIT_INTERRUPTED].elapsed_ns != 20 ||
+                metric.outcomes[BUSTER_WAIT_OTHER].calls != 1 || metric.outcomes[BUSTER_WAIT_OTHER].elapsed_ns != 20;
+
+    errno = EDOM;
+    const uint64_t begin = lane_diagnostic_now();
+    const uint64_t end = lane_diagnostic_now();
+    failures += begin == UINT64_MAX || end == UINT64_MAX || end < begin || errno != EDOM;
+    uint64_t clock_min = UINT64_MAX, clock_max = 0;
+    for (unsigned i = 0; i < 1000; i += 1)
+    {
+        const uint64_t first = lane_diagnostic_now();
+        const uint64_t last = lane_diagnostic_now();
+        if (first == UINT64_MAX || last == UINT64_MAX || last < first)
+        {
+            failures += 1;
+        }
+        else
+        {
+            const uint64_t elapsed = last - first;
+            clock_min = elapsed < clock_min ? elapsed : clock_min;
+            clock_max = elapsed > clock_max ? elapsed : clock_max;
+        }
+    }
+    printf("wait diagnostic: 1000 clock pairs, min %lu ns, max %lu ns\n", (unsigned long)clock_min, (unsigned long)clock_max);
+
+    uint32_t wrong = 0;
+    lane_diagnostic_begin(3, 5, true);
+    errno = 0;
+    const long refused = lane_diagnostic_futex(&wrong, 1, BUSTER_WAIT_BARRIER_FUTEX);
+    failures += refused != -1 || errno != EAGAIN || thread_context.wait_diagnostic.index != 3 ||
+                thread_context.wait_diagnostic.expected_cpu != 5 ||
+                thread_context.wait_diagnostic.metrics[BUSTER_WAIT_BARRIER_FUTEX].outcomes[BUSTER_WAIT_EAGAIN].calls != 1;
+#if defined(__MWAITX__)
+    unsigned eax = 0, ebx = 0, ecx = 0, edx = 0;
+    const bool mwaitx = __get_cpuid(0x80000001u, &eax, &ebx, &ecx, &edx) != 0 && (ecx & (1u << 29)) != 0;
+    if (mwaitx)
+    {
+        _mm_monitorx(&wrong, 0, 0);
+        lane_diagnostic_mwait(10000);
+        const LaneWaitDuration* observed = &thread_context.wait_diagnostic.metrics[BUSTER_WAIT_MWAITX].outcomes[BUSTER_WAIT_COMPLETED];
+        failures += observed->calls != 1 || observed->clock_errors != 0;
+    }
+    else
+    {
+        printf("wait diagnostic: MWAITX execution skipped (not available on this CPU)\n");
+    }
+#endif
+    thread_context.wait_diagnostic.active = false;
+
+    LaneDiagnosticTest test = { 0 };
+    pthread_t worker;
+    const bool created = pthread_create(&worker, 0, lane_diagnostic_test_worker, &test) == 0;
+    bool woke = false;
+    if (created)
+    {
+        const struct timespec pause = { .tv_nsec = 1000000 };
+        for (unsigned i = 0; i < 5000 && !woke; i += 1)
+        {
+            if (__atomic_load_n(&test.ready, __ATOMIC_ACQUIRE) != 0)
+            {
+                woke = syscall(SYS_futex, &test.word, FUTEX_WAKE_PRIVATE, 1, 0, 0, 0) == 1;
+            }
+            if (!woke)
+            {
+                nanosleep(&pause, 0);
+            }
+        }
+        if (!woke)
+        {
+            __atomic_store_n(&test.word, 1, __ATOMIC_RELEASE);
+            syscall(SYS_futex, &test.word, FUTEX_WAKE_PRIVATE, 1, 0, 0, 0);
+        }
+        pthread_join(worker, 0);
+    }
+    failures += !created || !woke || test.result != 0 || test.diagnostic.index != 7 || test.diagnostic.expected_cpu != 2 ||
+                test.diagnostic.metrics[BUSTER_WAIT_PARK_FUTEX].outcomes[BUSTER_WAIT_COMPLETED].calls != 1 ||
+                test.diagnostic.metrics[BUSTER_WAIT_PARK_FUTEX].outcomes[BUSTER_WAIT_COMPLETED].clock_errors != 0;
+    struct sigaction action = { 0 }, previous = { 0 };
+    action.sa_handler = lane_diagnostic_test_signal;
+    sigemptyset(&action.sa_mask);
+    const bool installed = sigaction(SIGUSR2, &action, &previous) == 0;
+    LaneDiagnosticTest interrupted = { 0 };
+    const bool signal_worker = installed && pthread_create(&worker, 0, lane_diagnostic_test_worker, &interrupted) == 0;
+    if (signal_worker)
+    {
+        const struct timespec pause = { .tv_nsec = 1000000 };
+        for (unsigned i = 0; i < 5000 && __atomic_load_n(&interrupted.finished, __ATOMIC_ACQUIRE) == 0; i += 1)
+        {
+            if (__atomic_load_n(&interrupted.ready, __ATOMIC_ACQUIRE) != 0)
+            {
+                pthread_kill(worker, SIGUSR2);
+            }
+            nanosleep(&pause, 0);
+        }
+        if (__atomic_load_n(&interrupted.finished, __ATOMIC_ACQUIRE) == 0)
+        {
+            __atomic_store_n(&interrupted.word, 1, __ATOMIC_RELEASE);
+            syscall(SYS_futex, &interrupted.word, FUTEX_WAKE_PRIVATE, 1, 0, 0, 0);
+        }
+        pthread_join(worker, 0);
+    }
+    failures += !signal_worker || !interrupted.signal_unblocked || interrupted.result != -1 || interrupted.error != EINTR ||
+                interrupted.diagnostic.metrics[BUSTER_WAIT_PARK_FUTEX].outcomes[BUSTER_WAIT_INTERRUPTED].calls != 1;
+    if (installed)
+    {
+        failures += sigaction(SIGUSR2, &previous, 0) != 0;
+    }
+    printf("wait diagnostic: actual futex wake/EAGAIN, timer, lane identity, accounting and MWAITX where supported: %u wrong\n", failures);
+    return failures == 0;
+}
+#endif
+
@@ -3483,0 +3641,3 @@ static int run_lane_tests(int argc, char** argv)
+#if defined(BUSTER_LANE_WAIT_DIAGNOSTIC) && BUSTER_LANE_WAIT_DIAGNOSTIC
+        passed = lane_diagnostic_test() && passed;
+#endif
