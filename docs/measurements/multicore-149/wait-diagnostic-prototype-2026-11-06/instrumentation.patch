+            const uint64_t fallback_begin = diagnostic_active ? lane_diagnostic_now() : UINT64_MAX;
+#endif
@@ -1467,0 +1645,6 @@ static uint32_t lane_wait(uint32_t* word, uint32_t value)
+#if defined(BUSTER_LANE_WAIT_DIAGNOSTIC) && BUSTER_LANE_WAIT_DIAGNOSTIC
+            if (diagnostic_active)
