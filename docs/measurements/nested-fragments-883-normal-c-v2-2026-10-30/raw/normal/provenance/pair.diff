+            }
+        }
+    }
+    for (uint32_t i = 0; i < BUSTER_ARRAY_LENGTH(memory); i += 1)
+    {
+        if (memory[i] != NULL && memory[i] != MAP_FAILED)
+        {
+            munmap(memory[i], lengths[i] + page);
+        }
+    }
+}
