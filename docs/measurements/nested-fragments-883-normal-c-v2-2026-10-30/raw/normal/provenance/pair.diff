diff --git a/src/buster/compiler/c_check_program_fragment.c b/src/buster/compiler/c_check_program_fragment.c
new file mode 100644
index 00000000..87fa8aa8
--- /dev/null
+++ b/src/buster/compiler/c_check_program_fragment.c
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+//
+// Root-owned, bounded postorder fragments (#868), included after the leaf template helpers.
+// The reverse walk proves a closed executable tree before any local map is read. Only then are its immutable
+// records classified and its occupied entry slots compacted. Failure publishes nothing; the task loop is the twin.
+
+#if BUSTER_HOST_VECTOR
+#define BUSTER_CHECK_LOWER_FRAGMENT_NODES 16u
+
+typedef enum CheckLowerFragmentResult
+{
+    CHECK_LOWER_FRAGMENT_OK,
+    CHECK_LOWER_FRAGMENT_ORDER,
+    CHECK_LOWER_FRAGMENT_BOUND,
+    CHECK_LOWER_FRAGMENT_OPERATOR,
+    CHECK_LOWER_FRAGMENT_EFFECT,
+    CHECK_LOWER_FRAGMENT_TYPE,
+    CHECK_LOWER_FRAGMENT_CONVERSION,
+    CHECK_LOWER_FRAGMENT_PAYLOAD,
+    CHECK_LOWER_FRAGMENT_CAPACITY,
+} CheckLowerFragmentResult;
+
+// The initial extension is deliberately integer-only. Shifts retain check_lower_count, and loads, pointers,
+// floating and narrow arithmetic retain their operation-specific expansion. A folded node is a leaf instead.
+static bool check_lower_fragment_operator(CheckOp op)
+{
+    return op < 64 && check_lower_batch_ops[op] != 0 && (op == CHECK_OP_POSITIVE || op == CHECK_OP_NEGATIVE || op == CHECK_OP_BIT_NOT ||
+           (op >= CHECK_OP_ADD && op <= CHECK_OP_REMAINDER) || (op >= CHECK_OP_LESS && op <= CHECK_OP_BIT_XOR) ||
+           op == CHECK_OP_CAST || op == CHECK_OP_CONVERT || op == CHECK_OP_SELECT);
+}
+
+static __attribute__((noinline)) bool check_lower_fragment(CheckLowerWriter* writer, uint32_t root)
+{
+    const CheckProgram* program = writer->program;
+    const CheckStream* stream = program->stream;
+    const CheckGraph* graph = &program->input->graph;
+    uint32_t pending[BUSTER_CHECK_LOWER_FRAGMENT_NODES] = { root };
+    uint32_t depth = 1;
+    uint32_t count = 0;
+    uint32_t leaves = 0;
+    uint32_t last_leaf = BUSTER_CHECK_NONE;
+    CheckLowerFragmentResult result = CHECK_LOWER_FRAGMENT_OK;
+    while (result == CHECK_LOWER_FRAGMENT_OK && depth != 0 && count < BUSTER_CHECK_LOWER_FRAGMENT_NODES)
+    {
+        const uint32_t node = pending[--depth];
+        if (count > root || node != root - count || node >= stream->count || node >= graph->count)
+        {
+            result = CHECK_LOWER_FRAGMENT_ORDER;
+        }
+        else
+        {
+            const CheckOp op = graph->ops[node];
+            const CheckValue* value = stream->values + node;
+            const bool leaf = op == CHECK_OP_VALUE || check_lower_batch_proof(value, op);
+            leaves = (leaves << 1) | leaf;
+            count += 1;
+            if (value->overload_head != 0 || value->fault != CHECK_FAULT_NONE ||
+                (value->flags & (BUSTER_CHECK_SIDE_EFFECT | BUSTER_CHECK_FP_ENVIRONMENT)) != 0)
+            {
+                result = CHECK_LOWER_FRAGMENT_EFFECT;
+            }
+            else if (leaf)
+            {
+                last_leaf = last_leaf == BUSTER_CHECK_NONE ? node : last_leaf;
+            }
+            else if (!check_lower_fragment_operator(op))
+            {
+                result = CHECK_LOWER_FRAGMENT_OPERATOR;
+            }
+            else
+            {
+                const bool binary = op >= CHECK_OP_ADD && op <= CHECK_OP_BIT_XOR;
+                const uint32_t a = graph->operand0[node];
+                const uint32_t b = binary ? graph->operand1[node] : 0;
+                if (a >= node || (binary && b >= node))
+                {
+                    result = CHECK_LOWER_FRAGMENT_ORDER;
+                }
+                else if (depth + 1 + binary > BUSTER_CHECK_LOWER_FRAGMENT_NODES)
+                {
+                    result = CHECK_LOWER_FRAGMENT_BOUND;
+                }
+                else
+                {
+                    // Reverse postorder visits the right subtree first. Matching each popped identity to the next
+                    // index rejects gaps, repeated/reordered operands and a folded child's skipped descendants.
+                    pending[depth++] = a;
+                    if (binary)
+                    {
+                        pending[depth++] = b;
+                    }
+                }
+            }
+        }
+    }
+    if (result == CHECK_LOWER_FRAGMENT_OK && depth != 0)
+    {
+        result = CHECK_LOWER_FRAGMENT_BOUND;
+    }
+    if (result == CHECK_LOWER_FRAGMENT_OK && count < 3)
+    {
+        result = CHECK_LOWER_FRAGMENT_ORDER;
+    }
+    uint8_t kinds[BUSTER_CHECK_LOWER_FRAGMENT_NODES] = { 0 };
+    uint8_t classes[BUSTER_CHECK_LOWER_FRAGMENT_NODES] = { 0 };
+    uint64_t values[BUSTER_CHECK_LOWER_FRAGMENT_NODES] = { 0 };
+    uint32_t occupied = 0;
+    if (result == CHECK_LOWER_FRAGMENT_OK)
+    {
+        const uint32_t first = root + 1 - count;
+        uint32_t metadata[BUSTER_CHECK_LOWER_FRAGMENT_NODES];
+        const __m512i classified = check_lower_batch_classify(writer, first, count);
+        _mm512_storeu_si512(metadata, classified);
+        const __mmask16 active = (__mmask16)((1u << count) - 1);
+        const __m512i class = _mm512_and_si512(classified, _mm512_set1_epi32(UINT8_MAX));
+        const uint32_t forbidden = (BUSTER_CHECK_LOWER_TYPE_AGGREGATE | BUSTER_CHECK_LOWER_TYPE_COMPLEX |
+                                   BUSTER_CHECK_LOWER_TYPE_ADDRESS | BUSTER_CHECK_LOWER_TYPE_POINTER |
+                                   BUSTER_CHECK_LOWER_TYPE_ATOMIC | BUSTER_CHECK_LOWER_TYPE_BIT_INT |
+                                   BUSTER_CHECK_LOWER_TYPE_VOLATILE_COPY) << 8;
+        const __mmask16 invalid = _mm512_cmplt_epu32_mask(class, _mm512_set1_epi32(BUSTER_TYPED_CLASS_I32)) |
+                                 _mm512_cmpgt_epu32_mask(class, _mm512_set1_epi32(BUSTER_TYPED_CLASS_U64)) |
+                                 _mm512_cmpge_epu32_mask(class, _mm512_set1_epi32(writer->class_limit)) |
+                                 _mm512_test_epi32_mask(classified, _mm512_set1_epi32((int)forbidden));
+        if ((active & invalid) != 0)
+        {
+            result = CHECK_LOWER_FRAGMENT_TYPE;
+        }
+        _mm_storeu_si128((__m128i*)classes, _mm512_cvtepi32_epi8(class));
+        for (uint32_t i = 0; result == CHECK_LOWER_FRAGMENT_OK && i < count; i += 1)
+        {
+            const uint32_t node = first + i;
+            if ((leaves & (1u << i)) != 0)
+            {
+                if (!check_lower_value_payload(writer, node, metadata[i], false, kinds + i, values + i))
+                {
+                    result = CHECK_LOWER_FRAGMENT_PAYLOAD;
+                }
+                occupied |= 1u << i;
+            }
+            else
+            {
+                const CheckOp op = graph->ops[node];
+                const bool binary = op >= CHECK_OP_ADD && op <= CHECK_OP_BIT_XOR;
+                const bool wrapper = op == CHECK_OP_CAST || op == CHECK_OP_CONVERT || op == CHECK_OP_POSITIVE;
+                for (uint32_t edge = 0; result == CHECK_LOWER_FRAGMENT_OK && edge < 1u + binary; edge += 1)
+                {
+                    const uint32_t child = edge == 0 ? graph->operand0[node] : graph->operand1[node];
+                    const TypeId from = stream->values[child].type;
+                    const TypeId to = wrapper ? stream->values[node].type : op == CHECK_OP_SELECT ? 0 : stream->conversions[node].operands[edge].type;
+                    if (!check_lower_batch_target(writer, to, true) || (to != 0 && from != to && !check_lower_conversion_empty(writer, from, to)))
+                    {
+                        result = CHECK_LOWER_FRAGMENT_CONVERSION;
+                    }
+                }
+                const uint8_t recipe = (uint8_t)(metadata[i] >> 16);
+                if (recipe != BUSTER_CHECK_LOWER_BATCH_WRAPPER)
+                {
+                    kinds[i] = recipe;
+                    occupied |= 1u << i;
+                }
+            }
+        }
+    }
+    const uint32_t entries = (uint32_t)__builtin_popcount(occupied);
+    const uint32_t room = writer->capacity < BUSTER_TIER0_MAX_ENTRIES ? writer->capacity : BUSTER_TIER0_MAX_ENTRIES;
+    if (result == CHECK_LOWER_FRAGMENT_OK && (writer->count > room || entries > room - writer->count ||
+        writer->depth > writer->capacity || 3 * count > writer->capacity - writer->depth))
+    {
+        // At most an instruction and two operand tasks per supported node. Although this path uses no tasks,
+        // reserve that conservative upper bound so it cannot turn a scalar task-capacity failure into success.
+        result = CHECK_LOWER_FRAGMENT_CAPACITY;
+    }
+    if (result == CHECK_LOWER_FRAGMENT_OK)
+    {
+        const __mmask16 prefix = (__mmask16)((1u << entries) - 1);
+        _mm_mask_storeu_epi8(writer->kinds + writer->count, prefix, _mm_maskz_compress_epi8((__mmask16)occupied, _mm_loadu_si128((const __m128i*)kinds)));
+        _mm_mask_storeu_epi8(writer->classes + writer->count, prefix, _mm_maskz_compress_epi8((__mmask16)occupied, _mm_loadu_si128((const __m128i*)classes)));
+        const uint32_t low_count = (uint32_t)__builtin_popcount(occupied & UINT8_MAX);
+        const uint32_t high_count = entries - low_count;
+        const __m512i low = _mm512_maskz_compress_epi64((__mmask8)occupied, _mm512_loadu_si512(values));
+        const __m512i high = _mm512_maskz_compress_epi64((__mmask8)(occupied >> 8), _mm512_loadu_si512(values + 8));
+        _mm512_mask_storeu_epi64(writer->values + writer->count, (__mmask8)((1u << low_count) - 1), low);
+        _mm512_mask_storeu_epi64(writer->values + writer->count + low_count, (__mmask8)((1u << high_count) - 1), high);
+        writer->count += entries;
+        writer->token = graph->tokens[last_leaf];
+        writer->expression_nodes += count;
+        writer->batch_nodes += count;
+    }
+#if defined(BUSTER_CHECK_LOWER_FRAGMENT_TRACE)
+    // Qualification-only records: attempted roots, not all evaluated occurrences. Never time a trace build.
+    fprintf(stderr, "lower-fragment root=%u visited=%u result=%u entries=%u\n", root, count, (unsigned)result, result == CHECK_LOWER_FRAGMENT_OK ? entries : 0);
+#endif
+    return result == CHECK_LOWER_FRAGMENT_OK;
+}
+#endif
diff --git a/src/buster/compiler/c_check_program_fragment_test.c b/src/buster/compiler/c_check_program_fragment_test.c
new file mode 100644
index 00000000..a83e563e
--- /dev/null
+++ b/src/buster/compiler/c_check_program_fragment_test.c
@@ -0,0 +1,243 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+//
+// Closed-fragment regression tests (#868). Compare the real scalar drain, normal dispatch and direct candidate;
+// every graph and output column ends at a protected page. Rejected speculation must leave output untouched.
+
+#define BUSTER_CHECK_FRAGMENT_TEST_NODES 17u
+#define BUSTER_CHECK_FRAGMENT_TEST_ENTRIES 96u
+
+static void check_test_program_fragments(CheckTest* test, TypeTable* types, uint8_t* type_classes, uint8_t* type_facts, uint32_t* type_templates)
+{
+    const uint64_t page = (uint64_t)sysconf(_SC_PAGESIZE);
+    const uint32_t sizes[] = {
+        sizeof(CheckOp),
+        sizeof(uint32_t),
+        sizeof(uint32_t),
+        sizeof(uint32_t),
+        sizeof(CheckValue),
+        sizeof(CheckNodeConversions),
+    };
+    uint8_t* memory[15] = { 0 };
+    uint64_t lengths[15] = { 0 };
+    bool ready = true;
+    for (uint32_t i = 0; i < BUSTER_ARRAY_LENGTH(memory); i += 1)
+    {
+        const uint64_t bytes = i < 6 ? (uint64_t)sizes[i] * BUSTER_CHECK_FRAGMENT_TEST_NODES :
+                                      (uint64_t)BUSTER_CHECK_FRAGMENT_TEST_ENTRIES * ((i - 6) % 3 == 2 ? sizeof(uint64_t) : 1);
+        lengths[i] = (bytes + page - 1) / page * page;
+        memory[i] = mmap(0, lengths[i] + page, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        if (memory[i] == MAP_FAILED)
+        {
+            ready = false;
+        }
+        else
+        {
+            ready = mprotect(memory[i] + lengths[i], page, PROT_NONE) == 0 && ready;
+        }
+    }
+    check_test_expect(test, ready, "nested fragments have protected graph, conversion, payload and output tails");
+    uint32_t locals[2] = {
+        BUSTER_CHECK_NONE,
+        0,
+    };
+    SymbolId symbols[2] = {
+        0,
+        1,
+    };
+    uint8_t object_flags[1] = { 0 };
+    const TypeId integers[] = {
+        BUSTER_TYPE_INT,
+        BUSTER_TYPE_UINT,
+        BUSTER_TYPE_LONG,
+        BUSTER_TYPE_ULONG,
+    };
+    for (uint32_t count = 3; ready && count <= BUSTER_CHECK_FRAGMENT_TEST_NODES; count += 1)
+    {
+        CheckInput input = {
+            .compound_objects = object_flags,
+            .static_objects = object_flags,
+        };
+        CheckGraph* graph = &input.graph;
+        graph->count = count;
+        graph->ops = (CheckOp*)(memory[0] + lengths[0] - (uint64_t)count * sizes[0]);
+        graph->operand0 = (uint32_t*)(memory[1] + lengths[1] - (uint64_t)count * sizes[1]);
+        graph->operand1 = (uint32_t*)(memory[2] + lengths[2] - (uint64_t)count * sizes[2]);
+        graph->tokens = (uint32_t*)(memory[3] + lengths[3] - (uint64_t)count * sizes[3]);
+        CheckStream stream = {
+            .values = (CheckValue*)(memory[4] + lengths[4] - (uint64_t)count * sizes[4]),
+            .conversions = (CheckNodeConversions*)(memory[5] + lengths[5] - (uint64_t)count * sizes[5]),
+            .count = count,
+        };
+        CheckProgram program = {
+            .input = &input,
+            .stream = &stream,
+            .types = types,
+            .object_count = 2,
+            .object_symbols = symbols,
+        };
+        for (uint32_t shape = 0; shape < 5; shape += 1)
+        {
+            const TypeId integer = integers[(count + shape) % BUSTER_ARRAY_LENGTH(integers)];
+            const bool selected = shape < 2 || (shape < 4 && count % 2 != 0) || (shape == 4 && count == 7);
+            for (uint32_t mode = 0; selected && mode < (shape == 4 ? 7u : 1u); mode += 1)
+            {
+                memset(stream.values, 0, (uint64_t)count * sizeof(CheckValue));
+                memset(stream.conversions, 0, (uint64_t)count * sizeof(CheckNodeConversions));
+                uint32_t entries = 0;
+                for (uint32_t n = 0; n < count; n += 1)
+                {
+                    const uint32_t leaf_count = (count + 1) / 2;
+                    const bool leaf = shape < 2 ? n == 0 : shape == 2 ? n == 0 || n % 2 != 0 :
+                                      shape == 3 ? n < leaf_count : n == 0 || n == 1 || n == 3 || n == 4;
+                    graph->tokens[n] = 2000 + n;
+                    graph->ops[n] = leaf ? CHECK_OP_VALUE : shape == 1 && n + 1 != count && n % 3 != 0 ? CHECK_OP_CAST :
+                                    shape < 2 ? CHECK_OP_NEGATIVE : n + 1 == count ? CHECK_OP_BIT_XOR : CHECK_OP_SUBTRACT;
+                    graph->operand0[n] = leaf ? BUSTER_CHECK_NONE : shape < 2 ? n - 1 : shape == 3 ? count - 1 - n : shape == 4 && n == 6 ? 2 : n - 2;
+                    graph->operand1[n] = leaf || shape < 2 ? BUSTER_CHECK_NONE : n - 1;
+                    stream.values[n].type = integer;
+                    stream.values[n].category = n == 0 ? CHECK_LVALUE : CHECK_RVALUE;
+                    stream.values[n].constant_kind = leaf && n != 0 ? CHECK_CONSTANT_INTEGER : CHECK_CONSTANT_NONE;
+                    stream.values[n].integer = 17 + n;
+                    stream.values[n].object = n == 0 ? 1 : 0;
+                    stream.conversions[n].operands[0].type = integer;
+                    stream.conversions[n].operands[1].type = integer;
+                    entries += graph->ops[n] != CHECK_OP_CAST;
+                }
+                if (mode == 1)
+                {
+                    stream.values[4].type = BUSTER_TYPE_CHAR;
+                }
+                else if (mode == 2)
+                {
+                    graph->operand1[count - 1] = graph->operand0[count - 1];
+                }
+                else if (mode == 3)
+                {
+                    graph->operand0[count - 1] = 5;
+                    graph->operand1[count - 1] = 2;
+                }
+                else if (mode == 4)
+                {
+                    stream.values[count - 1].flags = BUSTER_CHECK_SIDE_EFFECT;
+                }
+                else if (mode == 5)
+                {
+                    stream.values[5].constant_kind = CHECK_CONSTANT_INTEGER;
+                    stream.values[5].integer = 42;
+                }
+                else if (mode == 6)
+                {
+                    graph->ops[5] = CHECK_OP_SHIFT_LEFT;
+                }
+                for (uint32_t limit = 0; limit < 6; limit += 1)
+                {
+                    const uint32_t capacity = limit == 1 ? count : limit == 2 ? 2 : limit == 3 ? 3 * count - 1 : limit == 4 ? 3 * count : BUSTER_CHECK_FRAGMENT_TEST_ENTRIES;
+                    const uint32_t initial = limit == 5 ? capacity - entries : 0;
+                    CheckProgramLowered status[3] = { 0 };
+                    CheckLowerWriter writers[3];
+                    CheckLowerTaskPacked tasks[3][BUSTER_CHECK_FRAGMENT_TEST_ENTRIES];
+                    uint8_t indirect[3][1] = { { 0 } };
+                    uint8_t local_flags[3][1] = { { 0 } };
+                    for (uint32_t path = 0; path < 3; path += 1)
+                    {
+                        uint8_t* kinds = memory[6 + path * 3] + lengths[6 + path * 3] - BUSTER_CHECK_FRAGMENT_TEST_ENTRIES;
+                        uint8_t* classes = memory[7 + path * 3] + lengths[7 + path * 3] - BUSTER_CHECK_FRAGMENT_TEST_ENTRIES;
+                        uint64_t* values = (uint64_t*)(memory[8 + path * 3] + lengths[8 + path * 3] - BUSTER_CHECK_FRAGMENT_TEST_ENTRIES * sizeof(uint64_t));
+                        memset(kinds, 0xa5, BUSTER_CHECK_FRAGMENT_TEST_ENTRIES);
+                        memset(classes, 0xa5, BUSTER_CHECK_FRAGMENT_TEST_ENTRIES);
+                        memset(values, 0xa5, BUSTER_CHECK_FRAGMENT_TEST_ENTRIES * sizeof(uint64_t));
+                        writers[path] = (CheckLowerWriter){
+                            .program = &program,
+                            .output = status + path,
+                            .tasks = tasks[path],
+                            .kinds = kinds,
+                            .classes = classes,
+                            .values = values,
+                            .local_map = locals,
+                            .indirect = indirect[path],
+                            .local_flags = local_flags[path],
+                            .capacity = capacity,
+                            .count = initial,
+                            .token = 123,
+                            .scalar = path == 0,
+                            .type_classes = type_classes,
+                            .type_facts = type_facts,
+                            .type_templates = type_templates,
+                            .type_count = types->types.count,
+                            .class_limit = BUSTER_TYPED_CLASSES,
+                        };
+                        bool accepted = false;
+#if BUSTER_HOST_VECTOR
+                        if (path == 2)
+                        {
+                            accepted = check_lower_fragment(writers + path, count - 1);
+                            const bool expected = mode == 0 && count <= BUSTER_CHECK_LOWER_FRAGMENT_NODES && capacity >= 3 * count;
+                            check_test_expect(test, accepted == expected, "a closed integer fragment is accepted exactly within the node and capacity bounds");
+                            if (!accepted)
+                            {
+                                bool untouched = writers[path].count == initial && writers[path].token == 123 && writers[path].depth == 0 &&
+                                                 writers[path].expression_nodes == 0 && writers[path].batch_nodes == 0 && status[path].status == CHECK_PROGRAM_OK;
+                                for (uint32_t i = 0; i < BUSTER_CHECK_FRAGMENT_TEST_ENTRIES; i += 1)
+                                {
+                                    untouched = untouched && kinds[i] == 0xa5 && classes[i] == 0xa5 && values[i] == UINT64_C(0xa5a5a5a5a5a5a5a5);
+                                }
+                                check_test_expect(test, untouched, "a rejected fragment does not publish entries, tasks, tokens or evaluated-node counts");
+                            }
+                            else
+                            {
+                                const uint8_t integer_class = type_classes[type_index(integer)];
+                                bool literal = writers[path].count == initial + entries && writers[path].expression_nodes == count && writers[path].batch_nodes == count;
+                                uint32_t entry = initial;
+                                uint32_t last_leaf = 0;
+                                for (uint32_t n = 0; n < count; n += 1)
+                                {
+                                    const CheckOp op = graph->ops[n];
+                                    const bool leaf = op == CHECK_OP_VALUE;
+                                    if (leaf || op != CHECK_OP_CAST)
+                                    {
+                                        const uint8_t kind = leaf ? n == 0 ? BUSTER_TYPED_LOCAL : BUSTER_TYPED_CONST :
+                                                             op == CHECK_OP_NEGATIVE ? BUSTER_TYPED_NEG : op == CHECK_OP_BIT_XOR ? BUSTER_TYPED_XOR : BUSTER_TYPED_SUB;
+                                        literal = literal && kinds[entry] == kind && classes[entry] == integer_class && values[entry] == (leaf && n != 0 ? 17u + n : 0);
+                                        entry += 1;
+                                    }
+                                    last_leaf = leaf ? n : last_leaf;
+                                }
+                                check_test_expect(test, literal && writers[path].token == graph->tokens[last_leaf], "nested entries, compacted wrapper holes and final tokens also agree with independent literals");
+                            }
+                        }
+#endif
+                        if (!accepted)
+                        {
+                            check_lower_expression(writers + path, count - 1, false, 0);
+                        }
+                        check_lower_drain(writers + path);
+                    }
+                    for (uint32_t path = 1; path < 3; path += 1)
+                    {
+                        const bool same = writers[0].count == writers[path].count && writers[0].depth == writers[path].depth &&
+                                          writers[0].token == writers[path].token && status[0].status == status[path].status && status[0].token == status[path].token &&
+                                          writers[0].expression_nodes == writers[path].expression_nodes && local_flags[0][0] == local_flags[path][0] &&
+                                          memcmp(writers[0].kinds, writers[path].kinds, BUSTER_CHECK_FRAGMENT_TEST_ENTRIES) == 0 &&
+                                          memcmp(writers[0].classes, writers[path].classes, BUSTER_CHECK_FRAGMENT_TEST_ENTRIES) == 0 &&
+                                          memcmp(writers[0].values, writers[path].values, BUSTER_CHECK_FRAGMENT_TEST_ENTRIES * sizeof(uint64_t)) == 0;
+                        char description[160];
+                        snprintf(description, sizeof(description), "nested fragments: %u nodes, shape %u, mode %u, limit %u, path %u matches the scalar drain", count, shape, mode, limit, path);
+                        check_test_expect(test, same, description);
