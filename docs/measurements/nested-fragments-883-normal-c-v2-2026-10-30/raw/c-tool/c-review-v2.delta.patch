+static bool hp_clear_bash_functions(char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool valid = true;
+    size_t index = 0;
+    while (valid && environ != NULL && environ[index] != NULL)
+    {
+        const char* entry = environ[index];
+        if (strncmp(entry, "BASH_FUNC_", 10) == 0)
+        {
+            const char* equals = strchr(entry, '=');
+            size_t size = equals != NULL ? (size_t)(equals - entry) : 0;
+            char name[BUSTER_HP_PATH_CAPACITY] = {0};
+            valid = equals != NULL && size < sizeof(name);
+            if (valid)
+            {
+                memcpy(name, entry, size);
+                valid = unsetenv(name) == 0;
+            }
+            // unsetenv shifts remaining entries down; inspect this index again.
+        }
+        else
+        {
+            ++index;
+        }
+    }
+    if (!valid)
+    {
+        hp_error(error, "cannot remove inherited Bash function environment");
+    }
+    return valid;
+}
