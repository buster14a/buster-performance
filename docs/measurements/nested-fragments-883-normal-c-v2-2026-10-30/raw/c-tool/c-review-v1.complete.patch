+
+static void plan_record(PlanSuite *suite, const char *name, bool passed, const char *error)
+{
+    suite->count += 1;
+    suite->failures += !passed;
+    printf("%s %s", passed ? "PASS" : "FAIL", name);
+    if (!passed && error[0] != 0)
+    {
+        printf(" [%s]", error);
+    }
+    printf("\n");
+    return;
+}
