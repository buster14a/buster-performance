+static bool hp_digest_text(const char* text)
+{
+    bool valid = strlen(text) == 64;
+    for (size_t i = 0; valid && i < 64; i += 1)
+    {
+        valid = (text[i] >= '0' && text[i] <= '9') || (text[i] >= 'a' && text[i] <= 'f');
+    }
+    return valid;
+}
