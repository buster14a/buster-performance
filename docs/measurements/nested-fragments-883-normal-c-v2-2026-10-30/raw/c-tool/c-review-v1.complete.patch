+static void control_reader_symbol_mapping(ControlSuite *suite)
+{
+    ControlFixture fixture;
+    ControlOptions options = control_options(16, BUSTER_FAULT_NONE);
+    options.reorder = true;
+    control_fixture(&fixture, options);
+    Elf64_Shdr symtab = control_section(&fixture, BUSTER_SECTION_SYMTAB);
+    Elf64_Shdr second = control_section(&fixture, BUSTER_SECTION_COMMENT);
+    Elf64_Shdr rela = control_section(&fixture, BUSTER_SECTION_RELA_HOT);
+    // Construct a second symbol table in unused fixture alignment padding.
+    // The byte reader must flatten its raw indices into distinct global indices.
+    assert(512 + symtab.sh_size < 4096);
+    memcpy(fixture.bytes.data + 512, fixture.bytes.data + symtab.sh_offset, (size_t)symtab.sh_size);
+    second.sh_type = SHT_DYNSYM;
+    second.sh_flags = 0;
+    second.sh_offset = 512;
+    second.sh_size = symtab.sh_size;
+    second.sh_link = symtab.sh_link;
+    second.sh_info = symtab.sh_info;
+    second.sh_addralign = 8;
+    second.sh_entsize = sizeof(Elf64_Sym);
+    rela.sh_link = (Elf64_Word)fixture.section_index[BUSTER_SECTION_COMMENT];
+    control_set_section(&fixture, BUSTER_SECTION_COMMENT, second);
+    control_set_section(&fixture, BUSTER_SECTION_RELA_HOT, rela);
+    Elf64_Ehdr header = control_header(&fixture);
+    header.e_type = ET_DYN;
+    control_set_header(&fixture, header);
+    HpElf elf = {0};
+    HpBytes bytes =
+    {
+        fixture.bytes.data,
+        fixture.bytes.size
+    };
+    char error[BUSTER_HP_ERROR_CAPACITY] = {0};
+    bool accepted = hp_elf_read(bytes, &elf, error);
+    bool valid = accepted && elf.symbol_count == 12 && elf.relocation_count == 3;
+    size_t external_count = 0;
+    size_t foo_count = 0;
+    for (size_t i = 0; valid && i < elf.relocation_count; i += 1)
+    {
+        const HpRelocation *relocation = &elf.relocations[i];
+        valid = relocation->symbol < elf.symbol_count;
+        if (valid)
+        {
+            const HpSymbol *symbol = &elf.symbols[relocation->symbol];
+            if (relocation->section == fixture.section_index[BUSTER_SECTION_RELA_HOT])
+            {
+                valid = relocation->symbol == fixture.symbol_count + fixture.symbol_index[BUSTER_SYMBOL_EXTERNAL] && symbol->table == fixture.section_index[BUSTER_SECTION_COMMENT] && symbol->index == fixture.symbol_index[BUSTER_SYMBOL_EXTERNAL] && hp_string_is(symbol->name, "external");
+                external_count += 1;
+            }
+            else if (relocation->offset == 8)
+            {
+                valid = relocation->symbol == fixture.symbol_index[BUSTER_SYMBOL_FOO] && symbol->table == fixture.section_index[BUSTER_SECTION_SYMTAB] && symbol->index == fixture.symbol_index[BUSTER_SYMBOL_FOO] && hp_string_is(symbol->name, "foo") && symbol->value == 16 && symbol->section == fixture.section_index[BUSTER_SECTION_HOT];
+                foo_count += 1;
+            }
+        }
+    }
+    valid = valid && external_count == 1 && foo_count == 1;
+    control_record(suite, "reader-reordered-symbols-and-distinct-table-global-mapping", true, valid, error);
+    hp_elf_free(&elf);
+    return;
+}
