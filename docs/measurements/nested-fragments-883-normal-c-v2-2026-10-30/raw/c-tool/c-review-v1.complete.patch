+static bool hp_normalize_relocations(const HpElf *elf, HpString hot, uint64_t shift, uint64_t original_hot_size, HpNormalized *normalized, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    normalized->relocations = hp_array(elf->relocation_count, sizeof(*normalized->relocations), error);
+    HpRange *fields = hp_array(elf->relocation_count, sizeof(*fields), error);
+    bool ok = normalized->relocations != NULL && fields != NULL;
+    for (size_t i = 0; ok && i < elf->relocation_count; i += 1)
+    {
+        const HpRelocation *relocation = &elf->relocations[i];
+        const HpSymbol *symbol = &elf->symbols[relocation->symbol];
+        const HpSection *target = &elf->sections[relocation->target_section];
+        unsigned width = hp_elf_relocation_width(relocation->type);
+        ok = hp_require(width != 0, error, "unsupported relocation type") && hp_require(symbol->table == normalized->table && symbol->type != STT_FILE, error, "relocation uses unexpected symbol table or STT_FILE") && hp_require(!hp_string_is(target->name, ".comment") && !(symbol->section > 0 && symbol->section < elf->section_count && hp_string_is(elf->sections[symbol->section].name, ".comment")), error, "relocation involves ignored producer bytes") && hp_require((target->type == SHT_PROGBITS || target->type == SHT_INIT_ARRAY || target->type == SHT_FINI_ARRAY || target->type == SHT_PREINIT_ARRAY) && relocation->offset <= target->size && width <= target->size - relocation->offset, error, "relocation field outside supported file-backed content");
+        if (ok)
+        {
+            HpNormalizedRelocation *result = &normalized->relocations[i];
+            result->section_name = elf->sections[relocation->section].name;
+            result->target_name = target->name;
+            result->offset = relocation->offset;
+            result->type = relocation->type;
+            result->identity = normalized->identities[relocation->symbol];
+            result->addend = relocation->addend;
+            fields[i] = (HpRange)
+            {
+                relocation->offset,
+                relocation->offset + width,
+                target->index
+            };
+            if (hp_string_equal(target->name, hot))
+            {
+                ok = hp_require(result->offset >= shift, error, "relocation in inserted hot prefix");
+                if (ok)
+                {
+                    result->offset -= shift;
+                }
+            }
+            if (ok && symbol->type == STT_SECTION && hp_string_equal(result->identity.section_name, hot) && result->identity.special == 0)
+            {
+                ok = hp_require(hp_direct_section_type(relocation->type), error, "non-direct relocation to hot section symbol") && hp_require(result->addend >= INT64_MIN + (int64_t)shift, error, "normalized relocation addend underflow");
+                if (ok)
+                {
+                    result->addend -= (int64_t)shift;
+                    int64_t bias = hp_pc_type(relocation->type) ? (int64_t)width : 0;
+                    ok = hp_require(result->addend >= -bias && (result->addend < 0 || (uint64_t)result->addend <= original_hot_size), error, "hot section-symbol addend outside bounded direct target");
+                }
+            }
+        }
+    }
+    if (ok)
+    {
+        qsort(fields, elf->relocation_count, sizeof(*fields), hp_range_compare);
+        for (size_t i = 1; ok && i < elf->relocation_count; i += 1)
+        {
+            ok = hp_require(fields[i - 1].section != fields[i].section || fields[i - 1].end <= fields[i].begin, error, "overlapping relocation fields");
+        }
+        qsort(normalized->relocations, elf->relocation_count, sizeof(*normalized->relocations), hp_relocation_compare);
+    }
+    free(fields);
+    return ok;
+}
+
+static bool hp_addrsig(const HpElf *elf, const HpSection *section, const HpNormalized *normalized, HpIdentity **identities, size_t *count, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    HpIdentity *result = hp_array(section->bytes.size, sizeof(*result), error);
+    bool ok = result != NULL;
+    size_t position = 0;
+    size_t used = 0;
+    while (ok && position < section->bytes.size)
+    {
+        uint64_t value = 0;
+        unsigned bits = 0;
+        size_t start = position;
+        bool finished = false;
+        while (ok && !finished)
+        {
+            ok = hp_require(position < section->bytes.size && bits < 64, error, "malformed .llvm_addrsig ULEB128");
+            if (ok)
+            {
+                unsigned byte = section->bytes.data[position++];
+                ok = hp_require(bits != 63 || (byte & 127U) <= 1, error, "overflowing .llvm_addrsig ULEB128");
+                if (ok)
+                {
+                    value |= (uint64_t)(byte & 127U) << bits;
+                    if (byte < 128)
+                    {
+                        ok = hp_require(position - start == 1 || byte != 0, error, "noncanonical .llvm_addrsig ULEB128");
+                        finished = true;
+                    }
+                    else
+                    {
+                        bits += 7;
+                    }
+                }
+            }
+        }
+        if (ok)
+        {
+            ok = hp_require(value < elf->symbol_count && elf->symbols[value].type != STT_FILE, error, "bad .llvm_addrsig symbol");
+            if (ok)
+            {
+                result[used++] = normalized->identities[value];
+            }
+        }
+    }
+    if (ok)
+    {
+        qsort(result, used, sizeof(*result), hp_identity_compare);
+        *identities = result;
+        *count = used;
+    }
+    else
+    {
+        free(result);
+    }
+    return ok;
+}
+
+static const HpSection *hp_section_by_name(const HpElf *elf, HpString name)
+{
+    const HpSection *result = NULL;
+    for (size_t i = 0; i < elf->section_count; i += 1)
+    {
+        if (hp_string_equal(elf->sections[i].name, name))
+        {
+            result = &elf->sections[i];
+        }
+    }
+    return result;
+}
+
+static bool hp_is_comment(const HpSection *section)
+{
+    return section != NULL && hp_string_is(section->name, ".comment");
+}
+
+static bool hp_validate_comment(const HpSection *section, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool ok = true;
+    if (section != NULL)
+    {
+        ok = hp_require((section->flags & ~UINT64_C(0x30)) == 0 && section->type == SHT_PROGBITS && section->link == 0 && section->info == 0 && section->align <= 1 && section->entsize <= 1, error, "semantic .comment section");
+    }
+    return ok;
+}
+
+void hp_object_proof_free(HpObjectProof *proof)
+{
+    free(proof->disclosures);
+    memset(proof, 0, sizeof(*proof));
+}
+
+static void hp_disclose(HpObjectProof *proof, HpDisclosureKind kind, size_t section)
+{
+    // The caller allocates section_count + 2: at most one per common section,
+    // plus one .comment disclosure and one STT_FILE-record disclosure.
+    proof->disclosures[proof->disclosure_count].kind = kind;
+    proof->disclosures[proof->disclosure_count].section = section;
+    proof->disclosure_count += 1;
+}
+
+static bool hp_compare_sections(const HpElf *a, const HpElf *b, const HpSection *hot_a, const HpNormalized *na, const HpNormalized *nb, HpObjectProof *proof, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool ok = hp_string_equal(a->sections[a->shstr_index].name, b->sections[b->shstr_index].name) && hp_string_equal(a->sections[a->sections[na->table].link].name, b->sections[b->sections[nb->table].link].name);
+    // The two ownership roles are deliberately retained, which is stricter than
+    // treating their section names as an unordered set.
+    ok = hp_require(ok, error, "string-table ownership changed");
+    for (size_t i = 0; ok && i < a->section_count; i += 1)
+    {
+        const HpSection *x = &a->sections[i];
+        const HpSection *y = hp_section_by_name(b, x->name);
+        if (!hp_is_comment(x))
+        {
+            ok = hp_require(y != NULL, error, "section inventory changed");
+            if (ok)
+            {
+                ok = hp_require(x->type == y->type && x->flags == y->flags && x->align == y->align && x->entsize == y->entsize, error, "section attributes changed") && hp_require(hp_string_equal(a->sections[x->link].name, b->sections[y->link].name), error, "section link ownership changed");
+            }
+            if (ok && x->type == SHT_RELA)
+            {
+                ok = hp_require(hp_string_equal(a->sections[x->info].name, b->sections[y->info].name), error, "relocation section target changed");
+            }
+            else if (ok && x->type != SHT_SYMTAB)
+            {
+                ok = hp_require(x->info == y->info, error, "section info changed");
+            }
+            if (ok && (x->type == SHT_SYMTAB || x->type == SHT_RELA || i == a->shstr_index || i == a->sections[na->table].link))
+            {
+                if (!hp_bytes_equal(x->bytes, y->bytes))
+                {
+                    hp_disclose(proof, BUSTER_HP_DISCLOSURE_NORMALIZED_ENCODING, i);
+                }
+            }
+            else if (ok && x->type == BUSTER_HP_ADDRSIG)
+            {
+                HpIdentity *left = NULL;
+                HpIdentity *right = NULL;
+                size_t left_count = 0;
+                size_t right_count = 0;
+                ok = hp_require(x->link == na->table && y->link == nb->table && ((x->flags | y->flags) & SHF_ALLOC) == 0, error, "unsupported .llvm_addrsig ownership") && hp_addrsig(a, x, na, &left, &left_count, error) && hp_addrsig(b, y, nb, &right, &right_count, error);
+                ok = ok && hp_require(left_count == right_count, error, ".llvm_addrsig target count changed");
+                for (size_t j = 0; ok && j < left_count; j += 1)
+                {
+                    ok = hp_require(hp_identity_compare(&left[j], &right[j]) == 0, error, ".llvm_addrsig target identities changed");
+                }
+                free(left);
+                free(right);
+            }
+            else if (ok && x != hot_a)
+            {
+                ok = hp_require(x->size == y->size && hp_bytes_equal(x->bytes, y->bytes), error, "section bytes or size changed");
+            }
+        }
+    }
+    for (size_t i = 0; ok && i < b->section_count; i += 1)
+    {
+        if (!hp_is_comment(&b->sections[i]))
+        {
+            ok = hp_require(hp_section_by_name(a, b->sections[i].name) != NULL, error, "section inventory changed");
+        }
+    }
+    return ok;
+}
+
+bool hp_elf_compare_objects(const HpElf *base, const HpElf *variant, const char *hot_name, uint64_t shift, HpObjectProof *proof, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    error[0] = 0;
+    HpNormalized a = {0};
+    HpNormalized b = {0};
+    HpObjectProof result = {0};
+    const HpSection *hot_a = NULL;
+    const HpSection *hot_b = NULL;
+    bool ok = hp_require(shift <= BUSTER_HP_MAX_SHIFT, error, "invalid shift") && hp_validate_object(base, &a.table, error) && hp_validate_object(variant, &b.table, error);
+    if (ok)
+    {
+        hot_a = hp_elf_section_named(base, hot_name);
+        hot_b = hp_elf_section_named(variant, hot_name);
+        ok = hp_require(memcmp(base->ident, variant->ident, 16) == 0 && base->machine == variant->machine && base->version == variant->version && base->flags == variant->flags, error, "ELF identity changed") && hp_require(hot_a != NULL && hot_b != NULL, error, "missing hot section");
+    }
+    if (ok)
+    {
+        ok = hp_require(hot_a->type == SHT_PROGBITS && hot_b->type == SHT_PROGBITS && (hot_a->flags & 6) == 6 && (hot_b->flags & 6) == 6 && hot_a->align == BUSTER_HP_HOT_ALIGN && hot_b->align == BUSTER_HP_HOT_ALIGN, error, "hot section requires executable allocatable PROGBITS aligned 4096") && hp_require(hot_a->size <= UINT64_MAX - shift && hot_b->size == hot_a->size + shift, error, "hot section size is not translated");
+    }
+    if (ok)
+    {
+        for (uint64_t i = 0; ok && i < shift; i += 1)
+        {
+            ok = hp_require(hot_b->bytes.data[i] == 0, error, "nonzero inserted hot prefix");
+        }
+        HpBytes suffix =
+        {
+            hot_b->bytes.data + shift,
+            hot_b->bytes.size - (size_t)shift
+        };
+        ok = ok && hp_require(hp_bytes_equal(hot_a->bytes, suffix), error, "hot section bytes changed after prefix removal");
+    }
+    if (ok)
+    {
+        result.disclosures = hp_array(base->section_count + 2, sizeof(*result.disclosures), error);
+        const HpSection *comment_a = hp_elf_section_named(base, ".comment");
+        const HpSection *comment_b = hp_elf_section_named(variant, ".comment");
+        ok = result.disclosures != NULL && hp_validate_comment(comment_a, error) && hp_validate_comment(comment_b, error);
+        if (ok && ((comment_a == NULL) != (comment_b == NULL) || (comment_a != NULL && comment_b != NULL && !hp_bytes_equal(comment_a->bytes, comment_b->bytes))))
+        {
+            hp_disclose(&result, BUSTER_HP_DISCLOSURE_COMMENT, comment_a != NULL ? comment_a->index : SIZE_MAX);
+        }
+    }
+    if (ok)
+    {
+        ok = hp_normalize_symbols(base, hot_a->name, 0, &a, error) && hp_normalize_symbols(variant, hot_a->name, shift, &b, error) && hp_require(a.record_count == b.record_count, error, "symbol inventory changed");
+        for (size_t i = 0; ok && i < a.record_count; i += 1)
+        {
+            ok = hp_require(hp_identity_compare(&a.records[i], &b.records[i]) == 0, error, "symbol identity, value, size or binding changed");
+        }
+        bool same_files = a.file_count == b.file_count;
+        for (size_t i = 0; same_files && i < a.file_count; i += 1)
+        {
+            same_files = hp_string_equal(a.files[i], b.files[i]);
+        }
+        if (ok && !same_files)
+        {
+            hp_disclose(&result, BUSTER_HP_DISCLOSURE_FILE_RECORDS, SIZE_MAX);
+        }
+    }
+    if (ok)
+    {
+        ok = hp_normalize_relocations(base, hot_a->name, 0, hot_a->size, &a, error) && hp_normalize_relocations(variant, hot_a->name, shift, hot_a->size, &b, error) && hp_require(base->relocation_count == variant->relocation_count, error, "relocation inventory changed");
+        for (size_t i = 0; ok && i < base->relocation_count; i += 1)
+        {
+            ok = hp_require(hp_relocation_compare(&a.relocations[i], &b.relocations[i]) == 0, error, "normalized relocations changed");
+        }
+    }
+    if (ok)
+    {
+        ok = hp_compare_sections(base, variant, hot_a, &a, &b, &result, error);
+    }
+    hp_normalized_free(&a);
+    hp_normalized_free(&b);
+    if (ok)
+    {
+        result.shift = shift;
+        result.hot_bytes_before = hot_a->size;
+        result.hot_alignment = hot_a->align;
+        result.symbols_compared = base->symbol_count;
+        for (size_t i = 0; i < base->symbol_count; i += 1)
+        {
+            result.symbols_compared -= base->symbols[i].type == STT_FILE;
+        }
+        result.relocations_compared = base->relocation_count;
+        *proof = result;
+    }
+    else
+    {
+        hp_object_proof_free(&result);
+        memset(proof, 0, sizeof(*proof));
+    }
+    return ok;
+}
diff --git a/hp_elf.h b/hp_elf.h
new file mode 100644
index 0000000..29fbc7b
--- /dev/null
+++ b/hp_elf.h
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin.
+#ifndef BUSTER_HP_ELF_H
+#define BUSTER_HP_ELF_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define BUSTER_HP_ERROR_CAPACITY 512
+#define BUSTER_HP_ADDRSIG 0x6fff4c03U
+
+typedef struct HpBytes HpBytes;
+struct HpBytes
+{
+    const unsigned char *data;
+    size_t size;
+};
+
+typedef struct HpString HpString;
+struct HpString
+{
+    const char *data;
+    size_t size;
+};
+
+typedef struct HpSection HpSection;
+struct HpSection
+{
+    uint32_t index;
+    HpString name;
+    uint32_t type;
+    uint64_t flags;
+    uint64_t addr;
+    uint64_t offset;
+    uint64_t size;
+    uint32_t link;
+    uint32_t info;
+    uint64_t align;
+    uint64_t entsize;
+    HpBytes bytes;
+};
+
+typedef struct HpSymbol HpSymbol;
+struct HpSymbol
+{
+    uint32_t table;
+    uint32_t index;
+    HpString name;
+    uint8_t bind;
+    uint8_t type;
+    uint8_t other;
+    uint16_t section;
+    uint64_t value;
+    uint64_t size;
+};
+
+typedef struct HpRelocation HpRelocation;
+struct HpRelocation
+{
+    uint32_t section;
+    uint32_t target_section;
+    uint64_t offset;
+    uint32_t type;
+    size_t symbol;
+    int64_t addend;
+};
+
+typedef struct HpElf HpElf;
+struct HpElf
+{
+    HpBytes input;
+    unsigned char ident[16];
+    uint16_t elf_type;
+    uint16_t machine;
+    uint32_t version;
+    uint64_t entry;
+    uint32_t flags;
+    uint16_t program_count;
+    uint32_t shstr_index;
+    HpSection *sections;
+    size_t section_count;
+    HpSymbol *symbols;
+    size_t symbol_count;
+    HpRelocation *relocations;
+    size_t relocation_count;
+};
+
+typedef enum HpDisclosureKind
+{
+    BUSTER_HP_DISCLOSURE_COMMENT,
+    BUSTER_HP_DISCLOSURE_FILE_RECORDS,
+    BUSTER_HP_DISCLOSURE_NORMALIZED_ENCODING
+} HpDisclosureKind;
+
+typedef struct HpDisclosure HpDisclosure;
+struct HpDisclosure
+{
+    HpDisclosureKind kind;
+    // SIZE_MAX denotes presence differences without an owning base section.
+    size_t section;
+};
+
+typedef struct HpObjectProof HpObjectProof;
+struct HpObjectProof
+{
+    uint64_t shift;
+    uint64_t hot_bytes_before;
+    uint64_t hot_alignment;
+    size_t symbols_compared;
+    size_t relocations_compared;
+    HpDisclosure *disclosures;
+    size_t disclosure_count;
+};
+
+// Input bytes remain caller owned and must outlive the reader and proof records.
+// Output must be zero initialized. Failures leave it empty and set error.
+// Free metadata with hp_elf_free, and proof disclosures with hp_object_proof_free.
+// No executable instructions or external tools are invoked by this module.
+// The reader accepts file-backed metadata for REL/EXEC/DYN; comparison requires
+// successful, unmodified reader outputs and supports ET_REL only. Final-image
+// address ranges, program loading and resolved relocation values are separate
+// gates. Unknown/group/compressed/REL/TLSDESC semantics fail object comparison.
+bool hp_elf_read(HpBytes input, HpElf *output, char error[BUSTER_HP_ERROR_CAPACITY]);
+void hp_elf_free(HpElf *elf);
+const HpSection *hp_elf_section_named(const HpElf *elf, const char *name);
+bool hp_string_equal(HpString a, HpString b);
+bool hp_string_is(HpString value, const char *text);
+unsigned hp_elf_relocation_width(uint32_t type);
+bool hp_elf_compare_objects(const HpElf *base, const HpElf *variant, const char *hot_name, uint64_t shift, HpObjectProof *proof, char error[BUSTER_HP_ERROR_CAPACITY]);
+void hp_object_proof_free(HpObjectProof *proof);
+
+#endif
diff --git a/hp_linked.c b/hp_linked.c
new file mode 100644
index 0000000..bc3a530
--- /dev/null
+++ b/hp_linked.c
@@ -0,0 +1,466 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin.
+// hp_linked_compare binds every selected-object hot function to unique final
+// metadata, proves one translated contribution, and compares all linked bytes
+// outside known relocation operands. It never invokes or executes an image.
+#include "hp_linked.h"
+
+#include <elf.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct HpLinkedIndex HpLinkedIndex;
+struct HpLinkedIndex
+{
+    const HpSymbol **symbols;
+    size_t count;
+};
+
+static bool hp_linked_error(char error[BUSTER_HP_ERROR_CAPACITY], const char *message)
+{
+    if (error != NULL)
+    {
+        snprintf(error, BUSTER_HP_ERROR_CAPACITY, "%s", message);
+    }
+    return false;
+}
+
+static bool hp_linked_address_range(uint64_t address, uint64_t size)
+{
+    // An interval may end exactly one past UINT64_MAX; subtraction validates
+    // its last byte without overflowing the exclusive endpoint.
+    return size == 0 || size - 1 <= UINT64_MAX - address;
+}
+
+static int hp_linked_name_compare(HpString a, HpString b)
+{
+    size_t common = a.size < b.size ? a.size : b.size;
+    int result = common != 0 ? memcmp(a.data, b.data, common) : 0;
+    if (result == 0)
+    {
+        result = (a.size > b.size) - (a.size < b.size);
+    }
+    return result;
+}
+
+static int hp_linked_symbol_compare(const HpSymbol *a, const HpSymbol *b)
+{
+    int result = hp_linked_name_compare(a->name, b->name);
+    if (result == 0)
+    {
+        result = (a->type > b->type) - (a->type < b->type);
+    }
+    if (result == 0)
+    {
+        result = (a->bind > b->bind) - (a->bind < b->bind);
+    }
+    if (result == 0)
+    {
+        result = (a->other > b->other) - (a->other < b->other);
+    }
+    if (result == 0)
+    {
+        result = (a->size > b->size) - (a->size < b->size);
+    }
+    return result;
+}
+
+static int hp_linked_index_compare(const void *left, const void *right)
+{
+    const HpSymbol *const *a = left;
+    const HpSymbol *const *b = right;
+    return hp_linked_symbol_compare(*a, *b);
+}
+
+static bool hp_linked_index(const HpElf *elf, HpLinkedIndex *index, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool valid = elf->symbol_count <= SIZE_MAX / sizeof(*index->symbols);
+    if (valid && elf->symbol_count != 0)
+    {
+        index->symbols = calloc(elf->symbol_count, sizeof(*index->symbols));
+        valid = index->symbols != NULL;
+    }
+    if (!valid)
+    {
+        valid = hp_linked_error(error, "final symbol index allocation failed");
+    }
+    for (size_t item = 0; valid && item < elf->symbol_count; item += 1)
+    {
+        const HpSymbol *symbol = elf->symbols + item;
+        if (symbol->table >= elf->section_count)
+        {
+            valid = hp_linked_error(error, "final symbol has invalid table ownership");
+        }
+        else if (elf->sections[symbol->table].type == SHT_SYMTAB && symbol->section > 0 && symbol->section < elf->section_count)
+        {
+            index->symbols[index->count++] = symbol;
+        }
+    }
+    if (valid && index->count > 1)
+    {
+        qsort(index->symbols, index->count, sizeof(*index->symbols), hp_linked_index_compare);
+    }
+    return valid;
+}
+
+static const HpSymbol *hp_linked_find(const HpLinkedIndex *index, const HpSymbol *member)
+{
+    size_t low = 0;
+    size_t high = index->count;
+    while (low < high)
+    {
+        size_t middle = low + (high - low) / 2;
+        if (hp_linked_symbol_compare(index->symbols[middle], member) < 0)
+        {
+            low = middle + 1;
+        }
+        else
+        {
+            high = middle;
+        }
+    }
+    const HpSymbol *result = NULL;
+    if (low < index->count && hp_linked_symbol_compare(index->symbols[low], member) == 0 && (low + 1 == index->count || hp_linked_symbol_compare(index->symbols[low + 1], member) != 0))
+    {
+        result = index->symbols[low];
+    }
+    return result;
+}
+
+static bool hp_linked_symbol_extent(const HpElf *elf, const HpSymbol *symbol)
+{
+    bool valid = symbol->section > 0 && symbol->section < elf->section_count;
+    if (valid)
+    {
+        const HpSection *section = elf->sections + symbol->section;
+        valid = (section->flags & (SHF_ALLOC | SHF_EXECINSTR)) == (SHF_ALLOC | SHF_EXECINSTR) && symbol->value >= section->addr;
+        if (valid)
+        {
+            uint64_t offset = symbol->value - section->addr;
+            valid = offset <= section->size && symbol->size <= section->size - offset && hp_linked_address_range(symbol->value, symbol->size);
+        }
+    }
+    return valid;
+}
+
+static const HpSection *hp_linked_image_range(const HpElf *elf, uint64_t address, uint64_t size, HpBytes *bytes)
+{
+    const HpSection *result = NULL;
+    size_t count = 0;
+    for (size_t index = 0; index < elf->section_count; index += 1)
+    {
+        const HpSection *section = elf->sections + index;
+        if (section->type == SHT_PROGBITS && (section->flags & (SHF_ALLOC | SHF_EXECINSTR)) == (SHF_ALLOC | SHF_EXECINSTR) && section->addr <= address)
+        {
+            uint64_t offset = address - section->addr;
+            if (offset <= section->size && size <= section->size - offset && offset <= section->bytes.size && size <= section->bytes.size - (size_t)offset)
+            {
+                count += 1;
+                result = section;
+                bytes->data = section->bytes.data + (size_t)offset;
+                bytes->size = (size_t)size;
+            }
+        }
+    }
+    if (count != 1)
+    {
+        result = NULL;
+        memset(bytes, 0, sizeof(*bytes));
+    }
+    return result;
+}
+
+static int hp_linked_operand_compare(const void *left, const void *right)
+{
+    const HpLinkedOperand *a = left;
+    const HpLinkedOperand *b = right;
+    int result = (a->offset > b->offset) - (a->offset < b->offset);
+    if (result == 0)
+    {
+        result = (a->type > b->type) - (a->type < b->type);
+    }
+    return result;
+}
+
+void hp_linked_proof_free(HpLinkedProof *proof)
+{
+    if (proof != NULL)
+    {
+        free(proof->functions);
+        free(proof->operands);
+        memset(proof, 0, sizeof(*proof));
+    }
+    return;
+}
+
+bool hp_linked_compare(const HpElf *original_object, const HpElf *normal, const HpElf *variant, uint64_t shift, const char *const *required, size_t required_count, HpLinkedProof *proof, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool valid = original_object != NULL && normal != NULL && variant != NULL && proof != NULL && error != NULL && (required_count == 0 || required != NULL);
+    HpLinkedProof result = { 0 };
+    HpLinkedIndex normal_index = { 0 };
+    HpLinkedIndex variant_index = { 0 };
+    if (proof != NULL)
+    {
+        memset(proof, 0, sizeof(*proof));
+    }
+    if (error != NULL)
+    {
+        error[0] = 0;
+    }
+    if (!valid)
+    {
+        valid = hp_linked_error(error, "missing ELF, required-name or proof storage");
+    }
+    if (valid && (original_object->elf_type != ET_REL || normal->elf_type != ET_EXEC || variant->elf_type != ET_EXEC))
+    {
+        valid = hp_linked_error(error, "requires REL input and non-PIE EXEC images");
+    }
+    if (valid && shift != 0 && shift != 16 && shift != 64 && shift != 256 && shift != 1024 && shift != 2048)
+    {
+        valid = hp_linked_error(error, "unapproved hot shift");
+    }
+    const HpElf *images[2] =
+    {
+        normal,
+        variant
+    };
+    for (size_t image = 0; valid && image < 2; image += 1)
+    {
+        for (size_t index = 0; valid && index < images[image]->section_count; index += 1)
+        {
+            const HpSection *section = images[image]->sections + index;
+            if ((section->flags & SHF_ALLOC) != 0 && !hp_linked_address_range(section->addr, section->size))
+            {
+                valid = hp_linked_error(error, "allocated section exceeds ELF64 address range");
+            }
+        }
+    }
+    const HpSection *hot = valid ? hp_elf_section_named(original_object, ".text.buster_checker") : NULL;
+    if (valid && (hot == NULL || hot->type != SHT_PROGBITS || hot->align != 4096 || (hot->flags & (SHF_ALLOC | SHF_EXECINSTR)) != (SHF_ALLOC | SHF_EXECINSTR) || hot->size == 0 || hot->size > UINT64_MAX - shift))
+    {
+        valid = hp_linked_error(error, "hot object section is missing or not file-backed executable/page-aligned content");
+    }
+    size_t member_count = 0;
+    for (size_t index = 0; valid && index < original_object->symbol_count; index += 1)
+    {
+        const HpSymbol *symbol = original_object->symbols + index;
+        if (symbol->section == hot->index && symbol->type == STT_FUNC)
+        {
+            if (symbol->name.size == 0 || symbol->value > hot->size || symbol->size > hot->size - symbol->value)
+            {
+                valid = hp_linked_error(error, "unnamed or out-of-range owned hot function");
+            }
+            member_count += 1;
+        }
+    }
+    if (valid && (member_count == 0 || member_count > SIZE_MAX / sizeof(*result.functions)))
+    {
+        valid = hp_linked_error(error, "missing or excessive owned hot membership");
+    }
+    if (valid)
+    {
+        result.functions = calloc(member_count, sizeof(*result.functions));
+        valid = result.functions != NULL;
+        if (!valid)
+        {
+            valid = hp_linked_error(error, "owned function allocation failed");
+        }
+    }
+    const char *mandatory[] =
+    {
+        "check_program_emit",
+        "check_lower_drain",
+        "check_lower_batch_classify"
+    };
+    for (size_t set = 0; valid && set < 2; set += 1)
+    {
+        const char *const *names = set == 0 ? mandatory : required;
+        size_t name_count = set == 0 ? sizeof(mandatory) / sizeof(mandatory[0]) : required_count;
+        for (size_t name = 0; valid && name < name_count; name += 1)
+        {
+            bool found = false;
+            for (size_t index = 0; names[name] != NULL && index < original_object->symbol_count; index += 1)
+            {
+                const HpSymbol *symbol = original_object->symbols + index;
+                found = found || (symbol->section == hot->index && symbol->type == STT_FUNC && hp_string_is(symbol->name, names[name]));
+            }
+            if (!found)
+            {
+                valid = hp_linked_error(error, "required function is not owned by selected hot section");
+            }
+        }
+    }
+    if (valid)
+    {
+        valid = hp_linked_index(normal, &normal_index, error) && hp_linked_index(variant, &variant_index, error);
+    }
+    uint64_t base = 0;
+    for (size_t index = 0; valid && index < original_object->symbol_count; index += 1)
+    {
+        const HpSymbol *member = original_object->symbols + index;
+        if (member->section == hot->index && member->type == STT_FUNC)
+        {
+            for (size_t previous = 0; valid && previous < result.function_count; previous += 1)
+            {
+                if (hp_string_equal(result.functions[previous].name, member->name))
+                {
+                    valid = hp_linked_error(error, "ambiguous owned hot function name");
+                }
+            }
+            const HpSymbol *a = valid ? hp_linked_find(&normal_index, member) : NULL;
+            const HpSymbol *b = valid ? hp_linked_find(&variant_index, member) : NULL;
+            if (valid && (a == NULL || b == NULL || !hp_linked_symbol_extent(normal, a) || !hp_linked_symbol_extent(variant, b)))
+            {
+                valid = hp_linked_error(error, "missing, ambiguous or invalid final hot function extent");
+            }
+            if (valid && (b->value < a->value || b->value - a->value != shift || a->value < member->value || b->value < member->value || b->value - member->value < shift))
+            {
+                valid = hp_linked_error(error, "wrong final hot delta or contribution underflow");
+            }
+            if (valid)
+            {
+                uint64_t normal_base = a->value - member->value;
+                uint64_t variant_base = b->value - member->value - shift;
+                if (result.function_count == 0)
+                {
+                    base = normal_base;
+                }
+                if (base != normal_base || base != variant_base)
+                {
+                    valid = hp_linked_error(error, "owned functions are not one translated contribution");
+                }
+                if (valid)
+                {
+                    HpLinkedFunction record =
+                    {
+                        .name = member->name,
+                        .object_symbol = index,
+                        .object_offset = member->value,
+                        .size = member->size,
+                        .normal_address = a->value,
+                        .variant_address = b->value,
+                        .delta = b->value - a->value,
+                        .normal_residue_4096 = a->value % 4096,
+                        .variant_residue_4096 = b->value % 4096
+                    };
+                    result.functions[result.function_count++] = record;
+                }
+            }
+        }
+    }
+    if (valid && (base % 4096 != 0 || !hp_linked_address_range(base, hot->size + shift)))
+    {
+        valid = hp_linked_error(error, "linked hot contribution lost page alignment or address bounds");
+    }
+    HpBytes normal_bytes = { 0 };
+    HpBytes variant_bytes = { 0 };
+    const HpSection *normal_section = valid ? hp_linked_image_range(normal, base, hot->size, &normal_bytes) : NULL;
+    const HpSection *variant_section = valid ? hp_linked_image_range(variant, base, hot->size + shift, &variant_bytes) : NULL;
+    if (valid && (normal_section == NULL || variant_section == NULL))
+    {
+        valid = hp_linked_error(error, "hot contribution is not one file-backed executable range");
+    }
+    for (size_t index = 0; valid && index < result.function_count; index += 1)
+    {
+        const HpSymbol *member = original_object->symbols + result.functions[index].object_symbol;
+        const HpSymbol *a = hp_linked_find(&normal_index, member);
+        const HpSymbol *b = hp_linked_find(&variant_index, member);
+        if (a->section != normal_section->index || b->section != variant_section->index)
+        {
+            valid = hp_linked_error(error, "owned function belongs to a different final contribution section");
+        }
+    }
+    for (uint64_t index = 0; valid && index < shift; index += 1)
+    {
+        if (variant_bytes.data[(size_t)index] != 0)
+        {
+            valid = hp_linked_error(error, "inside padding was dropped or changed in final image");
+        }
+    }
+    size_t operand_count = 0;
+    for (size_t index = 0; valid && index < original_object->relocation_count; index += 1)
+    {
+        operand_count += original_object->relocations[index].target_section == hot->index;
+    }
+    if (valid && operand_count > SIZE_MAX / sizeof(*result.operands))
+    {
+        valid = hp_linked_error(error, "excessive hot relocation operands");
+    }
+    if (valid && operand_count != 0)
+    {
+        result.operands = calloc(operand_count, sizeof(*result.operands));
+        if (result.operands == NULL)
+        {
+            valid = hp_linked_error(error, "hot operand allocation failed");
+        }
+    }
+    for (size_t index = 0; valid && index < original_object->relocation_count; index += 1)
+    {
+        const HpRelocation *relocation = original_object->relocations + index;
+        if (relocation->target_section == hot->index)
+        {
+            unsigned width = hp_elf_relocation_width(relocation->type);
+            if (width == 0 || relocation->offset > hot->size || width > hot->size - relocation->offset)
+            {
+                valid = hp_linked_error(error, "unknown or out-of-range hot relocation operand");
+            }
+            else
+            {
+                HpLinkedOperand operand =
+                {
+                    .object_relocation = index,
+                    .offset = relocation->offset,
+                    .type = relocation->type,
+                    .width = width
+                };
+                result.operands[result.operand_count++] = operand;
+            }
+        }
+    }
+    if (valid && result.operand_count > 1)
+    {
+        qsort(result.operands, result.operand_count, sizeof(*result.operands), hp_linked_operand_compare);
+    }
+    uint64_t cursor = 0;
+    for (size_t index = 0; valid && index < result.operand_count; index += 1)
+    {
+        const HpLinkedOperand *operand = result.operands + index;
+        if (operand->offset < cursor)
+        {
+            valid = hp_linked_error(error, "overlapping hot relocation operands");
+        }
+        else
+        {
+            size_t size = (size_t)(operand->offset - cursor);
+            valid = memcmp(normal_bytes.data + (size_t)cursor, variant_bytes.data + (size_t)(shift + cursor), size) == 0;
+            cursor = operand->offset + operand->width;
+            result.masked_operand_bytes += operand->width;
+            if (!valid)
+            {
+                valid = hp_linked_error(error, "linked hot bytes changed outside relocation operands");
+            }
+        }
+    }
+    if (valid && memcmp(normal_bytes.data + (size_t)cursor, variant_bytes.data + (size_t)(shift + cursor), (size_t)(hot->size - cursor)) != 0)
+    {
+        valid = hp_linked_error(error, "linked hot suffix changed outside relocation operands");
+    }
+    if (valid)
+    {
+        result.shift = shift;
+        result.hot_input_base = base;
+        result.hot_bytes = hot->size;
+        result.hot_alignment = hot->align;
+        result.normal_output_section = normal_section->name;
+        result.variant_output_section = variant_section->name;
+        *proof = result;
+    }
+    else
+    {
+        hp_linked_proof_free(&result);
+    }
+    free(normal_index.symbols);
+    free(variant_index.symbols);
+    return valid;
+}
diff --git a/hp_linked.h b/hp_linked.h
new file mode 100644
index 0000000..98bd6f7
--- /dev/null
+++ b/hp_linked.h
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin.
+#ifndef BUSTER_HP_LINKED_H
+#define BUSTER_HP_LINKED_H
+
+#include "hp_elf.h"
+
+typedef struct HpLinkedFunction HpLinkedFunction;
+struct HpLinkedFunction
+{
+    HpString name;
+    size_t object_symbol;
+    uint64_t object_offset;
+    uint64_t size;
+    uint64_t normal_address;
+    uint64_t variant_address;
+    uint64_t delta;
+    uint64_t normal_residue_4096;
+    uint64_t variant_residue_4096;
+};
+
+typedef struct HpLinkedOperand HpLinkedOperand;
+struct HpLinkedOperand
+{
+    size_t object_relocation;
+    uint64_t offset;
+    uint32_t type;
+    unsigned width;
+};
+
+typedef struct HpLinkedProof HpLinkedProof;
+struct HpLinkedProof
+{
+    uint64_t shift;
+    uint64_t hot_input_base;
+    uint64_t hot_bytes;
+    uint64_t hot_alignment;
+    HpString normal_output_section;
+    HpString variant_output_section;
+    HpLinkedFunction *functions;
+    size_t function_count;
+    HpLinkedOperand *operands;
+    size_t operand_count;
+    uint64_t masked_operand_bytes;
+};
+
+// All inputs must be successful, unmodified hp_elf_read outputs. Input buffers
+// must outlive the borrowed names in proof. Output must be zero initialized.
+// Failure clears output; free only its owned arrays with hp_linked_proof_free.
+// This attests section-header geometry and linked nonrelocation bytes, NOT
+// PT_LOAD/runtime semantics or numeric resolved operand values. Separate object
+// relocation proof, pinned linker/input order, normal/zero full SHA identity
+// and per-image output preservation controls remain required before timing.
+bool hp_linked_compare(const HpElf *original_object, const HpElf *normal, const HpElf *variant, uint64_t shift, const char *const *required, size_t required_count, HpLinkedProof *proof, char error[BUSTER_HP_ERROR_CAPACITY]);
+void hp_linked_proof_free(HpLinkedProof *proof);
+
+#endif
diff --git a/hp_method.c b/hp_method.c
new file mode 100644
index 0000000..b596ebe
--- /dev/null
+++ b/hp_method.c
@@ -0,0 +1,819 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin.
+// Prepared diagnostic derivative. It never runs a produced compiler or timings.
+#define _GNU_SOURCE
+#include "hp_common.h"
+#include "hp_driver.h"
+#include "hp_linked.h"
+#include "hp_pad.h"
+#include "hp_plan.h"
+#include "hp_receipt.h"
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <sched.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define BUSTER_HP_CLANG_SHA "c336d48383874cffaab0dc4c5c359456d871f21380b746520dde5c7f4c125a67"
+#define BUSTER_HP_LICENSE_SHA "8d85c1057d742e597985c7d4e6320b015a9139385cff4cbae06ffc0ebe89afee"
+#define BUSTER_HP_WILD_SHA "8446253a800c27c5312e85fc95288ddc1b965a7f2f6b5805255eb8323daf9c51"
+#define BUSTER_HP_HOT ".text.buster_checker"
+
+typedef struct HpMethod HpMethod;
+struct HpMethod
+{
+    char tree[BUSTER_HP_PATH_CAPACITY];
+    char root[BUSTER_HP_PATH_CAPACITY];
+    char tc[BUSTER_HP_PATH_CAPACITY];
+    char cc[BUSTER_HP_PATH_CAPACITY];
+    char manifest[BUSTER_HP_PATH_CAPACITY];
+    char manifest_sha[65];
+    char normal_sha[65];
+    HpArguments flags;
+    HpArguments sources;
+    HpArguments objects;
+    HpSourcePlan plan;
+    HpDriverIsa c_isa;
+    bool fragment;
+};
+
+static bool method_digest(const char* value)
+{
+    bool result = value != NULL && strlen(value) == 64;
+    for (size_t i = 0; result && i < 64; ++i)
+    {
+        result = (value[i] >= '0' && value[i] <= '9') || (value[i] >= 'a' && value[i] <= 'f');
+    }
+    return result;
+}
+
+static bool method_canonical(const char* input, char output[BUSTER_HP_PATH_CAPACITY], char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool result = input != NULL && input[0] == '/' && realpath(input, output) != NULL;
+    if (!result)
+    {
+        hp_error(error, "absolute existing canonical path required: %s", input != NULL ? input : "(null)");
+    }
+    return result;
+}
+
+static bool method_new_path(const char* input, char output[BUSTER_HP_PATH_CAPACITY], char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    char parent[BUSTER_HP_PATH_CAPACITY] = {0};
+    char canonical[BUSTER_HP_PATH_CAPACITY] = {0};
+    bool result = input != NULL && input[0] == '/' && strlen(input) < sizeof(parent);
+    if (result)
+    {
+        strcpy(parent, input);
+        char* slash = strrchr(parent, '/');
+        result = slash != NULL && slash[1] != '\0' && strcmp(slash + 1, ".") != 0 && strcmp(slash + 1, "..") != 0;
+        if (result)
+        {
+            char name[BUSTER_HP_PATH_CAPACITY] = {0};
+            strcpy(name, slash + 1);
+            slash[1] = '\0';
+            result = method_canonical(parent, canonical, error) && hp_join_path(output, canonical, name, error);
+        }
+    }
+    if (!result && error[0] == '\0')
+    {
+        hp_error(error, "fresh absolute output with an existing parent required");
+    }
+    return result;
+}
+
+static bool method_hash(const char* path, const char* expected, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    char digest[65] = {0};
+    bool result = method_digest(expected) && hp_sha256_file(path, digest, error);
+    if (result && strcmp(digest, expected) != 0)
+    {
+        result = hp_error(error, "SHA256 mismatch: %s", path);
+    }
+    return result;
+}
+
+static bool method_path(char output[BUSTER_HP_PATH_CAPACITY], const HpMethod* method, const char* name, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    return hp_join_path(output, method->root, name, error);
+}
+
+static bool method_identity(HpMethod* method, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    char license[BUSTER_HP_PATH_CAPACITY] = {0};
+    const char* held = getenv("BUSTER_9700X_HELD");
+    bool result = held != NULL && strcmp(held, "1") == 0;
+    if (!result)
+    {
+        hp_error(error, "requires inherited existing shared-host lock; never set HELD manually");
+    }
+    if (result)
+    {
+        result = hp_join_path(method->cc, method->tc, "bin/clang", error) &&
+            hp_join_path(license, method->tc, "LICENSE.TXT", error) &&
+            method_hash(method->cc, BUSTER_HP_CLANG_SHA, error) &&
+            method_hash(license, BUSTER_HP_LICENSE_SHA, error) &&
+            method_hash("/usr/bin/wild", BUSTER_HP_WILD_SHA, error) &&
+            hp_prepare_environment(method->tc, error);
+    }
+    return result;
+}
+
+static bool method_load_arguments(const char* path, HpArguments* arguments, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    HpBuffer bytes = {0};
+    bool result = hp_read_file(path, 1024 * 1024, &bytes, error) &&
+        hp_arguments_read((HpBytes){bytes.data, bytes.size}, arguments, error);
+    hp_buffer_free(&bytes);
+    return result;
+}
+
+static bool method_copy(const char* from, const char* to, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    HpBuffer bytes = {0};
+    bool result = hp_read_file(from, BUSTER_HP_FILE_LIMIT, &bytes, error) &&
+        hp_write_file(to, (HpBytes){bytes.data, bytes.size}, error);
+    hp_buffer_free(&bytes);
+    return result;
+}
+
+static bool method_run(const HpPlanArguments* argv, const char* cwd, const char* stem, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    int status = -1;
+    bool result = hp_run(argv->values, cwd, stem, true, &status, error);
+    return result;
+}
+
+static bool method_driver(const HpPlanArguments* argv, const char* mode, const HpMethod* method, const char* stem, HpDriverIsa* isa, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    HpPlanArguments receipt = {0};
+    HpBuffer log = {0};
+    char path[BUSTER_HP_PATH_CAPACITY] = {0};
+    char actual[BUSTER_HP_PATH_CAPACITY] = {0};
+    char expected[BUSTER_HP_PATH_CAPACITY] = {0};
+    bool result = argv->count + 1 < BUSTER_HP_ARGUMENT_LIMIT;
+    if (result)
+    {
+        receipt.values[0] = argv->values[0];
+        receipt.values[1] = "-###";
+        for (size_t i = 1; i < argv->count; ++i)
+        {
+            receipt.values[i + 1] = argv->values[i];
+        }
+        receipt.count = argv->count + 1;
+        result = method_run(&receipt, method->tree, stem, error);
+    }
+    if (result && mode != NULL)
+    {
+        int length = snprintf(path, sizeof(path), "%s.stderr", stem);
+        result = length > 0 && (size_t)length < sizeof(path) &&
+            hp_read_file(path, BUSTER_HP_DRIVER_LOG_LIMIT, &log, error) &&
+            hp_driver_isa((HpBytes){log.data, log.size}, mode, isa, error) &&
+            method_canonical(isa->executable, actual, error) && method_canonical(method->cc, expected, error);
+        if (result && strcmp(actual, expected) != 0)
+        {
+            result = hp_error(error, "effective internal driver is not pinned Clang");
+        }
+    }
+    if (!result && error[0] == '\0')
+    {
+        hp_error(error, "effective-driver receipt failed");
+    }
+    hp_buffer_free(&log);
+    return result;
+}
+
+static bool method_default(const HpMethod* method, const char* stem, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    HpPlanArguments argv = {0};
+    HpBuffer bytes = {0};
+    char path[BUSTER_HP_PATH_CAPACITY] = {0};
+    argv.values[0] = method->cc;
+    argv.values[1] = "-dumpmachine";
+    argv.count = 2;
+    int length = snprintf(path, sizeof(path), "%s.stdout", stem);
