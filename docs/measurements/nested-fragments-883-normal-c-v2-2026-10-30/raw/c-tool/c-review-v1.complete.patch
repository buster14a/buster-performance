+_Static_assert(sizeof(Elf64_Ehdr) == 64, "ELF64 header layout");
+_Static_assert(sizeof(Elf64_Shdr) == 64, "ELF64 section layout");
+_Static_assert(sizeof(Elf64_Sym) == 24, "ELF64 symbol layout");
