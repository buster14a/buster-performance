+static bool plan_zero(const void *data, size_t size)
+{
+    const unsigned char *bytes = data;
+    bool valid = true;
+    for (size_t index = 0; valid && index < size; index += 1)
+    {
+        valid = bytes[index] == 0;
+    }
+    return valid;
+}
