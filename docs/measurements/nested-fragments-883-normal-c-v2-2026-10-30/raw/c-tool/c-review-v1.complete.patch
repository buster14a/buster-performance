+static int hp_open_capture(const char* path)
+{
+    int descriptor = open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+    int result = descriptor;
+    if (descriptor >= 0 && descriptor < 3)
+    {
+        result = fcntl(descriptor, F_DUPFD_CLOEXEC, 3);
+        close(descriptor);
+    }
+    return result;
+}
