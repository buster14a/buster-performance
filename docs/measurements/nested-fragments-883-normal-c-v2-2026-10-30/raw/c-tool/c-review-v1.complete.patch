+bool hp_write_file(const char* path, HpBytes bytes, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool valid = bytes.size <= BUSTER_HP_FILE_LIMIT && (bytes.size == 0 || bytes.data != NULL);
