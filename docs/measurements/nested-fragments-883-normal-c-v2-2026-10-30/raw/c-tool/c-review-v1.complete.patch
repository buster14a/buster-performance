+            passed = strcmp(slash != NULL ? slash + 1 : source, "main_unit_checker.c") == 0 && error[0] == 0;
+        }
+    }
+    else
+    {
+        passed = passed && plan_zero(&output, sizeof(output)) && error[0] != 0;
+    }
+    plan_record(suite, name, passed, error);
+    return;
+}
