diff --git a/hp_driver.c b/hp_driver.c
new file mode 100644
index 0000000..5f3de7f
--- /dev/null
+++ b/hp_driver.c
@@ -0,0 +1,309 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin.
+// First-party parser for saved, quoted Clang driver receipts. It never invokes
+// a producer or evaluates shell syntax. hp_driver_isa owns decoded features;
+// hp_driver_equal deliberately compares the ordered vector without attempting
+// to infer target-feature defaults or collapse repeated options. The selected
+// executable's canonical identity and all process statuses are caller gates.
+#include "hp_driver.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+static bool hp_driver_space(unsigned char byte)
+{
+    return byte == ' ' || byte == '\t';
+}
+
+static bool hp_driver_prefix(HpBytes line, const char *prefix)
+{
+    size_t size = strlen(prefix);
+    return line.size >= size && memcmp(line.data, prefix, size) == 0;
+}
+
+static bool hp_driver_line_is(HpBytes line, const char *text)
+{
+    size_t size = strlen(text);
+    return line.size == size && memcmp(line.data, text, size) == 0;
+}
+
+static bool hp_driver_header(HpBytes line, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    static const char version[] = "clang version 23.1.4";
+    static const char *const prefixes[] =
+    {
+        "InstalledDir: ",
+        "Build config: ",
+        "Found candidate GCC installation: ",
+        "Selected GCC installation: ",
+        "Candidate multilib: ",
+        "Selected multilib: "
+    };
+    bool valid = hp_driver_line_is(line, "Target: " BUSTER_HP_DRIVER_TARGET) || hp_driver_line_is(line, "Thread model: posix") || hp_driver_line_is(line, "(in-process)");
+    if (hp_driver_prefix(line, version))
+    {
+        valid = line.size == sizeof(version) - 1 || line.data[sizeof(version) - 1] == ' ' || line.data[sizeof(version) - 1] == '(';
+    }
+    for (size_t i = 0; !valid && i < sizeof(prefixes) / sizeof(prefixes[0]); i += 1)
+    {
+        size_t prefix_size = strlen(prefixes[i]);
+        valid = line.size > prefix_size && hp_driver_prefix(line, prefixes[i]);
+    }
+    if (!valid)
+    {
+        hp_error(error, "unknown or mismatched Clang receipt header");
+    }
+    return valid;
+}
+
+static bool hp_driver_command(HpBytes line, HpArguments *output, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    HpArguments command = {0};
+    command.storage = malloc(line.size + 1);
+    command.values = calloc(BUSTER_HP_ARGUMENT_LIMIT + 1, sizeof(*command.values));
+    bool valid = command.storage != NULL && command.values != NULL;
+    size_t position = 0;
+    size_t used = 0;
+    while (valid && position < line.size)
+    {
+        while (position < line.size && hp_driver_space(line.data[position]))
+        {
+            position += 1;
+        }
+        if (position < line.size)
+        {
+            valid = line.data[position] == '"' && command.count < BUSTER_HP_ARGUMENT_LIMIT;
+            if (valid)
+            {
+                position += 1;
+                size_t start = used;
+                command.values[command.count++] = command.storage + used;
+                bool closed = false;
+                while (valid && !closed)
+                {
+                    valid = position < line.size;
+                    if (valid)
+                    {
+                        unsigned char byte = line.data[position++];
+                        if (byte == '"')
+                        {
+                            closed = true;
+                        }
+                        else
+                        {
+                            if (byte == '\\')
+                            {
+                                valid = position < line.size && (line.data[position] == '\\' || line.data[position] == '"');
+                                if (valid)
+                                {
+                                    byte = line.data[position++];
+                                }
+                            }
+                            valid = valid && byte >= 32 && byte != 127 && used - start < BUSTER_HP_PATH_CAPACITY - 1;
+                            if (valid)
+                            {
+                                command.storage[used++] = (char)byte;
+                            }
+                        }
+                    }
+                }
+                if (valid)
+                {
+                    command.storage[used++] = 0;
+                    valid = position == line.size || hp_driver_space(line.data[position]);
+                }
+            }
+        }
+    }
+    valid = valid && command.count >= 2;
+    if (valid)
+    {
+        *output = command;
+    }
+    else
+    {
+        hp_arguments_free(&command);
+        hp_error(error, "malformed, unsupported or oversized quoted driver command");
+    }
+    return valid;
+}
+
+static bool hp_driver_feature(const char *value)
+{
+    bool valid = (value[0] == '+' || value[0] == '-') && value[1] != 0;
+    for (size_t i = 1; valid && value[i] != 0; i += 1)
+    {
+        unsigned char byte = (unsigned char)value[i];
+        valid = (byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') || (byte >= '0' && byte <= '9') || byte == '_' || byte == '-' || byte == '.';
+    }
+    valid = valid && strcmp(value, "-target-feature") != 0 && strcmp(value, "-target-cpu") != 0 && strcmp(value, "-triple") != 0 && strcmp(value, "-cc1") != 0 && strcmp(value, "-cc1as") != 0;
+    return valid;
+}
+
+static bool hp_driver_extract(const HpArguments *command, const char *mode, HpDriverIsa *isa, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool valid = command->count >= 2 && command->values[0][0] == '/' && strcmp(command->values[1], mode) == 0;
+    size_t modes = 0;
+    size_t triples = 0;
+    size_t cpus = 0;
+    size_t features = 0;
+    size_t feature_bytes = 0;
+    for (size_t i = 1; valid && i < command->count; i += 1)
+    {
+        const char *value = command->values[i];
+        modes += strcmp(value, "-cc1") == 0 || strcmp(value, "-cc1as") == 0;
+        if (strcmp(value, "-triple") == 0)
+        {
+            triples += 1;
+            valid = i + 1 < command->count && strcmp(command->values[i + 1], BUSTER_HP_DRIVER_TARGET) == 0;
+        }
+        else if (strcmp(value, "-target-cpu") == 0)
+        {
+            cpus += 1;
+            valid = i + 1 < command->count && strcmp(command->values[i + 1], BUSTER_HP_DRIVER_CPU) == 0;
+        }
+        else if (strcmp(value, "-target-feature") == 0)
+        {
+            valid = i + 1 < command->count && hp_driver_feature(command->values[i + 1]);
+            if (valid)
+            {
+                size_t size = strlen(command->values[i + 1]) + 1;
+                valid = size <= BUSTER_HP_DRIVER_LOG_LIMIT - feature_bytes;
+                if (valid)
+                {
+                    features += 1;
+                    feature_bytes += size;
+                }
+            }
+        }
+    }
+    valid = valid && modes == 1 && triples == 1 && cpus == 1;
+    if (valid)
+    {
+        isa->features.storage = malloc(feature_bytes != 0 ? feature_bytes : 1);
+        isa->features.values = calloc(features + 1, sizeof(*isa->features.values));
+        valid = isa->features.storage != NULL && isa->features.values != NULL;
+    }
+    if (valid)
+    {
+        size_t used = 0;
+        for (size_t i = 1; i < command->count; i += 1)
+        {
+            if (strcmp(command->values[i], "-target-feature") == 0)
+            {
+                size_t size = strlen(command->values[i + 1]) + 1;
+                isa->features.values[isa->features.count++] = isa->features.storage + used;
+                memcpy(isa->features.storage + used, command->values[i + 1], size);
+                used += size;
+            }
+        }
+        isa->features.storage[used != 0 ? used - 1 : 0] = 0;
+        memcpy(isa->executable, command->values[0], strlen(command->values[0]) + 1);
+        memcpy(isa->triple, BUSTER_HP_DRIVER_TARGET, sizeof(BUSTER_HP_DRIVER_TARGET));
+        memcpy(isa->cpu, BUSTER_HP_DRIVER_CPU, sizeof(BUSTER_HP_DRIVER_CPU));
+    }
+    else
+    {
+        hp_error(error, "missing, ambiguous or unqualified effective driver ISA");
+    }
+    return valid;
+}
+
+void hp_driver_free(HpDriverIsa *isa)
+{
+    if (isa != NULL)
+    {
+        hp_arguments_free(&isa->features);
+        memset(isa, 0, sizeof(*isa));
+    }
+    return;
+}
+
+bool hp_driver_isa(HpBytes log, const char *mode, HpDriverIsa *output, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    error[0] = 0;
+    HpDriverIsa isa = {0};
+    HpArguments command = {0};
+    bool valid = output != NULL && mode != NULL && (strcmp(mode, "-cc1") == 0 || strcmp(mode, "-cc1as") == 0) && log.data != NULL && log.size > 0 && log.size <= BUSTER_HP_DRIVER_LOG_LIMIT;
+    valid = valid && output->features.storage == NULL && output->features.values == NULL && output->features.count == 0 && output->executable[0] == 0 && output->triple[0] == 0 && output->cpu[0] == 0;
+    size_t commands = 0;
+    size_t position = 0;
+    while (valid && position < log.size)
+    {
+        size_t start = position;
+        while (valid && position < log.size && log.data[position] != '\n')
+        {
+            unsigned char byte = log.data[position];
+            valid = byte == '\t' || (byte >= 32 && byte != 127);
+            position += 1;
+        }
+        HpBytes line =
+        {
+            log.data + start,
+            position - start
+        };
+        if (position < log.size)
+        {
+            position += 1;
+        }
+        while (line.size > 0 && hp_driver_space(line.data[0]))
+        {
+            line.data += 1;
+            line.size -= 1;
+        }
+        while (line.size > 0 && hp_driver_space(line.data[line.size - 1]))
+        {
+            line.size -= 1;
+        }
+        if (valid && line.size > 0 && line.data[0] == '"')
+        {
+            commands += 1;
+            valid = commands == 1 && hp_driver_command(line, &command, error);
+        }
+        else if (valid && line.size > 0)
+        {
+            valid = hp_driver_header(line, error);
+        }
+    }
+    valid = valid && commands == 1;
+    if (valid)
+    {
+        valid = hp_driver_extract(&command, mode, &isa, error);
+    }
+    hp_arguments_free(&command);
+    if (valid)
+    {
+        *output = isa;
+    }
+    else
+    {
+        hp_driver_free(&isa);
+        if (error[0] == 0)
+        {
+            hp_error(error, "invalid, missing or ambiguous effective driver receipt");
+        }
+    }
+    return valid;
+}
+
+bool hp_driver_equal(const HpDriverIsa *a, const HpDriverIsa *b)
+{
+    bool equal = a != NULL && b != NULL && strcmp(a->triple, b->triple) == 0 && strcmp(a->cpu, b->cpu) == 0 && a->features.count == b->features.count;
+    for (size_t i = 0; equal && i < a->features.count; i += 1)
+    {
+        equal = strcmp(a->features.values[i], b->features.values[i]) == 0;
+    }
+    return equal;
+}
+
+bool hp_driver_default_target(HpBytes output, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    error[0] = 0;
+    size_t size = sizeof(BUSTER_HP_DRIVER_TARGET) - 1;
+    bool valid = output.data != NULL && (output.size == size || output.size == size + 1) && memcmp(output.data, BUSTER_HP_DRIVER_TARGET, size) == 0 && (output.size == size || output.data[size] == '\n');
+    if (!valid)
+    {
+        hp_error(error, "default driver target differs from exact pin");
+    }
+    return valid;
+}
diff --git a/hp_driver.h b/hp_driver.h
new file mode 100644
index 0000000..4f6e946
--- /dev/null
+++ b/hp_driver.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin.
+#ifndef BUSTER_HP_DRIVER_H
+#define BUSTER_HP_DRIVER_H
+
+#include "hp_common.h"
+
+#define BUSTER_HP_DRIVER_LOG_LIMIT ((size_t)1024 * 1024)
+#define BUSTER_HP_DRIVER_TARGET "x86_64-unknown-linux-gnu"
+#define BUSTER_HP_DRIVER_CPU "znver5"
+#define BUSTER_HP_DRIVER_NAME_CAPACITY 64
+
+typedef struct HpDriverIsa HpDriverIsa;
+struct HpDriverIsa
+{
+    char executable[BUSTER_HP_PATH_CAPACITY];
+    char triple[BUSTER_HP_DRIVER_NAME_CAPACITY];
+    char cpu[BUSTER_HP_DRIVER_NAME_CAPACITY];
+    HpArguments features;
+};
+
+// Parse a saved Linux Clang 23.1.4 -### receipt. mode is exactly -cc1/-cc1as.
+// The receipt is immutable, output is zero initialized, features are owned.
+// Only quoted argv is parsed; no shell evaluation or producer execution occurs.
+// Exactly one command is accepted; executable canonical identity is a separate
+// caller gate. Features preserve order and multiplicity without interpretation.
+bool hp_driver_isa(HpBytes log, const char *mode, HpDriverIsa *output, char error[BUSTER_HP_ERROR_CAPACITY]);
+void hp_driver_free(HpDriverIsa *isa);
+// Compare the effective target, CPU and complete ordered feature vector.
+// Executable strings are excluded: caller realpath-verifies against pinned CC.
+bool hp_driver_equal(const HpDriverIsa *a, const HpDriverIsa *b);
+// Accept exactly the pinned target bytes with zero or one trailing LF.
+bool hp_driver_default_target(HpBytes output, char error[BUSTER_HP_ERROR_CAPACITY]);
+
+#endif
diff --git a/hp_elf.c b/hp_elf.c
new file mode 100644
index 0000000..f351cbb
--- /dev/null
+++ b/hp_elf.c
@@ -0,0 +1,1027 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin.
+// First-party structural ELF proof, ported from the frozen local Python design
+// 7bad351a754cf55d45edbb26d7a346647c01267f9b0f10cd1fcdda5a2f7bebd6.
+// Reader: hp_elf_read. Object translation: hp_elf_compare_objects. Metadata owns
+// contiguous arrays; names and section contents borrow checked input slices.
+// Scalar format validation is cold preparation work, never compiler hot work.
+// Refuse unknown semantics rather than claiming linker/execution equivalence.
+#include "hp_elf.h"
+
+#include <elf.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define BUSTER_HP_HOT_ALIGN 4096U
+#define BUSTER_HP_MAX_SHIFT (UINT64_C(1) << 30)
+
+typedef struct HpRange HpRange;
+struct HpRange
+{
+    uint64_t begin;
+    uint64_t end;
+    uint32_t section;
+};
+
+typedef struct HpIdentity HpIdentity;
+struct HpIdentity
+{
+    HpString name;
+    HpString section_name;
+    uint64_t value;
+    uint64_t size;
+    uint8_t special;
+    uint8_t bind;
+    uint8_t type;
+    uint8_t other;
+};
+
+typedef struct HpNormalizedRelocation HpNormalizedRelocation;
+struct HpNormalizedRelocation
+{
+    HpString section_name;
+    HpString target_name;
+    uint64_t offset;
+    uint32_t type;
+    HpIdentity identity;
+    int64_t addend;
+};
+
+typedef struct HpNormalized HpNormalized;
+struct HpNormalized
+{
+    HpIdentity *identities;
+    HpIdentity *records;
+    HpString *files;
+    HpNormalizedRelocation *relocations;
+    size_t record_count;
+    size_t file_count;
+    size_t table;
+};
+
+static bool hp_require(bool condition, char error[BUSTER_HP_ERROR_CAPACITY], const char *message)
+{
+    if (!condition && error[0] == 0)
+    {
+        snprintf(error, BUSTER_HP_ERROR_CAPACITY, "%s", message);
+    }
+    return condition;
+}
+
+static uint16_t hp_u16(const unsigned char *bytes)
+{
+    return (uint16_t)((uint16_t)bytes[0] | (uint16_t)bytes[1] << 8);
+}
+
+static uint32_t hp_u32(const unsigned char *bytes)
+{
+    return (uint32_t)bytes[0] | (uint32_t)bytes[1] << 8 | (uint32_t)bytes[2] << 16 | (uint32_t)bytes[3] << 24;
+}
+
+static uint64_t hp_u64(const unsigned char *bytes)
+{
+    return (uint64_t)hp_u32(bytes) | (uint64_t)hp_u32(bytes + 4) << 32;
+}
+
+static int64_t hp_i64(const unsigned char *bytes)
+{
+    uint64_t bits = hp_u64(bytes);
+    int64_t result;
+    memcpy(&result, &bits, sizeof(result));
+    return result;
+}
+
+static bool hp_span(HpBytes input, uint64_t offset, uint64_t size, HpBytes *result, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool ok = hp_require(offset <= input.size && size <= input.size - offset, error, "out-of-file ELF span");
+    if (ok)
+    {
+        result->data = input.data + (size_t)offset;
+        result->size = (size_t)size;
+    }
+    return ok;
+}
+
+static bool hp_name(HpBytes strings, uint32_t offset, HpString *result, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool ok = hp_require(offset < strings.size, error, "bad ELF string offset");
+    if (ok)
+    {
+        const unsigned char *end = memchr(strings.data + offset, 0, strings.size - offset);
+        ok = hp_require(end != NULL, error, "unterminated ELF string");
+        if (ok)
+        {
+            result->data = (const char *)strings.data + offset;
+            result->size = (size_t)(end - strings.data - offset);
+        }
+    }
+    return ok;
+}
+
+bool hp_string_equal(HpString a, HpString b)
+{
+    return a.size == b.size && (a.size == 0 || memcmp(a.data, b.data, a.size) == 0);
+}
+
+bool hp_string_is(HpString value, const char *text)
+{
+    HpString other =
+    {
+        text,
+        strlen(text)
+    };
+    return hp_string_equal(value, other);
+}
+
+static int hp_string_compare(HpString a, HpString b)
+{
+    size_t shared = a.size < b.size ? a.size : b.size;
+    int result = shared != 0 ? memcmp(a.data, b.data, shared) : 0;
+    if (result == 0)
+    {
+        result = (a.size > b.size) - (a.size < b.size);
+    }
+    return result;
+}
+
+static int hp_range_compare(const void *left, const void *right)
+{
+    const HpRange *a = left;
+    const HpRange *b = right;
+    int result = (a->section > b->section) - (a->section < b->section);
+    if (result == 0)
+    {
+        result = (a->begin > b->begin) - (a->begin < b->begin);
+    }
+    if (result == 0)
+    {
+        result = (a->end > b->end) - (a->end < b->end);
+    }
+    return result;
+}
+
+static bool hp_bytes_equal(HpBytes a, HpBytes b)
+{
+    return a.size == b.size && (a.size == 0 || memcmp(a.data, b.data, a.size) == 0);
+}
+
+static void *hp_array(size_t count, size_t stride, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    void *result = NULL;
+    if (hp_require(count <= SIZE_MAX / stride, error, "ELF metadata array overflow"))
+    {
+        result = calloc(count != 0 ? count : 1, stride);
+        hp_require(result != NULL, error, "ELF metadata allocation failed");
+    }
+    return result;
+}
+
+void hp_elf_free(HpElf *elf)
+{
+    free(elf->sections);
+    free(elf->symbols);
+    free(elf->relocations);
+    memset(elf, 0, sizeof(*elf));
+}
+
+const HpSection *hp_elf_section_named(const HpElf *elf, const char *name)
+{
+    const HpSection *result = NULL;
+    for (size_t i = 0; i < elf->section_count; i += 1)
+    {
+        if (hp_string_is(elf->sections[i].name, name))
+        {
+            result = &elf->sections[i];
+        }
+    }
+    return result;
+}
+
+static bool hp_read_sections(HpElf *elf, uint64_t shoff, uint64_t phoff, uint16_t phnum, uint16_t phsize, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    HpBytes raw = {0};
+    HpBytes names = {0};
