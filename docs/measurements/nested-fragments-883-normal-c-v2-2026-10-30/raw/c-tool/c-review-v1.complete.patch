+static void control_proof_contracts(ControlSuite *suite)
+{
+    ControlFixture base;
+    ControlFixture variant;
+    HpElf left = {0};
+    HpElf right = {0};
+    HpObjectProof proof = {0};
+    char error[BUSTER_HP_ERROR_CAPACITY] = {0};
+    control_fixture(&base, control_options(0, BUSTER_FAULT_NONE));
+    HpBytes bytes =
+    {
+        base.bytes.data,
+        base.bytes.size
+    };
+    bool parsed = hp_elf_read(bytes, &left, error);
+    bool accepted = parsed && hp_elf_compare_objects(&left, &left, BUSTER_CONTROL_HOT, 0, &proof, error);
+    bool valid = accepted && proof.shift == 0 && proof.hot_bytes_before == 32 && proof.hot_alignment == 4096 && proof.symbols_compared == 5 && proof.relocations_compared == 3 && proof.disclosure_count == 0;
+    control_record(suite, "proof-identical-fields-and-no-disclosures", true, valid, error);
+    hp_object_proof_free(&proof);
+
+    ControlOptions options = control_options(0, BUSTER_FAULT_NONE);
+    options.comment = "different assembler producer";
+    options.file_name = "assembly-input.s";
+    control_fixture(&variant, options);
+    bytes.data = variant.bytes.data;
+    bytes.size = variant.bytes.size;
+    accepted = parsed && hp_elf_read(bytes, &right, error) && hp_elf_compare_objects(&left, &right, BUSTER_CONTROL_HOT, 0, &proof, error);
+    valid = accepted && control_has_disclosure(&proof, BUSTER_HP_DISCLOSURE_COMMENT) && control_has_disclosure(&proof, BUSTER_HP_DISCLOSURE_FILE_RECORDS) && control_has_disclosure(&proof, BUSTER_HP_DISCLOSURE_NORMALIZED_ENCODING) && proof.symbols_compared == 5 && proof.relocations_compared == 3;
+    control_record(suite, "proof-comment-file-and-encoding-disclosures", true, valid, error);
+    hp_object_proof_free(&proof);
+    hp_elf_free(&right);
+
+    options = control_options(16, BUSTER_FAULT_NONE);
+    options.reorder = true;
+    control_fixture(&variant, options);
+    bytes.data = variant.bytes.data;
+    bytes.size = variant.bytes.size;
+    accepted = parsed && hp_elf_read(bytes, &right, error) && hp_elf_compare_objects(&left, &right, BUSTER_CONTROL_HOT, 16, &proof, error);
+    valid = accepted && proof.shift == 16 && proof.hot_bytes_before == 32 && proof.hot_alignment == 4096 && proof.symbols_compared == 5 && proof.relocations_compared == 3 && control_has_disclosure(&proof, BUSTER_HP_DISCLOSURE_NORMALIZED_ENCODING) && !control_has_disclosure(&proof, BUSTER_HP_DISCLOSURE_COMMENT) && !control_has_disclosure(&proof, BUSTER_HP_DISCLOSURE_FILE_RECORDS);
+    control_record(suite, "proof-remapped-encoding-and-geometry-fields", true, valid, error);
+    hp_object_proof_free(&proof);
+    hp_elf_free(&right);
+
+    control_fixture(&variant, control_options(16, BUSTER_FAULT_HOT_BYTE));
+    bytes.data = variant.bytes.data;
+    bytes.size = variant.bytes.size;
+    accepted = parsed && hp_elf_read(bytes, &right, error);
+    if (accepted)
+    {
+        accepted = hp_elf_compare_objects(&left, &right, BUSTER_CONTROL_HOT, 16, &proof, error);
+    }
+    valid = !accepted && error[0] != 0 && proof.disclosures == NULL && proof.disclosure_count == 0 && proof.shift == 0 && proof.hot_bytes_before == 0 && proof.hot_alignment == 0 && proof.symbols_compared == 0 && proof.relocations_compared == 0;
+    control_record(suite, "proof-failure-leaves-empty-output", true, valid, error);
+    hp_object_proof_free(&proof);
+    hp_elf_free(&left);
+    hp_elf_free(&right);
+    valid = left.input.data == NULL && left.sections == NULL && left.symbols == NULL && left.relocations == NULL && left.section_count == 0 && left.symbol_count == 0 && left.relocation_count == 0 && proof.disclosures == NULL && proof.disclosure_count == 0;
+    control_record(suite, "free-resets-reader-and-proof-outputs", true, valid, "");
+
+    control_fixture(&variant, control_options(0, BUSTER_FAULT_BAD_MAGIC));
+    bytes.data = variant.bytes.data;
+    bytes.size = variant.bytes.size;
+    accepted = hp_elf_read(bytes, &right, error);
+    valid = !accepted && error[0] != 0 && right.input.data == NULL && right.sections == NULL && right.symbols == NULL && right.relocations == NULL && right.section_count == 0 && right.symbol_count == 0 && right.relocation_count == 0;
+    control_record(suite, "reader-failure-leaves-empty-output", true, valid, error);
+    hp_elf_free(&right);
+    return;
+}
