+        test.normal.fault = symmetric_faults[index];
+        tests[count++] = test;
+    }
+    const LinkedFault widths[] =
+    {
+        BUSTER_LINK_RELOCATION_8,
+        BUSTER_LINK_RELOCATION_2,
+        BUSTER_LINK_RELOCATION_1,
