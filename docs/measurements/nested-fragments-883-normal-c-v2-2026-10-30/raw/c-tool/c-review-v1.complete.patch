+        ranges[range_count++] = (HpRange)
+        {
+            0,
+            64,
+            0
+        };
+        ranges[range_count++] = (HpRange)
+        {
+            shoff,
+            shoff + elf->section_count * 64,
+            0
+        };
+        if (phnum != 0)
+        {
+            HpBytes unused = {0};
+            ok = ok && hp_span(elf->input, phoff, (uint64_t)phnum * phsize, &unused, error);
