+static bool control_has_disclosure(const HpObjectProof *proof, HpDisclosureKind kind)
+{
+    bool found = false;
+    for (size_t i = 0; i < proof->disclosure_count; i += 1)
+    {
+        found = found || proof->disclosures[i].kind == kind;
+    }
+    return found;
+}
