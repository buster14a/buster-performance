+    valid = valid && descriptor >= 0;
+    size_t offset = 0;
+    while (valid && offset < bytes.size)
+    {
+        ssize_t written = write(descriptor, bytes.data + offset, bytes.size - offset);
+        if (written < 0 && errno == EINTR)
+        {
+            continue;
+        }
+        valid = written > 0;
+        if (valid)
