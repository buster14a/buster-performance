+            method_inside_build(method, 0, true, error) && hp_verify_sources(method->tree, method->manifest, error) && method_snapshot(method, error) &&
+            method_complete(method, method->root, "prepared.json", "direct-normal", "objects and zero control only; no target execution or timings", error);
+    }
+    if (result)
+    {
+        char snapshot_sha[65] = {0};
+        result = method_path(path, method, "snapshot.sha256", error) && hp_sha256_file(path, snapshot_sha, error);
+        const char* ready[] = {"buster-hot-placement-c-v1", method->normal_sha, method->manifest_sha, snapshot_sha, NULL};
+        result = result && method_path(path, method, "ready.nul", error) && hp_record_arguments(path, ready, error);
+    }
+    return result;
+}
+
+static bool method_resume(HpMethod* method, uint64_t shift, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    char path[BUSTER_HP_PATH_CAPACITY] = {0};
+    char canonical[BUSTER_HP_PATH_CAPACITY] = {0};
+    HpArguments settings = {0};
+    HpArguments ready = {0};
+    HpBuffer receipt = {0};
+    uint64_t index = 0, count = 0, jobs = 0, fragment = 0;
+    bool result = shift == 16 || shift == 64 || shift == 256 || shift == 1024 || shift == 2048;
+    if (!result)
+    {
+        hp_error(error, "inside accepts only16,64,256,1024,2048; zero belongs to objects");
+    }
+    if (result)
+    {
+        result = method_path(path, method, "ready.nul", error) && method_load_arguments(path, &ready, error) && ready.count == 4 &&
+            strcmp(ready.values[0], "buster-hot-placement-c-v1") == 0 &&
+            method_path(path, method, "snapshot.sha256", error) && method_hash(path, ready.values[3], error) && hp_verify_sources(method->root, path, error) &&
+            method_path(path, method, "settings.nul", error) && method_load_arguments(path, &settings, error) && settings.count == 9;
+    }
+    if (result)
+    {
+        result = method_canonical(settings.values[0], method->tree, error) && method_canonical(settings.values[1], method->tc, error) &&
+            method_canonical(settings.values[2], method->manifest, error) && method_digest(settings.values[3]) && method_digest(settings.values[4]) &&
+            hp_plan_decimal(settings.values[5], BUSTER_HP_SOURCE_LIMIT - 1, &index, error) && hp_plan_decimal(settings.values[6], BUSTER_HP_SOURCE_LIMIT, &count, error) && count > 0 && index < count &&
+            hp_plan_decimal(settings.values[7], 1, &fragment, error) && hp_plan_decimal(settings.values[8], BUSTER_HP_SOURCE_LIMIT, &jobs, error) && jobs > 0;
+        if (result)
+        {
+            strcpy(method->manifest_sha, settings.values[3]);
+            strcpy(method->normal_sha, settings.values[4]);
+            method->fragment = fragment == 1;
+            result = strcmp(ready.values[1], method->normal_sha) == 0 && strcmp(ready.values[2], method->manifest_sha) == 0 &&
+                strcmp(method->tree, settings.values[0]) == 0 && strcmp(method->tc, settings.values[1]) == 0 && strcmp(method->manifest, settings.values[2]) == 0 &&
+                method_hash(method->manifest, method->manifest_sha, error) && hp_verify_sources(method->tree, method->manifest, error) && method_identity(method, error) &&
+                method_path(path, method, "flags.nul", error) && method_load_arguments(path, &method->flags, error) && hp_validate_flags(&method->flags, error) &&
+                method_path(path, method, "sources.nul", error) && method_load_arguments(path, &method->sources, error) && hp_plan_sources(&method->sources, &method->plan, error) &&
+                method->plan.checker_index == index && method->plan.count == count && method_manifest_inputs(method, error) && method_objects(method, error) &&
+                method_path(path, method, "direct-normal", error) && method_hash(path, method->normal_sha, error) &&
+                method_path(path, method, "inside-0/compiler", error) && method_hash(path, method->normal_sha, error) &&
+                method_path(path, method, "logs/effective-c-driver.stderr", error) && hp_read_file(path, BUSTER_HP_DRIVER_LOG_LIMIT, &receipt, error) &&
+                hp_driver_isa((HpBytes){receipt.data, receipt.size}, "-cc1", &method->c_isa, error) &&
+                method_canonical(method->c_isa.executable, canonical, error);
+        }
+        if (result)
+        {
+            char cc[BUSTER_HP_PATH_CAPACITY] = {0};
+            result = method_canonical(method->cc, cc, error) && strcmp(canonical, cc) == 0;
+        }
+    }
+    if (result)
+    {
+        char name[64] = {0};
+        snprintf(name, sizeof(name), "default-target-inside-%" PRIu64, shift);
+        result = method_path(path, method, name, error) && method_default(method, path, error) && method_inside_build(method, shift, false, error);
+    }
+    if (!result && error[0] == '\0')
+    {
+        hp_error(error, "prepared metadata, identities or structure failed");
+    }
+    hp_arguments_free(&settings);
+    hp_arguments_free(&ready);
+    hp_buffer_free(&receipt);
+    return result;
+}
+
+static void method_free(HpMethod* method)
+{
+    hp_arguments_free(&method->flags);
+    hp_arguments_free(&method->sources);
+    hp_arguments_free(&method->objects);
+    hp_driver_free(&method->c_isa);
+}
+
+int main(int argc, char** argv)
+{
+    HpMethod method = {0};
+    char error[BUSTER_HP_ERROR_CAPACITY] = {0};
+    const char* options[8] = {0};
+    const char* names[] = {"--tree", "--out", "--normal", "--manifest", "--flags-reference", "--sources-reference", "--tc", "--normal-sha256"};
+    bool result = argc >= 2;
+    if (result && strcmp(argv[1], "objects") == 0)
+    {
+        result = argc == 18;
+        for (int i = 2; result && i < argc; i += 2)
+        {
+            size_t found = 8;
+            for (size_t j = 0; j < 8; ++j)
+            {
+                if (strcmp(argv[i], names[j]) == 0)
+                {
+                    found = j;
+                }
+            }
+            result = found < 8 && options[found] == NULL;
+            if (result)
+            {
+                options[found] = argv[i + 1];
+            }
+        }
+        if (result)
+        {
+            char normal[BUSTER_HP_PATH_CAPACITY] = {0}, flags[BUSTER_HP_PATH_CAPACITY] = {0}, sources[BUSTER_HP_PATH_CAPACITY] = {0};
+            result = method_canonical(options[0], method.tree, error) && method_new_path(options[1], method.root, error) &&
+                method_canonical(options[2], normal, error) && method_canonical(options[3], method.manifest, error) &&
+                method_canonical(options[4], flags, error) && method_canonical(options[5], sources, error) && method_canonical(options[6], method.tc, error) && method_digest(options[7]);
+            if (result)
+            {
+                strcpy(method.normal_sha, options[7]);
+                result = method_prepare(&method, normal, flags, sources, error);
+            }
+        }
+    }
+    else if (result && strcmp(argv[1], "inside") == 0)
+    {
+        uint64_t shift = 0;
+        result = argc == 6 && strcmp(argv[2], "--objects") == 0 && strcmp(argv[4], "--shift") == 0 &&
+            method_canonical(argv[3], method.root, error) && hp_plan_decimal(argv[5], 2048, &shift, error) && method_resume(&method, shift, error);
+    }
+    else
+    {
+        result = false;
+    }
+    if (!result)
+    {
+        fprintf(stderr, "hot-placement: %s\n", error[0] != '\0' ? error : "invalid arguments or failed gate; preserved receipts");
+    }
+    else
+    {
+        puts("{\"passed\":true,\"timing_run\":false,\"target_execution\":false}");
+    }
+    method_free(&method);
+    return result ? 0 : 1;
+}
diff --git a/hp_pad.c b/hp_pad.c
new file mode 100644
index 0000000..76a952e
--- /dev/null
+++ b/hp_pad.c
@@ -0,0 +1,434 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin.
+// hp_pad_hot performs one inside-hot-section textual insertion. It does not
+// claim assembly or layout equivalence: object and final-image gates follow.
+// Context-changing macros, conditionals and section stacks are refused rather
+// than interpreted; the existing producer emits explicit section selections.
+#include "hp_pad.h"
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static bool hp_pad_error(char error[BUSTER_HP_ERROR_CAPACITY], const char *message)
+{
+    if (error != NULL)
+    {
+        snprintf(error, BUSTER_HP_ERROR_CAPACITY, "%s", message);
+    }
+    return false;
+}
+
+static bool hp_pad_space(unsigned char value)
+{
+    return value == ' ' || value == '\t' || value == '\r' || value == '\v' || value == '\f';
+}
+
+static HpString hp_pad_trim(HpString text)
+{
+    while (text.size != 0 && hp_pad_space((unsigned char)text.data[0]))
+    {
+        text.data += 1;
+        text.size -= 1;
+    }
+    while (text.size != 0 && hp_pad_space((unsigned char)text.data[text.size - 1]))
+    {
+        text.size -= 1;
+    }
+    return text;
+}
+
+static bool hp_pad_is(HpString text, const char *literal)
+{
+    size_t length = strlen(literal);
+    return text.size == length && memcmp(text.data, literal, length) == 0;
+}
+
+static bool hp_pad_starts(HpString text, const char *literal)
+{
+    size_t length = strlen(literal);
+    return text.size >= length && memcmp(text.data, literal, length) == 0;
+}
+
+static HpString hp_pad_word(HpString text)
+{
+    size_t end = 0;
+    while (end < text.size && !hp_pad_space((unsigned char)text.data[end]) && text.data[end] != ';')
+    {
+        end += 1;
+    }
+    HpString result =
+    {
+        .data = text.data,
+        .size = end
+    };
+    return result;
+}
+
+static bool hp_pad_unsupported(HpString word)
+{
+    bool result = hp_pad_is(word, ".pushsection") || hp_pad_is(word, ".popsection") || hp_pad_is(word, ".previous") || hp_pad_is(word, ".subsection") || hp_pad_is(word, ".macro") || hp_pad_is(word, ".endm") || hp_pad_is(word, ".else") || hp_pad_is(word, ".elseif") || hp_pad_is(word, ".endif") || hp_pad_is(word, ".rept") || hp_pad_is(word, ".endr") || hp_pad_is(word, ".irp") || hp_pad_is(word, ".irpc") || hp_pad_is(word, ".include") || hp_pad_is(word, ".incbin") || hp_pad_starts(word, ".if");
+    return result;
+}
+
+static bool hp_pad_context(HpString word)
+{
+    bool result = hp_pad_unsupported(word) || hp_pad_is(word, ".section") || hp_pad_is(word, ".text") || hp_pad_is(word, ".data") || hp_pad_is(word, ".bss") || hp_pad_is(word, ".p2align");
+    return result;
+}
+
+static HpString hp_pad_after_labels(HpString statement, bool *labelled)
+{
+    bool more = true;
+    *labelled = false;
+    while (more && statement.size != 0)
+    {
+        size_t index = 0;
+        while (index < statement.size)
+        {
+            unsigned char value = (unsigned char)statement.data[index];
+            bool label_char = (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') || (value >= '0' && value <= '9') || value == '_' || value == '.' || value == '$';
+            if (!label_char)
+            {
+                break;
+            }
+            index += 1;
+        }
+        size_t after = index;
+        while (after < statement.size && hp_pad_space((unsigned char)statement.data[after]))
+        {
+            after += 1;
+        }
+        if (index != 0 && after < statement.size && statement.data[after] == ':')
+        {
+            statement.data += after + 1;
+            statement.size -= after + 1;
+            statement = hp_pad_trim(statement);
+            *labelled = true;
+        }
+        else
+        {
+            more = false;
+        }
+    }
+    return statement;
+}
+
+// Quoted # and ; are data, not comments or statement separators. A section or
+// alignment directive sharing a physical line is refused, since insertion at
+// the line boundary could otherwise put .skip in a different section.
+static bool hp_pad_code(HpBytes line, HpString *code, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool valid = true;
+    bool quoted = false;
+    bool escaped = false;
+    bool semicolon = false;
+    size_t size = line.size;
+    for (size_t index = 0; valid && index < size; index += 1)
+    {
+        unsigned char value = line.data[index];
+        if (value == 0)
+        {
+            valid = hp_pad_error(error, "embedded NUL in generated assembly");
+        }
+        else if (escaped)
+        {
+            escaped = false;
+        }
+        else if (quoted && value == '\\')
+        {
+            escaped = true;
+        }
+        else if (value == '"')
+        {
+            quoted = !quoted;
+        }
+        else if (!quoted && value == '#')
+        {
+            size = index;
+        }
+        else if (!quoted && index + 1 < size && ((value == '/' && line.data[index + 1] == '*') || (value == '*' && line.data[index + 1] == '/')))
+        {
+            valid = hp_pad_error(error, "unsupported block-comment syntax in generated assembly");
+        }
+        else if (!quoted && value == ';')
+        {
+            semicolon = true;
+        }
+    }
+    if (valid && quoted)
+    {
+        valid = hp_pad_error(error, "unterminated quoted assembly line");
+    }
+    HpString result =
+    {
+        .data = (const char *)line.data,
+        .size = size
+    };
+    result = hp_pad_trim(result);
+    if (valid && semicolon)
+    {
+        quoted = false;
+        escaped = false;
+        size_t begin = 0;
+        for (size_t index = 0; valid && index <= result.size; index += 1)
+        {
+            unsigned char value = index < result.size ? (unsigned char)result.data[index] : ';';
+            if (escaped)
+            {
+                escaped = false;
+            }
+            else if (quoted && value == '\\')
+            {
+                escaped = true;
+            }
+            else if (value == '"')
+            {
+                quoted = !quoted;
+            }
+            else if (!quoted && value == ';')
+            {
+                HpString statement =
+                {
+                    .data = result.data + begin,
+                    .size = index - begin
+                };
+                statement = hp_pad_trim(statement);
+                bool labelled = false;
+                statement = hp_pad_after_labels(statement, &labelled);
+                if (hp_pad_context(hp_pad_word(statement)))
+                {
+                    valid = hp_pad_error(error, "section, alignment or macro directive shares a physical line");
+                }
+                begin = index + 1;
+            }
+        }
+    }
+    *code = result;
+    return valid;
+}
+
+static bool hp_pad_section_char(unsigned char value)
+{
+    bool result = (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') || (value >= '0' && value <= '9') || value == '_' || value == '.' || value == '$' || value == '-';
+    return result;
+}
+
+static bool hp_pad_section(HpString code, bool *hot, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool valid = true;
+    code.data += sizeof(".section") - 1;
+    code.size -= sizeof(".section") - 1;
+    if (code.size == 0 || !hp_pad_space((unsigned char)code.data[0]))
+    {
+        valid = hp_pad_error(error, "section directive requires a separated section name");
+    }
+    code = hp_pad_trim(code);
+    HpString name =
+    {
+        .data = code.data,
+        .size = 0
+    };
+    size_t used = 0;
+    if (valid && code.size != 0 && code.data[0] == '"')
+    {
+        used = 1;
+        while (used < code.size && code.data[used] != '"' && code.data[used] != '\\')
+        {
+            used += 1;
+        }
+        valid = used < code.size && code.data[used] == '"' && used > 1;
+        if (valid)
+        {
+            name.data = code.data + 1;
+            name.size = used - 1;
+            used += 1;
+        }
+    }
+    else if (valid)
+    {
+        while (used < code.size && hp_pad_section_char((unsigned char)code.data[used]))
+        {
+            used += 1;
+        }
+        name.size = used;
+        valid = used != 0;
+    }
+    if (valid)
+    {
+        code.data += used;
+        code.size -= used;
+        code = hp_pad_trim(code);
+        valid = code.size == 0 || code.data[0] == ',';
+    }
+    if (!valid)
+    {
+        valid = hp_pad_error(error, "unrecognized section-selection syntax");
+    }
+    else
+    {
+        *hot = hp_pad_is(name, ".text.buster_checker");
+    }
+    return valid;
+}
+
+static bool hp_pad_simple_section(HpString code, HpString word, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    code.data += word.size;
+    code.size -= word.size;
+    code = hp_pad_trim(code);
+    bool valid = code.size == 0 || hp_pad_is(code, "0");
+    if (!valid)
+    {
+        valid = hp_pad_error(error, "unsupported nonzero or malformed ordinary subsection");
+    }
+    return valid;
+}
+
+static bool hp_pad_alignment(HpString code)
+{
+    code.data += sizeof(".p2align") - 1;
+    code.size -= sizeof(".p2align") - 1;
+    code = hp_pad_trim(code);
+    return hp_pad_is(code, "12");
+}
+
+bool hp_pad_hot(HpBytes input, uint64_t shift, unsigned char **output, size_t *output_size, size_t *anchor_line, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool valid = output != NULL && output_size != NULL && anchor_line != NULL && error != NULL;
+    if (output != NULL)
+    {
+        *output = NULL;
+    }
+    if (output_size != NULL)
+    {
+        *output_size = 0;
+    }
+    if (anchor_line != NULL)
+    {
+        *anchor_line = 0;
+    }
+    if (error != NULL)
+    {
+        error[0] = 0;
+    }
+    if (!valid)
+    {
+        valid = hp_pad_error(error, "missing output or error storage");
+    }
+    if (valid && shift != 0 && shift != 16 && shift != 64 && shift != 256 && shift != 1024 && shift != 2048)
+    {
+        valid = hp_pad_error(error, "unapproved inside shift");
+    }
+    char insertion[64];
+    int inserted = valid && shift != 0 ? snprintf(insertion, sizeof(insertion), "\t.skip\t%" PRIu64 "\n", shift) : 0;
+    if (valid && (inserted < 0 || (size_t)inserted >= sizeof(insertion) || input.size > SIZE_MAX - (size_t)inserted - 1 || (input.size != 0 && input.data == NULL)))
+    {
+        valid = hp_pad_error(error, "input or insertion size is invalid");
+    }
+    if (valid && input.size != 0 && memchr(input.data, 0, input.size) != NULL)
+    {
+        valid = hp_pad_error(error, "embedded NUL in generated assembly");
+    }
+    bool hot = false;
+    bool seen_content = false;
+    size_t anchors = 0;
+    size_t anchor_after = 0;
+    size_t anchor_number = 0;
+    size_t number = 0;
+    for (size_t begin = 0; valid && begin < input.size; )
+    {
+        size_t end = begin;
+        while (end < input.size && input.data[end] != '\n')
+        {
+            end += 1;
+        }
+        bool newline = end < input.size;
+        size_t next = end + (newline ? 1 : 0);
+        number += 1;
+        HpBytes line =
+        {
+            .data = input.data + begin,
+            .size = end - begin
+        };
+        HpString code = { 0 };
+        valid = hp_pad_code(line, &code, error);
+        HpString word = hp_pad_word(code);
+        bool labelled = false;
+        HpString after_labels = hp_pad_after_labels(code, &labelled);
+        if (valid && code.size != 0)
+        {
+            if (labelled && hp_pad_context(hp_pad_word(after_labels)))
+            {
+                valid = hp_pad_error(error, "section, alignment or macro directive follows a label");
+            }
+            else if (hp_pad_unsupported(word))
+            {
+                valid = hp_pad_error(error, "unsupported section stack, macro, conditional or include directive");
+            }
+            else if (hp_pad_is(word, ".section"))
+            {
+                valid = hp_pad_section(code, &hot, error);
+            }
+            else if (hp_pad_is(word, ".text") || hp_pad_is(word, ".data") || hp_pad_is(word, ".bss"))
+            {
+                valid = hp_pad_simple_section(code, word, error);
+                hot = false;
+            }
+            else if (hp_pad_starts(word, ".section"))
+            {
+                valid = hp_pad_error(error, "unrecognized section-selection directive");
+            }
+            else if (hot)
+            {
+                if (hp_pad_is(word, ".p2align") && hp_pad_alignment(code))
+                {
+                    if (seen_content || !newline)
+                    {
+                        valid = hp_pad_error(error, "hot page alignment follows content or lacks newline");
+                    }
+                    else
+                    {
+                        anchors += 1;
+                        anchor_after = next;
+                        anchor_number = number;
+                    }
+                }
+                else
+                {
+                    seen_content = true;
+                }
+            }
+        }
+        begin = next;
+    }
+    if (valid && anchors != 1)
+    {
+        valid = hp_pad_error(error, "requires exactly one initial hot page-alignment anchor");
+    }
+    unsigned char *result = NULL;
+    size_t result_size = input.size + (size_t)inserted;
+    if (valid)
+    {
+        result = malloc(result_size + 1);
+        if (result == NULL)
+        {
+            valid = hp_pad_error(error, "output allocation failed");
+        }
+    }
+    if (valid)
+    {
+        memcpy(result, input.data, anchor_after);
+        if (inserted != 0)
+        {
+            memcpy(result + anchor_after, insertion, (size_t)inserted);
+        }
+        memcpy(result + anchor_after + (size_t)inserted, input.data + anchor_after, input.size - anchor_after);
+        result[result_size] = 0;
+        *output = result;
+        *output_size = result_size;
+        *anchor_line = anchor_number;
+    }
+    return valid;
+}
diff --git a/hp_pad.h b/hp_pad.h
new file mode 100644
index 0000000..592ea9b
--- /dev/null
+++ b/hp_pad.h
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin.
+#ifndef BUSTER_HP_PAD_H
+#define BUSTER_HP_PAD_H
+
+#include "hp_elf.h"
+
+// Parse only the supported generated-assembly context. The caller owns input
+// and receives a separately allocated output, freed with free(). On failure,
+// output, size and anchor are cleared. Shift zero is byte-identical input.
+// No source, assembler, compiler or executable is invoked by this function.
+bool hp_pad_hot(HpBytes input, uint64_t shift, unsigned char **output, size_t *output_size, size_t *anchor_line, char error[BUSTER_HP_ERROR_CAPACITY]);
+
+#endif
diff --git a/hp_plan.c b/hp_plan.c
new file mode 100644
index 0000000..bf9a774
--- /dev/null
+++ b/hp_plan.c
@@ -0,0 +1,318 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin.
+// First-party in-memory validation and command planning. Every operand remains
+// one argv entry. This module never interprets command text or starts a process.
+#include "hp_plan.h"
+
+#include <string.h>
+
+static bool hp_plan_error(char error[BUSTER_HP_ERROR_CAPACITY], const char *message)
+{
+    if (error != NULL)
+    {
+        hp_error(error, "%s", message);
+    }
+    return false;
+}
+
+static bool hp_plan_text(const char *text, size_t *size)
+{
+    size_t length = 0;
+    bool valid = text != NULL;
+    while (valid && length < BUSTER_HP_PATH_CAPACITY && text[length] != 0)
+    {
+        unsigned char byte = (unsigned char)text[length];
+        valid = byte >= 32 && byte != 127;
+        length += 1;
+    }
+    valid = valid && length != 0 && length < BUSTER_HP_PATH_CAPACITY;
+    if (size != NULL)
+    {
+        *size = valid ? length : 0;
+    }
+    return valid;
+}
+
+static bool hp_plan_file(const char *text)
+{
+    bool valid = hp_plan_text(text, NULL);
+    valid = valid && text[0] != '-' && text[0] != '@';
+    return valid;
+}
+
+static bool hp_plan_source(const char *text)
+{
+    size_t length = 0;
+    bool valid = hp_plan_file(text) && hp_plan_text(text, &length);
+    valid = valid && text[0] != '/' && length >= 3 && text[length - 2] == '.' && text[length - 1] == 'c';
+    size_t start = 0;
+    for (size_t index = 0; valid && index <= length; index += 1)
+    {
+        if (index == length || text[index] == '/')
+        {
+            size_t size = index - start;
+            valid = size != 0 && !(size == 1 && text[start] == '.') && !(size == 2 && text[start] == '.' && text[start + 1] == '.');
+            start = index + 1;
+        }
+        else
+        {
+            unsigned char byte = (unsigned char)text[index];
+            valid = (byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') || (byte >= '0' && byte <= '9') || byte == '_' || byte == '-' || byte == '.';
+        }
+    }
+    return valid;
+}
+
+static bool hp_plan_array(const HpArguments *arguments, size_t limit)
+{
+    bool valid = arguments != NULL && arguments->count <= limit && (arguments->count == 0 || arguments->values != NULL);
+    for (size_t index = 0; valid && index < arguments->count; index += 1)
+    {
+        valid = hp_plan_text(arguments->values[index], NULL);
+    }
+    return valid;
+}
+
+bool hp_plan_sources(const HpArguments *sources, HpSourcePlan *output, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    HpSourcePlan plan = { 0 };
+    if (output != NULL)
+    {
+        memset(output, 0, sizeof(*output));
+    }
+    if (error != NULL)
+    {
+        error[0] = 0;
+    }
+    bool valid = output != NULL && error != NULL && hp_plan_array(sources, BUSTER_HP_SOURCE_LIMIT) && sources->count != 0;
+    size_t checkers = 0;
+    for (size_t index = 0; valid && index < sources->count; index += 1)
+    {
+        const char *source = sources->values[index];
+        valid = hp_plan_source(source);
+        for (size_t previous = 0; valid && previous < index; previous += 1)
+        {
+            valid = strcmp(source, plan.values[previous]) != 0;
+        }
+        if (valid)
+        {
+            const char *slash = strrchr(source, '/');
+            const char *basename = slash != NULL ? slash + 1 : source;
+            if (strcmp(basename, "main_unit_checker.c") == 0)
+            {
+                checkers += 1;
+                plan.checker_index = index;
+            }
+            plan.values[plan.count++] = source;
+        }
+    }
+    valid = valid && checkers == 1;
+    if (valid)
+    {
+        *output = plan;
+    }
+    else
+    {
+        hp_plan_error(error, "invalid, duplicate, oversized or unqualified source inventory");
+    }
+    return valid;
+}
+
+bool hp_plan_decimal(const char *text, uint64_t maximum, uint64_t *output, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    if (output != NULL)
+    {
+        *output = 0;
+    }
+    if (error != NULL)
+    {
+        error[0] = 0;
+    }
+    size_t length = 0;
+    bool valid = output != NULL && error != NULL && hp_plan_text(text, &length);
+    uint64_t value = 0;
+    for (size_t index = 0; valid && index < length; index += 1)
+    {
+        unsigned char byte = (unsigned char)text[index];
+        valid = byte >= '0' && byte <= '9';
+        if (valid)
+        {
+            uint64_t digit = byte - '0';
+            valid = value < maximum / 10 || (value == maximum / 10 && digit <= maximum % 10);
+            if (valid)
+            {
+                value = value * 10 + digit;
+            }
+        }
+    }
+    if (valid)
+    {
+        *output = value;
+    }
+    else
+    {
+        hp_plan_error(error, "invalid, overflowing or out-of-range decimal setting");
+    }
+    return valid;
+}
+
+static bool hp_plan_push(HpPlanArguments *plan, const char *value)
+{
+    bool valid = plan->count < BUSTER_HP_ARGUMENT_LIMIT && hp_plan_text(value, NULL);
+    if (valid)
+    {
+        plan->values[plan->count++] = value;
+        plan->values[plan->count] = NULL;
+    }
+    return valid;
+}
+
+static bool hp_plan_arguments(const char *const *prefix, size_t prefix_count, const HpArguments *flags, HpPlanArguments *output, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    HpPlanArguments plan = { 0 };
+    bool valid = output != NULL && error != NULL && prefix_count <= BUSTER_HP_ARGUMENT_LIMIT && hp_plan_array(flags, BUSTER_HP_ARGUMENT_LIMIT - prefix_count);
+    for (size_t index = 0; valid && index < prefix_count; index += 1)
+    {
+        valid = hp_plan_push(&plan, prefix[index]);
+    }
+    for (size_t index = 0; valid && index < flags->count; index += 1)
+    {
+        valid = hp_plan_push(&plan, flags->values[index]);
+    }
+    if (valid)
+    {
+        *output = plan;
+    }
+    else
+    {
+        hp_plan_error(error, "invalid or oversized command argument plan");
+    }
+    return valid;
+}
+
+static bool hp_plan_prepare(HpPlanArguments *output, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    if (output != NULL)
+    {
+        memset(output, 0, sizeof(*output));
+    }
+    if (error != NULL)
+    {
+        error[0] = 0;
+    }
+    return output != NULL && error != NULL;
+}
+
+bool hp_plan_compile(const char *cc, const char *source, const char *object, const char *json, const HpArguments *flags, HpPlanArguments *output, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool valid = hp_plan_prepare(output, error) && hp_plan_file(cc) && cc[0] == '/' && hp_plan_source(source) && hp_plan_file(object) && hp_plan_file(json);
+    const char *prefix[] =
+    {
+        cc,
+        "-c",
+        source,
+        "-o",
+        object,
+        "-MJ",
+        json
+    };
+    if (valid)
+    {
+        valid = hp_plan_arguments(prefix, sizeof(prefix) / sizeof(prefix[0]), flags, output, error);
+    }
+    if (!valid && error != NULL && error[0] == 0)
+    {
+        hp_plan_error(error, "invalid direct-compile file operand");
+    }
+    return valid;
+}
+
+bool hp_plan_assembly(const char *cc, const char *source, const char *assembly, const HpArguments *flags, HpPlanArguments *output, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool valid = hp_plan_prepare(output, error) && hp_plan_file(cc) && cc[0] == '/' && hp_plan_source(source) && hp_plan_file(assembly);
+    const char *prefix[] =
+    {
+        cc,
+        "-S",
+        source,
+        "-o",
+        assembly
+    };
+    if (valid)
+    {
+        valid = hp_plan_arguments(prefix, sizeof(prefix) / sizeof(prefix[0]), flags, output, error);
+    }
+    if (!valid && error != NULL && error[0] == 0)
+    {
+        hp_plan_error(error, "invalid assembly-emission file operand");
+    }
+    return valid;
+}
+
+bool hp_plan_assemble(const char *cc, const char *assembly, const char *object, HpPlanArguments *output, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool valid = hp_plan_prepare(output, error) && hp_plan_file(cc) && cc[0] == '/' && hp_plan_file(assembly) && hp_plan_file(object);
+    const char *prefix[] =
+    {
+        cc,
+        "-c",
+        "-x",
+        "assembler",
+        "--target=x86_64-unknown-linux-gnu",
+        "-march=znver5",
+        assembly,
+        "-o",
+        object
+    };
+    HpArguments no_flags = { 0 };
+    if (valid)
+    {
+        valid = hp_plan_arguments(prefix, sizeof(prefix) / sizeof(prefix[0]), &no_flags, output, error);
+    }
+    if (!valid && error != NULL && error[0] == 0)
+    {
+        hp_plan_error(error, "invalid assembler file operand");
+    }
+    return valid;
+}
+
+bool hp_plan_link(const char *cc, const HpArguments *objects, size_t checker_index, const char *replacement, const char *image, HpPlanArguments *output, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool valid = hp_plan_prepare(output, error) && hp_plan_file(cc) && cc[0] == '/' && hp_plan_array(objects, BUSTER_HP_SOURCE_LIMIT) && objects->count != 0 && checker_index < objects->count && (replacement == NULL || hp_plan_file(replacement)) && hp_plan_file(image);
+    HpPlanArguments plan = { 0 };
+    const char *prefix[] =
+    {
+        cc,
+        "-no-pie",
+        "--ld-path=/usr/bin/wild"
+    };
+    for (size_t index = 0; valid && index < sizeof(prefix) / sizeof(prefix[0]); index += 1)
+    {
+        valid = hp_plan_push(&plan, prefix[index]);
+    }
+    for (size_t index = 0; valid && index < objects->count; index += 1)
+    {
+        const char *object = replacement != NULL && index == checker_index ? replacement : objects->values[index];
+        valid = hp_plan_file(objects->values[index]) && hp_plan_push(&plan, object);
+    }
+    const char *suffix[] =
+    {
+        "-lm",
+        "-ldl",
+        "-o",
+        image
+    };
+    for (size_t index = 0; valid && index < sizeof(suffix) / sizeof(suffix[0]); index += 1)
+    {
+        valid = hp_plan_push(&plan, suffix[index]);
+    }
+    if (valid)
+    {
+        *output = plan;
+    }
+    else
+    {
+        hp_plan_error(error, "invalid link inventory, checker slot or file operand");
+    }
+    return valid;
+}
diff --git a/hp_plan.h b/hp_plan.h
new file mode 100644
index 0000000..e410b55
--- /dev/null
+++ b/hp_plan.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin.
+#ifndef BUSTER_HP_PLAN_H
+#define BUSTER_HP_PLAN_H
+
+#include "hp_common.h"
+
+#define BUSTER_HP_SOURCE_LIMIT 256U
+
+typedef struct HpSourcePlan HpSourcePlan;
+struct HpSourcePlan
+{
+    const char *values[BUSTER_HP_SOURCE_LIMIT];
+    size_t count;
+    size_t checker_index;
+};
+
+typedef struct HpPlanArguments HpPlanArguments;
+struct HpPlanArguments
+{
+    const char *values[BUSTER_HP_ARGUMENT_LIMIT + 1];
+    size_t count;
+};
+
+// Plans own their pointer arrays and borrow all strings. No shell, producer or
+// filesystem is invoked. Use separate input/output storage. Successful argv
+// always has values[count] == NULL; failure clears the entire output plan.
+// Source paths are lexical project-relative ASCII .c paths with no empty,
+// dot or dotdot component and exactly one main_unit_checker.c basename.
+// Canonical filesystem ownership and source/flag identities are caller gates.
+bool hp_plan_sources(const HpArguments *sources, HpSourcePlan *output, char error[BUSTER_HP_ERROR_CAPACITY]);
+// Read base10 digits only (leading zeroes allowed), bounded by maximum.
+// Failure clears *output. Signs, whitespace and overlong strings are refused.
+bool hp_plan_decimal(const char *text, uint64_t maximum, uint64_t *output, char error[BUSTER_HP_ERROR_CAPACITY]);
+// These preserve the supplied C flag vector exactly. The independent exact
+// hp_validate_flags allowlist must pass before a producer uses the plan.
+bool hp_plan_compile(const char *cc, const char *source, const char *object, const char *json, const HpArguments *flags, HpPlanArguments *output, char error[BUSTER_HP_ERROR_CAPACITY]);
+bool hp_plan_assembly(const char *cc, const char *source, const char *assembly, const HpArguments *flags, HpPlanArguments *output, char error[BUSTER_HP_ERROR_CAPACITY]);
+// The assembler receives only this method's explicit pinned target/CPU flags.
+bool hp_plan_assemble(const char *cc, const char *assembly, const char *object, HpPlanArguments *output, char error[BUSTER_HP_ERROR_CAPACITY]);
+// Objects stay in source order; replacement, if non-NULL, occupies exactly the
+// checker_index slot. A valid checker_index is required even without replacing.
+bool hp_plan_link(const char *cc, const HpArguments *objects, size_t checker_index, const char *replacement, const char *image, HpPlanArguments *output, char error[BUSTER_HP_ERROR_CAPACITY]);
+
+#endif
diff --git a/hp_receipt.c b/hp_receipt.c
new file mode 100644
index 0000000..0939a50
--- /dev/null
+++ b/hp_receipt.c
@@ -0,0 +1,210 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin.
+// Serialize already successful structural proofs without adding semantic
+// claims. Object counts/disclosures and every linked function/operand field
+// remain visible. All names pass through the bounded JSON string writer.
+#define _POSIX_C_SOURCE 200809L
+#include "hp_receipt.h"
+
+#include <fcntl.h>
+#include <inttypes.h>
+#include <string.h>
+#include <unistd.h>
+
+#define BUSTER_HP_RECEIPT_ITEM_LIMIT ((size_t)1024 * 1024)
+
+static FILE *hp_receipt_open(const char *path, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    int descriptor = path != NULL ? open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600) : -1;
+    FILE *file = descriptor >= 0 ? fdopen(descriptor, "w") : NULL;
+    if (file == NULL)
+    {
+        if (descriptor >= 0)
+        {
+            close(descriptor);
+        }
+        hp_error(error, "cannot create exclusive proof receipt");
+    }
+    return file;
+}
+
+static bool hp_receipt_finish(FILE *file, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    bool valid = fflush(file) == 0;
+    valid = ferror(file) == 0 && valid;
+    valid = fclose(file) == 0 && valid;
+    if (!valid)
+    {
+        hp_error(error, "cannot complete proof receipt write/flush/close");
+    }
+    return valid;
+}
+
+static void hp_receipt_literal(FILE *file, const char *text)
+{
+    HpString value =
+    {
+        text,
+        strlen(text)
+    };
+    hp_json_string(file, value);
+    return;
+}
+
+static void hp_receipt_limits(FILE *file)
+{
+    fputs("  \"limits\": {\n    \"pt_load_validated\": false,\n    \"numeric_resolved_operands_validated\": false,\n    \"runtime_semantics_validated\": false\n  }", file);
+    return;
+}
+
+static const char *hp_receipt_disclosure(HpDisclosureKind kind)
+{
+    const char *text = NULL;
+    switch (kind)
+    {
+        case BUSTER_HP_DISCLOSURE_COMMENT:
+        {
+            text = "nonalloc .comment producer bytes/presence differ";
+        } break;
+        case BUSTER_HP_DISCLOSURE_FILE_RECORDS:
+        {
+            text = "unreferenced STT_FILE producer records differ";
+        } break;
+        case BUSTER_HP_DISCLOSURE_NORMALIZED_ENCODING:
+        {
+            text = "normalized symbol/string/RELA encoding differs";
+        } break;
+    }
+    return text;
+}
+
+static bool hp_receipt_string(HpString text)
+{
+    return text.size <= BUSTER_HP_FILE_LIMIT && (text.size == 0 || text.data != NULL);
+}
+
+bool hp_receipt_object(const char *path, const HpObjectProof *proof, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    error[0] = 0;
+    bool valid = proof != NULL && proof->disclosure_count <= BUSTER_HP_RECEIPT_ITEM_LIMIT && (proof->disclosure_count == 0 || proof->disclosures != NULL);
+    for (size_t i = 0; valid && i < proof->disclosure_count; i += 1)
+    {
+        valid = hp_receipt_disclosure(proof->disclosures[i].kind) != NULL;
+    }
+    FILE *file = valid ? hp_receipt_open(path, error) : NULL;
+    valid = valid && file != NULL;
+    if (valid)
+    {
+        fputs("{\n  \"schema\": \"buster-hot-placement-proof-v1\",\n  \"passed\": true,\n  \"kind\": \"ET_REL hot-section structural translation\",\n", file);
+        fprintf(file, "  \"shift\": %" PRIu64 ",\n  \"hot_bytes_before\": %" PRIu64 ",\n  \"hot_alignment\": %" PRIu64 ",\n  \"symbols_compared\": %zu,\n  \"relocations_compared\": %zu,\n  \"disclosure_count\": %zu,\n  \"disclosed_nonsemantic_differences\": [\n", proof->shift, proof->hot_bytes_before, proof->hot_alignment, proof->symbols_compared, proof->relocations_compared, proof->disclosure_count);
+        for (size_t i = 0; i < proof->disclosure_count; i += 1)
+        {
+            const HpDisclosure *disclosure = &proof->disclosures[i];
+            fprintf(file, "    {\"kind\": %u, \"meaning\": ", (unsigned)disclosure->kind);
+            hp_receipt_literal(file, hp_receipt_disclosure(disclosure->kind));
+            fputs(", \"section\": ", file);
+            if (disclosure->section == SIZE_MAX)
+            {
+                fputs("null", file);
+            }
+            else
+            {
+                fprintf(file, "%zu", disclosure->section);
+            }
+            fprintf(file, "}%s\n", i + 1 < proof->disclosure_count ? "," : "");
+        }
+        fputs("  ],\n  \"scope\": \"structural object translation only; separate linked geometry, producer/input provenance and image identity gates required\",\n", file);
+        hp_receipt_limits(file);
+        fputs("\n}\n", file);
+        valid = hp_receipt_finish(file, error);
+    }
+    else if (error[0] == 0)
+    {
+        hp_error(error, "invalid object proof receipt metadata");
+    }
+    return valid;
+}
+
+bool hp_receipt_linked(const char *path, const HpLinkedProof *proof, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    error[0] = 0;
+    bool valid = proof != NULL && proof->function_count <= BUSTER_HP_RECEIPT_ITEM_LIMIT && proof->operand_count <= BUSTER_HP_RECEIPT_ITEM_LIMIT && (proof->function_count == 0 || proof->functions != NULL) && (proof->operand_count == 0 || proof->operands != NULL) && hp_receipt_string(proof->normal_output_section) && hp_receipt_string(proof->variant_output_section);
+    for (size_t i = 0; valid && i < proof->function_count; i += 1)
+    {
+        valid = hp_receipt_string(proof->functions[i].name);
+    }
+    FILE *file = valid ? hp_receipt_open(path, error) : NULL;
+    valid = valid && file != NULL;
+    if (valid)
+    {
+        fputs("{\n  \"schema\": \"buster-hot-placement-proof-v1\",\n  \"passed\": true,\n  \"kind\": \"object-qualified linked hot geometry and nonrelocation bytes\",\n", file);
+        fprintf(file, "  \"shift\": %" PRIu64 ",\n  \"hot_input_base\": %" PRIu64 ",\n  \"hot_bytes\": %" PRIu64 ",\n  \"hot_alignment\": %" PRIu64 ",\n  \"normal_output_section\": ", proof->shift, proof->hot_input_base, proof->hot_bytes, proof->hot_alignment);
+        hp_json_string(file, proof->normal_output_section);
+        fputs(",\n  \"variant_output_section\": ", file);
+        hp_json_string(file, proof->variant_output_section);
+        fprintf(file, ",\n  \"function_count\": %zu,\n  \"functions\": [\n", proof->function_count);
+        for (size_t i = 0; i < proof->function_count; i += 1)
+        {
+            const HpLinkedFunction *function = &proof->functions[i];
+            fputs("    {\"name\": ", file);
+            hp_json_string(file, function->name);
+            fprintf(file, ", \"object_symbol\": %zu, \"object_offset\": %" PRIu64 ", \"size\": %" PRIu64 ", \"normal_address\": %" PRIu64 ", \"variant_address\": %" PRIu64 ", \"delta\": %" PRIu64 ", \"normal_residue_4096\": %" PRIu64 ", \"variant_residue_4096\": %" PRIu64 "}%s\n", function->object_symbol, function->object_offset, function->size, function->normal_address, function->variant_address, function->delta, function->normal_residue_4096, function->variant_residue_4096, i + 1 < proof->function_count ? "," : "");
+        }
+        fprintf(file, "  ],\n  \"operand_count\": %zu,\n  \"masked_operand_bytes\": %" PRIu64 ",\n  \"masked_relocation_operands\": [\n", proof->operand_count, proof->masked_operand_bytes);
+        for (size_t i = 0; i < proof->operand_count; i += 1)
+        {
+            const HpLinkedOperand *operand = &proof->operands[i];
+            fprintf(file, "    {\"object_relocation\": %zu, \"offset\": %" PRIu64 ", \"type\": %" PRIu32 ", \"width\": %u}%s\n", operand->object_relocation, operand->offset, operand->type, operand->width, i + 1 < proof->operand_count ? "," : "");
+        }
+        fputs("  ],\n  \"scope\": \"section-header geometry and linked bytes outside proved relocation operands only\",\n  \"requires\": [\n    \"separate full object relocation translation proof\",\n    \"pinned producer/linker and exact ordered link inputs\",\n    \"normal/zero full image SHA256 identity\",\n    \"per-image output preservation controls before timing\"\n  ],\n", file);
+        hp_receipt_limits(file);
+        fputs("\n}\n", file);
+        valid = hp_receipt_finish(file, error);
+    }
+    else if (error[0] == 0)
+    {
+        hp_error(error, "invalid linked proof receipt metadata");
+    }
+    return valid;
+}
+
+bool hp_receipt_identity(const char *path, const char *image, const char *digest, const char *scope, char error[BUSTER_HP_ERROR_CAPACITY])
+{
+    error[0] = 0;
+    bool valid = image != NULL && digest != NULL && scope != NULL;
+    size_t image_size = valid ? strnlen(image, BUSTER_HP_PATH_CAPACITY) : 0;
+    size_t scope_size = valid ? strnlen(scope, BUSTER_HP_PATH_CAPACITY) : 0;
+    size_t digest_size = valid ? strnlen(digest, 65) : 0;
+    valid = valid && image_size > 0 && image_size < BUSTER_HP_PATH_CAPACITY && scope_size > 0 && scope_size < BUSTER_HP_PATH_CAPACITY && digest_size == 64;
+    for (size_t i = 0; valid && i < 64; i += 1)
+    {
+        valid = (digest[i] >= '0' && digest[i] <= '9') || (digest[i] >= 'a' && digest[i] <= 'f');
+    }
+    FILE *file = valid ? hp_receipt_open(path, error) : NULL;
+    valid = valid && file != NULL;
+    if (valid)
+    {
+        fputs("{\n  \"schema\": \"buster-hot-placement-proof-v1\",\n  \"passed\": true,\n  \"kind\": \"file SHA256 identity\",\n  \"image\": ", file);
+        HpString name =
+        {
+            image,
+            image_size
+        };
+        hp_json_string(file, name);
+        fputs(",\n  \"sha256\": ", file);
+        hp_receipt_literal(file, digest);
+        fputs(",\n  \"scope\": ", file);
+        name.data = scope;
+        name.size = scope_size;
+        hp_json_string(file, name);
+        fputs(",\n", file);
+        hp_receipt_limits(file);
+        fputs("\n}\n", file);
+        valid = hp_receipt_finish(file, error);
+    }
+    else if (error[0] == 0)
+    {
+        hp_error(error, "invalid file identity receipt metadata");
+    }
+    return valid;
+}
