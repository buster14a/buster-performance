diff --git a/original/link.sh b/original/link.sh
new file mode 100644
index 0000000..e07ad73
--- /dev/null
+++ b/original/link.sh
@@ -0,0 +1,17 @@
+#!/usr/bin/env bash
+# link.sh TREE VARIANT SHIFT OUT [INSIDE]: TREE/objects/VARIANT.s with SHIFT bytes of .text before its code, and
+# INSIDE bytes at the start of .text.buster_checker after its page alignment (#502's section), assembled for the
+# host (as build.sh's -march=native compiles) and linked in the sources' order with wild, as build.sh links, into OUT.
+set -e
+cd "$1"
+c=$(< objects/checker.index); n=$(< objects/count)
+inside=${5-0}
+work=objects/link-$2-$3-$inside
+mkdir -p "$work"
+{ printf '\t.text\n\t.skip %d\n' "$3"; awk -v k="$inside" '{print} !done && /^\t\.p2align\t12$|^\t\.p2align 12$/ {if (k > 0) printf "\t.skip %d\n", k; done = 1}' "objects/$2.s"; } > "$work/checker.s"
+clang -c -march=native "$work/checker.s" -o "$work/checker.o"
+linked=()
+for ((i = 0; i < n; i += 1)); do
+    if [ "$i" -eq "$c" ]; then linked+=("$work/checker.o"); else linked+=("objects/$i.o"); fi
+done
+clang -no-pie --ld-path="$(command -v wild)" "${linked[@]}" -lm -ldl -o "$4"
diff --git a/original/objects.sh b/original/objects.sh
new file mode 100644
index 0000000..d6b5eb3
--- /dev/null
+++ b/original/objects.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+# objects.sh TREE: TREE's sources compiled as build.sh compiles them, without -g (BUSTER_DEBUG_INFO=0), into
+# TREE/objects/INDEX.o, but main_unit_checker.c, which goes to TREE/objects/checker.s, and with
+# -falign-functions=64 to TREE/objects/checker-align64.s. Run under the lock (8 compiles at once).
+set -e
+cd "$1"
+eval "$(sed -n '/^sources=/p;/^sources+=/p;/^flags=/p' build.sh)"
+mkdir -p objects
+for i in "${!sources[@]}"; do
+    case "${sources[$i]}" in
+        */main_unit_checker.c)
+            echo "clang -S ${sources[$i]} -o objects/checker.s ${flags[*]} -O3"
+            echo "clang -S ${sources[$i]} -o objects/checker-align64.s ${flags[*]} -O3 -falign-functions=64"
+            echo "clang -c ${sources[$i]} -o objects/checker-direct.o ${flags[*]} -O3" ;;
+        *) echo "clang -c ${sources[$i]} -o objects/$i.o ${flags[*]} -O3" ;;
+    esac
+done | xargs -P 8 -I{} sh -c '{}'
+for i in "${!sources[@]}"; do
+    case "${sources[$i]}" in */main_unit_checker.c) echo "$i" > objects/checker.index ;; esac
+done
+echo "${#sources[@]}" > objects/count
