+                emitted->cfg_input.allowed_registers = t1_hook_allowed;
+                emitted->cfg_input.registers[0] = caller | emitted->callee_registers;
+                emitted->crossing_values = buster_t1.preference_crossing;
+            }
+        }
+    }
+    else
+    {
+        buster_t1.allocate_base = T1_A_VALIDATE;
+        buster_t1.intervals_only = buster_t1.preferred_first != 0 && emitted->callee_registers != 0;
+        buster_t1.plain_deferred = buster_t1.intervals_only;
+        t1_row()->quiet = 2;
+        Tier1CfgError allocated = BUSTER_VECTOR_PATH(options->vector) ? tier1_cfg_allocate(&emitted->cfg_input, output, scratch, &emitted->cfg) : tier1_cfg_allocate_scalar(&emitted->cfg_input, output, scratch, &emitted->cfg);
+        if (allocated == TIER1_CFG_OK && buster_t1.intervals_only != 0 && buster_t1.preferred_first == 2)
+        {
+            // The exact variant: put the plain allocation off only where it provably meets no constraint; otherwise run it
+            // now, whole, as without the prototype.
+            const bool quiet = t1_plain_unconstrained(&emitted->cfg_input, &emitted->cfg, t1_row());
+            t1_row()->quiet = quiet;
+            if (!quiet)
+            {
+                buster_t1.intervals_only = 0;
+                buster_t1.plain_deferred = 0;
+                allocated = BUSTER_VECTOR_PATH(options->vector) ? tier1_cfg_allocate(&emitted->cfg_input, output, scratch, &emitted->cfg) : tier1_cfg_allocate_scalar(&emitted->cfg_input, output, scratch, &emitted->cfg);
+            }
+        }
+        else if (allocated == TIER1_CFG_OK && buster_t1.intervals_only == 0 && emitted->callee_registers != 0)
+        {
+            // Without the prototype, the same question of the first allocation's intervals, for the count.
+            t1_row()->quiet = t1_plain_unconstrained(&emitted->cfg_input, &emitted->cfg, t1_row());
+        }
+        buster_t1.allocate_base = T1_B_VALIDATE;
+        if (allocated == TIER1_CFG_OK && buster_t1.intervals_only == 0)
+        {
+            T1Function* row = t1_row();
+            const Tier1CfgInput* problem = &emitted->cfg_input;
+            row->pressure[0] = emitted->cfg.allocation.peak_pressure[0];
+            row->pressure[1] = emitted->cfg.allocation.peak_pressure[1];
+            row->pressure[2] = emitted->cfg.allocation.peak_pressure[2];
+            row->registers0 = (uint32_t)__builtin_popcount(problem->registers[0]);
+            uint32_t taken = 0;
+            for (uint32_t r = 0; r < problem->fixed.count; r += 1)
+            {
+                taken |= problem->fixed.classes[r] == BUSTER_TIER1_ALLOCATE_GPR ? problem->fixed.registers[r] : 0;
+            }
+            row->fixed_general = (uint32_t)__builtin_popcount(taken & problem->registers[0]);
+            for (uint32_t v = 0; problem->definition_registers != 0 && v < problem->value_count; v += 1)
+            {
+                row->pinned += problem->definition_registers[v] != 0;
+            }
+        }
+        buster_t1.intervals_only = 0;
         // A parameter bound to its incoming register over its definition's interval may leave a use there no register:
         // then every parameter is free, the entry's moves bringing each where its allocation has it.
         if (allocated == TIER1_CFG_CONSTRAINT)
@@ -4194,9 +4471,36 @@ static __attribute__((noinline)) Tier1EmitError tier1_emit_cfg_function(const Ti
