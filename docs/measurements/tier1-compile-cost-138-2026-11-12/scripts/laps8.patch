+        const uint32_t end = bound ? cfg->intervals.ends[cfg->value_interval_offsets[v]] : 0;
+        limits[class] = end > limits[class] ? end : limits[class];
+        for (uint32_t use = input->use_offsets[v]; use < input->use_offsets[v + 1]; use += 1)
+        {
+            uint8_t* count = required + (uint64_t)input->use_positions[use] * BUSTER_TIER1_ALLOCATE_CLASSES + class;
+            *count = (uint8_t)(*count + (input->use_required[use] != 0 && *count != UINT8_MAX));
+        }
+    }
+    for (uint64_t k = 0; enough && k < (uint64_t)input->position_count * BUSTER_TIER1_ALLOCATE_CLASSES; k += 1)
+    {
+        const uint32_t class = (uint32_t)(k % BUSTER_TIER1_ALLOCATE_CLASSES);
+        most[class] = required[k] > most[class] ? required[k] : most[class];
+    }
+    for (uint32_t class = 0; class < BUSTER_TIER1_ALLOCATE_CLASSES; class += 1)
+    {
+        enough = enough && (uint32_t)__builtin_popcount(input->registers[class]) >= most[class];
+    }
+    free(required);
+    row->quiet = enough ? 3 : 0;
+    row->required_most = most[BUSTER_TIER1_ALLOCATE_GPR];
+    row->pinned_end = limits[BUSTER_TIER1_ALLOCATE_GPR];
+    return enough;
+}
+
+// MEASUREMENT PROTOTYPE (laps6.patch): the allocator's hook (T1State.preference). The callee-saved step's first half
+// over the candidate's intervals; with BUSTER_T1_PREFERRED_FIRST=4, also whether the plain assignment provably meets no
+// constraint.
+typedef struct T1PreferenceContext
+{
+    const Tier1SelectPlan* plan;
+    const Tier1EmitOptions* options;
+    Arena* output;
+    Arena* scratch;
+    Tier1EmitResult* emitted;
+} T1PreferenceContext;
+
+static uint32_t t1_preference_hook(void* context, const void* candidate, uint32_t** allowed, uint32_t* registers0)
+{
+    const T1PreferenceContext* c = context;
+    t1_hook_candidate = candidate;
+    t1_hook_allowed = 0;
+    t1_hook_crossing = 0;
+    (void)tier1_emit_cfg_callee(c->plan, c->options, c->output, c->scratch, c->emitted);
+    t1_hook_candidate = 0;
+    *allowed = t1_hook_allowed;
+    *registers0 = c->emitted->cfg_input.registers[0] | c->emitted->callee_registers;
+    if (buster_t1.preferred_first == 4 && t1_hook_crossing != 0)
+    {
+        const bool quiet = t1_plain_unconstrained(&c->emitted->cfg_input, candidate, t1_row());
+        t1_row()->quiet = quiet;
+        buster_t1.preference_quiet = quiet;
+    }
+    if ((buster_t1.preferred_first == 5 || buster_t1.preferred_first == 6) && t1_hook_crossing != 0)
+    {
+        buster_t1.verdict_prefix = t1_plain_prefix(&c->emitted->cfg_input, candidate, buster_t1.verdict_limits, t1_row());
+    }
+    return t1_hook_crossing;
+}
+
+// Whether a function's two problems share one allocator call (laps6.patch's prototype).
+static bool t1_shared_allocation(const Tier1EmitResult* emitted)
+{
+    return buster_t1.preferred_first >= 3 && buster_t1.preferred_first <= 6 && emitted->callee_registers != 0;
+}
+
+// The callee-saved step's last part alone, for a function whose allocator call ran the step: the callee-saved registers
+// the general class's fragments took.
+static void t1_callee_used(Tier1EmitResult* emitted)
+{
+    const uint32_t callee = emitted->callee_registers;
+    emitted->callee_used = 0;
+    const Tier1Allocation* allocation = &emitted->cfg.allocation;
+    for (uint32_t i = 0; i < emitted->cfg.intervals.count; i += 1)
+    {
+        for (uint32_t f = allocation->fragment_offsets[i]; emitted->cfg.intervals.classes[i] == BUSTER_TIER1_ALLOCATE_GPR && f < allocation->fragment_offsets[i + 1]; f += 1)
+        {
+            const uint8_t reg = allocation->registers[f];
+            emitted->callee_used |= allocation->kinds[f] == BUSTER_TIER1_ALLOCATE_REGISTER && reg < 16 && ((callee >> reg) & 1) != 0 ? 1u << reg : 0;
+        }
+    }
+}
+
+// The CFG consumer's first allocation, with laps3.patch's, laps5.patch's and laps6.patch's prototypes
+// (tier1_emit_cfg_function's and tier1_emit_function_phase's).
+static Tier1EmitError tier1_emit_cfg_allocate_first(const Tier1SelectPlan* plan, const Tier1EmitOptions* options, Arena* output, Arena* scratch, Tier1EmitResult* emitted)
+{
+    Tier1EmitError error = TIER1_EMIT_OK;
+    if (t1_shared_allocation(emitted))
+    {
+        // One allocator call for both problems: the hook gives it the preferred problem after its intervals.
+        T1PreferenceContext context = { plan, options, output, scratch, emitted };
+        const uint32_t caller = emitted->cfg_input.registers[0];
+        buster_t1.allocate_base = T1_A_VALIDATE;
+        buster_t1.preference = t1_preference_hook;
+        buster_t1.preference_context = &context;
+        t1_row()->quiet = 2;
         Tier1CfgError allocated = BUSTER_VECTOR_PATH(options->vector) ? tier1_cfg_allocate(&emitted->cfg_input, output, scratch, &emitted->cfg) : tier1_cfg_allocate_scalar(&emitted->cfg_input, output, scratch, &emitted->cfg);
+        if (allocated == TIER1_CFG_CONSTRAINT)
+        {
+            emitted->cfg_input.definition_registers = 0;
+            allocated = BUSTER_VECTOR_PATH(options->vector) ? tier1_cfg_allocate(&emitted->cfg_input, output, scratch, &emitted->cfg) : tier1_cfg_allocate_scalar(&emitted->cfg_input, output, scratch, &emitted->cfg);
+        }
+        buster_t1.preference = 0;
+        buster_t1.allocate_base = T1_B_VALIDATE;
+        tier1_emit_diagnose(options, TIER1_EMIT_CAUSE_CFG_ALLOCATION, allocated);
+        error = allocated == TIER1_CFG_OK ? TIER1_EMIT_OK : allocated == TIER1_CFG_CAPACITY ? TIER1_EMIT_MEMORY : allocated == TIER1_CFG_CONSTRAINT ? TIER1_EMIT_ALLOCATION : TIER1_EMIT_INVALID;
+        error = error != TIER1_EMIT_OK || (emitted->cfg.split_count == 0 && (emitted->cfg.temp_slots & ~((1u << BUSTER_TIER1_ALLOCATE_CLASSES) - 1)) == 0) ? error : TIER1_EMIT_ALLOCATION;
+        if (error == TIER1_EMIT_OK)
+        {
+            T1Function* row = t1_row();
+            const bool taken = buster_t1.preference_taken != 0;
+            row->crossing = buster_t1.preference_crossing;
+            row->second = buster_t1.preference_crossing == 0 ? 0 : taken ? 1 : 4;
+            row->same_intervals = taken;
+            if (taken)
+            {
