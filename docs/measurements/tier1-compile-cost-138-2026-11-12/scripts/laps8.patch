+    // it (0 none asked, 1 taken, 2 refused for splits, 3 for a temporary slot, 4 a constraint, 5 capacity, 6 another
+    // error), and whether its intervals' values, starts and ends were the first allocation's.
+    uint32_t crossing;
+    uint32_t second;
+    uint32_t same_intervals;
+    uint32_t calls;
+    uint32_t fixed_ranges;
+    uint32_t fragments;
+    uint32_t moves;
+    uint32_t spills;
+    uint32_t scan_intervals;
+    uint32_t common_intervals;
+    uint32_t splits;
+    // The first allocation's peak pressure by class, the general class's registers then, the general registers its fixed
+    // ranges take, and the values bound to a definition's register (parameters).
+    uint32_t pressure[3];
+    uint32_t registers0;
+    uint32_t fixed_general;
+    uint32_t pinned;
+    // Whether the plain allocation provably meets no constraint (t1_plain_unconstrained): 1 or 0, 2 where it wasn't
+    // asked; the most required uses at one position (the general class's), the end of the last pinned definition's
+    // interval and the general class's peak pressure before it.
+    uint32_t quiet;
+    uint32_t required_most;
+    uint32_t pinned_end;
+    uint32_t pinned_pressure;
+    const uint8_t* name;
+    uint32_t name_length;
+} T1Function;
+
+typedef struct T1State
+{
+    T1Lap* laps;
+    uint64_t lap_count;
+    uint64_t lap_capacity;
+    T1Function* functions;
+    uint64_t function_count;
+    uint64_t function_capacity;
+    // The first function of the unit being compiled, and the units so far.
+    uint64_t unit_first;
+    uint32_t units;
+    // tier1_cfg_allocate_impl's stage base: T1_A_VALIDATE, or T1_B_VALIDATE for a function's later allocations.
+    uint32_t allocate_base;
+    uint64_t anchor_tsc[2];
+    uint64_t anchor_ns[2];
+    const char* path;
+    uint32_t dumped;
+    // A prototype of one allocation (BUSTER_T1_PREFERRED_FIRST in the environment): in a function that calls, the first
+    // tier1_cfg_allocate stops after its intervals (intervals_only), the callee-saved preference's allocation runs from
+    // them, and the plain allocation runs only where that one is refused or has nothing to prefer.
+    // BUSTER_T1_PREFERRED_FIRST=2 is the exact variant: the plain allocation is put off only where it provably meets no
+    // constraint (t1_plain_unconstrained); plain_deferred says whether the function's was.
+    uint32_t preferred_first;
+    uint32_t intervals_only;
+    uint32_t plain_deferred;
+    // laps6.patch's prototype of the design itself (BUSTER_T1_PREFERRED_FIRST=3): one tier1_cfg_allocate for both
+    // problems. After its intervals, the allocator calls `preference`, the callee-saved step's first half, which gives
+    // the preferred problem's registers per value (and the general class's set) from those intervals; the plain
+    // assignment runs for its verdict, the preferred one over the same intervals with another column of registers, and
+    // lookup, slot sharing and edge moves once, for the allocation that stands. BUSTER_T1_PREFERRED_FIRST=4 also skips
+    // the plain assignment where it provably meets no constraint (preference_quiet, t1_plain_unconstrained), and runs it
+    // only if the preferred one is refused. The allocator leaves in preference_taken whether the preferred allocation
+    // stands and in preference_crossing the hook's count.
+    uint32_t (*preference)(void* context, const void* candidate, uint32_t** allowed, uint32_t* registers0);
+    void* preference_context;
+    uint32_t preference_quiet;
+    uint32_t preference_taken;
+    uint32_t preference_crossing;
+    uint32_t preference_refused;
+    // laps7.patch's prototype of the plain assignment's verdict from a prefix (BUSTER_T1_PREFERRED_FIRST=5, with =3's one
+    // call): in the plain problem only a parameter's definition interval is bound to a register, so once the last of
+    // them has ended every interval may take any register of its class, and no required use can find them all held by
+    // intervals required at its position while the class has at least as many registers as the most required uses at
+    // one position. The hook sets verdict_prefix where that holds for every class, with each class's limit (the end of
+    // its last bound definition interval, 0 for none) in verdict_limits; the allocator then calls tier1_allocate with
+    // verdict_mode set, which scans each class's events before its limit and returns whether a constraint was met,
+    // without a result. The whole plain assignment runs only if the preferred one is refused.
+    uint32_t verdict_prefix;
+    uint32_t verdict_mode;
+    uint32_t verdict_limits[4];
+    // laps8.patch's prototype of the verdict inside the preferred assignment (BUSTER_T1_PREFERRED_FIRST=6, with =5's
+    // prefix): one tier1_allocate call for both problems. It validates the intervals and sorts their events once; then,
+    // with verdict_inline set and the plain problem's column of registers in verdict_allowed, it scans each class's
+    // events before its limit with that column, sets verdict_constraint if one meets a constraint, puts the scan's
+    // state back, and assigns the preferred problem as usual.
+    uint32_t verdict_inline;
+    uint32_t verdict_constraint;
+    const uint32_t* verdict_allowed;
+    // A prototype of the pipeline a phase at a time over a batch of functions (BUSTER_T1_BATCH: the most functions a
+    // batch, 0 for none; BUSTER_T1_BATCH_ENTRIES: the typed entries that close one).
+    uint32_t batch;
+    uint64_t batch_entries;
+} T1State;
+
+__attribute__((weak)) T1State buster_t1;
+
+static inline __attribute__((always_inline, unused)) void t1_lap(uint32_t stage)
+{
+    if (__builtin_expect(buster_t1.laps != 0, 0))
+    {
+        T1Lap* lap = buster_t1.laps + buster_t1.lap_count;
+        lap->tsc = __rdtsc();
+        lap->stage = stage;
+        lap->function = (uint32_t)buster_t1.function_count;
+        buster_t1.lap_count += buster_t1.lap_count + 1 < buster_t1.lap_capacity;
+    }
+}
+
+// The function being compiled from here on: body `body` of the current unit. The time since the last lap is no stage's.
+static inline __attribute__((unused)) void t1_function(uint32_t body)
+{
+    if (__builtin_expect(buster_t1.laps != 0, 0))
+    {
+        t1_lap(T1_OTHER);
+        buster_t1.function_count += buster_t1.function_count + 1 < buster_t1.function_capacity;
+        buster_t1.functions[buster_t1.function_count] = (T1Function){ .unit = buster_t1.units, .body = body };
+        buster_t1.allocate_base = T1_A_VALIDATE;
+    }
+}
+
+// The current function's row, or a spare one where the log is off, so that a caller writes fields without a test.
+static inline __attribute__((unused)) T1Function* t1_row(void)
+{
+    static T1Function spare;
+    return buster_t1.laps != 0 ? buster_t1.functions + buster_t1.function_count : &spare;
+}
+
+static inline __attribute__((unused)) uint64_t t1_now_ns(void)
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC_RAW, &now);
+    return (uint64_t)now.tv_sec * UINT64_C(1000000000) + (uint64_t)now.tv_nsec;
+}
+
+static __attribute__((unused)) void t1_dump(void)
+{
+    if (buster_t1.laps != 0 && buster_t1.dumped == 0)
+    {
+        buster_t1.dumped = 1;
+        buster_t1.anchor_tsc[1] = __rdtsc();
+        buster_t1.anchor_ns[1] = t1_now_ns();
+        static const char* const names[] = { T1_STAGE_NAMES };
+        FILE* file = fopen(buster_t1.path, "w");
+        if (file != 0)
+        {
+            fprintf(file, "A\t%llu\t%llu\t%llu\t%llu\n", (unsigned long long)buster_t1.anchor_tsc[0], (unsigned long long)buster_t1.anchor_ns[0],
+                    (unsigned long long)buster_t1.anchor_tsc[1], (unsigned long long)buster_t1.anchor_ns[1]);
+            for (uint32_t s = 0; s < T1_STAGE_COUNT; s += 1)
+            {
+                fprintf(file, "S\t%u\t%s\n", s, names[s]);
+            }
+            for (uint64_t f = 1; f <= buster_t1.function_count; f += 1)
+            {
+                const T1Function* row = buster_t1.functions + f;
+                fprintf(file, "F\t%llu\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%.*s\n", (unsigned long long)f, row->unit, row->body,
+                        row->typed_entries, row->typed_locals, row->lowered_instructions, row->lowered_blocks, row->promoted_locals, row->promoted_instructions, row->promoted_blocks,
+                        row->optimized_instructions, row->optimized_blocks, row->effective_uses, row->cfg_values, row->cfg_blocks, row->cfg_edges, row->cfg_positions, row->cfg_phis,
+                        row->cfg_uses, row->dense_values, row->liveness_iterations, row->intervals, row->allocations, row->records, row->branches, row->chain, row->tier1,
+                        (int)row->name_length, row->name != 0 ? (const char*)row->name : "");
+            }
+            for (uint64_t f = 1; f <= buster_t1.function_count; f += 1)
+            {
+                const T1Function* row = buster_t1.functions + f;
+                fprintf(file, "G\t%llu\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\n", (unsigned long long)f, row->crossing, row->second, row->same_intervals, row->calls, row->fixed_ranges,
+                        row->fragments, row->moves, row->spills, row->scan_intervals, row->common_intervals, row->splits, row->pressure[0], row->pressure[1], row->pressure[2], row->registers0,
+                        row->fixed_general, row->pinned, row->quiet, row->required_most, row->pinned_end, row->pinned_pressure);
+            }
+            for (uint64_t k = 0; k < buster_t1.lap_count; k += 1)
+            {
+                fprintf(file, "L\t%llu\t%u\t%u\n", (unsigned long long)buster_t1.laps[k].tsc, buster_t1.laps[k].stage, buster_t1.laps[k].function);
+            }
+            fclose(file);
+        }
+    }
+}
+
+// Before main: the log's room, touched, where the environment asks for it. Every unit's copy runs; the first one acts.
+static __attribute__((constructor, unused)) void t1_initialize(void)
+{
+    const char* path = getenv("BUSTER_T1_LAPS");
+    const char* preferred = getenv("BUSTER_T1_PREFERRED_FIRST");
+    buster_t1.preferred_first = preferred != 0 ? (uint32_t)strtoul(preferred, 0, 10) : 0;
+    const char* batch = getenv("BUSTER_T1_BATCH");
+    const char* batch_entries = getenv("BUSTER_T1_BATCH_ENTRIES");
+    buster_t1.batch = batch != 0 ? (uint32_t)strtoul(batch, 0, 10) : 0;
+    buster_t1.batch_entries = batch_entries != 0 ? strtoull(batch_entries, 0, 10) : UINT64_MAX;
+    if (path != 0 && buster_t1.laps == 0)
+    {
+        const uint64_t lap_capacity = UINT64_C(1) << 21;
+        const uint64_t function_capacity = UINT64_C(1) << 16;
+        void* laps = mmap(0, lap_capacity * sizeof(T1Lap), PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_POPULATE, -1, 0);
+        void* functions = mmap(0, function_capacity * sizeof(T1Function), PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_POPULATE, -1, 0);
+        if (laps != MAP_FAILED && functions != MAP_FAILED)
+        {
+            buster_t1.functions = functions;
+            buster_t1.function_capacity = function_capacity;
+            buster_t1.lap_capacity = lap_capacity;
+            buster_t1.path = path;
+            buster_t1.allocate_base = T1_A_VALIDATE;
+            buster_t1.anchor_tsc[0] = __rdtsc();
+            buster_t1.anchor_ns[0] = t1_now_ns();
+            buster_t1.laps = laps;
+            atexit(t1_dump);
+        }
+    }
+}
+
+#endif
