+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+//
+// MEASUREMENT ONLY (buster#138's compile-cost attribution, 2026-11-12): not for main. A lap log of Tier 1's pipeline:
+// with BUSTER_T1_LAPS=PATH in the environment, every t1_lap(STAGE) appends the TSC and the stage that the time since
+// the previous lap belongs to, with the function being compiled, and the driver's final stage writes the log to PATH:
+// the TSC's anchors on CLOCK_MONOTONIC_RAW (which `perf record -k CLOCK_MONOTONIC_RAW` stamps its samples with, so a
+// reducer can put each sample in the lap its time falls in), one row per function with its sizes, and the laps.
+// Without the variable a lap is a load and a branch. One thread only: run it on one lane (--lanes 1, or one CPU).
+// The state is one weak object, so that main.c's units share it.
+
+#ifndef BUSTER_TIER1_LAPS_H
+#define BUSTER_TIER1_LAPS_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <sys/mman.h>
+#include <x86intrin.h>
+
+typedef enum T1Stage
+{
+    T1_OTHER,
+    T1_ARENAS,
+    T1_LOWER_VALIDATE,
+    T1_LOWER_PLAN,
+    T1_LOWER_COUNT,
+    T1_LOWER_EMIT,
+    T1_LOWER_VERIFY,
+    T1_INLINE,
+    T1_GVN,
+    T1_SSA_CFG,
+    T1_SSA_CLASSIFY,
+    T1_SSA_PREPARE,
+    T1_SSA_DOMINANCE,
+    T1_SSA_DEFINITIONS,
+    T1_SSA_CONSTRUCT,
+    T1_SSA_SIMPLIFY,
+    T1_SSA_LAYOUT,
+    T1_SSA_FILL,
+    T1_SSA_VERIFY,
+    T1_WIDE,
+    T1_VECTOR_SPLIT,
+    T1_TRUTH,
+    T1_IF_CONVERT,
+    T1_OPT_VERIFY_INPUT,
+    T1_OPT_CFG_USES,
+    T1_OPT_DOMINATORS,
+    T1_OPT_DOMINANCE,
+    T1_OPT_SCCP,
+    T1_OPT_DCE,
+    T1_OPT_REWRITE,
+    T1_FINAL_ROWS,
+    T1_FINAL_CFG,
+    T1_FINAL_DOMINATORS,
+    T1_FINAL_DOMINANCE,
+    T1_SELECT_PREPARE,
+    T1_SELECT_FACTS,
+    T1_SELECT_LABEL,
+    T1_SELECT_PATTERNS,
+    T1_SELECT_USES,
+    T1_CHAIN_LIVENESS,
+    T1_CHAIN_PREPARE,
+    T1_CHAIN_ALLOCATE,
+    T1_CHAIN_FRAME,
+    T1_CHAIN_RECORDS,
+    T1_CFG_PROBLEM,
+    // tier1_cfg_allocate_impl's parts, the first allocation's; the second's (the callee-saved preference's, or a
+    // constraint's retry) are these plus T1_ALLOCATE_PARTS.
+    T1_A_VALIDATE,
+    T1_A_PREPARE,
+    T1_A_LIVENESS,
+    T1_A_LISTS,
+    T1_A_INTERVALS,
+    T1_A_ASSIGN,
+    T1_A_LOOKUP,
+    T1_A_EDGES,
+    T1_B_VALIDATE,
+    T1_B_PREPARE,
+    T1_B_LIVENESS,
+    T1_B_LISTS,
+    T1_B_INTERVALS,
+    T1_B_ASSIGN,
+    T1_B_LOOKUP,
+    T1_B_EDGES,
+    T1_CFG_CALLEE,
+    T1_CFG_SAVES,
+    T1_CFG_FRAME,
+    T1_CFG_RECORDS,
+    T1_CERTIFY,
+    T1_PUBLISH,
+    T1_REST,
+    T1_STAGE_COUNT,
+    // The driver's own stages (c_check_clock.c's CheckStage), from 100: its laps and marks.
+    T1_DRIVER = 100,
+} T1Stage;
+#define T1_ALLOCATE_PARTS (T1_B_VALIDATE - T1_A_VALIDATE)
+
+#define T1_STAGE_NAMES \
+    "other", "arenas", "lower.validate", "lower.plan", "lower.count", "lower.emit", "lower.verify", "inline", "gvn", \
+    "ssa.cfg", "ssa.classify", "ssa.prepare", "ssa.dominance", "ssa.definitions", "ssa.construct", "ssa.simplify", "ssa.layout", "ssa.fill", "ssa.verify", \
+    "wide", "vector-split", "truth", "if-convert", \
+    "opt.verify-input", "opt.cfg-uses", "opt.dominators", "opt.dominance", "opt.sccp", "opt.dce", "opt.rewrite", \
+    "final.rows", "final.cfg", "final.dominators", "final.dominance", \
+    "select.prepare", "select.facts", "select.label", "select.patterns", "select.uses", \
+    "chain.liveness", "chain.prepare", "chain.allocate", "chain.frame", "chain.records", \
+    "cfg.problem", \
+    "alloc1.validate", "alloc1.prepare", "alloc1.liveness", "alloc1.lists", "alloc1.intervals", "alloc1.assign", "alloc1.lookup", "alloc1.edges", \
+    "alloc2.validate", "alloc2.prepare", "alloc2.liveness", "alloc2.lists", "alloc2.intervals", "alloc2.assign", "alloc2.lookup", "alloc2.edges", \
+    "cfg.callee", "cfg.saves", "cfg.frame", "cfg.records", "certify", "publish", "rest"
+
+typedef struct T1Lap
+{
+    uint64_t tsc;
+    uint32_t stage;
+    uint32_t function;
+} T1Lap;
+
+// One compiled function's sizes, as the pipeline's steps saw them. `function` 0 is "no function".
+typedef struct T1Function
+{
+    uint32_t unit;
+    uint32_t body;
+    uint32_t typed_entries;
+    uint32_t typed_locals;
+    uint32_t lowered_instructions;
+    uint32_t lowered_blocks;
+    uint32_t promoted_locals;
+    uint32_t promoted_instructions;
+    uint32_t promoted_blocks;
+    uint32_t optimized_instructions;
+    uint32_t optimized_blocks;
+    uint32_t effective_uses;
+    uint32_t cfg_values;
+    uint32_t cfg_blocks;
+    uint32_t cfg_edges;
+    uint32_t cfg_positions;
+    uint32_t cfg_phis;
+    uint32_t cfg_uses;
+    uint32_t dense_values;
+    uint32_t liveness_iterations;
+    uint32_t intervals;
+    uint32_t allocations;
+    uint32_t records;
+    uint32_t branches;
+    uint32_t chain;
+    uint32_t tier1;
