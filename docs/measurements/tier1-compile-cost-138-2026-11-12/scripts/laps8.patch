+        T1Function* row = t1_row();
+        row->calls = emitted->prepared.call_count;
+        row->fixed_ranges = emitted->cfg_input.fixed.count;
+        row->fragments = emitted->cfg.allocation.fragment_count;
+        row->moves = emitted->cfg.move_count;
+        row->spills = emitted->cfg.allocation.spill_count;
+        row->scan_intervals = emitted->cfg.allocation.scalar_intervals;
+        row->common_intervals = emitted->cfg.allocation.vector_intervals;
+        row->splits = emitted->cfg.split_count;
