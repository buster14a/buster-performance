@@ -17,4 +17,33 @@
 #define BUSTER_SCALAR_PATH(requested) (requested)
 #define BUSTER_VECTOR_PATH(requested) (requested)
 #include <immintrin.h>
+// EXPERIMENT ONLY (#2924 C12a's gate): the preprocessor's areas whose scalar paths this executable takes, by the bits
+// after "-areas" in its file's name (compiler-areas1024: area 10), so that time-runs compares copies of one executable.
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+static __attribute__((unused)) unsigned buster_scalar_area_bits(void)
+{
+    static int cached = -1;
+    if (cached < 0)
+    {
+        char path[4096];
+        const ssize_t length = readlink("/proc/self/exe", path, sizeof(path) - 1);
+        unsigned bits = 0;
+        if (length > 0)
+        {
+            path[length] = 0;
+            const char* at = strstr(path, "-areas");
+            bits = at != 0 ? (unsigned)strtoul(at + 6, 0, 0) : 0;
+        }
+        cached = (int)bits;
+    }
+    return (unsigned)cached;
+}
+static __attribute__((unused)) int buster_scalar_area(unsigned area)
+{
+    return (int)((buster_scalar_area_bits() >> area) & 1u);
+}
+#define BUSTER_VECTOR_AREA(area, requested) (BUSTER_VECTOR_PATH(requested) && !buster_scalar_area(area))
+#define BUSTER_SCALAR_AREA(area, requested) (BUSTER_SCALAR_PATH(requested) || buster_scalar_area(area))
 #endif
