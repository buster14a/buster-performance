== Compare source binding columns on main.c
mapfile -d '' -t host_flags < <(./build.sh print-host-flags)
test "${#host_flags[@]}" -gt 0
"$BUSTER_COMPILER" test-parser-bindings --clang "${host_flags[@]}" -Isrc -fwrapv -funsigned-char --predefines build/predefines.h -DBUSTER_COMPLETE_DRIVER=1 src/buster/compiler/main.c
== Check c-testsuite's programs with their bodies read apart on 8 lanes
# #113: each program checked by the scalar path, the vector path and the deferred reader, whose result must be
# the vector path's column for column, against clang -fsyntax-only; with the identifiers' ids in another order
# (#153's --id-order).
unset CPATH C_INCLUDE_PATH
"$BUSTER_COMPILER" test-checker-corpus --clang clang --deferred 8 --id-order 153 build/c-testsuite/tests/single-exec
== Check the frozen SQLite source against Clang
# --deferred 8 also reads its bodies apart on 8 lanes (#113), whose result must be the vector path's. --symbols
# compares -c's functions and objects with clang -O0 -c's where the backend lowers the file (#129), which it
# does for sqlite3.c since #567 lowers its atomics: SQLITE_INLINE's allocateSpace is ours alone, "inlined".
unset CPATH C_INCLUDE_PATH
export SOURCE_DATE_EPOCH=1792454400
corpus=$BUSTER_CORPUS
"$BUSTER_COMPILER" test-checker-corpus --clang clang --deferred 8 --symbols --report build/checker-sqlite.tsv --no-default-config --target=x86_64-linux-gnu -march=znver5 -std=gnu17 -nostdinc -isystem "$corpus/headers/usr/lib/clang/23/include" -isystem "$corpus/headers/usr/local/include" -isystem "$corpus/headers/usr/include" "$corpus/sqlite/sqlite3.c"
== Test C-source binding identities and scope semantics
"$BUSTER_COMPILER" test-parser-bindings --clang
== Compare source binding columns on the frozen SQLite input
corpus=$BUSTER_CORPUS
"$BUSTER_COMPILER" test-parser-bindings --clang -march=znver5 -nostdinc -isystem "$corpus/headers/usr/lib/clang/23/include" -isystem "$corpus/headers/usr/local/include" -isystem "$corpus/headers/usr/include" "$corpus/sqlite/sqlite3.c"
== Test deferred-body source-position environments
"$BUSTER_COMPILER" test-environments
== Test scoped name-resolution kernels
"$BUSTER_COMPILER" test-bindings
