== Check narrow-unsigned sign comparisons and admitted deferred diagnostics [2 CPUs]
# Both common-warning suites share this grant: they compile independent bodies, request two lanes and assert the
# reported deferred admission. Ordinary driver parts cover the uninitialized cases' default and scalar routes.
"$BUSTER_COMPILER" test-checker-driver --executable "$BUSTER_COMPILER" --sign-compare-only --in-process ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
"$BUSTER_COMPILER" test-checker-driver --executable "$BUSTER_COMPILER" --uninitialized-only --in-process ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
== Compare -c's functions and objects with clang -O0 -c's on frozen musl sources
# #129: each source the checker accepts is written as -c writes it, and must define what clang -O0 -c's object
# does, but for the three documented reasons (docs/c-lowering.md); a file the backend refuses is counted with the
# feature it names. Its acceptance against clang -fsyntax-only is compared too, as for any corpus. These eight
# directories' 542 files that the backend lowers, with every explained difference of musl's (math's), must all
# be compared: a backend that came to refuse them would otherwise pass by comparing none.
unset CPATH C_INCLUDE_PATH
export SOURCE_DATE_EPOCH=1792454400
corpus=$BUSTER_CORPUS
musl="$corpus/libc/musl"
"$BUSTER_COMPILER" test-checker-corpus --clang clang --symbols-minimum 542 --no-default-config --target=x86_64-linux-gnu -march=znver5 -std=c99 -ffreestanding -nostdinc -D_XOPEN_SOURCE=700 -Os -pipe \
  -I "$musl/arch/x86_64" -I "$musl/arch/generic" -I "$corpus/musl-generated/obj/src/internal" -I "$musl/src/include" -I "$musl/src/internal" -I "$corpus/musl-generated/obj/include" -I "$musl/include" \
  "$musl/src/math" "$musl/src/string" "$musl/src/stdlib" "$musl/src/fenv" "$musl/src/legacy" "$musl/src/process" "$musl/src/signal" "$musl/src/multibyte"
== Test deferred function bodies against source order
# #113's fixtures, each through the deferred reader on 1, 2, 3 and 8 lanes with every binding resolution, and
# on 8 with the identifiers' ids in another order (#153's --id-order, 153 by default).
"$BUSTER_COMPILER" test-checker-deferred
== Test typed postorder checking and source fixtures (part 1 of 8)
# --part deals the checks (sections, and check_test_programs' programs) in turn to 8 parts of one CPU each; part 1
# also runs the sections that share the type table. Whole, the command took 141 s on a hosted runner with 2 CPUs,
# of which it kept 1.03 busy.
"$BUSTER_COMPILER" test-checker --seed 133 --part 1/8
== Compare main.c's checking and its functions and objects with clang's
# #129: the compiler's own main.c, with build.sh's flags for a plain -march=znver5 build whatever this run's host,
# sanitizer and fuzzing, and -DBUSTER_COMPLETE_DRIVER=1 for the whole compiler rather than the driver unit's code
# (the unit docs/c-lowering.md measures; docs/commands/build.md): checked by both paths, which must agree, and
# accepted as clang -fsyntax-only accepts it, and its -c object must define what clang -O0 -c's does, but for the
# documented reasons. The one file must be compared, except in the TSan and MSan rows: it is 4,864,411 preprocessed
# tokens (on 2026-11-10), and at 6,323,682 its two paths held 7.5 GiB resident unsanitized and TSan's shadow took the
# same check past 20 GiB, beyond the hosted runner (docs/ci.md). Every other row and the 9700X still run it.
if [ "${BUSTER_SANITIZER:-none}" != thread ] && [ "${BUSTER_SANITIZER:-none}" != memory ]; then
unset CPATH C_INCLUDE_PATH
mapfile -d '' -t flags < <(env -u BUSTER_SANITIZER -u BUSTER_SANITIZER_OPTIMIZATION -u BUSTER_FUZZ_AVAILABLE -u BUSTER_FUZZ_ENTRY \
  BUSTER_HOST_ARCH=znver5 BUSTER_DEBUG_INFO=0 ./build.sh print-compile-flags --config Release)
test "${#flags[@]}" -gt 0
"$BUSTER_COMPILER" test-checker-corpus --clang clang --symbols-minimum 1 "${flags[@]}" -DBUSTER_COMPLETE_DRIVER=1 src/buster/compiler/main.c
else
printf 'SKIP: main.c checking comparison (sanitizer memory budget; docs/ci.md)\n'
exit 77
fi
== Check semantic mutants of the frozen SQLite and musl sources against Clang
# #133: each mutant is one edit of a unit's -E text (a type changed, a declaration removed, operands swapped),
# checked as a file is: acceptance and the first error's line against clang -fsyntax-only, and both paths
# alike. The seed and counts are fixed; docs/c-checker.md has the wider campaigns.
unset CPATH C_INCLUDE_PATH
export SOURCE_DATE_EPOCH=1792454400
corpus=$BUSTER_CORPUS
system=(-nostdinc -isystem "$corpus/headers/usr/lib/clang/23/include" -isystem "$corpus/headers/usr/local/include" -isystem "$corpus/headers/usr/include")
musl="$corpus/libc/musl"
"$BUSTER_COMPILER" test-checker-corpus --clang clang --semantic-mutations 8 --seed 133 --minimize 0 --no-default-config --target=x86_64-linux-gnu -march=znver5 -std=gnu17 "${system[@]}" "$corpus/sqlite/sqlite3.c"
"$BUSTER_COMPILER" test-checker-corpus --clang clang --semantic-mutations 96 --seed 133 --minimize 0 --no-default-config --target=x86_64-linux-gnu -march=znver5 -std=c99 -ffreestanding -nostdinc -D_XOPEN_SOURCE=700 -Os -pipe \
  -I "$musl/arch/x86_64" -I "$musl/arch/generic" -I "$corpus/musl-generated/obj/src/internal" -I "$musl/src/include" -I "$musl/src/internal" -I "$corpus/musl-generated/obj/include" -I "$musl/include" \
  --files-from tests/preprocessor-oracle/musl-subset.txt --root "$musl"
