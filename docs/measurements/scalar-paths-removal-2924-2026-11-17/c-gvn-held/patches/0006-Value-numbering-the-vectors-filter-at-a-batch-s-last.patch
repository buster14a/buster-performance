From 727a4747573071e2764f408efe9397e684f867a3 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 23 Nov 2026 20:46:45 +0000
Subject: [PATCH 6/6] Value numbering: the vectors filter at a batch's last
 lane (#2924)

The mutation round's survivor v1 dropped the filter's last lane: a
fixture puts a scalar duplicate at instruction 15, which the vectors
policy must keep.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EgbxngY8HBj6wFPMjAjgYD
Signed-off-by: David Gonzalez Martin <davidgmbb@gmail.com>
---
 src/buster/compiler/ir_optimize_gvn_test.c | 49 ++++++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/src/buster/compiler/ir_optimize_gvn_test.c b/src/buster/compiler/ir_optimize_gvn_test.c
index f97ea52d..29f9e037 100644
--- a/src/buster/compiler/ir_optimize_gvn_test.c
+++ b/src/buster/compiler/ir_optimize_gvn_test.c
@@ -753,6 +753,54 @@ static void ir_gvn_test_vectors(IrOptimizeTest* test)
     arena_release(&scratch);
 }
 
+// IrGvnOptions.vectors at a batch's last lane: the scalar duplicate at instruction 15 stays its own value.
+static void ir_gvn_test_vectors_tail(IrOptimizeTest* test)
+{
+    static const char text[] = "function (i32) -> m16 {\n"
+                               "b0:\n"
+                               "  %0 = param.i32 0\n"
+                               "  %1 = add.i32 %0, %0\n"
+                               "  %2 = add.i32 %1, %0\n"
+                               "  %3 = add.i32 %2, %0\n"
+                               "  %4 = add.i32 %3, %0\n"
+                               "  %5 = add.i32 %4, %0\n"
+                               "  %6 = add.i32 %5, %0\n"
+                               "  %7 = add.i32 %6, %0\n"
+                               "  %8 = add.i32 %7, %0\n"
+                               "  %9 = add.i32 %8, %0\n"
+                               "  %10 = add.i32 %9, %0\n"
+                               "  %11 = add.i32 %10, %0\n"
+                               "  %12 = add.i32 %11, %0\n"
+                               "  %13 = add.i32 %12, %0\n"
+                               "  %14 = add.i32 %13, %0\n"
+                               "  %15 = add.i32 %0, %0\n"
+                               "  %16 = add.i32 %15, %14\n"
+                               "  %17 = intrinsic.v4i32 %16 splat\n"
+                               "  %18 = vcmp.m16 %17, %17 eq lanes=i8\n"
+                               "  %19 = ret.void %18\n"
+                               "}\n";
+    Arena input = arena_reserve(UINT64_C(16) << 20);
+    Arena output = arena_reserve(UINT64_C(16) << 20);
+    Arena scratch = arena_reserve(UINT64_C(16) << 20);
+    IrFunction f = { 0 };
+    const bool ready = input.base != NULL && output.base != NULL && scratch.base != NULL;
+    const IrParseResult parsed = ready ? ir_parse((String8){ .pointer = (char*)text, .length = sizeof(text) - 1 }, &input, &scratch, &f) : (IrParseResult){ .error = IR_PARSE_END };
+    const bool fixture = parsed.error == IR_PARSE_OK && parsed.check.error == IR_OK;
+    ir_optimize_test_expect(test, fixture, "GVN's vector-only tail fixture parses");
+    for (uint32_t policy = 0; fixture && policy < 2; policy += 1)
+    {
+        IrGvnOptions options = ir_gvn_options();
+        options.vectors = policy != 0;
+        IrGvnResult result = { 0 };
+        const IrCheck check = ir_optimize_gvn(&f, &output, &scratch, options, &result);
+        ir_optimize_test_expect(test, check.error == IR_OK && result.removed == (policy != 0 ? 0u : 1u), "GVN's vector-only policy keeps a scalar duplicate in a batch's last lane");
+        arena_pop_to(&output, 0);
+    }
+    arena_release(&input);
+    arena_release(&output);
+    arena_release(&scratch);
+}
+
 // The width changes (#1840) on values SCCP can't fold, a parameter's splat: GVN merges an insert, an extract and a widen
 // equal to another, keeps the insert and the extract of another part (the intrinsic's flags) apart, and the
 // interpreter's mask is unchanged.
@@ -910,6 +958,7 @@ static __attribute__((unused)) int run_ir_gvn_tests(int argc, char** argv)
         ir_gvn_test_ir(&test);
         ir_gvn_test_simd(&test);
         ir_gvn_test_vectors(&test);
+        ir_gvn_test_vectors_tail(&test);
         ir_gvn_test_widths(&test);
         ir_gvn_test_payloads(&test);
         if (frozen)
