From: Claude <noreply@anthropic.com>
Date: Mon, 23 Nov 2026 20:22:02 +0000
Subject: [PATCH 3/6] Value numbering: the pressure item's comment names the
 pass (#2924)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EgbxngY8HBj6wFPMjAjgYD
Signed-off-by: David Gonzalez Martin <davidgmbb@gmail.com>
---
 src/buster/compiler/c_check_program_emit.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/buster/compiler/c_check_program_emit.c b/src/buster/compiler/c_check_program_emit.c
index 8b585804..f4648cc8 100644
--- a/src/buster/compiler/c_check_program_emit.c
+++ b/src/buster/compiler/c_check_program_emit.c
@@ -602,7 +602,7 @@ struct CheckEmitGrowth
 // it takes 6.2% of the loop kernels' cycles, and none of speedtest1's or Lua's beyond code placement's, for 3.4% of
 // sqlite3.c's --tier1 compile (docs/ir-loop-motion.md's "The pressure policy").
 #define BUSTER_CHECK_TIER1_PASS_HOIST 16384u
-// #866's solver under #2719's pressure policy (ir_optimize_gvn.c's IrGvnOptions.pressure), on promoted SSA after
+// Value numbering under #2719's pressure policy (ir_optimize_gvn.c's IrGvnOptions.pressure), on promoted SSA after
 // if-conversion and before LICM, off by default: on the 9700X it takes none of speedtest1's or Lua's cycles beyond code
 // placement's, for 16.2% of sqlite3.c's --tier1 compile.
 #define BUSTER_CHECK_TIER1_PASS_NUMBERING 32768u
