From 3c113b52201296bb2af628a8eb06a33323716883 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 23 Nov 2026 20:30:59 +0000
Subject: [PATCH 4/6] Value numbering: a key without the impure word, and a
 payload fixture (#2924)

Only pure instructions enter the walk's table, so the word that kept an
impure instruction's key unique was never read: it goes, and the keys are
six words. The mutation round of the deletion showed two key words no
fixture distinguished: test-ir-gvn's payload fixture keeps addresses of
another scale, 128-bit constants of another high word and selects of
another third operand apart, and merges their equal copies.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EgbxngY8HBj6wFPMjAjgYD
Signed-off-by: David Gonzalez Martin <davidgmbb@gmail.com>
---
 src/buster/compiler/ir_optimize_gvn.c      |  5 +-
 src/buster/compiler/ir_optimize_gvn_test.c | 62 ++++++++++++++++++++++
 2 files changed, 64 insertions(+), 3 deletions(-)

diff --git a/src/buster/compiler/ir_optimize_gvn.c b/src/buster/compiler/ir_optimize_gvn.c
index 6003907d..2056af3f 100644
--- a/src/buster/compiler/ir_optimize_gvn.c
+++ b/src/buster/compiler/ir_optimize_gvn.c
@@ -10,8 +10,8 @@
 // refinement rounds) took 1.07 to 1.15 times its ticks in every size bin of Tier 1's pipeline (#2924's 6987893038). A
 // vectorized value numbering that wins at every size, and recovers the partition's phi congruences, is #3433.
 
-// A key's words: the meta word, the payload's two, the three operands' classes, and an impure instruction's own number.
-#define BUSTER_IR_GVN_FIELDS 7
+// A key's words: the meta word, the payload's two and the three operands' classes. Only pure instructions have keys.
+#define BUSTER_IR_GVN_FIELDS 6
 #define BUSTER_IR_GVN_HASH_BASIS UINT64_C(1469598103934665603)
 #define BUSTER_IR_GVN_HASH_MULTIPLIER UINT64_C(1099511628211)
 
@@ -278,7 +278,6 @@ static void ir_gvn_key(IrGvnWork* work, uint32_t i)
     work->fields[n * 3 + i] = (mask & 1) != 0 ? work->classes[ir_gvn_resolve(work->alias, f->a[i])] : 0;
     work->fields[n * 4 + i] = (mask & 2) != 0 ? work->classes[ir_gvn_resolve(work->alias, f->b[i])] : 0;
     work->fields[n * 5 + i] = (mask & 4) != 0 ? work->classes[ir_gvn_resolve(work->alias, ir_value_third(f, i))] : 0;
-    work->fields[n * 6 + i] = work->pure[i] == 0 ? (uint64_t)i + 1 : 0;
 }
 
 static uint64_t ir_gvn_hash_one(const IrGvnWork* work, uint32_t i)
diff --git a/src/buster/compiler/ir_optimize_gvn_test.c b/src/buster/compiler/ir_optimize_gvn_test.c
index 4bc676a0..9778d435 100644
--- a/src/buster/compiler/ir_optimize_gvn_test.c
+++ b/src/buster/compiler/ir_optimize_gvn_test.c
@@ -802,6 +802,67 @@ static void ir_gvn_test_widths(IrOptimizeTest* test)
     arena_release(&scratch);
 }
 
+// A key's payload and third operand: addresses that differ in their scale alone, 128-bit constants that differ in their
+// high word alone and selects that differ in their third operand alone stay apart; their equal copies merge.
+static void ir_gvn_test_payloads(IrOptimizeTest* test)
+{
+    static const char text[] = "function (ptr, i64) -> i64 {\n"
+                               "b0:\n"
+                               "  %0 = param.ptr 0\n"
+                               "  %1 = param.i64 1\n"
+                               "  %2 = address.ptr %0 + %1 * 4 offset=8\n"
+                               "  %3 = address.ptr %0 + %1 * 8 offset=8\n"
+                               "  %4 = address.ptr %0 + %1 * 4 offset=8\n"
+                               "  %5 = const.i128 0x00000000000000010000000000000005\n"
+                               "  %6 = const.i128 0x00000000000000020000000000000005\n"
+                               "  %7 = const.i128 0x00000000000000010000000000000005\n"
+                               "  %8 = ptrtoint.i64 %2\n"
+                               "  %9 = ptrtoint.i64 %3\n"
+                               "  %10 = ptrtoint.i64 %4\n"
+                               "  %11 = xor.i128 %5, %6\n"
+                               "  %12 = xor.i128 %11, %7\n"
+                               "  %13 = trunc.i64 %12\n"
+                               "  %14 = add.i64 %8, %9\n"
+                               "  %15 = add.i64 %14, %10\n"
+                               "  %16 = add.i64 %15, %13\n"
+                               "  %17 = icmp.i1 %1, %13 ult\n"
+                               "  %18 = select.i64 %17, %8, %9\n"
+                               "  %19 = select.i64 %17, %8, %10\n"
+                               "  %20 = select.i64 %17, %8, %9\n"
+                               "  %21 = add.i64 %18, %19\n"
+                               "  %22 = add.i64 %21, %20\n"
+                               "  %23 = add.i64 %22, %16\n"
+                               "  %24 = ret.void %23\n"
+                               "}\n";
+    Arena input = arena_reserve(UINT64_C(16) << 20);
+    Arena output = arena_reserve(UINT64_C(16) << 20);
+    Arena scratch = arena_reserve(UINT64_C(16) << 20);
+    IrFunction f = { 0 };
+    const bool ready = input.base != NULL && output.base != NULL && scratch.base != NULL;
+    const IrParseResult parsed = ready ? ir_parse((String8){ .pointer = (char*)text, .length = sizeof(text) - 1 }, &input, &scratch, &f) : (IrParseResult){ .error = IR_PARSE_END };
+    const bool fixture = parsed.error == IR_PARSE_OK && parsed.check.error == IR_OK;
+    ir_optimize_test_expect(test, fixture, "GVN's payload fixture parses");
+    if (fixture)
+    {
+        IrGvnResult result = { 0 };
+        const IrCheck check = ir_optimize_gvn(&f, &output, &scratch, ir_gvn_options(), &result);
+        uint32_t addresses = 0;
+        uint32_t constants = 0;
+        uint32_t selects = 0;
+        for (uint32_t i = 0; check.error == IR_OK && i < result.function.instruction_count; i += 1)
+        {
+            addresses += result.function.op[i] == IR_ADDRESS;
+            constants += result.function.op[i] == IR_CONST && result.function.type[i] == IR_I128;
+            selects += result.function.op[i] == IR_SELECT;
+        }
+        ir_optimize_test_expect(test, check.error == IR_OK && result.removed == 4 && addresses == 2 && constants == 2 && selects == 2,
+                                "GVN keeps addresses of another scale, constants of another high word and selects of another third operand apart");
+    }
+    arena_release(&input);
+    arena_release(&output);
+    arena_release(&scratch);
+}
+
 static __attribute__((unused)) int run_ir_gvn_tests(int argc, char** argv)
 {
     IrOptimizeTest test = {
@@ -833,6 +894,7 @@ static __attribute__((unused)) int run_ir_gvn_tests(int argc, char** argv)
         ir_gvn_test_simd(&test);
         ir_gvn_test_vectors(&test);
         ir_gvn_test_widths(&test);
+        ir_gvn_test_payloads(&test);
         if (frozen)
         {
             ir_optimize_test_expect(&test, test.gvn_digest == BUSTER_IR_OPTIMIZE_TEST_GVN_DIGEST, "value numbering's results have their frozen digest");
-- 
