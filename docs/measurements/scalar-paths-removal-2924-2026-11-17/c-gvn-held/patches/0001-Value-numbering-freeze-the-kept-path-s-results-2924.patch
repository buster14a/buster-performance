From 4d25949a4656ea41cbd6746a51975f8447548efd Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 23 Nov 2026 20:13:57 +0000
Subject: [PATCH 1/6] Value numbering: freeze the kept path's results (#2924)

The owner decided (#2924, 7112387760) that value numbering keeps its
scalar available-expression walk as the one implementation: it wins in
every size bin of the C9 gate (6987893038). Before the congruence
partition goes, test-ir-gvn folds every result of the scalar path, each
fixture's function and removed count, into IrOptimizeTest.gvn_digest,
frozen here while the partition is still beside it, for the default seed
that generates the random fixtures. The interpreter checks stay.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EgbxngY8HBj6wFPMjAjgYD
Signed-off-by: David Gonzalez Martin <davidgmbb@gmail.com>
---
 src/buster/compiler/ir_optimize_gvn_test.c | 25 +++++++++++++++++++++-
 src/buster/compiler/ir_optimize_test.c     |  4 ++++
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/src/buster/compiler/ir_optimize_gvn_test.c b/src/buster/compiler/ir_optimize_gvn_test.c
index 86ab1fcf..98a2fdba 100644
--- a/src/buster/compiler/ir_optimize_gvn_test.c
+++ b/src/buster/compiler/ir_optimize_gvn_test.c
@@ -213,6 +213,8 @@ static void ir_gvn_test_compare(IrOptimizeTest* test, const IrFunction* f, Arena
             ir_optimize_test_expect(test, before.status != 4 && before.status == after.status && before.value == after.value && before.effects == after.effects, "GVN vector preserves independently interpreted returns, faults and effects");
             ir_optimize_test_expect(test, before.status == reference.status && before.value == reference.value && before.effects == reference.effects, "GVN scalar preserves independently interpreted returns, faults and effects");
         }
+        ir_optimize_test_fold_function(&test->gvn_digest, &b.function);
+        ir_optimize_test_fold(&test->gvn_digest, b.removed);
         // Values that reach no cycle are numbered without refinement rounds; only the rest are refined.
         ir_optimize_test_expect(test, recurrent ? a.acyclic < f->instruction_count && a.rounds != 0 : a.acyclic == f->instruction_count && a.rounds == 0, "GVN refines exactly the values that reach a cycle");
         // Refining every instruction in synchronous rounds is the acyclic numbering's exact oracle: the same
@@ -822,6 +824,10 @@ static void ir_gvn_test_simd(IrOptimizeTest* test)
                 ir_optimize_test_expect(test, constants == 2 && byte_adds == 1 && short_adds == 1 && floating == 4 && result.removed == 2,
                                         "GVN merges identical payloads and lanes, keeps high-word differences, lane widths and floating effects");
                 ir_optimize_test_simd_semantics(test, &f, &result.function, &scratch);
+                if (path != 0)
+                {
+                    ir_optimize_test_fold_function(&test->gvn_digest, &result.function);
+                }
             }
         }
         // Full equality is mandatory even if an adversarial hash collides on constants differing only in word 7.
@@ -899,6 +905,10 @@ static void ir_gvn_test_vectors(IrOptimizeTest* test)
                 }
                 ir_optimize_test_expect(test, policy == 0 || (scalar_adds == 2 && vector_adds == 1), "GVN's vector-only policy keeps both scalar additions");
                 ir_optimize_test_simd_semantics(test, &f, &results[policy][path].function, &scratch);
+                if (path != 0)
+                {
+                    ir_optimize_test_fold_function(&test->gvn_digest, &results[policy][path].function);
+                }
             }
         }
         ir_optimize_test_expect(test, results[policy][0].function.instruction_count != 0 && results[policy][1].function.instruction_count != 0 &&
@@ -969,6 +979,10 @@ static void ir_gvn_test_widths(IrOptimizeTest* test)
             ir_optimize_test_expect(test, result.removed == 3 && counts[0] == 1 && counts[1] == 1 && counts[2] == 2 && counts[3] == 2 && counts[4] == 1,
                                     "GVN merges equal width changes and keeps those of another part apart");
             ir_optimize_test_simd_semantics(test, &f, &result.function, &scratch);
+            if (path != 0)
+            {
+                ir_optimize_test_fold_function(&test->gvn_digest, &result.function);
+            }
         }
         arena_pop_to(&output, 0);
     }
@@ -979,7 +993,10 @@ static void ir_gvn_test_widths(IrOptimizeTest* test)
 
 static __attribute__((unused)) int run_ir_gvn_tests(int argc, char** argv)
 {
-    IrOptimizeTest test = { .random = 139 };
+    IrOptimizeTest test = {
+        .random = BUSTER_IR_OPTIMIZE_TEST_SEED,
+        .gvn_digest = BUSTER_IR_OPTIMIZE_TEST_DIGEST_BASIS,
+    };
     bool valid = true;
     for (int i = 1; i < argc; i += 1)
     {
@@ -996,6 +1013,8 @@ static __attribute__((unused)) int run_ir_gvn_tests(int argc, char** argv)
         }
     }
     int result = 2;
+    // The digest is frozen for the default seed, which generates the random fixtures.
+    const bool frozen = test.random == BUSTER_IR_OPTIMIZE_TEST_SEED;
     if (valid)
     {
         ir_gvn_test_guards(&test);
@@ -1004,6 +1023,10 @@ static __attribute__((unused)) int run_ir_gvn_tests(int argc, char** argv)
         ir_gvn_test_simd(&test);
         ir_gvn_test_vectors(&test);
         ir_gvn_test_widths(&test);
+        if (frozen)
+        {
+            ir_optimize_test_expect(&test, test.gvn_digest == BUSTER_IR_OPTIMIZE_TEST_GVN_DIGEST, "value numbering's results have their frozen digest");
+        }
         printf("ir-gvn: %" PRIu64 " checks, %" PRIu64 " failures\n", test.checks, test.failures);
         result = test.failures == 0 ? 0 : 1;
     }
diff --git a/src/buster/compiler/ir_optimize_test.c b/src/buster/compiler/ir_optimize_test.c
index 93314d92..6fbf3541 100644
--- a/src/buster/compiler/ir_optimize_test.c
+++ b/src/buster/compiler/ir_optimize_test.c
@@ -31,6 +31,9 @@ struct IrOptimizeTest
     // Value numbering with memory's generated programs' and overflow fixture's results (ir_optimize_memory_test.c), in
     // order, frozen where the pass's vector path and its scalar twin agreed: with the default seed, which generates them.
     uint64_t memory_digest;
+    // Value numbering's results (ir_optimize_gvn_test.c), in order, by its available expressions, the one path #2924
+    // kept: frozen while the congruence partition was still beside it, with the default seed.
+    uint64_t gvn_digest;
 };
 
 #define BUSTER_IR_OPTIMIZE_TEST_DIGEST_BASIS UINT64_C(0xcbf29ce484222325)
@@ -40,6 +43,7 @@ struct IrOptimizeTest
 #define BUSTER_IR_OPTIMIZE_TEST_UNROLL_DIGEST UINT64_C(0xc92a6941c51cf4e2)
 #define BUSTER_IR_OPTIMIZE_TEST_SEED UINT64_C(139)
 #define BUSTER_IR_OPTIMIZE_TEST_MEMORY_DIGEST UINT64_C(0x5d860cd5f67a13ce)
+#define BUSTER_IR_OPTIMIZE_TEST_GVN_DIGEST UINT64_C(0x5b74764bdd7e6b5b)
 
 static void ir_optimize_test_expect(IrOptimizeTest* test, bool condition, const char* description)
 {
-- 
