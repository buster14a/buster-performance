From a5b2c8e565aee83f62aa1ff42b0bf31992c3ada4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 23 Nov 2026 20:36:19 +0000
Subject: [PATCH 5/6] Value numbering: collisions that differ in each key word
 (#2924)

The mutation round's survivor c1 skipped the last key word in
ir_gvn_compare: hashes hid it. test-ir-gvn now compares two keys of equal
hashes that differ in one word alone, each word in turn.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EgbxngY8HBj6wFPMjAjgYD
Signed-off-by: David Gonzalez Martin <davidgmbb@gmail.com>
---
 src/buster/compiler/ir_optimize_gvn_test.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/src/buster/compiler/ir_optimize_gvn_test.c b/src/buster/compiler/ir_optimize_gvn_test.c
index 9778d435..f97ea52d 100644
--- a/src/buster/compiler/ir_optimize_gvn_test.c
+++ b/src/buster/compiler/ir_optimize_gvn_test.c
@@ -52,6 +52,23 @@ static void ir_gvn_test_collisions(IrOptimizeTest* test)
             ir_optimize_test_expect(test, ir_gvn_compare(&work, i - 1, i) != 0 && ir_gvn_compare(&work, i, i) == 0, "GVN hash collisions cannot merge distinct parameter keys");
         }
     }
+    // Two keys of equal hashes that differ in one word alone, each word in turn.
+    for (uint32_t field = 0; field < BUSTER_IR_GVN_FIELDS; field += 1)
+    {
+        IrFunction f = { .instruction_count = 2, .op = operations };
+        operations[0] = IR_ADD;
+        operations[1] = IR_ADD;
+        IrGvnWork work = {
+            .ir = { .function = &f },
+            .hashes = hashes,
+            .fields = fields,
+        };
+        memset(fields, 0, sizeof(fields));
+        hashes[0] = 0;
+        hashes[1] = 0;
+        fields[(uint64_t)field * 2 + 1] = 1;
+        ir_optimize_test_expect(test, ir_gvn_compare(&work, 0, 1) != 0 && ir_gvn_compare(&work, 1, 0) != 0, "GVN compares every key word");
+    }
 }
 
 static bool ir_gvn_test_cycle(Arena* arena, IrFunction* f)
