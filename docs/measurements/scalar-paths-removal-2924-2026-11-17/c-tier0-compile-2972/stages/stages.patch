+// Experiment only (#2972): TSC ticks of Tier 0's compile by stage and path, printed at exit to BUSTER_TIER0_STAGES.
+#include <x86intrin.h>
+static uint64_t tier0_stage_last;
+static uint64_t tier0_stage_ticks[2][12];
+static uint64_t tier0_stage_calls[2];
+static uint64_t tier0_stage_entries[2];
+#define TIER0_STAGE_BEGIN() (tier0_stage_last = __rdtsc())
+#define TIER0_STAGE(v, k) do { const uint64_t tier0_now = __rdtsc(); tier0_stage_ticks[(v) ? 1 : 0][k] += tier0_now - tier0_stage_last; tier0_stage_last = tier0_now; } while (0)
+__attribute__((destructor)) static void tier0_stage_report(void)
+{
+    const char* path = getenv("BUSTER_TIER0_STAGES");
+    FILE* out = path != 0 ? fopen(path, "a") : 0;
+    if (out != 0)
+    {
+        static const char* names[12] = { "setup", "front", "select", "frame", "measure", "output", "emit", "finish", "after-generate", "records", "end", "-" };
+        for (uint32_t v = 0; v < 2; v += 1)
+        {
+            if (tier0_stage_calls[v] != 0)
+            {
+                fprintf(out, "%s: %llu calls, %llu entries\n", v ? "vector" : "scalar", (unsigned long long)tier0_stage_calls[v], (unsigned long long)tier0_stage_entries[v]);
+                for (uint32_t k = 0; k < 11; k += 1)
+                {
+                    fprintf(out, "  %-15s %9.1f ticks a call\n", names[k], (double)tier0_stage_ticks[v][k] / (double)tier0_stage_calls[v]);
+                }
+            }
+        }
+        fclose(out);
+    }
+}
