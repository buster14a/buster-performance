+// EXPERIMENT (#2699 re-measure; never merged): BUSTER_FRAME_SCALAR=1/2 forces the scalar/vector path,
+// BUSTER_FRAME_DUMP=FILE appends each request, BUSTER_FRAME_PROBE=N prints per-size ticks at call N (0: every call).
+#include <stdio.h>
+#include <stdlib.h>
+static uint64_t tier1_frame_probe_ticks[10];
+static uint64_t tier1_frame_probe_bins[10];
+static uint64_t tier1_frame_probe_calls;
+static int tier1_frame_probe_init;
+static int tier1_frame_probe_force;
+static long tier1_frame_probe_at = -1;
+static FILE* tier1_frame_probe_dump;
+static uint32_t tier1_frame_probe_bin(uint32_t count)
+{
+    uint32_t bin = 0;
+    while (bin < 9 && count > (bin == 0 ? 0u : 1u << (bin - 1)))
+    {
+        bin += 1;
+    }
+    return bin;
+}
+static Tier1FrameError tier1_frame_plan_path_probed(const Tier1FrameRequest* request, Arena* output, Arena* scratch, bool scalar, Tier1Frame* result);
 static Tier1FrameError tier1_frame_plan_path(const Tier1FrameRequest* request, Arena* output, Arena* scratch, bool scalar, Tier1Frame* result)
+{
+    if (!tier1_frame_probe_init)
+    {
+        tier1_frame_probe_init = 1;
+        const char* const force = getenv("BUSTER_FRAME_SCALAR");
+        tier1_frame_probe_force = force != 0 ? atoi(force) : 0;
+        const char* const at = getenv("BUSTER_FRAME_PROBE");
+        tier1_frame_probe_at = at != 0 ? atol(at) : -1;
+        const char* const dump = getenv("BUSTER_FRAME_DUMP");
+        tier1_frame_probe_dump = dump != 0 ? fopen(dump, "ab") : 0;
+    }
+    scalar = tier1_frame_probe_force == 1 ? true : (tier1_frame_probe_force == 2 ? false : scalar);
+    if (tier1_frame_probe_dump != 0)
+    {
+        const Tier1FrameSlots* const slots = &request->slots;
+        const uint32_t header[6] = { slots->count, slots->column_count, slots->indices != 0, request->call_count, request->used_callee_saved, request->flags };
+        fwrite(header, 4, 6, tier1_frame_probe_dump);
+        const uint32_t rows = slots->indices != 0 ? slots->column_count : slots->count;
+        if (rows != 0)
+        {
+            fwrite(slots->start, 4, rows, tier1_frame_probe_dump);
+            fwrite(slots->end, 4, rows, tier1_frame_probe_dump);
+            fwrite(slots->size, 4, rows, tier1_frame_probe_dump);
+            fwrite(slots->alignment, 4, rows, tier1_frame_probe_dump);
+        }
+        if (slots->indices != 0 && slots->count != 0)
+        {
+            fwrite(slots->indices, 4, slots->count, tier1_frame_probe_dump);
+        }
+        if (request->call_count != 0)
+        {
+            fwrite(request->calls, sizeof(AbiCall), request->call_count, tier1_frame_probe_dump);
+        }
+        fflush(tier1_frame_probe_dump);
+    }
+    const uint64_t before = __rdtsc();
+    const Tier1FrameError error = tier1_frame_plan_path_probed(request, output, scratch, scalar, result);
+    const uint64_t ticks = __rdtsc() - before;
+    const uint32_t bin = tier1_frame_probe_bin(request->slots.count);
+    tier1_frame_probe_ticks[bin] += ticks;
+    tier1_frame_probe_bins[bin] += 1;
+    tier1_frame_probe_calls += 1;
+    if (tier1_frame_probe_at == 0 || (tier1_frame_probe_at > 0 && tier1_frame_probe_calls == (uint64_t)tier1_frame_probe_at))
+    {
+        uint64_t total = 0;
+        for (uint32_t i = 0; i < 10; i += 1)
+        {
+            total += tier1_frame_probe_ticks[i];
+        }
+        fprintf(stderr, "FRAMEPROBE path=%s calls=%llu ticks=%llu", scalar ? "scalar" : "vector", (unsigned long long)tier1_frame_probe_calls, (unsigned long long)total);
+        for (uint32_t i = 0; i < 10; i += 1)
+        {
+            fprintf(stderr, " b%u=%llu/%llu", i, (unsigned long long)tier1_frame_probe_bins[i], (unsigned long long)tier1_frame_probe_ticks[i]);
+        }
+        fprintf(stderr, "\n");
+    }
+    return error;
+}
+static Tier1FrameError tier1_frame_plan_path_probed(const Tier1FrameRequest* request, Arena* output, Arena* scratch, bool scalar, Tier1Frame* result)
 {
     (void)scalar;
 
