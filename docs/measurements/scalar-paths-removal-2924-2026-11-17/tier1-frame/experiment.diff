+// EXPERIMENT (#2699 re-measure; never merged): --replay FILE plans every dumped request once a pass, in order, on both
+// paths, and prints rdtsc ticks a plan by object-count bin (the bins of tier1_frame.c's probe), medians of 21 passes.
+static int tier1_frame_benchmark_replay(const char* path)
+{
+    FILE* file = fopen(path, "rb");
+    int status = file != 0 ? 0 : 1;
+    uint32_t* words = 0;
+    uint64_t length = 0;
+    if (status == 0)
+    {
+        fseek(file, 0, SEEK_END);
+        length = (uint64_t)ftell(file) / 4;
+        fseek(file, 0, SEEK_SET);
+        words = malloc(length * 4 + 64);
+        status = words != 0 && fread(words, 4, length, file) == length ? 0 : 1;
+        fclose(file);
+    }
+    uint32_t frames = 0;
+    Tier1FrameRequest* requests = status == 0 ? malloc(sizeof(Tier1FrameRequest) * (length / 6 + 1)) : 0;
+    for (uint64_t at = 0; status == 0 && at + 6 <= length; frames += 1)
+    {
+        const uint32_t* header = words + at;
+        Tier1FrameRequest* request = &requests[frames];
+        const uint32_t count = header[0];
+        const uint32_t rows = header[2] != 0 ? header[1] : count;
+        at += 6;
+        *request = (Tier1FrameRequest){
+            .slots = {
+                .start = words + at,
+                .end = words + at + rows,
+                .size = words + at + rows * 2,
+                .alignment = words + at + rows * 3,
+                .count = count,
+                .column_count = header[1],
+            },
+            .call_count = header[3],
+            .used_callee_saved = header[4],
+            .flags = header[5],
+        };
+        at += (uint64_t)rows * 4;
+        if (header[2] != 0)
+        {
+            request->slots.indices = words + at;
+            at += count;
+        }
+        request->calls = (const AbiCall*)(words + at);
+        at += (uint64_t)header[3] * 4;
+        status = at <= length ? 0 : 1;
+    }
+    Arena output = arena_reserve(BUSTER_TIER1_FRAME_BENCHMARK_ARENA_BYTES);
+    Arena scratch = arena_reserve(BUSTER_TIER1_FRAME_BENCHMARK_ARENA_BYTES);
+    uint64_t bins[10] = {0};
+    uint64_t mismatches = 0;
+    for (uint32_t f = 0; status == 0 && f < frames; f += 1)
+    {
+        bins[tier1_frame_probe_bin(requests[f].slots.count)] += 1;
+        Tier1Frame a;
+        Tier1Frame b;
+        const Tier1FrameError ea = tier1_frame_plan_scalar(&requests[f], &output, &scratch, &a);
+        const Tier1FrameError eb = tier1_frame_plan(&requests[f], &output, &scratch, &b);
+        bool same = ea == eb;
+        if (same && ea == TIER1_FRAME_OK)
+        {
+            same = a.slot_count == b.slot_count && a.object_bytes == b.object_bytes && a.stack_adjust_bytes == b.stack_adjust_bytes &&
+                (a.count == 0 || (memcmp(a.slot, b.slot, a.count * 4) == 0 && memcmp(a.offset, b.offset, a.count * 4) == 0));
+        }
+        mismatches += !same;
+        arena_pop_to(&output, 0);
+        arena_pop_to(&scratch, 0);
+    }
+    double ticks[2][10][BUSTER_TIER1_FRAME_BENCHMARK_PASSES];
+    double totals[2][BUSTER_TIER1_FRAME_BENCHMARK_PASSES];
+    for (uint32_t pass = 0; status == 0 && pass < BUSTER_TIER1_FRAME_BENCHMARK_PASSES; pass += 1)
+    {
+        for (uint32_t order = 0; order < 2; order += 1)
+        {
+            const uint32_t which = order ^ (pass & 1);
+            uint64_t sums[10] = {0};
+            uint64_t total = 0;
+            for (uint32_t f = 0; f < frames; f += 1)
+            {
+                Tier1Frame frame;
+                const uint64_t before = __rdtsc();
+                const Tier1FrameError error = which == 0 ? tier1_frame_plan_scalar(&requests[f], &output, &scratch, &frame) : tier1_frame_plan(&requests[f], &output, &scratch, &frame);
+                const uint64_t spent = __rdtsc() - before;
+                __asm__ volatile("" : : "r"(&frame), "r"(error) : "memory");
+                sums[tier1_frame_probe_bin(requests[f].slots.count)] += spent;
+                total += spent;
+                arena_pop_to(&output, 0);
+                arena_pop_to(&scratch, 0);
+            }
+            for (uint32_t bin = 0; bin < 10; bin += 1)
+            {
+                ticks[which][bin][pass] = bins[bin] != 0 ? (double)sums[bin] / bins[bin] : 0;
+            }
+            totals[which][pass] = (double)total;
+        }
+    }
+    if (status == 0)
+    {
+        printf("replay file=%s frames=%u mismatches=%llu\n", path, frames, (unsigned long long)mismatches);
+        const char* const names[10] = {"0", "1", "2", "3-4", "5-8", "9-16", "17-32", "33-64", "65-128", "129+"};
+        for (uint32_t bin = 0; bin < 10; bin += 1)
+        {
+            if (bins[bin] != 0)
+            {
+                tier1_frame_benchmark_sort(ticks[0][bin]);
+                tier1_frame_benchmark_sort(ticks[1][bin]);
+                const double sc = ticks[0][bin][BUSTER_TIER1_FRAME_BENCHMARK_PASSES / 2];
+                const double vc = ticks[1][bin][BUSTER_TIER1_FRAME_BENCHMARK_PASSES / 2];
+                printf("  bin=%s frames=%llu scalar_ticks/plan=%.1f vector_ticks/plan=%.1f vector/scalar=%.3f\n", names[bin], (unsigned long long)bins[bin], sc, vc, vc / sc);
+            }
+        }
+        tier1_frame_benchmark_sort(totals[0]);
+        tier1_frame_benchmark_sort(totals[1]);
+        const double sc = totals[0][BUSTER_TIER1_FRAME_BENCHMARK_PASSES / 2];
+        const double vc = totals[1][BUSTER_TIER1_FRAME_BENCHMARK_PASSES / 2];
+        printf("  total scalar_ticks=%.0f vector_ticks=%.0f vector/scalar=%.3f\n", sc, vc, vc / sc);
+    }
+    return status | (mismatches != 0);
+}
+
 int run_tier1_frame_benchmark(int argc, char** argv)
 {
+    if (argc == 3 && strcmp(argv[1], "--replay") == 0)
+    {
+        return tier1_frame_benchmark_replay(argv[2]);
+    }
     int only = -1;
     int selected_phase = -1;
     uint32_t after_ms = 0;
