index ef75b5ba6..70f3066d9 100644
--- a/src/buster/compiler/c_preprocessor_impl.c
+++ b/src/buster/compiler/c_preprocessor_impl.c
@@ -1416,6 +1416,16 @@ static bool pp_same_definition(const Preprocessor* pp, const PPMacro* a, const P
 
 static void pp_scan_body_vector(const uint8_t* kinds, const uint32_t* values, uint32_t begin, uint32_t end, bool* pastes, bool* hashes, bool* va_opt)
 {
+    // A one-token list has three possible marks. Compare its kind with all three at once.
+    if (end - begin == 1)
+    {
+        const __m128i marks = _mm_cvtsi32_si128(C_TOKEN_HASHHASH | (C_TOKEN_HASH << 8) | (C_TOKEN_RAW_IDENTIFIER << 16));
+        const __mmask16 match = _mm_cmpeq_epi8_mask(_mm_set1_epi8(kinds[begin] & 0x7f), marks);
+        *pastes = (match & 1) != 0;
+        *hashes = (match & 2) != 0;
+        *va_opt = (match & 4) != 0 && values[begin] == C_NAME_VA_OPT;
+        return;
+    }
     uint64_t found_pastes = 0;
     uint64_t found_hashes = 0;
     uint64_t found_va_opt = 0;
