#!/bin/bash
set -euo pipefail
root=~/buster-fast-bench/ppbody-codex-6b097f86
corpus=/var/lib/buster-9700x/corpora/preprocessor-391e729af658
musl=$corpus/libc/musl
lua=~/buster-fast-bench/2924-c-df-claude/c3pr/inputs/lua-5.4.8/src
export LC_ALL=C
group=$1
case "$group" in
sqlite) args=(-DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_THREADSAFE=0 -DSQLITE_ENABLE_MEMSYS5 -DSQLITE_ENABLE_RTREE -I"$corpus/sqlite" "$corpus/sqlite/sqlite3.c");;
lua) args=("$lua"/*.c);;
musl) args=(-std=c99 -nostdinc -ffreestanding -D_XOPEN_SOURCE=700 -I "$musl/arch/x86_64" -I "$musl/arch/generic" -I "$corpus/musl-generated/obj/src/internal" -I "$musl/src/include" -I "$musl/src/internal" -I "$corpus/musl-generated/obj/include" -I "$musl/include"); declare -A seen; for f in "$musl"/src/*/*.c "$musl"/src/*/x86_64/*.c; do b=${f##*/}; if [[ -z ${seen[$b]:-} ]]; then seen[$b]=1; args+=("$f"); fi; done;;
dense) args=(--window-bytes 64 "$root/dense.c");;
esac
cd "$root"
out="$root/single-$group"
mkdir -p "$out"
export EXCLUSIVE_OWNER=codex-ppbody-6b097f86 EXCLUSIVE_TITLE='pp_define direct single-token classification' EXCLUSIVE_LINK=https://github.com/buster14a/buster/issues/2924
for mode in 0 1 2 4; do
  "$root/locked" bash -c 'set -eo pipefail; out=$1; shift; "$@" 2>"$out.stderr" | sha256sum >"$out.sha"' _ "$out/mode$mode" "$root/pp-bodymode$mode" -E "${args[@]}"
  cmp "$out/mode0.stderr" "$out/mode$mode.stderr"
  cmp "$out/mode0.sha" "$out/mode$mode.sha"
done
"$root/pp-bodymode0" ab --rounds 5 --cpu 2 --lock "$HOME/buster-fast-bench/exclusive.sh" "$root/pp-bodymode0" -- time-runs --runs 5 --directory "$out" --build vector "$root/pp-bodymode0" --build scalar "$root/pp-bodymode1" --build single "$root/pp-bodymode2" --build control "$root/pp-bodymode4" --list -E "${args[@]}" >"$root/single-$group.log" 2>&1
