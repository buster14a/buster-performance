     memcpy(stream + 2, data, length);
@@ -165,7 +179,7 @@ static void inflate_test_adler(InflateTestTally* tally, uint64_t seed)
     };
     for (uint32_t i = 0; i < BUSTER_ARRAY_LENGTH(known); i += 1)
     {
