#!/bin/bash
set -euo pipefail
root=~/buster-fast-bench/x87-codex-6b097f86
cd "$root"
export EXCLUSIVE_OWNER=codex-x87-6b097f86 EXCLUSIVE_TITLE="x87 full compiler, balanced order" EXCLUSIVE_LINK=https://github.com/buster14a/buster/issues/2924
for tier in tier0 tier1; do
 flags=(); if [[ $tier == tier1 ]]; then flags=(--tier1); fi
 mkdir -p "$root/qbalanced-$tier"
 for rep in 0 1 2; do
  case $rep in
    0) order=(fresh correct-head fresh-control);;
    1) order=(correct-head fresh-control fresh);;
    2) order=(fresh-control fresh correct-head);;
  esac
  builds=(); for name in "${order[@]}"; do builds+=(--build "$name" "$root/$name"); done
  "$root/fresh" ab --rounds 3 --cpu 2 --lock "$HOME/buster-fast-bench/exclusive.sh" "$root/fresh" -- time-runs --runs 5 --directory "$root/qbalanced-$tier" "${builds[@]}" --list -c --lanes 1 "${flags[@]}" "$root/long-double.c" >"$root/qbalanced-$tier-$rep.log" 2>&1
 done
done
echo passed >qbalanced.status
