#!/bin/bash
set -euo pipefail
root=~/buster-fast-bench/x87-codex-6b097f86
corpus=/var/lib/buster-9700x/corpora/preprocessor-391e729af658
musl=$corpus/libc/musl
lua=~/buster-fast-bench/2924-c-df-claude/c3pr/inputs/lua-5.4.8/src
export LC_ALL=C
mode=$1; group=$2
case "$group" in
sqlite) args=(-DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_THREADSAFE=0 -DSQLITE_ENABLE_MEMSYS5 -DSQLITE_ENABLE_RTREE -I"$corpus/sqlite" "$corpus/sqlite/sqlite3.c");;
lua) args=("$lua"/*.c);;
musl) args=(-std=c99 -nostdinc -ffreestanding -D_XOPEN_SOURCE=700 -I "$musl/arch/x86_64" -I "$musl/arch/generic" -I "$corpus/musl-generated/obj/src/internal" -I "$musl/src/include" -I "$musl/src/internal" -I "$corpus/musl-generated/obj/include" -I "$musl/include"); declare -A seen; for f in "$musl"/src/*/*.c "$musl"/src/*/x86_64/*.c; do b=${f##*/}; if [[ -z ${seen[$b]:-} ]]; then seen[$b]=1; args+=("$f"); fi; done;;
long-double) args=("$root/long-double.c");;
*) exit 2;;
esac
case "$mode" in
 tier1) flags=(--tier1);;
 tier0) flags=();;
 *) exit 2;;
esac
out="$root/qfinal-$mode-$group"
mkdir -p "$out"
cd "$root"
export EXCLUSIVE_OWNER=codex-x87-6b097f86 EXCLUSIVE_TITLE="x87 whole compiler, balanced order" EXCLUSIVE_LINK=https://github.com/buster14a/buster/issues/2924
 for rep in 0 1 2; do
  case $rep in
    0) order=(fresh correct-head fresh-control);;
    1) order=(correct-head fresh-control fresh);;
    2) order=(fresh-control fresh correct-head);;
  esac
  builds=(); for name in "${order[@]}"; do builds+=(--build "$name" "$root/$name"); done
  "$root/fresh" ab --rounds 2 --cpu 2 --lock "$HOME/buster-fast-bench/exclusive.sh" "$root/fresh" -- time-runs --runs 5 --directory "$out" "${builds[@]}" --list -c --lanes 1 "${flags[@]}" "${args[@]}" >"$root/qfinal-$mode-$group-$rep.log" 2>&1
 done
