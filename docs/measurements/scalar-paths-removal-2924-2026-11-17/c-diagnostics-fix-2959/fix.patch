+// diagnostic_sort's path for BUSTER_DIAGNOSTIC_SMALL_COUNT records or fewer, which the radix sort's 16 passes cost more
+// than (#2959): insertion, stable, comparing each record's two keys as one 128-bit number (source above sequence),
+// which takes one branch a step where the twin's two comparisons take two. A 64-byte-aligned function of its own, so
+// that its loop's placement doesn't move with its callers' code: in diagnostic_sort, the twin's loop ran 1.07 to 1.5
+// times as long as the same loop inlined in the benchmark on the 9700X.
+static __attribute__((noinline, aligned(64))) void diagnostic_sort_small(DiagnosticOrder* items, uint32_t count)
+{
+    for (uint32_t i = 1; i < count; i += 1)
+    {
+        const DiagnosticOrder value = items[i];
+        const unsigned __int128 key = (unsigned __int128)value.source << 64 | value.sequence;
+        uint32_t at = i;
+        while (at != 0 && key < ((unsigned __int128)items[at - 1].source << 64 | items[at - 1].sequence))
+        {
+            items[at] = items[at - 1];
+            at -= 1;
+        }
+        items[at] = value;
+    }
+}
