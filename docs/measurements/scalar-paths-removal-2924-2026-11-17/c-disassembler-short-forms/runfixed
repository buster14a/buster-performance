#!/bin/bash
set -euo pipefail
root=~/buster-fast-bench/decode-codex-6b097f86
cd "$root"
if [[ ! -d src/.git ]]; then git clone -q --shared --no-checkout ~/buster-fast-bench/3433-codex-6b097f86/src src; fi
git -C src fetch -q https://github.com/buster14a/buster.git refs/heads/claude/3451-decode-one-wip
git -C src switch --detach -q 07bfd1a5972461452d81582a5819ee06aeace958
clang_bin=$(find "$HOME/.cache/buster/benchpress-clang" -path '*/bin/clang' | head -1)
for mode in original short; do
 git -C src restore --source=HEAD -- src/buster/compiler/x86_64_disassembler.c
 if [[ $mode == short ]]; then git -C src apply "$root/short2.patch"; fi
 "$clang_bin" -O3 -march=native -funsigned-char -fwrapv -fno-strict-aliasing -Isrc/src -Isrc/src/buster/compiler mini.c -lm -o "$mode"
 "./$mode" --samples | sha256sum > "$mode.sha"
done
cmp original.sha short.sha
legacy=~/buster-fast-bench/2924-x86/gate-decode-a/base-calls
for round in 1 2 3; do
 if [[ $round == 2 ]]; then order=(short original main); else order=(main original short); fi
 for n in 1 2 4 8 16 64 256; do
  for mode in "${order[@]}"; do
   cmd=("$root/$mode"); if [[ $mode == main ]]; then cmd=("$legacy" benchmark-x86-disassembler); fi
   taskset -c 2 "${cmd[@]}" --phase decode --calls "$n" >"gate-$mode-$n-$round.log" 2>&1
  done
 done
done
echo passed > decode.status
