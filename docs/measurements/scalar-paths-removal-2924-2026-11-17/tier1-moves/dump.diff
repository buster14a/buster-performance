 }
 
+#include <stdio.h>
+#include <stdlib.h>
+// DUMP (experiment only): BUSTER_MOVES_DUMP=FILE appends (count, scratch, sources[count], destinations[count]).
 static __attribute__((unused)) Tier1AllocationError tier1_resolve_moves(const Tier1ParallelMoves* input, Arena* arena, Tier1ResolvedMoves* result)
 {
+    static FILE* dump;
+    static int ready;
+    if (!ready)
+    {
+        ready = 1;
+        const char* path = getenv("BUSTER_MOVES_DUMP");
+        dump = path != 0 ? fopen(path, "ab") : 0;
+    }
+    if (dump != 0 && input != 0 && (input->count == 0 || (input->sources != 0 && input->destinations != 0)))
+    {
+        const uint32_t header[2] = { input->count, input->scratch };
+        fwrite(header, 4, 2, dump);
+        fwrite(input->sources, 4, input->count, dump);
+        fwrite(input->destinations, 4, input->count, dump);
+        fflush(dump);
+    }
     const bool small = input != 0 && input->count <= BUSTER_TIER1_MOVE_SMALL_COUNT;
     const Tier1AllocationError error = small ? tier1_resolve_moves_scalar(input, arena, result) : tier1_resolve_moves_indexed(input, arena, result);
     return error;
