+static __attribute__((unused)) uint64_t tier1_ir_licm[4];
+__attribute__((constructor)) static void tier1_ir_init(void)
+{
+    const char* mask = getenv("BUSTER_IR_SCALAR_AREAS");
+    tier1_ir_mask = mask != 0 ? (uint32_t)strtoul(mask, 0, 0) : 0;
+    const char* out = getenv("BUSTER_IR_AREA_TICKS");
+    tier1_ir_out = out != 0 ? fopen(out, "a") : 0;
+}
+static inline __attribute__((always_inline, unused)) bool tier1_ir_scalar(bool scalar, uint32_t area)
+{
+    return scalar || (tier1_ir_mask >> area & 1) != 0;
+}
