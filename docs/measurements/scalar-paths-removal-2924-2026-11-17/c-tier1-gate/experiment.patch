 #include "buster/compiler/ssa_benchmark.c"
 #endif
 
+// Experiment only (#2924 C7's gate): BUSTER_TIER1_SCALAR_AREAS, a bitmask of the Tier 1 areas whose scalar twin runs
+// (bit 0 selection; 1 to 4 the chain consumer's liveness, allocation, rematerialization marks and records; 5 to 8 the
+// CFG consumer's problem, allocation, preference and records; 9 the schedule; the frame never); BUSTER_TIER1_AREA_TICKS,
+// a file a line per compiled function is appended to: its stage, IR instructions and TSC ticks per region (one lane).
+#include <x86intrin.h>
+#define TIER1_EXPERIMENT_TIMERS 10
+static uint32_t tier1_experiment_mask;
+static FILE* tier1_experiment_out;
+static uint64_t tier1_experiment_ticks[TIER1_EXPERIMENT_TIMERS];
+static uint32_t tier1_experiment_instructions;
+__attribute__((constructor)) static void tier1_experiment_init(void)
+{
+    const char* mask = getenv("BUSTER_TIER1_SCALAR_AREAS");
+    tier1_experiment_mask = mask != 0 ? (uint32_t)strtoul(mask, 0, 0) : 0;
+    const char* out = getenv("BUSTER_TIER1_AREA_TICKS");
+    tier1_experiment_out = out != 0 ? fopen(out, "a") : 0;
+}
+static inline __attribute__((always_inline)) bool tier1_experiment_vector(bool vector, uint32_t area)
+{
+    return vector && (tier1_experiment_mask & (1u << area)) == 0;
+}
+
