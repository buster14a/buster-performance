+// EXPERIMENT ONLY (#2924 C11's gate): BUSTER_ASM_RELAX_SCALAR=1 sends the relaxation alone to its scalar arms.
+static bool asm_relax_scalar_knob(void)
+{
+    static int knob = -1;
+    if (knob < 0)
+    {
+        const char* value = getenv("BUSTER_ASM_RELAX_SCALAR");
+        knob = value != 0 && value[0] == '1';
+    }
+    return knob != 0;
+}
