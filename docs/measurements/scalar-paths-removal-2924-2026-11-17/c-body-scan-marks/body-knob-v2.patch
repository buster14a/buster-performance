 // Include guards and #pragma once (#120)
 
+// pp_define's checks by the file's marks (pp_mark_tokens, pp_scan_body), with every mark in every lane of its word: a
+// line of `shift` identifiers, 0 to 191, moves the definitions after it across the marks' 64-token words. Each block
+// must give its expansions and its diagnostics whatever the shift: a paste (`##` short and 70 tokens into a list that
+// crosses a word), a stringizing `#`, a `#` after no parameter (an error) at the end of a 70-token list, `##` at a
+// list's end (an error), and __VA_OPT__ in an object-like macro (a warning) and in a variadic one. An ordinary
+// identifier that is no mark, and a `#` or `##` outside any list, must change nothing.
+static bool pp_directive_test_marks(void)
+{
+    uint32_t failures = 0;
+    char source[16384];
+    char tail[1024];
+    for (uint32_t i = 0; i < 70; i += 1)
+    {
+        tail[2 * i] = 't';
+        tail[2 * i + 1] = ' ';
+    }
+    tail[140] = 0;
+    for (uint32_t shift = 0; shift < 192; shift += 1)
+    {
+        uint32_t length = 0;
+        for (uint32_t i = 0; i < shift; i += 1)
+        {
+            length += (uint32_t)snprintf(source + length, sizeof(source) - length, "p ");
+        }
+        length += (uint32_t)snprintf(source + length, sizeof(source) - length,
+                                     "\n#define P(a,b) a ## b\nP(x,y)\n#define S(x) #x\nS(q)\n#define E(x) %s#y\n#define L(a,b) a %s## b\nL(m,n)\n"
+                                     "#define V __VA_OPT__\n#define O(...) __VA_OPT__(o)\nO(1)\n#define Z(x) x ##\n#define N(x) x __VA_ARGS2__ x\nN(k)\n",
+                                     tail, tail);
+        static Preprocessor pp;
+        static InternTable table;
+        const PPOptions options = { .language = { .standard = 2023, .gnu = true }, .quiet = true };
+        const bool initialized = intern_initialize(&table) && pp_initialize(&pp, &options, &table);
+        // The run reports its two errors; its output is the whole source's all the same.
+        const bool ran = initialized && (pp_run_source(&pp, "marks.c", (const uint8_t*)source, length) || !pp.fatal);
+        // The output: the shift's p's, xy, "q", m, 69 t's and tn, o, k __VA_ARGS2__ k.
+        const uint32_t expected = shift + 1 + 1 + 1 + 69 + 1 + 1 + 3;
+        bool same = initialized && ran && !pp.fatal && pp.errors == 2 && pp.warnings == 1 && pp.output.count == expected;
+        static const char* const words[] = { "xy", "\"q\"", "m", "tn", "o", "k" };
+        const uint32_t places[] = { shift, shift + 1, shift + 2, shift + 72, shift + 73, shift + 74 };
+        for (uint32_t w = 0; same && w < BUSTER_ARRAY_LENGTH(words); w += 1)
+        {
+            const uint32_t value = pp.output.values[places[w]];
+            const uint8_t kind = pp.output.kinds[places[w]];
+            const uint32_t size = (uint32_t)strlen(words[w]);
+            same = kind == C_TOKEN_RAW_IDENTIFIER ? intern_length(&table, value) == size && memcmp(intern_bytes(&table, value), words[w], size) == 0 : w == 1;
+        }
+        if (!same && failures < 4)
+        {
+            printf("marks at shift %u: %s, %u errors, %u warnings, %u tokens (expected 2, 1, %u)\n", shift, ran ? "ran" : "failed", initialized ? pp.errors : 0,
+                   initialized ? pp.warnings : 0, initialized ? pp.output.count : 0, expected);
+        }
+        failures += !same;
+        pp_release(&pp);
+        intern_release(&table);
+    }
+    printf("definitions' marks across words: %u of 192 shifts differ\n", failures);
+    return failures == 0;
+}
