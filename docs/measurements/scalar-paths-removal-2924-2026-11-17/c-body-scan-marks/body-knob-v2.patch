+        const __m512i block = _mm512_maskz_loadu_epi8(valid, kinds + i);
+        const __m512i kind = _mm512_and_si512(block, _mm512_set1_epi8(0x7F));
+        uint64_t word = _mm512_mask_cmpeq_epi8_mask(valid, kind, _mm512_set1_epi8(C_TOKEN_HASH)) | _mm512_mask_cmpeq_epi8_mask(valid, kind, _mm512_set1_epi8(C_TOKEN_HASHHASH));
+        const uint64_t lines = _mm512_movepi8_mask(block) & valid;
+        const uint64_t directives = _mm512_mask_cmpeq_epi8_mask(valid, block, _mm512_set1_epi8((char)(C_TOKEN_HASH | BUSTER_C_TOKEN_START_OF_LINE)));
+        if (open || directives != 0)
+        {
+            const uint64_t identifiers = _mm512_mask_cmpeq_epi8_mask(valid, kind, _mm512_set1_epi8(C_TOKEN_RAW_IDENTIFIER));
+            for (uint32_t quarter = 0; quarter < 4; quarter += 1)
+            {
+                const __mmask16 named = (__mmask16)(identifiers >> (16 * quarter));
