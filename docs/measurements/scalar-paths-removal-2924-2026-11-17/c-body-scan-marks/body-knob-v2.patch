+// Whether tokens [begin, end) of a definition's replacement list have a '##', a '#' and a __VA_OPT__: the file's marks
+// of those tokens (PPFileData.marks), 64 at a time from `begin` out of two words, which for most lists is one window
+// that is zero, and the kind of each marked token, which few lists have. Each of the scans it replaced lost somewhere
+// (#2924, 7006161887): 64 tokens' kinds and their identifiers' ids for every definition, to a token at a time on musl's
+// one-token constants, which lost on long lists.
+static void pp_scan_body(const PPFileData* data, uint32_t begin, uint32_t end, bool* pastes, bool* hashes, bool* va_opt)
+{
+    uint32_t found = 0;
+    for (uint32_t at = begin; at < end; at += 64)
+    {
+        const unsigned __int128 pair = (unsigned __int128)data->marks[at / 64 + 1] << 64 | data->marks[at / 64];
+        uint64_t bits = _bzhi_u64((uint64_t)(pair >> (at % 64)), end - at < 64 ? end - at : 64);
+        for (; bits != 0; bits &= bits - 1)
+        {
+            const uint8_t kind = data->kinds[at + (uint32_t)__builtin_ctzll(bits)] & 0x7F;
+            found |= kind == C_TOKEN_HASHHASH ? 1u : kind == C_TOKEN_HASH ? 2u : 4u;
+        }
+    }
+    *pastes = (found & 1u) != 0;
+    *hashes = (found & 2u) != 0;
+    *va_opt = (found & 4u) != 0;
+}
