+static unsigned buster_body_arm = 0;
+__attribute__((constructor)) static void buster_body_arm_read(void)
+{
+    char path[4096];
+    const ssize_t length = readlink("/proc/self/exe", path, sizeof(path) - 1);
+    if (length > 0)
+    {
+        path[length] = 0;
+        const char* at = strstr(path, "-areas");
+        buster_body_arm = at != 0 ? (unsigned)strtoul(at + 6, 0, 0) : 0;
