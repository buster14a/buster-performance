+// Whether tokens [begin, end) of a definition's replacement list, begin < end, have a '##', a '#' and a __VA_OPT__: the
+// file's marks of those tokens (PPFileData.marks), a word or two for most lists, and the kind of each marked one, which
+// few lists have. Each of the scans it replaced lost somewhere (#2924, 7006161887): 64 tokens' kinds and their
+// identifiers' ids for every definition, to a token at a time on musl's short constants, which lost on long lists.
+static void pp_scan_body(const PPFileData* data, uint32_t begin, uint32_t end, bool* pastes, bool* hashes, bool* va_opt)
+{
+    const uint32_t first = begin / 64;
+    const uint32_t last = (end - 1) / 64;
+    uint32_t found = 0;
+    for (uint32_t w = first; w <= last; w += 1)
+    {
+        uint64_t bits = data->marks[w];
+        bits &= w == first ? ~0ull << (begin % 64) : ~0ull;
+        bits &= w == last ? _bzhi_u64(~0ull, (end - 1) % 64 + 1) : ~0ull;
+        for (; bits != 0; bits &= bits - 1)
+        {
+            const uint8_t kind = data->kinds[64 * w + (uint32_t)__builtin_ctzll(bits)] & 0x7F;
+            found |= kind == C_TOKEN_HASHHASH ? 1u : kind == C_TOKEN_HASH ? 2u : 4u;
+        }
+    }
+    *pastes = (found & 1u) != 0;
+    *hashes = (found & 2u) != 0;
+    *va_opt = (found & 4u) != 0;
+}
