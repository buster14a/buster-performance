+// The marks (PPFileData.marks) of tokens [begin, end), a word per 64 from `begin`, a multiple of 64: '#' and '##' by
+// their kinds, __VA_OPT__ by an identifier's id, its value (another token's value is its end, which may equal the id).
+static void pp_mark_tokens(const uint8_t* kinds, const uint32_t* values, uint32_t begin, uint32_t end, uint64_t* marks)
+{
+    for (uint32_t i = begin; i < end; i += 64)
+    {
+        const __mmask64 valid = end - i >= 64 ? ~0ull : _bzhi_u64(~0ull, end - i);
+        const __m512i kind = _mm512_and_si512(_mm512_maskz_loadu_epi8(valid, kinds + i), _mm512_set1_epi8(0x7F));
+        uint64_t word = _mm512_mask_cmpeq_epi8_mask(valid, kind, _mm512_set1_epi8(C_TOKEN_HASH)) | _mm512_mask_cmpeq_epi8_mask(valid, kind, _mm512_set1_epi8(C_TOKEN_HASHHASH));
+        const uint64_t identifiers = _mm512_mask_cmpeq_epi8_mask(valid, kind, _mm512_set1_epi8(C_TOKEN_RAW_IDENTIFIER));
+        for (uint32_t quarter = 0; quarter < 4; quarter += 1)
+        {
+            const __mmask16 named = (__mmask16)(identifiers >> (16 * quarter));
+            const __m512i ids = _mm512_maskz_loadu_epi32(named, values + i + 16 * quarter);
+            word |= (uint64_t)_mm512_mask_cmpeq_epi32_mask(named, ids, _mm512_set1_epi32(C_NAME_VA_OPT)) << (16 * quarter);
+        }
+        marks[i / 64] = word;
+    }
+}
