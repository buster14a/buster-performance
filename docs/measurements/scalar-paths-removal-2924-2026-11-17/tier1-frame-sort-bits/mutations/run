#!/bin/bash
set -euo pipefail
: "${HEAD_TREE:?Set to candidate checkout}"
cp "$HEAD_TREE/src/buster/compiler/tier1_frame.c" mutated-frame.c
patch -p1 <changes.patch
"${CC:-clang}" -g -O1 -march=native -funsigned-char -fwrapv -fno-strict-aliasing -ffunction-sections -fdata-sections -I"$HEAD_TREE/src" -I"$HEAD_TREE/src/buster/compiler" -fsanitize=address,undefined -fno-sanitize-recover=all mini.c -Wl,--gc-sections -lm -o mini
./mini 0
for mutation in {1..7}; do
    if ./mini "$mutation"; then echo "mutation survived: $mutation"; exit 1; fi
done
