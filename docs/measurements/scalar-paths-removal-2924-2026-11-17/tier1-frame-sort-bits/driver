#!/bin/bash
set -euo pipefail
root=~/buster-fast-bench/frame-codex-6b097f86
corpus=/var/lib/buster-9700x/corpora/preprocessor-391e729af658
musl=$corpus/libc/musl
lua=~/buster-fast-bench/2924-c-df-claude/c3pr/inputs/lua-5.4.8/src
export LC_ALL=C
mode=$1; group=$2
case "$group" in
sqlite) args=(-DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_THREADSAFE=0 -DSQLITE_ENABLE_MEMSYS5 -DSQLITE_ENABLE_RTREE -I"$corpus/sqlite" "$corpus/sqlite/sqlite3.c");;
lua) args=("$lua"/*.c);;
musl) args=(-std=c99 -nostdinc -ffreestanding -D_XOPEN_SOURCE=700 -I "$musl/arch/x86_64" -I "$musl/arch/generic" -I "$corpus/musl-generated/obj/src/internal" -I "$musl/src/include" -I "$musl/src/internal" -I "$corpus/musl-generated/obj/include" -I "$musl/include"); declare -A seen; for f in "$musl"/src/*/*.c "$musl"/src/*/x86_64/*.c; do b=${f##*/}; if [[ -z ${seen[$b]:-} ]]; then seen[$b]=1; args+=("$f"); fi; done;;
long-double) args=("$root/long-double.c");;
*) exit 2;;
esac
case "$mode" in
 tier1) flags=(--tier1);;
 tier0) flags=();;
 *) exit 2;;
esac
out="$root/frame-time-$mode-$group"
mkdir -p "$out"
cd "$out"
for side in base frame-head; do
 mkdir -p "$out/$side"; cd "$out/$side"
 "$root/locked" bash -c 'cd "$1" && shift && "$@" >stdout.txt 2>stderr.txt' _ "$PWD" "$root/$side" -c --lanes 1 "${flags[@]}" "${args[@]}"
done
diff -qr "$out/base" "$out/frame-head" >"$root/frame-cmp-$mode-$group.log"
test "$(find "$out/base" -name '*.o' | wc -l)" -eq "$(case "$group" in lua) echo 34;; musl) echo 1336;; *) echo 1;; esac)"
cd "$out"
export EXCLUSIVE_OWNER=codex-frame-6b097f86 EXCLUSIVE_TITLE="Tier 1 frame sorter" EXCLUSIVE_LINK=https://github.com/buster14a/buster/issues/3450
"$root/base" ab --rounds 3 --cpu 2 --lock "$HOME/buster-fast-bench/exclusive.sh" "$root/base" -- time-runs --runs 3 --directory "$out" --build base "$root/base" --build head "$root/frame-head" --build control "$root/base" --list -c --lanes 1 "${flags[@]}" "${args[@]}" > "$root/frame-prod-$mode-$group.log" 2>&1
