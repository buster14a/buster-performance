#!/bin/bash
set -euo pipefail
root=~/buster-fast-bench/frame-codex-6b097f86
cd "$root"
clang_bin=$(find "$HOME/.cache/buster/benchpress-clang" -path '*/bin/clang' | head -1)
"$clang_bin" -O3 -march=native boundary.c old-local.o new-local.o -Wl,--gc-sections -lm -o boundary
for rep in 1 2 3; do taskset -c 2 ./boundary synth > "boundary-$rep.log"; done
ln -f base control
ln -f frame-head duplicate-head
for group in lua sqlite musl; do
 taskset -c 2 bash "$root/same-driver" tier1 "$group"
done
echo passed >frame-extra.status
