#!/bin/bash
set -euo pipefail
root=~/buster-fast-bench/frame-codex-6b097f86
corpus=/var/lib/buster-9700x/corpora/preprocessor-391e729af658
musl=$corpus/libc/musl
lua=~/buster-fast-bench/2924-c-df-claude/c3pr/inputs/lua-5.4.8/src
export LC_ALL=C
mode=$1; group=$2
case "$group" in
sqlite) args=(-DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_THREADSAFE=0 -DSQLITE_ENABLE_MEMSYS5 -DSQLITE_ENABLE_RTREE -I"$corpus/sqlite" "$corpus/sqlite/sqlite3.c");;
lua) args=("$lua"/*.c);;
musl) args=(-std=c99 -nostdinc -ffreestanding -D_XOPEN_SOURCE=700 -I "$musl/arch/x86_64" -I "$musl/arch/generic" -I "$corpus/musl-generated/obj/src/internal" -I "$musl/src/include" -I "$musl/src/internal" -I "$corpus/musl-generated/obj/include" -I "$musl/include"); declare -A seen; for f in "$musl"/src/*/*.c "$musl"/src/*/x86_64/*.c; do b=${f##*/}; if [[ -z ${seen[$b]:-} ]]; then seen[$b]=1; args+=("$f"); fi; done;;
long-double) args=("$root/long-double.c");;
*) exit 2;;
esac
case "$mode" in
 tier1) flags=(--tier1);;
 tier0) flags=();;
 *) exit 2;;
esac
out="$root/samepath-$mode-$group"
mkdir -p "$out"
cd "$root"
mkdir -p "$out/results"
cd "$out"
for rep in {0..15}; do
 case $((rep % 4)) in
  0) order=(base frame-head control duplicate-head);;
  1) order=(frame-head duplicate-head base control);;
  2) order=(duplicate-head control frame-head base);;
  3) order=(control base duplicate-head frame-head);;
 esac
 for side in "${order[@]}"; do
  ln -f "$root/$side" "$out/compiler-under-test"
  "$root/base" time-runs --runs 1 --directory "$out/results" --build candidate "$out/compiler-under-test" --list -c --lanes 1 "${flags[@]}" "${args[@]}" >"$out/sample-$rep-$side.log" 2>&1
 done
done
