#!/bin/bash
set -euo pipefail
: "${BASE_TREE:?Set to the baseline checkout}" "${HEAD_TREE:?Set to the candidate checkout}"
for mode in old new; do
    src=$BASE_TREE/src
    if [[ $mode == new ]]; then src=$HEAD_TREE/src; fi
    "${CC:-clang}" -I"$src" -I"$src/buster/compiler" -O3 -march=native -funsigned-char -ffunction-sections -fdata-sections "-DSIDE=${mode}_side" -c side.c -o "$mode.o"
    objcopy --keep-global-symbol="${mode}_side" "$mode.o" "$mode-local.o"
done
for probe in gate boundary stress; do
    "${CC:-clang}" -O3 -march=native "$probe.c" old-local.o new-local.o -Wl,--gc-sections -lm -o "$probe"
done
