+// #2924 C12c-3's census (experiment only): each use counts its value by file and line, written at exit to
+// BUSTER_PATH_CENSUS (with BUSTER_EXIT_HELPER=0).
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+typedef struct BusterPathSite { const char* file; unsigned line; unsigned long long values[2]; } BusterPathSite;
+static __attribute__((unused)) BusterPathSite buster_path_sites[8192];
+static __attribute__((unused)) int buster_path_enabled = -1;
+static __attribute__((unused)) void buster_path_dump(void)
+{
+    const char* name = getenv("BUSTER_PATH_CENSUS");
+    FILE* file = name != NULL ? fopen(name, "a") : NULL;
+    for (unsigned i = 0; file != NULL && i < 8192; i += 1)
+    {
+        if (buster_path_sites[i].file != NULL)
+        {
+            fprintf(file, "path %s:%u %llu %llu\n", buster_path_sites[i].file, buster_path_sites[i].line, buster_path_sites[i].values[0], buster_path_sites[i].values[1]);
+        }
+    }
+    if (file != NULL)
+    {
+        fclose(file);
+    }
+}
+static inline __attribute__((noinline)) bool buster_path_count(const char* file, unsigned line, bool value)
+{
+    if (buster_path_enabled < 0)
+    {
+        buster_path_enabled = getenv("BUSTER_PATH_CENSUS") != NULL;
+        if (buster_path_enabled)
+        {
+            atexit(buster_path_dump);
+        }
+    }
+    for (unsigned i = (line * 2654435761u) & 8191; buster_path_enabled; i = (i + 1) & 8191)
+    {
+        if (buster_path_sites[i].file == NULL || (buster_path_sites[i].line == line && strcmp(buster_path_sites[i].file, file) == 0))
+        {
+            buster_path_sites[i].file = file;
+            buster_path_sites[i].line = line;
+            buster_path_sites[i].values[value ? 1 : 0] += 1;
+            break;
+        }
+    }
+    return value;
+}
+#define BUSTER_SCALAR_PATH(requested) buster_path_count(__FILE__, __LINE__, (requested))
+#define BUSTER_VECTOR_PATH(requested) (!buster_path_count(__FILE__, __LINE__, !(requested)))
