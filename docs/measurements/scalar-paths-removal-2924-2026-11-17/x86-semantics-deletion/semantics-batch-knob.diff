diff --git a/src/buster/compiler/x86_semantics_benchmark.c b/src/buster/compiler/x86_semantics_benchmark.c
index 278b428b..13f67cd3 100644
--- a/src/buster/compiler/x86_semantics_benchmark.c
+++ b/src/buster/compiler/x86_semantics_benchmark.c
@@ -422,7 +422,35 @@ struct X86SemanticsBenchmarkData
     uint64_t code_capacity;
 };
 
+static uint64_t x86_semantics_gate_batch;
+static void x86_semantics_benchmark_once_whole(X86SemanticsBenchmarkData* data, X86SemanticsBenchmarkPath path);
 static void x86_semantics_benchmark_once(X86SemanticsBenchmarkData* data, X86SemanticsBenchmarkPath path)
+{
+    if (x86_semantics_gate_batch == 0)
+    {
+        x86_semantics_benchmark_once_whole(data, path);
+    }
+    else
+    {
+        X86SemanticsBenchmarkData part = *data;
+        for (uint64_t first = 0; first < data->count; first += x86_semantics_gate_batch)
+        {
+            const uint64_t left = data->count - first;
+            part.count = left < x86_semantics_gate_batch ? left : x86_semantics_gate_batch;
+            part.rows = data->rows ? data->rows + first : 0;
+            part.values = data->values ? data->values + first : 0;
+            part.contexts = data->contexts ? data->contexts + first : 0;
+            part.forms = data->forms ? data->forms + first : 0;
+            part.records = data->records ? data->records + first : 0;
+            part.reads = data->reads ? data->reads + first : 0;
+            part.writes = data->writes ? data->writes + first : 0;
+            part.opmasks = data->opmasks ? data->opmasks + first : 0;
+            x86_semantics_benchmark_once_whole(&part, path);
+        }
+    }
+}
+
+static void x86_semantics_benchmark_once_whole(X86SemanticsBenchmarkData* data, X86SemanticsBenchmarkPath path)
 {
     if (!data->effects)
     {
@@ -919,6 +947,9 @@ int run_x86_semantics_benchmark(int argc, char** argv)
     }
     else
     {
+        const char* gate = getenv("BUSTER_GATE_BATCH");
+        x86_semantics_gate_batch = gate ? strtoull(gate, 0, 10) : 0;
+        printf("gate batch %llu\n", (unsigned long long)x86_semantics_gate_batch);
         valid = x86_encoder_initialize() && x86_semantics_initialize();
         X86SemanticsBenchmarkCounters counters = x86_semantics_benchmark_open_counters();
         printf("x86 semantics: seed %llu, %u interleaved-pass medians", (unsigned long long)seed, BUSTER_X86_SEMANTICS_BENCHMARK_PASSES);
