 static void x86_semantics_benchmark_once(X86SemanticsBenchmarkData* data, X86SemanticsBenchmarkPath path)
+{
+    if (x86_semantics_gate_batch == 0)
+    {
+        x86_semantics_benchmark_once_whole(data, path);
+    }
+    else
+    {
+        X86SemanticsBenchmarkData part = *data;
+        for (uint64_t first = 0; first < data->count; first += x86_semantics_gate_batch)
+        {
+            const uint64_t left = data->count - first;
+            part.count = left < x86_semantics_gate_batch ? left : x86_semantics_gate_batch;
+            part.rows = data->rows ? data->rows + first : 0;
+            part.values = data->values ? data->values + first : 0;
+            part.contexts = data->contexts ? data->contexts + first : 0;
+            part.forms = data->forms ? data->forms + first : 0;
+            part.records = data->records ? data->records + first : 0;
+            part.reads = data->reads ? data->reads + first : 0;
+            part.writes = data->writes ? data->writes + first : 0;
+            part.opmasks = data->opmasks ? data->opmasks + first : 0;
+            x86_semantics_benchmark_once_whole(&part, path);
+        }
+    }
+}
