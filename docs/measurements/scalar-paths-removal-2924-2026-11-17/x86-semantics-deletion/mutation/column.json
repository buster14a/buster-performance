{
 "runs": [
  {
   "tests": [
    "./build/compiler test-tier1-emit",
    "./build/compiler test-tier1-pipeline",
    "./build/compiler test-check-debug"
   ],
   "mutants": [
    [
     "c1-flags-never-written",
     "    return (build->writes[r] & BUSTER_X86_RESOURCE_FLAGS) != 0;",
     "    return (build->writes[r] & BUSTER_X86_RESOURCE_FLAGS) == UINT64_MAX;"
    ],
    [
     "c2-prologue-written-off-by-one",
     "                const uint64_t written = build.writes[r];",
     "                const uint64_t written = build.writes[r + 1];"
    ]
   ]
  },
  {
   "tests": [
    "./build/compiler test-check-debug",
    "./build/compiler test-tier1-pipeline"
   ],
   "mutants": [
    [
     "c3-debug-transfer-first-record",
     "        transfers[r] = check_tier1_debug_transfer(emitted->code.records + old, written[old]);",
     "        transfers[r] = check_tier1_debug_transfer(emitted->code.records + old, written[0]);"
    ],
    [
     "c4-value-transfer-nothing-written",
     "            proof.transfers[r] = check_tier1_debug_value_transfer(&proof, emitted, old, record_writes[old]);",
     "            proof.transfers[r] = check_tier1_debug_value_transfer(&proof, emitted, old, record_writes[old] & 0);"
    ]
   ]
  }
 ]
}