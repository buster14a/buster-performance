+// Experiment only (#3451's gate): BUSTER_EFFECTS_DUMP=FILE appends every call: its count, whether it takes the opmasks
+// column, then its records.
+#include <fcntl.h>
+#include <unistd.h>
+static void x86_effects_dump(const X86Instruction* instructions, uint64_t count, uint32_t with_opmasks)
+{
+    static int descriptor = -2;
+    if (descriptor == -2)
+    {
+        const char* path = getenv("BUSTER_EFFECTS_DUMP");
+        descriptor = path != 0 ? open(path, O_WRONLY | O_CREAT | O_APPEND, 0644) : -1;
+    }
+    if (descriptor >= 0 && count != 0)
+    {
+        const uint32_t header[2] = { (uint32_t)count, with_opmasks };
+        ssize_t written = write(descriptor, header, sizeof(header));
+        written += write(descriptor, instructions, count * sizeof(X86Instruction));
+        (void)written;
+    }
+}
+
 static __attribute__((unused)) void x86_instructions_effects(const X86Instruction* instructions, uint64_t count, uint64_t* reads, uint64_t* writes)
 {
+    x86_effects_dump(instructions, count, 0);
     x86_instructions_effects_lanes(instructions, count, reads, writes, 0);
 }
 
@@ -3502,6 +3524,7 @@ static __attribute__((unused)) void x86_instructions_effects(const X86Instructio
 static __attribute__((unused)) void x86_instructions_effects_opmasks(const X86Instruction* instructions, uint64_t count, uint64_t* reads, uint64_t* writes,
                                                                      uint16_t* opmasks)
 {
+    x86_effects_dump(instructions, count, 1);
     x86_instructions_effects_lanes(instructions, count, reads, writes, opmasks);
 }
 
