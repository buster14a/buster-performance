+
+// #2924 C9g, experiment only: the two-path fixtures of x87_transfer_candidates and ir_parse's line scan.
+static uint64_t c9g_measure_ticks(void)
+{
+    _mm_lfence();
+    const uint64_t result = __rdtsc();
+    _mm_lfence();
+    return result;
+}
+
+static int c9g_measure_paths(int argc, char** argv)
+{
+    uint64_t state = 2924;
+    static X86Instruction records[64 * 1024];
+    static uint32_t tokens[64 * 1024];
+    static uint8_t eligible[64 * 1024];
+    const uint16_t forms[] = { X86_FORM_FSTP_M80, X86_FORM_FLD_M80, X86_FORM_FMULP_ST_ST0, X86_FORM_FSTP_M80 };
+    for (uint32_t r = 0; r < 64 * 1024; r += 1)
+    {
+        state = state * 6364136223846793005ull + 1442695040888963407ull;
+        records[r] = (X86Instruction){ .form = forms[(state >> 33) & 3], .rm = X86_REGISTER_RSP, .mode = BUSTER_X86_MEMORY_BASE, .displacement = 16 };
+        tokens[r] = ((state >> 40) & 1) != 0 ? r % 64 : 1000;
+        eligible[r] = 1;
+    }
+    volatile uint64_t sink = 0;
+    for (uint32_t count = 1; count <= 64; count = count < 8 ? count + 1 : count * 2)
+    {
+        uint64_t least[2] = { UINT64_MAX, UINT64_MAX };
+        for (uint32_t round = 0; round < 15; round += 1)
+        {
+            for (uint32_t turn = 0; turn < 2; turn += 1)
+            {
+                const bool vector = ((round + turn) & 1) != 0;
+                const uint64_t begin = c9g_measure_ticks();
+                for (uint32_t window = 0; window + 64 <= 64 * 1024; window += 64)
+                {
+                    sink += x87_transfer_candidates(records + window, tokens + window, eligible + window, 0, count, vector);
+                }
+                const uint64_t taken = c9g_measure_ticks() - begin;
+                least[vector] = taken < least[vector] ? taken : least[vector];
+            }
+        }
+        printf("x87-candidates count=%u scalar_ticks=%.2f vector_ticks=%.2f scalar/vector=%.3f\n", count, least[0] / 1024.0, least[1] / 1024.0, (double)least[0] / (double)least[1]);
+    }
+    Arena output = arena_reserve(UINT64_C(256) << 20);
+    Arena scratch = arena_reserve(UINT64_C(256) << 20);
+    uint64_t least[2] = { UINT64_MAX, UINT64_MAX };
+    uint64_t bytes = 0;
+    for (uint32_t round = 0; round < 9; round += 1)
+    {
+        for (uint32_t turn = 0; turn < 2; turn += 1)
+        {
+            const bool vector = ((round + turn) & 1) != 0;
+            uint64_t taken = 0;
+            bytes = 0;
+            for (int i = 1; i < argc; i += 1)
+            {
+                FILE* file = fopen(argv[i], "rb");
+                static char text[1 << 20];
+                const size_t length = file != NULL ? fread(text, 1, sizeof(text), file) : 0;
+                if (file != NULL)
+                {
+                    fclose(file);
+                }
+                const String8 source = { .pointer = text, .length = length };
+                for (uint32_t repeat = 0; repeat < 50; repeat += 1)
+                {
+                    IrFunction function = { 0 };
+                    const uint64_t begin = c9g_measure_ticks();
+                    const IrParseResult parsed = vector ? ir_parse(source, &output, &scratch, &function) : ir_parse_scalar(source, &output, &scratch, &function);
+                    taken += c9g_measure_ticks() - begin;
+                    sink += parsed.consumed;
+                    bytes += length;
+                    arena_pop_to(&output, 0);
+                    arena_pop_to(&scratch, 0);
+                }
+            }
+            least[vector] = taken < least[vector] ? taken : least[vector];
+        }
+    }
+    printf("ir-parse files=%d bytes=%" PRIu64 " scalar_ticks_per_byte=%.3f vector_ticks_per_byte=%.3f scalar/vector=%.3f\n", argc - 1, bytes, (double)least[0] / bytes, (double)least[1] / bytes, (double)least[0] / (double)least[1]);
+    arena_release(&output);
+    arena_release(&scratch);
+    return 0;
+}
