From 6b931fa6188d573ee649a2428b11a1e305b311e6 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 23 Nov 2026 21:50:44 +0000
Subject: [PATCH 3/4] x87 transfers: a region that starts past the first record
 (#2924)

The mutation round's survivor x3 named candidates by their place in the
region rather than their records' own indices: every fixture's region
started at record 0. test-tier1-wide now runs regions from records 1
and 12.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EgbxngY8HBj6wFPMjAjgYD
Signed-off-by: David Gonzalez Martin <davidgmbb@gmail.com>
---
 src/buster/compiler/tier1_x87_transfer_test.c | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/src/buster/compiler/tier1_x87_transfer_test.c b/src/buster/compiler/tier1_x87_transfer_test.c
index d5ca1817..5a62b439 100644
--- a/src/buster/compiler/tier1_x87_transfer_test.c
+++ b/src/buster/compiler/tier1_x87_transfer_test.c
@@ -167,6 +167,26 @@ static void tier1_x87_transfer_candidate_bounds(Tier1WideTest* test)
             tier1_wide_test_expect(test, mixed_candidates == mixed, "the transport classifier takes eligible private stores alone");
             memset(eligible, 1, sizeof(eligible));
         }
+        // A region that starts past the first record: candidates are named by their records' own indices.
+        X86Instruction shifted[BUSTER_X87_TRANSFER_RECORDS + 24];
+        uint32_t shifted_tokens[BUSTER_X87_TRANSFER_RECORDS + 24];
+        uint8_t shifted_eligible[BUSTER_X87_TRANSFER_RECORDS + 24];
+        memset(shifted_eligible, 1, sizeof(shifted_eligible));
+        for (uint32_t first = 1; first < 24; first += 11)
+        {
+            for (uint32_t r = 0; r < BUSTER_X87_TRANSFER_RECORDS + 24; r += 1)
+            {
+                shifted[r] = tier1_x87_transfer_memory(X86_FORM_FSTP_M80, X86_REGISTER_RSP, (int32_t)(16 * r));
+                shifted_tokens[r] = r % 3 == 0 ? r - first : r;
+            }
+            uint64_t expected = 0;
+            for (uint32_t r = 0; r < BUSTER_X87_TRANSFER_RECORDS; r += 1)
+            {
+                expected |= (uint64_t)((first + r) % 3 != 0) << r;
+            }
+            const uint64_t candidates = x87_transfer_candidates(shifted, shifted_tokens, shifted_eligible, first, BUSTER_X87_TRANSFER_RECORDS);
+            tier1_wide_test_expect(test, candidates == expected, "the transport classifier names a region's stores by their own records");
+        }
     }
     if (records_memory != MAP_FAILED)
     {
-- 
