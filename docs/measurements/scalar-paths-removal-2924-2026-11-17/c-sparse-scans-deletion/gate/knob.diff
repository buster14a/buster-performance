diff --git a/src/buster/compiler/host_isa.h b/src/buster/compiler/host_isa.h
index 260a9f1c5..a858e3709 100644
--- a/src/buster/compiler/host_isa.h
+++ b/src/buster/compiler/host_isa.h
@@ -17,4 +17,24 @@
 #define BUSTER_SCALAR_PATH(requested) (requested)
 #define BUSTER_VECTOR_PATH(requested) (requested)
 #include <immintrin.h>
+// EXPERIMENT ONLY (#2924 C12c-3 core-2's gate): the scalar arms this executable takes, by the bits after "-areas" in its
+// file's name: 1 the sparse columns' scans, 2 the generic and static selections, 4 the deprecated uses' scan.
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+__attribute__((weak)) unsigned buster_scalar_area_mask = 0;
+static __attribute__((constructor, unused)) void buster_scalar_area_initialize(void)
+{
+    char path[4096];
+    const ssize_t length = readlink("/proc/self/exe", path, sizeof(path) - 1);
+    unsigned bits = 0;
+    if (length > 0)
+    {
+        path[length] = 0;
+        const char* at = strstr(path, "-areas");
+        bits = at != 0 ? (unsigned)strtoul(at + 6, 0, 0) : 0;
+    }
+    buster_scalar_area_mask = bits;
+}
+#define buster_scalar_area(area) ((int)((buster_scalar_area_mask >> (area)) & 1u))
 #endif
