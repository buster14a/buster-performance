 #ifndef BUSTER_C_CHECK_PROGRAM_INCLUDED
 #define BUSTER_C_CHECK_PROGRAM_INCLUDED
 
+// Experiment only (#2924 C8's gate): BUSTER_TIER0_SCALAR_AREAS, a bitmask of the areas whose scalar twin runs (bit 0
+// Tier 0's compile, 1 its validation, 2 its inlining, 3 the unwind analyzer of --verify); BUSTER_TIER0_AREA_TICKS, a
+// file each call appends one line to, in call order: its area, its Tier 0 entries and its TSC ticks (one lane).
+#include <x86intrin.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <fcntl.h>
+#include <unistd.h>
+static __attribute__((unused)) uint32_t tier0_experiment_mask;
+static __attribute__((unused)) int tier0_experiment_fd = -1;
+__attribute__((constructor)) static void tier0_experiment_init(void)
+{
+    const char* mask = getenv("BUSTER_TIER0_SCALAR_AREAS");
+    tier0_experiment_mask = mask != 0 ? (uint32_t)strtoul(mask, 0, 0) : 0;
+    const char* out = getenv("BUSTER_TIER0_AREA_TICKS");
+    tier0_experiment_fd = out != 0 ? open(out, O_WRONLY | O_CREAT | O_APPEND, 0644) : -1;
+}
+static inline __attribute__((always_inline, unused)) bool tier0_experiment_scalar(bool scalar, uint32_t area)
+{
+    return scalar || (tier0_experiment_mask & (1u << area)) != 0;
+}
+static __attribute__((noinline, unused)) void tier0_experiment_log(uint32_t area, uint32_t count, uint64_t ticks)
+{
+    if (tier0_experiment_fd >= 0)
+    {
+        char line[64];
+        const int length = snprintf(line, sizeof(line), "%u %u %llu\n", area, count, (unsigned long long)ticks);
+        (void)!write(tier0_experiment_fd, line, (size_t)length);
+    }
+}
+
 typedef enum CheckProgramStatus
 {
     CHECK_PROGRAM_OK,
