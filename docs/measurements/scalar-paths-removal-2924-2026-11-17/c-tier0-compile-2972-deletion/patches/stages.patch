+// Experiment only (#2972): TSC ticks of Tier 0's compile by stage and path, printed at exit to BUSTER_TIER0_STAGES.
+#include <x86intrin.h>
+static uint64_t tier0_stage_last;
+#define TIER0_STAGES 16
+#define TIER0_STAGE_BINS 17
+static uint32_t tier0_stage_bin;
+static uint64_t tier0_stage_ticks[2][TIER0_STAGE_BINS][TIER0_STAGES];
+static uint64_t tier0_stage_calls[2][TIER0_STAGE_BINS];
+static uint64_t tier0_stage_entries[2];
+#define TIER0_STAGE_BEGIN() (tier0_stage_bin = function->count < TIER0_STAGE_BINS - 1 ? function->count : TIER0_STAGE_BINS - 1, tier0_stage_last = __rdtsc())
+#define TIER0_STAGE(v, k) do { const uint64_t tier0_now = __rdtsc(); tier0_stage_ticks[(v) ? 1 : 0][tier0_stage_bin][k] += tier0_now - tier0_stage_last; tier0_stage_last = tier0_now; } while (0)
+__attribute__((destructor)) static void tier0_stage_report(void)
+{
+    const char* path = getenv("BUSTER_TIER0_STAGES");
+    FILE* out = path != 0 ? fopen(path, "a") : 0;
+    if (out != 0)
+    {
+        static const char* names[TIER0_STAGES] = { "setup", "front", "select", "layout", "measure", "output", "forms", "finish", "after-generate", "records", "end", "references", "homes", "emit", "labels-values", "fuse" };
+        static const uint32_t order[] = { 0, 14, 15, 1, 2, 11, 12, 3, 4, 5, 13, 6, 7, 8, 9, 10 };
+        for (uint32_t v = 0; v < 2; v += 1)
+        {
+            for (uint32_t b = 0; b < TIER0_STAGE_BINS; b += 1)
+            {
+                const uint64_t calls = tier0_stage_calls[v][b];
+                if (calls != 0)
+                {
+                    double total = 0;
+                    fprintf(out, "%s entries %u%s: %llu calls\n", v ? "vector" : "scalar", b, b == TIER0_STAGE_BINS - 1 ? "+" : "", (unsigned long long)calls);
+                    for (uint32_t o = 0; o < sizeof(order) / sizeof(order[0]); o += 1)
+                    {
+                        const double ticks = (double)tier0_stage_ticks[v][b][order[o]] / (double)calls;
+                        total += ticks;
+                        fprintf(out, "  %-15s %9.1f\n", names[order[o]], ticks);
+                    }
+                    fprintf(out, "  %-15s %9.1f\n", "total", total);
+                }
+            }
+        }
+        fclose(out);
+    }
+}
