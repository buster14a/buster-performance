@@ -1398,6 +1420,11 @@ static __attribute__((unused)) IrCheck ir_optimize_sroa(const IrFunction* functi
         result->widened_slots = widened_slots;
         result->widened_returns = widened_returns;
     }
+    const uint64_t c9h_ticks = __rdtsc() - c9h_begin;
+    if (c9h_sroa_out != NULL)
+    {
+        fprintf(c9h_sroa_out, "%u %u %u %llu\n", function->block_count, function->slot_count, function->instruction_count, (unsigned long long)c9h_ticks);
+    }
     arena_pop_to(scratch, sm);
