+#include <x86intrin.h>
+#include <stdio.h>
+#include <stdlib.h>
+// Experiment only (#2924 C9h's SROA gate): BUSTER_IR_SROA_SCALAR=1 takes the uses scan's twin alone (the preparation and
+// the DCE rewrite keep the caller's path); BUSTER_IR_SROA_TICKS names a file a line per SROA call is appended to: the
+// function's blocks, slots, instructions and TSC ticks.
+static int c9h_sroa_scalar = -1;
+static FILE* c9h_sroa_out = NULL;
+static void c9h_sroa_knob(void)
+{
+    if (c9h_sroa_scalar < 0)
+    {
+        const char* knob = getenv("BUSTER_IR_SROA_SCALAR");
+        c9h_sroa_scalar = knob != NULL && knob[0] == '1';
+        const char* out = getenv("BUSTER_IR_SROA_TICKS");
+        c9h_sroa_out = out != NULL ? fopen(out, "a") : NULL;
+    }
+}
+
 static void ir_sroa_provenance(IrSroaWork* work, bool scalar, bool flagged)
 {
-    (void)scalar;
+    c9h_sroa_knob();
+    scalar = scalar || c9h_sroa_scalar != 0;
 
     const IrFunction* f = work->ir.function;
