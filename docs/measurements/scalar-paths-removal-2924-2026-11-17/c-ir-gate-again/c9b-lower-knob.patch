@@ -22,6 +22,31 @@
 #include "ir_vectorize_target.c"
 #include "tier1_schedule_ir.c"
 #include "c_check_tier1_schedule.c"
+// Experiment only (#2924 C9b's lowering re-gate): BUSTER_IR_LOWER_SCALAR=1 takes the lowering's twin; BUSTER_IR_LOWER_TICKS
+// names a file a line per lowering is appended to: the Tier 0 entries and the TSC ticks.
+#include <x86intrin.h>
+#include <stdio.h>
+#include <stdlib.h>
+static int c9_lower_scalar = -1;
+static FILE* c9_lower_out = NULL;
+static inline __attribute__((always_inline, unused)) bool c9_lower_flag(bool scalar)
+{
+    if (c9_lower_scalar < 0)
+    {
+        const char* knob = getenv("BUSTER_IR_LOWER_SCALAR");
+        c9_lower_scalar = knob != NULL && knob[0] == '1';
+        const char* out = getenv("BUSTER_IR_LOWER_TICKS");
+        c9_lower_out = out != NULL ? fopen(out, "a") : NULL;
+    }
+    return scalar || c9_lower_scalar != 0;
+}
+static inline __attribute__((always_inline, unused)) void c9_lower_record(uint32_t entries, uint64_t ticks)
+{
+    if (c9_lower_out != NULL)
+    {
+        fprintf(c9_lower_out, "%u %llu\n", entries, (unsigned long long)ticks);
+    }
+}
 
 _Static_assert(BUSTER_TIER1_ACCESS_DIRECT == BUSTER_TIER0_ACCESS_DIRECT && BUSTER_TIER1_ACCESS_GOT == BUSTER_TIER0_ACCESS_GOT && BUSTER_TIER1_ACCESS_LOCAL_EXEC == BUSTER_TIER0_ACCESS_LOCAL_EXEC &&
                    BUSTER_TIER1_ACCESS_INITIAL_EXEC == BUSTER_TIER0_ACCESS_INITIAL_EXEC,
