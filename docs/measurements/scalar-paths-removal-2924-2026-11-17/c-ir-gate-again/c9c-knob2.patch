+        }
+        const uint64_t c9c_ticks = __rdtsc() - c9c_begin;
+        if (c9c_out != NULL)
+        {
+            fprintf(c9c_out, "%u %u %u %llu\n", unssa->block_count, unssa->slot_count, unssa->instruction_count, (unsigned long long)c9c_ticks);
         }
         passes->gvn_removed = numbered ? shared.removed : 0;
         outcome = check_tier1_step(CHECK_TIER1_PROMOTION, CHECK_TIER1_CAUSE_IR, check.error, check.instruction, check.detail, fault);
