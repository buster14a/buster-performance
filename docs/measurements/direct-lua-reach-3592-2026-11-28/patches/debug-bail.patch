diff --git a/src/buster/compiler/c_direct_types.c b/src/buster/compiler/c_direct_types.c
index f6e6ed3f..02ab4616 100644
--- a/src/buster/compiler/c_direct_types.c
+++ b/src/buster/compiler/c_direct_types.c
@@ -445,6 +445,21 @@ static __attribute__((cold, noinline)) void fast_cc_bail(FastCCState* cc, const
         cc->bailout = true;
         cc->bailout_reason = reason;
         cc->bailout_tok = cc->pos;
+        if (getenv("BUSTER_DEBUG_BAIL") != NULL)
+        {
+            const FastIdentTable* it = &cc->pp->idents;
+            const uint32_t fn = cc->cur_func_name_id;
+            fprintf(stderr, "BAIL %s in %s at %u:", reason, fn != 0 && fn <= it->count ? it->strings + it->entries[fn].str_offset : "?", cc->pos);
+            const uint32_t from = cc->pos > 16u ? cc->pos - 16u : 0u;
+            for (uint32_t i = from; i < cc->pos + 6u && i < cc->tcount; i += 1)
+            {
+                const uint32_t d = cc->td[i];
+                if (i == cc->pos) { fprintf(stderr, " <<<"); }
+                if (cc->tk[i] == FTOK_IDENT && d != 0 && d <= it->count) { fprintf(stderr, " %s", it->strings + it->entries[d].str_offset); }
+                else { fprintf(stderr, " k%u", (unsigned)cc->tk[i]); }
+            }
+            fprintf(stderr, "\n");
+        }
     }
 }
 
