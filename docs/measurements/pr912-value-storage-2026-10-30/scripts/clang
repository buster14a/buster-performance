#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
# Copyright (c) 2026 David Gonzalez Martin.
# Transparent build wrapper: keep each actual translation unit object for proof.
set -euo pipefail
output= source= previous= compile=0
for argument in "$@"; do
    if [ "$previous" = -o ]; then output=$argument; fi
    case "$argument" in
        -c) compile=1 ;;
        src/buster/compiler/*.c) source=$argument ;;
    esac
    previous=$argument
done
"${PR912_REAL_CLANG:?}" "$@"
if [ "$compile" = 1 ] && [ -n "$output" ] && [ -n "$source" ]; then
    cp "$output" "${PR912_OBJECTS:?}/$(basename "$source").o"
fi
