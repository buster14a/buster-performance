+            for (uint32_t i = 0; i < BUSTER_PROBE_COUNTERS; i += 1)
+            {
+                const uint64_t value = probe_read(i);
+                stage_clock->probe_stage[stage][i] += value - probe_last[i];
+                probe_last[i] = value;
+            }
