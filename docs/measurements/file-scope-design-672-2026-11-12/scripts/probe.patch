+// ---- PROBE (measurement patch of the #672 file-scope record; not for merging) -------------------------------------
+// BUSTER_PROBE_SKIPS names a file of lines "UNIT<TAB>DECLARATIONS<TAB>ORDINAL,ORDINAL,...", sorted by unit: for the
+// unit of that base name (without its extension), the top-level declarations the walk in source order passes without
+// reading, by their ordinal among the unit's top-level declarations (the tokens whose parent is the tree's root, in
+// order). The decisions are made outside (the record's tools/attest.py). A unit whose count of top-level declarations
+// isn't DECLARATIONS skips nothing, and is counted as a mismatch. A skipped declaration's tokens get no visit mark and
+// are ignored, as the design's skip marks them. With BUSTER_PROBE_SKIP_REPORT set as well, each unit's end prints the
+// counts so far on standard error (the process leaves without running exit handlers); the last line is the command's.
+static const char* probe_skip_unit;
+static int probe_skip_mode = -1;
+static char* probe_skip_text;
+static char** probe_skip_names;
+static uint32_t* probe_skip_expected;
+static uint32_t* probe_skip_first;
+static uint32_t* probe_skip_ordinals;
+static uint32_t probe_skip_units;
+static uint64_t probe_skip_counts[5];
+
+static void probe_skip_report(void)
+{
+    fprintf(stderr, "probe-skip\tunits\t%llu\tunits-mismatched\t%llu\tunits-unlisted\t%llu\tdeclarations\t%llu\ttokens\t%llu\n",
+            (unsigned long long)probe_skip_counts[0], (unsigned long long)probe_skip_counts[1], (unsigned long long)probe_skip_counts[2],
+            (unsigned long long)probe_skip_counts[3], (unsigned long long)probe_skip_counts[4]);
+}
+
+static void probe_skip_load(void)
+{
+    const char* path = getenv("BUSTER_PROBE_SKIPS");
+    probe_skip_mode = 0;
+    FILE* file = path != NULL ? fopen(path, "rb") : NULL;
+    if (file != NULL)
+    {
+        fseek(file, 0, SEEK_END);
+        const long size = ftell(file);
+        fseek(file, 0, SEEK_SET);
+        probe_skip_text = malloc((size_t)size + 1);
+        const size_t read = fread(probe_skip_text, 1, (size_t)size, file);
+        fclose(file);
+        probe_skip_text[read] = 0;
+        uint32_t lines = 0;
+        uint32_t numbers = 0;
+        for (size_t i = 0; i < read; i += 1)
+        {
+            lines += probe_skip_text[i] == '\n';
+            numbers += probe_skip_text[i] == ',' || probe_skip_text[i] == '\t';
+        }
+        probe_skip_names = malloc(sizeof(char*) * (lines + 1));
+        probe_skip_expected = malloc(sizeof(uint32_t) * (lines + 1));
+        probe_skip_first = malloc(sizeof(uint32_t) * (lines + 2));
+        probe_skip_ordinals = malloc(sizeof(uint32_t) * (numbers + 1));
+        uint32_t ordinals = 0;
+        char* at = probe_skip_text;
+        while (*at != 0)
+        {
+            char* line_end = strchr(at, '\n');
+            if (line_end != NULL)
+            {
+                *line_end = 0;
+            }
+            char* tab = strchr(at, '\t');
+            if (tab != NULL)
+            {
+                *tab = 0;
+                probe_skip_names[probe_skip_units] = at;
+                char* rest = tab + 1;
+                probe_skip_expected[probe_skip_units] = (uint32_t)strtoul(rest, &rest, 10);
+                probe_skip_first[probe_skip_units] = ordinals;
+                while (*rest == '\t' || *rest == ',')
+                {
+                    rest += 1;
+                    if (*rest >= '0' && *rest <= '9')
+                    {
+                        probe_skip_ordinals[ordinals] = (uint32_t)strtoul(rest, &rest, 10);
+                        ordinals += 1;
+                    }
+                }
+                probe_skip_units += 1;
+            }
+            at = line_end != NULL ? line_end + 1 : at + strlen(at);
+        }
+        probe_skip_first[probe_skip_units] = ordinals;
+        probe_skip_mode = getenv("BUSTER_PROBE_SKIP_REPORT") != NULL ? 2 : 1;
+    }
+}
+
+static void probe_skip_apply(CheckInputReader* reader, const Parser* parser)
+{
+    if (probe_skip_mode < 0)
+    {
+        probe_skip_load();
+    }
+    if (probe_skip_mode > 0 && probe_skip_unit != NULL)
+    {
+        const char* slash = strrchr(probe_skip_unit, '/');
+        const char* base = slash != NULL ? slash + 1 : probe_skip_unit;
+        const char* dot = strrchr(base, '.');
+        const size_t length = dot != NULL ? (size_t)(dot - base) : strlen(base);
+        uint32_t low = 0;
+        uint32_t high = probe_skip_units;
+        uint32_t found = UINT32_MAX;
+        while (low < high && found == UINT32_MAX)
+        {
+            const uint32_t middle = low + (high - low) / 2;
+            int order = strncmp(base, probe_skip_names[middle], length);
+            order = order == 0 ? -(int)(unsigned char)probe_skip_names[middle][length] : order;
+            if (order == 0)
+            {
+                found = middle;
+            }
+            else if (order < 0)
+            {
+                high = middle;
+            }
+            else
+            {
+                low = middle + 1;
+            }
+        }
+        const uint32_t count = parser->tokens.count;
+        const uint32_t* parents = parser->tree.parents;
+        uint32_t roots = 0;
+        for (uint32_t t = 0; found != UINT32_MAX && t < count; t += 1)
+        {
+            roots += parents[t] == BUSTER_PARSE_ROOT;
+        }
+        probe_skip_counts[0] += 1;
+        if (found == UINT32_MAX)
+        {
+            probe_skip_counts[2] += 1;
+        }
+        else if (roots != probe_skip_expected[found])
+        {
+            probe_skip_counts[1] += 1;
+        }
+        else
+        {
+            const uint32_t* list = probe_skip_ordinals + probe_skip_first[found];
+            const uint32_t listed = probe_skip_first[found + 1] - probe_skip_first[found];
+            uint32_t next = 0;
+            uint32_t ordinal = 0;
+            uint32_t start = 0;
+            for (uint32_t t = 0; t < count; t += 1)
+            {
+                if (parents[t] == BUSTER_PARSE_ROOT)
+                {
+                    if (next < listed && list[next] == ordinal)
+                    {
+                        memset(reader->visits + start, 0, t - start + 1);
+                        memset(reader->ignored + start, 1, t - start + 1);
+                        probe_skip_counts[3] += 1;
+                        probe_skip_counts[4] += t - start + 1;
+                        next += 1;
+                    }
+                    ordinal += 1;
+                    start = t + 1;
+                }
+            }
+        }
+    }
+}
+// ---- end of PROBE ---------------------------------------------------------------------------------------------------
