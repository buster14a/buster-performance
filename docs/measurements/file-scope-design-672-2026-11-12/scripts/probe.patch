+// ---- PROBE (measurement patch of the #672 file-scope record; not for merging) -------------------------------------
+// BUSTER_PROBE=1: every lap also reads five hardware counters with rdpmc (user cycles, user instructions, kernel
+// cycles, kernel instructions, demand fills from DRAM) and charges their growth to the lap's stage; a many-unit
+// command's units run on one lane share one clock (c_checker_units.c), whose marks are laps (no getrusage, no /proc).
+// BUSTER_PROBE=2: the marks also read the minor-fault count (a read() of a software event), charged to their stage.
+#include <linux/perf_event.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+
+#define BUSTER_PROBE_COUNTERS 5u
+static const char* const probe_names[BUSTER_PROBE_COUNTERS] = { "cycles-u", "instructions-u", "cycles-k", "instructions-k", "dram-fills" };
+static struct perf_event_mmap_page* probe_pages[BUSTER_PROBE_COUNTERS];
+static int probe_fds[BUSTER_PROBE_COUNTERS];
+static int probe_fault_fd = -1;
+static uint64_t probe_last[BUSTER_PROBE_COUNTERS];
+static uint64_t probe_fault_last;
+static int probe_mode = -1;
+static bool probe_ready;
+static uint64_t probe_reads_slow;
+
+static uint64_t probe_read(uint32_t i)
+{
+    struct perf_event_mmap_page* page = probe_pages[i];
+    uint64_t count = 0;
+    bool done = false;
+    while (!done)
+    {
+        const uint32_t sequence = __atomic_load_n(&page->lock, __ATOMIC_ACQUIRE);
+        const uint32_t index = page->index;
+        const int64_t offset = page->offset;
+        if (index != 0 && page->cap_user_rdpmc)
+        {
+            uint64_t pmc = __rdpmc((int)index - 1);
+            const uint32_t shift = 64u - page->pmc_width;
+            pmc = (uint64_t)((int64_t)(pmc << shift) >> shift);
+            count = (uint64_t)offset + pmc;
+            done = __atomic_load_n(&page->lock, __ATOMIC_ACQUIRE) == sequence;
+        }
+        else
+        {
+            uint64_t value = 0;
+            if (read(probe_fds[i], &value, sizeof(value)) != (ssize_t)sizeof(value))
+            {
+                value = 0;
+            }
+            probe_reads_slow += 1;
+            count = value;
+            done = true;
+        }
+    }
+    return count;
+}
+
+static int probe_open(uint32_t type, uint64_t config, bool user, bool kernel)
+{
+    struct perf_event_attr attribute = { 0 };
+    attribute.type = type;
+    attribute.size = sizeof(attribute);
+    attribute.config = config;
+    attribute.exclude_user = !user;
+    attribute.exclude_kernel = !kernel;
+    attribute.exclude_hv = 1;
+    return (int)syscall(SYS_perf_event_open, &attribute, 0, -1, -1, 0);
+}
+
+static void probe_start(void)
+{
+    const char* value = getenv("BUSTER_PROBE");
+    probe_mode = value != NULL ? atoi(value) : 0;
+    if (probe_mode > 0)
+    {
+        probe_fds[0] = probe_open(PERF_TYPE_HARDWARE, PERF_COUNT_HW_CPU_CYCLES, true, false);
+        probe_fds[1] = probe_open(PERF_TYPE_HARDWARE, PERF_COUNT_HW_INSTRUCTIONS, true, false);
+        probe_fds[2] = probe_open(PERF_TYPE_HARDWARE, PERF_COUNT_HW_CPU_CYCLES, false, true);
+        probe_fds[3] = probe_open(PERF_TYPE_HARDWARE, PERF_COUNT_HW_INSTRUCTIONS, false, true);
+        probe_fds[4] = probe_open(PERF_TYPE_RAW, 0x843, true, true);
+        probe_ready = true;
+        for (uint32_t i = 0; i < BUSTER_PROBE_COUNTERS; i += 1)
+        {
+            void* page = probe_fds[i] >= 0 ? mmap(NULL, 4096, PROT_READ, MAP_SHARED, probe_fds[i], 0) : MAP_FAILED;
+            probe_ready = probe_ready && page != MAP_FAILED;
+            probe_pages[i] = page != MAP_FAILED ? page : NULL;
+        }
+        if (probe_mode > 1)
+        {
+            probe_fault_fd = probe_open(PERF_TYPE_SOFTWARE, PERF_COUNT_SW_PAGE_FAULTS_MIN, true, true);
+        }
+        if (!probe_ready)
+        {
+            fprintf(stderr, "probe: counters unavailable\n");
+            probe_mode = 0;
+        }
+        for (uint32_t i = 0; probe_ready && i < BUSTER_PROBE_COUNTERS; i += 1)
+        {
+            probe_last[i] = probe_read(i);
+        }
+    }
+}
