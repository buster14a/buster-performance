+    {
+        .name = "shifts by constants",
+        .text = "function (ptr) -> void {\n"
+                "b0:\n"
+                "  %0 = param.ptr 0\n"
+                "  %1 = load.i128 %0 align=16\n"
+                "  %2 = const.i128 0x0\n"
