From 5e7408d63c019df8a001515ecb93cb7530e9b5b7 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 12:19:06 +0000
Subject: [PATCH] experiment: split step 5's shapes (not for the PR)

---
 src/buster/compiler/tier0_inline.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/buster/compiler/tier0_inline.c b/src/buster/compiler/tier0_inline.c
index ecd921bb..bc32642c 100644
--- a/src/buster/compiler/tier0_inline.c
+++ b/src/buster/compiler/tier0_inline.c
@@ -150,6 +150,11 @@ static bool tier0_inline_callee_valid(const Tier0Function* function, uint32_t* b
     bool valid = function->incoming_variadic == 0 && !function->returns_twice && !function->calls_returns_twice && !function->eh_return && !function->unwind_init && function->interrupt == 0 &&
                  function->preserve_general == 0 && function->preserve_vectors == 0 && function->preserve_mask_bytes == 0 && !function->realign_stack &&
                  function->label_count == 0 && function->table_count == 0;
+    // Experiment only (#1398 step 5's 9700X split): BUSTER_S5_EXPERIMENT=r refuses results in memory, =m several returns.
+    const char* experiment = getenv("BUSTER_S5_EXPERIMENT");
+    const bool no_memory = experiment != NULL && experiment[0] == 'r';
+    const bool no_returns = experiment != NULL && experiment[0] == 'm';
+    valid = valid && !(no_memory && function->result.kind == BUSTER_ABI_RESULT_MEMORY);
     const bool returns = count != 0 && function->kinds[count - 1] == BUSTER_TYPED_RETURN;
     // An asm body's labels (#1839, Tier0AsmBody.labels) are defined once, where its own code has them.
     for (uint32_t b = 0; valid && b < function->asm_body_count; b += 1)
@@ -160,7 +165,7 @@ static bool tier0_inline_callee_valid(const Tier0Function* function, uint32_t* b
     {
         const uint32_t kind = function->kinds[e];
         valid = kind != BUSTER_TYPED_ALLOCA && kind != BUSTER_TYPED_STACK_SAVE && kind != BUSTER_TYPED_STACK_RESTORE && kind != BUSTER_TYPED_FRAME_ADDRESS &&
-                kind != BUSTER_TYPED_TAIL_CALL && kind != BUSTER_TYPED_JUMP_INDIRECT;
+                kind != BUSTER_TYPED_TAIL_CALL && kind != BUSTER_TYPED_JUMP_INDIRECT && (!no_returns || kind != BUSTER_TYPED_RETURN || e + 1 == count);
     }
     *body = returns ? count - 1 : count;
     return valid;
-- 
2.43.0

