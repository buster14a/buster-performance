+        ((types->types.flags[type_index(fn)] & (BUSTER_TYPE_FLAG_PROTOTYPE|BUSTER_TYPE_FLAG_VARIADIC))!=BUSTER_TYPE_FLAG_PROTOTYPE) ||
+        type_function_abi_kind(types,fn)!=TYPE_FUNCTION_ABI_SYSV || type_function_keeps_registers(types,fn) ||
+        check_input_library_call(reader,name)!=0 || check_input_window_call_attributes(reader,identifiers->declarations[id],object)) return false;
+    const TypeId ret=type_return(types,fn);
