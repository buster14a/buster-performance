+// The graph has now numbered the front's records. Bind the independent results to their nodes for a comparison
+// with the actual checked stream after compilation, including roots the other shadow refuses for any reason.
+static void node_window_probe_bind(NodeFront* front, CheckInputReader* reader)
+{
+    struct NodeFactsReader* state = front->typer->facts;
+    if (getenv("NODE_SOURCE_ROWS") != NULL)
+    {
+        for (uint32_t r = front->made; r < front->count; r++)
+        {
+            NodeWindowNativeTape* tape = state->proof_source_tapes[r];
+            if (tape != NULL)
+            {
+                const uint32_t key = front->nodes[r];
+                if (key >= state->types->node_capacity || state->types->probe_tapes[key] != NULL) abort();
+                state->types->probe_tapes[key] = tape;
+            }
+        }
+    }
+    for (uint32_t r = front->made; r < front->count; r += 1)
+    {
+        if (front->roots[r] && state->proof_made[r])
+        {
+            const uint32_t left = front->window_left[r];
+            const uint32_t operand = left <= r ? r - left : r;
+            const uint32_t size = front->sizes[operand];
+            if (left == 0 || left > r || size == 0 || size > operand + 1)
+            {
+                fprintf(stderr, "node-proof missing region at token %u\n", front->tokens[r]);
+                continue;
+            }
+            if (node_machine_reader_discard(reader, front, r, operand))
+            {
+                continue;
+            }
+            const uint32_t count = size + 1;
+            const uint64_t bytes = sizeof(NodeWindowProofPart) + (uint64_t)count * sizeof(NodeWindowProofItem);
+            NodeWindowProofPart* part = arena_push_array(reader->arena, bytes, 1, _Alignof(NodeWindowProofPart));
+            if (part == NULL)
+            {
+                fprintf(stderr, "node-proof no space at token %u\n", front->tokens[r]);
+                continue;
+            }
+            part->count = count;
+            part->selection = state->proof_select[r];
+            part->root = front->nodes[r];
+            part->op = front->ops[r];
+            part->next = state->types->proof_parts;
+            state->types->proof_parts = part;
+            for (uint32_t i = 0; i < count; i += 1)
+            {
+                const uint32_t x = i == size ? r : operand + 1 - size + i;
+                part->items[i] = (NodeWindowProofItem){ .node = front->nodes[x], .token = front->tokens[x], .value = state->proof_records[x] };
+            }
+        }
+    }
