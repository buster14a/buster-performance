+            uint64_t made[6] = {0};
+            uint32_t asks_fresh = 0;
+            if (getenv("NODE_SOURCE_SKIP_ROW_INPUTS") != NULL)
+                node_tests_window_bytes_by(tests, state, front, made, true, false, false);
+            else
+                node_tests_window_bytes_by(tests, state, front, made, true, true, true);
+            node_tests_window_loop_by(tests, state, front, count, made + 1, made + 2, made + 3, made + 4, made + 5, &asks_fresh, false);
+            node_tests_window_asks(tests, front, asks_fresh);
+            NodeContextsLoopCounts source_contexts = {0};
+            node_contexts_window_loop(state, front, count, &source_contexts);
+            node_contexts_window_targets(state, front, count);
+            state->c_updates_now = source_contexts.updates_taken;
+            state->c_branches_now = source_contexts.branched - source_contexts.branched_roots + source_contexts.valued;
+            for (uint32_t r = front->made; r < count; ++r)
+                if (state->proof_select[r] & 16u) state->window_c_targets[r] = 0;
+            NodeRowsCounts reads = {0};
+            node_rows_window_reads(state, count, &reads);
+            node_rows_window_shapes(state, front, count);
+            if (state->c_updates_now || state->c_branches_now) node_rows_window_updates(state, front, count, &reads);
+            const uint32_t written = node_rows_window_write(state, front, count);
+            uint32_t lists[BUSTER_NODE_ROWS_LISTS] = {0}, numbered = 0;
+            uint64_t steps = 0;
+            node_rows_window_values(state, front, count, written, &reads, lists, &numbered, &steps);
+            uint32_t kept = 0, entries = 0, calls_kept = 0;
+            for (uint32_t r = front->made; r < count; ++r)
+            {
+                if ((state->proof_select[r] & 16u) == 0) continue;
+                const uint32_t top = r - front->window_left[r], size = front->sizes[top], first = top + 1 - size;
+                if (node_contexts_window_any(state->window_c_masks, BUSTER_NODE_ROWS_MASK_LISTED, first, size)) continue;
+                NodeWindowNativeTape* part = node_probe_keep_tape(state, front, first, top, r, true);
+                state->proof_source_tapes[r] = part;
+                kept++;
+                entries += part->count;
+                calls_kept += part->calls;
+            }
+            fprintf(stderr,"source-rows selected=%u written=%u entries=%u calls=%u\n",selected,kept,entries,calls_kept);
+            state->c_updates_now = old_updates;
+            state->c_branches_now = old_branches;
+            state->window_x_senses = original_senses;
+            state->window_x_expressions = original_expr;
+            state->c_verdicts = original_verdict;
+        }
+        tests->scratch.declaration_facts = old_declarations;
+        tests->event_bits = old_events;
+        tests->line_bytes = old_lines;
+        state->place_taken = old_placed;
+        state->facts.records = old_records;
+    }
+}
