+static NodeFactsRecord node_cross_resolve(const NodeWindowProofItem* item, const TypeTable* types)
+{
+    NodeFactsRecord value = item->value;
+    TypeId ids[] = {value.type,value.converted[0],value.converted[1],(TypeId)value.spare};
+    for (uint32_t k = 0; k < 4; k++)
+    {
+        if (item->pointees[k] == 0) continue;
+        const TypeId pointer = type_find_pointer(types,item->pointees[k]);
+        ids[k] = pointer ? pointer | type_qualifiers(ids[k]) : UINT32_MAX;
+    }
+    value.type=ids[0]; value.converted[0]=ids[1]; value.converted[1]=ids[2];
+    value.spare = (value.spare & ~(uint64_t)UINT32_MAX) | ids[3];
+    return value;
+}
