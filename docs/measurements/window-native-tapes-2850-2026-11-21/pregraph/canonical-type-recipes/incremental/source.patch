+                        part->root_token,part->reference_count,part->count);
+                }
+                state->proof_source_tapes[r] = part;
+                CheckInput* input = state->reader->output;
+                if (input->source_native == NULL)
+                {
+                    input->source_native = BUSTER_ARENA_PUSH_ARRAY(state->reader->arena, NodeWindowNativeTape*, (uint64_t)input->token_count + 1);
+                    if (input->source_native == NULL) abort();
+                    memset(input->source_native, 0, ((size_t)input->token_count + 1) * sizeof(*input->source_native));
+                }
+                uint32_t key = part->root_token;
+                if (key >= input->token_count) abort();
+                if (input->source_native[key] != NULL)
+                {
+                    input->source_key_collisions++;
+                    input->source_native[key] = (NodeWindowNativeTape*)(uintptr_t)1;
+                }
+                else
+                {
+                    input->source_native[key] = part;
+                }
+                input->source_candidates++;
+                kept++;
+                entries += part->count;
+                calls_kept += part->calls;
+            }
+            fprintf(stderr,"source-rows selected=%u written=%u entries=%u calls=%u\n",selected,kept,entries,calls_kept);
+            state->c_updates_now = old_updates;
+            state->c_branches_now = old_branches;
+            state->window_x_senses = original_senses;
+            state->window_x_expressions = original_expr;
+            state->c_verdicts = original_verdict;
+        }
+        tests->scratch.declaration_facts = old_declarations;
+        tests->event_bits = old_events;
+        tests->line_bytes = old_lines;
+        state->place_taken = old_placed;
+        state->facts.records = old_records;
+    }
+}
