+// Exploration: T on the actual front's columns, before the ordinary reader has emitted this chunk's graph.
+// The kernel reads declaration lines, type rows and available operand records. The comparison after ordinary checking
+// reports which named calls and arguments actually had a derivation, including their retained payload fields.
+static void node_probe_warning_select(NodeFront* front);
+static NodeWindowNativeTape* node_window_compact_candidate(NodeFront* front, uint32_t root, uint32_t top, CheckValue* value)
+{
+    struct NodeFactsReader* state = front->typer->facts;
+    CheckInput* input = state->reader->output;
+    const uint32_t token = front->tokens[root];
+    if (input->source_native == NULL || !state->proof_made[root] || !state->proof_made[top] ||
+        (state->proof_select[root] & 48u) != 48u || !check_source_window_compactable(input, token))
+    {
+        return NULL;
+    }
+    NodeWindowNativeTape* tape = input->source_native[token];
+    if (tape != state->proof_source_tapes[root] || tape->root_op != front->ops[root] || tape->compact_node != 0) return NULL;
+    const NodeFactsRecord* record = state->proof_records + top;
+    const uint8_t field = record->standing & BUSTER_NODE_MACHINE_FIELD;
+    if (field == BUSTER_NODE_MACHINE_FLOATING || record->unfit != 0) return NULL;
+    *value = (CheckValue){
+        .type = record->type,
+        .category = (CheckCategory)(record->standing & 3u),
+        .flags = record->flags,
+        .constant_kind = (CheckConstantKind)((record->standing >> 2) & 7u),
+        .integer = field == 0 ? record->payload : 0,
+        .object = record->object,
+        .offset = field == BUSTER_NODE_MACHINE_OFFSET ? (int64_t)record->payload : 0,
+    };
+    return tape;
+}
+static void node_cross_chunk_prepare(NodeFront* front, CheckInputReader* reader)
+{
+    const char* differential = getenv("NODE_CROSS_CHUNK");
+    if (differential && front->typer && front->typer->facts)
+    {
+        NodeMachineReader* typer = front->typer;
+        struct NodeFactsReader* st = typer->facts;
+        if (strchr(differential, 'm')) node_machine_settle(&typer->machine);
+        if (strchr(differential, 'r')) node_facts_settle(&st->facts);
+        if (strchr(differential, 's')) node_machine_reader_strings(typer, reader->output);
+        fprintf(stderr, "cross-chunk records=%u made=%u types=%u settled=%u rows=%u members=%u lines=%u\n",
+                front->count, front->made, typer->machine.types->types.count, typer->machine.type_count,
+                st->facts.row_count, st->facts.member_count, st->facts.line_count);
+    }
+}
+
+// Derive a direct callee's decay within a temporary type-table view. The native
+// tape keeps no provisional TypeId. A conversion witness keeps the pointee key.
+// Populate address and decay answers from pointer types already interned by the shared source/type reader.
+// Lookup does not allocate a type or change its ID. A missing canonical pointer leaves its expression eligible
+// for ordinary fallback. A newly interned pointee can complete a previously empty array or function answer.
+static void node_source_registered_pointers(struct NodeFactsReader* state)
+{
+    NodeFacts* facts = &state->facts;
+    NodeMachine* machine = facts->machine;
+    node_machine_settle(machine);
+    node_facts_settle(facts);
+    if (state->source_pointer_count != facts->row_count)
+    {
+        const TypeTable* types = machine->types;
+        for (uint32_t i = 1; i < facts->row_count; i += 1)
+        {
+            const TypeId type = (TypeId)i << BUSTER_TYPE_INDEX_SHIFT;
+            const uint8_t kind = type_kind(types, type);
+            NodeFactsRow* row = facts->rows + i;
+            NodeFactsSide* side = facts->sides + i;
+            for (uint32_t q = 0; q <= BUSTER_TYPE_CONST; q += 1)
+            {
+                const TypeId qualified = type | q;
+                const TypeId pointer = type_find_pointer(types, qualified);
+                if (pointer != 0 && type_index(pointer) < facts->row_count)
+                {
+                    side->pointers[q] = pointer;
+                    side->pointer_words[q] = node_machine_word(machine, pointer);
+                }
+                if ((row->word & BUSTER_NODE_MACHINE_WORD_PLAIN) != 0 &&
+                    (kind == BUSTER_TYPE_KIND_FUNCTION || type_kind_is_array(kind)))
+                {
+                    const TypeId pointee = kind == BUSTER_TYPE_KIND_FUNCTION ? type : row->element | q;
+                    const TypeId decayed = type_find_pointer(types, pointee);
+                    if (decayed != 0 && type_index(decayed) < facts->row_count)
+                    {
+                        row->decayed[q] = decayed;
+                    }
+                }
+            }
+        }
+        state->source_pointer_count = facts->row_count;
+    }
+}
+
+// Only an address operand, a direct callee, or a leaf in a value-consuming position can request a
+// missing pointer type. The lookup-only control leaves the table unchanged at the same frontier.
+static void node_source_demand_leaf(NodeFront* front, NodeFacts* facts, uint32_t leaf, bool address, uint32_t counts[3])
+{
+    const uint32_t entry = front->window_entries[leaf];
+    if (front->ops[leaf] != CHECK_OP_VALUE || entry == 0 || entry >= facts->line_capacity ||
+        (front->window_kinds[leaf] != BUSTER_NODE_FACTS_LITERAL_LINE && front->window_kinds[leaf] != BUSTER_NODE_FACTS_IDENTIFIER))
+    {
+        return;
+    }
+    TypeTable* types = facts->machine->types;
+    const TypeId type = (TypeId)facts->lines[4 * (uint64_t)entry];
+    if (!type_is_valid(types,type)) { return; }
+    const uint8_t kind = type_kind(types,type);
+    const TypeId pointee = address ? type : kind == BUSTER_TYPE_KIND_FUNCTION ? type_unqualified(type) :
+                           type_kind_is_array(kind) ? type_element(types,type) | type_qualifiers(type) : 0;
+    if (pointee != 0 && type_find_pointer(types,pointee) == 0)
+    {
+        const uint32_t before = types->types.count;
+        const TypeId pointer = type_pointer(types,pointee);
+        if (pointer != 0 && types->types.count > before)
+        {
+            counts[address ? 0 : kind == BUSTER_TYPE_KIND_FUNCTION ? 1 : 2]++;
+        }
+    }
+}
+
+static void node_source_demand_pointers(NodeFront* front, NodeFacts* facts)
+{
+    uint32_t counts[3] = {0};
+    for (uint32_t x = front->made; x < front->count; x += 1)
+    {
+        const CheckOp op = front->ops[x];
+        const uint32_t left = front->window_left[x], right = front->window_right[x];
+        if (left != 0 && left <= x && (op == CHECK_OP_ADDRESS || op == CHECK_OP_CALL || op == CHECK_OP_CONVERT || op == CHECK_OP_CAST))
+        {
+            node_source_demand_leaf(front,facts,x-left,op==CHECK_OP_ADDRESS,counts);
+        }
+        if (right != 0 && right <= x && op == CHECK_OP_ASSIGN)
+        {
+            node_source_demand_leaf(front,facts,x-right,false,counts);
+        }
+        const uint32_t start = front->window_entries[x], args = front->window_counts[x];
+        if (op == CHECK_OP_CALL && start <= front->window_argument_count && args <= front->window_argument_count-start)
+        {
+            for (uint32_t a = 0; a < args; a += 1)
+            {
+                const uint32_t d = front->window_arguments[start+a];
+                if (d != 0 && d <= x) { node_source_demand_leaf(front,facts,x-d,false,counts); }
+            }
+        }
+    }
+    if ((counts[0] || counts[1] || counts[2]) && getenv("NODE_SOURCE_WINDOW_WATCH") != NULL)
+        fprintf(stderr,"source-intern address=%u function=%u array=%u\n",counts[0],counts[1],counts[2]);
+}
+
+
+typedef struct NodeCrossTypeView
+{
+    TypeViewMark mark;
+    NodeFactsRow* saved_rows;
+    NodeFactsSide* saved_sides;
+    TypeError error;
+    TypeChanges* changes;
+    uint32_t hidden_begin, hidden_end, machine_count, row_count, used;
+    uint32_t indices[BUSTER_NODE_FRONT_RECORDS];
+    TypeId decays[BUSTER_NODE_FRONT_RECORDS];
+} NodeCrossTypeView;
+
+static void node_cross_save_row(struct NodeFactsReader* st, uint32_t index, uint32_t permanent)
+{
+    if (permanent == 0 || index >= permanent || st->cross_generation[index] == st->cross_serial) return;
+    NodeCrossTypeUndo* undo = &st->cross_undo[st->cross_undo_count++];
+    st->cross_generation[index] = st->cross_serial;
+    undo->index = index;
+    memcpy(undo->decayed,st->facts.rows[index].decayed,sizeof(undo->decayed));
+    memcpy(undo->pointers,st->facts.sides[index].pointers,sizeof(undo->pointers));
+    memcpy(undo->words,st->facts.sides[index].pointer_words,sizeof(undo->words));
+}
+
+static void node_cross_link_types(struct NodeFactsReader* st,uint32_t first,uint32_t permanent)
+{
+    NodeFacts* f = &st->facts;
+    NodeMachine* machine = f->machine;
+    const TypeTable* tt = machine->types;
+    for (uint32_t i=first ? first : 1; i<f->row_count; i++)
+    {
+        const TypeId type = (TypeId)i << BUSTER_TYPE_INDEX_SHIFT;
+        const uint8_t kind=type_kind(tt,type);
+        NodeFactsRow* row = &f->rows[i];
+        if (type_kind_is_array(kind) && (row->word & BUSTER_NODE_MACHINE_WORD_PLAIN))
+        {
+            if (permanent) abort(); // Demand constructs pointers only.
+            const uint32_t element=type_index(row->element);
+            if (element >= f->row_capacity) continue;
+            st->cross_array_next[i]=st->cross_array_heads[element];
+            st->cross_array_heads[element]=i;
+            for (uint32_t q=0;q<=BUSTER_TYPE_CONST;q++)
+            {
+                const TypeId p=type_find_pointer(tt,row->element|q);
+                if (p && type_index(p)<f->row_count) row->decayed[q]=p;
+            }
+        }
+        if (kind != BUSTER_TYPE_KIND_POINTER) continue;
+        const TypeId target=type_element(tt,type);
+        const uint32_t index=type_index(target);
+        if (index >= f->row_count || type_find_pointer(tt,target)!=type) continue;
+        const uint32_t qualifier=type_qualifiers(target);
+        const bool function=type_kind(tt,target)==BUSTER_TYPE_KIND_FUNCTION;
+        const bool plain=(f->rows[index].word & BUSTER_NODE_MACHINE_WORD_PLAIN)!=0;
+        if (qualifier<=BUSTER_TYPE_CONST)
+        {
+            node_cross_save_row(st,index,permanent);
+            for (uint32_t q=0;q<=BUSTER_TYPE_CONST;q++)
+            {
+                if (q!=qualifier && !function) continue;
+                f->sides[index].pointers[q]=type;
+                f->sides[index].pointer_words[q]=node_machine_word(machine,type);
+                if (function && plain) f->rows[index].decayed[q]=type;
+            }
+        }
+        for (uint32_t a=st->cross_array_heads[index];a;a=st->cross_array_next[a])
+        {
+            for (uint32_t q=0;q<=BUSTER_TYPE_CONST;q++)
+            {
+                if ((f->rows[a].element|q)!=target) continue;
+                node_cross_save_row(st,a,permanent);
+                f->rows[a].decayed[q]=type;
+            }
+        }
+    }
+}
+static void node_cross_incremental_begin(NodeFront* front,struct NodeFactsReader* st)
+{
+    NodeFacts* f = &st->facts;
+    if (!st->cross_array_heads)
+    {
+        const uint32_t count=f->row_capacity+1;
+        st->cross_array_heads=BUSTER_ARENA_PUSH_ARRAY(st->reader->arena,uint32_t,count);
+        st->cross_array_next=BUSTER_ARENA_PUSH_ARRAY(st->reader->arena,uint32_t,count);
+        st->cross_generation=BUSTER_ARENA_PUSH_ARRAY(st->reader->arena,uint32_t,count);
+        st->cross_undo=BUSTER_ARENA_PUSH_ARRAY(st->reader->arena,NodeCrossTypeUndo,count);
+        if (!st->cross_array_heads||!st->cross_array_next||!st->cross_generation||!st->cross_undo) abort();
+        memset(st->cross_array_heads,0,(size_t)count*sizeof(uint32_t));
+        memset(st->cross_generation,0,(size_t)count*sizeof(uint32_t));
+    }
+    if (st->cross_frontier > f->row_count || st->cross_serial==UINT32_MAX) abort();
+    node_cross_link_types(st,st->cross_frontier,0);
+    st->cross_frontier=f->row_count;
+    st->cross_serial++;
+    st->cross_undo_count=0;
+    node_source_demand_pointers(front,f);
+    node_machine_settle(f->machine);
+    node_facts_settle(f);
+    node_cross_link_types(st,st->cross_frontier,st->cross_frontier);
+}
+static void node_cross_incremental_end(struct NodeFactsReader* st)
+{
+    for (uint32_t i=0;i<st->cross_undo_count;i++)
+    {
+        const NodeCrossTypeUndo* u=st->cross_undo+i;
+        memcpy(st->facts.rows[u->index].decayed,u->decayed,sizeof(u->decayed));
+        memcpy(st->facts.sides[u->index].pointers,u->pointers,sizeof(u->pointers));
+        memcpy(st->facts.sides[u->index].pointer_words,u->words,sizeof(u->words));
+    }
+}
+
+static void node_cross_type_begin(NodeFront* front, NodeCrossTypeView* view)
+{
+    struct NodeFactsReader* st = front->typer->facts;
+    NodeFacts* facts = &st->facts;
+    NodeMachine* machine = facts->machine;
+    TypeTable* tt = machine->types;
+    node_machine_settle(machine);
+    node_facts_settle(facts);
+    view->mark = type_view_mark(tt);
+    view->error = tt->last_error;
+    view->changes = tt->changes;
+    view->hidden_begin = tt->hidden_begin;
+    view->hidden_end = tt->hidden_end;
+    view->machine_count = machine->type_count;
+    view->row_count = facts->row_count;
+    view->used = 0;
+    view->saved_rows = NULL;
+    view->saved_sides = NULL;
+    tt->changes = NULL;
+    memset(st->proof_arg_cache, 0, sizeof(st->proof_arg_cache));
+    if (getenv("NODE_CROSS_INCREMENTAL") != NULL)
+    {
+        node_cross_incremental_begin(front,st);
+        return;
+    }
+    if (getenv("NODE_CROSS_TYPE_WIDE") != NULL)
+    {
+        if (st->cross_rows == NULL)
+        {
+            st->cross_rows = arena_push_array(st->reader->arena, (uint64_t)facts->row_capacity + 1, sizeof(NodeFactsRow), 64);
+            st->cross_sides = arena_push_array(st->reader->arena, (uint64_t)facts->row_capacity + 1, sizeof(NodeFactsSide), 64);
+            if (!st->cross_rows || !st->cross_sides) abort();
+        }
+        view->saved_rows = facts->rows;
+        view->saved_sides = facts->sides;
+        memcpy(st->cross_rows, facts->rows, ((size_t)facts->row_count + 1) * sizeof(NodeFactsRow));
+        memcpy(st->cross_sides, facts->sides, ((size_t)facts->row_count + 1) * sizeof(NodeFactsSide));
+        facts->rows = st->cross_rows;
+        facts->sides = st->cross_sides;
+        node_source_demand_pointers(front,facts);
+        st->source_pointer_count = UINT32_MAX;
+        node_source_registered_pointers(st);
+        return;
+    }
+    for (uint32_t r = 0; r < front->count; ++r)
+    {
+        if (front->ops[r] != CHECK_OP_CALL) continue;
+        const uint32_t distance = front->window_left[r];
+        if (!distance || distance > r) continue;
+        const uint32_t child = r - distance;
+        if (front->ops[child] != CHECK_OP_VALUE || front->window_kinds[child] != BUSTER_NODE_FACTS_IDENTIFIER) continue;
+        const uint32_t line = front->window_entries[child];
+        if (!line || line >= facts->line_capacity) continue;
+        const TypeId fn = (TypeId)facts->lines[4 * (uint64_t)line];
+        const uint32_t ix = type_index(fn);
+        if (ix >= facts->row_count || type_kind(tt,fn) != BUSTER_TYPE_KIND_FUNCTION || facts->rows[ix].decayed[0]) continue;
+        const TypeId ptr = type_pointer(tt, fn);
+        if (!ptr || type_index(ptr) >= facts->row_capacity || type_index(ptr) >= machine->type_capacity) continue;
+        view->indices[view->used] = ix;
+        view->decays[view->used++] = facts->rows[ix].decayed[0];
+        facts->rows[ix].decayed[0] = ptr;
+    }
+    node_machine_settle(machine);
+    node_facts_settle(facts);
+}
+static void node_cross_type_end(NodeFront* front, const NodeCrossTypeView* view)
+{
+    struct NodeFactsReader* st = front->typer->facts;
+    NodeFacts* facts = &st->facts;
+    NodeMachine* machine = facts->machine;
+    TypeTable* tt = machine->types;
+    CheckInput* in = st->reader->output;
+    if (!in->cross_callee_pointees)
+    {
+        in->cross_callee_pointees = BUSTER_ARENA_PUSH_ARRAY(st->reader->arena, TypeId, in->token_count + 1u);
+        if (!in->cross_callee_pointees) abort();
+        memset(in->cross_callee_pointees, 0, ((size_t)in->token_count + 1) * sizeof(TypeId));
+    }
+    uint32_t calls = 0, derived = 0, root_private = 0, key_count[4] = {0};
+    for (uint32_t x = 0; x < front->count; x++)
+    {
+        TypeId* keys = st->cross_keys[x];
+        memset(keys, 0, 4 * sizeof(*keys));
+        if (!st->proof_made[x]) continue;
+        const NodeFactsRecord* record = &st->proof_records[x];
+        const TypeId ids[4] = {record->type, record->converted[0], record->converted[1], (TypeId)record->spare};
+        for (uint32_t k = 0; k < 4; k++)
+        {
+            const TypeId id = ids[k];
+            if (type_index(id) < view->mark.types) continue;
+            if (!type_is_valid(tt,id) || type_kind(tt,id) != BUSTER_TYPE_KIND_POINTER ||
+                type_index(type_element(tt,id)) >= view->mark.types)
+            {
+                fprintf(stderr,"cross-unsupported record=%u op=%u slot=%u id=%u mark=%u\n",x,front->ops[x],k,id,view->mark.types);
+                abort();
+            }
+            keys[k] = type_element(tt,id);
+            if (getenv("NODE_CROSS_MUTATE_KEY") != NULL && k == 1) keys[k] = BUSTER_TYPE_INT;
+            key_count[k]++;
+        }
+    }
+    fprintf(stderr,"cross-keys value=%u operand0=%u operand1=%u argument=%u\n",key_count[0],key_count[1],key_count[2],key_count[3]);
+    for (uint32_t r = front->made; r < front->count; ++r)
+    {
+        if (st->proof_source_tapes[r] == NULL) continue;
+        root_private += type_index(st->proof_records[r].type) >= view->mark.types;
+        const uint32_t top = r - front->window_left[r], size = front->sizes[top];
+        for (uint32_t x = top + 1 - size; x <= top; ++x)
+        {
+            if (front->ops[x] != CHECK_OP_CALL || st->window_x_owns[x] != BUSTER_TYPED_CALL) continue;
+            const uint32_t a = x - front->window_left[x], token = front->tokens[x];
+            const NodeFactsRecord* call = st->proof_records + x;
+            const TypeId fn = st->proof_records[a].type, pointer = call->converted[0];
+            if (token >= in->token_count || type_index(fn) >= view->mark.types || !pointer ||
+                type_kind(tt, pointer) != BUSTER_TYPE_KIND_POINTER || type_element(tt,pointer) != type_unqualified(fn) ||
+                call->conversion_flags[0] != BUSTER_CHECK_CONVERT_FUNCTION) abort();
+            if (in->cross_callee_pointees[token] && in->cross_callee_pointees[token] != fn) abort();
+            in->cross_callee_pointees[token] = fn;
+            calls++;
+            derived += type_index(pointer) >= view->mark.types;
+        }
+    }
+    fprintf(stderr,"cross-view rows=%u interned=%u calls=%u provisional=%u root-private=%u\n",
+            view->used,tt->types.count-view->mark.types,calls,derived,root_private);
+    if (getenv("NODE_CROSS_INCREMENTAL") != NULL) node_cross_incremental_end(st);
+    else if (root_private && !view->saved_rows) abort();
+    if (view->saved_rows)
+    {
+        facts->rows = view->saved_rows;
+        facts->sides = view->saved_sides;
+    }
+    for (uint32_t i = 0; i < view->used; ++i) facts->rows[view->indices[i]].decayed[0] = view->decays[i];
+    if (!type_view_reset(tt, view->mark)) abort();
+    tt->hidden_begin=view->hidden_begin; tt->hidden_end=view->hidden_end; tt->last_error=view->error; tt->changes=view->changes;
+    machine->type_count=view->machine_count; facts->row_count=view->row_count;
+    memset(facts->rows+facts->row_count,0,sizeof(NodeFactsRow));
+    memset(facts->sides+facts->row_count,0,sizeof(NodeFactsSide));
+}
+
+static void node_window_probe(NodeFront* front)
+{
+    struct NodeFactsReader* state = front->typer->facts;
+    const bool temporary_types = getenv("NODE_CROSS_TYPE_VIEW") != NULL;
+    NodeCrossTypeView transaction;
+    const uint64_t view_start = __rdtsc();
+    if (temporary_types) node_cross_type_begin(front,&transaction);
+    const uint64_t view_prepared = __rdtsc();
+    NodeFacts run = state->facts;
+    const CheckGraph environment = { .extensions = run.machine->graph->extensions };
+    NodeMachine machine = {
+        .types = run.machine->types, .graph = &environment, .type_words = run.machine->type_words,
+        .type_count = run.machine->type_count, .overloads = run.machine->overloads,
+    };
+    run.machine = &machine;
+    const bool mutate_argument = getenv("NODE_PROOF_FAULT_ARGUMENT") != NULL;
+    const bool trace_calls = getenv("NODE_PROOF_TRACE_CALL") != NULL;
+    run.argument_slots = state->proof_arg_cache;
+    run.input = NULL;
+    run.nodes = NULL;
+    const bool pointers = getenv("NODE_PROOF_POINTERS") != NULL;
+    const bool no_floating = getenv("NODE_PROOF_NO_FP") != NULL;
+    const bool calls = getenv("NODE_PROOF_CALLS") != NULL;
+    const uint32_t count = front->count;
+    uint8_t kinds[BUSTER_NODE_FRONT_RECORDS + 64] = { 0 };
+    uint32_t bounds[2] = { 0, count };
+    memset(state->proof_records, 0, (size_t)count * sizeof(NodeFactsRecord));
+    for (uint32_t x = 0; x < count; x += 1)
+    {
+        const CheckOp op = (CheckOp)front->ops[x];
+        const uint8_t kind = front->window_kinds[x];
+        const uint32_t entry = front->window_entries[x];
+        bool chosen = false;
+        if (op == CHECK_OP_VALUE && (kind == BUSTER_NODE_FACTS_LITERAL_LINE || kind == BUSTER_NODE_FACTS_IDENTIFIER) && entry != 0 && entry < run.line_capacity)
+        {
+            const TypeId type = (TypeId)run.lines[4 * (uint64_t)entry];
+            const uint32_t index = type_index(type);
+            chosen = pointers || (type == type_unqualified(type) && index < BUSTER_NODE_MACHINE_KINDS && node_machine_integer_widths[index] != 0);
