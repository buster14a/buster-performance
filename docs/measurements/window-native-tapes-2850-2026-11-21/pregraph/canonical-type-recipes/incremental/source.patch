+// The root map was populated from the source window before the graph assigned any node an index.
+// Duplicate source keys are ineligible. compact_node is the new operand's checked-graph index plus one.
+static __attribute__((unused)) bool check_source_window_compactable(const CheckInput* input, uint32_t token)
+{
+    const NodeWindowNativeTape* tape = input->source_native != NULL && token < input->token_count ? input->source_native[token] : NULL;
+    return (uintptr_t)tape > 1 && tape->root_token == token && tape->compactable;
