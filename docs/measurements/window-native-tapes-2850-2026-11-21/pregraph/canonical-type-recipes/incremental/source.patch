+typedef struct NodeWindowProofItem NodeWindowProofItem;
+struct NodeWindowProofItem
+{
+    uint32_t node;
+    uint32_t token;
+    NodeFactsRecord value;
+    TypeId pointees[4];
+};
+
+typedef struct NodeWindowProofPart NodeWindowProofPart;
+struct NodeWindowProofPart
+{
+    NodeWindowProofPart* next;
+    uint32_t count;
+    uint32_t root;
+    uint32_t op;
+    uint32_t selection;
+    NodeWindowProofItem items[];
+};
