+    const uint32_t token = input->graph.tokens[node];
+    const NodeWindowNativeTape* tape = token < input->token_count ? input->source_native[token] : NULL;
+    return (uintptr_t)tape > 1 && tape->root_token == token && tape->compact_node != 0 && tape->root_op == input->graph.ops[node] &&
