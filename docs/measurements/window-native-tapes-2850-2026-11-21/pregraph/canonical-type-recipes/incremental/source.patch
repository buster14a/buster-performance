+static void node_window_probe_compare(const CheckProgram* program, const NodeFrontTypes* typed)
+{
+    const CheckStream* stream = program->stream;
+    uint32_t roots = 0, records = 0, mismatched = 0, bad_roots = 0, warning_roots = 0;
+    uint32_t call_roots = 0, calls = 0, args = 0, arg_bad = 0, affected = 0;
+    uint32_t noncanonical = 0, full_bad_roots = 0, full_bad_call_roots = 0;
+    uint64_t totals[2][15] = { 0 };
+    uint32_t bad_by_op[CHECK_OP_COUNT] = { 0 };
+    for (const NodeWindowProofPart* part = typed->proof_parts; part != NULL; part = part->next)
+    {
+        roots += 1;
+        records += part->count;
+        bool any = false;
+        bool warnings = false;
+        bool has_call = false;
+        bool different_value = false;
+        for (uint32_t i = 0; i < part->count; i += 1)
+        {
+            const NodeWindowProofItem* item = part->items + i;
+            const NodeFactsRecord resolved = node_cross_resolve(item,program->types);
+            const NodeFactsRecord* got = &resolved;
+            const uint32_t node = item->node;
+            bool same = node < program->input->graph.count && program->input->graph.tokens[node] == item->token;
+            if (same)
+            {
+                const CheckValue want = check_stream_value(stream, node);
+                warnings |= stream->warnings != NULL && (stream->warnings[node] & 0x01ffffffu) != 0;
+                const uint8_t field = got->standing & BUSTER_NODE_MACHINE_FIELD;
+                const bool floating = field == BUSTER_NODE_MACHINE_FLOATING;
+                const int64_t offset = field == BUSTER_NODE_MACHINE_OFFSET ? (int64_t)got->payload : 0;
+                const unsigned __int128 integer = field == 0 ? got->payload : 0;
+                const CheckValue decoded = {
+                    .type = got->type, .category = (CheckCategory)(got->standing & 3u), .flags = got->flags,
+                    .constant_kind = (CheckConstantKind)((got->standing >> 2) & 7u), .integer = integer,
+                    .floating_storage = { floating ? got->payload : 0, floating ? got->exponent : 0 },
+                    .object = got->object, .offset = offset
+                };
+                if (memcmp(&want, &decoded, sizeof(want)) != 0)
+                {
+                    const CheckOp op = (CheckOp)program->input->graph.ops[node];
+                    if (op < CHECK_OP_COUNT && bad_by_op[op]++ == 0)
+                    {
+                        const unsigned char* a = (const unsigned char*)&want;
+                        const unsigned char* b = (const unsigned char*)&decoded;
+                        for (uint32_t byte = 0; byte < sizeof(want); ++byte)
+                        {
+                            if (a[byte] != b[byte])
+                            {
+                                fprintf(stderr, "probe-full first difference op=%u node=%u token=%u byte=%u expected=%u actual=%u\n", (unsigned)op, node, item->token, byte, a[byte], b[byte]);
+                                break;
+                            }
+                        }
+                    }
+                    noncanonical += 1;
+                    different_value = true;
+                }
+                same = got->type == want.type && (got->standing & 3u) == (uint32_t)want.category && got->flags == want.flags &&
+                       ((got->standing >> 2) & 7u) == (uint32_t)want.constant_kind && got->object == want.object && offset == want.offset &&
+                       want.fault == 0 && want.overload_head == 0 && want.bit_width == 0 && (want.constant_kind == CHECK_CONSTANT_NONE || integer == want.integer) &&
+                       (want.constant_kind != CHECK_CONSTANT_FLOATING || (want.floating_storage[0] == (floating ? got->payload : 0) && (uint16_t)want.floating_storage[1] == (floating ? got->exponent : 0))) &&
+                       got->member_offset == stream->member_offsets[node];
+                for (uint32_t k = 0; k < 2; k += 1)
+                {
+                    const CheckConversion conversion = stream->conversions[node].operands[k];
+                    same = same && got->converted[k] == conversion.type && got->conversion_flags[k] == conversion.flags;
+                }
+            }
+            if (node < program->input->graph.count && program->input->graph.ops[node] == CHECK_OP_CALL)
+            {
+                const CheckGraph* graph = &program->input->graph;
+                has_call = true;
+                calls++;
+                for (uint32_t g = 0; g < graph->argument_counts[node]; ++g)
+                {
+                    const uint32_t at = graph->argument_offsets[node] + g;
+                    const uint32_t source = graph->argument_nodes[at];
+                    uint32_t j = i;
+                    while (j != 0 && part->items[j - 1].node != source) --j;
+                    const CheckConversion want = stream->argument_conversions[at];
+                    const uint64_t packed = (uint64_t)want.type | ((uint64_t)want.flags << 32);
+                    const uint64_t argument = j ? node_cross_resolve(&part->items[j - 1],program->types).spare : UINT64_MAX;
+                    const bool equal = argument == packed;
+                    args++;
+                    arg_bad += !equal;
+                    if (!equal && arg_bad <= 5)
+                        fprintf(stderr, "node-proof call %u argument %u node %u got %" PRIu64 " expected %" PRIu64 "\n", node, g, source,
+                                argument, packed);
+                    same &= equal;
+                }
+            }
+            if (!same && mismatched < 5)
+            {
+                fprintf(stderr, "node-proof stream difference root=%u node=%u token=%u op=%u\n", part->root, node, item->token,
+                        node < program->input->graph.count ? (uint32_t)program->input->graph.ops[node] : UINT32_MAX);
+                if (node < program->input->graph.count && item->token < program->parser->tokens.count)
+                {
+                    const Parser* parser = program->parser;
+                    const Preprocessor* pp = parser->preprocessor;
+                    const uint32_t source = parser->tokens.sources[item->token];
+                    const uint32_t location = pp->output.locations[source];
+                    const uint32_t range = pp_find_range(pp, location);
+                    if (range != BUSTER_PP_NONE && pp->ranges[range].file != BUSTER_PP_NONE)
+                    {
+                        const PPFile* file = pp->files + pp->ranges[range].file;
+                        const PPRange* source_range = pp->ranges + range;
+                        const uint32_t offset = location - source_range->base;
+                        fprintf(stderr, "node-proof source %.*s byte=%u\n", (int)file->path_length, file->path, offset);
+                    }
+                    const CheckValue want = check_stream_value(stream, node);
+                    fprintf(stderr, "node-proof stream-fields type=%u/%u flags=%u/%u category=%u/%u kind=%u/%u object=%u/%u payload=%" PRIu64 " integer=%" PRIu64 " offset=%" PRId64 " floating=%" PRIu64 " fault=%u overload=%u width=%u c0=%u/%u c1=%u/%u cf0=%u/%u cf1=%u/%u member=%" PRIu64 "/%" PRIu64 "\n",
+                            got->type, want.type, got->flags, want.flags, got->standing & 3u, (uint32_t)want.category, got->standing >> 2 & 7u, (uint32_t)want.constant_kind,
+                            got->object, want.object, got->payload, (uint64_t)want.integer, want.offset, want.floating_storage[0], want.fault, want.overload_head, want.bit_width,
+                            got->converted[0], stream->conversions[node].operands[0].type, got->converted[1], stream->conversions[node].operands[1].type,
+                            got->conversion_flags[0], stream->conversions[node].operands[0].flags, got->conversion_flags[1], stream->conversions[node].operands[1].flags,
+                            got->member_offset, stream->member_offsets[node]);
+                }
+            }
+            any |= !same;
+            mismatched += !same;
+        }
+        if (part->selection)
+        {
+            const uint32_t n = part->root;
+            const bool admitted = (part->selection & 16u) != 0;
+            const bool tested = n < typed->node_capacity && (typed->refusals[n] & BUSTER_NODE_FRONT_TYPED_TESTED);
+            const bool swept = tested && (typed->refusals[n] & BUSTER_NODE_FRONT_TYPED_SWEPT) && typed->sweep_refusals[n] == NODE_MACHINE_TAKEN;
+            const uint64_t reader_keys = tested ? typed->tests[n] : 0;
+            const bool observed = n < typed->node_capacity && typed->proof_observed[n] != 0;
+            const uint64_t full_keys = observed ? typed->proof_census[n] : 0;
+            const bool unsafe = admitted && (!tested || !swept || reader_keys || warnings || !observed || full_keys);
+            uint64_t* t = totals[part->op == CHECK_OP_CONVERT ? 0 : 1];
+            t[0]++; t[1] += (part->selection & 2u) != 0; t[2] += (part->selection & 4u) != 0;
+            t[3] += (part->selection & 8u) != 0; t[4] += admitted; t[5] += admitted ? part->count : 0;
+            t[6] += unsafe; t[7] += admitted && !tested; t[8] += admitted && !swept;
+            t[9] += admitted && (reader_keys || full_keys); t[10] += admitted && warnings; t[11] += admitted && !observed;
+            const bool oracle_quiet = tested && swept && observed && reader_keys == 0 && full_keys == 0 && !warnings;
+            t[12] += oracle_quiet; t[13] += oracle_quiet && !admitted; t[14] += admitted && any;
+            if (unsafe && t[6] <= 500)
+            {
+                fprintf(stderr, "probe-select-unsafe root=%u token=%u op=%u reader=%" PRIx64 " full=%" PRIx64 " tested=%u swept=%u warning=%u observed=%u\n",
+                    n, part->items[part->count-1].token, part->op, reader_keys, full_keys, tested, swept, warnings, observed);
+                const Parser* parser = program->parser;
+                const Preprocessor* pp = parser->preprocessor;
+                const uint32_t token = part->items[part->count-1].token;
+                const uint32_t location = pp->output.locations[parser->tokens.sources[token]];
+                const uint32_t range = pp_find_range(pp, location);
+                if (range != BUSTER_PP_NONE && pp->ranges[range].file != BUSTER_PP_NONE)
+                {
+                    const PPFile* file = pp->files + pp->ranges[range].file;
+                    fprintf(stderr, "probe-select-source file=%.*s offset=%u size=%u T=%u context=%u ops=", (int)file->path_length, file->path,
+                            location - pp->ranges[range].base, part->count, n < typed->node_capacity ? typed->refusals[n] & BUSTER_NODE_FRONT_TYPED_REFUSAL : 255,
+                            tested ? typed->kinds[n] : 255);
+                    for (uint32_t i=0; i<part->count; ++i) { fprintf(stderr, "%u,", program->input->graph.ops[part->items[i].node]); }
+                    fputc('\n',stderr);
+                }
+            }
+        }
+        bad_roots += any;
+        warning_roots += warnings;
+        call_roots += has_call;
+        affected += has_call && any;
+        full_bad_roots += different_value;
+        full_bad_call_roots += has_call && different_value;
+    }
+    for (uint32_t b = 0; b < 2; ++b)
+    {
+        const uint64_t* t = totals[b];
+        fprintf(stderr, "probe-select kind=%s eligible=%lu structure=%lu quiet=%lu contexts=%lu admitted=%lu records=%lu unsafe=%lu untested=%lu unswept=%lu keys=%lu warnings=%lu unobserved=%lu oracle=%lu conservative=%lu mismatched=%lu\n",
+                b == 0 ? "return" : "discard", t[0], t[1], t[2], t[3], t[4], t[5], t[6], t[7], t[8], t[9], t[10], t[11], t[12], t[13], t[14]);
+    }
+    fprintf(stderr, "probe-full different-values=%u different-roots=%u different-call-roots=%u\n", noncanonical, full_bad_roots, full_bad_call_roots);
+    fprintf(stderr, "node-proof call-roots=%u calls=%u arguments=%u argument-differences=%u affected-roots=%u\n", call_roots, calls, args, arg_bad, affected);
+    fprintf(stderr, "node-proof stream roots=%u records=%u bad-roots=%u differences=%u warning-bit-roots=%u\n", roots, records, bad_roots, mismatched, warning_roots);
+}
