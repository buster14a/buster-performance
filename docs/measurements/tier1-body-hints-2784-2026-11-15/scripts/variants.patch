+// PROTOTYPE #2784: a range before its value's definition in layout, with no hint interval (a loop body's block laid
+// out before its header, none of whose predecessors precede it), takes the hint chain of the definition's interval
+// back to the first interval that ends (exit) or starts (opening) before it.
+#include <stdlib.h>
+static void tier1_cfg_body_ranges(const Tier1CfgInput* input, const uint32_t* offsets, Tier1CfgPieces* pieces)
+{
+    const char* mode = getenv("P2784");
+    const bool phis_only = mode != 0 && mode[0] == 'p';
+    for (uint32_t v = 0; mode != 0 && v < input->value_count; v += 1)
+    {
+        const uint32_t d = offsets[v] != offsets[v + 1] ? tier1_cfg_piece_at(pieces, offsets[v], offsets[v + 1], input->definitions[v]) : BUSTER_TIER1_CFG_NONE;
+        for (uint32_t i = offsets[v]; d != BUSTER_TIER1_CFG_NONE && i < d; i += 1)
+        {
+            if (pieces->hint_intervals[i] == BUSTER_TIER1_CFG_NONE && pieces->hints[i] == v && (!phis_only || true))
+            {
+                uint32_t c = pieces->hint_intervals[d];
+                bool before = false;
+                for (uint32_t step = 0; c != BUSTER_TIER1_CFG_NONE && !before && step < 8; step += 1)
+                {
+                    const uint32_t n = c & ~BUSTER_TIER1_ALLOCATE_HINT_EXIT;
+                    before = (c & BUSTER_TIER1_ALLOCATE_HINT_EXIT) != 0 ? pieces->ends[n] <= pieces->starts[i] : pieces->starts[n] < pieces->starts[i];
+                    c = before ? c : pieces->hint_intervals[n];
+                }
+                const bool other = mode[0] == 'a' || (before && pieces->values[c & ~BUSTER_TIER1_ALLOCATE_HINT_EXIT] != v);
+                pieces->hint_intervals[i] = before && other && pieces->classes[c & ~BUSTER_TIER1_ALLOCATE_HINT_EXIT] == pieces->classes[i] ? c : BUSTER_TIER1_CFG_NONE;
+            }
+        }
+    }
+}
