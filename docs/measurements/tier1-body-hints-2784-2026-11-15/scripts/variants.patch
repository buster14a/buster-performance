+// LOCAL DEBUG (#2768), not for commit.
+#include <stdio.h>
+#include <stdlib.h>
+static void tier1_debug_2768(const Tier1SelectPlan* plan, const Tier1EmitResult* emitted)
+{
+    const char* env = getenv("BUSTER_DEBUG_2768");
+    const IrFunction* function = plan->function;
+    const Tier1CfgInput* in = &emitted->cfg_input;
+    const Tier1CfgAllocation* cfg = &emitted->cfg;
+    if (env == 0 || in->block_count < (uint32_t)atoi(env))
+    {
+        return;
+    }
+    const uint32_t base = 2 * (in->block_count - function->block_count);
+    uint32_t lo = 0, hi = 0;
+    const char* w = getenv("BUSTER_DEBUG_2768_WINDOW");
+    if (w != 0)
+    {
+        sscanf(w, "%u:%u", &lo, &hi);
+    }
+    uint32_t* nodes = calloc(in->value_count + 1, 4);
+    uint32_t v = 0;
+    for (uint32_t node = 0; node < function->instruction_count; node += 1)
+    {
+        const bool value = plan->covered[node] == 0 && function->type[node] != IR_VOID && function->type[node] != IR_F80;
+        if (value)
+        {
+            nodes[v] = node;
+            v += 1;
+        }
+    }
+    fprintf(stderr, "== debug2768 blocks %u values %u (%u) base %u positions %u intervals %u\n", in->block_count, in->value_count, v, base, in->position_count, cfg->intervals.count);
+    if (getenv("BUSTER_DEBUG_2768_SLOTS") != 0)
+    {
+        const uint32_t spills = cfg->allocation.spill_count;
+        for (uint32_t b = 0; b < in->block_count; b += 1)
+        {
+            for (uint32_t e = in->successor_offsets[b]; e < in->successor_offsets[b + 1]; e += 1)
+            {
+                for (uint32_t m = cfg->edge_move_offsets[e]; m < cfg->edge_move_offsets[e + 1]; m += 1)
+                {
+                    const uint32_t from = cfg->move_sources[m];
+                    const uint32_t to = cfg->move_destinations[m];
+                    const bool slot_from = (from >= BUSTER_TIER1_CFG_SPILL && from != BUSTER_TIER1_CFG_REMATERIALIZE) || from == 11 || to == 11; (void)spills;
+                    const bool slot_to = to >= BUSTER_TIER1_CFG_SPILL || from == 11 || to == 11;
+                    if (slot_from && slot_to)
+                    {
+                        const uint32_t value = cfg->move_values[m];
+                        fprintf(stderr, "slotmove edge %u->%u [%u] v%u n%u op%u slot %u->%u\n", b, in->successors[e], in->block_starts[in->successors[e]], value, nodes[value], function->op[nodes[value]], from - BUSTER_TIER1_CFG_SPILL, to - BUSTER_TIER1_CFG_SPILL);
+                    }
+                }
+            }
+        }
+    }
+    if (w == 0)
+    {
+        uint32_t k = 0;
+        for (uint32_t node = 0; node < function->instruction_count; node += 1)
+        {
+            if (function->op[node] == IR_CALL)
+            {
+                fprintf(stderr, "call %u node %u pos %u sym %u\n", k, node, base + 2 * node, function->a[node]);
+                k += 1;
+            }
+        }
+        free(nodes);
+        return;
+    }
+    for (uint32_t b = 0; b < in->block_count; b += 1)
+    {
+        if (in->block_starts[b + 1] > lo && in->block_starts[b] < hi)
+        {
+            fprintf(stderr, "block %u [%u,%u) preds", b, in->block_starts[b], in->block_starts[b + 1]);
+            for (uint32_t p = in->predecessor_offsets[b]; p < in->predecessor_offsets[b + 1]; p += 1) fprintf(stderr, " %u", in->predecessors[p]);
+            fprintf(stderr, " succs");
+            for (uint32_t s = in->successor_offsets[b]; s < in->successor_offsets[b + 1]; s += 1) fprintf(stderr, " %u", in->successors[s]);
+            fprintf(stderr, "\n");
+            for (uint32_t k = in->phi_offsets[b]; k < in->phi_offsets[b + 1]; k += 1)
+            {
+                fprintf(stderr, "  phi v%u:", in->phi_values[k]);
+                for (uint32_t o = in->phi_operand_offsets[k]; o < in->phi_operand_offsets[k + 1]; o += 1) fprintf(stderr, " v%d", (int)in->phi_operands[o]);
+                fprintf(stderr, "\n");
+            }
+        }
+    }
+    const Tier1AllocationInput* iv = &cfg->intervals;
+    const Tier1Allocation* al = &cfg->allocation;
+    for (uint32_t i = 0; i < iv->count; i += 1)
+    {
+        if (iv->ends[i] > lo && iv->starts[i] < hi && iv->classes[i] == 0)
+        {
+            const uint32_t val = iv->values[i];
+            const uint32_t node = nodes[val];
+            const uint32_t hv = iv->hint_values != 0 ? iv->hint_values[i] : UINT32_MAX;
+            const uint32_t hint = iv->hint_intervals != 0 ? iv->hint_intervals[i] : UINT32_MAX;
+            fprintf(stderr, "iv %u v%u n%u op%u def %u [%u,%u) allowed %05x hv v%d", i, val, node, function->op[node], in->definitions[val], iv->starts[i], iv->ends[i], iv->allowed_registers[i], (int)hv);
+            if (hint != UINT32_MAX)
+            {
+                const uint32_t h = hint & ~BUSTER_TIER1_ALLOCATE_HINT_EXIT;
+                fprintf(stderr, " hi %s%u(v%u [%u,%u))", (hint & BUSTER_TIER1_ALLOCATE_HINT_EXIT) ? "exit:" : "open:", h, iv->values[h], iv->starts[h], iv->ends[h]);
+            }
+            fprintf(stderr, " remat %u uses", iv->rematerializable != 0 ? iv->rematerializable[i] : 0);
+            for (uint32_t u = iv->use_offsets[i]; u < iv->use_offsets[i + 1]; u += 1) fprintf(stderr, " %u%s", iv->use_positions[u], iv->use_required != 0 && iv->use_required[u] ? "R" : "");
+            fprintf(stderr, " frags");
+            for (uint32_t f = al->fragment_offsets[i]; f < al->fragment_offsets[i + 1]; f += 1) fprintf(stderr, " [%u,%u)%s%d", al->starts[f], al->ends[f], al->kinds[f] == BUSTER_TIER1_ALLOCATE_REGISTER ? "r" : al->kinds[f] == BUSTER_TIER1_ALLOCATE_SPILL ? "S" : "M", al->kinds[f] == BUSTER_TIER1_ALLOCATE_REGISTER ? al->registers[f] : -1);
+            fprintf(stderr, "\n");
+        }
+    }
+    free(nodes);
+}
