From 36ceed09ee63c4d2f45e627f68d2b3c770c97d33 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 14:00:45 +0000
Subject: [PATCH 3/3] WIP marks 3

---
 src/buster/compiler/c_check_constant.c          | 4 ++--
 src/buster/compiler/c_check_expression_input.c  | 2 +-
 src/buster/compiler/c_check_input.c             | 2 +-
 src/buster/compiler/c_check_input_initializer.c | 2 +-
 4 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/src/buster/compiler/c_check_constant.c b/src/buster/compiler/c_check_constant.c
index 85586f87..266571dd 100644
--- a/src/buster/compiler/c_check_constant.c
+++ b/src/buster/compiler/c_check_constant.c
@@ -2796,7 +2796,7 @@ static bool check_constant_evaluate(CheckConstantInput* input)
                 const bool enumeration = reader->declaration_kinds[declaration] == C_BINDING_ENUMERATOR;
                 // A constexpr object's value is the constant its initializer's finish read (#793): an integer or a
                 // floating constant, or a null pointer, as an lvalue whose object is still the declaration's.
-                const CheckConstexprValue* constant = (reader->declaration_flags[declaration] & BUSTER_CHECK_DECLARATION_CONSTEXPR) != 0 ?
+                const CheckConstexprValue* constant = (BUSTER_CHECK_RARE(reader, declaration_flags, declaration) & BUSTER_CHECK_DECLARATION_CONSTEXPR) != 0 ?
                     check_input_constexpr_find(reader, declaration) : 0;
                 input->values[index] = constant != 0 ? constant->value : (CheckValue)
                 {
@@ -3052,7 +3052,7 @@ static bool check_constant_evaluate(CheckConstantInput* input)
         }
         else if (role == PARSE_ROLE_CLOSE_KEYWORD)
         {
-            if (reader->builtins[token] == CBUILTIN_CONVERTVECTOR || reader->builtins[token] == CBUILTIN_BIT_CAST)
+            if (BUSTER_CHECK_RARE(reader, builtins, token) == CBUILTIN_CONVERTVECTOR || BUSTER_CHECK_RARE(reader, builtins, token) == CBUILTIN_BIT_CAST)
             {
                 const uint16_t builtin = reader->builtins[token];
                 const uint32_t type_first = input->type_begin[index];
diff --git a/src/buster/compiler/c_check_expression_input.c b/src/buster/compiler/c_check_expression_input.c
index 05c1bea5..e8f5873a 100644
--- a/src/buster/compiler/c_check_expression_input.c
+++ b/src/buster/compiler/c_check_expression_input.c
@@ -375,7 +375,7 @@ static void check_input_expression_list(CheckInputReader* reader, CheckInputBatc
     reader->first_value[token] = values.first;
     reader->last_value[token] = values.last;
     reader->value_counts[token] = values.count;
-    if (reader->static_initializers[token])
+    if (BUSTER_CHECK_RARE(reader, static_initializers, token))
     {
         // A braced static initializer's elements are constant expressions, which initializer planning diagnoses:
         // the same constant evaluation its scalar form's INITIALIZE gets (check_input_expression_act's list).
diff --git a/src/buster/compiler/c_check_input.c b/src/buster/compiler/c_check_input.c
index 3d465c8b..08de0be2 100644
--- a/src/buster/compiler/c_check_input.c
+++ b/src/buster/compiler/c_check_input.c
@@ -10437,7 +10437,7 @@ static __attribute__((noinline)) void check_input_expression_act(CheckInputReade
                 const uint32_t library = use != BUSTER_CHECK_NONE ? check_input_library_call(reader, use) : 0;
                 graph->members[node] = library != 0 ? library : graph->members[node];
             }
-            if (reader->builtins[token] != 0)
+            if (BUSTER_CHECK_RARE(reader, builtins, token) != 0)
             {
                 graph->members[node] = reader->builtins[token];
             }
diff --git a/src/buster/compiler/c_check_input_initializer.c b/src/buster/compiler/c_check_input_initializer.c
index 6ce8743e..354ba1ed 100644
--- a/src/buster/compiler/c_check_input_initializer.c
+++ b/src/buster/compiler/c_check_input_initializer.c
@@ -508,7 +508,7 @@ static bool check_input_initializer_finish(CheckInputReader* reader, uint32_t de
     const uint32_t assignment = check_input_bit(reader->output->declaration_bits, declaration, BUSTER_CHECK_BITS_COMPOUND) ? declaration : begin - 1;
     TypeId type = reader->declared_types[declaration];
     bool valid = begin < end && end <= parser->tokens.count;
-    if (valid && (check_input_auto_type(type) || (reader->declaration_flags[declaration] & BUSTER_CHECK_DECLARATION_DEDUCED) != 0))
+    if (valid && (check_input_auto_type(type) || (BUSTER_CHECK_RARE(reader, declaration_flags, declaration) & BUSTER_CHECK_DECLARATION_DEDUCED) != 0))
     {
         type = check_input_auto_type_finish(reader, declaration, begin, end, type);
         valid = type != 0 && check_input_cleanup_deduced(reader, declaration, type);
-- 
