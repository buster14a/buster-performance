+// Whether the `bytes` of the rare columns' token columns at `entry` may be other than zero: on the vector path of a reading
+// in source order, a page no write claimed is all zero (CheckInputReader.rare_pages), so that a read of it can give 0
+// without touching it, which in base pages would map the zero page there (#628: of sqlite3.c's 6,673 pages, the walks
+// write 688 and read nearly all). Anywhere else, and outside the token columns, true.
+static inline __attribute__((always_inline)) bool check_input_rare_written(const CheckInputReader* reader, const void* entry, uint64_t bytes)
+{
+    bool result = true;
+    if (reader->rare_gated && (const uint8_t*)entry >= reader->rare_begin && (const uint8_t*)entry + bytes <= reader->rare_end)
+    {
+        const uint64_t first = ((uintptr_t)entry >> 12) - ((uintptr_t)reader->rare_begin >> 12);
+        const uint64_t last = (((uintptr_t)entry + bytes - 1) >> 12) - ((uintptr_t)reader->rare_begin >> 12);
+        result = ((reader->rare_pages[first >> 6] >> (first & 63)) & 1) != 0 || ((reader->rare_pages[last >> 6] >> (last & 63)) & 1) != 0;
+    }
+    return result;
+}
