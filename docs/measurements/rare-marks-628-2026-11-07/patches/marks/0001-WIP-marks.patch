+        const uint8_t* first = (const uint8_t*)(page > (uintptr_t)reader->rare_begin ? page : (uintptr_t)reader->rare_begin);
+        const uint8_t* last = (const uint8_t*)(page + 4096 < (uintptr_t)reader->rare_end ? page + 4096 : (uintptr_t)reader->rare_end);
+        bool nonzero = false;
+        for (const uint8_t* byte = first; !nonzero && byte < last; byte += 1)
+        {
