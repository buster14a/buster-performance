+static uint32_t check_input_rare_verify(const CheckInputReader* reader)
+{
+    uint32_t result = 0;
+    const uintptr_t base = (uintptr_t)reader->rare_begin & ~(uintptr_t)4095;
+    for (uintptr_t page = base; page < (uintptr_t)reader->rare_end; page += 4096)
