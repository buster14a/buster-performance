+static __attribute__((noinline)) void check_input_probe_clear(void* data, uint64_t bytes, const char* field, bool survey, bool conditional)
+{
+    uint8_t* p=data;
+    uint64_t total=0,dirty=0,skipped=0;
+    while (bytes>=512)
+    {
+        __m512i a=_mm512_or_si512(_mm512_loadu_si512(p),_mm512_loadu_si512(p+64));
+        __m512i b=_mm512_or_si512(_mm512_loadu_si512(p+128),_mm512_loadu_si512(p+192));
+        __m512i c=_mm512_or_si512(_mm512_loadu_si512(p+256),_mm512_loadu_si512(p+320));
+        __m512i d=_mm512_or_si512(_mm512_loadu_si512(p+384),_mm512_loadu_si512(p+448));
+        const __m512i block=_mm512_or_si512(_mm512_or_si512(a,b),_mm512_or_si512(c,d));
+        const bool any=_mm512_test_epi64_mask(block,block)!=0;
+        if (any || !conditional) memset(p,0,512);
+        total++;
+        dirty+=any;
+        skipped+=!any;
+        p+=512;
+        bytes-=512;
+    }
+    memset(p,0,bytes);
+    if (survey) fprintf(stderr,"clear-survey %s blocks=%llu dirty=%llu zero=%llu tail=%llu\n",field,(unsigned long long)total,
+        (unsigned long long)dirty,(unsigned long long)skipped,(unsigned long long)bytes);
+}
