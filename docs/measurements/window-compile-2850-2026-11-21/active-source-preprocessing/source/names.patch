     *progress = (RefineProgress){ .previous_ends = _mm512_setzero_si512(), .backslash_chunks = backslash_chunks };
 }
 
+static void refine_source_cache_begin(RefineProgress* progress,Arena* arena,uint64_t length)
+{
+    if (length >= (1u<<20))
