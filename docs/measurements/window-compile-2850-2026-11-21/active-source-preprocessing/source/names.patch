+++ b/src/buster/compiler/c_refine.c
@@ -914,12 +914,66 @@ BUSTER_REFINE_FUSED_INSTANTIATE(refine_intern_batch_fused_trigraphs, true)
 // refined a window at a time (refine_tokens_blocks): the ends of the 16 tokens before the next block (lane 15 is the last
 // one's), read before pass C wrote ids over the identifiers' ends in place, and the source's backslash chunks
 // (refine_scan_chunks), scanned up to word `scanned`. refine_progress_begin starts a file's.
+// A source-local table is empty at the start of a large file. A slot for a short
+// name proves its whole identical spelling. A longer name also compares its
+// remaining bytes with the immutable spelling of the cached canonical ID.
+typedef struct RefineSourceName
+{
+    uint64_t first;
+    uint32_t length;
+    IdentId id;
+} RefineSourceName;
+#define BUSTER_REFINE_SOURCE_NAMES 2048u
+
+static bool refine_source_names(InternTable* table, const uint8_t* source, RefineIdentifiers* names, RefineSourceName* cache)
+{
+    for (uint32_t i=0; i<names->count; i+=1)
+    {
+        const uint32_t n=names->lengths[i];
+        const uint8_t* text=source+names->starts[i];
+        uint64_t first;
+        if (n>=8) { memcpy(&first,text,8); }
+        else { first=(uint64_t)_mm_cvtsi128_si64(_mm_maskz_loadu_epi8((__mmask16)_bzhi_u32(0xffff,n),text)); }
+        uint32_t hash=(uint32_t)_mm_crc32_u64(n,first);
+        if (n>8)
+        {
+            uint32_t tail;
+            memcpy(&tail,text+n-4,sizeof(tail));
+            hash=_mm_crc32_u32(hash,tail);
+        }
+        RefineSourceName* entry=&cache[hash & (BUSTER_REFINE_SOURCE_NAMES-1)];
+        IdentId id=entry->id;
+        bool found=entry->length==n && entry->first==first;
+        if (found && n>8)
+        {
+            const uint8_t* record=table->records+table->spans[id].offset;
+            if (n<=64)
+            {
+                const __mmask64 after=_bzhi_u64(~UINT64_C(0),n-8);
+                const __m512i current=_mm512_maskz_loadu_epi8(after,text+8);
+                const __m512i cached=_mm512_maskz_loadu_epi8(after,record+8);
+                found=_mm512_mask_cmpneq_epi8_mask(after,current,cached)==0;
+            }
+            else { found=memcmp(text+8,record+8,n-8)==0; }
+        }
+        if (!found)
+        {
+            id=intern_find_or_add(table,text,n);
+            if (id==0) { return false; }
+            *entry=(RefineSourceName){ .first=first,.length=n,.id=id };
+        }
+        names->ids[i]=id;
+    }
+    return true;
+}
+
