+        {
+            result=refine_source_names(table,source,&identifiers,progress->source_names);
+        }
+        else if (fused)
         {
             for (uint32_t first = 0; result && first < identifiers.count; first += batch)
             {
@@ -997,6 +1064,7 @@ BUSTER_INLINE bool refine_tokens_whole(InternTable* table, const uint8_t* source
     RefineProgress progress;
     uint64_t* backslash_chunks = arena_push_array(scratch.arena, refine_progress_words(length), sizeof(uint64_t), 64);
     refine_progress_begin(&progress, backslash_chunks);
+    refine_source_cache_begin(&progress,scratch.arena,length);
     const bool result = backslash_chunks != 0 &&
                         refine_tokens_with(table, source, length, kinds, starts, ends, values, space, flags, trigraphs, batch, fused, 0, count, &progress);
