diff --git a/src/buster/compiler/c_refine.c b/src/buster/compiler/c_refine.c
index 77056c495..91b96608c 100644
--- a/src/buster/compiler/c_refine.c
+++ b/src/buster/compiler/c_refine.c
@@ -914,12 +914,85 @@ BUSTER_REFINE_FUSED_INSTANTIATE(refine_intern_batch_fused_trigraphs, true)
 // refined a window at a time (refine_tokens_blocks): the ends of the 16 tokens before the next block (lane 15 is the last
 // one's), read before pass C wrote ids over the identifiers' ends in place, and the source's backslash chunks
 // (refine_scan_chunks), scanned up to word `scanned`. refine_progress_begin starts a file's.
+// Eight complete source spellings of at most eight bytes can be gathered and
+// checked together. Misses stay in source order for the canonical intern pass.
+#define BUSTER_REFINE_SOURCE_NAMES 2048u
+#define BUSTER_REFINE_NAME_BATCH 256u
+typedef struct RefineSourceName
+{
+    uint64_t keys[BUSTER_REFINE_SOURCE_NAMES];
+    uint64_t entries[BUSTER_REFINE_SOURCE_NAMES];
+} RefineSourceName;
+
+static bool refine_source_names(InternTable* table, const uint8_t* source, uint64_t length, RefineIdentifiers* names,
+                                RefineSourceName* cache, uint32_t flags, bool trigraphs)
+{
+    RefineIdentifiers pending;
+    uint32_t rows[BUSTER_REFINE_NAME_BATCH];
+    const __m512i scale = _mm512_set1_epi64((long long)UINT64_C(0x9e3779b97f4a7c15));
+    const __m256i lane_numbers = _mm256_setr_epi32(0, 1, 2, 3, 4, 5, 6, 7);
+    const __m512i zero = _mm512_setzero_si512();
+    bool result = true;
+    for (uint32_t batch = 0; result && batch < names->count; batch += BUSTER_REFINE_NAME_BATCH)
+    {
+        const uint32_t end = names->count - batch < BUSTER_REFINE_NAME_BATCH ? names->count : batch + BUSTER_REFINE_NAME_BATCH;
+        pending.count = 0;
+        for (uint32_t i = batch; i < end; i += 8)
+        {
+            const __mmask8 real = end - i >= 8 ? 0xff : (__mmask8)_bzhi_u32(0xff, end - i);
+            const __m256i starts = _mm256_maskz_loadu_epi32(real, names->starts + i);
+            const __m256i sizes = _mm256_maskz_loadu_epi32(real, names->lengths + i);
+            const __m512i offsets = _mm512_cvtepu32_epi64(starts);
+            const __m512i lengths = _mm512_cvtepu32_epi64(sizes);
+            const __mmask8 short_names = _mm512_mask_cmple_epu64_mask(real, lengths, _mm512_set1_epi64(8));
+            const __mmask8 readable = _mm512_mask_cmple_epu64_mask(short_names, offsets, _mm512_set1_epi64((long long)length - 8));
+            const __m512i words = _mm512_mask_i64gather_epi64(zero, readable, offsets, source, 1);
+            const __m512i excluded = _mm512_sllv_epi64(_mm512_set1_epi64(-1), _mm512_slli_epi64(lengths, 3));
+            const __m512i keys = _mm512_andnot_si512(excluded, words);
+            const __m512i slots = _mm512_srli_epi64(_mm512_mullo_epi64(keys, scale), 53);
+            const __m512i existing = _mm512_mask_i64gather_epi64(zero, readable, slots, cache->keys, 8);
+            const __mmask8 equal = _mm512_mask_cmpeq_epu64_mask(readable, keys, existing);
+            const __m512i entries = _mm512_mask_i64gather_epi64(zero, equal, slots, cache->entries, 8);
+            const __mmask8 hits = _mm512_mask_cmpeq_epu64_mask(equal, lengths, _mm512_srli_epi64(entries, 32));
+            _mm256_mask_storeu_epi32(names->ids + i, hits, _mm512_cvtepi64_epi32(entries));
+            const __mmask8 misses = real & ~hits;
+            const __m256i indices = _mm256_add_epi32(lane_numbers, _mm256_set1_epi32((int)i));
+            _mm256_mask_compressstoreu_epi32(pending.starts + pending.count, misses, starts);
+            _mm256_mask_compressstoreu_epi32(pending.lengths + pending.count, misses, sizes);
+            _mm256_mask_compressstoreu_epi32(rows + pending.count, misses, indices);
+            pending.count += (uint32_t)__builtin_popcount(misses);
+        }
+        result = (trigraphs ? refine_pass_b_64_trigraphs : refine_pass_b_64_plain)(table, source, length, &pending, flags);
+        for (uint32_t i = 0; result && i < pending.count; i += 1)
+        {
+            const uint32_t size = pending.lengths[i];
+            const IdentId id = pending.ids[i];
+            names->ids[rows[i]] = id;
+            if (size <= 8 && size == intern_length(table, id))
+            {
+                const uint8_t* text = source + pending.starts[i];
+                const __mmask16 bytes = (__mmask16)_bzhi_u32(0xff, size);
+                const uint64_t key = (uint64_t)_mm_cvtsi128_si64(_mm_maskz_loadu_epi8(bytes, text));
+                const uint64_t actual = (uint64_t)_mm_cvtsi128_si64(_mm_maskz_loadu_epi8(bytes, intern_bytes(table,id)));
+                if (key == actual)
+                {
+                    const uint32_t slot = (uint32_t)((key * UINT64_C(0x9e3779b97f4a7c15)) >> 53);
+                    cache->keys[slot] = key;
+                    cache->entries[slot] = ((uint64_t)size << 32) | id;
+                }
+            }
+        }
+    }
+    return result;
+}
