+// A macro in a regular source line still needs the ordinary macro reader, including argument
+// collection across the next line or an include. Give it immutable raw columns made by the same
+// byte classifier. Its live file context, ranges and expansion locations stay intact.
+static bool pp_enter_source_line(Preprocessor* pp, PPContext* context, const PPFileData* data, uint32_t pos, uint32_t next,
+                                 uint32_t count, __m512i kinds, uint64_t spaces, const uint8_t* starts, const uint8_t* ends,
+                                 uint64_t names, const uint32_t* ids)
+{
+    typedef struct
+    {
+        uint8_t kinds[64 + BUSTER_PP_TOKEN_SLACK];
+        uint32_t starts[64 + BUSTER_PP_TOKEN_SLACK];
+        uint32_t values[64 + BUSTER_PP_TOKEN_SLACK];
+        uint64_t space[3];
+    } PPSourceLine;
+    const uint32_t index = pp->data_count;
+    PPSourceLine* rows = index >= (BUSTER_PP_MAX_FILES >> pp->capacity_shift) ? NULL : arena_push(&pp->arena,sizeof(*rows),64);
+    if (rows == NULL) { return false; }
+    _mm512_storeu_si512(rows->kinds,kinds);
+    rows->kinds[0] |= BUSTER_C_TOKEN_START_OF_LINE;
+    const __m512i base = _mm512_set1_epi32((int32_t)pos);
+    for (uint32_t lane = 0; lane < count; lane += 16)
+    {
+        _mm512_storeu_si512(rows->starts+lane,_mm512_add_epi32(base,_mm512_cvtepu8_epi32(_mm_loadu_si128((const __m128i*)(starts+lane)))));
+        const __m512i raw = _mm512_add_epi32(base,_mm512_cvtepu8_epi32(_mm_loadu_si128((const __m128i*)(ends+lane))));
+        _mm512_storeu_si512(rows->values+lane,_mm512_mask_loadu_epi32(raw,(__mmask16)(names>>lane),ids+lane));
+    }
+    rows->space[0] = spaces;
+    rows->space[1] = rows->space[2] = 0;
+    pp->datas[index] = (PPFileData){ .bytes=data->bytes, .length=data->length, .record=data->record, .device=data->device,
+                                     .inode=data->inode, .modified=data->modified, .has_modified=data->has_modified,
+                                     .prepared=true, .included=data->included, .once=data->once, .dependency=data->dependency,
+                                     .guard_opener=BUSTER_PP_NONE, .kinds=rows->kinds, .starts=rows->starts, .values=rows->values,
+                                     .space=rows->space, .token_count=count, .stream_lines=data->stream_lines, .line_pages=data->line_pages,
+                                     .stream_begin=pos, .stream_end=next != data->length ? next : 0 };
+    pp_stream_count_lines(data,next);
+    pp->data_count += 1;
+    pp->input_tokens += count;
+    context->data = index;
+    context->position = 0;
+    context->next_directive = 0;
+    context->end = count;
+    context->comment_read = false;
+    context->hidden_directives = false;
+    return true;
+}
