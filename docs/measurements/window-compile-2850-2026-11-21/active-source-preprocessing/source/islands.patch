+// A two-byte punctuator made of two operator bytes; zero leaves them as separate tokens.
+// Directives, digraphs, trigraphs, comments and sequences needing a third byte go to the lexer.
+static uint8_t pp_source_punct_pair(uint8_t a, uint8_t b)
+{
+    switch (a)
+    {
+    case '+': return b == '+' ? C_TOKEN_PLUSPLUS : b == '=' ? C_TOKEN_PLUSEQUAL : 0;
+    case '-': return b == '-' ? C_TOKEN_MINUSMINUS : b == '=' ? C_TOKEN_MINUSEQUAL : b == '>' ? C_TOKEN_ARROW : 0;
+    case '*': return b == '=' ? C_TOKEN_STAREQUAL : 0;
+    case '/': return b == '=' ? C_TOKEN_SLASHEQUAL : 0;
+    case '%': return b == '=' ? C_TOKEN_PERCENTEQUAL : 0;
+    case '&': return b == '&' ? C_TOKEN_AMPAMP : b == '=' ? C_TOKEN_AMPEQUAL : 0;
+    case '|': return b == '|' ? C_TOKEN_PIPEPIPE : b == '=' ? C_TOKEN_PIPEEQUAL : 0;
+    case '^': return b == '=' ? C_TOKEN_CARETEQUAL : 0;
+    case '!': return b == '=' ? C_TOKEN_EXCLAIMEQUAL : 0;
+    case '=': return b == '=' ? C_TOKEN_EQUALEQUAL : 0;
+    case '<': return b == '=' ? C_TOKEN_LESSEQUAL : b == '<' ? C_TOKEN_LESSLESS : 0;
+    case '>': return b == '=' ? C_TOKEN_GREATEREQUAL : b == '>' ? C_TOKEN_GREATERGREATER : 0;
+    default: return 0;
+    }
+}
