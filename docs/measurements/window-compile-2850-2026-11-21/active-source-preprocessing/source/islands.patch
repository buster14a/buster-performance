+// Directive indices already available before the source frontier give the scanner's nesting state.
+// Decline structural errors here so the canonical directive reader can report locations once.
+static bool pp_fragment_skip_state(const PPFileData* data, uint32_t d, uint32_t* depth, uint64_t* seen)
+{
+    for (uint32_t i = d + 1; i < data->directive_count; i += 1)
+    {
+        const uint8_t kind = data->directive_kind[i];
+        if (kind == PP_DIRECTIVE_IF || kind == PP_DIRECTIVE_IFDEF || kind == PP_DIRECTIVE_IFNDEF)
+        {
+            if (*depth == 64) { return false; }
+            *seen &= ~(UINT64_C(1) << *depth);
+            *depth += 1;
+        }
+        else if (kind == PP_DIRECTIVE_ENDIF)
+        {
+            if (*depth == 0) { return false; }
+            *depth -= 1;
+        }
+        else if (kind == PP_DIRECTIVE_ELIF || kind == PP_DIRECTIVE_ELSE || kind == PP_DIRECTIVE_ELIFDEF || kind == PP_DIRECTIVE_ELIFNDEF)
+        {
+            if (*depth == 0 || kind == PP_DIRECTIVE_ELIFDEF || kind == PP_DIRECTIVE_ELIFNDEF) { return false; }
+            const uint64_t bit = UINT64_C(1) << (*depth - 1);
+            if ((*seen & bit) != 0) { return false; }
