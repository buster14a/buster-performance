+            end = tail != from && (bytes[tail-1] == '\\' || (tail >= 3 && memcmp(bytes+tail-3,"?" "?/",3)==0)) ?
+                  pp_fragment_cut(bytes,length,low) : (uint32_t)(nl-bytes)+1;
+        }
