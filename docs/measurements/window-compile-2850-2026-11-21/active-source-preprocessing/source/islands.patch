 // whose record the unit's data then copies. Diagnoses a file that can't be prepared, and returns false.
+// Fragment boundaries are before a physical directive at column one, after an unspliced newline.
+// A cut still inside a block comment is rejected after lexical preparation.
+static uint32_t pp_fragment_cut(const uint8_t* bytes, uint32_t length, uint32_t from)
+{
+    for (uint32_t pos = from; pos < length;)
+    {
+        const uint8_t* hash = memchr(bytes + pos, '#', length - pos);
+        if (hash == NULL)
+        {
+            break;
+        }
+        pos = (uint32_t)(hash - bytes);
+        if (pos > 0 && bytes[pos - 1] == '\n')
+        {
+            uint32_t tail = pos - 1;
+            while (tail != 0 && (bytes[tail - 1] == '\r' || bytes[tail - 1] == ' ' || bytes[tail - 1] == '\t' || bytes[tail - 1] == '\v' || bytes[tail - 1] == '\f'))
+            {
+                tail -= 1;
+            }
+            if (tail == 0 || (bytes[tail - 1] != '\\' && !(tail >= 3 && memcmp(bytes + tail - 3, "?" "?/", 3) == 0)))
+            {
+                return pos;
+            }
+        }
+        pos += 1;
+    }
+    return length;
+}
