+// An arm whose opening #if was in a previous fragment has no local pair in the preparer's table.
+static uint32_t pp_fragment_sibling(const PPFileData* data, uint32_t d)
+{
+    uint32_t depth = 0;
+    for (uint32_t i = d + 1; i < data->directive_count; i += 1)
+    {
+        const uint8_t kind = data->directive_kind[i];
+        if (kind == PP_DIRECTIVE_IF || kind == PP_DIRECTIVE_IFDEF || kind == PP_DIRECTIVE_IFNDEF)
+        {
+            depth += 1;
+        }
+        else if (kind == PP_DIRECTIVE_ENDIF)
+        {
+            if (depth == 0) { return i; }
+            depth -= 1;
+        }
+        else if (depth == 0 && (kind == PP_DIRECTIVE_ELSE || kind == PP_DIRECTIVE_ELIF || kind == PP_DIRECTIVE_ELIFDEF || kind == PP_DIRECTIVE_ELIFNDEF))
+        {
+            return i;
+        }
+    }
+    return BUSTER_PP_NONE;
