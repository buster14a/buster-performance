-// An unknown ordinary int rvalue gives its condition an unknown int with its inherited flags.
-// The three absent conversions, payload, status and constant fields already have their initial
-// zero values. Payload-bearing or qualified inputs and the floating-environment pass remain
-// on the ordinary action path.
-static bool check_graph_unknown_int_condition(const TypeTable* types, const CheckGraph* graph, CheckStream* stream, uint32_t node)
+// The logical action on a runtime integer or pointer with no constant value yields an int rvalue.
+// A plain lvalue load has the same result outside constant evaluation. Its address identifies the
+// storage and its conversion records the load. The generic action handles stored constants and
+// values with qualifiers, payloads, overloads or floating-environment effects.
+static bool check_graph_unknown_truth(const TypeTable* types, const CheckGraph* graph, CheckStream* stream, uint32_t node)
 {
     const uint32_t operand = graph->operand0[node];
-    const bool taken = stream->zero_columns && graph->overload_candidate_count == 0 &&
-                 ((graph->fp_environments != NULL ? graph->fp_environments[node] : graph->fp_contract_default) & BUSTER_CHECK_FP_ENV_ACCESS) == 0 &&
-                 operand < node && stream->dense_values == NULL && stream->value_types[operand] == BUSTER_TYPE_INT &&
-                 stream->value_categories[operand] == CHECK_RVALUE && stream->value_constants[operand] == CHECK_CONSTANT_NONE &&
-                 stream->payload_rows[operand] == 0 && (stream->value_flags[operand] & ~BUSTER_CHECK_INHERITED) == 0 &&
-                 type_is_valid(types, BUSTER_TYPE_INT);
-    if (taken)
+    if (!stream->zero_columns || graph->overload_candidate_count != 0 || stream->dense_values != NULL || operand >= node ||
+        ((graph->fp_environments != NULL ? graph->fp_environments[node] : graph->fp_contract_default) & BUSTER_CHECK_FP_ENV_ACCESS) != 0 ||
+        stream->payload_rows[operand] != 0)
     {
-        stream->value_types[node] = BUSTER_TYPE_INT;
-        stream->value_flags[node] = stream->value_flags[operand];
-        stream->conversions[node].operands[0].type = BUSTER_TYPE_INT;
-        stream->statistics.scalar_nodes += 1;
+        return false;
     }
-    return taken;
+    const TypeId type = stream->value_types[operand];
+    const uint32_t code = type_index(type);
+    const bool integer = code >= BUSTER_TYPE_CODE_BOOL && code <= BUSTER_TYPE_CODE_ULLONG;
+    if (type_qualifiers(type) != 0 || !type_is_valid(types, type) || (!integer && type_kind(types, type) != BUSTER_TYPE_KIND_POINTER))
+    {
+        return false;
+    }
+    const bool load = stream->value_categories[operand] == CHECK_LVALUE;
+    const uint8_t constant = stream->value_constants[operand];
+    const uint32_t flags = stream->value_flags[operand];
+    if (load ? ((constant != CHECK_CONSTANT_NONE && constant != CHECK_CONSTANT_ADDRESS) ||
+                (stream->constant_evaluated != NULL && stream->constant_evaluated[node] != 0)) :
+               (stream->value_categories[operand] != CHECK_RVALUE || constant != CHECK_CONSTANT_NONE))
+    {
+        return false;
+    }
+    if ((flags & ~(BUSTER_CHECK_INHERITED | BUSTER_CHECK_NONNULL_ADDRESS)) != 0)
+    {
+        return false;
+    }
+    stream->value_types[node] = BUSTER_TYPE_INT;
+    stream->value_flags[node] = flags & BUSTER_CHECK_INHERITED;
+    stream->conversions[node].operands[0] = (CheckConversion){ .type = type, .flags = load ? BUSTER_CHECK_CONVERT_LVALUE : 0 };
+    stream->statistics.scalar_nodes += 1;
+    return true;
 }
 
