+        const bool name_only = stop - cursor == 1 && parser->tokens.kinds[cursor] == PARSE_KIND_IDENTIFIER &&
+                               parser->tree.roles[cursor] == PARSE_ROLE_OPERAND && !check_input_attribute_starts(parser, cursor, stop) &&
+                               run->common_attributes == NULL && !reader->objc_attributes && !reader->padding_sugar;
+        if (name_only && run->valid)
         {
-            frames[run->depth++] = check_input_declarator_frame(base, cursor, stop, false, false, 0, reader->specifier_abi_origin, reader->specifier_noderef);
