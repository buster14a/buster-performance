+                check_input_set_sugar(reader, cursor, 0);
+            }
+            run->cursor = stop;
+            run->name = cursor;
+            run->result = base;
+            run->abi_origin = reader->specifier_abi_origin;
+            run->noderef = reader->specifier_noderef;
+        }
+        else
+        {
+            run->frames = arena_push_array(reader->scratch, capacity, sizeof(CheckDeclaratorFrame), 8);
+            run->parts = run->frames != NULL ? arena_push_array(reader->scratch, capacity, sizeof(CheckDeclaratorPart), 8) : NULL;
+            run->parameters = run->parts != NULL ? BUSTER_ARENA_PUSH_ARRAY(reader->scratch, CheckDeclaratorParameter, capacity) : NULL;
+            reader->output->resource |= run->parameters == NULL;
+            run->valid &= run->parameters != NULL;
+            if (run->valid)
+            {
+                run->frames[run->depth++] = check_input_declarator_frame(base, cursor, stop, false, false, 0, reader->specifier_abi_origin, reader->specifier_noderef);
