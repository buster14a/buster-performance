+    reader->output->resource |= run == NULL;
     if (run != 0)
     {
         *run = (CheckDeclaratorRun)
         {
-            .frames = frames,
-            .parts = parts,
-            .parameters = parameters,
             .mark = mark,
             .stop = stop,
             .binding_mark = c_bindings_mark(&reader->bindings),
@@ -8078,12 +8074,39 @@ static inline __attribute__((always_inline)) CheckDeclaratorRun* check_input_dec
             .definition_end = BUSTER_CHECK_NONE,
