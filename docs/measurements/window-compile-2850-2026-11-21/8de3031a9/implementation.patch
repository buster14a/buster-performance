     const uint32_t capacity = stop - cursor + 1;
     const uint64_t mark = reader->scratch->length;
     CheckDeclaratorRun* run = arena_push(reader->scratch, sizeof(CheckDeclaratorRun), _Alignof(CheckDeclaratorRun));
