@@ -676,6 +676,44 @@ static void check_test_graph_break(CheckTest* test, CheckGraph* graph, uint32_t
 
 #define BUSTER_CHECK_TEST_GRAPH_RULES 19u
 
+// The leaf rank is independent of writer chunk boundaries. Exercise every alignment and each possible
+// vector tail, including a graph that overwrites the same blocks after returning to its first node.
+static void check_test_graph_leaf_blocks(CheckTest* test)
+{
+    enum { count = 97 };
+    CheckGraphLeafBlock blocks[(count + 15) / 16];
+    uint32_t slots[count];
+    const CheckGraph graph = { .leaf_blocks = blocks };
+    bool same = true;
+    memset(blocks, 0xff, sizeof(blocks));
+    for (uint32_t step = 1; step <= 16; step += 1)
+    {
+        uint32_t next = 0;
+        for (uint32_t first = 0; first < count; first += step)
+        {
+            const uint32_t live = count - first < step ? count - first : step;
+            const uint32_t base = next;
+            uint32_t bits = 0;
+            for (uint32_t lane = 0; lane < live; lane += 1)
+            {
+                const bool leaf = ((first + lane) * 23u + step) % 11u < 7;
+                slots[first + lane] = leaf ? next++ : BUSTER_CHECK_NONE;
+                bits |= (uint32_t)leaf << lane;
+            }
+            check_graph_append_leaf_bits(blocks, first, live, bits, base);
+        }
+        for (uint32_t node = 0; node < count; node += 1)
+        {
+            same &= slots[node] == check_graph_leaf_slot(&graph, node);
+            if (count - node >= 16)
+            {
+                same &= _mm512_cmpeq_epi32_mask(check_graph_leaf_slot_block(&graph, node), _mm512_loadu_si512(slots + node)) == UINT16_MAX;
+            }
+        }
+    }
+    check_test_expect(test, same, "leaf ranks survive partial and unaligned groups and repeated writes");
+}
+
 // #530: check_graph_validate against its definition (check_test_graph_validate_definition), on random graphs of every count to 70
 // and of 4,099 nodes, with and without the exact path's sideband nodes, the optional byte columns and tag history: each
 // graph whole, and once per rule broken at a random node.
@@ -1147,6 +1185,7 @@ static __attribute__((noinline)) void check_test_graph_regressions(CheckTest* te
     check_test_int_conditions(test, table, storage, output, scratch);
     check_test_graph_report_order(test, table, storage, output, scratch);
     check_test_graph_updates(test, table, storage, output, scratch);
+    check_test_graph_leaf_blocks(test);
     check_test_graph_validation(test, storage);
     check_test_graph_validation_edges(test, table, storage, output, scratch);
 }
