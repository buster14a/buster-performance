+    const CheckGraphLeafBlock block = graph->leaf_blocks[node / 16];
+    const uint32_t offset = node & 15u;
+    return ((uint32_t)block.present >> offset) & 1u ? block.first + (uint32_t)__builtin_popcount(_bzhi_u32(block.present, offset)) : BUSTER_CHECK_NONE;
