+// The source graph numbers leaves consecutively. Each group of sixteen nodes needs only its starting
+// number and a bit per leaf. Writers append in postorder; starting a block replaces all of its old bits.
+static inline void check_graph_append_leaf_bits(CheckGraphLeafBlock* blocks, uint32_t node, uint32_t count, uint32_t bits, uint32_t first)
+{
+    const uint32_t offset = node & 15u;
+    CheckGraphLeafBlock* block = blocks + node / 16;
+    if (offset == 0)
+    {
+        *block = (CheckGraphLeafBlock){ .first = first, .present = (uint16_t)bits };
+    }
+    else
+    {
+        block->present = (uint16_t)(_bzhi_u32(block->present, offset) | (bits << offset));
+        const uint32_t room = 16 - offset;
+        if (count > room)
+        {
+            block[1] = (CheckGraphLeafBlock){ .first = first + (uint32_t)__builtin_popcount(_bzhi_u32(bits, room)), .present = (uint16_t)(bits >> room) };
+        }
+    }
