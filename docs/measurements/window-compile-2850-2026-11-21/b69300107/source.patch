+typedef struct CheckSourceBody
+{
+    struct Tier0Function* function;
+    struct CheckControl* controls;
+    uint32_t control_count;
+    uint32_t entry_count;
+    uint32_t* objects;
+    uint32_t symbols;
+    uint32_t references;
+    uint32_t opening;
+    uint32_t closing;
+} CheckSourceBody;
+
+typedef struct CheckSourceBodies
+{
+    CheckSourceBody* rows;
+    uint32_t count;
+    uint32_t capacity;
+} CheckSourceBodies;
+
+static const CheckSourceBody* check_input_source_body(const CheckSourceBodies* bodies, uint32_t opening)
+{
+    uint32_t lo = 0;
+    uint32_t hi = bodies != NULL ? bodies->count : 0;
+    while (lo < hi)
+    {
+        const uint32_t mid = lo + (hi - lo) / 2;
+        if (bodies->rows[mid].opening < opening) lo = mid + 1;
+        else hi = mid;
+    }
+    return bodies != NULL && lo < bodies->count && bodies->rows[lo].opening == opening ? &bodies->rows[lo] : NULL;
+}
+
+// A previously published function owns each statement whose token lies inside its braces.
+static bool check_input_source_has_token(const CheckSourceBodies* bodies, uint32_t token)
+{
+    uint32_t lo=0, hi=bodies!=NULL?bodies->count:0;
+    while(lo<hi)
+    {
+        const uint32_t mid=lo+(hi-lo)/2;
+        if(bodies->rows[mid].closing<token) lo=mid+1;
+        else hi=mid;
+    }
+    return bodies!=NULL && lo<bodies->count && bodies->rows[lo].opening<=token;
+}
+
+static bool check_input_source_add(CheckSourceBodies* bodies, CheckSourceBody row, Arena* arena)
+{
+    if (bodies->count == bodies->capacity)
+    {
+        const uint32_t capacity = bodies->count == 0 ? 8 : bodies->count * 2;
+        if (capacity <= bodies->count) return false;
+        CheckSourceBody* rows = BUSTER_ARENA_PUSH_ARRAY(arena, CheckSourceBody, capacity);
+        if (rows == NULL) return false;
+        if (bodies->count != 0) memcpy(rows,bodies->rows,(size_t)bodies->count*sizeof(*rows));
+        bodies->rows = rows;
+        bodies->capacity = capacity;
+    }
+    if (bodies->count != 0 && row.opening <= bodies->rows[bodies->count - 1].opening) return false;
+    bodies->rows[bodies->count++] = row;
+    return true;
+}
