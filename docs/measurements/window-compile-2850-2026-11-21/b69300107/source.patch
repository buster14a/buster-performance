+// The ordinary unit reader skips a source-owned body. Submit its graph warnings while its original nodes and
+// checked flow are available, so the unit's ordinary diagnostic publisher retains its normal ordering and policy.
+static void check_live_control_warnings(CheckSourceControlUnit* unit, CheckProgram* program, CheckInputReader* reader,
+                                        uint32_t opening, uint32_t closing, Arena* scratch)
+{
+    Preprocessor* pp = reader->pp;
+    if (pp->fatal || pp->options.suppress_warnings || program->input->graph.count == 0)
+    {
+        return;
+    }
+    const Parser* parser = reader->parser;
+    CheckInput input = *program->input;
+    // Source-owned bodies at this boundary exclude GNU statement expressions.
+    input.regions = NULL;
+    input.region_count = 0;
+    const uint64_t mark = scratch->length;
+    if (unit->warning_ignored == NULL)
+    {
+        unit->warning_ignored = BUSTER_ARENA_PUSH_ARRAY(unit->native_metadata, CheckCommonIgnored, 1);
+        if (unit->warning_ignored == NULL ||
+            !check_common_ignored_prepare(unit->warning_ignored, parser, pp, &input, reader->types, unit->native_metadata))
+        {
+            check_common_exhausted(pp);
+            return;
+        }
+    }
+    CheckWarningSpelling spell = { 0 };
+    CheckCommonCandidates candidates = { .count = input.graph.count };
+    CheckCommonFacts facts = { 0 };
+    const CheckCommonEnabled enabled =
+    {
+        .sign_compare = check_common_enabled(pp, &input, CHECK_WARNING_ID_SIGN_COMPARE, true),
+        .out_of_range = check_common_enabled(pp, &input, CHECK_WARNING_ID_TAUTOLOGICAL_OUT_OF_RANGE_COMPARE, false),
+        .enum_cast = input.enum_names,
+        .const_values = &input.const_values,
+    };
+    check_common_contexts = (CheckCommonContexts){ 0 };
+    if (check_common_candidates_build(&input.graph, scratch, &candidates) &&
+        check_common_facts(&input, program->stream, reader->types, parser, program, &enabled, NULL, &candidates, scratch, &facts))
+    {
+        check_common_graph_warnings(parser, pp, &input, program->stream, reader->types, &spell, &facts, program, NULL,
+                                    unit->warning_ignored, opening, closing + 1, scratch);
+    }
+    else
+    {
+        check_common_exhausted(pp);
+    }
+    check_common_contexts = (CheckCommonContexts){ 0 };
+    arena_pop_to(scratch, mark);
+}
