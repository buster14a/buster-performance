+// An ordinary nonconstant integer operand, or a checked integer constant. The presence of an unknown operand
+// prevents a fold. Every other flag, source-time load, fault, qualifier or arithmetic type takes its ordinary action.
+static bool check_body_integer_operand(const CheckStream* stream, uint32_t node, bool* known, uint32_t* conversion)
+{
+    const uint32_t flags = stream->value_flags[node];
+    const uint32_t row = stream->payload_rows[node];
+    const uint32_t category = stream->value_categories[node];
+    const uint32_t constant = stream->value_constants[node];
+    *known = category == CHECK_RVALUE && constant == CHECK_CONSTANT_INTEGER;
+    *conversion = category == CHECK_LVALUE ? BUSTER_CHECK_CONVERT_LVALUE : 0;
+    const uint32_t ordinary = BUSTER_CHECK_SIDE_EFFECT | BUSTER_CHECK_MODIFICATION;
+    if (*known)
+    {
+        return (flags & ~(BUSTER_CHECK_ICE | BUSTER_CHECK_LITERAL_ZERO)) == 0 &&
+               (row == 0 || stream->payloads[row - 1].fault == CHECK_FAULT_NONE);
+    }
+    return (row == 0 || stream->payloads[row - 1].fault == CHECK_FAULT_NONE) &&
+                        ((category == CHECK_RVALUE && row == 0 && constant == CHECK_CONSTANT_NONE && (flags & ~ordinary) == 0) ||
+                        (category == CHECK_LVALUE && (constant == CHECK_CONSTANT_ADDRESS || constant == CHECK_CONSTANT_NONE) &&
+                         (flags & ~(ordinary | BUSTER_CHECK_NONNULL_ADDRESS | BUSTER_CHECK_REGISTER | BUSTER_CHECK_REGISTER_NAME | BUSTER_CHECK_STATIC_OBJECT)) == 0));
+}
+
+// An unqualified builtin integer accepts another integer without a source-type query.
+// A simple lvalue read can still carry its object and address payload in the checked
+// value. Preserve those fields, and use the production conversion for the integer bits.
+static bool check_body_store_transfer(TypeTable* types, const CheckGraph* graph, CheckStream* stream, uint32_t node)
+{
+    const CheckOp op = graph->ops[node];
+    const bool store = op == CHECK_OP_ASSIGN;
+    const uint32_t left = graph->operand0[node];
+    const uint32_t source = store ? graph->operand1[node] : left;
+    if (left >= node || source >= node || (stream->constant_evaluated != NULL && stream->constant_evaluated[node]) ||
+        ((graph->fp_environments != NULL ? graph->fp_environments[node] : graph->fp_contract_default) & BUSTER_CHECK_FP_ENV_ACCESS) != 0)
+        return false;
+    const TypeId input = stream->value_types[source];
+    const TypeId target = store ? stream->value_types[left] : graph->types[node];
+    if (target < BUSTER_TYPE_BOOL || target > BUSTER_TYPE_UINT128 || input < BUSTER_TYPE_BOOL || input > BUSTER_TYPE_UINT128 ||
+        type_qualifiers(target | input) != 0)
+        return false;
+    bool known = false;
+    uint32_t flags = 0;
+    if (store && (stream->value_categories[left] != CHECK_LVALUE || !check_body_integer_operand(stream, left, &known, &flags)))
+        return false;
+    if (!check_body_integer_operand(stream, source, &known, &flags)) return false;
+
+    CheckValue value;
+    check_stream_value_to(stream, source, &value);
+    if (value.category == CHECK_LVALUE)
+    {
+        value.category = CHECK_RVALUE;
+        value.constant_kind = CHECK_CONSTANT_NONE;
+        value.flags &= ~(BUSTER_CHECK_REGISTER | BUSTER_CHECK_REGISTER_NAME | BUSTER_CHECK_VOLATILE_PART);
+    }
+    check_action_convert_plain(types, &value, target, node);
+    if (store)
+    {
+        value.flags &= ~(BUSTER_CHECK_ICE | BUSTER_CHECK_GNU_ICE_FORM | BUSTER_CHECK_FLOAT_LITERAL | BUSTER_CHECK_ICE_UNEVALUATED);
+        value.flags |= BUSTER_CHECK_SIDE_EFFECT | BUSTER_CHECK_MODIFICATION | (stream->value_flags[left] & BUSTER_CHECK_INHERITED);
+    }
+    check_stream_set_value_flags(stream, node, &value, check_value_source_flags(op, value.flags));
+    CheckNodeConversions conv = { 0 };
+    if (store) conv.operands[0].type = target;
+    conv.operands[store].type = target;
+    conv.operands[store].flags = flags | BUSTER_CHECK_CONVERT_ASSIGNMENT;
+    stream->conversions[node] = conv;
+    if (!stream->zero_columns)
+    {
+        stream->diagnostics[node] = CHECK_DIAG_NONE;
+        stream->warnings[node] = 0;
+    }
+    stream->member_offsets[node] = 0;
+    stream->statistics.scalar_nodes += 1;
+    return true;
+}
+
+// Classify sixteen source operators together and execute each proof in graph order.
+// Dependent expressions can consume the result from the immediately preceding lane.
+// The builtin type tables are the same integer promotion and pair tables used by the
+// type kernels. The ordinary check retains constant folding, faults and other types.
+static bool check_body_transfer(TypeTable* types, const CheckGraph* graph, CheckStream* stream,
+                                uint32_t node, CheckBodyActionRows* stats)
+{
+    const CheckOp op = graph->ops[node];
+    if (op == CHECK_OP_ASSIGN || op == CHECK_OP_INITIALIZE || op == CHECK_OP_CONVERT)
+        return check_body_store_transfer(types, graph, stream, node);
+    const uint32_t a = graph->operand0[node];
+    const bool unary = op <= CHECK_OP_BIT_NOT || op == CHECK_OP_CONDITION;
+    const uint32_t b = unary ? a : graph->operand1[node];
+    if (a >= node || b >= node || (stream->constant_evaluated != NULL && stream->constant_evaluated[node]) ||
+        ((graph->fp_environments != NULL ? graph->fp_environments[node] : graph->fp_contract_default) & BUSTER_CHECK_FP_ENV_ACCESS) != 0)
+        return false;
+
+    const bool logical = op == CHECK_OP_NOT || op == CHECK_OP_CONDITION || op == CHECK_OP_LOGICAL_AND || op == CHECK_OP_LOGICAL_OR;
+    const TypeId left = stream->value_types[a];
+    const TypeId right = stream->value_types[b];
+    if (type_qualifiers(left | right) != 0) return false;
+    const bool integral = left >= BUSTER_TYPE_BOOL && left <= BUSTER_TYPE_UINT128 &&
+                          right >= BUSTER_TYPE_BOOL && right <= BUSTER_TYPE_UINT128;
+    if (!integral && !(unary && logical && type_is_valid(types, left) && type_kind(types, left) == BUSTER_TYPE_KIND_POINTER))
+        return false;
+    bool ak = false, bk = false;
+    uint32_t af = 0, bf = 0;
+    if (!check_body_integer_operand(stream, a, &ak, &af) || (!unary && !check_body_integer_operand(stream, b, &bk, &bf))) return false;
+    stats->ready += 1;
+    if ((ak && (unary || bk)) || (logical && (ak || bk)) ||
+        (bk && op >= CHECK_OP_DIVIDE && op <= CHECK_OP_SHIFT_RIGHT)) return false;
+
+    TypeId lt = left, rt = right;
+    if (!logical)
+    {
+        lt = BUSTER_TYPE_BUILTIN(type_promotion_codes[type_index(left)]);
+        rt = BUSTER_TYPE_BUILTIN(type_promotion_codes[type_index(right)]);
+        if (lt != left) af |= BUSTER_CHECK_CONVERT_PROMOTION;
+        if (!unary && rt != right) bf |= BUSTER_CHECK_CONVERT_PROMOTION;
+        if (!unary && op != CHECK_OP_SHIFT_LEFT && op != CHECK_OP_SHIFT_RIGHT)
+        {
+            const uint32_t index = ((type_index(lt) & 7u) << 3) | (type_index(rt) & 7u);
+            const TypeId common = BUSTER_TYPE_BUILTIN(type_integer_codes[index]);
+            if (lt != common) af |= BUSTER_CHECK_CONVERT_ARITHMETIC;
+            if (rt != common) bf |= BUSTER_CHECK_CONVERT_ARITHMETIC;
+            lt = common;
+            rt = common;
+        }
+    }
+    stream->conversions[node] = (CheckNodeConversions){ .operands = {
+        { .type = lt, .flags = af }, { .type = unary ? 0 : rt, .flags = bf } } };
+    stream->value_types[node] = logical || (op >= CHECK_OP_LESS && op <= CHECK_OP_NOT_EQUAL) ? BUSTER_TYPE_INT : lt;
+    stream->value_flags[node] = (stream->value_flags[a] | stream->value_flags[b]) & BUSTER_CHECK_INHERITED;
+    stream->value_objects[node] = 0;
+    stream->value_constants[node] = CHECK_CONSTANT_NONE;
+    stream->value_categories[node] = CHECK_RVALUE;
+    if (!stream->zero_columns)
+    {
+        stream->diagnostics[node] = CHECK_DIAG_NONE;
+        stream->warnings[node] = 0;
+    }
+    stream->member_offsets[node] = 0;
+    stream->statistics.scalar_nodes += 1;
+    return true;
+}
