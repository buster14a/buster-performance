+static void check_body_action_blocks(TypeTable* types, const CheckGraph* graph, CheckStream* stream, CheckValue* arguments,
+                                     Arena* scratch, CheckBodyActionRows* stats)
+{
+    for (uint32_t first = 0; first < graph->count; first += 16)
+    {
+        const uint32_t count = graph->count - first < 16 ? graph->count - first : 16;
+        const __mmask16 live = (__mmask16)((1u << count) - 1);
+        const __m512i op = _mm512_maskz_loadu_epi32(live, graph->ops + first);
+        const __mmask16 operators = _mm512_mask_cmpge_epi32_mask(live, op, _mm512_set1_epi32(CHECK_OP_POSITIVE)) &
+                                    _mm512_cmple_epi32_mask(op, _mm512_set1_epi32(CHECK_OP_LOGICAL_OR));
+        const __mmask16 stores = _mm512_mask_cmpge_epi32_mask(live, op, _mm512_set1_epi32(CHECK_OP_INITIALIZE)) &
+                                 _mm512_cmple_epi32_mask(op, _mm512_set1_epi32(CHECK_OP_CONDITION));
+        const __mmask16 candidates = operators | stores | _mm512_mask_cmpeq_epi32_mask(live, op, _mm512_set1_epi32(CHECK_OP_ASSIGN));
+        stats->integer_ops += (uint32_t)__builtin_popcount(candidates);
+        stats->blocks += 1;
+        for (uint32_t lane = 0; lane < count; lane += 1)
+        {
+            const uint32_t node = first + lane;
+            if ((candidates & (1u << lane)) != 0 && check_body_transfer(types, graph, stream, node, stats))
+            {
+                stats->taken += 1;
+                if (stats->audit) stats->ops[graph->ops[node]] += 1;
+            }
+            else
+            {
+                if (check_graph_is_leaf(graph, node)) check_graph_leaf(types, graph, stream, node);
+                else check_graph_scalar_node(types, graph, stream, node, arguments, scratch);
+                stats->fallback += 1;
+            }
+        }
+    }
+}
