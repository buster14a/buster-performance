+// Only the emitted statement events suppress the synthetic void cast. The operand remains at the
+// same position among the natural roots, including where a call has an unused-result diagnostic.
+static bool check_common_discard_statement(const CheckInput* input, uint32_t node)
+{
+    uint32_t first = 0;
+    uint32_t end = input->discard_statement_count;
+    while (first < end)
+    {
+        const uint32_t middle = first + (end - first) / 2;
+        if ((uint32_t)input->discard_statements[middle] < node)
+        {
+            first = middle + 1;
+        }
+        else
+        {
+            end = middle;
+        }
+    }
+    return first < input->discard_statement_count && (uint32_t)input->discard_statements[first] == node;
+}
