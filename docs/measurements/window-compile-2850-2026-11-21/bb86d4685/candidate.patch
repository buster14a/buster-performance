+            uint8_t included[BUSTER_NODE_FRONT_RECORDS + 64] = {0};
+            uint8_t senses[BUSTER_NODE_FRONT_RECORDS + 64] = {0};
+            uint16_t expressions[BUSTER_NODE_FRONT_RECORDS + 64] = {0};
+            uint8_t verdicts[BUSTER_NODE_FRONT_RECORDS + 64] = {0};
+            const uint8_t required = reader->pp->options.node_source_window ? 48u : 16u;
