+    const bool trace_calls = (!state->reader->pp->options.node_source_window && getenv("NODE_PROOF_TRACE_CALL") != NULL);
+    run.argument_slots = state->proof_arg_cache;
+    run.input = NULL;
+    run.nodes = NULL;
+    const bool pointers = (!state->reader->pp->options.node_source_window && getenv("NODE_PROOF_POINTERS") != NULL);
+    const bool no_floating = state->reader->pp->options.node_source_window || getenv("NODE_PROOF_NO_FP") != NULL;
+    const bool calls = (!state->reader->pp->options.node_source_window && getenv("NODE_PROOF_CALLS") != NULL);
