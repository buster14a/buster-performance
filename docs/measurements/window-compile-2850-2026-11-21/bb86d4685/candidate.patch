+// Only the already qualified integer grammar reaches here. Its sole write is an optional direct
+// outer assignment. Save one event for each automatic identifier, in front postorder, before numbering.
+static bool node_source_compact_local_plan(struct NodeFactsReader* state, const NodeFront* front, NodeWindowNativeTape* tape,
+                                           uint32_t first, uint32_t top)
+{
+    const CheckInput* input = state->reader->output;
+    const Parser* parser = state->reader->parser;
+    const bool store = front->ops[top] == CHECK_OP_ASSIGN;
+    const uint32_t target = store ? top - front->window_left[top] : BUSTER_CHECK_NONE;
+    NodeSourceLocalAccess events[BUSTER_NODE_FRONT_RECORDS + 64];
+    uint32_t used = 0;
+    for (uint32_t x = first; x <= top; x += 1)
+    {
+        const uint32_t object = state->proof_records[x].object;
+        if (front->ops[x] != CHECK_OP_VALUE || object == 0 || object > input->token_count ||
+            check_common_sparse_get(input->declaration_bodies, object - 1) >= input->token_count)
+        {
+            continue;
+        }
+        const uint32_t token = front->tokens[x == target ? top : x];
+        const uint32_t parent = parser->tree.parents[token];
+        const uint8_t role = parent < parser->tokens.count ? parser->tree.roles[parent] : PARSE_ROLE_NONE;
+        const bool statement = x == target && (role == PARSE_ROLE_TERMINATOR || role == PARSE_ROLE_SEPARATOR ||
+                               role == PARSE_ROLE_COMMA || role == PARSE_ROLE_CLOSE_FOR) && !check_common_for_condition(parser, token, parent);
+        events[used++] = (NodeSourceLocalAccess){ .object = object, .token = token, .store = x == target, .statement = statement };
+    }
+    if (used != 0)
+    {
+        tape->accesses = BUSTER_ARENA_PUSH_ARRAY(state->reader->arena, NodeSourceLocalAccess, used);
+        if (tape->accesses != NULL)
+        {
+            memcpy(tape->accesses, events, (size_t)used * sizeof(*events));
+            tape->access_count = used;
+        }
+    }
+    return used == 0 || tape->accesses != NULL;
+}
