+                for (uint32_t t = tests->source_segment_count; !tests->source_segment_types && t < table->types.count; ++t)
+                {
+                    tests->source_segment_types = table->types.kind[t] == BUSTER_TYPE_KIND_QUALIFIED &&
+                                                  check_lower_segment(table, (TypeId)t << BUSTER_TYPE_INDEX_SHIFT);
+                }
+                tests->source_segment_count = table->types.count;
+                segmented = tests->source_segment_types;
+            }
+            else segmented = compact && check_lower_segment_types(state->reader->types);
+
+            for (uint32_t r = front->made; r < count; ++r)
+            {
+                if ((state->proof_select[r] & required) != required) continue;
+                const uint32_t top = r - front->window_left[r], size = front->sizes[top], first = top + 1 - size;
+                if (node_contexts_window_any(state->window_c_masks, BUSTER_NODE_ROWS_MASK_LISTED, first, size)) continue;
+                NodeWindowNativeTape* part = node_probe_keep_tape(state, front, first, top, r, true);
+                if (part == NULL) continue;
+                if (compact)
+                {
+                    const bool local_plan = (reader->pp->options.node_source_window || getenv("NODE_SOURCE_LOCAL_ACCESS") != NULL) && (state->proof_select[r] & 32u) != 0;
+                    if (!local_plan || node_source_compact_local_plan(state,front,part,first,top))
+                        node_source_compact_references(state,front,part,first,top+1,local_warnings,segmented);
+                    if (!reader->pp->options.node_source_window && getenv("NODE_SOURCE_COMPACT_AUDIT") && part->compactable) fprintf(stderr,"compact-admit: token=%u refs=%u rows=%u\n",
+                        part->root_token,part->reference_count,part->count);
+                }
+                state->proof_source_tapes[r] = part;
+                if (reader->pp->options.node_source_window)
+                {
+                    // A parser action can create several discard roots at one token. Only a unique complete
+                    // action may own a physical row. Every record of that action is made in the same chunk.
+                    if ((r != front->made && front->roots[r - 1] && front->tokens[r - 1] == part->root_token) ||
+                        (r + 1 < count && front->roots[r + 1] && front->tokens[r + 1] == part->root_token))
+                        state->proof_source_tapes[r] = NULL;
+                    continue;
+                }
+                CheckInput* input = state->reader->output;
+                if (input->source_native == NULL)
+                {
+                    input->source_native = BUSTER_ARENA_PUSH_ARRAY(state->reader->arena, NodeWindowNativeTape*, (uint64_t)input->token_count + 1);
+                    if (input->source_native == NULL) abort();
+                    memset(input->source_native, 0, ((size_t)input->token_count + 1) * sizeof(*input->source_native));
+                }
+                uint32_t key = part->root_token;
+                if (key >= input->token_count) abort();
+                if (input->source_native[key] != NULL)
+                {
+                    input->source_key_collisions++;
+                    input->source_native[key] = (NodeWindowNativeTape*)(uintptr_t)1;
+                }
+                else
+                {
+                    input->source_native[key] = part;
+                }
+                input->source_candidates++;
+                kept++;
+                entries += part->count;
+                calls_kept += part->calls;
+            }
+            if (!reader->pp->options.node_source_window && getenv("NODE_SOURCE_QUIET") == NULL) fprintf(stderr,"source-rows selected=%u written=%u entries=%u calls=%u\n",selected,kept,entries,calls_kept);
+            state->c_updates_now = old_updates;
+            state->c_branches_now = old_branches;
+            state->window_x_senses = original_senses;
+            state->window_x_expressions = original_expr;
+            state->c_verdicts = original_verdict;
+        }
