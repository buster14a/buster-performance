+            state->c_updates_now = source_contexts.updates_taken;
+            state->c_branches_now = source_contexts.branched - source_contexts.branched_roots + source_contexts.valued;
+            for (uint32_t r = front->made; r < count; ++r)
+                if (state->proof_select[r] & 16u) state->window_c_targets[r] = 0;
+            NodeRowsCounts reads = {0};
+            node_rows_window_reads(state, count, &reads);
+            node_rows_window_shapes(state, front, count);
+            if (state->c_updates_now || state->c_branches_now) node_rows_window_updates(state, front, count, &reads);
+            const uint32_t written = node_rows_window_write(state, front, count);
+            uint32_t lists[BUSTER_NODE_ROWS_LISTS] = {0}, numbered = 0;
+            uint64_t steps = 0;
+            node_rows_window_values(state, front, count, written, &reads, lists, &numbered, &steps);
+            uint32_t kept = 0, entries = 0, calls_kept = 0;
+            const CheckInput* input = state->reader->output;
+            const bool compact = reader->pp->options.node_source_window || getenv("NODE_SOURCE_COMPACT") != NULL || getenv("NODE_SOURCE_COMPACT_AUDIT") != NULL;
+            const bool local_warnings = compact && (check_common_enabled(state->reader->pp,input,CHECK_WARNING_ID_UNINITIALIZED,false) ||
+                check_common_enabled(state->reader->pp,input,CHECK_WARNING_ID_UNUSED_BUT_SET_VARIABLE,false) ||
+                check_common_enabled(state->reader->pp,input,CHECK_WARNING_ID_UNUSED_BUT_SET_PARAMETER,false) ||
+                check_common_enabled(state->reader->pp,input,CHECK_WARNING_ID_UNUSED_PARAMETER,false) ||
+                check_common_enabled(state->reader->pp,input,CHECK_WARNING_ID_UNUSED_VARIABLE,false));
+            bool segmented;
+            if (reader->pp->options.node_source_window)
+            {
