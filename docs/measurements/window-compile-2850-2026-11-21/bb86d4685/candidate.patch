+                const uint32_t size = front->sizes[top];
+                memset(included + top + 1 - size, 1, size);
+                included[r] = 1;
+                senses[top] = BUSTER_NODE_ROWS_SENSE_TOP;
+                expressions[top] = (uint16_t)selected;
+                verdicts[selected++] = BUSTER_NODE_CONTEXTS_TAKEN;
+            }
+            uint8_t* original_senses = state->window_x_senses;
+            uint16_t* original_expr = state->window_x_expressions;
+            uint8_t* original_verdict = state->c_verdicts;
+            const uint32_t old_updates = state->c_updates_now;
+            const uint32_t old_branches = state->c_branches_now;
+            state->window_x_senses = senses;
+            state->window_x_expressions = expressions;
+            state->c_verdicts = verdicts;
+            state->place_taken = included;
+            uint64_t made[6] = {0};
+            uint32_t asks_fresh = 0;
+            node_tests_window_bytes_by(tests, state, front, made, true, true, true);
+            node_tests_window_loop_by(tests, state, front, count, made + 1, made + 2, made + 3, made + 4, made + 5, &asks_fresh, false);
