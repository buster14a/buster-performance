+static void node_source_compact_references(struct NodeFactsReader* state, const NodeFront* front, NodeWindowNativeTape* tape,
+                                            uint32_t first, uint32_t past, bool local_warnings, bool segmented)
+{
+    const CheckInput* input = state->reader->output;
+    if (segmented || !node_source_compact_shape(tape)) return;
+    uint32_t objects[BUSTER_NODE_FRONT_RECORDS+64];
+    uint32_t count = 0;
+    // The ordinary references walker pushes operand0 then operand1 and pops its stack from the end.
+    // The straight-line family below therefore visits its leaf objects in reversed source postorder.
+    for (uint32_t x=past; x-- > first;)
+    {
+        const CheckOp op = front->ops[x];
+        if (!(op <= CHECK_OP_BIT_XOR || op == CHECK_OP_CAST || op == CHECK_OP_CONVERT || op == CHECK_OP_ADDRESS || op == CHECK_OP_ASSIGN)) return;
+        if (op != CHECK_OP_VALUE) continue;
+        const NodeFactsRecord* value = state->proof_records+x;
+        if (value->object == 0) continue;
+        const uint32_t object = value->object;
+        if (object > input->token_count || check_input_bit(input->declaration_bits, object-1, BUSTER_CHECK_BITS_COMPOUND) ||
+            (input->overload_heads != NULL && input->overload_heads[front->tokens[x]] != 0)) return;
+        if ((value->flags & BUSTER_CHECK_STATIC_OBJECT) != 0 || check_input_bit(input->declaration_bits, object-1, BUSTER_CHECK_BITS_STATIC))
+            objects[count++] = object;
+        else if (local_warnings && tape->access_count == 0)
+            return;
+    }
+    if (count)
+    {
+        tape->references = BUSTER_ARENA_PUSH_ARRAY(state->reader->arena,uint32_t,count);
+        if (!tape->references) return;
+        memcpy(tape->references,objects,(size_t)count*sizeof(*objects));
+    }
+    tape->reference_count = count;
+    tape->compactable = true;
+}
