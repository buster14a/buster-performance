+// The callee conversion is solely a pointer to the source declaration's function
+// type. Store that recipe when the pointer has no ordinary TypeId at this
+// frontier. No temporary TypeId or type-table insertion is required.
+static void node_cross_symbolic_callees(NodeFront* front)
+{
+    struct NodeFactsReader* st = front->typer->facts;
+    CheckInput* in = st->reader->output;
+    TypeTable* types = st->facts.machine->types;
+    if (!in->cross_callee_pointees)
+    {
+        in->cross_callee_pointees = BUSTER_ARENA_PUSH_ARRAY(st->reader->arena, TypeId, in->token_count + 1u);
+        if (!in->cross_callee_pointees) abort();
+        memset(in->cross_callee_pointees, 0, ((size_t)in->token_count + 1u) * sizeof(TypeId));
+    }
+    uint32_t requests = 0, deferred = 0;
+    for (uint32_t x=0; x<front->count; x++)
+    {
+        if (!st->proof_made[x] || front->ops[x] != CHECK_OP_CALL) continue;
+        const NodeFactsRecord* call = st->proof_records+x;
+        if (call->conversion_flags[0] != BUSTER_CHECK_CONVERT_FUNCTION) continue;
+        if (front->window_left[x] == 0 || front->window_left[x] > x) abort();
+        const TypeId fn = st->proof_records[x-front->window_left[x]].type;
+        if (type_kind(types,fn) != BUSTER_TYPE_KIND_FUNCTION) abort();
+        if (call->converted[0] == 0)
+        {
+            deferred++;
+        }
+        else if (type_kind(types,call->converted[0]) != BUSTER_TYPE_KIND_POINTER ||
+                 type_element(types,call->converted[0]) != type_unqualified(fn)) abort();
+        const uint32_t token = front->tokens[x];
+        if (token >= in->token_count) abort();
+        if (in->cross_callee_pointees[token] && in->cross_callee_pointees[token] != type_unqualified(fn)) abort();
+        in->cross_callee_pointees[token] = getenv("NODE_CROSS_MUTATE_KEY") != NULL ? BUSTER_TYPE_INT : type_unqualified(fn);
+        requests++;
+    }
+    fprintf(stderr,"cross-symbolic calls=%u deferred=%u\n",requests,deferred);
+}
