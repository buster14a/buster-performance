+// The unused top class bit marks a potential terminal in the diagnostic source-order gate.
+#define BUSTER_CHECK_WINDOW_END 0x80u
+
+static uint32_t check_regular_window_class(const CheckInputReader* reader, uint32_t token)
+{
+    return (reader->visits[token] & BUSTER_CHECK_EXPRESSION_CODE_MASK) >> BUSTER_CHECK_EXPRESSION_CODE_SHIFT;
+}
+
+static uint32_t check_regular_window_seed(const CheckInputReader* reader, uint32_t token, bool returned)
+{
+    const Parser* parser = reader->parser;
+    const uint32_t count = parser->tokens.count;
+    const uint8_t* kinds = parser->tokens.kinds;
+    if (returned && reader->query_types[token] == BUSTER_TYPE_INT && count - token >= 3)
+    {
+        const uint32_t next = check_regular_window_class(reader, token + 1);
+        const bool name = !reader->pp->options.predefines.debug && !reader->pp->options.predefines.debug_modules;
+        if (kinds[token + 2] == PARSE_KIND_SEMI && (next == CHECK_INPUT_CODE_LITERAL || (name && next == CHECK_INPUT_CODE_IDENTIFIER)))
+        {
+            return token;
+        }
+        if (count - token >= 4 && kinds[token + 3] == PARSE_KIND_SEMI && next == CHECK_INPUT_CODE_PREFIX)
+        {
+            const uint32_t arg = check_regular_window_class(reader, token + 2);
+            if ((kinds[token + 1] == PARSE_KIND_MINUS && arg == CHECK_INPUT_CODE_LITERAL) ||
+                (kinds[token + 1] == PARSE_KIND_PLUS && name && arg == CHECK_INPUT_CODE_IDENTIFIER))
+            {
+                return token;
+            }
+        }
+        if (count - token >= 5 && kinds[token + 4] == PARSE_KIND_SEMI && next == CHECK_INPUT_CODE_LITERAL &&
+            check_regular_window_class(reader, token + 3) == CHECK_INPUT_CODE_LITERAL &&
+            (kinds[token + 2] == PARSE_KIND_PLUS || kinds[token + 2] == PARSE_KIND_MINUS || kinds[token + 2] == PARSE_KIND_STAR))
+        {
+            return token;
+        }
+    }
+    else if (!returned && reader->query_types[token] == BUSTER_TYPE_VOID && token >= 2 &&
+             kinds[token - 2] == PARSE_KIND_L_PAREN && kinds[token - 1] == PARSE_KIND_TYPE)
+    {
+        uint32_t leaf = token + 1;
+        while (leaf < count && kinds[leaf] == PARSE_KIND_L_PAREN)
+        {
+            ++leaf;
+        }
+        if (leaf < count && check_regular_window_class(reader, leaf) == CHECK_INPUT_CODE_LITERAL)
+        {
+            uint32_t parent = parser->tree.parents[token];
+            while (parent < count && check_regular_window_class(reader, parent) == CHECK_INPUT_CODE_GROUP)
+            {
+                parent = parser->tree.parents[parent];
+            }
+            if (parent < count && check_regular_window_class(reader, parent) == CHECK_INPUT_CODE_TERMINATOR &&
+                kinds[parent] == PARSE_KIND_SEMI && reader->conditions[parent] == 0)
+            {
+                return parent;
+            }
+        }
+    }
+    return BUSTER_CHECK_NONE;
+}
+
+static bool check_regular_window_unit(CheckInputReader* reader, uint32_t limit, bool marked, bool report)
+{
+    const uint32_t count = reader->parser->tokens.count;
+    uint32_t seeds = 0;
+    for (uint32_t at = 0; at < count && (marked || report || seeds < limit); at += 64)
+    {
+        const uint64_t lanes = _bzhi_u64(UINT64_MAX, count - at < 64 ? count - at : 64);
+        const __m512i visits = _mm512_maskz_loadu_epi8(lanes, reader->visits + at);
+        const __m512i codes = _mm512_and_si512(visits, _mm512_set1_epi8(BUSTER_CHECK_EXPRESSION_CODE_MASK));
+        const uint64_t returns = _mm512_cmpeq_epi8_mask(codes, _mm512_set1_epi8(CHECK_INPUT_CODE_RETURN << BUSTER_CHECK_EXPRESSION_CODE_SHIFT));
+        const uint64_t casts = _mm512_cmpeq_epi8_mask(codes, _mm512_set1_epi8(CHECK_INPUT_CODE_CAST << BUSTER_CHECK_EXPRESSION_CODE_SHIFT));
+        for (uint64_t bits = (returns | casts) & lanes; bits != 0; bits &= bits - 1)
+        {
+            const uint32_t bit = (uint32_t)__builtin_ctzll(bits);
+            const uint32_t token = check_regular_window_seed(reader, at + bit, ((returns >> bit) & 1) != 0);
+            if (token < count)
+            {
+                seeds += 1;
+                if (marked)
+                {
+                    reader->visits[token] |= BUSTER_CHECK_WINDOW_END;
+                }
+            }
+        }
+    }
+    if (report)
+    {
+        fprintf(stderr, "regular-window-unit: tokens=%u seeds=%u limit=%u marked=%u\n", count, seeds, limit, marked);
+    }
+    return seeds >= limit;
+}
+
+static uint32_t check_regular_window_ends(uint32_t* ends, const uint32_t* classes, uint32_t count)
+{
+    uint32_t n = 0;
+    for (uint32_t at = 0; at < count; at += 16)
+    {
+        const uint16_t lanes = (uint16_t)_bzhi_u32(UINT32_MAX, count - at < 16 ? count - at : 16);
+        const __m512i fields = _mm512_maskz_loadu_epi32(lanes, classes + at);
+        for (uint32_t bits = _mm512_test_epi32_mask(fields, _mm512_set1_epi32(BUSTER_CHECK_WINDOW_END)); bits != 0; bits &= bits - 1)
+        {
+            ends[n++] = at + (uint32_t)__builtin_ctz(bits);
+        }
+    }
+    ends[n] = count;
+    return n;
+}
