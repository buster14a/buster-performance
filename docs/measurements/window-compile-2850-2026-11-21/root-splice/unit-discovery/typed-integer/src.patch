+// A unit-level discovery control. The reader already classified these bytes in written source order.
+static bool check_integer_window_unit(CheckInputReader* reader)
+{
+    const uint32_t limit = reader->pp->options.integer_window_screen_min;
+    const bool trace = reader->pp->options.integer_window_screen_report;
+    const bool typed = reader->pp->options.integer_window_screen_typed;
+    const Parser* parser = reader->parser;
+    uint32_t cursor = BUSTER_PP_NONE;
+    const uint32_t count = reader->parser->tokens.count;
+    uint32_t seeds = 0;
+    for (uint32_t at = 1; at + 1 < count && (trace || seeds < limit); at += 64)
+    {
+        const uint32_t remaining = count - 1 - at;
+        const uint64_t lanes = _bzhi_u64(UINT64_MAX, remaining < 64 ? remaining : 64);
+        const __m512i mask = _mm512_set1_epi8(BUSTER_CHECK_EXPRESSION_CODE_MASK);
+        const __m512i literal = _mm512_set1_epi8(CHECK_INPUT_CODE_LITERAL << BUSTER_CHECK_EXPRESSION_CODE_SHIFT);
+        const __m512i prior = _mm512_and_si512(mask, _mm512_maskz_loadu_epi8(lanes, reader->visits + at - 1));
+        const __m512i here = _mm512_and_si512(mask, _mm512_maskz_loadu_epi8(lanes, reader->visits + at));
+        const __m512i next = _mm512_and_si512(mask, _mm512_maskz_loadu_epi8(lanes, reader->visits + at + 1));
+        const uint64_t left = _mm512_cmpeq_epi8_mask(literal, prior);
+        const uint64_t right = _mm512_cmpeq_epi8_mask(literal, next);
+        const uint64_t unary = _mm512_cmpeq_epi8_mask(here, _mm512_set1_epi8(CHECK_INPUT_CODE_PREFIX << BUSTER_CHECK_EXPRESSION_CODE_SHIFT));
+        const uint64_t binary = _mm512_cmpeq_epi8_mask(here, _mm512_set1_epi8(CHECK_INPUT_CODE_BINARY << BUSTER_CHECK_EXPRESSION_CODE_SHIFT));
+        uint64_t bits = lanes & right & (unary | (binary & left));
+        if (!typed)
+        {
+            seeds += (uint32_t)__builtin_popcountll(bits);
+            continue;
+        }
+        for (; bits != 0 && (trace || seeds < limit); bits &= bits - 1)
+        {
+            const uint32_t i = (uint32_t)__builtin_ctzll(bits);
+            const uint32_t token = at + i;
+            const uint32_t r = token + 1;
+            const bool two = ((binary >> i) & 1) != 0;
+            const uint32_t l = two ? token - 1 : r;
+            if (parser->tree.parents[r] != token || parser->tree.parents[l] != token ||
+                parser->tokens.kinds[r] != PARSE_KIND_NUMBER || parser->tokens.kinds[l] != PARSE_KIND_NUMBER ||
+                (reader->constant_contexts[token] & BUSTER_CHECK_CONSTANT_ASSERTION_CONTEXT) != 0)
+            {
+                continue;
+            }
+            const uint8_t kind = parser->tokens.kinds[token];
+            const CheckOp op = two ? check_input_binary(kind) : kind == PARSE_KIND_PLUS ? CHECK_OP_POSITIVE :
+                               kind == PARSE_KIND_MINUS ? CHECK_OP_NEGATIVE : kind == PARSE_KIND_TILDE ? CHECK_OP_BIT_NOT : CHECK_OP_COUNT;
+            if (op < CHECK_OP_COUNT && !check_integer_window_observed(parser, token, op))
+            {
+                const uint32_t x = check_integer_window_literal(reader, l, check_input_literal_plain(reader, l, &cursor));
+                const uint32_t y = l == r ? x : check_integer_window_literal(reader, r, check_input_literal_plain(reader, r, &cursor));
+                uint32_t result;
+                seeds += x != BUSTER_CHECK_NONE && y != BUSTER_CHECK_NONE && check_node_window_fold_int(op, x, y, two, &result);
+            }
+        }
+    }
+    if (trace)
+    {
+        fprintf(stderr, "integer-window-unit: token-count=%u seeds=%u limit=%u\n", count, seeds, limit);
+    }
+    return seeds >= limit;
+}
