+        program->object_symbols[call->object] == 0 || call->function == 0 || type_index(call->function) >= types->types.count ||
+        type_kind(types, call->function) != BUSTER_TYPE_KIND_FUNCTION || call->variadic ||
+        (types->types.flags[type_index(call->function)] & BUSTER_TYPE_FLAG_PROTOTYPE) == 0 ||
+        type_function_abi_kind(types, call->function) != TYPE_FUNCTION_ABI_SYSV || type_function_keeps_registers(types, call->function) ||
+        check_lower_convention_call(types, call->function, writer->target.features) != NULL) return false;
+    uint32_t parameters = 0;
+    const TypeId* formal = type_parameters(types, call->function, &parameters);
+    const TypeId result = type_return(types, call->function);
+    if (parameters != call->arguments || parameters > BUSTER_TIER0_MAX_CALL_ARGUMENTS ||
+        !check_lower_source_call_type(writer,result,true))
+        return false;
+    for (uint32_t i = 0; i < parameters; ++i)
+    {
+        const TypeId argument = call->argument_types[i];
+        if (type_unqualified(argument) != type_unqualified(formal[i]) ||
+            !check_lower_source_call_type(writer,argument,false) ||
+            call->classes[i] > BUSTER_TYPED_CLASS_U64 || call->classes[i] != check_lower_class(writer,argument)) return false;
+    }
+    const bool discard = tape->entries[tape->count-1].kind == BUSTER_TYPED_DISCARD;
+    if (tape->count < 1u + discard || tape->count - 1u - discard != parameters) return false;
+    const NodeWindowNativeEntry* end = tape->entries + parameters;
+    if (end->kind != BUSTER_TYPED_CALL || end->class != check_lower_class(writer,result) || end->value != 0 ||
+        end->left_token >= program->input->token_count || (discard && tape->entries[parameters+1].cast_token >= program->input->token_count))
+        return false;
+    uint64_t values[32];
+    for (uint32_t i = 0; i < parameters; ++i)
