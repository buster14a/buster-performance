+// Source object addresses stay symbolic until lowering. A VLA's actual address already lives in its slot.
+static void check_lower_source_entry(CheckLowerWriter* writer, const NodeWindowNativeEntry* row, uint64_t value)
+{
+    const bool address = row->kind == BUSTER_TYPED_LOCAL_ADDRESS || row->kind == BUSTER_TYPED_GLOBAL_ADDRESS;
+    if (address && (writer->source_native_probes & 8u) == 0)
+    {
+        check_lower_address(writer,(uint32_t)row->value,0);
+    }
+    else
+    {
+        check_lower_emit(writer,row->kind,row->class,value);
