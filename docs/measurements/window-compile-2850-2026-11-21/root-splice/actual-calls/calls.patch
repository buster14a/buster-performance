+        const uint8_t kind = entry->kind;
+        if (entry->op != CHECK_OP_VALUE || kind < BUSTER_TYPED_CONST || kind > BUSTER_TYPED_GLOBAL_ADDRESS ||
+            entry->class == BUSTER_TYPED_CLASS_VOID || entry->class != call->classes[i]) return false;
+        values[i] = entry->value;
+        if (kind == BUSTER_TYPED_CONST) continue;
+        if (entry->value >= program->object_count) return false;
+        const bool local = kind == BUSTER_TYPED_LOCAL || kind == BUSTER_TYPED_LOCAL_ADDRESS;
+        values[i] = local ? check_lower_local_of(writer, (uint32_t)entry->value) : program->object_symbols[entry->value];
+        if ((local && values[i] >= writer->local_count) || (!local && values[i] == 0) ||
+            (kind == BUSTER_TYPED_LOCAL && writer->local_classes[values[i]] != entry->class)) return false;
+    }
+    const char* fault = getenv("NODE_SOURCE_CALL_FAULT");
+    const SymbolId symbol = program->object_symbols[call->object] ^ (fault != NULL && fault[0] == 's' ? 1u : 0u);
+    const uint32_t dest = check_lower_native_call(writer,symbol,result,call->argument_types,parameters);
+    if (dest == BUSTER_CHECK_NONE) return true;
+    writer->calls_returns_twice |= writer->twice && check_lower_calls_twice(writer,call->object);
+    const uint32_t outer = writer->source;
+    for (uint32_t i = 0; i < parameters; ++i)
+    {
+        const NodeWindowNativeEntry* entry = tape->entries+i;
+        check_lower_source(writer,entry->token);
+        const bool wrong_constant = fault != NULL && fault[0] == 'v' && entry->kind == BUSTER_TYPED_CONST;
+        check_lower_source_entry(writer,entry,values[i] ^ (uint64_t)wrong_constant);
+    }
+    check_lower_source(writer,fault != NULL && fault[0] == 't' ? end->token : end->left_token);
+    check_lower_emit(writer,BUSTER_TYPED_CALL,end->class,dest);
+    if (discard)
+    {
+        const NodeWindowNativeEntry* drop = end+1;
+        check_lower_source(writer,drop->cast_token);
+        check_lower_emit(writer,drop->kind,drop->class,drop->value);
+    }
+    check_lower_source(writer,outer);
+    if ((writer->source_native_probes & 1u) != 0)
+        fprintf(stderr,"splice-direct: token=%u call=%u rows=%u args=%u\n",tape->root_token,dest,tape->count,parameters);
+    return true;
+}
