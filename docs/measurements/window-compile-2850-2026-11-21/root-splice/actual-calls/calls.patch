+static bool check_lower_source_call_type(const CheckLowerWriter* writer, TypeId type, bool void_ok)
+{
+    const TypeTable* types = writer->program->types;
+    if (type == 0 || type_index(type) >= types->types.count) return false;
+    const uint8_t kind = type_kind(types, type_strip_aligned(types, type));
+    const uint8_t class = check_lower_class(writer, type);
+    return ((kind == BUSTER_TYPE_KIND_INTEGER || kind == BUSTER_TYPE_KIND_POINTER) && class >= BUSTER_TYPED_CLASS_I8 &&
+            class <= BUSTER_TYPED_CLASS_U64) || (void_ok && kind == BUSTER_TYPE_KIND_VOID && class == BUSTER_TYPED_CLASS_VOID);
+}
+
+// This optional subset retains the graph for diagnostics and object discovery. Direct fixed prototypes with
+// scalar arguments, no ABI conversion entries and one call can reserve their ordinary call row before replay.
+static bool check_lower_source_call(CheckLowerWriter* writer, const NodeWindowNativeTape* tape, uint32_t flags)
+{
+    const CheckProgram* program = writer->program;
+    const TypeTable* types = program->types;
+    if (tape->rows == NULL || tape->calls != 1 || writer->chain != BUSTER_CHECK_NONE || writer->tail != BUSTER_CHECK_NONE ||
+        (tape->root_op != CHECK_OP_CONVERT && tape->root_op != CHECK_OP_CAST) ||
+        (tape->root_op == CHECK_OP_CONVERT && flags != 0)) return false;
+    const NodeWindowNativeCall* call = tape->rows[0];
