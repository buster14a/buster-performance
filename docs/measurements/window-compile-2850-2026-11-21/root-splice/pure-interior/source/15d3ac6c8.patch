+// A closed literal tree starts with a literal followed by another literal, a sign or a group.
+// Screen 16 parser actions together and only visit uninterrupted arithmetic runs that contain such a pair.
+static uint32_t check_input_interior_ranges(const uint32_t* classes, uint32_t acting, CheckInteriorRange* ranges)
+{
+    uint16_t literals[BUSTER_CHECK_EXPRESSION_CHUNK/16 + 1], continuation[BUSTER_CHECK_EXPRESSION_CHUNK/16+1];
+    uint16_t kept[BUSTER_CHECK_EXPRESSION_CHUNK/16 + 1], ranks[BUSTER_CHECK_EXPRESSION_CHUNK/16+1];
+    const uint32_t tiles = (acting + 15) / 16;
+    uint32_t literal = 0;
+    for (uint32_t t = 0; t < tiles; ++t)
+    {
+        const uint32_t first = 16*t;
+        const uint16_t valid = (uint16_t)_bzhi_u32(UINT32_MAX, acting-first < 16 ? acting-first : 16);
+        const __m512i ids = _mm512_and_si512(_mm512_maskz_loadu_epi32(valid, classes+first),_mm512_set1_epi32(BUSTER_CHECK_EXPRESSION_CODE_MASK));
+#define BUSTER_INTERIOR_MATCH(k) _mm512_mask_cmpeq_epi32_mask(valid, ids, _mm512_set1_epi32((k) << BUSTER_CHECK_EXPRESSION_CODE_SHIFT))
+        literals[t] = BUSTER_INTERIOR_MATCH(CHECK_INPUT_CODE_LITERAL);
+        continuation[t] = literals[t] | BUSTER_INTERIOR_MATCH(CHECK_INPUT_CODE_PREFIX) | BUSTER_INTERIOR_MATCH(CHECK_INPUT_CODE_GROUP);
+        kept[t] = continuation[t] | BUSTER_INTERIOR_MATCH(CHECK_INPUT_CODE_BINARY);
+#undef BUSTER_INTERIOR_MATCH
+        ranks[t] = (uint16_t)literal;
+        literal += (uint32_t)__builtin_popcount(literals[t]);
+    }
+    continuation[tiles] = 0;
+    uint32_t count = 0, after = 0;
+    for (uint32_t t = 0; t < tiles; ++t)
+    {
+        const uint32_t following = continuation[t] | ((uint32_t)continuation[t+1] << 16);
+        uint32_t seeds = literals[t] & (following>>1);
+        while (seeds)
+        {
+            const uint32_t bit = (uint32_t)__builtin_ctz(seeds);
+            const uint32_t begin = 16*t + bit;
+            if (begin >= after)
+            {
+                uint32_t group = t;
+                uint32_t outside = (uint16_t)(~kept[group] & (UINT32_MAX << bit));
+                while (outside == 0 && ++group < tiles) outside = (uint16_t)~kept[group];
+                after = outside != 0 ? 16*group + (uint32_t)__builtin_ctz(outside) : acting;
+                ranges[count++] = (CheckInteriorRange){ (uint16_t)begin,(uint16_t)after,
+                    (uint16_t)(ranks[t] + (uint32_t)__builtin_popcount(literals[t] & ((1u << bit) - 1))) };
+            }
+            if (after >= 16*t+16) break;
+            seeds &= UINT32_MAX << (after - 16*t);
+        }
+    }
+    return count;
+}
