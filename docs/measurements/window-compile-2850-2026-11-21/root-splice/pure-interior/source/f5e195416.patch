+// Reuse the ordinary numeric decoder beyond its existing chunk table of plain decimals. A
+// bounded source spelling is enough for an int and cannot request a wide integer allocation.
+static uint32_t check_input_interior_integer(CheckInputReader* reader, uint32_t token)
+{
+    const uint32_t source = reader->parser->tokens.sources[token];
+    const PPTokens* pp = &reader->pp->output;
+    uint32_t result = BUSTER_CHECK_NONE;
+    if (reader->parser->tokens.names[token] == 0 && pp->kinds[source] == C_TOKEN_NUMERIC_CONSTANT &&
+        pp->values[source] - pp->locations[source] <= 16)
+    {
+        uint8_t buffer[17];
+        const uint8_t* bytes = NULL;
+        const uint32_t length = pp_spelling(reader->pp,pp->kinds[source],pp->values[source],pp->locations[source],buffer,&bytes);
+        CheckLiteral literal = {0};
+        if (length <= 16 && bytes != NULL) check_literal_integer(bytes, length, &literal);
+        if (literal.valid && literal.type == BUSTER_TYPE_INT && !literal.real && !literal.imaginary && !literal.bit_width)
+            result = (uint32_t)literal.integer;
+    }
+    return result;
+}
