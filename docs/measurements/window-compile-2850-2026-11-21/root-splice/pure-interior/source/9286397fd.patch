+// These parents inspect their children's written operator (and, for a signed shift,
+// its literal beneath unary minus) when they report boolean, shift and division diagnostics.
+static bool check_input_interior_observed(const Parser* parser, uint32_t token, CheckOp op)
+{
+    if (op == CHECK_OP_SHIFT_LEFT) return true;
+    uint32_t parent = parser->tree.parents[token];
+    while (parent < parser->tokens.count && parser->tree.roles[parent] == PARSE_ROLE_CLOSE_GROUP)
+    {
+        parent = parser->tree.parents[parent];
+    }
+    if (parent >= parser->tokens.count) return false;
+    const uint32_t role = parser->tree.roles[parent];
+    return role == PARSE_ROLE_SHIFT || role == PARSE_ROLE_MULTIPLICATIVE || role == PARSE_ROLE_OPEN_TERNARY || role == PARSE_ROLE_CLOSE_TERNARY;
+}
