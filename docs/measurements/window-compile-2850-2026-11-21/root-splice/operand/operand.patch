+static bool node_source_compact_shape(const NodeWindowNativeTape* tape)
+{
+    const bool weight = tape->count > 0 && tape->count <= 32 && tape->calls == 0;
+    const bool stored = weight && tape->root_op == CHECK_OP_CAST && tape->count == 3 && tape->entries[2].kind == BUSTER_TYPED_DISCARD &&
+                        (tape->entries[1].kind == BUSTER_TYPED_STORE_LOCAL || tape->entries[1].kind == BUSTER_TYPED_STORE_GLOBAL);
+    if (!weight || (!stored && tape->root_op != CHECK_OP_CONVERT)) return false;
+    for (uint32_t i = 0; i < tape->count; ++i)
+    {
+        const NodeWindowNativeEntry* row = tape->entries + i;
+        const uint8_t kind = row->kind;
+        const bool simple = (kind >= BUSTER_TYPED_CONST && kind <= BUSTER_TYPED_GLOBAL_ADDRESS) || kind == BUSTER_TYPED_NEG || kind == BUSTER_TYPED_NOT ||
+                            (kind >= BUSTER_TYPED_ADD && kind <= BUSTER_TYPED_SHR) || (kind >= BUSTER_TYPED_EQ && kind <= BUSTER_TYPED_GE);
+        if ((!simple && !(stored && i != 0)) || row->class == BUSTER_TYPED_CLASS_VOID || row->class > BUSTER_TYPED_CLASS_U64) return false;
+    }
+    return true;
+}
