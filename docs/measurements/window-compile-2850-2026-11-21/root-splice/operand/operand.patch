+        const uint32_t top = root - front->window_left[root];
+        const uint32_t size = front->sizes[top];
+        if (size < 2 || size > top + 1 || top + 1 - size < front->made) continue;
+        const uint32_t first = top + 1 - size, token = front->tokens[top];
+        const uint32_t last = reader->postorder_positions[token], length = reader->subtree_sizes[last];
+        if (length == 0 || length > last + 1 || last + 1 - length < chunk_first) continue;
+        CheckValue value;
+        NodeWindowNativeTape* tape = node_window_compact_candidate(front, root, top, &value);
+        if (tape == NULL) continue;
+
+        const uint32_t start = last + 1 - length;
+        uint32_t begin = pos;
+        while (begin < acting && reader->postorder_positions[tokens[begin]] < start) ++begin;
+        uint32_t end = begin, expected = first, ids = 0, nums = 0;
+        for (; end < acting && reader->postorder_positions[tokens[end]] <= last; ++end)
+        {
+            const uint32_t code = check_input_window_code(classes, end);
+            if (code == CHECK_INPUT_CODE_GROUP || code == CHECK_INPUT_CODE_LIST || code == CHECK_INPUT_CODE_SEPARATOR) continue;
+            if (expected > top || tokens[end] != front->tokens[expected] ||
+                (code != CHECK_INPUT_CODE_IDENTIFIER && code != CHECK_INPUT_CODE_LITERAL && code != CHECK_INPUT_CODE_PREFIX &&
+                 code != CHECK_INPUT_CODE_BINARY && code != CHECK_INPUT_CODE_CAST)) break;
+            ++expected;
+            ids += code == CHECK_INPUT_CODE_IDENTIFIER;
+            nums += code == CHECK_INPUT_CODE_LITERAL;
+        }
+        if (end == begin || expected != top + 1 || tokens[end - 1] != token ||
+            (end < acting && reader->postorder_positions[tokens[end]] <= last)) continue;
+        while (pos < begin && !reader->output->resource)
+        {
+            check_input_expression_coded(reader, batch, tokens[pos], (uint8_t)classes[pos], true, identifiers, &identifier, literals, &literal, visited);
