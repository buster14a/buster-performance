+// An independently typed operand occupies a closed parser subtree. Its graph-making actions must agree one
+// by one with the front, including the earliest record. Keep the wrapper action and the surrounding source
+// walk. In particular a root spanning chunks, or a subtree with any unmodeled reader action, stays ordinary.
+static uint32_t check_source_compact_actions(CheckInputReader* reader, CheckInputBatch* batch, NodeFront* front,
+                                            const uint32_t* tokens, const uint32_t* classes, uint32_t acting,
+                                            const CheckInputIdentifiers* identifiers, const CheckInputLiterals* literals,
+                                            uint64_t* visited, uint32_t chunk_first)
+{
+    uint32_t pos = 0, literal = 0, identifier = 0;
