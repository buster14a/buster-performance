+// Only complete parser subtrees ending in a conversion or discarded expression can be published. Gather
+// those with integer-source actions, preserving token order and each identifier/literal's ordinary decoded
+// input. The same source type, warning, native-row and physical ownership checks still decide admission.
+static void check_source_front_chunk(NodeFront* front, CheckInputReader* reader, const uint32_t* tokens, const uint32_t* classes,
+                                     uint32_t acting, const CheckInputIdentifiers* identifiers, const CheckInputLiterals* literals)
+{
+    uint8_t chosen[BUSTER_CHECK_EXPRESSION_CHUNK] = {0};
+    uint32_t kept_tokens[BUSTER_CHECK_EXPRESSION_CHUNK], kept_classes[BUSTER_CHECK_EXPRESSION_CHUNK];
+    CheckInputIdentifiers kept_identifiers;
+    CheckInputLiterals kept_literals;
+    uint32_t through = 0;
+    for (uint32_t end = 0; end < acting; ++end)
+    {
+        const uint32_t code = (classes[end] & BUSTER_CHECK_EXPRESSION_CODE_MASK) >> BUSTER_CHECK_EXPRESSION_CODE_SHIFT;
+        if (code != CHECK_INPUT_CODE_RETURN && code != CHECK_INPUT_CODE_TERMINATOR) continue;
+        const uint32_t token = tokens[end];
+        const uint32_t last = reader->postorder_positions[token];
+        const uint32_t size = reader->subtree_sizes[last];
+        if (size < 2 || size > last + 1) continue;
+        const uint32_t first = last + 1 - size;
+        if (first < reader->postorder_positions[tokens[0]] || (through && first <= reader->postorder_positions[tokens[through - 1]])) continue;
+        uint32_t start = end;
+        bool leaves = false, assignment = false;
+        while (start != through && reader->postorder_positions[tokens[start - 1]] >= first)
+        {
+            const uint32_t at = start - 1;
+            const uint32_t action = (classes[at] & BUSTER_CHECK_EXPRESSION_CODE_MASK) >> BUSTER_CHECK_EXPRESSION_CODE_SHIFT;
+            if (action == CHECK_INPUT_CODE_IDENTIFIER || action == CHECK_INPUT_CODE_LITERAL) leaves = true;
+            else if (action == CHECK_INPUT_CODE_BINARY)
+            {
+                const CheckOp op = check_input_binary(reader->parser->tokens.kinds[tokens[at]]);
+                assignment |= op == CHECK_OP_ASSIGN;
+                if (op != CHECK_OP_ASSIGN && op != CHECK_OP_ADD && op != CHECK_OP_SUBTRACT && op != CHECK_OP_MULTIPLY &&
+                    op != CHECK_OP_BIT_AND && op != CHECK_OP_BIT_OR && op != CHECK_OP_BIT_XOR) break;
+            }
+            else if (action != CHECK_INPUT_CODE_PREFIX && action != CHECK_INPUT_CODE_GROUP &&
+                     action != CHECK_INPUT_CODE_SEPARATOR && action != CHECK_INPUT_CODE_LIST) break;
+            start = at;
+        }
+        if (leaves && (code == CHECK_INPUT_CODE_RETURN || assignment) &&
+            (start == 0 || reader->postorder_positions[tokens[start - 1]] < first))
+        {
+            memset(chosen + start, 1, end + 1 - start);
+            through = end + 1;
+        }
+    }
+    uint32_t kept = 0, id = 0, lit = 0, kid = 0, klit = 0;
+    for (uint32_t i = 0; i < through; ++i)
+    {
+        const uint32_t code = (classes[i] & BUSTER_CHECK_EXPRESSION_CODE_MASK) >> BUSTER_CHECK_EXPRESSION_CODE_SHIFT;
+        if (chosen[i])
+        {
+            kept_tokens[kept] = tokens[i];
+            kept_classes[kept++] = classes[i];
+            if (code == CHECK_INPUT_CODE_IDENTIFIER)
+            {
+                kept_identifiers.types[kid] = identifiers->types[id];
+                kept_identifiers.flags[kid] = identifiers->flags[id];
+                kept_identifiers.objects[kid] = identifiers->objects[id];
+                kept_identifiers.declarations[kid] = identifiers->declarations[id];
+                kept_identifiers.status[kid++] = identifiers->status[id];
+            }
+            else if (code == CHECK_INPUT_CODE_LITERAL) kept_literals.values[klit++] = literals->values[lit];
+        }
+        id += code == CHECK_INPUT_CODE_IDENTIFIER;
+        lit += code == CHECK_INPUT_CODE_LITERAL;
+    }
+    front->stack_count = 0;
+    front->group_count = 0;
+    front->full = false;
+    front->count = 0;
+    front->made = 0;
+    front->pending = 0;
+    if (kept != 0)
+    {
+        node_front_chunk_windowed(front, reader, kept_tokens, kept_classes, kept, &kept_identifiers, &kept_literals);
+        node_window_probe(front);
+    }
+}
