-static __attribute__((unused)) const NodeWindowNativeTape* check_source_window_required(const CheckInput* input, uint32_t node)
+static __attribute__((noinline,unused)) const NodeWindowNativeTape* check_source_window_physical(const CheckInput* input, uint32_t node)
+{
+    const CheckGraph* graph = &input->graph;
+    const CheckOp op = graph->ops[node];
+    if (op != CHECK_OP_VALUE && op != CHECK_OP_CONVERT && op != CHECK_OP_CAST) return NULL;
+    const uint32_t leaf = op == CHECK_OP_VALUE ? node : graph->operand0[node];
+    if (leaf >= graph->count || graph->ops[leaf] != CHECK_OP_VALUE) return NULL;
+    const uint32_t index = graph->members[leaf];
+    if (index == 0 || index > input->source_compacted) return NULL;
+    const NodeWindowNativeTape* tape = input->source_physical[index - 1];
+    return tape->compact_node == leaf + 1 && tape->root_token == graph->tokens[node] &&
+           (tape->compact_whole ? node == leaf : op == tape->root_op) ? tape : NULL;
+}
