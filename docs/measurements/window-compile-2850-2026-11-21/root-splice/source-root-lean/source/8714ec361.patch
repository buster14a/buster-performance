+// A bit in source-token space cheaply rules out ordinary nodes. Only a committed row can reach the
+// reciprocal graph/leaf check, which distinguishes multiple records owned by the same parser token.
+static inline __attribute__((always_inline,unused)) const NodeWindowNativeTape* check_source_window_required(const CheckInput* input, uint32_t node)
+{
+    if (input->source_root_bits != NULL && node < input->graph.count)
+    {
+        const uint32_t token = input->graph.tokens[node];
+        if (token < input->token_count && ((input->source_root_bits[token >> 6] >> (token & 63)) & 1u) != 0)
+            return check_source_window_physical(input, node);
+        return NULL;
+    }
+    return input->source_native != NULL && node < input->graph.count ? check_source_window_legacy(input, node) : NULL;
+}
