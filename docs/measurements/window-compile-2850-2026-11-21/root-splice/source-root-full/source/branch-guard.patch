+++ b/src/buster/compiler/c_check_node_census.c
@@ -5771,6 +5771,72 @@ static void node_shadow_tested(NodeShadow* shadow, const NodeCensusScratch* s, c
 // automatic object's analysis. Binding uses still come from the original resolved tokens. The retained
 // root supplies the return conversion or the discard; assignments must store directly in a file-scope
 // scalar. The complete source warning and C proof must already have admitted the interval.
+// Structural control experiment. A source decimal, alone or on the decisive side of a logical
+// operator, proves a branch cannot run without evaluating its other operand or consulting the graph.
+static uint32_t node_source_decimal_truth(const CheckInputReader* reader, uint32_t first, uint32_t end)
+{
+    const Parser* parser = reader->parser;
+    const uint32_t root = check_input_fallthrough_ungroup(parser, &first, &end);
+    uint32_t range = BUSTER_PP_NONE;
+    const uint32_t literal = first + 1 == end && root == first && parser->tokens.kinds[first] == PARSE_KIND_NUMBER ?
+                             check_input_literal_plain(reader, first, &range) : BUSTER_CHECK_NONE;
+    return literal == BUSTER_CHECK_NONE ? 2 : literal != 0;
+}
+
+static uint32_t node_source_guard_truth(const CheckInputReader* reader, uint32_t first, uint32_t end)
+{
+    const Parser* parser = reader->parser;
+    uint32_t root = check_input_fallthrough_ungroup(parser, &first, &end);
+    uint32_t truth = node_source_decimal_truth(reader, first, end);
+    // A chain of && or of || is decided by any zero or any nonzero respectively.
+    const uint8_t outer = root < parser->tokens.count ? parser->tree.roles[root] : PARSE_ROLE_NONE;
+    const bool logical = outer == PARSE_ROLE_LOGICAL_AND || outer == PARSE_ROLE_LOGICAL_OR;
+    const uint32_t deciding = outer == PARSE_ROLE_LOGICAL_OR;
+    bool all_known = true;
+    while (truth == 2 && logical && first < root && root < end && parser->tree.roles[root] == outer)
+    {
+        const uint32_t right = node_source_decimal_truth(reader, root + 1, end);
+        end = root;
+        root = check_input_fallthrough_ungroup(parser, &first, &end);
+        const uint32_t left = node_source_decimal_truth(reader, first, end);
+        all_known &= right != 2;
+        truth = right == deciding || left == deciding ? deciding : (all_known && left != 2) ? 1 - deciding : 2;
+    }
+    return truth;
+}
+
+static bool node_source_guard_permits(const CheckInputReader* reader, uint32_t close, uint32_t child)
+{
+    const Parser* parser = reader->parser;
+    const uint32_t open = check_common_opener(parser, close);
+    uint32_t first = open + 1;
+    uint32_t end = close;
+    bool bounded = open != BUSTER_CHECK_NONE && open != 0 && child > close;
+    const bool switch_guard = bounded && parser->tokens.kinds[open - 1] == PARSE_KIND_SWITCH;
+    if (bounded && parser->tree.roles[close] == PARSE_ROLE_CLOSE_FOR)
+    {
+        uint32_t semis[2] = { BUSTER_CHECK_NONE, BUSTER_CHECK_NONE };
+        uint32_t found = 0;
+        for (uint32_t at = first; at < end && found < 2; at += 1)
+        {
+            if (parser->tree.parents[at] == close && parser->tokens.kinds[at] == PARSE_KIND_SEMI) { semis[found++] = at; }
+        }
+        bounded = found == 2;
+        first = semis[0] + 1;
+        end = semis[1];
+    }
+    bool ok = true;
+    if (bounded && first < end)
+    {
+        const uint32_t truth = node_source_guard_truth(reader, first, end);
+        const bool otherwise = parser->tree.roles[child] == PARSE_ROLE_ELSE;
+        // A known switch selector still needs case labels and fallthrough. Leave the whole switch
+        // ordinary; a dynamic selector allows its cases' retained tapes to be consumed normally.
+        ok = truth == 2 || (!switch_guard && truth != (uint32_t)otherwise);
+    }
+    return ok;
+}
+
 static bool node_probe_compact_warning_ok(const NodeFront* front, uint32_t root, bool locals)
 {
     const struct NodeFactsReader* state = front->typer->facts;
@@ -5846,6 +5912,52 @@ static bool node_probe_compact_warning_ok(const NodeFront* front, uint32_t root,
             ok = arithmetic || store;
         }
     }
+    // A guarded statement need not receive a native expression request. Preserve its complete
+    // graph until the reader has a source reachability certificate for every enclosing control.
+    const bool pruned = locals && getenv("NODE_SOURCE_PRUNED_GUARDS") != NULL;
+    const bool straight = locals && getenv("NODE_SOURCE_STRAIGHT_GUARDS") != NULL;
+    const bool external = locals && getenv("NODE_SOURCE_EXTERNAL_BODY") != NULL;
+    if (ok && (pruned || straight || external))
+    {
+        const Parser* parser = reader->parser;
+        const uint32_t tokens = parser->tokens.count;
+        uint32_t open_body = BUSTER_CHECK_NONE;
+        uint32_t child = front->tokens[root];
+        for (uint32_t at = child, steps = 0; ok && at < tokens && steps < tokens; steps += 1)
+        {
+            const uint8_t role = parser->tree.roles[at];
+            const uint32_t parent = parser->tree.parents[at];
+            if (role == PARSE_ROLE_CLOSE_BODY)
+            {
+                if (external)
+                {
+                    for (uint32_t open = child; open != 0 && open_body == BUSTER_CHECK_NONE; )
+                    {
+                        open -= 1;
+                        if (parser->tree.parents[open] == at && parser->tree.roles[open] == PARSE_ROLE_OPEN_BODY) { open_body = open; }
+                    }
+                }
+                break;
+            }
+            if (role == PARSE_ROLE_OPEN_BODY || parent == at) { open_body = at; break; }
+            if ((pruned || straight) && (role == PARSE_ROLE_CLOSE_CONDITION || role == PARSE_ROLE_CLOSE_FOR))
+            {
+                ok = pruned && node_source_guard_permits(reader, at, child);
+            }
+            else if (straight)
+            {
+                ok = role != PARSE_ROLE_ELSE && role != PARSE_ROLE_DO && role != PARSE_ROLE_LABEL && role != PARSE_ROLE_CLOSE_CASE;
+            }
+            child = at;
+            at = parent;
+        }
+        if (ok && external)
+        {
+            const uint32_t definition = open_body < tokens ? check_common_sparse_get(input->body_declarations, open_body) : BUSTER_CHECK_NONE;
+            ok = definition < tokens && check_input_linkage(input->declaration_bits, definition) == 2 &&
+                 (input->function_flags == NULL || (input->function_flags[definition] & CHECK_INPUT_FUNCTION_INLINE) == 0);
+        }
+    }
     return ok;
 }
 
