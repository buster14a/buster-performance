+// Single-byte identifiers in the ASCII range 64..127 have distinct low six bits. Only names
+// already installed in the ordinary interner are eligible. A file follows new canonical names
+// as its blocks progress, retaining normal first-insertion order and IDs.
+typedef struct RefineLetters RefineLetters;
+struct RefineLetters
+{
+    uint32_t known;
+    uint32_t ids[64];
+};
+
+static void refine_update_letters(RefineLetters* letters, const InternTable* table)
+{
+    for (uint32_t i = letters->known != 0 ? letters->known : 1; i < table->count; i += 1)
+    {
+        const InternSpan span = table->spans[i];
+        if (span.length == 1)
+        {
+            const uint32_t byte = table->records[span.offset];
+            if (byte >= 64 && byte < 128)
+            {
+                letters->ids[byte - 64] = i;
+            }
+        }
+    }
+    letters->known = table->count;
+}
