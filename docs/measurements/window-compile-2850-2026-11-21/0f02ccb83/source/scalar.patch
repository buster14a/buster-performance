+// Starting after a false directive's physical line, find the branch its real evaluator wants next.
+// The source cursor emits no token rows and interns no identifiers. Unusual directive spellings,
+// diagnostics in nested conditions, and raw strings use the normal lexer and directive handler.
+static bool pp_scan_false_branch(const Preprocessor* pp, const PPFileData* data, uint32_t begin, uint32_t* sibling)
+{
+    const ScalarLexer lexer = { .source = data->bytes, .length = data->length, .trigraphs = (pp->refine_flags & C_TOKENIZER_TRIGRAPHS) != 0 };
+    uint64_t p = begin;
+    bool sol = true;
+    uint32_t depth = 0;
+    uint64_t seen_else = 0;
+    int32_t quote = 0;
+    int32_t previous = 0;
+    enum { NORMAL, COMMENT, LINE } mode = NORMAL;
+    while (p < data->length)
+    {
+        uint64_t size, at;
+        const int32_t c = get_char(&lexer, p, &size, &at);
+        p += size;
+        if (c == BUSTER_LEX_END_OF_FILE)
+        {
+            break;
+        }
+        if (mode == COMMENT)
+        {
+            if (c == '*' && peek_char(&lexer, p, &size) == '/')
+            {
+                p += size;
+                mode = NORMAL;
+            }
+        }
+        else if (c == '\n' || c == '\r')
+        {
+            if (quote != 0)
+            {
+                return false;
+            }
+            mode = NORMAL;
+            sol = true;
+        }
+        else if (mode == LINE)
+        {
+            continue;
+        }
+        else if (quote != 0)
+        {
+            if (c == '\\')
+            {
+                peek_char(&lexer, p, &size);
+                p += size;
+            }
+            else if (c == quote)
+            {
+                quote = 0;
+            }
+        }
+        else if (c == '/' && peek_char(&lexer, p, &size) == '*')
+        {
+            p += size;
+            mode = COMMENT;
+        }
+        else if (c == '/' && peek_char(&lexer, p, &size) == '/')
+        {
+            p += size;
+            mode = LINE;
+        }
+        else if (c == '"' || c == '\'')
+        {
+            if ((c == '"' && previous == 'R') || (c == '\'' && ((previous >= '0' && previous <= '9') || previous == '.')))
+            {
+                return false;
+            }
+            sol = false;
+            quote = c;
+        }
+        else if (sol && c == '#')
+        {
+            const uint32_t hash = (uint32_t)at;
+            const uint8_t* bytes = data->bytes;
+            while (p < data->length && (bytes[p] == ' ' || bytes[p] == '\t')) { p += 1; }
+            const uint64_t word = p;
+            while (p < data->length && ((bytes[p] >= 'a' && bytes[p] <= 'z') || (bytes[p] >= 'A' && bytes[p] <= 'Z') ||
+                                        (bytes[p] >= '0' && bytes[p] <= '9') || bytes[p] == '_')) { p += 1; }
+            const uint32_t length = (uint32_t)(p - word);
+            if (p < data->length && (bytes[p] == '\\' || bytes[p] == '?' || bytes[p] >= 128 || bytes[p] == '$' ||
+                                     (length == 0 && (bytes[p] == '/' || bytes[p] == '\v' || bytes[p] == '\f'))))
+            {
+                return false;
+            }
+            const uint8_t* name = bytes + word;
+            const bool open = (length == 2 && memcmp(name, "if", 2) == 0) || (length == 5 && memcmp(name, "ifdef", 5) == 0) ||
+                              (length == 6 && memcmp(name, "ifndef", 6) == 0);
+            const bool close = length == 5 && memcmp(name, "endif", 5) == 0;
+            const bool otherwise = length == 4 && memcmp(name, "else", 4) == 0;
+            const bool modern = (length == 7 && memcmp(name, "elifdef", 7) == 0) || (length == 8 && memcmp(name, "elifndef", 8) == 0);
+            const bool branch = otherwise || modern || (length == 4 && memcmp(name, "elif", 4) == 0);
+            if (depth == 0 && (close || branch))
+            {
+                *sibling = hash;
+                return true;
+            }
+            if (open)
+            {
+                if (depth == 64) { return false; }
+                seen_else &= ~(UINT64_C(1) << depth);
+                depth += 1;
+            }
+            else if (close)
+            {
+                depth -= 1;
+            }
+            else if (branch)
+            {
+                const uint64_t bit = UINT64_C(1) << (depth - 1);
+                if ((seen_else & bit) || modern)
+                {
+                    return false;
+                }
+                if (otherwise) { seen_else |= bit; }
+            }
+            sol = false;
+        }
+        else if (sol && (c == '%' || c == 0 || c > 127))
+        {
+            return false;
+        }
+        else if (c != ' ' && c != '\t' && c != '\v' && c != '\f')
+        {
+            sol = false;
+        }
+        previous = c;
+    }
+    return false;
+}
