+static PPPrepareStatus pp_prepare_fragment(Preprocessor* pp, const PPFileData* original, PPFileData* result,
+                                          uint32_t from, bool terminal, uint64_t* ticks)
+{
+    const PPPrepare prepare = pp_prepare_config(pp);
+    const uint32_t length = original->length;
+    const uint8_t* bytes = original->bytes;
+    const uint32_t target = 64u << 10;
+    uint32_t end = terminal || length - from <= target ? length : pp_fragment_cut(bytes, length, from + target);
+    for (;;)
+    {
+        PPFileData part = { .bytes = bytes + from, .length = end - from, .device = original->device, .inode = original->inode,
+                            .modified = original->modified, .has_modified = original->has_modified, .record = original->record,
+                            .included = original->included, .once = original->once, .dependency = original->dependency };
+        const PPPrepareStatus status = pp_prepare_into(&prepare, pp->table, pp->columns, &pp->arena, &part, ticks);
+        if (status != PP_PREPARE_DONE)
+        {
+            return status;
+        }
+        if (end != length && (part.unterminated_comment != 0 || part.raw_error_count != 0))
+        {
+            // Retry this fragment without a cut in a token or malformed lexical construct.
+            end = length;
+            continue;
+        }
+        if (from != 0)
+        {
+            const __m512i offset = _mm512_set1_epi32((int32_t)from);
+            for (uint32_t i = 0; i < part.token_count; i += 16)
+            {
+                const __mmask16 valid = part.token_count - i >= 16 ? 0xffffu : (__mmask16)_bzhi_u32(0xffff, part.token_count - i);
+                const __m128i kinds = _mm_maskz_loadu_epi8(valid, part.kinds + i);
+                const __mmask16 positions = _mm_mask_cmpneq_epi8_mask(valid, _mm_and_si128(kinds, _mm_set1_epi8(127)), _mm_set1_epi8(C_TOKEN_RAW_IDENTIFIER));
+                const __m512i starts = _mm512_maskz_loadu_epi32(valid, part.starts + i);
+                const __m512i values = _mm512_maskz_loadu_epi32(positions, part.values + i);
+                _mm512_mask_storeu_epi32(part.starts + i, valid, _mm512_add_epi32(starts, offset));
+                _mm512_mask_storeu_epi32(part.values + i, positions, _mm512_add_epi32(values, offset));
+            }
+            for (uint32_t i = 0; i < part.raw_error_count; i += 1)
+            {
+                part.raw_errors[i].offset += from;
+            }
+            if (part.unterminated_comment != 0)
+            {
+                part.unterminated_comment += from;
+            }
+        }
+        part.bytes = bytes;
+        part.length = length;
+        part.line_pages = NULL;
+        part.stream_end = end != length ? end : 0;
+        if (end != length || from != 0)
+        {
+            part.guard = 0;
+            part.guard_opener = BUSTER_PP_NONE;
+        }
+        *result = part;
+        return PP_PREPARE_DONE;
+    }
+}
