+// Switch a live file context while existing macro bodies keep their immutable raw columns and source offsets.
+static bool pp_enter_fragment(Preprocessor* pp, PPContext* context, uint32_t from, bool terminal)
+{
+    const uint32_t index = pp->data_count;
+    if (index >= (BUSTER_PP_MAX_FILES >> pp->capacity_shift) ||
+        pp_prepare_fragment(pp, &pp->datas[context->data], &pp->datas[index], from, terminal, 0, pp->options.timing ? pp->ticks : NULL) != PP_PREPARE_DONE)
+    {
+        pp_diagnose(pp, PP_SEVERITY_FATAL, 0, "out of memory preparing the next source fragment");
+        return false;
+    }
+    pp->data_count += 1;
+    const PPFileData* next = &pp->datas[index];
+    pp->input_tokens += next->token_count;
+    context->data = index;
+    context->position = 0;
+    context->next_directive = 0;
+    context->end = next->token_count;
+    context->comment_read = false;
+    context->hidden_directives = false;
+    return true;
+}
