+// Starting after a false directive's physical line, find the branch its real evaluator wants next.
+// The source cursor emits no token rows and interns no identifiers. Unusual directive spellings,
+// diagnostics in nested conditions, and raw strings use the normal lexer and directive handler.
+static bool pp_scan_false_branch(const Preprocessor* pp, const PPFileData* data, uint32_t begin, uint32_t depth, uint64_t seen_else, uint32_t* sibling)
+{
