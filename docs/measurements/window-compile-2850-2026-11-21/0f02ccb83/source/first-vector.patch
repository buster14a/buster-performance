+                            .modified = original->modified, .has_modified = original->has_modified, .record = original->record,
+                            .included = original->included, .once = original->once, .dependency = original->dependency };
+        const PPPrepareStatus status = pp_prepare_into(&prepare, pp->table, pp->columns, &pp->arena, &part, ticks);
+        if (status != PP_PREPARE_DONE)
+        {
+            return status;
+        }
+        if (end != length && (part.unterminated_comment != 0 || part.raw_error_count != 0))
