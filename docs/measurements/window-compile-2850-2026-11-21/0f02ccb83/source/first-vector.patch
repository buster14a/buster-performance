+                events |= _mm512_cmpeq_epi8_mask(bytes, _mm512_set1_epi8('?'));
+            }
+            if (mode == COMMENT)
+            {
+                events |= _mm512_cmpeq_epi8_mask(bytes, _mm512_set1_epi8('*'));
+            }
+            else
+            {
+                events |= _mm512_cmpeq_epi8_mask(bytes, _mm512_set1_epi8('\n')) | _mm512_cmpeq_epi8_mask(bytes, _mm512_set1_epi8('\r'));
+                if (quote != 0)
+                {
+                    events |= _mm512_cmpeq_epi8_mask(bytes, _mm512_set1_epi8((char)quote));
+                }
+                else if (mode == NORMAL)
+                {
+                    events |= _mm512_cmpeq_epi8_mask(bytes, _mm512_set1_epi8('/')) | _mm512_cmpeq_epi8_mask(bytes, _mm512_set1_epi8('"')) |
