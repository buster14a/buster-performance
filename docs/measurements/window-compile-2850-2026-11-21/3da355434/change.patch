diff --git a/src/buster/compiler/c_check_body_static_data.c b/src/buster/compiler/c_check_body_static_data.c
new file mode 100644
index 000000000..6e86c675e
--- /dev/null
+++ b/src/buster/compiler/c_check_body_static_data.c
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+
+static void check_body_data_hex(FILE* file, const uint8_t* data, uint64_t count)
+{
+    const char digits[] = "0123456789abcdef";
+    for (uint64_t i = 0; i < count; i += 1)
+    {
+        const uint8_t value = data == NULL ? 0 : data[i];
+        fputc(digits[value >> 4], file);
+        fputc(digits[value & 15], file);
+    }
+}
+
+static void check_body_data_name(const CheckInputReader* reader, uint32_t token)
+{
+    const uint32_t name = reader->parser->tokens.names[token];
+    if (name != 0)
+    {
+        fwrite(intern_bytes(reader->pp->table, name), 1, intern_length(reader->pp->table, name), stderr);
+    }
+}
+
+// Each independent array element owns its complete set of overlapping writes. Emit the final
+// bytes and unresolved source identities while the row's conversions and string literals are live.
+static bool check_body_static_data(CheckInputReader* reader, const CheckStream* stream, uint32_t row,
+                                   uint32_t last, uint32_t decl, Arena* output, Arena* scratch)
+{
+    const Parser* parser = reader->parser;
+    if (decl >= parser->tokens.count) return false;
+    CheckInput* input = reader->output;
+    const TypeId array = type_strip_aligned(reader->types, reader->declared_types[decl]);
+    if (type_kind(reader->types, array) != BUSTER_TYPE_KIND_ARRAY) return false;
+    const TypeId element = type_element(reader->types, array);
+    // The ordinary front end can already have materialized a literal table before graph construction.
+    // Those rows carry no graph node. Keep their provenance separate from a window that plans its live expressions.
+    for (const CheckInputLiteralTable* table = input->literal_tables; table != NULL; table = table->next)
+    {
+        if (table->declaration > decl) break;
+        if (table->declaration == decl)
+        {
+            fprintf(stderr, "static-preplanned\t");
+            check_body_data_name(reader, decl);
+            fprintf(stderr, "\t%u\t%u\n", row, last);
+            return true;
+        }
+    }
+    while (row < last)
+    {
+        const uint32_t close = parser->tree.parents[row];
+        if (close > last || close <= row) return false;
+        const uint64_t output_start = output->length;
+        const uint64_t scratch_start = scratch->length;
+        CheckInitializer init;
+        if (!check_initializer_plan_warnings(reader->types, parser, input->token_nodes, stream, input->strings,
+                input->string_count, input->string_ids, element, row, close + 1, true, false, true,
+                output, scratch, &init, &input->graph, NULL, NULL, NULL, NULL))
+        {
+            fprintf(stderr, "static-init-failed\t%u\t%u\t%u\t%u\n", decl, row, init.status, init.failed_token);
+            return false;
+        }
+        const CheckDataObject object = { .object = reader->objects[decl], .type = element, .initializer_plan = &init,
+                                         .initializer = BUSTER_CHECK_NONE, .token = decl };
+        CheckDataPlan data = { 0 };
+        const CheckDataStatus status = check_data_plan_object(reader->types, stream, &object, NULL, parser->tokens.count + 1,
+                                                              NULL, output, scratch, NULL, &data);
+        if (status != CHECK_DATA_OK || data.size != type_size(reader->types, element))
+        {
+            fprintf(stderr, "static-data-failed\t%u\t%u\t%u\n", decl, row, status);
+            return false;
+        }
+        fprintf(stderr, "static-data-row\t");
+        check_body_data_name(reader, decl);
+        fprintf(stderr, "\t%u\t", row);
+        check_body_data_hex(stderr, data.bytes, data.size);
+        fputc('\n', stderr);
+        for (uint32_t i = 0; i < data.fixup_count; i += 1)
+        {
+            const CheckDataFixup* f = &data.fixups[i];
+            if (f->object == 0 || f->object > parser->tokens.count) return false;
+            const uint32_t token = f->object - 1;
+            const uint32_t id = check_sparse_present(input->string_ids) ? check_sparse_get(input->string_ids, token) : BUSTER_CHECK_NONE;
+            fprintf(stderr, "static-data-fixup\t%u\t%u\t%lld\t", row, f->offset, (long long)f->addend);
+            if (id < input->string_count && input->strings[id].object == f->object && !input->strings[id].predefined)
+            {
+                fprintf(stderr, "string\t");
+                check_body_data_hex(stderr, input->strings[id].bytes, input->strings[id].byte_count);
+            }
+            else
+            {
+                fprintf(stderr, "symbol\t");
+                check_body_data_name(reader, token);
+            }
+            fputc('\n', stderr);
+        }
+        arena_pop_to(scratch, scratch_start);
+        arena_pop_to(output, output_start);
+        if (close == last) break;
+        row = close + 2;
+    }
+    return true;
+}
