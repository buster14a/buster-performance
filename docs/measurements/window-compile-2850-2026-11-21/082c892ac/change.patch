+typedef struct CheckSourceBatch
+{
+    uint32_t first;
+    uint32_t end;
+    uint32_t extra;
+    bool active;
+} CheckSourceBatch;
+
+typedef struct CheckSourceBatches
+{
+    uint32_t roots;
+    uint32_t batches;
+    uint32_t checked;
+    uint32_t max_nodes;
+    uint32_t max_tokens;
+} CheckSourceBatches;
+
+static bool check_source_batch_flush(CheckInputReader* reader, CheckSourceBatch batch, bool discard,
+                                     Arena* graph, Arena* checked, Arena* scratch, CheckSourceBatches* totals)
+{
+    if (batch.first == batch.end) return true;
+    uint32_t made = 0;
+    if (batch.active)
+    {
+        const uint32_t close = reader->postorder[batch.end - 1];
+        if (!check_body_source_one(reader, batch.first, batch.end, close, batch.extra, discard, true, graph, checked, scratch, &made)) return false;
+    }
+    else if (!discard)
+    {
+        check_source_batch_receipts(reader, NULL, NULL, batch.first, batch.end);
+    }
+    totals->checked += made;
+    totals->batches += 1;
+    if (made > totals->max_nodes) totals->max_nodes = made;
+    const uint32_t tokens = batch.end - batch.first;
+    if (tokens > totals->max_tokens) totals->max_tokens = tokens;
+    arena_pop_to(graph, 0);
+    arena_pop_to(checked, 0);
+    arena_pop_to(scratch, 0);
+    return true;
+}
+
+static bool check_source_batch_forest(CheckInputReader* reader, uint32_t limit, bool discard,
+                                      Arena* graph, Arena* checked, Arena* scratch)
+{
+    const Parser* parser = reader->parser;
+    const uint32_t tokens = parser->tokens.count;
+    uint32_t root_first = 0, extra = 0;
+    bool active = false;
+    CheckSourceBatch batch = { 0 };
+    CheckSourceBatches result = { 0 };
+    const uint8_t drop = BUSTER_CHECK_EXPRESSION_ACTS | (CHECK_INPUT_CODE_DROP << BUSTER_CHECK_EXPRESSION_CODE_SHIFT);
+    for (uint32_t i = 0; i < tokens; i += 1)
+    {
+        const uint32_t t = reader->postorder[i];
+        const uint8_t visit = reader->visits[t];
+        active |= (visit & BUSTER_CHECK_EXPRESSION_ACTS) != 0 && visit != drop;
+        const uint8_t kind = parser->tokens.kinds[t];
+        extra += kind == PARSE_KIND_L_SQUARE ? 8 : kind == PARSE_KIND_SIZEOF ? 4 : 0;
+        if (parser->tree.parents[t] < tokens) continue;
+        const uint32_t end = i + 1;
+        if (batch.end > batch.first && end - batch.first > limit)
+        {
+            if (!check_source_batch_flush(reader, batch, discard, graph, checked, scratch, &result)) return false;
+            batch = (CheckSourceBatch){ .first = root_first, .end = root_first };
+        }
+        if (batch.extra > UINT32_MAX - extra) return false;
+        batch.extra += extra;
+        batch.active |= active;
+        batch.end = end;
+        result.roots += 1;
+        root_first = end;
+        extra = 0;
+        active = false;
+    }
+    const bool valid = root_first == tokens && check_source_batch_flush(reader, batch, discard, graph, checked, scratch, &result);
+    fprintf(stderr, "source-batch-summary\tlimit=%u\troots=%u\tbatches=%u\tnodes=%u\tlargest-nodes=%u\tlargest-tokens=%u\twhole-graph=%u\n",
+            limit, result.roots, result.batches, result.checked, result.max_nodes, result.max_tokens, reader->output->graph.count);
+    return valid;
+}
