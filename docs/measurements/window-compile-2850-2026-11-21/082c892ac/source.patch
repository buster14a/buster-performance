+static uint64_t check_body_warning_fingerprint(const TypeTable* types, const CheckWarningEvent* event, const CheckWarningNote* notes)
+{
+    uint64_t h = UINT64_C(14695981039346656037);
+#define BUSTER_BODY_WARN(field) h = (h ^ (uint64_t)(field)) * UINT64_C(1099511628211)
+    BUSTER_BODY_WARN(event->id); BUSTER_BODY_WARN(event->kind); BUSTER_BODY_WARN(event->token); BUSTER_BODY_WARN(event->source);
+    BUSTER_BODY_WARN(event->flags); BUSTER_BODY_WARN(event->completion_kind); BUSTER_BODY_WARN(event->completion);
+    BUSTER_BODY_WARN(event->detail); BUSTER_BODY_WARN(event->suborder); BUSTER_BODY_WARN(event->note_count);
+    for (uint32_t i = 0; i <= event->note_count; i += 1)
+    {
+        const CheckWarningPayload* payload = &event->payload;
+        if (i != 0)
+        {
+            const CheckWarningNote* note = notes + event->note_first + i - 1;
+            BUSTER_BODY_WARN(note->kind); BUSTER_BODY_WARN(note->token); BUSTER_BODY_WARN(note->source);
+            payload = &note->payload;
+        }
+        BUSTER_BODY_WARN(check_body_type_fingerprint(types,payload->first_type));
+        BUSTER_BODY_WARN(check_body_type_fingerprint(types,payload->second_type)); BUSTER_BODY_WARN(payload->name);
+        BUSTER_BODY_WARN(payload->token); BUSTER_BODY_WARN(payload->data);
+    }
+#undef BUSTER_BODY_WARN
+    return h;
+}
