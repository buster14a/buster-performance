+    const CheckInputTokenCounts counts = check_input_count_tokens(parser, names, groups, name_count, syntax, visits, resolved_visits);
     input->vla_capacity = counts.subscripts;
     input->asm_capacity = counts.asms;
     const uint32_t vector_members = counts.vector_members;
@@ -17202,6 +17236,7 @@ static bool check_input_run(CheckInput* input, const Parser* parser, Preprocesso
         .deferred = deferred,
