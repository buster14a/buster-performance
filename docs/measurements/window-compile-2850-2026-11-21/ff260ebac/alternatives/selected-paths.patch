+static inline __attribute__((always_inline)) void check_graph_nodes_range(TypeTable* types, const CheckGraph* graph, CheckStream* stream, const CheckOptions* options, CheckValue* arguments, Arena* scratch,
+                                    uint8_t* pure, uint32_t* levels, uint32_t* counts, uint32_t* order, uint32_t batch_size, uint32_t node, uint32_t end)
+{
+    const bool regions = options->regions || options->level_order;
+    while (node < end)
+    {
+        if ((!regions || pure[node] == 0) && check_graph_is_leaf(graph, node))
+        {
+            check_graph_leaf(types, graph, stream, node);
+            node += 1;
+        }
+        else if (!regions || pure[node] == 0)
+        {
+            check_graph_scalar_node(types, graph, stream, node, arguments, scratch);
+            node += 1;
+        }
+        else
+        {
+            const uint32_t begin = node;
+            node = check_graph_marked_end(pure, node, end);
+            if (options->level_order)
+            {
+                check_graph_region(types, graph, stream, pure, begin, node, batch_size, levels, counts, order);
+            }
+            else
+            {
+                check_graph_region_postorder(types, graph, stream, pure, begin, node, batch_size);
+            }
+        }
+    }
+}
+
+static __attribute__((noinline)) bool check_graph_nodes_with_decays(TypeTable* types, const CheckGraph* graph, CheckStream* stream, const CheckOptions* options, CheckValue* arguments, Arena* scratch,
+                                    uint8_t* pure, uint32_t* levels, uint32_t* counts, uint32_t* order, uint32_t batch_size, uint32_t count)
+{
+    uint32_t node = 0;
+    for (uint32_t i = 0; i < graph->function_decay_count; i += 1)
+    {
+        const CheckFunctionDecay decay = graph->function_decays[i];
+        check_graph_nodes_range(types, graph, stream, options, arguments, scratch, pure, levels, counts, order, batch_size, node, decay.node);
+        if (type_pointer(types, decay.function) == 0)
+        {
+            stream->status = CHECK_STATUS_RESOURCE;
+            stream->failed_node = decay.node;
+            return false;
+        }
+        node = decay.node;
+    }
+    check_graph_nodes_range(types, graph, stream, options, arguments, scratch, pure, levels, counts, order, batch_size, node, count);
+    return true;
+}
