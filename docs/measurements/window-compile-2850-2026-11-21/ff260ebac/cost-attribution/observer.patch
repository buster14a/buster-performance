+static __attribute__((noinline)) uint32_t check_input_window_actions_prior(CheckInputReader* reader, CheckInputBatch* batch, const uint32_t* tokens, const uint32_t* classes,
+                                                                     uint32_t acting, const CheckInputIdentifiers* identifiers, const CheckInputLiterals* literals,
+                                                                     uint64_t* visited)
+{
+    uint32_t ends[BUSTER_CHECK_EXPRESSION_CHUNK + 1];
+    const uint32_t candidates = reader->pp->options.node_window_assignments ? check_input_window_ends_prior(ends, classes, acting, true) :
+                                check_input_window_ends_prior(ends, classes, acting, false);
+    uint32_t identifier = 0;
+    uint32_t literal = 0;
+    uint32_t cursor = 0;
+    for (uint32_t k = 0; k <= candidates && !reader->output->resource; k += 1)
+    {
+        const uint32_t end = ends[k];
+        const uint32_t start = k != 0 ? ends[k - 1] + 1 : 0;
+        const uint32_t first = k < candidates ? check_input_window_first_prior(reader, tokens, classes, start, end) : end;
+        for (; cursor < first && !reader->output->resource; cursor += 1)
+        {
+            check_input_expression_coded(reader, batch, tokens[cursor], (uint8_t)classes[cursor], true, identifiers, &identifier, literals, &literal, visited);
+        }
+        if (!reader->output->resource && first < end)
+        {
