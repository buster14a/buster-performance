+// The compacted action retains this bit only on a complete candidate comparison. All ordinary
+// actions still use the original code bits, including when the checker refuses the candidate.
+#define BUSTER_CHECK_WINDOW_PREDICATE 0x80u
+
+static void check_input_window_mark_conditions(CheckInputReader* reader)
+{
+    const Parser* parser = reader->parser;
+    const uint32_t count = parser->tokens.count;
+    uint32_t controls = 0;
+    for (uint32_t i = 0; i < count; i += 64)
+    {
+        const __mmask64 lanes = (__mmask64)_bzhi_u64(UINT64_MAX, count - i < 64 ? count - i : 64);
+        const __m512i roles = _mm512_maskz_loadu_epi8(lanes, parser->tree.roles + i);
+        uint64_t bits = _mm512_mask_cmpeq_epi8_mask(lanes, roles, _mm512_set1_epi8(PARSE_ROLE_CLOSE_CONDITION));
+        for (; bits != 0; bits &= bits - 1)
+        {
+            const uint32_t close = i + (uint32_t)__builtin_ctzll(bits);
+            const uint32_t keyword = reader->first_child[close];
+            if (reader->visits[close] != (BUSTER_CHECK_EXPRESSION_ACTS | CHECK_INPUT_CODE_CONDITION << BUSTER_CHECK_EXPRESSION_CODE_SHIFT) ||
+                keyword >= count || (parser->tokens.kinds[keyword] != PARSE_KIND_IF && parser->tokens.kinds[keyword] != PARSE_KIND_WHILE))
+            {
+                continue;
+            }
+            controls += 1;
+            // The first two children are the keyword and opening parenthesis. The next child is the
+            // tested expression. A parenthesized expression's first child is its opening parenthesis.
+            const uint32_t open = reader->next_child[keyword];
+            uint32_t root = open < close ? reader->next_child[open] : count;
+            if (close <= keyword || close - keyword > 34)
+            {
+                continue;
+            }
+            while (root < close && parser->tree.roles[root] == PARSE_ROLE_CLOSE_GROUP)
+            {
+                const uint32_t group = reader->first_child[root];
+                const uint32_t value = group < root ? reader->next_child[group] : count;
+                if (value >= root)
+                {
+                    break;
+                }
+                root = value;
+            }
+            if (root < close && reader->visits[root] == (BUSTER_CHECK_EXPRESSION_ACTS | CHECK_INPUT_CODE_BINARY << BUSTER_CHECK_EXPRESSION_CODE_SHIFT) &&
+                check_input_window_predicate(reader, root))
+            {
+                reader->visits[root] |= BUSTER_CHECK_WINDOW_PREDICATE;
+            }
+        }
+    }
+    reader->output->window_condition_candidates += controls;
+}
