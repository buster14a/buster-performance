+// This more restrictive screen accepts only two unparenthesized leaf tokens. Their parser roles,
+// source braces and the ordinary comparison class are independent of any semantic or graph state.
+static void check_input_window_mark_plain_conditions(CheckInputReader* reader)
+{
+    const Parser* parser = reader->parser;
+    const uint32_t count = parser->tokens.count;
+    uint32_t controls = 0;
+    for (uint32_t i = 0; count > 1 && i < count - 1; i += 64)
+    {
+        const __mmask64 lanes = (__mmask64)_bzhi_u64(UINT64_MAX, count - 1 - i < 64 ? count - 1 - i : 64);
+        const __m512i kinds = _mm512_maskz_loadu_epi8(lanes, parser->tokens.kinds + i);
+        const __m512i opens = _mm512_maskz_loadu_epi8(lanes, parser->tree.roles + i + 1);
+        const uint64_t keywords = _mm512_cmpeq_epi8_mask(kinds, _mm512_set1_epi8(PARSE_KIND_IF)) |
+                                  _mm512_cmpeq_epi8_mask(kinds, _mm512_set1_epi8(PARSE_KIND_WHILE));
+        const uint64_t heads = _mm512_mask_cmpeq_epi8_mask(lanes & keywords, opens, _mm512_set1_epi8(PARSE_ROLE_OPEN_CONDITION));
+        controls += (uint32_t)__builtin_popcountll(heads);
+        if (heads == 0 || count - i < 6)
+        {
+            continue;
+        }
+        const uint32_t valid = count - i - 5;
+        const __mmask64 active = (__mmask64)(heads & _bzhi_u64(UINT64_MAX, valid < 64 ? valid : 64));
+        const __m512i closers = _mm512_maskz_loadu_epi8(active, parser->tree.roles + i + 5);
+        const __m512i closing_actions = _mm512_maskz_loadu_epi8(active, reader->visits + i + 5);
+        const uint64_t complete = _mm512_mask_cmpeq_epi8_mask(active, closers, _mm512_set1_epi8(PARSE_ROLE_CLOSE_CONDITION)) &
+                                  _mm512_cmpeq_epi8_mask(closing_actions, _mm512_set1_epi8(BUSTER_CHECK_EXPRESSION_ACTS | CHECK_INPUT_CODE_CONDITION << BUSTER_CHECK_EXPRESSION_CODE_SHIFT));
+        const __m512i operators = _mm512_maskz_loadu_epi8(complete, parser->tree.roles + i + 3);
+        const uint64_t comparisons = _mm512_mask_cmpeq_epi8_mask(complete, operators, _mm512_set1_epi8(PARSE_ROLE_RELATIONAL)) |
+                                     _mm512_mask_cmpeq_epi8_mask(complete, operators, _mm512_set1_epi8(PARSE_ROLE_EQUALITY));
+        const __m512i visits = _mm512_maskz_loadu_epi8(comparisons, reader->visits + i + 3);
+        const uint64_t marked = _mm512_mask_cmpeq_epi8_mask(comparisons, visits, _mm512_set1_epi8(BUSTER_CHECK_EXPRESSION_ACTS | CHECK_INPUT_CODE_BINARY << BUSTER_CHECK_EXPRESSION_CODE_SHIFT));
+        const __m512i set = _mm512_or_si512(visits, _mm512_set1_epi8((int8_t)BUSTER_CHECK_WINDOW_PREDICATE));
+        _mm512_mask_storeu_epi8(reader->visits + i + 3, marked, set);
+    }
+    reader->output->window_condition_candidates += controls;
+}
