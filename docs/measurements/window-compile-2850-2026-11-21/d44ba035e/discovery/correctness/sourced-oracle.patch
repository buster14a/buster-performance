From 5b27df2d07d2ba0241e25d1f124d98ada3600754 Mon Sep 17 00:00:00 2001
From: David Gonzalez Martin <davidgmbb@gmail.com>
Date: Sat, 21 Nov 2026 13:23:53 +0100
Subject: [PATCH] Measure all native functions and source rows against
 unmodified SQLite lowering

Signed-off-by: David Gonzalez Martin <davidgmbb@gmail.com>
---
 .../compiler/c_check_node_census_test.c       | 46 +++++++++++++++++++
 1 file changed, 46 insertions(+)

diff --git a/src/buster/compiler/c_check_node_census_test.c b/src/buster/compiler/c_check_node_census_test.c
index d309f196d..8c36d4616 100644
--- a/src/buster/compiler/c_check_node_census_test.c
+++ b/src/buster/compiler/c_check_node_census_test.c
@@ -6232,6 +6232,51 @@ static void node_window_test_compile(CheckTest* test, bool assignments)
     lower_source_close(&plain);
 }
 
+// Read the actual frozen source twice and compare every selected native function and its source positions.
+static void node_window_test_corpus_sources(CheckTest* test)
+{
+    const char* file = getenv("BUSTER_COMPARE_WINDOW_FILE");
+    if (file == NULL)
+    {
+        return;
+    }
+    static LowerSource regular;
+    static LowerSource candidate;
+    char* options[] = { "-DSQLITE_OMIT_LOAD_EXTENSION", "-DSQLITE_THREADSAFE=0", "-DSQLITE_ENABLE_MEMSYS5", "-DSQLITE_ENABLE_RTREE" };
+    const uint32_t window = BUSTER_LOWER_SOURCE_WINDOW_ASSIGNMENTS | BUSTER_LOWER_SOURCE_WINDOW_CONDITIONS;
+    bool same = lower_source_open(&regular, file, options, BUSTER_ARRAY_LENGTH(options), 0) && regular.prepared &&
+                lower_source_open(&candidate, file, options, BUSTER_ARRAY_LENGTH(options), window) && candidate.prepared;
+    CheckProgramLowered a = { 0 };
+    CheckProgramLowered b = { 0 };
+    same = same && check_program_lower_sources(&a, &regular.selected.program, true, &regular.path.output_arena, &regular.path.scratch) &&
+                   check_program_lower_sources(&b, &candidate.selected.program, true, &candidate.path.output_arena, &candidate.path.scratch) && a.count == b.count;
+    uint32_t tested = 0;
+    uint64_t rows = 0;
+    uint64_t wrong_native = 0;
+    uint64_t wrong_tokens = 0;
+    for (uint32_t i = 0; same && i < a.count; i += 1)
+    {
+        const Tier0Function* first = a.functions + i;
+        const Tier0Function* second = b.functions + i;
+        wrong_native += !check_test_program_function(first, second);
+        if (first->count == second->count)
+        {
+            for (uint32_t j = 0; j < first->count; j += 1)
+            {
+                wrong_tokens += a.entry_tokens[i][j] != b.entry_tokens[i][j];
+            }
+        }
+        tested += 1;
+        rows += first->count;
+    }
+    printf("condition-source-oracle: prepared=%d ordinary=%d opt=%d bodies=%u rows=%" PRIu64 " native-differences=%" PRIu64 " token-differences=%" PRIu64
+           " taken=%u\n", same, regular.prepared, candidate.prepared, tested, rows, wrong_native, wrong_tokens, candidate.path.input.window_condition_count);
+    check_test_expect(test, same && tested != 0 && wrong_native == 0 && wrong_tokens == 0 && candidate.path.input.window_condition_count > 0,
+                      "all native functions and every row's source token agree with ordinary");
+    lower_source_close(&candidate);
+    lower_source_close(&regular);
+}
+
 static void node_window_test_conditions(CheckTest* test)
 {
     char file[PATH_MAX];
@@ -6300,6 +6345,7 @@ static __attribute__((noinline)) void check_test_node_census(CheckTest* test)
     node_window_test_compile(test, false);
     node_window_test_compile(test, true);
     node_window_test_conditions(test);
+    node_window_test_corpus_sources(test);
     char directory[] = "/tmp/buster-node-census-XXXXXX";
     const bool ready = mkdtemp(directory) != 0;
     check_test_expect(test, ready, "node-census fixtures' directory is made");
-- 
