From ccf2160d5f803f8ba50fc407be61cf33251e058a Mon Sep 17 00:00:00 2001
From: David Gonzalez Martin <davidgmbb@gmail.com>
Date: Sat, 21 Nov 2026 12:57:03 +0100
Subject: [PATCH] Measure control window discovery, checking and publication as
 separate prefixes

Signed-off-by: David Gonzalez Martin <davidgmbb@gmail.com>
---
 .../compiler/c_check_expression_input.c       | 65 +++++++++++++++----
 1 file changed, 54 insertions(+), 11 deletions(-)

diff --git a/src/buster/compiler/c_check_expression_input.c b/src/buster/compiler/c_check_expression_input.c
index 264fd0940..2085da928 100644
--- a/src/buster/compiler/c_check_expression_input.c
+++ b/src/buster/compiler/c_check_expression_input.c
@@ -1816,6 +1816,31 @@ static uint32_t check_input_window_code(const uint32_t* classes, uint32_t i)
 
 bool check_node_window_compare(const TypeTable* types, CheckOp op, const CheckValue leaves[2], CheckValue* value, uint8_t* instruction);
 
+// Same-image diagnostic boundaries for the frozen SQLite comparison run. Each prefix before FULL
+// deliberately returns its predicates to ordinary compilation. The optional report runs once per unit.
+typedef struct CheckConditionCost
+{
+    uint32_t stage;
+    uint32_t shaped;
+    uint32_t typed;
+    uint32_t rows;
+} CheckConditionCost;
+
+enum { CONDITION_COST_OFF, CONDITION_COST_ALLOC, CONDITION_COST_CONTROLS, CONDITION_COST_DISCOVER,
+       CONDITION_COST_FRONT, CONDITION_COST_TYPE, CONDITION_COST_ROWS, CONDITION_COST_FULL };
+
+static uint32_t check_condition_cost_stage(void)
+{
+    static const char* const names[] = { "off", "alloc", "controls", "discover", "front", "type", "rows", "full" };
+    const char* selected = getenv("BUSTER_CONDITION_COST");
+    for (uint32_t i = 0; selected != NULL && i < BUSTER_ARRAY_LENGTH(names); i += 1)
+    {
+        if (strcmp(selected, names[i]) == 0)
+            return i;
+    }
+    return CONDITION_COST_FULL;
+}
+
 // The comparison subtree occupies contiguous source tokens. Match its bounding parentheses to the
 // parser's condition roles, stepping over complete parenthesized expressions. A control's closing
 // token follows the controlled statement in postorder, so its operand must be sealed earlier.
@@ -1867,7 +1892,7 @@ static bool check_input_window_local(const CheckInputReader* reader, const Check
 
 // The compacted reader actions and their bound leaves are this front's only inputs. A refused expression has
 // written no graph or lasting tape, so the ordinary walk starts with its original identifier and literal cursors.
-static bool check_input_window_comparison(CheckInputReader* reader, NodeFront* front, const uint32_t* tokens, const uint32_t* classes,
+static bool check_input_window_comparison(CheckInputReader* reader, CheckConditionCost* cost, NodeFront* front, const uint32_t* tokens, const uint32_t* classes,
                                           uint32_t first, uint32_t end, const CheckInputIdentifiers* identifiers, uint32_t identifier,
                                           const CheckInputLiterals* literals, uint32_t literal, CheckValue leaves[2], uint32_t uses[2],
                                           uint32_t* names, CheckValue* result, uint8_t* instruction)
@@ -1921,10 +1946,13 @@ static bool check_input_window_comparison(CheckInputReader* reader, NodeFront* f
     front->argument_count = 0;
     front->wide_count = 0;
     node_front_chunk_lean(front, reader, tokens + first, classes + first, end - first + 1, identifiers, &decoded);
-    return front->count == 3 && front->sizes[2] == 3 && front->tokens[2] == tokens[end] &&
+    const bool shaped = front->count == 3 && front->sizes[2] == 3 && front->tokens[2] == tokens[end] &&
            front->ops[0] == CHECK_OP_VALUE && front->ops[1] == CHECK_OP_VALUE && front->tokens[0] == uses[0] && front->tokens[1] == uses[1] &&
-           front->distances[0][2] == 2 && front->distances[1][2] == 1 &&
-           check_node_window_compare(reader->types, (CheckOp)front->ops[2], leaves, result, instruction);
+           front->distances[0][2] == 2 && front->distances[1][2] == 1;
+    cost->shaped += shaped;
+    const bool typed = shaped && cost->stage > CONDITION_COST_FRONT && check_node_window_compare(reader->types, (CheckOp)front->ops[2], leaves, result, instruction);
+    cost->typed += typed;
+    return typed && cost->stage > CONDITION_COST_TYPE;
 }
 
 // Find a complete expression ending at this candidate. Its source tokens and postorder must agree: a match
@@ -2146,7 +2174,7 @@ static bool check_input_window_assign(CheckInputReader* reader, CheckInputBatch*
 }
 
 // The ordinary control keeps its CONDITION, branch sense and target. Only the value it tests is a summary.
-static bool check_input_window_condition(CheckInputReader* reader, CheckInputBatch* batch, NodeFront* front, const uint32_t* tokens, const uint32_t* classes,
+static bool check_input_window_condition(CheckInputReader* reader, CheckInputBatch* batch, CheckConditionCost* cost, NodeFront* front, const uint32_t* tokens, const uint32_t* classes,
                                          uint32_t first, uint32_t end, const CheckInputIdentifiers* identifiers, uint32_t* identifier,
                                          const CheckInputLiterals* literals, uint32_t* literal)
 {
@@ -2155,7 +2183,7 @@ static bool check_input_window_condition(CheckInputReader* reader, CheckInputBat
     CheckValue value;
     uint32_t names;
     uint8_t instruction;
-    if (!check_input_window_comparison(reader, front, tokens, classes, first, end, identifiers, *identifier, literals, *literal, leaves, uses, &names, &value, &instruction))
+    if (!check_input_window_comparison(reader, cost, front, tokens, classes, first, end, identifiers, *identifier, literals, *literal, leaves, uses, &names, &value, &instruction))
     {
         return false;
     }
@@ -2167,6 +2195,12 @@ static bool check_input_window_condition(CheckInputReader* reader, CheckInputBat
         check_node_window_int_entry(rows + i, local ? leaves[i].object : (uint32_t)leaves[i].integer, uses[i], local);
     }
     rows[2] = (CheckInputWindowRow){ .token = token, .kind = instruction, .class = rows[0].class };
+    cost->rows += 3;
+    if (cost->stage == CONDITION_COST_ROWS)
+    {
+        __asm__ __volatile__("" : : "m"(rows), "m"(value));
+        return false;
+    }
     const uint32_t node = check_input_window_publish(reader, batch, token, value, rows, 3, 3);
     if (node != BUSTER_CHECK_NONE)
     {
@@ -2180,7 +2214,7 @@ static bool check_input_window_condition(CheckInputReader* reader, CheckInputBat
 
 // List complete returns and potentially assignable statements 16 actions at a time. The ordinary action loop runs unchanged between admitted spans, including a
 // return whose operands crossed the chunk boundary. The chunk and all its cursors are local to this reader.
-static __attribute__((noinline)) uint32_t check_input_window_actions(CheckInputReader* reader, CheckInputBatch* batch, NodeFront* conditions, uint32_t chunk, const uint32_t* tokens, const uint32_t* classes,
+static __attribute__((noinline)) uint32_t check_input_window_actions(CheckInputReader* reader, CheckInputBatch* batch, CheckConditionCost* cost, NodeFront* conditions, uint32_t chunk, const uint32_t* tokens, const uint32_t* classes,
                                                                      uint32_t acting, const CheckInputIdentifiers* identifiers, const CheckInputLiterals* literals,
                                                                      uint64_t* visited)
 {
@@ -2197,7 +2231,7 @@ static __attribute__((noinline)) uint32_t check_input_window_actions(CheckInputR
         const __mmask16 terminated = _mm512_mask_cmpeq_epi32_mask(lanes, codes, _mm512_set1_epi32(CHECK_INPUT_CODE_TERMINATOR << BUSTER_CHECK_EXPRESSION_CODE_SHIFT));
         const __mmask16 assignments = _mm512_mask_cmpeq_epi32_mask(terminated, before, _mm512_set1_epi32(CHECK_INPUT_CODE_BINARY << BUSTER_CHECK_EXPRESSION_CODE_SHIFT));
         __mmask16 predicates = 0;
-        if (conditions != NULL)
+        if (conditions != NULL && cost->stage >= CONDITION_COST_CONTROLS)
         {
             const __mmask16 controls = _mm512_mask_cmpeq_epi32_mask(lanes, codes, _mm512_set1_epi32(CHECK_INPUT_CODE_CONDITION << BUSTER_CHECK_EXPRESSION_CODE_SHIFT));
             for (uint32_t bits = controls; bits != 0; bits &= bits - 1)
@@ -2206,6 +2240,9 @@ static __attribute__((noinline)) uint32_t check_input_window_actions(CheckInputR
                 const uint32_t kind = keyword < reader->parser->tokens.count ? reader->parser->tokens.kinds[keyword] : 0;
                 reader->output->window_condition_candidates += kind == PARSE_KIND_IF || kind == PARSE_KIND_WHILE;
             }
+        }
+        if (conditions != NULL && cost->stage >= CONDITION_COST_DISCOVER)
+        {
             const __mmask16 binary = _mm512_mask_cmpeq_epi32_mask(lanes, codes, _mm512_set1_epi32(CHECK_INPUT_CODE_BINARY << BUSTER_CHECK_EXPRESSION_CODE_SHIFT));
             for (uint32_t bits = binary; bits != 0; bits &= bits - 1)
             {
@@ -2241,7 +2278,7 @@ static __attribute__((noinline)) uint32_t check_input_window_actions(CheckInputR
         if (!reader->output->resource && first < end)
         {
             const bool statement = check_input_window_code(classes, end) == CHECK_INPUT_CODE_TERMINATOR;
-            const bool taken = condition ? check_input_window_condition(reader, batch, conditions, tokens, classes, first, end, identifiers, &identifier, literals, &literal) :
+            const bool taken = condition ? cost->stage > CONDITION_COST_DISCOVER && check_input_window_condition(reader, batch, cost, conditions, tokens, classes, first, end, identifiers, &identifier, literals, &literal) :
                                statement ? check_input_window_assign(reader, batch, tokens[end], identifiers, &identifier, literals, &literal) :
                                check_input_window_take(reader, batch, tokens, first, end, literals, &literal, identifiers, &identifier);
             if (taken)
@@ -2349,8 +2386,9 @@ static void check_input_expressions_coded_range(CheckInputReader* reader, uint32
     // original root's operand even for a rejected return. The shadow and the graph-numbering probe compare graph nodes.
     const bool window = reader->pp->options.node_window && coded && begin == 0 && stop == count && !timed && front == NULL &&
                         reader->expression_declined == NULL && reader->parser->errors == 0 && input->musttail_count == 0 && check_node_window_prepare();
+    CheckConditionCost cost = { .stage = window && reader->pp->options.node_window_conditions ? check_condition_cost_stage() : CONDITION_COST_OFF };
     NodeFront* conditions = NULL;
-    if (window && reader->pp->options.node_window_conditions)
+    if (cost.stage >= CONDITION_COST_ALLOC)
     {
         conditions = arena_push_array(reader->scratch, 1, sizeof(*conditions), 64);
         NodeFrontShadow* shadow = arena_push_array(reader->scratch, 1, sizeof(*shadow), _Alignof(NodeFrontShadow));
@@ -2390,7 +2428,7 @@ static void check_input_expressions_coded_range(CheckInputReader* reader, uint32
         uint32_t i = 0;
         if (window)
         {
-            i = check_input_window_actions(reader, batch, conditions, first, tokens, classes, acting, &identifiers, &literals, &visited);
+            i = check_input_window_actions(reader, batch, &cost, conditions, first, tokens, classes, acting, &identifiers, &literals, &visited);
         }
         else if (!timed)
         {
@@ -2435,6 +2473,11 @@ static void check_input_expressions_coded_range(CheckInputReader* reader, uint32
     {
         node_front_finish(front, reader, base);
     }
+    if (window && reader->pp->options.node_window_conditions && getenv("BUSTER_CONDITION_COST_REPORT") != NULL)
+    {
+        fprintf(stderr, "condition-cost: stage=%u controls=%u bounded=%u shaped=%u typed=%u native=%u published=%u\n", cost.stage,
+                input->window_condition_candidates, input->window_condition_bounded, cost.shaped, cost.typed, cost.rows, input->window_condition_count);
+    }
     // A coded unit's visits lie within its chunks' actions; another's actions are all visits.
     visited = coded ? (visited < acted ? visited : acted) : acted;
     reader->output->expression_part_ticks[BUSTER_CHECK_EXPRESSION_PART_PREPARE] = prepared;
-- 
2.56.1

