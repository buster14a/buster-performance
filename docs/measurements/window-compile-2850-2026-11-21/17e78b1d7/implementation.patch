+// A closed, unflushed leaf that the published window can read directly. The object and type have
+// already been resolved by the reader. The source form excludes enumerators, volatile and special
+// storage, and any token whose value the ordinary diagnostic or lowering paths can observe separately.
+static bool check_input_pending_local(const CheckInputReader* reader, const CheckGraphLeaf* leaf, uint32_t token)
+{
+    const CheckInput* input = reader->output;
+    const uint32_t declaration = leaf->object - 1;
+    return reader->parser->tokens.kinds[token] == PARSE_KIND_IDENTIFIER && leaf->type == BUSTER_TYPE_INT &&
+           leaf->category == CHECK_LVALUE && leaf->flags == BUSTER_CHECK_NONNULL_ADDRESS && leaf->constant_kind == CHECK_CONSTANT_ADDRESS &&
+           leaf->integer == 0 && leaf->row == 0 && leaf->overload_head == 0 && declaration < input->token_count &&
+           input->declaration_kinds[declaration] == C_BINDING_OBJECT && !check_input_bit(input->declaration_bits, declaration, BUSTER_CHECK_BITS_THREAD_LOCAL) &&
+           check_sparse_get(input->declaration_bodies, declaration) < input->token_count;
+}
+
+static bool check_input_pending_number(const CheckInputReader* reader, const CheckGraphLeaf* leaf, uint32_t token)
+{
+    return reader->parser->tokens.kinds[token] == PARSE_KIND_NUMBER && leaf->type == BUSTER_TYPE_INT && leaf->category == CHECK_RVALUE &&
+           leaf->constant_kind == CHECK_CONSTANT_INTEGER && (leaf->flags & ~BUSTER_CHECK_LITERAL_ZERO) == BUSTER_CHECK_ICE &&
+           leaf->integer <= INT32_MAX && leaf->object == 0 && leaf->row == 0 && leaf->overload_head == 0;
+}
+
+// Replace the final nodes of the pending batch. Until publication succeeds their existing records
+// remain untouched. Allocation refusal restores both cursors and the reader continues normally.
+static uint32_t check_input_pending_commit(CheckInputReader* reader, CheckInputBatch* batch, uint32_t token, CheckValue value,
+                                           const CheckInputWindowRow* rows, uint32_t length, uint32_t nodes, uint32_t leaves)
+{
+    batch->count -= nodes;
+    batch->leaves -= leaves;
+    const uint32_t summary = check_input_window_publish(reader, batch, token, value, rows, length, nodes + 1);
+    if (summary == BUSTER_CHECK_NONE)
+    {
+        batch->count += nodes;
+        batch->leaves += leaves;
+    }
+    return summary;
+}
+
+static bool check_input_pending_return(CheckInputReader* reader, CheckInputBatch* batch, uint32_t token, uint32_t child)
+{
+    const Parser* parser = reader->parser;
+    const uint32_t place = child - batch->base;
+    const uint32_t operand = batch->tokens[place];
+    if (operand != token + 1 || parser->tokens.count - token < 3 || parser->tokens.kinds[token + 2] != PARSE_KIND_SEMI ||
+        parser->tree.parents[operand] != token || batch->contexts[place] != 0)
+    {
+        return false;
+    }
+    const CheckGraphLeaf* leaf = reader->output->graph.leaf_records + batch->leaf_slots[place];
+    const bool local = check_input_pending_local(reader, leaf, operand);
+    if (!local && !check_input_pending_number(reader, leaf, operand))
+    {
+        return false;
+    }
+    CheckValue value = { .type = BUSTER_TYPE_INT, .category = CHECK_RVALUE };
+    value.flags = local ? BUSTER_CHECK_NONNULL_ADDRESS : BUSTER_CHECK_ICE;
+    value.object = local ? leaf->object : 0;
+    value.constant_kind = local ? CHECK_CONSTANT_NONE : CHECK_CONSTANT_INTEGER;
+    value.integer = local ? 0 : leaf->integer;
+    CheckInputWindowRow row;
+    check_node_window_int_entry(&row, local ? leaf->object : (uint32_t)leaf->integer, local ? operand : token, local);
+    const uint32_t summary = check_input_pending_commit(reader, batch, token, value, &row, 1, 1, 1);
+    if (summary != BUSTER_CHECK_NONE)
+    {
+        reader->first_value[operand] = BUSTER_CHECK_NONE;
+        reader->output->token_nodes[operand] = BUSTER_CHECK_NONE;
+        reader->output->token_nodes[token] = summary;
+    }
+    return summary != BUSTER_CHECK_NONE;
+}
+
+static bool check_input_pending_store(CheckInputReader* reader, CheckInputBatch* batch, uint32_t token)
+{
+    const uint32_t first = batch->count - 3;
+    const uint32_t left = batch->base + first;
+    const Parser* parser = reader->parser;
+    const uint32_t parent = parser->tree.parents[token];
+    if (token < 3 || parser->tokens.kinds[token] != PARSE_KIND_SEMI || parser->tree.roles[token] != PARSE_ROLE_TERMINATOR || parent >= parser->tokens.count ||
+        (parser->tree.roles[parent] != PARSE_ROLE_CLOSE_BODY && parser->tree.roles[parent] != PARSE_ROLE_CLOSE_BLOCK) ||
+        batch->ops[first] != CHECK_OP_VALUE || batch->ops[first + 1] != CHECK_OP_VALUE || batch->operand0[first + 2] != left ||
+        batch->operand1[first + 2] != left + 1 || batch->tokens[first] != token - 3 || batch->tokens[first + 1] != token - 1 ||
+        batch->tokens[first + 2] != token - 2 || parser->tree.parents[token - 2] != token || parser->tree.parents[token - 3] != token - 2 ||
+        parser->tree.parents[token - 1] != token - 2 || (batch->contexts[first] | batch->contexts[first + 1] | batch->contexts[first + 2]) != 0)
+    {
+        return false;
+    }
+    const CheckGraph* graph = &reader->output->graph;
+    const CheckGraphLeaf* target = graph->leaf_records + batch->leaf_slots[first];
+    const CheckGraphLeaf* source = graph->leaf_records + batch->leaf_slots[first + 1];
+    const bool local = check_input_pending_local(reader, source, token - 1);
+    if (!check_input_pending_local(reader, target, token - 3) || (local ? source->object == target->object : !check_input_pending_number(reader, source, token - 1)))
+    {
+        return false;
+    }
+    CheckInputWindowRow rows[3];
+    check_node_window_int_entry(rows, local ? source->object : (uint32_t)source->integer, token - 1, local);
+    check_node_window_store(rows + 1, target->object, token - 2);
+    const CheckValue value = { .type = BUSTER_TYPE_VOID, .category = CHECK_RVALUE, .flags = BUSTER_CHECK_SIDE_EFFECT | (local ? BUSTER_CHECK_NONNULL_ADDRESS : 0),
+                               .integer = local ? 0 : source->integer, .object = local ? source->object : 0 };
+    const uint32_t summary = check_input_pending_commit(reader, batch, token, value, rows, 3, 3, 2);
+    if (summary != BUSTER_CHECK_NONE)
+    {
+        for (uint32_t t = token - 3; t < token; t += 1)
+        {
+            reader->first_value[t] = BUSTER_CHECK_NONE;
+            reader->output->token_nodes[t] = BUSTER_CHECK_NONE;
+        }
+        reader->output->token_nodes[token - 3] = summary;
+        if (reader->region_roots != NULL)
+        {
+            reader->region_roots[token] = summary;
+        }
+    }
+    return summary != BUSTER_CHECK_NONE;
+}
