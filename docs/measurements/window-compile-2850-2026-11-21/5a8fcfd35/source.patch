diff --git a/src/buster/compiler/c_parser_source_forest.c b/src/buster/compiler/c_parser_source_forest.c
new file mode 100644
index 000000000..8951b6fdf
--- /dev/null
+++ b/src/buster/compiler/c_parser_source_forest.c
@@ -0,0 +1,271 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+
+#define LIVE_LIMIT (4u << 20)
+
+typedef struct LiveForest
+{
+    ParseTokens tokens;
+    ParseTree tree;
+    uint32_t *postorder, *positions, *ends, *first_children, *next_siblings, *sizes;
+    ParseMeanings names;
+    Arena* scratch;
+    uint8_t* tags;
+    uint32_t input, converted, scanned, parsed, frontier, windows, live_windows, live_parsed, callbacks, known_ids;
+    uint64_t vector_tokens, fallback_tokens;
+    int32_t depth;
+    bool body, pending_pack, refused;
+} LiveForest;
+
+static void live_names(LiveForest* live, Preprocessor* pp)
+{
+    for (uint32_t i = 0; i < BUSTER_PARSE_PREDECLARED_TYPEDEFS; i += 1)
+    {
+        const char* name = parse_predeclared_typedefs[i];
+        const uint32_t id = intern_find(pp->table,(const uint8_t*)name,strlen(name));
+        if (id != 0 && id >= live->known_ids) live->names.meanings[id] = PARSE_MEANING_TYPEDEF;
+    }
+    parse_custom_attribute_names(&live->names, pp->table);
+    live->known_ids = pp->table->count;
+    live->names.table = pp->table;
+    live->names.capacity = pp->table->count;
+}
+
+// Each vector job reads padding before and after its input. An interior declaration boundary
+// has live tokens on both sides, so give this job its own end sentinels and scratch columns.
+static bool live_vector_tree(LiveForest* live, Preprocessor* pp, uint32_t begin, uint32_t count, ParseTree tree)
+{
+    Arena* scratch = live->scratch;
+    const uint32_t padding = BUSTER_PARSE_TOKEN_PADDING;
+    const uint32_t slots = count + 2 * padding;
+    uint8_t* kinds = BUSTER_ARENA_PUSH_ARRAY(scratch, uint8_t, slots);
+    uint32_t* names = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, slots);
+    uint8_t* flags = BUSTER_ARENA_PUSH_ARRAY(scratch, uint8_t, slots);
+    ParseMeanings scope = live->names;
+    scope.meanings = BUSTER_ARENA_PUSH_ARRAY(scratch, uint8_t, (uint64_t)scope.capacity + 1);
+    ParseKernels kernels = { 0 };
+    ParseVectorBuffers buffers = { 0 };
+    if (!kinds || !names || !flags || !scope.meanings ||
+        !parse_kernels_reserve(&kernels, scratch, count, scope.capacity) ||
+        !parse_vector_buffers_reserve(&buffers, scratch, count)) return false;
+
+    memset(kinds, PARSE_KIND_END, padding);
+    memset(kinds + padding + count, PARSE_KIND_END, padding);
+    memset(names, 0, padding * sizeof(*names));
+    memset(names + padding + count, 0, padding * sizeof(*names));
+    memset(flags, 0, padding);
+    memset(flags + padding + count, 0, padding);
+    memcpy(kinds + padding, live->tokens.kinds + begin, count);
+    memcpy(names + padding, live->tokens.names + begin, (size_t)count * sizeof(*names));
+    memcpy(flags + padding, live->tokens.flags + begin, count);
+    memcpy(scope.meanings, live->names.meanings, scope.capacity);
+    for (uint32_t id = 1; id < scope.capacity; id += 1)
+        if (scope.meanings[id] == PARSE_MEANING_TYPEDEF) kernels.typedef_names[id] = BUSTER_PARSE_TYPEDEF_FILE;
+
+    IdentId predeclared[BUSTER_PARSE_PREDECLARED_TYPEDEFS];
+    for (uint32_t i = 0; i < BUSTER_PARSE_PREDECLARED_TYPEDEFS; i += 1)
+    {
+        const char* name = parse_predeclared_typedefs[i];
+        predeclared[i] = intern_find(pp->table, (const uint8_t*)name, strlen(name));
+    }
+    ParseDiagnostic diagnostics[8];
+    const ParseInput input = {
+        .kinds = kinds + padding, .names = names + padding, .flags = flags + padding,
+        .count = count, .language = pp->options.language, .meanings = &scope, .scratch = scratch,
+        .diagnostics = diagnostics, .diagnostic_capacity = 8, .prior_file_items = begin != 0,
+    };
+    const ParseKernelResult parsed = parse_vector(&kernels, &input, predeclared, &buffers);
+    if (parsed.fallback.errors || kernels.unsupported || kernels.unbalanced) return false;
+
+    memcpy(tree.roles, kernels.roles, count);
+    memcpy(tree.parents, kernels.parents, (size_t)count * sizeof(*tree.parents));
+    memcpy(tree.depths, kernels.node_depths, (size_t)count * sizeof(*tree.depths));
+    for (uint32_t i = 0; i < kernels.typedef_count; i += 1)
+        if (kernels.typedef_scopes[i] == BUSTER_PARSE_TYPEDEF_FILE)
+            live->names.meanings[kernels.typedef_log[i]] = PARSE_MEANING_TYPEDEF;
+    live->vector_tokens += count;
+    live->fallback_tokens += parsed.fallback.tokens;
+    return true;
+}
+
+static bool live_parse(LiveForest* live, Preprocessor* pp, uint32_t end)
+{
+    const uint32_t begin = live->parsed;
+    if (begin == end) return true;
+    ParseTree tree = { .parents=live->tree.parents+begin, .roles=live->tree.roles+begin, .depths=live->tree.depths+begin };
+    live_names(live, pp);
+    const uint32_t count = end - begin;
+    const uint64_t grammar_mark = live->scratch->length;
+    const bool parsed = live_vector_tree(live, pp, begin, count, tree);
+    arena_pop_to(live->scratch, grammar_mark);
+    if (!parsed) return false;
+    const uint64_t mark = live->scratch->length;
+    uint32_t* last = BUSTER_ARENA_PUSH_ARRAY(live->scratch, uint32_t, (uint64_t)count + 1);
+    uint32_t* before = BUSTER_ARENA_PUSH_ARRAY(live->scratch, uint32_t, (uint64_t)count + 1);
+    uint32_t* starts = BUSTER_ARENA_PUSH_ARRAY(live->scratch, uint32_t, (uint64_t)count + 1);
+    if (!last || !before || !starts) return false;
+    uint32_t* postorder = live->postorder + begin;
+    uint32_t* positions = live->positions + begin;
+    uint32_t* ends = live->ends + begin;
+    uint32_t* first_children = live->first_children + begin;
+    uint32_t* next_siblings = live->next_siblings + begin;
+    parse_tree_columns(tree.parents, count, last, before, postorder, positions, ends, first_children,
+                       next_siblings, starts, live->sizes + begin);
+    for (uint32_t i = 0; i < count; i += 1)
+    {
+        postorder[i] += begin;
+        positions[i] += begin;
+        ends[i] += begin;
+        if (first_children[i] != BUSTER_PARSE_NONE) first_children[i] += begin;
+        if (next_siblings[i] != BUSTER_PARSE_NONE) next_siblings[i] += begin;
+    }
+    ends[count] = end;
+    arena_pop_to(live->scratch, mark);
+    for (uint32_t i=0;i<end-begin;i++)
+        if (tree.parents[i] != BUSTER_PARSE_ROOT) tree.parents[i] += begin;
+    live->parsed = end;
+    live->windows += 1;
+    if (pp->context_count != 0) { live->live_windows += 1; live->live_parsed = end; }
+    return true;
+}
+
+static void live_receive(void* object, Preprocessor* pp, uint32_t begin, uint32_t end)
+{
+    LiveForest* live = object;
+    if (live->refused) return;
+    live->callbacks += 1;
+    if (live->input != begin || pp->table->count + 1 >= LIVE_LIMIT) {live->refused=true; return;}
+    live->input = end;
+    PPTokens output=pp->output;
+    output.count=end;
+    ParseTokens* tokens=&live->tokens;
+    const uint32_t first_written = tokens->count;
+    const uint32_t first_pragma = tokens->pragma_count;
+    if ((uint64_t)tokens->count + 2 * (uint64_t)(end - live->converted) + 2 > LIVE_LIMIT)
+    {
+        live->refused = true;
+        return;
+    }
+    live->converted = parse_append_output(&output, tokens, live->converted, pp->context_count == 0);
+    const uint32_t written = tokens->count;
+    if (live->pending_pack && first_written < written)
+    {
+        tokens->flags[first_written] |= BUSTER_PARSE_AFTER_PRAGMA_PACK;
+        live->pending_pack = false;
+    }
+    for (uint32_t k = first_pragma; k < tokens->pragma_count; k += 1)
+    {
+        const uint32_t hash = tokens->pragma_sources[k], position = tokens->pragma_positions[k];
+        uint32_t close = hash;
+        if (parse_pragma_at(&output, hash, &close) && pp_token_is_name(pp, &output, hash + 2, close, "pack"))
+        {
+            if (position < written) tokens->flags[position] |= BUSTER_PARSE_AFTER_PRAGMA_PACK;
+            else live->pending_pack = true;
+        }
+    }
+    for (uint32_t i=live->scanned;i<written;i++)
+    {
+        const uint8_t k=tokens->kinds[i];
+        if (k==PARSE_KIND_L_BRACE || k==PARSE_KIND_L_PAREN || k==PARSE_KIND_L_SQUARE)
+        {
+            if (live->depth==0 && k==PARSE_KIND_L_BRACE) live->body=i!=0 && tokens->kinds[i-1]==PARSE_KIND_R_PAREN;
+            live->depth+=1;
+        }
+        if (k==PARSE_KIND_R_BRACE || k==PARSE_KIND_R_PAREN || k==PARSE_KIND_R_SQUARE) live->depth-=1;
+        if (live->depth<0) { live->refused=true; return; }
+        if (live->depth==0 && (k==PARSE_KIND_SEMI || (k==PARSE_KIND_R_BRACE && live->body)))
+            live->frontier=i+1;
+    }
+    live->scanned=written;
+    if (live->frontier>live->parsed && !live_parse(live,pp,live->frontier)) live->refused=true;
+}
+
+BUSTER_PARSER_ENTRY void parse_begin_source_forest(Parser* parser, Preprocessor* pp)
+{
+    if (pp->options.scalar || arena_reservation_limit() != BUSTER_ARENA_MAX_CAPACITY) return;
+    parser->live_rows = arena_reserve(UINT64_C(1) << 28);
+    LiveForest* live = BUSTER_ARENA_PUSH_ARRAY(&parser->live_rows, LiveForest, 1);
+    if (live == NULL) return;
+    *live = (LiveForest){ .scratch = &parser->scratch };
+#define LIVE_COL(field, Type) do { \
+        Type* storage = BUSTER_ARENA_PUSH_ARRAY(&parser->live_rows, Type, LIVE_LIMIT + 2 * BUSTER_PARSE_TOKEN_PADDING); \
+        if (storage == NULL) return; \
+        live->field = storage + BUSTER_PARSE_TOKEN_PADDING; \
+    } while (0)
+    LIVE_COL(tokens.kinds, uint8_t);
+    LIVE_COL(tokens.names, uint32_t);
+    LIVE_COL(tokens.flags, uint8_t);
+    LIVE_COL(tokens.sources, uint32_t);
+    LIVE_COL(tokens.pragma_sources, uint32_t);
+    LIVE_COL(tokens.pragma_positions, uint32_t);
+    LIVE_COL(tree.roles, uint8_t);
+    LIVE_COL(tree.depths, uint32_t);
+    LIVE_COL(tree.parents, uint32_t);
+    LIVE_COL(postorder,uint32_t); LIVE_COL(positions,uint32_t); LIVE_COL(ends,uint32_t);
+    LIVE_COL(first_children,uint32_t); LIVE_COL(next_siblings,uint32_t); LIVE_COL(sizes,uint32_t);
+    LIVE_COL(tags, uint8_t);
+    LIVE_COL(names.meanings, uint8_t);
+#undef LIVE_COL
+    live->tokens.identity_sources = true;
+    live->tokens.capacity = LIVE_LIMIT;
+    parser->live_forest = live;
+    pp->source_forest = live;
+    pp->source_range = live_receive;
+}
+
+static bool parse_take_source_tokens(Parser* parser, Preprocessor* pp)
+{
+    LiveForest* live = parser->live_forest;
+    if (live == NULL || live->refused || pp->errors != 0) return false;
+    if (live->converted < pp->output.count)
+    {
+        live->input = live->converted;
+        live_receive(live, pp, live->input, pp->output.count);
+    }
+    if (live->refused || live->converted != pp->output.count || !live_parse(live, pp, live->tokens.count))
+    {
+        live->refused = true;
+        return false;
+    }
+    parser->tokens = live->tokens;
+    parser->meaning_room = 0;
+    parser->meaning_column = NULL;
+    parser->diagnostic_column = NULL;
+    return true;
+}
+
+static bool parse_take_source_forest(Parser* parser, Preprocessor* pp)
+{
+    LiveForest* live = parser->live_forest;
+    // A recovery parse uses the ordinary complete-unit entry point and can call it again.
+    parser->live_forest = NULL;
+    if (live == NULL) return false;
+    if (!live->refused && live->converted < pp->output.count)
+    {
+        live->input = live->converted;
+        live_receive(live, pp, live->input, pp->output.count);
+    }
+    const uint32_t count = parser->tokens.count;
+    bool ready = !live->refused && pp->errors == 0 && live->converted == pp->output.count &&
+                 live->tokens.count == count && live_parse(live, pp, count);
+    // The full conversion applies deferred history-dependent attribute rewrites. Its token tuple must equal
+    // the stream given to the source parser, including names, pack flags and normalized kinds.
+    if (parser->tokens.kinds != live->tokens.kinds) ready = ready && memcmp(parser->tokens.kinds, live->tokens.kinds, count) == 0 &&
+            memcmp(parser->tokens.names, live->tokens.names, (size_t)count * sizeof(uint32_t)) == 0 &&
+            memcmp(parser->tokens.flags, live->tokens.flags, count) == 0;
+    if (getenv("BUSTER_PARSE_LIVE_AUDIT") != NULL)
+        fprintf(stderr, "live-forest\taccepted=%u\ttokens=%u\tbefore-eof=%u\twindows=%u\tcallbacks=%u\tvector-tokens=%llu\tlocal-fallback-tokens=%llu\n",
+                ready, count, live->live_parsed, live->windows, live->callbacks, (unsigned long long)live->vector_tokens,
+                (unsigned long long)live->fallback_tokens);
+    if (ready)
+    {
+        parser->tree = live->tree;
+        parser->postorder = live->postorder;
+        parser->positions = live->positions;
+        parser->ends = live->ends;
+        parser->first_children = live->first_children;
+        parser->next_siblings = live->next_siblings;
+        parser->sizes = live->sizes;
+    }
+    return ready;
+}
