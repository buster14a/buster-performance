+// Judge an unqualified int local's postfix update before the ordinary graph is allocated.
+bool check_node_window_postfix(const TypeTable* types, uint32_t object, uint32_t token, bool decrement, CheckValue* summary, CheckInputWindowRow rows[5])
+{
+    const uint32_t word = node_machine_make_word(types, BUSTER_TYPE_CODE_INT, BUSTER_TYPED_CLASS_I32, check_lower_builtin_facts[BUSTER_TYPE_CODE_INT]);
+    NodeFactsRow types_used[BUSTER_TYPE_CODE_INT + 1] = { 0 };
+    types_used[BUSTER_TYPE_CODE_INT] = (NodeFactsRow){ .word = word, .value = BUSTER_TYPE_INT, .flags = BUSTER_NODE_FACTS_SIGNED };
+    const NodeFactsView view = { .rows = types_used, .row_count = BUSTER_ARRAY_LENGTH(types_used), .int_word = word };
+    NodeFactsRecord facts[2] = { 0 };
+    node_facts_record(facts, 0, BUSTER_TYPE_INT, word, BUSTER_NODE_MACHINE_STANDING(CHECK_LVALUE, CHECK_CONSTANT_ADDRESS), BUSTER_CHECK_NONNULL_ADDRESS, object, 0);
+    const CheckOp op = decrement ? CHECK_OP_POST_DECREMENT : CHECK_OP_POST_INCREMENT;
+    if (!node_facts_update(facts, &view, 1, 0, 0, false, op, false) || facts[1].type != BUSTER_TYPE_INT ||
+        facts[1].standing != BUSTER_NODE_MACHINE_STANDING(CHECK_RVALUE, CHECK_CONSTANT_NONE))
+    {
+        return false;
+    }
+    *summary = (CheckValue){ .type = facts[1].type, .flags = facts[1].flags, .object = facts[1].object, .integer = facts[1].payload };
+    const uint8_t class = BUSTER_TYPED_CLASS_I32;
+    rows[0] = (CheckInputWindowRow){ .token = token, .kind = BUSTER_TYPED_LOCAL, .class = class, .value = object,
+                                   .flags = BUSTER_CHECK_WINDOW_LOCAL | BUSTER_CHECK_WINDOW_READ | BUSTER_CHECK_WINDOW_UPDATE, .event_offset = -1 };
+    rows[1] = (CheckInputWindowRow){ .token = token, .kind = BUSTER_TYPED_DUP, .class = class };
+    rows[2] = (CheckInputWindowRow){ .token = token, .kind = BUSTER_TYPED_CONST, .class = class, .value = 1 };
+    rows[3] = (CheckInputWindowRow){ .token = token, .kind = decrement ? BUSTER_TYPED_SUB : BUSTER_TYPED_ADD, .class = class };
+    rows[4] = (CheckInputWindowRow){ .token = token, .kind = BUSTER_TYPED_SET_LOCAL, .class = class, .value = object,
+                                   .flags = BUSTER_CHECK_WINDOW_LOCAL | BUSTER_CHECK_WINDOW_WRITE | BUSTER_CHECK_WINDOW_UPDATE, .event_offset = -1 };
+    return true;
+}
