@@ -6945,6 +6945,20 @@ static void check_live_control_warnings(CheckSourceControlUnit* unit, CheckProgr
     }
     const Parser* parser = reader->parser;
     CheckInput input = *program->input;
+    // A body enters here with no reader reports. Attribute checks can supply one per member or per
+    // condition at a use. Keep those records inside the live graph up to the ordinary unit's capacity.
+    if (semantic_errors)
+    {
+        const uint64_t room = (uint64_t)input.graph.count * ((uint64_t)input.condition_count + 1) + 1;
+        const uint32_t unit_room = input.token_count + 1;
+        input.report_capacity = room < unit_room ? (uint32_t)room : unit_room;
+        input.reports = BUSTER_ARENA_PUSH_ARRAY(reader->arena, CheckInputReport, input.report_capacity);
+        if (input.reports == NULL)
+        {
+            check_common_exhausted(pp);
+            return;
+        }
+    }
     // Source-owned bodies at this boundary exclude GNU statement expressions.
     // Interrupt functions, their direct callers and the translation-unit constant-expression calls have a single ordinary owner.
     input.interrupt_calls = false;
