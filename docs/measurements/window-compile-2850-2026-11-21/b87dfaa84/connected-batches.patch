+// Builtin evidence may inspect an argument's entire lvalue path for its alignment or extent. Leave that path in the
+// graph, along with expressions that expose the field's address. An unusually deep source path takes the same fallback.
+static bool check_input_window_member_context(const CheckInputReader* reader, uint32_t parent)
+{
+    const Parser* parser = reader->parser;
+    for (uint32_t steps = 0; parent < reader->output->token_count && steps < 64; steps += 1)
+    {
+        const uint32_t role = parser->tree.roles[parent];
+        if ((reader->builtins != NULL && reader->builtins[parent] != 0) ||
+            (role == PARSE_ROLE_PREFIX && parser->tokens.kinds[parent] == PARSE_KIND_AMP))
+        {
+            return false;
+        }
+        if (role == PARSE_ROLE_RETURN || role == PARSE_ROLE_TERMINATOR || role == PARSE_ROLE_OPEN_BLOCK || role == PARSE_ROLE_OPEN_BODY)
+        {
+            return true;
+        }
+        parent = parser->tree.parents[parent];
+    }
+    return parent >= reader->output->token_count;
+}
