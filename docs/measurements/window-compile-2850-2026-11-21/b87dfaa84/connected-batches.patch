+// A field location starts with the value of its source pointer. Its member declaration keeps the offset and type.
+void check_node_window_member_pointer(CheckInputWindowRow* row, uint32_t object, uint32_t token)
+{
+    *row = (CheckInputWindowRow){ .value = object, .token = token, .kind = BUSTER_TYPED_LOCAL,
+                                  .class = BUSTER_TYPED_CLASS_U64, .flags = BUSTER_CHECK_WINDOW_LOCAL | BUSTER_CHECK_WINDOW_READ };
+}
+
+uint32_t check_node_window_member_step(CheckInputWindowRow* rows, uint32_t token, TypeId type, uint64_t offset, bool load, bool terminal)
+{
+    uint32_t count = 0;
+    if (offset != 0)
+    {
+        rows[count++] = (CheckInputWindowRow){ .token=token, .kind=BUSTER_TYPED_CONST, .class=BUSTER_TYPED_CLASS_U64, .value=offset };
+        rows[count++] = (CheckInputWindowRow){ .token=token, .kind=BUSTER_TYPED_PTR_ADD, .class=BUSTER_TYPED_CLASS_U64, .value=1 };
+    }
+    if (load)
+    {
+        rows[count++] = (CheckInputWindowRow){ .token=token, .kind=BUSTER_TYPED_LOAD, .value=type,
+            .flags=BUSTER_CHECK_WINDOW_FIELD_LOAD | (terminal ? BUSTER_CHECK_WINDOW_LAST_LOAD : 0) };
+    }
+    return count;
+}
