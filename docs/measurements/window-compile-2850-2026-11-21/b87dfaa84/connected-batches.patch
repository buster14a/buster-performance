+// Return unresolved member spellings to the ordinary owner before it builds a graph for this region.
+static void check_materialize_source_selectors(CheckInputReader* reader,uint32_t begin,uint32_t end)
+{
+    PPNameViews* plan=reader->pp?reader->pp->name_views:NULL;
+    if(!plan || !plan->selector_count || begin>=end)return;
+    const ParseTokens* tokens=&reader->parser->tokens;
+    uint32_t first=0,stop=plan->selector_count;
+    while(first<stop)
+    {
+        const uint32_t m=first+(stop-first)/2;
+        if(plan->selectors[m].parser_token<begin)first=m+1;else stop=m;
+    }
+    for(uint32_t i=first;i<plan->selector_count && plan->selectors[i].parser_token<end;i++)
+    {
+        PPBorrowedSelector* field=plan->selectors+i;
+        const uint32_t t=field->parser_token;
+        if(t>=tokens->count || tokens->names[t] || parse_source_index(tokens,t)!=field->row)continue;
+        const IdentId id=field->declaration?field->declaration:intern_find_or_add(reader->pp->table,field->bytes,field->length);
+        if(!id){reader->output->resource=true;return;}
+        tokens->names[t]=id;
+        if(!reader->pp->output_released)reader->pp->output.values[field->row]=id;
+    }
+}
