 // Splice the prechecked expression's tape, map local objects in the current body and give each entry its
 // own source token. The next ordinary task resumes the source and failure context active at this splice.
+static _Thread_local uint64_t chain_witness_tasks[256];
+static _Thread_local uint64_t chain_witness_expansions;
+static _Thread_local uint64_t chain_witness_tapes;
+static void check_chain_witness_tasks(void)
+{
+    for (uint32_t i = 0; i < 256; i += 1)
+        if (chain_witness_tasks[i] != 0) fprintf(stderr, "chain-task\t%u\t%llu\n", i, (unsigned long long)chain_witness_tasks[i]);
+    fprintf(stderr, "chain-expansions\t%llu\t%llu\n", (unsigned long long)chain_witness_expansions, (unsigned long long)chain_witness_tapes);
+    memset(chain_witness_tasks,0,sizeof(chain_witness_tasks));
+    chain_witness_expansions=0; chain_witness_tapes=0;
+}
