diff --git a/src/buster/compiler/c_check_member_chain_input.c b/src/buster/compiler/c_check_member_chain_input.c
new file mode 100644
index 000000000..2689a9ecc
--- /dev/null
+++ b/src/buster/compiler/c_check_member_chain_input.c
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+//
+// A local pointer, its complete direct record members and the enclosing use already have source facts.
+// Publish one checked lvalue plus a typed operand tape before the ordinary leaves and member actions exist.
+typedef struct CheckMemberChainOptions
+{
+    bool enabled;
+    bool audit;
+    bool poison;
+    uint32_t mutate_token;
+} CheckMemberChainOptions;
+
+uint32_t check_node_window_member_step(CheckInputWindowRow* rows, uint32_t token, TypeId type, uint64_t offset, bool load, bool terminal);
+
+static bool check_input_chain_context(const CheckInputReader* reader, uint32_t token)
+{
+    const Parser* p = reader->parser;
+    for (uint32_t steps = 0; token < p->tokens.count && steps < 64; steps += 1)
+    {
+        const uint32_t role = p->tree.roles[token];
+        if ((reader->builtins != NULL && reader->builtins[token] != 0) || (reader->constant_contexts != NULL && reader->constant_contexts[token] != 0))
+            return false;
+        if (role == PARSE_ROLE_RETURN || role == PARSE_ROLE_TERMINATOR || role == PARSE_ROLE_OPEN_CONDITION)
+            return true;
+        if (role == PARSE_ROLE_OPEN_BODY || role == PARSE_ROLE_OPEN_BLOCK)
+            return false;
+        token = p->tree.parents[token];
+    }
+    return false;
+}
+
+static uint32_t check_input_member_chain(CheckInputReader* reader, CheckInputBatch* batch, const uint32_t* tokens, const uint32_t* classes, uint32_t first,
+                                         uint32_t end, const CheckInputIdentifiers* ids, uint32_t identifier, const CheckMemberChainOptions* options)
+{
+    const Parser* p = reader->parser;
+    CheckInput* input = reader->output;
+    TypeTable* types = reader->types;
+    const uint32_t base = tokens[first], op = tokens[first + 1];
+    const uint32_t declaration = ids->declarations[identifier];
+    const TypeId base_type = (TypeId)ids->types[identifier];
+    if (op != base + 1 || p->tokens.kinds[op] != PARSE_KIND_ARROW || p->tree.parents[base] != op ||
+        ids->status[identifier] != (BUSTER_CHECK_IDENTIFIER_ACTED | BUSTER_CHECK_IDENTIFIER_NODE) || (ids->types[identifier] >> 32) != CHECK_LVALUE ||
+        ids->flags[identifier] != (((uint64_t)CHECK_CONSTANT_ADDRESS << 32) | BUSTER_CHECK_NONNULL_ADDRESS) || declaration >= input->token_count ||
+        ids->objects[identifier] != (uint64_t)declaration + 1 || input->declaration_kinds[declaration] != C_BINDING_OBJECT ||
+        check_sparse_get(input->declaration_bodies, declaration) >= input->token_count ||
+        check_input_bit(input->declaration_bits, declaration, BUSTER_CHECK_BITS_STATIC | BUSTER_CHECK_BITS_THREAD_LOCAL) ||
+        check_input_attributes_at(input, declaration) != NULL || !type_is_valid(types, base_type) || type_qualifiers(base_type) != 0 ||
+        type_kind(types, base_type) != BUSTER_TYPE_KIND_POINTER || reader->tag_completions == NULL)
+        return 0;
+    uint32_t stop = first + 1, root = base;
+    while (stop < end && check_input_window_code(classes, stop) == CHECK_INPUT_CODE_MEMBER && tokens[stop] == (stop == first + 1 ? base + 1 : root + 2) &&
+           p->tree.parents[root] == tokens[stop] && tokens[stop] + 1 < p->tokens.count && p->tree.roles[tokens[stop] + 1] == PARSE_ROLE_MEMBER)
+    {
+        root = tokens[stop++];
+    }
+    const uint32_t parent = p->tree.parents[root];
+    if (stop - first < 2 || stop - first > 17 || parent >= p->tokens.count ||
+        ((p->tokens.kinds[parent] == PARSE_KIND_ARROW || p->tokens.kinds[parent] == PARSE_KIND_PERIOD) && p->tree.parents[root] == parent) ||
+        !check_input_chain_context(reader, parent))
+        return 0;
+    CheckInputWindowRow rows[1 + 3 * 16];
+    check_node_window_member_pointer(rows, (uint32_t)ids->objects[identifier], base);
+    uint32_t count = 1, member = 0;
+    TypeId type = base_type;
+    for (uint32_t a = first + 1; a < stop; a += 1)
+    {
+        const uint32_t t = tokens[a];
+        const bool arrow = p->tokens.kinds[t] == PARSE_KIND_ARROW;
+        if (arrow && type_kind(types, type) != BUSTER_TYPE_KIND_POINTER)
+            return 0;
+        const TypeId record = arrow ? type_element(types, type) : type;
+        const uint8_t kind = type_kind(types, record);
+        if ((kind != BUSTER_TYPE_KIND_STRUCT && kind != BUSTER_TYPE_KIND_UNION) || type_qualifiers(record) != 0 || !type_is_complete(types, record))
+            return 0;
+        const uint32_t tag = types->types.index[type_index(record)];
+        if (types->tags.packed[tag] != 0 || types->tags.ms_struct[tag] != 0 || reader->tag_completions[tag] > t)
+            return 0;
+        uint64_t bits = 0;
+        uint32_t quals = 0;
+        const uint32_t name = p->tokens.names[t + 1];
+        member = type_lookup_member(types, record, name, &bits, &quals);
+        if (member == 0 || member == BUSTER_TYPE_MEMBER_UNKNOWN || member - types->tags.member_begin[tag] >= types->tags.member_count[tag] ||
+            types->members.name[member] != name || types->members.flags[member] != 0 || quals != 0 || (bits & 7) != 0 ||
+            check_marked_member(input->marked_members, input->marked_member_count, member) != NULL)
+            return 0;
+        type = types->members.type[member];
+        if (type_qualifiers(type) != 0)
+            return 0;
+        const bool last = a + 1 == stop;
+        const bool load = last || p->tokens.kinds[tokens[a + 1]] == PARSE_KIND_ARROW;
+        if (last && !((type >= BUSTER_TYPE_BOOL && type <= BUSTER_TYPE_ULLONG) || type_kind(types, type) == BUSTER_TYPE_KIND_POINTER))
+            return 0;
+        if (options->mutate_token == t)
+            bits += 8;
+        count += check_node_window_member_step(rows + count, t, type, bits / 8, load, last);
+    }
+    const CheckValue value = {.type = type, .category = CHECK_LVALUE, .flags = BUSTER_CHECK_NONNULL_ADDRESS};
+    const uint32_t node = check_input_window_publish(reader, batch, root, value, rows, count, stop - first);
+    if (node == BUSTER_CHECK_NONE)
+        return 0;
+    input->window_summaries[input->window_count - 1].member = member;
+    check_input_expression_value(reader, root, node);
+    if (options->audit)
+        fprintf(stderr, "source-chain\t%u\t%u\t%u\t%u\t%u\t%u\n", base, root, stop - first - 1, count, node, type);
+    return stop - first;
+}
+
+// Consume an entire postorder span before the base identifier or its selectors
+// allocate ordinary nodes.
+static uint32_t check_input_member_chain_span(CheckInputReader* reader, CheckInputBatch* batch, uint32_t* tokens, uint32_t* classes, uint32_t first,
+                                              uint32_t end, CheckInputIdentifiers* ids, uint32_t* identifier, const CheckMemberChainOptions* options)
+{
+    if (first + 1 >= end || check_input_window_code(classes, first) != CHECK_INPUT_CODE_IDENTIFIER ||
+        check_input_window_code(classes, first + 1) != CHECK_INPUT_CODE_MEMBER)
+        return 0;
+    const uint32_t before = reader->output->graph.count + batch->count;
+    const uint32_t span = check_input_member_chain(reader, batch, tokens, classes, first, end, ids, *identifier, options);
+    if (span != 0)
+    {
+        if (options->poison)
+        {
+            if (reader->output->graph.count + batch->count != before + 1)
+                abort();
+            // The surviving terminal VALUE is the sole handle read by ordinary
+            // enclosing expressions. Destroy the skipped identifier result and all
+            // source action coordinates in this chunk.
+            ids->status[*identifier] = UINT32_MAX;
+            ids->types[*identifier] = UINT64_MAX;
+            ids->flags[*identifier] = UINT64_MAX;
+            ids->objects[*identifier] = UINT64_MAX;
+            ids->declarations[*identifier] = UINT32_MAX;
+            for (uint32_t i = first; i < first + span; i += 1)
+            {
+                tokens[i] = BUSTER_CHECK_NONE;
+                classes[i] = UINT32_MAX;
+            }
+        }
+        *identifier += 1;
+    }
+    return span;
+}
