+// Diagnostic only. The records join actual tracked slices to anonymous resident page extents.
+static __attribute__((unused)) void* arena_audit_slice(void* result, Arena* arena, uint64_t size, const char* file, int line)
+{
+    if (result != NULL && size >= 2048 && getenv("BUSTER_PAGE_OWNER_AUDIT") != NULL)
+    {
+        const char* name = strrchr(file,'/');
+        name = name == NULL ? file : name + 1;
+        struct timespec now;
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        fprintf(stderr, "alloc-site\t%lld.%09ld\t%lx\t%llu\t%lx\t%llu\t%llu\t%llu\t%s\t%d\n",
+                (long long)now.tv_sec, now.tv_nsec, (unsigned long)result, (unsigned long long)size,
+                (unsigned long)arena->base, (unsigned long long)arena->small,
+                (unsigned long long)arena->capacity, (unsigned long long)arena->committed, name, line);
+    }
+    return result;
+}
+static __attribute__((unused)) void* arena_audit_push(Arena* arena, uint64_t size, uint64_t alignment, const char* file, int line)
+{
+    return arena_audit_slice(arena_push(arena,size,alignment),arena,size,file,line);
+}
+static __attribute__((unused)) void* arena_audit_array(Arena* arena, uint64_t count, uint64_t size, uint64_t alignment, const char* file, int line)
+{
+    return arena_audit_slice(arena_push_array(arena,count,size,alignment),arena,count*size,file,line);
+}
+static __attribute__((unused)) Arena arena_audit_tables(ArenaTable* tables, uint32_t count, const char* file, int line)
+{
+    Arena result = arena_reserve_tables(tables,count);
+    if (getenv("BUSTER_PAGE_OWNER_AUDIT") != NULL)
+    {
+        for (uint32_t i=0;i<count;i+=1)
+        {
+            char name[512];
+            snprintf(name,sizeof(name),"%s[table%u]",file,i);
+            arena_audit_slice(tables[i].base,&result,tables[i].bytes,name,line);
+        }
+    }
+    return result;
+}
+#define arena_reserve_tables(t,n) arena_audit_tables((t),(n),__FILE__,__LINE__)
+#define arena_push(a,s,b) arena_audit_push((a),(s),(b),__FILE__,__LINE__)
+#define arena_push_array(a,n,s,b) arena_audit_array((a),(n),(s),(b),__FILE__,__LINE__)
