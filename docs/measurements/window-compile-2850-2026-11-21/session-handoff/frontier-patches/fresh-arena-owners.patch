 // A lap that also charges the resource use since the last mark to `stage`; nothing without a clock.
+
+static void check_clock_page_owners(CheckStage stage)
+{
+    if (getenv("BUSTER_PAGE_OWNER_AUDIT") == NULL) return;
+    const char* name=check_stage_names[stage];
+    if (!(stage == CHECK_STAGE_PREPROCESS || stage == CHECK_STAGE_PARSE || stage == CHECK_STAGE_CHECK_INPUT ||
+          stage == CHECK_STAGE_CHECK_EXPRESSIONS || stage == CHECK_STAGE_CHECK_PROGRAM || stage==CHECK_STAGE_OBJECT_BUILD)) return;
+    FILE* maps=fopen("/proc/self/maps","r");
+    if (maps == NULL) return;
+    const int fd=open("/proc/self/pagemap",O_RDONLY);
+    char line[1024];
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC,&now);
+    fprintf(stderr,"owner-stage\t%lld.%09ld\t%s\tbusy=%d\tsmall=%llu\n",(long long)now.tv_sec,now.tv_nsec,name,(int)arena_pages_busy,(unsigned long long)arena_small_floor);
+    while (fd>=0 && fgets(line,sizeof(line),maps)!=NULL)
+    {
+        unsigned long begin=0,end=0;
+        char perms[8]={0};
+        if (sscanf(line,"%lx-%lx %7s",&begin,&end,perms)!=3 || perms[0]!='r') continue;
+        LaneExitRegion ranges[256];
+        while(begin<end)
+        {
+            LaneExitScan scan = { .size=sizeof(scan), .start=begin, .end=end, .vector=(uintptr_t)ranges,
+                .vector_length=256, .category_mask=BUSTER_LANE_EXIT_PAGE_PRESENT, .return_mask=0x6c };
+            const long rc=syscall(SYS_ioctl,fd,BUSTER_LANE_EXIT_PAGEMAP_SCAN,&scan);
+            if (rc<0) { fprintf(stderr,"owner-ioctl-error\t%s\t%lu\t%d\n",name,begin,errno); break; }
+            for (long i=0;i<rc;i++)
+                fprintf(stderr,"owner-page\t%s\t%lx\t%lx\t%lx\n",name,(unsigned long)ranges[i].start,(unsigned long)ranges[i].end,(unsigned long)ranges[i].categories);
+            if (scan.walk_end<=begin) break;
+            begin=scan.walk_end;
+        }
+    }
+    if (fd>=0) close(fd);
+    fclose(maps);
+}
