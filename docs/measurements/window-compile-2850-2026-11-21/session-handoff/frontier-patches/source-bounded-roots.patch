+}
+static void check_live_control_rows(const char* arm,const CheckProgram* p,uint32_t close,const Tier0Function* f,const Tier0Code* code)
+{
+    fprintf(stderr,"control-native-%s\t%u\t%u\t%u\t",arm,close,f->parameter_count,f->count);
+    for (uint32_t i=0;i<f->count;i+=1)
+    {
+        const uint64_t val=tier0_global_kind(f->kinds[i]) ? check_live_control_symbol(p,f->values[i]) : f->values[i];
+        fprintf(stderr,"%x:%x:%llx,",f->kinds[i],f->classes[i],(unsigned long long)val);
+    }
+    fprintf(stderr,"\t");
+    for(uint32_t c=0;c<f->call_count;c+=1) fprintf(stderr,"%llu:%u,",(unsigned long long)check_live_control_symbol(p,f->call_targets[c]),f->call_argument_counts[c]);
+    fprintf(stderr,"\t%u:%u:%u\t",code->error,code->count,code->branch_count);
+    for(uint32_t r=0;r<code->reference_count;r+=1)
+    {
+        const LinkReference ref=code->references[r];
+        fprintf(stderr,"%u:%u:%u:%llu:%lld,",ref.instruction,ref.field,ref.kind,(unsigned long long)check_live_control_symbol(p,ref.target),(long long)ref.addend);
+    }
+    fprintf(stderr,"\t");
+    X86Instruction* records=malloc((size_t)(code->count+1)*sizeof(*records));
+    uint32_t* offsets=malloc((size_t)(code->count+1)*sizeof(*offsets));
+    uint32_t* ends=malloc(BUSTER_X86_ENCODER_FIXUP_CAPACITY(code->reference_count)*sizeof(*ends));
+    const size_t cap=BUSTER_X86_ENCODER_CAPACITY(code->count);
+    uint8_t* bytes=malloc(cap+1);
+    if (!records || !offsets || !ends || !bytes) abort();
+    memcpy(records,code->records,(size_t)code->count*sizeof(*records));
+    const BranchSizing sizing=size_branches(records,code->count,code->branches,code->targets,code->branch_count,offsets);
+    if (sizing.error!=BRANCH_SIZING_OK) abort();
+    const int64_t n=x86_encode(records,code->count,bytes,cap,0,ends);
+    for (int64_t j=0;j<n;j+=1) fprintf(stderr,"%02x",bytes[j]);
+    fprintf(stderr,"\t");
+    uint32_t ordinal=0;
+    for (uint32_t j=0;j<code->reference_count;j+=1)
+    {
+        const LinkReference ref=code->references[j];
+        const uint32_t distance=x86_fixup_distance(records[ref.instruction].form,ref.field);
+        if (j!=0 && ref.instruction!=code->references[j-1].instruction) ordinal+=1;
+        fprintf(stderr,"%u:%u:%llu:%lld,",ends[ordinal]-distance,ref.kind,(unsigned long long)check_live_control_symbol(p,ref.target),
+                (long long)(ref.addend-(link_fixup_kinds[ref.kind].pc_relative?distance:0)));
+    }
+    fprintf(stderr,"\n");
+    free(records); free(offsets); free(ends); free(bytes);
+}
+// Freeze function-scope static objects before their checked nodes retire. The ordinary
+// unit data writer later resolves each source object to its final symbol and section.
+static bool check_live_static_objects(CheckSourceControlUnit* unit, const CheckProgram* p,
+                                      Arena* output, Arena* scratch, CheckInputLiteralTable** first)
+{
+    CheckInputLiteralTable** tail = first;
+    const CheckInitializers* plans = p->initializers;
+    const CheckInput* in = p->input;
+    for (uint32_t i = 0; plans != NULL && i < plans->count; i += 1)
+    {
+        const uint32_t token = plans->declaration_tokens[i];
+        if (!check_input_bit(in->declaration_bits, token, BUSTER_CHECK_BITS_STATIC)) continue;
+        const CheckInputLiteralTable* existing = unit->persistent->literal_tables;
+        while (existing != NULL && existing->declaration < token) existing = existing->next;
+        if (existing != NULL && existing->declaration == token) continue;
+        const CheckInitializer* init = &plans->plans[i];
+        if (init->status != CHECK_INIT_OK || init->label_differences) return false;
+        const uint64_t temporary = scratch->length;
+        CheckDataObject object = { .object = in->objects[token], .type = in->declared_types[token], .token = token,
+                                   .initializer = BUSTER_CHECK_NONE, .initializer_plan = init };
+        CheckDataPlan data;
+        // The canonical planner owns payload bytes in output. Its ordered address records
+        // live in scratch until copied into the retained, symbol-independent image.
+        if (check_data_plan_object(p->types, p->stream, &object, NULL, p->object_count, NULL,
+                                   output, scratch, NULL, &data) != CHECK_DATA_OK) return false;
+        CheckInputLiteralTable* row = BUSTER_ARENA_PUSH_ARRAY(output, CheckInputLiteralTable, 1);
+        CheckPreparedInitializer* image = BUSTER_ARENA_PUSH_ARRAY(output, CheckPreparedInitializer, 1);
+        CheckPreparedAddress* fields = data.fixup_count == 0 ? NULL : BUSTER_ARENA_PUSH_ARRAY(output, CheckPreparedAddress, data.fixup_count);
+        if (row == NULL || image == NULL || (data.fixup_count != 0 && fields == NULL)) return false;
+        // check_data_payload can place a temporary image in scratch when the object arena is too small.
+        uint8_t* payload = data.bytes;
+        if (payload == NULL || (uintptr_t)payload - (uintptr_t)output->base >= output->length)
+        {
+            payload = BUSTER_ARENA_PUSH_ARRAY(output, uint8_t, data.size != 0 ? data.size : 1);
+            if (payload == NULL) return false;
+            if (data.bytes != NULL) memcpy(payload, data.bytes, data.size);
+            else memset(payload, 0, data.size);
+        }
+        for (uint32_t j = 0; j < data.fixup_count; j += 1)
+        {
+            const CheckDataFixup* fix = data.fixups + j;
+            fields[j] = (CheckPreparedAddress){ .offset = fix->offset, .object = fix->object, .addend = fix->addend };
+        }
+        *image = (CheckPreparedInitializer){ .bytes = payload, .addresses = fields, .address_count = data.fixup_count };
+        *row = (CheckInputLiteralTable){ .declaration = token, .plan = { .type = init->type,
+                                         .object_size = data.size, .prepared = image, .failed_token = BUSTER_CHECK_NONE,
+                                         .warning_token = BUSTER_CHECK_NONE } };
+        *tail = row;
+        tail = &row->next;
+        arena_pop_to(scratch, temporary);
+    }
+    return true;
+}
