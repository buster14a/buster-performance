+
+typedef struct CheckReturnValue
+{
+    TypeId type;
+    uint64_t constant;
+    bool literal;
+    bool readonly;
+    uint8_t parameter;
+    uint8_t loads;
+    uint8_t extension;
+    uint8_t widths[4];
+    int32_t offsets[4];
