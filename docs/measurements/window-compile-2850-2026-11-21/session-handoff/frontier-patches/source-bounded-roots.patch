+#include "c_check_native_return.c"
+
+// An expression class can remain at a delimiter even when none of its children creates a
+// value. With every producing action owned by a source statement, these classes have no
+// value to propagate, discard or publish. All other classes keep the ordinary reader.
+static uint32_t check_source_root_body_remaining(const CheckInputReader* reader, uint32_t opening, uint32_t closing, uint32_t limit)
+{
+    const uint32_t harmless = (1u << CHECK_INPUT_CODE_LIST) | (1u << CHECK_INPUT_CODE_DROP) |
+                              (1u << CHECK_INPUT_CODE_SEPARATOR) | (1u << CHECK_INPUT_CODE_GROUP) |
+                              (1u << CHECK_INPUT_CODE_TERMINATOR);
+    uint32_t remaining = 0;
+    for (uint32_t t = opening; t <= closing; t += 1)
+    {
+        const uint8_t action = reader->visits[t];
+        if (action == 0)
+            continue;
+        const uint32_t code = (action & BUSTER_CHECK_EXPRESSION_CODE_MASK) >> BUSTER_CHECK_EXPRESSION_CODE_SHIFT;
+        if ((action & BUSTER_CHECK_EXPRESSION_SPARSE) || (harmless & (1u << code)) == 0)
+            if (++remaining > limit) return remaining;
+    }
+    return remaining;
+}
+
+// Optional native census for the remaining producing classes of every physical function.
+static void check_source_root_body_residuals(const CheckInputReader* reader, uint32_t open, uint32_t close)
+{
+    uint32_t counts[BUSTER_CHECK_EXPRESSION_CODES] = {0};
+    for (uint32_t t = open; t <= close; t += 1)
+    {
+        const uint8_t action = reader->visits[t];
+        if (action)
+            counts[(action & BUSTER_CHECK_EXPRESSION_CODE_MASK) >> BUSTER_CHECK_EXPRESSION_CODE_SHIFT] += 1;
+    }
+    fprintf(stderr, "source-root-residual\t%u\t%u", open, close);
+    for (uint32_t code = 0; code < BUSTER_CHECK_EXPRESSION_CODES; code += 1)
+        if (counts[code]) fprintf(stderr, "\t%s=%u", check_input_expression_code_names[code], counts[code]);
+    fputc('\n', stderr);
+}
+
+// A selected function's graph is discarded immediately. References in the four shared
+// token columns belong to the unit reader, including when native qualification declines.
+static bool check_source_emit_partial_body(CheckSourceControlUnit* unit, CheckInputReader* reader, uint32_t open, uint32_t close,
+                                           Arena* graph, Arena* checked, Arena* scratch, uint32_t* made)
+{
+    const uint32_t last = reader->postorder_positions[close];
+    const uint32_t size = reader->subtree_sizes[last];
+    if (size == 0 || size > last + 1)
+        return false;
+    const uint32_t start = last + 1 - size;
+    uint32_t lo = open, hi = close;
+    for (uint32_t i = start; i <= last; i += 1)
+    {
+        const uint32_t t = reader->postorder[i];
+        if (t < lo) lo = t;
+        if (t > hi) hi = t;
+    }
+    const uint32_t length = hi - lo + 1;
+    uint32_t* save = BUSTER_ARENA_PUSH_ARRAY(graph, uint32_t, (uint64_t)length * 4);
+    if (save == NULL) return false;
+    uint32_t* columns[] = {reader->output->token_nodes, reader->first_value, reader->last_value, reader->value_counts};
+    for (uint32_t i = 0; i < 4; i += 1)
+        memcpy(save + (uint64_t)i * length, columns[i] + lo, (size_t)length * sizeof(*save));
+    const bool produced = check_body_source_one(reader, start, last + 1, close, graph, checked, scratch, made, unit, false);
+    for (uint32_t i = 0; i < 4; i += 1)
+        memcpy(columns[i] + lo, save + (uint64_t)i * length, (size_t)length * sizeof(*save));
+    return produced && check_input_source_body(reader->output->source_bodies, open) != NULL;
+}
+
+// Qualification probe. Native-only publication leaves no requirement for the source
+// operator rows of this function. Overwrite both the operand tapes and the row headers.
+static void check_source_poison_body_programs(CheckInput* input, uint32_t open, uint32_t close)
+{
+    const CheckSourceBody* body = check_input_source_body(input->source_bodies, open);
+    if (body == NULL || body->encoded == NULL || body->function != NULL)
+        return;
+    uint32_t poisoned = 0;
+    for (uint32_t token = check_sparse_next(input->source_statement_tokens, open, close); token < close;
+         token = check_sparse_next(input->source_statement_tokens, token + 1, close))
+    {
+        const uint32_t slot = check_sparse_get(input->source_statement_tokens, token);
+        if (slot >= input->source_statement_count)
+            continue;
+        CheckSourceStatement* root = input->source_statements + slot;
+        if (root->operator_count)
+            memset((void*)root->operators, 0xda, (size_t)root->operator_count * sizeof(*root->operators));
+        memset(root, 0, sizeof(*root));
+        poisoned += 1;
+    }
+    fprintf(stderr, "source-root-poison\t%u\t%u\n", close, poisoned);
+}
+
+static uint32_t check_source_emit_root_bodies(CheckInputReader* reader, CheckSourceControlUnit* unit, Arena* graph, Arena* checked, Arena* scratch)
+{
+    CheckInput* input = reader->output;
+    const Parser* parser = reader->parser;
+    const uint32_t count = parser->tokens.count;
+    const bool audit = getenv("BUSTER_CONTROL_SOURCE_AUDIT") != NULL;
+    uint32_t selected = 0;
+    const char* budget = getenv("BUSTER_SOURCE_ROOT_BUDGET");
+    const uint32_t max_actions = budget ? (uint32_t)strtoul(budget, NULL, 10) : 0;
+    const bool census = getenv("BUSTER_SOURCE_ROOT_CENSUS") != NULL;
+    const bool linear = getenv("BUSTER_SOURCE_LINEAR_BODIES") != NULL;
+    const bool poison = getenv("BUSTER_DROP_SAVED_SOURCE_ROWS") != NULL;
+    // Source rows resolve their own objects, conversions, direct call prototypes and member
+    // offsets. The control builder only receives a graph with no nodes. A rejected native
+    // fragment leaves every expression class in place for the unit's ordinary fallback.
+    CheckInput local_input = *input;
+    local_input.graph = (CheckGraph){0};
+    CheckInputReader local_reader = *reader;
+    local_reader.output = &local_input;
+    CheckStream stream = {.failed_node = BUSTER_CHECK_NONE};
+    for (uint32_t open = check_sparse_next(input->body_declarations, 0, count); open < count;
+         open = check_sparse_next(input->body_declarations, open + 1, count))
+    {
+        const uint32_t close = parser->tree.parents[open];
+        if (close <= open || close >= count || parser->tree.roles[close] != PARSE_ROLE_CLOSE_BODY)
+            continue;
+        if (census) check_source_root_body_residuals(reader, open, close);
+        if (!input->source_statement_count || check_sparse_next(input->source_statement_tokens, open, close) >= close)
+            continue;
+        const uint32_t remaining = check_source_root_body_remaining(reader, open, close, max_actions);
+        if (remaining > max_actions) continue;
+        // A parameter bound can live outside the braces and refer to a node of the unit's graph.
+        bool parameters = false;
+        for (uint32_t i = 0; i < input->vla_count && !parameters; i += 1)
+            parameters = input->vlas[i].body == open;
+        for (uint32_t r = 0; remaining && !parameters && r < input->region_count; r += 1)
+            parameters = input->regions[r].opening - open < close - open;
+        if (parameters)
+            continue;
+        if (remaining)
+        {
+            uint32_t made = 0;
+            if (check_source_emit_partial_body(unit, reader, open, close, graph, checked, scratch, &made))
+            {
+                memset(reader->visits + open, 0, close - open + 1);
+                selected += 1;
+                if (poison) check_source_poison_body_programs(input, open, close);
+                if (audit) fprintf(stderr, "source-partial-body\t%u\t%u\t%u\t%u\n", open, close, remaining, made);
+            }
+            arena_pop_to(graph, 0); arena_pop_to(checked, 0); arena_pop_to(scratch, 0);
+            continue;
+        }
+        const bool direct = linear && check_source_linear_native(unit, &local_reader, &stream, open, close, scratch);
+        if (!direct) check_source_control_function(unit, &local_reader, &stream, close, checked, scratch);
+        if (direct && audit) fprintf(stderr, "source-linear-body\t%u\t%u\n", open, close);
+        const CheckSourceBody* body = check_input_source_body(input->source_bodies, open);
+        if (body != NULL)
+        {
+            memset(reader->visits + open, 0, close - open + 1);
+            selected += 1;
+            if (poison) check_source_poison_body_programs(input, open, close);
+            if (audit)
+                fprintf(stderr, "source-root-body\t%u\t%u\t%u\t%u\n", open, close, body->encoded != NULL, body->function != NULL);
+        }
+        arena_pop_to(checked, 0);
+        arena_pop_to(scratch, 0);
+    }
+    return selected;
+}
