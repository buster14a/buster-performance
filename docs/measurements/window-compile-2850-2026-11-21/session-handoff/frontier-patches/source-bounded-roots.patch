+        // readers. A local graph borrows them, emits its ordinary control, and can then retire.
+        if (!check_source_requires_rows && reader->pp->options.collect_diagnostics &&
+            getenv("BUSTER_COMPOSE_SOURCE_STATEMENTS") != NULL && getenv("BUSTER_CONTROL_SOURCE_NATIVE") != NULL)
+            check_control_source_native(reader);
+        else
+            check_input_expressions_coded_range(reader, 0, count);
+        return true;
+    }
+    // A byte belongs to the physical source token even when postorder interleaves a header and its body.
+    // Clearing an admitted body's class suppresses only that body during the normal, contiguous chunk walk.
+    for (uint32_t open = check_sparse_next(in->body_declarations, 0, count); open < count;
+         open = check_sparse_next(in->body_declarations, open + 1, count))
+    {
+        const uint32_t close = p->tree.parents[open];
+        if (close > open + 1 && close < count && close - open <= 75 && check_native_return(reader, open, close))
+            memset(reader->visits + open, 0, (size_t)(close - open) + 1);
+    }
+    check_input_expressions_coded_range(reader, 0, count);
+    return true;
+}
