+    uint64_t* values=BUSTER_ARENA_PUSH_ARRAY(output,uint64_t,(uint64_t)function->count+1);
+    SymbolId* targets=BUSTER_ARENA_PUSH_ARRAY(output,SymbolId,(uint64_t)function->call_count+1);
+    if(values==NULL || targets==NULL) return false;
+    const SymbolId copy=check_source_runtime_target(saved,program,writer,function->hidden_copy);
+    if(function->hidden_copy!=0 && copy==0) return false;
+    function->hidden_copy=copy;
+    for(uint32_t i=0;i<function->count;i+=1)
+    {
+        uint64_t value=function->values[i];
+        if(tier0_global_kind(function->kinds[i]))
+        {
+            const uint64_t table=value-saved->table_symbol;
