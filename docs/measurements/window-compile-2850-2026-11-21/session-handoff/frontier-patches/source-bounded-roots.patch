+
+static bool check_return_publish(CheckInputReader*, uint32_t, uint32_t, const CheckReturnBytes*);
+
+static uint32_t check_return_width(const TypeTable* types, TypeId type)
+{
+    if ((type_qualifiers(type) & ~(uint32_t)BUSTER_TYPE_CONST) != 0)
+        return 0;
+    type = type_unqualified(type);
+    if (type_kind(types, type) == BUSTER_TYPE_KIND_POINTER)
+        return 8;
+    if (type == BUSTER_TYPE_INT || type == BUSTER_TYPE_UINT)
+        return 4;
+    return type == BUSTER_TYPE_LONG || type == BUSTER_TYPE_ULONG || type == BUSTER_TYPE_LLONG || type == BUSTER_TYPE_ULLONG ? 8 : 0;
+}
+
+static uint8_t check_return_extension(const TypeTable* types, TypeId type)
+{
+    if ((type_qualifiers(type) & ~(uint32_t)BUSTER_TYPE_CONST) != 0)
+        return 0;
+    type = type_unqualified(type);
+    if (type == BUSTER_TYPE_CHAR)
+        return types->char_unsigned ? 0xb6 : 0xbe;
+    if (type == BUSTER_TYPE_SCHAR)
+        return 0xbe;
+    if (type == BUSTER_TYPE_UCHAR)
+        return 0xb6;
+    if (type == BUSTER_TYPE_SHORT)
+        return 0xbf;
+    return type == BUSTER_TYPE_USHORT ? 0xb7 : 0;
+}
+
+static bool check_return_value(CheckInputReader* reader, uint32_t open, uint32_t* cursor, uint32_t end, CheckReturnValue* out)
+{
+    const Parser* p = reader->parser;
+    const CheckInput* in = reader->output;
+    const TypeTable* types = reader->types;
+    uint32_t t = *cursor;
+    if (t >= end)
+        return false;
+    if (p->tokens.kinds[t] == PARSE_KIND_MINUS || p->tokens.kinds[t] == PARSE_KIND_NUMBER)
+    {
+        const bool minus = p->tokens.kinds[t] == PARSE_KIND_MINUS;
+        t += minus;
+        if (t >= end || p->tokens.kinds[t] != PARSE_KIND_NUMBER)
+            return false;
+        const uint8_t* bytes;
+        uint32_t length;
+        if (!check_input_spelling(reader, t, &bytes, &length) || length == 0 || length > 10 || (length > 1 && bytes[0] == '0'))
+            return false;
+        uint64_t v = 0;
+        for (uint32_t k = 0; k < length; k += 1)
+        {
+            if (bytes[k] < '0' || bytes[k] > '9')
+                return false;
+            v = v * 10 + (bytes[k] - '0');
+        }
+        if (v > INT32_MAX)
+            return false;
+        *out = (CheckReturnValue){.type = BUSTER_TYPE_INT, .literal = true, .constant = minus ? 0 - v : v};
+        *cursor = t + 1;
+        return true;
+    }
+    if (p->tokens.kinds[t] != PARSE_KIND_IDENTIFIER || p->tree.roles[t] != PARSE_ROLE_OPERAND)
+        return false;
+    uint32_t param = check_sparse_get(in->parameters, open);
+    while (param != BUSTER_CHECK_NONE && p->tokens.names[param] != p->tokens.names[t])
+        param = check_sparse_get(in->parameter_next, param);
+    if (param == BUSTER_CHECK_NONE || in->declarations[t] != param)
+        return false;
+    const uint32_t n = check_sparse_get(in->parameters, param);
+    if (n >= 6)
+        return false;
+    *out = (CheckReturnValue){.type = in->declared_types[param], .parameter = (uint8_t)n};
+    t += 1;
+    while (t + 1 < end && p->tokens.kinds[t] == PARSE_KIND_ARROW && p->tokens.kinds[t + 1] == PARSE_KIND_IDENTIFIER)
+    {
+        if (in->noderef_member_count || in->noderef_declaration_count || out->loads == 4 ||
+            type_kind(types, out->type) != BUSTER_TYPE_KIND_POINTER || !check_return_width(types, out->type))
+            return false;
+        TypeId record = type_element(types, out->type);
+        const CheckContext where = {
+            .tag_completions = reader->tag_completions, .tag_completion_count = types->tags.count, .source_position = t};
+        if ((type_qualifiers(record) & ~(uint32_t)BUSTER_TYPE_CONST) != 0 || type_kind(types, record) != BUSTER_TYPE_KIND_STRUCT ||
+            !check_context_source_complete(types, record, &where))
+            return false;
+        uint64_t offset = 0;
+        uint32_t quals = 0;
+        const uint32_t member = type_lookup_member(types, record, p->tokens.names[t + 1], &offset, &quals);
+        if (member == 0 || member >= types->members.count ||
+            (in->marked_member_count != 0 && check_marked_member(in->marked_members, in->marked_member_count, member) != NULL) ||
+            (offset & 7) != 0 || offset / 8 > INT32_MAX || (quals & ~(uint32_t)BUSTER_TYPE_CONST) != 0 ||
+            (types->members.flags[member] & BUSTER_TYPE_MEMBER_BIT_FIELD) != 0)
+            return false;
+        out->type = types->members.type[member];
+        out->readonly |= ((type_qualifiers(record) | type_qualifiers(out->type) | quals) & BUSTER_TYPE_CONST) != 0;
+        const uint32_t width = check_return_width(types, out->type);
+        out->extension = check_return_extension(types, out->type);
+        if (!width && !out->extension)
+            return false;
+        out->offsets[out->loads] = (int32_t)(offset / 8);
+        out->widths[out->loads++] = (uint8_t)width;
+        t += 2;
+    }
+    *cursor = t;
+    return check_return_width(types, out->type) != 0 || out->extension != 0;
+}
+
+static void check_return_word(CheckReturnBytes* code, uint32_t value)
+{
+    memcpy(code->bytes + code->count, &value, 4);
+    code->count += 4;
+}
+
+static void check_return_reg(CheckReturnBytes* code, uint32_t width, uint8_t opcode, uint8_t dst, uint8_t src)
+{
+    const uint8_t rex = (uint8_t)(0x40 | (width == 8 ? 8 : 0) | (dst >= 8 ? 4 : 0) | (src >= 8 ? 1 : 0));
+    if (rex != 0x40)
+        code->bytes[code->count++] = rex;
+    code->bytes[code->count++] = opcode;
+    code->bytes[code->count++] = (uint8_t)(0xc0 | ((dst & 7) << 3) | (src & 7));
+}
+
+static void check_return_load(CheckReturnBytes* code, const CheckReturnValue* v, uint32_t width)
+{
+    if (v->literal)
+    {
+        if (v->constant == 0)
+        {
+            code->bytes[code->count++] = 0x31;
+            code->bytes[code->count++] = 0xc0;
+        }
+        else
+        {
+            if (width == 8 && v->constant > UINT32_MAX)
+            {
+                code->bytes[code->count++] = 0x48;
+                code->bytes[code->count++] = 0xc7;
+                code->bytes[code->count++] = 0xc0;
+            }
+            else
+                code->bytes[code->count++] = 0xb8;
+            check_return_word(code, (uint32_t)v->constant);
+        }
+        return;
+    }
+    check_return_reg(code, v->loads ? 8 : width, 0x8b, 0, check_return_registers[v->parameter]);
+    for (uint32_t i = 0; i < v->loads; i += 1)
+    {
+        if (v->widths[i] == 8)
+            code->bytes[code->count++] = 0x48;
+        if (v->widths[i] == 0 && v->extension)
+        {
+            code->bytes[code->count++] = 0x0f;
+            code->bytes[code->count++] = v->extension;
+        }
+        else
+            code->bytes[code->count++] = 0x8b;
+        const int32_t offset = v->offsets[i];
+        code->bytes[code->count++] = offset == 0 ? 0 : offset <= 127 ? 0x40 : 0x80;
+        if (offset > 127)
+            check_return_word(code, (uint32_t)offset);
+        else if (offset != 0)
+            code->bytes[code->count++] = (uint8_t)offset;
+    }
+}
+
+static bool check_return_store(CheckInputReader* reader, uint32_t open, uint32_t* cursor, uint32_t end, CheckReturnBytes* code)
+{
+    CheckReturnValue address = {0}, value = {0};
+    uint32_t t = *cursor;
+    if (!check_return_value(reader, open, &t, end, &address) || address.loads != 1 || address.extension || address.readonly ||
+        address.offsets[0] > 127 || t >= end || reader->parser->tokens.kinds[t++] != PARSE_KIND_EQUAL ||
+        !check_return_value(reader, open, &t, end, &value) || t >= end || reader->parser->tokens.kinds[t++] != PARSE_KIND_SEMI ||
+        value.loads != 0)
+        return false;
+    const uint32_t width = address.widths[0];
+    if (value.literal
+            ? value.constant > INT32_MAX || (type_kind(reader->types, address.type) == BUSTER_TYPE_KIND_POINTER && value.constant != 0)
+            : type_unqualified(value.type) != type_unqualified(address.type))
+        return false;
+    check_return_reg(code, 8, 0x8b, 0, check_return_registers[address.parameter]);
+    if (address.offsets[0] != 0)
+    {
+        code->bytes[code->count++] = 0x48;
+        code->bytes[code->count++] = 0x83;
+        code->bytes[code->count++] = 0xc0;
+        code->bytes[code->count++] = (uint8_t)address.offsets[0];
+    }
+    if (value.literal)
+    {
+        if (value.constant == 0)
+        {
+            code->bytes[code->count++] = 0x31;
+            code->bytes[code->count++] = 0xc9;
+        }
+        else
+        {
+            code->bytes[code->count++] = 0xb9;
+            check_return_word(code, (uint32_t)value.constant);
+        }
+    }
+    else
+        check_return_reg(code, width, 0x8b, 1, check_return_registers[value.parameter]);
+    if (width == 8)
+        code->bytes[code->count++] = 0x48;
+    code->bytes[code->count++] = 0x89;
+    code->bytes[code->count++] = 0x08;
+    check_return_reg(code, 8, 0x8b, 0, 1);
+    *cursor = t;
+    return true;
+}
+
+static bool check_return_expression(CheckInputReader* reader, uint32_t open, uint32_t* cursor, uint32_t end, TypeId result,
+                                    CheckReturnBytes* code, CheckReturnValue* a)
+{
+    const Parser* p = reader->parser;
+    const TypeTable* types = reader->types;
+    uint32_t t = *cursor;
+    const bool negated = t < end && p->tokens.kinds[t] == PARSE_KIND_EXCLAIM;
+    t += negated;
+    if (!check_return_value(reader, open, &t, end, a))
+        return false;
+    const TypeId type = type_unqualified(a->type);
+    const uint32_t width = check_return_width(types, type);
+    if (a->extension)
+    {
+        if (t != end || negated || (result != type && result != BUSTER_TYPE_INT && result != BUSTER_TYPE_UINT))
+            return false;
+        check_return_load(code, a, 4);
+        code->bytes[code->count++] = 0x0f;
+        code->bytes[code->count++] = a->extension;
+        code->bytes[code->count++] = 0xc0;
+        *cursor = t;
+        return true;
+    }
+    if (check_return_extension(types, result))
+        return false;
+    if (t == end && !negated)
+    {
+        if (!a->literal && type != result)
+            return false;
+        if (a->literal &&
+            (type_kind(types, result) == BUSTER_TYPE_KIND_POINTER
+                 ? a->constant != 0
+                 : a->constant > INT32_MAX && result != BUSTER_TYPE_LONG && result != BUSTER_TYPE_LLONG && result != BUSTER_TYPE_INT))
+            return false;
+        check_return_load(code, a, check_return_width(types, result));
+        *cursor = t;
+        return true;
+    }
+    if (a->literal)
+        return false;
+    const uint8_t op = negated ? PARSE_KIND_EQUALEQUAL : p->tokens.kinds[t++];
+    CheckReturnValue b = {.literal = true};
+    if (!negated && !check_return_value(reader, open, &t, end, &b))
+        return false;
+    if (t != end || b.loads || (!b.literal && type_unqualified(b.type) != type))
+        return false;
+    const bool compare = op == PARSE_KIND_EQUALEQUAL || op == PARSE_KIND_EXCLAIMEQUAL;
+    if (compare)
+    {
+        if (result != BUSTER_TYPE_INT || (b.literal && b.constant != 0))
+            return false;
+        uint8_t reg = check_return_registers[a->parameter];
+        if (a->loads)
+        {
+            check_return_load(code, a, width);
+            reg = 0;
+        }
+        if (b.literal)
+            check_return_reg(code, width, 0x85, reg, reg);
+        else
+            check_return_reg(code, width, 0x3b, reg, check_return_registers[b.parameter]);
+        code->bytes[code->count++] = 0x0f;
+        code->bytes[code->count++] = op == PARSE_KIND_EQUALEQUAL ? 0x94 : 0x95;
+        code->bytes[code->count++] = 0xc0;
+        code->bytes[code->count++] = 0x0f;
+        code->bytes[code->count++] = 0xb6;
+        code->bytes[code->count++] = 0xc0;
+    }
+    else
+    {
+        const uint8_t opcode = op == PARSE_KIND_PLUS    ? 0x03
+                               : op == PARSE_KIND_MINUS ? 0x2b
+                               : op == PARSE_KIND_AMP   ? 0x23
+                               : op == PARSE_KIND_PIPE  ? 0x0b
+                               : op == PARSE_KIND_CARET ? 0x33
+                                                        : 0;
+        if (!opcode || result != type || type_kind(types, type) != BUSTER_TYPE_KIND_INTEGER)
+            return false;
+        check_return_load(code, a, width);
+        if (b.literal)
+        {
+            if (!b.constant || b.constant > 127)
+                return false;
+            if (width == 8)
+                code->bytes[code->count++] = 0x48;
+            if ((op == PARSE_KIND_PLUS || op == PARSE_KIND_MINUS) && b.constant == 1)
+            {
+                code->bytes[code->count++] = 0xff;
+                code->bytes[code->count++] = op == PARSE_KIND_PLUS ? 0xc0 : 0xc8;
+            }
+            else
+            {
+                const uint8_t sub = op == PARSE_KIND_PLUS    ? 0
+                                    : op == PARSE_KIND_MINUS ? 5
+                                    : op == PARSE_KIND_AMP   ? 4
+                                    : op == PARSE_KIND_PIPE  ? 1
+                                                             : 6;
+                code->bytes[code->count++] = 0x83;
+                code->bytes[code->count++] = (uint8_t)(0xc0 | (sub << 3));
+                code->bytes[code->count++] = (uint8_t)b.constant;
+            }
+        }
+        else
+            check_return_reg(code, width, opcode, 0, check_return_registers[b.parameter]);
+    }
+    *cursor = t;
+    return true;
+}
+
+static void check_return_stack(CheckReturnBytes* code, uint8_t bytes, uint8_t opcode, uint8_t reg, uint8_t offset)
+{
+    if (bytes == 8)
+        code->bytes[code->count++] = 0x48;
+    code->bytes[code->count++] = opcode;
+    code->bytes[code->count++] = (uint8_t)((reg << 3) | 4 | (offset ? 0x40 : 0));
+    code->bytes[code->count++] = 0x24;
+    if (offset)
+        code->bytes[code->count++] = offset;
+}
+
+static void check_return_arg(CheckReturnBytes* code, const CheckReturnValue* v, uint8_t dst, uint8_t width)
+{
+    if (v->literal)
+    {
+        if (v->constant == 0)
+            check_return_reg(code, 4, 0x31, dst, dst);
+        else
+        {
+            code->bytes[code->count++] = (uint8_t)(0xb8 + dst);
+            check_return_word(code, (uint32_t)v->constant);
+        }
+        return;
+    }
+    check_return_stack(code, v->loads ? 8 : width, 0x8b, dst, (uint8_t)(v->parameter * 8));
+    for (uint32_t i = 0; i < v->loads; i += 1)
+    {
+        if (v->widths[i] == 8)
+            code->bytes[code->count++] = 0x48;
+        code->bytes[code->count++] = 0x8b;
+        const int32_t offset = v->offsets[i];
+        code->bytes[code->count++] = (uint8_t)((dst << 3) | dst | (offset == 0 ? 0 : offset <= 127 ? 0x40 : 0x80));
+        if (offset > 127)
+            check_return_word(code, (uint32_t)offset);
+        else if (offset != 0)
+            code->bytes[code->count++] = (uint8_t)offset;
+    }
+}
+
+static bool check_return_wrapper(CheckInputReader* reader, uint32_t open, uint32_t first, uint32_t end, uint32_t parameters,
+                                 const TypeId* own, TypeId result, CheckReturnBytes* code)
+{
+    const Parser* p = reader->parser;
+    const CheckInput* in = reader->output;
+    const TypeTable* types = reader->types;
+    uint32_t t = first;
+    const bool returned = t < end && p->tokens.kinds[t] == PARSE_KIND_RETURN;
+    t += returned;
+    if (parameters > 3 || end < t + 3 || (!returned && result != BUSTER_TYPE_VOID) || p->tree.roles[t] != PARSE_ROLE_OPERAND ||
+        p->tokens.kinds[t] != PARSE_KIND_IDENTIFIER || p->tree.roles[t + 1] != PARSE_ROLE_OPEN_CALL || p->tree.parents[t + 1] != end - 1 ||
+        p->tree.roles[end - 1] != PARSE_ROLE_CLOSE_CALL)
+        return false;
+    const uint32_t decl = in->declarations[t];
+    if (decl >= in->token_count || in->declaration_kinds[decl] != C_BINDING_FUNCTION || in->objects[decl] == 0 ||
+        in->objects[decl] > in->token_count || check_input_attributes_at(in, decl) != NULL ||
+        check_input_attributes_at(in, in->objects[decl] - 1) != NULL || check_input_builtin_named(reader, p->tokens.names[t]) ||
+        check_input_library_call(reader, t) != 0 || check_input_builtin_id(reader, t) != 0 ||
+        (reader->late_attribute_masks != NULL && reader->late_attribute_masks[in->objects[decl]] != 0))
+        return false;
+    const uint32_t flags = in->function_flags == NULL ? 0 : in->function_flags[decl];
+    if (flags & (CHECK_INPUT_FUNCTION_INLINE | CHECK_INPUT_FUNCTION_NAKED | CHECK_INPUT_FUNCTION_KR | CHECK_INPUT_FUNCTION_NORETURN |
+                 CHECK_INPUT_FUNCTION_IMPLICIT | CHECK_INPUT_FUNCTION_IMPLICIT_LIBRARY))
+        return false;
+    const TypeId function = in->declared_types[decl];
+    if (type_kind(types, function) != BUSTER_TYPE_KIND_FUNCTION || type_function_abi_kind(types, function) != TYPE_FUNCTION_ABI_SYSV ||
+        type_function_keeps_registers(types, function) || type_function_has_parameter_abis(types, function) ||
+        (types->types.flags[type_index(function)] & (BUSTER_TYPE_FLAG_VARIADIC | BUSTER_TYPE_FLAG_PROTOTYPE)) !=
+            BUSTER_TYPE_FLAG_PROTOTYPE ||
+        type_unqualified(type_return(types, function)) != result)
+        return false;
+    uint32_t n = 0;
+    const TypeId* args = type_parameters(types, function, &n);
+    if (n > 3)
+        return false;
+    CheckReturnValue values[3] = {0};
+    uint8_t widths[3] = {0}, used = 0;
+    t += 2;
+    for (uint32_t a = 0; a < n; a += 1)
+    {
+        if (a && (t >= end - 1 || p->tokens.kinds[t++] != PARSE_KIND_COMMA))
+            return false;
+        widths[a] = (uint8_t)check_return_width(types, args[a]);
+        if (!widths[a] || !check_return_value(reader, open, &t, end - 1, values + a) || values[a].extension)
+            return false;
+        if (values[a].literal)
+        {
+            if (values[a].constant > INT32_MAX || (type_kind(types, args[a]) == BUSTER_TYPE_KIND_POINTER && values[a].constant != 0))
+                return false;
+        }
+        else
+        {
+            if (type_unqualified(values[a].type) != type_unqualified(args[a]) || values[a].parameter >= parameters)
+                return false;
+            if ((used & (1u << values[a].parameter)) != 0)
+                return false;
+            used |= (uint8_t)(1u << values[a].parameter);
+        }
+    }
+    if (t != end - 1)
+        return false;
+    code->callee = in->objects[decl];
+    code->frame = __builtin_popcount(used) < 2 ? 8 : 24;
+    const uint8_t adjust[] = {0x48, 0x83, 0xec, code->frame};
+    memcpy(code->bytes + code->count, adjust, sizeof(adjust));
+    code->count += sizeof(adjust);
+    uint8_t slot = 0;
+    for (uint32_t i = 0; i < parameters; i += 1)
+    {
+        if ((used & (1u << i)) == 0)
+            continue;
+        check_return_stack(code, (uint8_t)check_return_width(types, own[i]), 0x89, check_return_registers[i], slot);
+        slot += 8;
+    }
+    for (uint32_t i = 0; i < n; i += 1)
+    {
+        if (!values[i].literal)
+            values[i].parameter = (uint8_t)__builtin_popcount(used & ((1u << values[i].parameter) - 1));
+        check_return_arg(code, values + i, (uint8_t)i, widths[i]);
+    }
+    for (uint32_t i = n; i--;)
+        if (check_return_registers[i] != i)
+            check_return_reg(code, 8, 0x8b, check_return_registers[i], (uint8_t)i);
+    code->bytes[code->count++] = 0xe8;
+    code->field = (uint16_t)code->count;
+    check_return_word(code, 0);
+    code->bytes[code->count++] = 0x48;
+    code->bytes[code->count++] = 0x83;
+    code->bytes[code->count++] = 0xc4;
+    code->bytes[code->count++] = code->frame;
+    return true;
+}
+
+static bool check_native_return(CheckInputReader* reader, uint32_t open, uint32_t close)
+{
+    const Parser* p = reader->parser;
+    const CheckInput* in = reader->output;
+    const TypeTable* types = reader->types;
+    if (close <= open + 1 || close - open > 75 || p->tokens.kinds[close - 1] != PARSE_KIND_SEMI)
+        return false;
+    const uint32_t d = check_sparse_get(in->body_declarations, open);
+    if (d >= in->token_count || in->objects[d] == 0 || in->objects[d] > in->token_count || check_input_attributes_at(in, d) != NULL ||
+        check_input_attributes_at(in, in->objects[d] - 1) != NULL ||
+        (in->function_flags != NULL && (in->function_flags[d] & (CHECK_INPUT_FUNCTION_INLINE | CHECK_INPUT_FUNCTION_NAKED |
+                                                                 CHECK_INPUT_FUNCTION_KR | CHECK_INPUT_FUNCTION_NORETURN)) != 0))
+        return false;
+    // Array parameter declarators can evaluate their bounds before the first statement.
+    for (uint32_t h = d + 1; h < open; h += 1)
+        if (p->tokens.kinds[h] == PARSE_KIND_L_SQUARE)
+            return false;
+    const TypeId fn = in->declared_types[d];
+    if (type_kind(types, fn) != BUSTER_TYPE_KIND_FUNCTION || type_function_abi_kind(types, fn) != TYPE_FUNCTION_ABI_SYSV ||
+        type_function_keeps_registers(types, fn) || type_function_has_parameter_abis(types, fn) ||
+        (types->types.flags[type_index(fn)] & (BUSTER_TYPE_FLAG_VARIADIC | BUSTER_TYPE_FLAG_PROTOTYPE)) != BUSTER_TYPE_FLAG_PROTOTYPE)
+        return false;
+    uint32_t count = 0;
+    const TypeId* params = type_parameters(types, fn, &count);
+    if (count > 6)
+        return false;
+    for (uint32_t pt = check_sparse_get(in->parameters, open); pt != BUSTER_CHECK_NONE; pt = check_sparse_get(in->parameter_next, pt))
+        if (check_input_attributes_at(in, pt) != NULL)
+            return false;
+    for (uint32_t i = 0; i < count; i += 1)
+        if (!check_return_width(types, params[i]))
+            return false;
+    const TypeId result = type_unqualified(type_return(types, fn));
+    const uint32_t width = check_return_width(types, result);
+    const bool narrow = check_return_extension(types, result) != 0;
+    if (!width && !narrow && result != BUSTER_TYPE_VOID)
+        return false;
+    uint32_t t = open + 1, stores = 0;
+    CheckReturnBytes code = {0};
+    while (t < close)
+    {
+        if (p->tokens.kinds[t] == PARSE_KIND_SEMI)
+        {
+            t += 1;
+            continue;
+        }
+        if (t + 8 >= close || p->tokens.kinds[t] != PARSE_KIND_L_PAREN || p->tokens.kinds[t + 1] != PARSE_KIND_L_PAREN ||
+            p->tokens.names[t + 2] != C_NAME_VOID || p->tokens.kinds[t + 3] != PARSE_KIND_R_PAREN ||
+            p->tokens.kinds[t + 4] != PARSE_KIND_L_PAREN || p->tokens.kinds[t + 5] != PARSE_KIND_NUMBER ||
+            p->tokens.kinds[t + 6] != PARSE_KIND_R_PAREN || p->tokens.kinds[t + 7] != PARSE_KIND_R_PAREN ||
+            p->tokens.kinds[t + 8] != PARSE_KIND_SEMI)
+            break;
+        const uint8_t* spelling = NULL;
+        uint32_t length = 0;
+        if (!check_input_spelling(reader, t + 5, &spelling, &length) || length != 1 || spelling[0] != '0')
+            break;
+        t += 9;
+    }
+    if (!narrow && check_return_wrapper(reader, open, t, close - 1, count, params, result, &code))
+    {
+        t = close;
+    }
+    while (t < close && p->tokens.kinds[t] != PARSE_KIND_RETURN)
+    {
+        if (count > 2 || stores == 4 || !check_return_store(reader, open, &t, close, &code))
+            return false;
+        stores += 1;
+    }
+    CheckReturnValue a = {0};
+    if (t < close)
+    {
+        if (!width && !narrow)
+            return false;
+        t += 1;
+        uint32_t end = close - 1;
+        while (t + 2 < end && p->tree.roles[t] == PARSE_ROLE_OPEN_GROUP && p->tree.parents[t] == end - 1)
+        {
+            t += 1;
+            end -= 1;
+        }
+        if (!check_return_expression(reader, open, &t, end, result, &code, &a) || t != end)
+            return false;
+    }
+    else if (code.callee == 0 && (width != 0 || narrow || !stores))
+        return false;
+    code.bytes[code.count++] = 0xc3;
+    if (!check_return_publish(reader, open, close, &code))
+        return false;
+    if (code.callee && getenv("BUSTER_DIRECT_RETURN_AUDIT") != NULL)
+        fprintf(stderr, "direct-source-call\t%u\t%u\t%u\t%u\n", open, close, code.callee, code.field);
+    if (getenv("BUSTER_DIRECT_RETURN_AUDIT") != NULL)
+        fprintf(stderr, "direct-return\t%u\t%u\t%u\t%u\t%u\t%u\n", open, close, a.literal, a.loads, stores, code.count);
+    return true;
+}
+
+static bool check_source_argument_compatible(const TypeTable* types, TypeId from, TypeId wanted)
+{
+    if (type_unqualified(from) == wanted)
+        return true;
+    if (type_kind(types, from) != BUSTER_TYPE_KIND_POINTER || type_kind(types, wanted) != BUSTER_TYPE_KIND_POINTER)
+        return false;
+    const TypeId source = type_element(types, from), target = type_element(types, wanted);
+    return type_kind(types, source) != BUSTER_TYPE_KIND_FUNCTION && type_unqualified(target) == BUSTER_TYPE_VOID &&
+           (type_qualifiers(source) & ~type_qualifiers(target)) == 0;
+}
+
+static bool check_source_statement_operand(CheckInputReader* reader, uint32_t* cursor, uint32_t close, TypeId expected, bool write,
+                                           CheckSourceOperand* argument)
+{
+    const Parser* p = reader->parser;
+    const CheckInput* in = reader->output;
+    const TypeTable* types = reader->types;
+    uint32_t t = *cursor;
+    if (t >= close)
+        return false;
+    if (p->tokens.kinds[t] == PARSE_KIND_NUMBER || p->tokens.kinds[t] == PARSE_KIND_MINUS)
+    {
+        CheckReturnValue value = {0};
+        if (write || !check_return_value(reader, 0, &t, close, &value) || !value.literal ||
+            (type_kind(types, expected) == BUSTER_TYPE_KIND_POINTER && value.constant != 0))
+            return false;
+        *argument = (CheckSourceOperand){.type = expected ? expected : BUSTER_TYPE_INT, .constant = value.constant};
+    }
+    else
+    {
+        const uint32_t object_decl = in->declarations[t];
+        if (p->tokens.kinds[t] != PARSE_KIND_IDENTIFIER || p->tree.roles[t] != PARSE_ROLE_OPERAND || object_decl >= in->token_count ||
+            in->declaration_kinds[object_decl] != C_BINDING_OBJECT || in->objects[object_decl] == 0 ||
+            check_input_bit(in->declaration_bits, object_decl, BUSTER_CHECK_BITS_STATIC) ||
+            !check_return_width(types, in->declared_types[object_decl]) || check_input_attributes_at(in, object_decl) != NULL ||
+            BUSTER_CHECK_RARE(reader, declaration_flags, object_decl) != 0)
+            return false;
+        TypeId type = in->declared_types[object_decl];
+        const TypeId base = type;
+        uint32_t field = 0;
+        t += 1;
+        if (t + 1 < close && p->tokens.kinds[t] == PARSE_KIND_ARROW && p->tree.roles[t + 1] == PARSE_ROLE_MEMBER)
+        {
+            if (type_kind(types, type) != BUSTER_TYPE_KIND_POINTER || in->marked_member_count != 0 || in->noderef_member_count ||
+                in->noderef_declaration_count)
+                return false;
+            const TypeId record = type_element(types, type);
+            const CheckContext where = {
+                .tag_completions = reader->tag_completions, .tag_completion_count = types->tags.count, .source_position = t};
+            if ((write && type_qualifiers(record)) || (type_qualifiers(record) & ~(uint32_t)BUSTER_TYPE_CONST) != 0 ||
+                type_kind(types, record) != BUSTER_TYPE_KIND_STRUCT || !check_context_source_complete(types, record, &where))
+                return false;
+            uint64_t offset = 0;
+            uint32_t quals = 0;
+            const uint32_t member = type_lookup_member(types, record, p->tokens.names[t + 1], &offset, &quals);
+            if (!member || member >= types->members.count || (offset & 7) != 0 || offset / 8 > INT32_MAX || (write && quals) ||
+                (quals & ~(uint32_t)BUSTER_TYPE_CONST) != 0 || (types->members.flags[member] & BUSTER_TYPE_MEMBER_BIT_FIELD) != 0)
+                return false;
+            type = types->members.type[member];
+            if (!check_return_width(types, type))
+                return false;
+            field = (uint32_t)(offset / 8) + 1;
+            t += 2;
+        }
+        if ((write && type_qualifiers(type)) || (expected && !check_source_argument_compatible(types, type, expected)))
+            return false;
+        *argument = (CheckSourceOperand){.type = expected ? expected : type_unqualified(type),
+                                         .source_type = base,
+                                         .field_type = type,
+                                         .object = in->objects[object_decl],
+                                         .field = field};
+    }
+    *cursor = t;
+    return true;
+}
+
+static bool check_source_call_target(CheckInputReader* reader, uint32_t first, bool nested, CheckSourceStatement* call)
+{
+    const Parser* p = reader->parser;
+    const CheckInput* in = reader->output;
+    const TypeTable* types = reader->types;
+    const uint32_t token = first - 1;
+    if (p->tree.roles[token] != PARSE_ROLE_OPERAND || p->tokens.kinds[token] != PARSE_KIND_IDENTIFIER || token == 0 ||
+        (!nested && p->tokens.kinds[token - 1] != PARSE_KIND_SEMI && p->tokens.kinds[token - 1] != PARSE_KIND_L_BRACE &&
+         p->tokens.kinds[token - 1] != PARSE_KIND_R_BRACE))
+        return false;
+    const uint32_t decl = in->declarations[token];
+    if (decl >= in->token_count || in->declaration_kinds[decl] != C_BINDING_FUNCTION || in->objects[decl] == 0 ||
+        in->objects[decl] > in->token_count || check_input_attributes_at(in, decl) != NULL ||
+        check_input_attributes_at(in, in->objects[decl] - 1) != NULL || check_input_builtin_named(reader, p->tokens.names[token]) ||
+        check_input_library_call(reader, token) != 0 || check_input_builtin_id(reader, token) != 0 ||
+        (reader->late_attribute_masks != NULL && reader->late_attribute_masks[in->objects[decl]] != 0))
+        return false;
+    if (in->function_flags != NULL &&
+        (in->function_flags[decl] & (CHECK_INPUT_FUNCTION_NORETURN | CHECK_INPUT_FUNCTION_KR | CHECK_INPUT_FUNCTION_IMPLICIT |
+                                     CHECK_INPUT_FUNCTION_IMPLICIT_LIBRARY | CHECK_INPUT_FUNCTION_NAKED | CHECK_INPUT_FUNCTION_INLINE)))
+        return false;
+    const TypeId fn = in->declared_types[decl];
+    if (type_kind(types, fn) != BUSTER_TYPE_KIND_FUNCTION || type_function_abi_kind(types, fn) != TYPE_FUNCTION_ABI_SYSV ||
+        type_function_keeps_registers(types, fn) || type_function_has_parameter_abis(types, fn) ||
+        (types->types.flags[type_index(fn)] & (BUSTER_TYPE_FLAG_VARIADIC | BUSTER_TYPE_FLAG_PROTOTYPE)) != BUSTER_TYPE_FLAG_PROTOTYPE ||
+        (type_return(types, fn) != BUSTER_TYPE_VOID && !check_return_width(types, type_return(types, fn))))
+        return false;
+    uint32_t n = 0;
+    type_parameters(types, fn, &n);
+    if (n > 4)
+        return false;
+    call->callee = in->objects[decl];
+    call->count = n;
+    call->function = fn;
+    return true;
+}
+
+static bool check_source_call_statement(CheckInputReader* reader, uint32_t first, uint32_t close, CheckSourceStatement* call)
+{
+    if (!check_source_call_target(reader, first, false, call))
+        return false;
+    const Parser* p = reader->parser;
+    const TypeTable* types = reader->types;
+    uint32_t n = 0;
+    const TypeId* formal = type_parameters(types, call->function, &n);
+    uint32_t t = first + 1;
+    for (uint32_t a = 0; a < n; a += 1)
+    {
+        const TypeId expected = type_unqualified(formal[a]);
+        if (!check_return_width(types, formal[a]) || (a && (t >= close || p->tokens.kinds[t++] != PARSE_KIND_COMMA)) || t >= close)
+            return false;
+        CheckSourceOperand* argument = call->arguments + a;
+        if (!check_source_statement_operand(reader, &t, close, expected, false, argument))
+            return false;
+    }
+    return t == close;
+}
+
+static bool check_source_store_statement(CheckInputReader* reader, uint32_t equal, uint32_t end, uint32_t* begin,
+                                         CheckSourceStatement* store)
+{
+    const Parser* p = reader->parser;
+    if (p->tokens.kinds[equal] != PARSE_KIND_EQUAL || equal < 2 || end <= equal + 1 || end - equal > 9)
+        return false;
+    uint32_t first = equal - 1;
+    if (first >= 2 && p->tokens.kinds[first - 1] == PARSE_KIND_ARROW)
+        first -= 2;
+    if (!first || (p->tokens.kinds[first - 1] != PARSE_KIND_SEMI && p->tokens.kinds[first - 1] != PARSE_KIND_L_BRACE &&
+                   p->tokens.kinds[first - 1] != PARSE_KIND_R_BRACE))
+        return false;
+    uint32_t at = first;
+    CheckSourceOperand* args = store->arguments;
+    if (!check_source_statement_operand(reader, &at, equal, 0, true, args) || at != equal)
+        return false;
+    const TypeId type = args[0].type;
+    at += 1;
+    if (!check_source_statement_operand(reader, &at, end, type, false, args + 1))
+        return false;
+    store->count = 2;
+    if (at < end)
+    {
+        if (!args[1].object || type_kind(reader->types, type) != BUSTER_TYPE_KIND_INTEGER)
+            return false;
+        const uint8_t op = p->tokens.kinds[at++];
+        if (op != PARSE_KIND_PLUS && op != PARSE_KIND_MINUS && op != PARSE_KIND_STAR && op != PARSE_KIND_AMP && op != PARSE_KIND_PIPE &&
+            op != PARSE_KIND_CARET)
+            return false;
+        if (!check_source_statement_operand(reader, &at, end, type, false, args + 2))
+            return false;
+        store->operation = op;
+        store->count = 3;
+    }
+    if (at != end)
+        return false;
+    *begin = first;
+    return true;
+}
+
+// Publish complete local stores at function close. Linkage and declaration attributes of a call can
+// still change later in the unit, so retain that call's spelling interval for the final contract check.
+static void check_source_event_close(CheckInputReader* reader,const uint32_t* sites,uint32_t count)
+{
+    const Parser* p=reader->parser;
+    CheckInput* in=reader->output;
+    if(p->errors || in->overload_heads!=NULL) return;
+    for(uint32_t i=0;i<count;i+=1)
+    {
+        const uint32_t op=sites[i], parent=p->tree.parents[op];
+        if(parent<=op || parent>=reader->function_end) continue;
+        const bool call=p->tree.roles[op]==PARSE_ROLE_OPEN_CALL;
+        const uint32_t end=call?parent+1:parent;
+        if(end-op>18 || end>=reader->function_end || p->tree.roles[end]!=PARSE_ROLE_TERMINATOR ||
+           p->tokens.kinds[end]!=PARSE_KIND_SEMI || p->tree.parents[end]>=p->tokens.count ||
+           (p->tree.roles[p->tree.parents[end]]!=PARSE_ROLE_CLOSE_BODY && p->tree.roles[p->tree.parents[end]]!=PARSE_ROLE_CLOSE_BLOCK)) continue;
+        if(call && (p->tree.roles[parent]!=PARSE_ROLE_CLOSE_CALL || p->tree.parents[parent]!=end)) continue;
+        uint32_t owner=p->tree.parents[end], limit=0;
+        while(owner<p->tokens.count && p->tree.roles[owner]!=PARSE_ROLE_CLOSE_BODY && p->tree.roles[owner]!=PARSE_ROLE_CLOSE_COMPOUND_BODY && limit++<255)
+            owner=p->tree.parents[owner];
+        if(owner!=reader->function_end) continue;
+        CheckSourceStatement row={0};
+        uint32_t begin=op-1;
+        if(call) row.count=UINT32_MAX;
+        else if(!check_source_store_statement(reader,op,end,&begin,&row)) continue;
+        if(reader->event_statement_count==in->source_statement_room)
+        {
+            const uint32_t next=in->source_statement_room?in->source_statement_room*2:16;
+            if(next<in->source_statement_room) return;
+            CheckSourceStatement* rows=BUSTER_ARENA_PUSH_ARRAY(reader->arena,CheckSourceStatement,next);
+            uint32_t* begins=BUSTER_ARENA_PUSH_ARRAY(reader->arena,uint32_t,next);
+            uint32_t* ends=BUSTER_ARENA_PUSH_ARRAY(reader->arena,uint32_t,next);
+            if(rows==NULL || begins==NULL || ends==NULL) return;
+            const uint32_t n=reader->event_statement_count;
+            if(n){memcpy(rows,in->source_statements,(size_t)n*sizeof(*rows));memcpy(begins,reader->statement_begins,(size_t)n*sizeof(*begins));memcpy(ends,reader->statement_ends,(size_t)n*sizeof(*ends));}
+            in->source_statements=rows;
+            reader->statement_begins=begins;reader->statement_ends=ends;in->source_statement_room=next;
+        }
+        const uint32_t n=reader->event_statement_count++;
+        in->source_statements[n]=row;
+        reader->statement_begins[n]=begin;
+        reader->statement_ends[n]=end;
+    }
+}
+
+static void check_source_event_publish(CheckInputReader* reader)
+{
+    const Parser* p=reader->parser; CheckInput* in=reader->output;
+    if(in->overload_heads!=NULL || p->errors || !reader->event_statement_count) return;
+    CheckSparsePool* pool=NULL;
+    if(!check_sparse_reserve(reader->arena,&pool,&in->source_statement_tokens,1,p->tokens.count,false,false)) return;
+    for(uint32_t i=0;i<reader->event_statement_count;i+=1)
+    {
+        const uint32_t begin=reader->statement_begins[i],end=reader->statement_ends[i];
+        CheckSourceStatement row=in->source_statements[i];
+        if(row.count==UINT32_MAX && !check_source_call_statement(reader,begin+1,end-1,&row)) continue;
+        if(check_sparse_get(in->source_statement_tokens,end)!=BUSTER_CHECK_NONE) continue;
+        check_sparse_set(pool,in->source_statement_tokens,end,in->source_statement_count);
+        in->source_statements[in->source_statement_count++]=row;
+        memset(reader->visits+begin,0,(size_t)(end-begin)+1);
+        if(in->source_statement_audit) fprintf(stderr,"direct-statement\t%u\t%u\t%u\t%u\n",begin,end,row.callee,row.count);
+    }
+    if(getenv("BUSTER_DIRECT_GRAPH_CENSUS")!=NULL)
+        fprintf(stderr,"source-statement-events\t%u\t%u\n",reader->event_statement_count,in->source_statement_count);
+}
+
+#include "c_check_source_operators.c"
+
+static uint64_t check_source_operator_boundaries(__m512i kinds, __mmask64 lanes)
+{
+    return _mm512_mask_cmpeq_epi8_mask(lanes, kinds, _mm512_set1_epi8(PARSE_KIND_SEMI)) |
+           _mm512_mask_cmpeq_epi8_mask(lanes, kinds, _mm512_set1_epi8(PARSE_KIND_L_BRACE)) |
+           _mm512_mask_cmpeq_epi8_mask(lanes, kinds, _mm512_set1_epi8(PARSE_KIND_R_BRACE));
+}
+
+// The parser classified these operators before any source program was attempted. A body
+// containing one of them cannot consist entirely of the scalar programs produced here.
+// Decline a whole body from its first such block, before proving any of its leaves.
+static bool check_source_program_body_candidate(const CheckInputReader* reader, uint32_t begin, uint32_t end)
+{
+    static const uint8_t blocked[64] = {
+        [CHECK_INPUT_CODE_SCALAR] = 0x80, [CHECK_INPUT_CODE_CAST] = 0x80, [CHECK_INPUT_CODE_TERNARY] = 0x80,
+        [CHECK_INPUT_CODE_SUBSCRIPT] = 0x80, [CHECK_INPUT_CODE_POSTFIX] = 0x80, [CHECK_INPUT_CODE_STRING] = 0x80,
+        [CHECK_INPUT_CODE_INITIALIZE] = 0x80
+    };
+    const __m512i table = _mm512_loadu_si512(blocked);
+    for (uint32_t first = begin; first < end; first += 64)
+    {
+        const uint32_t size = end - first < 64 ? end - first : 64;
+        const __mmask64 live = size == 64 ? UINT64_MAX : _bzhi_u64(UINT64_MAX, size);
+        const __m512i visits = _mm512_maskz_loadu_epi8(live, reader->visits + first);
+        const __m512i codes = _mm512_and_si512(_mm512_srli_epi16(visits, BUSTER_CHECK_EXPRESSION_CODE_SHIFT), _mm512_set1_epi8(31));
+        if (_mm512_movepi8_mask(_mm512_permutexvar_epi8(codes, table)))
+            return false;
+    }
+    return true;
+}
+
+static void check_source_statements(CheckInputReader* reader)
+{
+    const Parser* p = reader->parser;
+    CheckInput* in = reader->output;
+    const uint32_t count = p->tokens.count;
+    CheckSparsePool* pool = NULL;
+    const bool census = getenv("BUSTER_DIRECT_GRAPH_CENSUS") != NULL;
+    struct timespec started={0};
+    if(census) clock_gettime(CLOCK_MONOTONIC,&started);
+    uint32_t opened = 0, assigned = 0, call_count = 0, store_count = 0;
+    uint64_t covered = 0;
+    const bool operators = getenv("BUSTER_DIRECT_OPERATOR_PROGRAM") != NULL;
+    in->source_operator_call_mode = operators && getenv("BUSTER_DIRECT_OPERATOR_CALLS") != NULL;
+    const bool masked = operators && getenv("BUSTER_OPERATOR_MASKED_ROOTS") != NULL;
+    uint32_t operator_stores = 0, operator_calls = 0, operator_steps = 0;
+    if (in->overload_heads != NULL || p->errors != 0)
+        return;
+    const bool restricted = getenv("BUSTER_SOURCE_ROOT_ONLY_SCAN") != NULL;
+    uint32_t candidates = 0, candidate_tokens = 0;
+    for (uint32_t cursor = 0; cursor < count; )
+    {
+        uint32_t first_token = 0, stop = count;
+        if (restricted)
+        {
+            const uint32_t open = check_sparse_next(in->body_declarations, cursor, count);
+            if (open >= count)
+                break;
+            const uint32_t close = p->tree.parents[open];
+            cursor = open + 1;
+            if (close <= cursor || close >= count || p->tree.roles[close] != PARSE_ROLE_CLOSE_BODY)
+                continue;
+            cursor = close + 1;
+            if (!check_source_program_body_candidate(reader, open + 1, close))
+                continue;
+            first_token = open + 1;
+            stop = close;
+            candidates += 1;
+            candidate_tokens += stop - first_token;
+        }
+        else
+            cursor = count;
+        for (uint32_t base = first_token; base < stop; base += 64)
+        {
+            const uint32_t span = stop - base < 64 ? stop - base : 64;
+            const __mmask64 lanes = span == 64 ? UINT64_MAX : _bzhi_u64(UINT64_MAX, span);
+            const __m512i roles = _mm512_maskz_loadu_epi8(lanes, p->tree.roles + base);
+            const uint64_t openings = _mm512_mask_cmpeq_epi8_mask(lanes, roles, _mm512_set1_epi8(PARSE_ROLE_OPEN_CALL));
+            const uint64_t assigns = _mm512_mask_cmpeq_epi8_mask(lanes, roles, _mm512_set1_epi8(PARSE_ROLE_ASSIGN));
+            const uint8_t* kinds = p->tokens.kinds;
+            if (census)
+            {
+                opened += (uint32_t)__builtin_popcountll(openings);
+                assigned += (uint32_t)__builtin_popcountll(assigns);
+            }
+            const uint64_t headings = operators ? _mm512_mask_cmpeq_epi8_mask(lanes, roles, _mm512_set1_epi8(PARSE_ROLE_OPEN_CONDITION)) : 0;
+            const uint64_t returns = operators ? _mm512_mask_cmpeq_epi8_mask(lanes, roles, _mm512_set1_epi8(PARSE_ROLE_RETURN)) : 0;
+            uint64_t sites = openings | assigns | headings | returns;
+            if (masked && sites)
+            {
+                const __m512i prior = _mm512_maskz_loadu_epi8(lanes, kinds + base - 2);
+                const __m512i previous = _mm512_maskz_loadu_epi8(lanes, kinds + base - 1);
+                const __m512i here = _mm512_maskz_loadu_epi8(lanes, kinds + base);
+                const uint64_t plain = check_source_operator_boundaries(prior, lanes);
+                const uint64_t equals = _mm512_mask_cmpeq_epi8_mask(assigns, here, _mm512_set1_epi8(PARSE_KIND_EQUAL));
+                const uint64_t member = _mm512_mask_cmpeq_epi8_mask(equals, prior, _mm512_set1_epi8(PARSE_KIND_ARROW));
+                const uint64_t field = member ? check_source_operator_boundaries(_mm512_maskz_loadu_epi8(lanes, kinds + base - 4), member) : 0;
+                const uint64_t tests = _mm512_mask_cmpeq_epi8_mask(headings, previous, _mm512_set1_epi8(PARSE_KIND_IF)) |
+                                       _mm512_mask_cmpeq_epi8_mask(headings, previous, _mm512_set1_epi8(PARSE_KIND_WHILE));
+                sites = (openings & plain) | (equals & (plain | field)) | tests |
+                        _mm512_mask_cmpeq_epi8_mask(returns, here, _mm512_set1_epi8(PARSE_KIND_RETURN));
+            }
+            while (sites)
+            {
+                const uint32_t bit = (uint32_t)__builtin_ctzll(sites);
+                sites &= sites - 1;
+                const uint32_t first = base + bit;
+                const bool call_site = ((openings >> bit) & 1) != 0;
+                const uint32_t parent = p->tree.parents[first];
+                if (first < 2 || parent <= first || parent >= count - 1)
+                    continue;
+                const bool condition_site = ((headings >> bit) & 1) != 0;
+                const bool return_site = ((returns >> bit) & 1) != 0;
+                const uint32_t end = call_site ? parent + 1 : parent;
+                if (!condition_site && !return_site && (end - first > (operators ? 64u : 18u) || p->tree.roles[end] != PARSE_ROLE_TERMINATOR || kinds[end] != PARSE_KIND_SEMI ||
+                    p->tree.parents[end] >= count ||
+                    (p->tree.roles[p->tree.parents[end]] != PARSE_ROLE_CLOSE_BODY &&
+                     p->tree.roles[p->tree.parents[end]] != PARSE_ROLE_CLOSE_BLOCK)))
+                    continue;
+                if (call_site && (p->tree.roles[parent] != PARSE_ROLE_CLOSE_CALL || p->tree.parents[parent] != end))
+                    continue;
+                if (in->region_count)
+                {
+                    uint32_t owner = p->tree.parents[end], limit = 0;
+                    while (owner < count && p->tree.roles[owner] != PARSE_ROLE_CLOSE_BODY &&
+                           p->tree.roles[owner] != PARSE_ROLE_CLOSE_COMPOUND_BODY && limit++ < 255)
+                        owner = p->tree.parents[owner];
+                    if (owner >= count || p->tree.roles[owner] != PARSE_ROLE_CLOSE_BODY)
+                        continue;
+                }
+                CheckSourceStatement call = {0};
+                uint32_t begin = condition_site || return_site ? first : first - 1;
+                bool accepted = return_site ? check_source_operator_return(reader, first, end, &call) : condition_site ? check_source_operator_condition(reader, first, end, &call) : call_site ? check_source_call_statement(reader, first, parent, &call)
+                                          : check_source_store_statement(reader, first, end, &begin, &call);
+                if (!accepted && operators && !condition_site && !return_site)
+                    accepted = call_site ? check_source_operator_call(reader, first, parent, &call)
+                                         : check_source_operator_store(reader, first, end, &begin, &call);
+                if (!accepted)
+                    continue;
+                operator_stores += call.operator_count != 0 && !call_site && !condition_site && !return_site;
+                operator_calls += call.operator_count != 0 && call_site;
+                operator_steps += call.operator_count;
+                if (!pool && !check_sparse_reserve(reader->arena, &pool, &in->source_statement_tokens, 1, count, false, false))
+                    return;
+                if (in->source_statement_count == in->source_statement_room)
+                {
+                    const uint32_t next = in->source_statement_room ? in->source_statement_room * 2 : 16;
+                    if (next < in->source_statement_room)
+                        return;
+                    CheckSourceStatement* rows = BUSTER_ARENA_PUSH_ARRAY(reader->arena, CheckSourceStatement, next);
+                    if (!rows)
+                        return;
+                    if (in->source_statement_count)
+                        memcpy(rows, in->source_statements, (size_t)in->source_statement_count * sizeof(*rows));
+                    in->source_statements = rows;
+                    in->source_statement_room = next;
+                }
+                check_sparse_set(pool, in->source_statement_tokens, return_site ? first : end, in->source_statement_count);
+                in->source_statements[in->source_statement_count++] = call;
+                in->source_condition_count += condition_site;
+                in->source_return_count += return_site;
+                in->source_operator_steps += call.operator_count;
+                in->source_operator_calls += call.operator_calls;
+                if (census)
+                {
+                    call_count += call_site;
+                    store_count += !call_site && !condition_site && !return_site;
+                    covered += end - begin + 1;
+                }
+                memset(reader->visits + begin, 0, (size_t)(end - begin) + 1);
+                if (in->source_statement_audit)
+                    fprintf(stderr, "%s\t%u\t%u\t%u\t%u\t%u\n", return_site ? "direct-operator-return" : condition_site ? "direct-condition" : "direct-statement", begin, end, call.callee, call.count, call.operator_count);
+            }
+        }
+    }
+    if (census && restricted) fprintf(stderr, "source-root-candidates\t%u\t%u\n", candidates, candidate_tokens);
+    if(census)
+    {
+        struct timespec finished={0};
+        clock_gettime(CLOCK_MONOTONIC,&finished);
+        const uint64_t ns=(uint64_t)(finished.tv_sec-started.tv_sec)*UINT64_C(1000000000)+finished.tv_nsec-started.tv_nsec;
+        fprintf(stderr,"source-nested-calls\t%u\n",in->source_operator_calls);
