+
+static bool check_source_operator_call(CheckInputReader* reader, uint32_t first, uint32_t close, CheckSourceStatement* call)
+{
+    CheckSourceStatement row = {0};
+    CheckSourceOperator rows[BUSTER_SOURCE_OPERATOR_LIMIT];
+    uint32_t steps = 0;
+    if (!check_source_call_target(reader, first, false, &row) || !check_source_operator_arguments(reader, first, close, &row, rows, &steps, 0) ||
+        !check_source_operator_save(reader, rows, steps, &row))
+        return false;
+    *call = row;
+    return true;
+}
+
+static bool check_source_operator_condition(CheckInputReader* reader, uint32_t open, uint32_t close, CheckSourceStatement* statement)
+{
+    const Parser* p = reader->parser;
+    if (close <= open + 1 || close - open > BUSTER_SOURCE_OPERATOR_LIMIT || p->tree.roles[close] != PARSE_ROLE_CLOSE_CONDITION ||
+        (p->tokens.kinds[open - 1] != PARSE_KIND_IF && p->tokens.kinds[open - 1] != PARSE_KIND_WHILE))
+        return false;
+    CheckSourceOperator rows[BUSTER_SOURCE_OPERATOR_LIMIT];
+    uint32_t count = 0;
+    if (!check_source_operator_expression(reader, open + 1, close, 0, rows, &count))
+        return false;
+    return check_source_operator_save(reader, rows, count, statement);
+}
+
+static bool check_source_operator_return(CheckInputReader* reader, uint32_t token, uint32_t end, CheckSourceStatement* statement)
+{
+    const Parser* p = reader->parser;
+    const CheckInput* in = reader->output;
+    if (p->tokens.kinds[token] != PARSE_KIND_RETURN || p->tree.roles[end] != PARSE_ROLE_TERMINATOR ||
+        p->tokens.kinds[end] != PARSE_KIND_SEMI || end <= token + 1 || end - token > BUSTER_SOURCE_OPERATOR_LIMIT ||
+        in->cleanup_count || in->musttail_count)
+        return false;
+    const TypeId result = type_unqualified(reader->query_types[token]);
+    if (!check_return_width(reader->types, result))
+        return false;
+    uint32_t owner = p->tree.parents[end];
+    for (uint32_t hops = 0; hops < 128 && owner < in->token_count; hops += 1)
+    {
+        if (p->tree.roles[owner] == PARSE_ROLE_CLOSE_BODY || p->tree.roles[owner] == PARSE_ROLE_CLOSE_COMPOUND_BODY)
+            break;
+        owner = p->tree.parents[owner];
+    }
+    if (owner >= in->token_count || p->tree.roles[owner] != PARSE_ROLE_CLOSE_BODY)
+        return false;
+    uint32_t open = reader->first_child[owner];
+    while (open < in->token_count && p->tree.roles[open] != PARSE_ROLE_OPEN_BODY)
+        open = reader->next_child[open];
+    if (open >= in->token_count)
+        return false;
+    const uint32_t decl = check_sparse_get(in->body_declarations, open);
+    if (decl >= in->token_count || !in->objects[decl] || in->objects[decl] > in->token_count ||
+        check_input_attributes_at(in, decl) || check_input_attributes_at(in, in->objects[decl] - 1) ||
+        (in->function_flags && (in->function_flags[decl] & (CHECK_INPUT_FUNCTION_NORETURN | CHECK_INPUT_FUNCTION_NAKED | CHECK_INPUT_FUNCTION_KR))))
+        return false;
+    CheckSourceOperator rows[BUSTER_SOURCE_OPERATOR_LIMIT];
+    uint32_t count = 0;
+    if (!check_source_operator_expression(reader, token + 1, end, result, rows, &count))
+        return false;
+    return check_source_operator_save(reader, rows, count, statement);
+}
