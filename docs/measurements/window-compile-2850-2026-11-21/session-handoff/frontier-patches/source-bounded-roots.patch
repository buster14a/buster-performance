+// An early code fragment cannot be the input of a later inlining or target-specific transformation.
+// All declarations, including redeclarations, are available by the time a function's expressions are checked.
+static bool check_source_can_retire(CheckSourceControlUnit* unit,const CheckProgram* program)
+{
+    if (!check_source_retire_typed) return false;
+    if (unit->native_attributes==NULL)
+    {
+        unit->native_attributes=BUSTER_ARENA_PUSH_ARRAY(unit->native_metadata,uint8_t,program->object_count);
+        if (unit->native_attributes==NULL) return false;
+        memset(unit->native_attributes,0,program->object_count);
+        for(uint32_t i=0;i<unit->declaring_count;i+=1)
+        {
+            const uint32_t t=unit->declaring[i];
+            const CheckInputAttributes* attr=check_input_attributes_at(program->input,t);
+            if (attr!=NULL)
+            {
+                const uint32_t object=program->input->objects[t];
+                const uint32_t bits=check_program_attribute_bits(attr);
+                const uint32_t retained=BUSTER_CHECK_PROGRAM_ATTRIBUTE_NAKED|BUSTER_CHECK_PROGRAM_ATTRIBUTE_TARGET|
+                    BUSTER_CHECK_PROGRAM_ATTRIBUTE_CALLEE|BUSTER_CHECK_PROGRAM_ATTRIBUTE_ALIAS|BUSTER_CHECK_PROGRAM_ATTRIBUTE_ALWAYS_INLINE|
+                    BUSTER_CHECK_PROGRAM_ATTRIBUTE_INTERRUPT|BUSTER_CHECK_PROGRAM_ATTRIBUTE_REALIGN|BUSTER_CHECK_PROGRAM_ATTRIBUTE_RETURNS_TWICE|
+                    BUSTER_CHECK_PROGRAM_ATTRIBUTE_PATCHABLE;
+                if (object<program->object_count && (bits&retained)!=0) unit->native_attributes[object]=1;
+                unit->native_remapped |= (bits&BUSTER_CHECK_PROGRAM_ATTRIBUTE_ALIAS)!=0;
+            }
+        }
+    }
+    if (unit->native_remapped) return false;
+    for(uint32_t i=0;i<program->symbol_count;i+=1) if (unit->native_attributes[program->symbol_objects[i]]) return false;
+    return true;
+}
