+static bool check_native_returns_run(CheckInputReader* reader)
+{
+    const Parser* p = reader->parser;
+    const uint32_t count = p->tokens.count;
+    CheckInput* in = reader->output;
+    if (getenv("BUSTER_DIRECT_SOURCE_STATEMENTS") != NULL)
+    {
+        in->source_statement_audit=getenv("BUSTER_DIRECT_RETURN_AUDIT")!=NULL;
+        if(reader->event_statements) check_source_event_publish(reader);
+        else check_source_statements(reader);
