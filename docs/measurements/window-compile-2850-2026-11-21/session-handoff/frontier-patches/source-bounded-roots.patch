+// Resolve the field while its encoded instruction and end are in the same body's window.
+// Its target is still symbolic. The link gives it its final symbol and atom later.
+static inline bool link_code_field(const X86Instruction* instruction, const LinkReference* reference, const uint32_t* ends,
+                                   uint64_t ordinal, uint32_t* offset, int64_t* addend)
+{
+    bool valid = ends != NULL && reference->field <= X86_FIXUP_IMMEDIATE && (instruction->form & BUSTER_X86_FORM_FIXUP) != 0 &&
+                 link_kind_fits(reference->kind, instruction, reference->field);
+    if (valid)
+    {
+        const uint32_t end = ends[ordinal];
+        const uint32_t distance = x86_fixup_distance(instruction->form, reference->field);
+        *offset = end - distance;
+        *addend = reference->addend;
+        valid = distance <= end && !(link_fixup_kinds[reference->kind].pc_relative &&
+                                     __builtin_sub_overflow(reference->addend, (int64_t)distance, addend));
+    }
+    return valid;
+}
+
+static inline bool link_add_code_field(Link* link, AtomId atom, uint32_t offset, uint8_t kind, SymbolId target, int64_t addend)
+{
+    const bool valid = link_add_fixup(link, atom, offset, kind, target, addend) != 0;
+    if (valid)
+    {
+        memset(link->atoms.bytes[atom] + offset, 0, link_fixup_kinds[kind].width);
+    }
+    return valid;
+}
