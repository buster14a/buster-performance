+
+// The System V integer registers at entry. This leaf never changes RSP or a preserved register.
+static const uint8_t check_return_registers[6] = {7, 6, 2, 1, 8, 9};
+
+typedef struct CheckReturnBytes
+{
+    uint8_t bytes[256];
+    uint32_t count;
+    uint32_t callee;
+    uint16_t field;
+    uint8_t frame;
