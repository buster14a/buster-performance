+static bool check_source_operator_expression(CheckInputReader* reader, uint32_t first, uint32_t end, TypeId wanted,
+                                             CheckSourceOperator* rows, uint32_t* count)
+{
+    return check_source_operator_expression_depth(reader, first, end, wanted, rows, count, 0);
+}
+
+static bool check_source_operator_save(CheckInputReader* reader, const CheckSourceOperator* rows, uint32_t used, CheckSourceStatement* statement)
+{
+    if (!used)
+        return false;
+    CheckSourceOperator* saved = BUSTER_ARENA_PUSH_ARRAY(reader->arena, CheckSourceOperator, used);
+    if (!saved)
+        return false;
+    memcpy(saved, rows, used * sizeof(*rows));
+    statement->operators = saved;
+    statement->operator_count = (uint8_t)used;
+    for (uint32_t i = 0; reader->output->source_operator_call_mode && i < used; i += 1)
+        statement->operator_calls += rows[i].op == CHECK_OP_CALL;
+    return true;
+}
+
+static bool check_source_operator_store(CheckInputReader* reader, uint32_t equal, uint32_t end, uint32_t* begin, CheckSourceStatement* store)
+{
+    const Parser* p = reader->parser;
+    if (p->tokens.kinds[equal] != PARSE_KIND_EQUAL || equal < 2 || end <= equal + 1 || end - equal > BUSTER_SOURCE_OPERATOR_LIMIT)
+        return false;
+    uint32_t first = equal - 1;
+    if (first >= 2 && p->tokens.kinds[first - 1] == PARSE_KIND_ARROW)
+        first -= 2;
+    if (!first || (p->tokens.kinds[first - 1] != PARSE_KIND_SEMI && p->tokens.kinds[first - 1] != PARSE_KIND_L_BRACE &&
+                   p->tokens.kinds[first - 1] != PARSE_KIND_R_BRACE) || !check_source_operator_local(reader, first))
+        return false;
+    uint32_t at = first;
+    CheckSourceOperand dest = {0};
+    if (!check_source_statement_operand(reader, &at, equal, 0, true, &dest) || at != equal)
+        return false;
+    CheckSourceOperator rows[BUSTER_SOURCE_OPERATOR_LIMIT];
+    uint32_t count = 0;
+    if (!check_source_operator_expression(reader, equal + 1, end, dest.type, rows, &count))
+        return false;
+    *store = (CheckSourceStatement){.arguments = {dest}};
+    *begin = first;
+    return check_source_operator_save(reader, rows, count, store);
