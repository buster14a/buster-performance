+static void check_live_static_publish(CheckInput* destination, CheckInputLiteralTable* pending)
+{
+    CheckInputLiteralTable** link = &destination->literal_tables;
+    while (pending != NULL)
+    {
+        CheckInputLiteralTable* next = pending->next;
+        while (*link != NULL && (*link)->declaration < pending->declaration) link = &(*link)->next;
+        pending->next = *link;
+        *link = pending;
+        if (pending->next == NULL) destination->literal_tables_last = pending;
+        destination->literal_table_count += 1;
+        link = &pending->next;
+        pending = next;
+    }
+}
