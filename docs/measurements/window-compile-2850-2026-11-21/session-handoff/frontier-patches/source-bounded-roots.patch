+    uint32_t* links = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, slots);
+    uint32_t* marks = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, slots);
+    writer.fold_stack = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, slots);
+    writer.labels = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, capacity);
+    writer.entries = BUSTER_ARENA_PUSH_ARRAY(scratch, CheckControl, capacity);
+    writer.tasks = BUSTER_ARENA_PUSH_ARRAY(scratch, CheckControlTask, capacity);
+    writer.dropped_ranges = BUSTER_ARENA_PUSH_ARRAY(scratch, uint64_t, capacity);
+    writer.static_initializers = BUSTER_ARENA_PUSH_ARRAY(scratch, uint64_t, ((uint64_t)slots + 63) / 64);
+    if (!links || !marks || !writer.fold_stack || !writer.labels ||
+        !writer.entries || !writer.tasks || !writer.dropped_ranges || !writer.static_initializers) exit(2);
+    memset(unit->token_head + opening, 0xff, ((uint64_t)close - opening + 1) * sizeof(uint32_t));
+    for (uint32_t j = graph->count; j != 0; )
+    {
+        const uint32_t i = --j, token = graph->tokens[i];
+        if (token >= opening && token <= close) { links[i] = unit->token_head[token]; unit->token_head[token] = i; }
+    }
+    memset(writer.static_initializers, 0, (((uint64_t)slots + 63) / 64) * sizeof(uint64_t));
+    for (uint32_t token = check_sparse_next(input->initializer_nodes, opening, close); token < close;
+         token = check_sparse_next(input->initializer_nodes, token + 1, close))
+    {
+        const uint32_t node = check_sparse_get(input->initializer_nodes, token);
+        if (node < graph->count)
+        {
+            const uint64_t bit = UINT64_C(1) << (node % 64);
+            writer.static_initializers[node / 64] = (writer.static_initializers[node / 64] & ~bit) |
+                (check_input_bit(input->declaration_bits, token, BUSTER_CHECK_BITS_STATIC) ? bit : 0);
+        }
+    }
+    writer.static_initializers_ready = true;
+    writer.node_next = links;
+    check_control_build(&writer, opening);
+    if (p.status != CHECK_PROGRAM_OK) BUSTER_SOURCE_CONTROL_DECLINE("control-failure",p.status);
+    p.switches = writer.switches;
+    p.switch_count = writer.switch_count;
+    memset(marks, 0, slots * sizeof(uint32_t));
+    uint64_t reference_room = slots;
+    if (input->source_statement_count)
+        for (uint32_t i = 0; i < writer.entry_count; i += 1)
+        {
+            const CheckSourceStatement* source = check_program_source_root(input, writer.entries[i]);
+            if (source)
+                reference_room += source->operator_calls + (source->callee != 0);
+        }
+    uint64_t* refs = BUSTER_ARENA_PUSH_ARRAY(scratch, uint64_t, reference_room);
+    uint64_t* sorted = BUSTER_ARENA_PUSH_ARRAY(scratch, uint64_t, reference_room);
+    uint32_t* canonical = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, reference_room);
+    if (!refs || !sorted || !canonical) BUSTER_SOURCE_CONTROL_DECLINE("reference-room",0);
+    const uint32_t count = check_program_references(&p, writer.entries, writer.entry_count, close + 1,
+                                                     unit->seen, marks, writer.fold_stack, refs, unit->needed);
+    if (p.status != CHECK_PROGRAM_OK) BUSTER_SOURCE_CONTROL_DECLINE("control-failure",p.status);
+    // Only reached builtin uses contribute helper records, as in the complete unit's check_program_finish.
+    p.builtin_count=check_program_builtins(graph,marks,NULL,false);
+    if(p.builtin_count!=0)
+    {
+        p.builtin_nodes=BUSTER_ARENA_PUSH_ARRAY(scratch,uint32_t,p.builtin_count);
+        if(!p.builtin_nodes) abort();
+        check_program_builtins(graph,marks,p.builtin_nodes,false);
+    }
+    uint32_t varying = 0;
+    for (uint32_t i = 1; i < count; i += 1) varying |= (uint32_t)((refs[i] ^ refs[0]) >> 32);
+    const uint64_t* order = c_bindings_sort(refs, sorted, count, true, varying);
+    for (uint32_t i = 0; i < count; i += 1) canonical[i] = (uint32_t)(order[i] >> 32);
+    if (input->source_bodies == NULL) check_source_control_record("local", close, writer.entries, writer.count, 0, canonical, count, &p);
+    if (input->source_bodies != NULL || getenv("BUSTER_LOCAL_CONTROL_NATIVE") != NULL)
+    {
+        const uint32_t drops = writer.dropped_range_count;
+        uint64_t* ordered = drops > 1 ? BUSTER_ARENA_PUSH_ARRAY(scratch, uint64_t, drops) : NULL;
+        if (drops > 1 && ordered == NULL) return;
+        uint32_t varying_ranges = 0;
+        for (uint32_t i = 1; i < drops; i += 1)
+        {
+            varying_ranges |= (uint32_t)((writer.dropped_ranges[0] ^ writer.dropped_ranges[i]) >> 32);
+        }
+        p.dropped_ranges = drops > 1 ? c_bindings_sort(writer.dropped_ranges, ordered, drops, !BUSTER_SCALAR_PATH(parser->options.scalar), varying_ranges) : writer.dropped_ranges;
+        p.dropped_range_count = drops;
+        check_live_control_native(unit,&p,reader,opening,close,writer.entries,writer.entry_count,writer.count,canonical,count,&writer,scratch);
+        if (unit->object_symbols != NULL)
+        {
+            const uint32_t declaration=check_sparse_get(input->body_declarations,opening);
+            if (declaration < input->token_count) unit->object_symbols[input->objects[declaration]]=0;
+            for (uint32_t i=0; i<count; i+=1) unit->object_symbols[canonical[i]]=0;
+        }
+    }
+}
+
+#undef BUSTER_SOURCE_CONTROL_DECLINE
diff --git a/src/buster/compiler/c_check_source_linear_program.c b/src/buster/compiler/c_check_source_linear_program.c
new file mode 100644
index 000000000..31f0a30e3
--- /dev/null
+++ b/src/buster/compiler/c_check_source_linear_program.c
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+
+// These are direct-call symbols from the checked source operator rows. The ordinary
+// program publishes unique canonical object numbers in ascending order.
+static bool check_source_linear_reference(uint32_t* references, uint32_t* count, uint32_t object, uint32_t limit)
+{
+    if (object == 0)
+        return true;
+    if (object >= limit)
+        return false;
+    uint32_t at = 0;
+    while (at < *count && references[at] < object)
+        at += 1;
+    if (at < *count && references[at] == object)
+        return true;
+    if (*count >= 64)
+        return false;
+    memmove(references + at + 1, references + at, (*count - at) * sizeof(*references));
+    references[at] = object;
+    *count += 1;
+    return true;
+}
+
+// A source-owned statement followed by another, or by the body's final return,
+// is already a complete linear control program. Account for each physical token
+// when proving that the native emitter can use these entries without the CFG builder.
+static bool check_source_linear_native(CheckSourceControlUnit* unit, CheckInputReader* reader, CheckStream* stream,
+                                       uint32_t open, uint32_t close, Arena* scratch)
+{
+    const Parser* parser = reader->parser;
+    const CheckInput* input = reader->output;
+    const uint32_t limit = input->token_count;
+    if (close - open > 512 || check_sparse_next(input->initializer_begins, open, close) < close)
+        return false;
+    const uint32_t declaration = check_sparse_get(input->body_declarations, open);
+    if (declaration >= limit || check_input_attributes_at(input, declaration) ||
+        (input->function_flags && (input->function_flags[declaration] &
+            ~(CHECK_INPUT_FUNCTION_INLINE | CHECK_INPUT_FUNCTION_EXTERN | CHECK_INPUT_FUNCTION_EXTERNAL_DEFINITION))))
+        return false;
+    const TypeId result = type_return(reader->types, input->declared_types[declaration]);
+    if (!check_source_operator_width(reader->types, result) && result != BUSTER_TYPE_VOID)
+        return false;
+    CheckControl entries[64];
+    uint32_t references[64], n = 0, refs = 0;
+    bool returned = false;
+    for (uint32_t first = open + 1; first < close;)
+    {
+        if (returned || n >= 63)
+            return false;
+        const bool ret = parser->tokens.kinds[first] == PARSE_KIND_RETURN;
+        const bool expr = parser->tokens.kinds[first] == PARSE_KIND_IDENTIFIER;
+        if ((!ret && !expr) || (ret && parser->tree.roles[first] != PARSE_ROLE_RETURN))
+            return false;
+        uint32_t end = first;
+        while (end < close && parser->tokens.kinds[end] != PARSE_KIND_SEMI)
+        {
+            if (parser->tokens.kinds[end] == PARSE_KIND_L_BRACE || parser->tokens.kinds[end] == PARSE_KIND_R_BRACE)
+                return false;
+            end += 1;
+        }
+        if (end >= close || parser->tree.roles[end] != PARSE_ROLE_TERMINATOR)
+            return false;
+        const uint32_t token = ret ? first : end;
+        const uint32_t row = check_sparse_get(input->source_statement_tokens, token);
+        if (row >= input->source_statement_count || (ret && parser->tree.parents[first] != end))
+            return false;
+        const CheckSourceStatement* statement = input->source_statements + row;
+        if (!check_source_linear_reference(references, &refs, statement->callee, limit))
+            return false;
+        for (uint32_t i = 0; i < statement->operator_count; i += 1)
+            if (statement->operators[i].op == CHECK_OP_CALL &&
+                !check_source_linear_reference(references, &refs, (uint32_t)statement->operators[i].value, limit))
+                return false;
+        entries[n++] = (CheckControl){.node = BUSTER_CHECK_NONE, .token = token,
+                                      .target = ret ? BUSTER_CHECK_NONE : row,
+                                      .kind = ret ? CHECK_CONTROL_RETURN : CHECK_CONTROL_SOURCE_STATEMENT};
+        returned = ret;
+        first = end + 1;
+    }
+    if (!n || (!returned && result != BUSTER_TYPE_VOID))
+        return false;
+    entries[n++] = (CheckControl){.kind = CHECK_CONTROL_END, .node = BUSTER_CHECK_NONE, .token = close, .target = BUSTER_CHECK_NONE};
+    CheckInitializers empty = {.token_count = limit};
+    CheckProgram p = {.input = input, .stream = stream, .parser = parser, .types = reader->types, .object_count = limit + 1,
+                      .object_labelled = unit->object_labelled, .initializers = &empty, .identifiers = reader->pp->table};
+    CheckControlWriter writer = {.program = &p, .parser = parser, .entries = entries, .count = n, .entry_count = n, .capacity = n};
+    check_live_control_native(unit, &p, reader, open, close, entries, n, n, references, refs, &writer, scratch);
+    if (unit->object_symbols)
+    {
+        unit->object_symbols[input->objects[declaration]] = 0;
+        for (uint32_t i = 0; i < refs; i += 1)
+            unit->object_symbols[references[i]] = 0;
+    }
+    return check_input_source_body(input->source_bodies, open) != NULL;
+}
diff --git a/src/buster/compiler/c_check_source_operators.c b/src/buster/compiler/c_check_source_operators.c
new file mode 100644
index 000000000..63480e43c
--- /dev/null
+++ b/src/buster/compiler/c_check_source_operators.c
@@ -0,0 +1,346 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+
+// An accepted right operand is already one contiguous parser subtree. Give its
+// checked postorder straight to the statement lowerer. The stack lives only
+// while deciding admission. A refused tree leaves ordinary visits intact.
+#define BUSTER_SOURCE_OPERATOR_LIMIT 64u
+
+static bool check_source_operator_local(const CheckInputReader* reader, uint32_t token)
+{
+    const CheckInput* in = reader->output;
+    const uint32_t decl = in->declarations[token];
+    return decl < in->token_count && check_sparse_get(in->declaration_bodies, decl) < in->token_count &&
+           in->objects[decl] == decl + 1 && !check_input_bit(in->declaration_bits, decl, BUSTER_CHECK_BITS_STATIC | BUSTER_CHECK_BITS_THREAD_LOCAL);
+}
+
+static bool check_source_operator_width(const TypeTable* types, TypeId type)
+{
+    return check_return_width(types, type) || check_return_extension(types, type) || type == BUSTER_TYPE_BOOL;
+}
+
+static bool check_source_operator_leaf(CheckInputReader* reader, uint32_t token, CheckSourceOperator* result)
+{
+    const Parser* p = reader->parser;
+    const CheckInput* in = reader->output;
+    if (p->tokens.kinds[token] == PARSE_KIND_NUMBER && p->tokens.names[token] == 0)
+    {
+        const uint8_t* bytes;
+        uint32_t length;
+        if (!check_input_spelling(reader, token, &bytes, &length) || !length || length > 32)
+            return false;
+        if (length == 1 && bytes[0] >= '0' && bytes[0] <= '9')
+        {
+            *result = (CheckSourceOperator){.op = CHECK_OP_VALUE, .type = BUSTER_TYPE_INT, .value = bytes[0] - '0'};
+            return true;
+        }
+        // Restrict the fast path to ordinary integer spellings. Richer encodings, floating
+        // suffixes, separated digits and bit-precise literals retain the diagnostic reader.
+        for (uint32_t k = 0; k < length; k += 1)
+        {
+            const uint8_t c = bytes[k], lower = c | 32;
+            if (!((c >= '0' && c <= '9') || (lower >= 'a' && lower <= 'f') || lower == 'x' || lower == 'u' || lower == 'l'))
+                return false;
+        }
+        CheckLiteral literal = {0};
+        const uint64_t mark = reader->scratch->length;
+        check_literal_number(bytes, length, reader->scratch, &literal);
+        arena_pop_to(reader->scratch, mark);
+        if (!literal.valid || literal.resource || literal.real || literal.imaginary || literal.range || literal.bit_width ||
+            !check_return_width(reader->types, literal.type))
+            return false;
+        *result = (CheckSourceOperator){.op = CHECK_OP_VALUE, .type = literal.type, .value = literal.integer};
+        return true;
+    }
+    if (p->tokens.kinds[token] != PARSE_KIND_IDENTIFIER || !check_source_operator_local(reader, token))
+        return false;
+    const uint32_t decl = in->declarations[token];
+    const TypeId type = in->declared_types[decl];
+    if (in->declaration_kinds[decl] != C_BINDING_OBJECT || type_qualifiers(type) || !check_source_operator_width(reader->types, type) ||
+        check_input_attributes_at(in, decl) != NULL || BUSTER_CHECK_RARE(reader, declaration_flags, decl))
+        return false;
+    *result = (CheckSourceOperator){.op = CHECK_OP_VALUE, .type = type, .object = true, .value = in->objects[decl]};
+    return true;
+}
+
+static bool check_source_operator_member(CheckInputReader* reader, uint32_t token, TypeId pointer, CheckSourceOperator* row)
+{
+    const Parser* p = reader->parser;
+    const TypeTable* types = reader->types;
+    const CheckInput* in = reader->output;
+    if (p->tokens.kinds[token] != PARSE_KIND_ARROW || p->tree.roles[token + 1] != PARSE_ROLE_MEMBER ||
+        type_kind(types, pointer) != BUSTER_TYPE_KIND_POINTER || in->noderef_member_count || in->noderef_declaration_count || !reader->tag_completions)
+        return false;
+    const TypeId record = type_element(types, pointer);
+    if (type_kind(types, record) != BUSTER_TYPE_KIND_STRUCT || type_qualifiers(record) || !type_is_complete(types, record))
+        return false;
+    const uint32_t tag = types->types.index[type_index(record)];
+    if (reader->tag_completions[tag] > token || types->tags.packed[tag] || types->tags.ms_struct[tag])
+        return false;
+    uint64_t bits = 0;
+    uint32_t qualifiers = 0;
+    const uint32_t name = p->tokens.names[token + 1];
+    const uint32_t member = type_lookup_member(types, record, name, &bits, &qualifiers);
+    if (!member || member >= types->members.count || member - types->tags.member_begin[tag] >= types->tags.member_count[tag] ||
+        types->members.name[member] != name || types->members.flags[member] || qualifiers || (bits & 7) ||
+        check_marked_member(in->marked_members, in->marked_member_count, member) != NULL)
+        return false;
+    const TypeId result = types->members.type[member];
+    if (type_qualifiers(result) || !check_source_operator_width(types, result))
+        return false;
+    *row = (CheckSourceOperator){.op = CHECK_OP_ARROW, .type = result, .value = bits / 8};
+    return true;
+}
+
+static bool check_source_operator_expression_depth(CheckInputReader*, uint32_t, uint32_t, TypeId, CheckSourceOperator*, uint32_t*, uint32_t);
+
+static bool check_source_operator_arguments(CheckInputReader* reader, uint32_t first, uint32_t close, const CheckSourceStatement* target,
+                                            CheckSourceOperator* rows, uint32_t* used, uint32_t nesting)
+{
+    const Parser* p = reader->parser;
+    uint32_t count = 0, at = first + 1;
+    const TypeId* formal = type_parameters(reader->types, target->function, &count);
+    for (uint32_t i = 0; i < count; i += 1)
+    {
+        uint32_t end = at;
+        for (uint32_t level = 0; end < close; end += 1)
+        {
+            const uint8_t kind = p->tokens.kinds[end];
+            if (!level && kind == PARSE_KIND_COMMA)
+                break;
+            if (kind == PARSE_KIND_L_PAREN)
+                level += 1;
+            if (kind == PARSE_KIND_R_PAREN && level)
+                level -= 1;
+        }
+        if ((end < close) != (i + 1 < count) || !check_return_width(reader->types, formal[i]) ||
+            !check_source_operator_expression_depth(reader, at, end, type_unqualified(formal[i]), rows, used, nesting))
+            return false;
+        at = end + (end < close);
+    }
+    return at == close;
+}
+
+static bool check_source_operator_expression_depth(CheckInputReader* reader, uint32_t first, uint32_t end, TypeId wanted,
+                                                    CheckSourceOperator* rows, uint32_t* count, uint32_t nesting)
+{
+    const Parser* p = reader->parser;
+    const uint32_t root = check_input_range_root(reader, first, end);
+    if (root == BUSTER_CHECK_NONE)
+        return false;
+    const uint32_t last = reader->postorder_positions[root];
+    const uint32_t start = last + 1 - (end - first);
+    uint8_t stack[BUSTER_SOURCE_OPERATOR_LIMIT];
+    uint64_t reads[BUSTER_SOURCE_OPERATOR_LIMIT];
+    uint32_t used = *count, depth = 0;
+    for (uint32_t pos = start; pos <= last; pos += 1)
+    {
+        const uint32_t t = reader->postorder[pos];
+        const uint8_t role = p->tree.roles[t], kind = p->tokens.kinds[t];
+        if (role == PARSE_ROLE_OPEN_GROUP || role == PARSE_ROLE_CLOSE_GROUP || role == PARSE_ROLE_MEMBER)
+            continue;
+        CheckSourceOperator row = {0};
+        uint64_t sources = 0;
+        if (role == PARSE_ROLE_OPERAND && reader->output->source_operator_call_mode && t + 1 < end &&
+            p->tree.roles[t + 1] == PARSE_ROLE_OPEN_CALL)
+        {
+            const uint32_t open = t + 1, close = p->tree.parents[open];
+            CheckSourceStatement target = {0};
+            if (nesting >= 4 || close <= open || close >= end || p->tree.roles[close] != PARSE_ROLE_CLOSE_CALL ||
+                reader->postorder_positions[close] != pos + close - t || check_input_range_root(reader, t, close + 1) != close ||
+                !check_source_call_target(reader, open, true, &target))
+                return false;
+            const TypeId result = type_return(reader->types, target.function);
+            if (!check_return_width(reader->types, result) || !check_source_operator_arguments(reader, open, close, &target, rows, &used, nesting + 1))
+                return false;
+            row = (CheckSourceOperator){.op = CHECK_OP_CALL, .type = result, .value = target.callee | (uint64_t)target.function << 32};
+            sources = UINT64_MAX;
+            pos = reader->postorder_positions[close];
+        }
+        else if (role == PARSE_ROLE_OPERAND)
+        {
+            if (!check_source_operator_leaf(reader, t, &row))
+                return false;
+            if (row.object)
+                sources = UINT64_C(1) << (row.value & 63);
+        }
+        else if (depth && role == PARSE_ROLE_MEMBER_OPERATOR)
+        {
+            sources = reads[stack[depth - 1]];
+            if (t + 1 >= end || !check_source_operator_member(reader, t, rows[stack[--depth]].type, &row))
+                return false;
+        }
+        else if (depth && role == PARSE_ROLE_PREFIX)
+        {
+            sources = reads[stack[depth - 1]];
+            CheckSourceOperator* arg = rows + stack[--depth];
+            if ((type_kind(reader->types, arg->type) != BUSTER_TYPE_KIND_INTEGER && !(kind == PARSE_KIND_EXCLAIM && type_kind(reader->types, arg->type) == BUSTER_TYPE_KIND_POINTER)) || (!arg->object && arg->op == CHECK_OP_VALUE))
+                return false;
+            const CheckOp op = kind == PARSE_KIND_PLUS ? CHECK_OP_POSITIVE : kind == PARSE_KIND_MINUS ? CHECK_OP_NEGATIVE :
+                               kind == PARSE_KIND_TILDE ? CHECK_OP_BIT_NOT : kind == PARSE_KIND_EXCLAIM ? CHECK_OP_NOT : CHECK_OP_COUNT;
+            if (op == CHECK_OP_COUNT)
+                return false;
+            row = (CheckSourceOperator){.op = op, .type = op == CHECK_OP_NOT ? BUSTER_TYPE_INT : type_promote(reader->types, arg->type), .value = arg->type};
+            if (op != CHECK_OP_NOT)
+                arg->wanted = row.type;
+        }
+        else if (depth >= 2 && role >= PARSE_ROLE_MULTIPLICATIVE && role < PARSE_ROLE_ASSIGN)
+        {
+            const uint64_t left_reads = reads[stack[depth - 2]], right_reads = reads[stack[depth - 1]];
+            sources = left_reads | right_reads;
+            CheckSourceOperator* rhs = rows + stack[--depth];
+            CheckSourceOperator* lhs = rows + stack[--depth];
+            const CheckOp op = check_input_binary(kind);
+            const bool shift = op == CHECK_OP_SHIFT_LEFT || op == CHECK_OP_SHIFT_RIGHT;
+            const bool divide = op == CHECK_OP_DIVIDE || op == CHECK_OP_REMAINDER;
+            const bool compare = op >= CHECK_OP_LESS && op <= CHECK_OP_NOT_EQUAL;
+            if (!(op == CHECK_OP_ADD || op == CHECK_OP_SUBTRACT || op == CHECK_OP_MULTIPLY || compare || shift || divide ||
+                  (op >= CHECK_OP_BIT_AND && op <= CHECK_OP_BIT_XOR)) ||
+                type_kind(reader->types, lhs->type) != BUSTER_TYPE_KIND_INTEGER || type_kind(reader->types, rhs->type) != BUSTER_TYPE_KIND_INTEGER ||
+                (lhs->op == CHECK_OP_VALUE && !lhs->object && rhs->op == CHECK_OP_VALUE && !rhs->object))
+                return false;
+            // Keep tautological comparisons and invalid constant shift counts with their diagnostic producer.
+            if ((compare && (left_reads & right_reads)) || (divide && !right_reads && !(rhs->value & (rhs->value - 1))) ||
+                (shift && !right_reads && rhs->value >= type_size(reader->types, type_promote(reader->types, lhs->type)) * 8))
+                return false;
+            const TypeId common = shift ? type_promote(reader->types, lhs->type) : type_usual_arithmetic(reader->types, lhs->type, rhs->type);
+            lhs->wanted = common;
+            rhs->wanted = shift ? type_promote(reader->types, rhs->type) : common;
+            row = (CheckSourceOperator){.op = op, .type = compare ? BUSTER_TYPE_INT : common};
+        }
+        else
+            return false;
+        if (used >= BUSTER_SOURCE_OPERATOR_LIMIT)
+            return false;
+        rows[used] = row;
+        reads[used] = sources;
+        stack[depth++] = (uint8_t)used++;
+    }
+    if (depth != 1)
+        return false;
+    CheckSourceOperator* result = rows + stack[0];
+    if (!wanted)
+    {
+        if (!result->object && result->op == CHECK_OP_VALUE)
+            return false;
+    }
