         if (pp_collecting(pp))
         {
             pp_collect_step(pp);
@@ -9051,6 +9066,9 @@ static void pp_skip_group(Preprocessor* pp, PPContext* context, uint32_t d)
         context->position = data->directive_hash[next];
         context->next_directive = next;
     }
+#ifdef BUSTER_PP_STRUCTURAL_EXPERIMENT
+    pp_projection_skip(data,d,context->next_directive,context->hidden_directives);
+#endif
     if (pp->conditional_count > context->conditional_base)
     {
         pp->conditionals[pp->conditional_count - 1].skipping = true;
