+    STORAGE_COLUMN(sample, "graph", graph, operand1, graph->capacity, graph->count);
+    STORAGE_COLUMN(sample, "graph", graph, operand2, graph->capacity, graph->count);
+    STORAGE_COLUMN(sample, "graph", graph, leaf_slots, graph->capacity, graph->count);
+    STORAGE_COLUMN(sample, "graph", graph, types, graph->capacity, graph->count);
+    STORAGE_COLUMN(sample, "graph", graph, members, graph->capacity, graph->count);
+    STORAGE_COLUMN(sample, "graph", graph, contexts, graph->capacity, graph->count);
+    STORAGE_COLUMN(sample, "graph", graph, source_positions, graph->capacity, graph->count);
+    STORAGE_COLUMN(sample, "graph", graph, argument_offsets, graph->capacity, graph->count);
+    STORAGE_COLUMN(sample, "graph", graph, argument_counts, graph->capacity, graph->count);
+    STORAGE_COLUMN(sample, "graph", graph, recorded_pure, graph->capacity, graph->count);
+    STORAGE_COLUMN(sample, "graph", graph, warning_suppressed, graph->capacity, graph->count);
+    STORAGE_COLUMN(sample, "graph", graph, fp_environments, graph->capacity, graph->count);
+    STORAGE_COLUMN(sample, "graph", graph, leaf_records, graph->capacity, graph->leaf_count);
+    STORAGE_COLUMN(sample, "graph", graph, leaf_payloads, graph->leaf_payload_capacity, graph->leaf_payload_count);
+    STORAGE_COLUMN(sample, "graph", graph, argument_nodes, graph->argument_capacity, graph->argument_count);
+    STORAGE_COLUMN(sample, "graph", graph, argument_tokens, graph->argument_capacity, graph->argument_count);
+}
