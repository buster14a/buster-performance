+// Measurement-only resident-page view, restricted to the requested compilation.
+typedef struct CheckStorageSample { FILE* out; int pages; size_t page; const char* stage; } CheckStorageSample;
+static CheckStorageSample check_storage_start(const char* stage)
+{
+    const char* file = getenv("BUSTER_GRAPH_STORAGE");
+    CheckStorageSample sample = { .pages = -1, .stage = stage };
+    if (file != NULL)
+    {
+        sample.out = fopen(file, "a");
+        sample.pages = open("/proc/self/pagemap", O_RDONLY | O_CLOEXEC);
+        sample.page = (size_t)sysconf(_SC_PAGESIZE);
+    }
+    return sample;
+}
+static void check_storage_done(CheckStorageSample* sample)
+{
+    if (sample->out != NULL) fclose(sample->out);
+    if (sample->pages >= 0) close(sample->pages);
+}
+static void check_storage_column(CheckStorageSample* sample, const char* group, const char* name, const void* ptr,
+                                 uint64_t capacity, uint64_t used, size_t stride)
+{
+    if (sample->out == NULL || ptr == NULL || capacity == 0) return;
+    const uint64_t base = (uintptr_t)ptr, end = base + capacity * stride, past_used = base + used * stride;
+    const size_t size = sample->page;
+    const uint64_t first = base / size, past = (end + size - 1) / size;
+    uint64_t now = first, resident = 0, exclusive = 0, tail_exclusive = 0;
+    while (now < past)
+    {
+        uint64_t entries[256];
+        const uint64_t block = past - now < 256 ? past - now : 256;
+        const ssize_t length = (ssize_t)(block * sizeof(*entries));
+        if (pread(sample->pages, entries, (size_t)length, (off_t)(now * sizeof(*entries))) != length) abort();
+        for (uint64_t j = 0; j < block; j++)
+        {
+            const uint64_t lo = (now+j) * size;
+            const uint64_t begin = lo > base ? lo : base;
+            const uint64_t stop = lo + size < end ? lo + size : end;
+            const bool present = (entries[j] >> 63) != 0;
+            const bool private = present && ((entries[j] >> 56) & 1u) != 0;
+            resident += present ? stop-begin : 0;
+            exclusive += private ? stop-begin : 0;
+            const uint64_t tail = begin > past_used ? begin : past_used;
+            tail_exclusive += private && tail < stop ? stop - tail : 0;
+        }
+        now += block;
+    }
+    fprintf(sample->out, "%s\t%s\t%s\t%" PRIu64 "\t%" PRIu64 "\t%zu\t%" PRIu64 "\t%" PRIu64 "\t%" PRIu64 "\n",
+            sample->stage, group, name, capacity, used, stride, resident, exclusive, tail_exclusive);
+}
+#define STORAGE_COLUMN(sample, group, owner, field, cap, used) check_storage_column(sample, group, #field, (owner)->field, cap, used, sizeof(*(owner)->field))
