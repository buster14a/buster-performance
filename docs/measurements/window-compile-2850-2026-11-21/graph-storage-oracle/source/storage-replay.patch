+static void node_storage_replay(const CheckProgram* program, const NodeFrontTypes* typed)
+{
+    const char* mode = getenv("NODE_PROOF_PACKED_REPLAY");
+    if (mode == NULL) return;
+    const CheckGraph* old = &program->input->graph;
+    Arena setup = arena_reserve(UINT64_C(1) << 30);
+    Arena graph_arena = arena_reserve(UINT64_C(1) << 32), output = arena_reserve(UINT64_C(1) << 32), scratch = arena_reserve(UINT64_C(1) << 32);
+    uint8_t* states = BUSTER_ARENA_PUSH_ARRAY(&setup, uint8_t, old->count);
+    memset(states, 0, old->count);
+    bool packed = strcmp(mode, "pack") == 0;
+    uint8_t* receipts = BUSTER_ARENA_PUSH_ARRAY(&setup, uint8_t, old->count);
+    memset(receipts,0,old->count);
+    for (uint32_t i=0; i<old->const_warning_count; i++) receipts[old->const_warnings[i].node]=1;
+    uint32_t vetoed=0;
+    for (const NodeWindowProofPart* p = packed ? typed->proof_parts : NULL; p != NULL; p=p->next)
+    {
+        if (p->count <= 2) continue;
+        bool external = false;
+        for (uint32_t j = 0; j+1 < p->count; j++) external |= receipts[p->items[j].node]!=0;
+        if (external) {vetoed++; continue;}
+        const uint32_t root = p->items[p->count-2].node;
+        for (uint32_t i=0; i+2<p->count; i++) states[p->items[i].node] = 1;
+        states[root] = 2;
+    }
+    check_storage_states = states;
+    check_storage_expected = program->stream;
+    CheckGraph graph = { 0 }; uint32_t bodies = 0; uint32_t* mapping = NULL;
+    bool ok = check_source_body_graph(&graph, program->input, program->parser, NULL, NULL, &graph_arena, &scratch, &bodies, &mapping);
+    check_storage_states = NULL; check_storage_expected = NULL;
+    graph.const_values = old->const_values;
+    if (old->const_warning_count != 0)
+    {
+        CheckConstWarning* warnings = BUSTER_ARENA_PUSH_ARRAY(&graph_arena, CheckConstWarning, old->const_warning_count);
+        graph.const_warnings=warnings; graph.const_warning_count=old->const_warning_count;
+        for(uint32_t i=0; i<old->const_warning_count; i++)
+        {
+            warnings[i]=old->const_warnings[i];
+            warnings[i].node=mapping[warnings[i].node];
+            assert(warnings[i].node!=BUSTER_CHECK_NONE);
+        }
+        fprintf(stderr,"storage-replay-extra: relocated-constant-warnings=%u vetoed-groups=%u\n",old->const_warning_count,vetoed);
+    }
+    CheckStream stream = { 0 };
+    // Source-driver -c passes the already recorded graph and a fresh output, with optional --check-transitions disabled.
+    graph.recorded_pure=BUSTER_ARENA_PUSH_ARRAY(&graph_arena,uint8_t,(uint64_t)graph.count+1);
+    uint32_t failed = BUSTER_CHECK_NONE;
+    ok = ok && check_graph_validate(&graph, graph.recorded_pure, &graph.recorded, &failed);
+    graph.recorded_nodes=graph.count; graph.recorded_ready=ok;
+    const CheckOptions options = { .fresh_output = true };
+    const int leader=node_storage_counter(PERF_TYPE_HARDWARE,PERF_COUNT_HW_CPU_CYCLES,-1);
+    const int retired=node_storage_counter(PERF_TYPE_HARDWARE,PERF_COUNT_HW_INSTRUCTIONS,leader);
+    uint64_t cycles=0, instructions=0;
+    struct rusage before,after;
+    getrusage(1 /* Linux RUSAGE_THREAD */,&before);
+    const uint64_t start = __rdtsc();
+    if (leader>=0) ioctl(leader,PERF_EVENT_IOC_ENABLE,PERF_IOC_FLAG_GROUP);
+    if (ok) ok = check_graph_run((TypeTable*)program->types,&graph,&output,&scratch,&options,&stream);
+    if (leader>=0) ioctl(leader,PERF_EVENT_IOC_DISABLE,PERF_IOC_FLAG_GROUP);
+    const uint64_t elapsed = __rdtsc()-start;
+    getrusage(1 /* Linux RUSAGE_THREAD */,&after);
+    if(leader>=0) { if(read(leader,&cycles,sizeof(cycles))!=sizeof(cycles))abort(); close(leader); }
+    if(retired>=0) { if(read(retired,&instructions,sizeof(instructions))!=sizeof(instructions))abort(); close(retired); }
+    fprintf(stderr,"storage-phase: mode=%s usercycles=%" PRIu64 " instructions=%" PRIu64 " minorfaults=%ld userus=%ld sysus=%ld\n",mode,cycles,instructions,
+            after.ru_minflt-before.ru_minflt,(after.ru_utime.tv_sec-before.ru_utime.tv_sec)*1000000L+after.ru_utime.tv_usec-before.ru_utime.tv_usec,
+            (after.ru_stime.tv_sec-before.ru_stime.tv_sec)*1000000L+after.ru_stime.tv_usec-before.ru_stime.tv_usec);
+    uint32_t wrong_values=0, wrong_diagnostics=0, wrong_warnings=0, wrong_conversions=0, wrong_member=0, roots=0, retained=0;
+    for (uint32_t i = 0; ok && i < old->count; i++)
+    {
+        const uint32_t n = mapping[i];
+        if (states[i] == 1) { assert(n == BUSTER_CHECK_NONE); continue; }
+        assert(n < stream.count && graph.tokens[n]==old->tokens[i]);
+        retained++; roots += states[i]==2;
+        CheckValue expected = check_stream_value(program->stream, i);
+        if (expected.fault && expected.fault_node < old->count) expected.fault_node=mapping[expected.fault_node];
+        const CheckValue got = check_stream_value(&stream, n);
+        const bool same = check_test_value_equal(&expected, &got);
+        if (!same && wrong_values < 4)
+        {
+            fprintf(stderr,"storage-replay-diff: old=%u node=%u op=%u token=%u root=%u type=%u/%u flags=%u/%u integer=%" PRIu64 "/%" PRIu64 "\n",
+                    i,n,old->ops[i],old->tokens[i],states[i]==2,expected.type,got.type,expected.flags,got.flags,(uint64_t)expected.integer,(uint64_t)got.integer);
+        }
+        wrong_values+=!same;
+        wrong_diagnostics+=program->stream->diagnostics[i]!=stream.diagnostics[n];
+        wrong_warnings+=program->stream->warnings[i]!=stream.warnings[n] || program->stream->warning_ignored[i]!=stream.warning_ignored[n];
+        if (states[i] != 2)
+        {
+            wrong_member += program->stream->member_offsets[i]!=stream.member_offsets[n];
+            wrong_conversions += memcmp(program->stream->conversions+i,stream.conversions+n,sizeof(CheckNodeConversions)) != 0;
+        }
+    }
+    CheckStorageSample sample=check_storage_start(mode);
+    check_storage_graph(&sample,&graph);
+    if(ok)check_storage_stream(&sample,&stream);
+    check_storage_done(&sample);
+    fprintf(stderr,"storage-replay: mode=%s ok=%u graph=%u leaves=%u leaf-rest=%u stream-payloads=%u roots=%u retained=%u values=%u diagnostics=%u warnings=%u conversions=%u member-offsets=%u reports=%u/%u effects=%u/%u ticks=%" PRIu64 " graph-bytes=%" PRIu64 " stream-bytes=%" PRIu64 "\n",
+            mode,ok,graph.count,graph.leaf_count,graph.leaf_payload_count,stream.payload_count,roots,retained,wrong_values,wrong_diagnostics,
+            wrong_warnings,wrong_conversions,wrong_member,stream.report_count,program->stream->report_count,stream.effect_count,program->stream->effect_count,
+            elapsed,graph_arena.length,output.length);
+    arena_release(&setup);arena_release(&graph_arena);arena_release(&output);arena_release(&scratch);
+}
