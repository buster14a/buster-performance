+
+#define NINE 9
+int positive(void) { return 18 + 24; }
+int negative(void) { return 8 - 50; }
+int negated(void) { return -42; }
+int multiplied(void) { return NINE * 7; }
+int zero(void) { return 0; }
+int literal(void) { return 4; }
