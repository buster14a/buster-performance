+// Publish an immutable function's fields directly to its newly defined link atom. Runtime functions
+// and jump tables have their final symbols now. The producer checked the field bounds and cleared
+// their bytes while the encoder owned the fragment.
+static bool check_source_link_fields(Link* link, AtomId atom, const CheckProgram* program, uint32_t b,
+                                     const CheckEmitBody* body, const CheckLowerShared* shared, const CheckProgramLowered* lowered)
+{
+    const CheckSourceBody* source = body->source_fields;
+    const CheckSourceEncoded* encoded = source->encoded;
+    LinkFixups* fixups = &link->fixups;
+    const uint32_t first = fixups->count;
+    const uint32_t count = encoded->reference_count;
+    if (count == 0) return true;
+    if (count > fixups->capacity - first || link->atoms.fixup_count[atom] != 0) return false;
+    for (uint32_t i = 0; i < count; i += 1)
+    {
+        const CheckSourceField field = encoded->fields[i];
+        const uint32_t extra = field.target - source->symbols - 1;
+        SymbolId target = field.target <= source->symbols ? program->object_symbols[source->objects[field.target-1]] :
+                          extra < source->runtime_count ? body->field_runtime_targets[extra] : body->field_table_base + extra - source->runtime_count;
+        const uint32_t runtime = target - shared->provisional_runtimes;
+        if (body->relocate_runtime && runtime < CHECK_LOWER_RUNTIMES) target = lowered->runtime_symbols[runtime];
+        const uint32_t table = target - shared->provisional_tables;
+        if (body->relocate_tables && table < lowered->table_count) target = lowered->case_symbol_base + table;
+        if (target == 0 || target >= link->symbols.count) return false;
+        fixups->offset[first + i] = field.offset;
+        fixups->target[first + i] = target;
+        fixups->kind[first + i] = field.kind;
+        fixups->addend[first + i] = field.addend;
+    }
+    link->atoms.fixup_begin[atom] = first;
+    link->atoms.fixup_count[atom] = count;
+    fixups->count += count;
+    return true;
+}
