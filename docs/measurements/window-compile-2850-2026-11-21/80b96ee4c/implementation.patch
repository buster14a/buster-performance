+static inline void check_input_spill_operand(CheckInputReader* reader, const CheckInputPendingOperand* item)
+{
+    reader->first_value[item->token] = item->values.first;
+    reader->last_value[item->token] = item->values.last;
+    reader->value_counts[item->token] = item->values.count;
+}
+
+// Only the ordinary visit needs empty children represented, for instance a variably modified typeof
+// that selects its children by source position. Restore its direct children's original lists.
+static void check_input_spill_children(CheckInputReader* reader, const CheckInputBatch* batch, uint32_t token, uint32_t first)
+{
+    for (uint32_t child = reader->first_child[token]; child != BUSTER_CHECK_NONE; child = reader->next_child[child])
+    {
+        reader->first_value[child] = BUSTER_CHECK_NONE;
+    }
+    for (uint32_t i = first; i < batch->pending_count; i += 1)
+    {
+        check_input_spill_operand(reader, batch->pending + i);
+    }
+}
+
+static inline void check_input_pending_result(CheckInputReader* reader, CheckInputBatch* batch, uint32_t token)
+{
+    const uint32_t parent = reader->parser->tree.parents[token];
+    if (batch->produced.count != 0 && parent < reader->parser->tokens.count)
+    {
+        const uint8_t visit = reader->visits[parent];
+        const uint8_t dropped = BUSTER_CHECK_EXPRESSION_ACTS | CHECK_INPUT_CODE_DROP << BUSTER_CHECK_EXPRESSION_CODE_SHIFT;
+        if ((visit & BUSTER_CHECK_EXPRESSION_ACTS) != 0 && visit != dropped)
+        {
+            const CheckInputPendingOperand item = { .token = token, .parent = parent, .values = batch->produced };
+            if (batch->pending_count < BUSTER_CHECK_PENDING_OPERANDS)
+            {
+                batch->pending[batch->pending_count++] = item;
+            }
+            else
+            {
+                // Continue this unit with the token columns after an exceptionally wide or deep tree.
+                // Only these open values can be read by a later parent.
+                memset(reader->first_value, 0xff, ((uint64_t)reader->parser->tokens.count + 1) * sizeof(uint32_t));
+                for (uint32_t i = 0; i < batch->pending_count; i += 1)
+                {
+                    check_input_spill_operand(reader, batch->pending + i);
+                }
+                check_input_spill_operand(reader, &item);
+                batch->pending = NULL;
+            }
+        }
+    }
+}
