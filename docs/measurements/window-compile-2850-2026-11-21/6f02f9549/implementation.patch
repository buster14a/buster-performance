+// The complete leaf first written for this declaration at this use type. Only
+// ordinary addresses independent of token context are reusable. Each graph
+// node still receives a private leaf for any subsequent rewrite.
+typedef struct CheckBoundLeaf CheckBoundLeaf;
+struct CheckBoundLeaf
+{
+    uint32_t declaration;
+    TypeId type;
+    CheckGraphLeaf value;
+};
+
+#define BUSTER_CHECK_BOUND_LEAVES 512u
+
+static __attribute__((noinline)) bool check_input_bound_leaf_fill(CheckInputReader* reader, CheckInputBatch* batch, uint32_t token,
+                                                                  uint32_t declaration, TypeId type, CheckBoundLeaf* entry)
+{
+    CheckInputIdentifiers single;
+    check_input_identifier_entry(reader, token, &single, 0);
+    const bool acted = check_input_expression_identifier(reader, batch, token, &single, 0);
+    if (acted && (single.status[0] & BUSTER_CHECK_IDENTIFIER_NODE) != 0 && !reader->output->resource &&
+        (single.status[0] & BUSTER_CHECK_IDENTIFIER_ENUMERATOR) == 0 && (single.flags[0] & BUSTER_CHECK_REGISTER) == 0)
+    {
+        const uint8_t kind = type_kind(reader->types, type);
+        if (kind != BUSTER_TYPE_KIND_ENUM && kind != BUSTER_TYPE_KIND_ALIGNED)
+        {
+            entry->type = type;
+            entry->declaration = declaration;
+            entry->value = reader->output->graph.leaf_records[batch->leaf_slots[batch->count - 1]];
+        }
+    }
+    return acted;
+}
+
+static inline __attribute__((always_inline)) bool check_input_bound_leaf(CheckInputReader* reader, CheckInputBatch* batch, uint32_t token, CheckBoundLeaf* entries)
+{
+    const TypeId type = reader->declared_types[token];
+    if (type == 0)
+    {
+        return true;
+    }
+    const uint32_t declaration = reader->output->declarations[token];
+    CheckBoundLeaf* entry = entries + (declaration & (BUSTER_CHECK_BOUND_LEAVES - 1u));
+    if (entry->declaration != declaration || entry->type != type)
+    {
+        return check_input_bound_leaf_fill(reader, batch, token, declaration, type, entry);
+    }
+    const uint32_t node = check_input_batch_add(reader, batch, CHECK_OP_VALUE, token, BUSTER_CHECK_NONE, BUSTER_CHECK_NONE, BUSTER_CHECK_NONE, CHECK_INPUT_FORM_LEAF);
+    if (node != BUSTER_CHECK_NONE)
+    {
+        reader->output->graph.leaf_records[batch->leaf_slots[node - batch->base]] = entry->value;
+        check_input_expression_value(reader, token, node);
+    }
+    return true;
+}
