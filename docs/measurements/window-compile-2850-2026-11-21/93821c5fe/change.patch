+typedef struct CheckStaticRefBlock
+{
+    struct CheckStaticRefBlock* next;
+    uint64_t offset;
+    uint32_t count;
+    CheckDataFixup refs[];
+} CheckStaticRefBlock;
+
+typedef struct CheckStaticImage
+{
+    Arena* arena;
+    uint8_t* data;
+    uint64_t size;
+    uint64_t used;
+    CheckStaticRefBlock* first;
+    CheckStaticRefBlock* last;
+    uint32_t fixups;
+} CheckStaticImage;
+
+static bool check_static_image_row(CheckStaticImage* image, const CheckDataPlan* row)
+{
+    if (row->size > image->size - image->used || row->fixup_count > UINT32_MAX - image->fixups) return false;
+    if (row->bytes != NULL) memcpy(image->data + image->used, row->bytes, row->size);
+    if (row->fixup_count != 0)
+    {
+        const size_t size = (size_t)row->fixup_count * sizeof(CheckDataFixup);
+        CheckStaticRefBlock* block = arena_push(image->arena, sizeof(CheckStaticRefBlock) + size, _Alignof(CheckStaticRefBlock));
+        if (block == NULL) return false;
+        block->next = NULL; block->offset = image->used; block->count = row->fixup_count;
+        memcpy(block->refs, row->fixups, size);
+        if (image->last != NULL) image->last->next = block;
+        else image->first = block;
+        image->last = block;
+        image->fixups += row->fixup_count;
+    }
+    image->used += row->size;
+    return true;
+}
