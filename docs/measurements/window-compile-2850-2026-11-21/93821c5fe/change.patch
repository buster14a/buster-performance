diff --git a/src/buster/compiler/c_check_static_window_publish.c b/src/buster/compiler/c_check_static_window_publish.c
new file mode 100644
index 000000000..98aec3bd2
--- /dev/null
+++ b/src/buster/compiler/c_check_static_window_publish.c
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+
+static bool check_static_window_retain(CheckInputReader* reader, CheckStaticImage* image, uint32_t decl)
+{
+    const uint64_t size = type_size(reader->types, reader->declared_types[decl]);
+    if (image->used > size || image->fixups == UINT32_MAX) return false;
+    const uint64_t mark = reader->arena->length;
+    CheckInputLiteralTable* table = BUSTER_ARENA_PUSH_ARRAY(reader->arena, CheckInputLiteralTable, 1);
+    uint8_t* payload = BUSTER_ARENA_PUSH_ARRAY(reader->arena, uint8_t, size);
+    CheckInitPart* parts = BUSTER_ARENA_PUSH_ARRAY(reader->arena, CheckInitPart, (uint64_t)image->fixups + 1);
+    if (table == NULL || payload == NULL || parts == NULL)
+    {
+        arena_pop_to(reader->arena, mark);
+        return false;
+    }
+    memcpy(payload, image->data, size);
+    const TypeId type = reader->declared_types[decl];
+    *table = (CheckInputLiteralTable){ .declaration = decl };
+    parts[0] = (CheckInitPart){ .kind = CHECK_INIT_BYTES, .type = type, .token = decl, .node = BUSTER_CHECK_NONE,
+                                .bytes = payload, .byte_count = size };
+    uint32_t i = 1;
+    for (const CheckStaticRefBlock* b = image->first; b != NULL; b = b->next)
+    {
+        for (uint32_t j = 0; j < b->count; j += 1)
+        {
+            const CheckDataFixup* fix = &b->refs[j];
+            parts[i++] = (CheckInitPart){
+                .kind = CHECK_INIT_VALUE, .type = BUSTER_TYPE_ULONG, .token = decl, .node = BUSTER_CHECK_NONE,
+                .bit_offset = (b->offset + fix->offset) * 8,
+                .value = { .type = BUSTER_TYPE_ULONG, .category = CHECK_RVALUE, .flags = BUSTER_CHECK_STATIC_OBJECT,
+                           .constant_kind = CHECK_CONSTANT_ADDRESS, .object = fix->object, .offset = fix->addend }
+            };
+        }
+    }
+    table->plan = (CheckInitializer){ .type = type, .object_size = size, .parts = parts, .count = i,
+                                      .failed_token = BUSTER_CHECK_NONE, .warning_token = BUSTER_CHECK_NONE };
+    CheckInput* input = reader->output;
+    CheckInputLiteralTable** link = &input->literal_tables;
+    while (*link != NULL && (*link)->declaration < decl) link = &(*link)->next;
+    table->next = *link;
+    *link = table;
+    if (table->next == NULL) input->literal_tables_last = table;
+    input->literal_table_count += 1;
+    return true;
+}
+
+static void check_static_window_publish(CheckInputReader* reader)
+{
+    const Parser* parser = reader->parser;
+    const uint32_t count = parser->tokens.count;
+    Arena graph = arena_reserve(1ull << 36), checked = arena_reserve(1ull << 36), scratch = arena_reserve(1ull << 36);
+    Arena staging = arena_reserve(1ull << 36);
+    uint32_t begin = 0, source_begin = 0, ordinary = 0, accepted = 0, local = 0, refs = 0;
+    uint64_t bytes = 0;
+    for (uint32_t i = 0; i < count; i += 1)
+    {
+        const uint32_t term = reader->postorder[i];
+        if (parser->tree.parents[term] < count) continue;
+        CheckStaticRows rows;
+        bool emit = false;
+        if (check_static_rows_open(parser, source_begin, term, &rows) &&
+            reader->initializers[rows.first_row - 2] == 2 && BUSTER_CHECK_RARE(reader, static_initializers, rows.first_row - 2) &&
+            check_body_static_discards(reader, rows.first_row - 2, term, &emit))
+        {
+            const uint32_t decl = reader->initializer_declarations[rows.first_row - 2];
+            const CheckInputLiteralTable* table = reader->output->literal_tables;
+            while (table != NULL && table->declaration < decl) table = table->next;
+            const TypeId array = decl < count ? type_strip_aligned(reader->types, reader->declared_types[decl]) : 0;
+            if ((table == NULL || table->declaration != decl) && type_is_valid(reader->types, array) &&
+                type_kind(reader->types, array) == BUSTER_TYPE_KIND_ARRAY && type_is_complete(reader->types, array))
+            {
+                if (ordinary < begin) check_input_expressions_coded_range(reader, ordinary, begin);
+                ordinary = begin;
+                const uint32_t extent = term - source_begin + 1;
+                uint32_t* columns[] = {reader->output->token_nodes, reader->first_value, reader->last_value, reader->value_counts};
+                uint32_t* saved = BUSTER_ARENA_PUSH_ARRAY(&staging, uint32_t, (uint64_t)extent * 4);
+                if (saved == NULL) { reader->output->resource = true; break; }
+                for (uint32_t k = 0; k < 4; k += 1) memcpy(saved + (uint64_t)k*extent, columns[k]+source_begin, (size_t)extent*4);
+                CheckStaticImage image = { .arena = &staging, .size = type_size(reader->types, array) };
+                image.data = BUSTER_ARENA_PUSH_ARRAY(&staging, uint8_t, image.size);
+                bool good = image.data != NULL && image.size != 0;
+                if (good) memset(image.data, 0, image.size);
+                uint32_t start = begin, first = rows.first_row, frontier, last, nodes = 0;
+                while (good && check_static_rows_next(parser, &rows, &frontier, &last))
+                {
+                    const uint32_t stop = reader->postorder_positions[frontier] + 1;
+                    uint32_t made = 0;
+                    good = start < stop && stop <= i + 1 && check_body_source_one(reader, start, stop, term, &graph, &checked,
+                                &scratch, &made, frontier, emit, last, first, decl, &image);
+                    nodes += made;
+                    start = stop;
+                    first = rows.next_row;
+                    arena_pop_to(&graph, 0); arena_pop_to(&checked, 0); arena_pop_to(&scratch, 0);
+                }
+                for (uint32_t k = 0; k < 4; k += 1) memcpy(columns[k]+source_begin, saved+(uint64_t)k*extent, (size_t)extent*4);
+                if (good && check_static_window_retain(reader, &image, decl))
+                {
+                    accepted += 1; local += nodes; bytes += image.size; refs += image.fixups;
+                    ordinary = i + 1;
+                }
+                arena_pop_to(&staging, 0);
+            }
+        }
+        begin = i + 1;
+        source_begin = term + 1;
+    }
+    if (ordinary < count && !reader->output->resource) check_input_expressions_coded_range(reader, ordinary, count);
+    if (getenv("BUSTER_WINDOW_DATA_AUDIT") != NULL)
+        fprintf(stderr,"static-published\ttables=%u\tlocal-nodes=%u\tunit-nodes=%u\tbytes=%llu\tfixups=%u\n",
+                accepted, local, reader->output->graph.count, (unsigned long long)bytes, refs);
+    arena_release(&staging); arena_release(&scratch); arena_release(&checked); arena_release(&graph);
+}
