diff --git a/src/buster/compiler/c_check_body_static_rows.c b/src/buster/compiler/c_check_body_static_rows.c
new file mode 100644
index 000000000..ce9e68c68
--- /dev/null
+++ b/src/buster/compiler/c_check_body_static_rows.c
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+#ifndef BUSTER_CHECK_BODY_STATIC_ROWS_INCLUDED
+#define BUSTER_CHECK_BODY_STATIC_ROWS_INCLUDED
+
+typedef struct CheckStaticRows
+{
+    uint32_t first_row;
+    uint32_t outer_close;
+    uint32_t next_row;
+} CheckStaticRows;
+
+// A single file-scope declaration ending in an explicitly braced array of explicitly braced rows.
+// Follow the parser's matched braces and separator ancestry, with no rescan of a row's field expressions.
+static bool check_static_rows_open(const Parser* parser, uint32_t first, uint32_t term, CheckStaticRows* rows)
+{
+    if (term <= first || term - first < 2048 || parser->tree.roles[term] != PARSE_ROLE_TERMINATOR ||
+        parser->tree.roles[term - 1] != PARSE_ROLE_CLOSE_INITIALIZER) return false;
+    uint32_t open = first;
+    while (open < term && parser->tree.roles[open] != PARSE_ROLE_OPEN_INITIALIZER) open += 1;
+    if (open <= first || open >= term || parser->tree.parents[open] != term - 1 ||
+        parser->tree.roles[open - 1] != PARSE_ROLE_ASSIGN) return false;
+    const uint32_t stop = term - 1;
+    uint32_t row = open + 1;
+    uint32_t count = 0;
+    while (row < stop)
+    {
+        const uint32_t close = parser->tree.parents[row];
+        if (parser->tree.roles[row] != PARSE_ROLE_OPEN_INITIALIZER || close <= row || close >= stop ||
+            parser->tree.roles[close] != PARSE_ROLE_CLOSE_INITIALIZER) return false;
+        if (row != open + 1 && (parser->tree.parents[close] != row - 1 ||
+                                 parser->tree.roles[row - 1] != PARSE_ROLE_SEPARATOR)) return false;
+        count += 1;
+        row = close + 1;
+        if (row < stop && parser->tree.roles[row++] != PARSE_ROLE_SEPARATOR) return false;
+    }
+    if (count < 2) return false;
+    *rows = (CheckStaticRows){ .first_row = open + 1, .outer_close = stop, .next_row = open + 1 };
+    return true;
+}
+
+// Each frontier owns the closed row and every previous row. The next chunk sees the completed
+// prefix as an empty list after its members have been checked and their declaration casts emitted.
+static bool check_static_rows_next(const Parser* parser, CheckStaticRows* rows, uint32_t* frontier, uint32_t* last)
+{
+    const uint32_t begin = rows->next_row;
+    if (begin >= rows->outer_close) return false;
+    uint32_t row = begin;
+    do
+    {
+        *last = parser->tree.parents[row];
+        *frontier = row == rows->first_row ? *last : row - 1;
+        row = *last + 1;
+        row += row < rows->outer_close;
+    } while (row < rows->outer_close && row - begin < 1024);
+    rows->next_row = row;
+    return true;
+}
+#endif
