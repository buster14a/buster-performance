 // expressions go on the walk's stack, for the __builtin_constant_p they may hold. An extern declaration has no code.
+static uint32_t check_program_control_head(const CheckControlWriter* writer, uint32_t token)
+{
+    const CheckInput* input = writer->program->input;
+    if (!check_sparse_present(input->control_heads)) return writer->token_first[token];
+    const uint32_t exception = input->control_has_exceptions ? check_sparse_get(input->control_heads, token) : BUSTER_CHECK_NONE;
+    const uint32_t child = writer->first[token];
+    const uint32_t value = child < input->token_count ? input->token_nodes[child] : BUSTER_CHECK_NONE;
+    const uint32_t candidate = value != BUSTER_CHECK_NONE ? value + 1 : BUSTER_CHECK_NONE;
+    const uint32_t predicted = exception != BUSTER_CHECK_NONE ? exception :
+        candidate < input->graph.count && input->graph.tokens[candidate] == token ? candidate : BUSTER_CHECK_NONE;
+    if (input->control_verify)
+    {
+        CheckControlWriter* w = (CheckControlWriter*)writer;
+        ++w->roots_checked;
+        if (predicted != writer->token_first[token] && ++w->roots_diff < 12)
+            fprintf(stderr, "root-miss token=%u role=%u kind=%u expected=%u op=%u predicted=%u\n",token,writer->parser->tree.roles[token],writer->parser->tokens.kinds[token],writer->token_first[token],writer->token_first[token]<input->graph.count ? input->graph.ops[writer->token_first[token]] : 255,predicted);
+        return writer->token_first[token];
+    }
+    return predicted;
+}
