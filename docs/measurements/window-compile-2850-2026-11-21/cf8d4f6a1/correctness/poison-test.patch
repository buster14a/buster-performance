diff --git a/src/buster/compiler/c_check_input_scan_test.c b/src/buster/compiler/c_check_input_scan_test.c
index c52a12654..68d93e787 100644
--- a/src/buster/compiler/c_check_input_scan_test.c
+++ b/src/buster/compiler/c_check_input_scan_test.c
@@ -210,6 +210,15 @@ static void check_test_output_none(CheckTest* test)
                 exact &= columns[column][token] == (column == 2 || column == 3 ? UINT32_C(0xa5a5a5a5) : column == 8 ? 0 : UINT32_MAX);
             }
         }
+        // The payloads still contain dirty, valid-looking values. Only a publication makes a value visible,
+        // including declaration token zero. Clearing a published slot returns it to NONE.
+        exact &= check_input_initializer_declaration(&reader, 0) == BUSTER_CHECK_NONE &&
+                 check_input_initializer_declaration(&reader, count) == BUSTER_CHECK_NONE;
