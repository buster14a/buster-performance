From a62702e323e37ec9777b7efbc94d70a05598e38f Mon Sep 17 00:00:00 2001
From: David Gonzalez Martin <davidgmbb@gmail.com>
Date: Sat, 21 Nov 2026 13:14:55 +0100
Subject: [PATCH] Admit the discarded first expression of a for loop in the
 assignment window (#2850)

Signed-off-by: David Gonzalez Martin <davidgmbb@gmail.com>
---
 src/buster/compiler/c_check_expression_input.c | 11 ++++++++---
 src/buster/compiler/c_check_node_census_test.c |  6 +++---
 tests/checker/node-window.c                    |  6 ++++++
 3 files changed, 17 insertions(+), 6 deletions(-)

diff --git a/src/buster/compiler/c_check_expression_input.c b/src/buster/compiler/c_check_expression_input.c
index 64248a52a..105d50a70 100644
--- a/src/buster/compiler/c_check_expression_input.c
+++ b/src/buster/compiler/c_check_expression_input.c
@@ -1823,12 +1823,17 @@ static uint32_t check_input_window_first(const CheckInputReader* reader, const u
     uint32_t first = end;
     if (check_input_window_code(classes, end) == CHECK_INPUT_CODE_TERMINATOR)
     {
-        // A stand-alone assignment ending this block statement. Its two names or literal and its operator
-        // must also be the last three actions, in postorder. A statement-expression's final value may escape.
+        // The first semicolon immediately after for (x = y has the same discarded value as a
+        // block-statement assignment. Check its own opener so the condition and increment use their usual consumers.
+        const uint32_t parent = parser->tree.parents[token];
+        const bool for_init = token >= 5 && parent < parser->tokens.count && parser->tree.roles[parent] == PARSE_ROLE_CLOSE_FOR &&
+                              parser->tree.roles[token - 4] == PARSE_ROLE_OPEN_FOR && parser->tree.parents[token - 4] == parent &&
+                              parser->tokens.kinds[token - 5] == PARSE_KIND_FOR;
+        // A statement-expression's final value may escape.
         if (end - start >= 3 && token >= 3 && parser->tokens.kinds[token] == PARSE_KIND_SEMI &&
             parser->tree.roles[token] == PARSE_ROLE_TERMINATOR &&
             reader->conditions[token] == 0 && parser->tree.parents[token] < parser->tokens.count &&
-            (parser->tree.roles[parser->tree.parents[token]] == PARSE_ROLE_CLOSE_BLOCK || parser->tree.roles[parser->tree.parents[token]] == PARSE_ROLE_CLOSE_BODY) &&
+            (for_init || parser->tree.roles[parent] == PARSE_ROLE_CLOSE_BLOCK || parser->tree.roles[parent] == PARSE_ROLE_CLOSE_BODY) &&
             tokens[end - 3] == token - 3 && tokens[end - 2] == token - 1 && tokens[end - 1] == token - 2 &&
             check_input_window_code(classes, end - 3) == CHECK_INPUT_CODE_IDENTIFIER &&
             (check_input_window_code(classes, end - 2) == CHECK_INPUT_CODE_IDENTIFIER || check_input_window_code(classes, end - 2) == CHECK_INPUT_CODE_LITERAL) &&
diff --git a/src/buster/compiler/c_check_node_census_test.c b/src/buster/compiler/c_check_node_census_test.c
index 5a453cc7b..10e828d09 100644
--- a/src/buster/compiler/c_check_node_census_test.c
+++ b/src/buster/compiler/c_check_node_census_test.c
@@ -6130,8 +6130,8 @@ static void node_window_test_compile(CheckTest* test, bool assignments)
     {
         const CheckInput* reference = &plain.path.input;
         CheckInput* input = &window.path.input;
-        check_test_expect(test, reference->window_count == 0 && input->window_count == (assignments ? 13u : 11u) && input->window_nodes == (assignments ? 40u : 32u),
-                          "node-window takes two additional complete assignments only with assignment discovery enabled");
+        check_test_expect(test, reference->window_count == 0 && input->window_count == (assignments ? 15u : 11u) && input->window_nodes == (assignments ? 48u : 32u),
+                          "node-window takes discarded block and for-initializer assignments only with assignment discovery enabled");
         check_test_expect(test, reference->graph.count == input->graph.count + input->window_nodes - input->window_count,
                           "node-window replaces complete expressions by single checked roots");
         bool same = true;
@@ -6183,7 +6183,7 @@ static void node_window_test_compile(CheckTest* test, bool assignments)
                         regular.flags, value.flags, summary->count, rows[0].kind, rows[0].value);
             }
         }
-        check_test_expect(test, same && reads == (assignments ? 5u : 4u) && writes == (assignments ? 2u : 0u),
+        check_test_expect(test, same && reads == (assignments ? 6u : 4u) && writes == (assignments ? 4u : 0u),
                           "node-window publishes the complete ordinary checked values, exact native rows and ordered reads and writes");
         CheckProgramLowered original = { 0 };
         CheckProgramLowered first = { 0 };
diff --git a/tests/checker/node-window.c b/tests/checker/node-window.c
index e1184bc15..2edc4b0b8 100644
--- a/tests/checker/node-window.c
+++ b/tests/checker/node-window.c
@@ -18,3 +18,9 @@ int mixed(int x) { if (x) return x; return 1 + 4; }
 int local_read(int x) { int y = x; return +y; }
 int assigned_literal(int target) { target = 24; return target; }
 int assigned_local(int source, int target) { target = source; return target; }
+
+void for_initializers(int i, int n)
+{
+    for (i = 24; i < n; ++i) { }
+    for (i = n; i > 0; --i) { }
+}
-- 
2.56.1

