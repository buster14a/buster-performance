+// A completed arrow on an ordinary local pointer and a representable literal of type int.
+// T computes the selected member's value, the assignment conversion and the discarded checked value before graph publication.
+uint32_t check_node_window_field(const CheckInputReader* reader, TypeId pointer, uint32_t object, uint32_t literal, uint32_t token,
+                                 CheckValue* checked, CheckInputWindowRow rows[6])
+{
+    const TypeTable* types = reader->types;
+    const CheckInput* input = reader->output;
