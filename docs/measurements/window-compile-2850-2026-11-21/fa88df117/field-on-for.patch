+    if (member == 0 || member == BUSTER_TYPE_MEMBER_UNKNOWN || qualifiers != 0 || (offset & 7u) != 0 ||
+        (types->members.flags[member] & BUSTER_TYPE_MEMBER_BIT_FIELD) != 0)
+    {
+        return 0;
+    }
+    const TypeId target = types->members.type[member];
+    const uint32_t code = type_index(target);
+    if (type_qualifiers(target) != 0 || code < BUSTER_TYPE_CODE_CHAR || code > BUSTER_TYPE_CODE_ULLONG)
+    {
