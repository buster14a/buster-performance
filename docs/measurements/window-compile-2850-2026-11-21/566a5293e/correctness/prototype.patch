     const bool name = reader->parser->tokens.kinds[tokens[first]] == PARSE_KIND_IDENTIFIER;
+    if (name && operands >= 2 && reader->parser->tokens.kinds[tokens[first] + 1] == PARSE_KIND_L_PAREN)
+    {
+        const uint32_t args = operands - 2;
+        const uint32_t id = *identifier;
+        const TypeTable* types = reader->types;
+        const TypeId function = (TypeId)identifiers->types[id];
+        const uint32_t object = (uint32_t)identifiers->objects[id];
+        if (identifiers->status[id] != (BUSTER_CHECK_IDENTIFIER_ACTED | BUSTER_CHECK_IDENTIFIER_NODE) ||
+            identifiers->types[id] >> 32 != CHECK_FUNCTION || object == 0 || (identifiers->objects[id] >> 32) != 0 ||
+            type_kind(types, function) != BUSTER_TYPE_KIND_FUNCTION || type_return(types, function) != BUSTER_TYPE_INT ||
+            (types->types.flags[type_index(function)] & (BUSTER_TYPE_FLAG_PROTOTYPE | BUSTER_TYPE_FLAG_VARIADIC)) != BUSTER_TYPE_FLAG_PROTOTYPE ||
+            check_input_library_call(reader, tokens[first]) != 0 ||
+            (reader->window_call_guard && (type_function_abi_kind(types, function) != TYPE_FUNCTION_ABI_SYSV ||
+                                                     check_input_window_call_attributes(reader, identifiers->declarations[id], object))))
+        {
+            return false;
+        }
+        uint32_t parameters = 0;
+        const TypeId* formal = type_parameters(types, function, &parameters);
+        if (parameters != args || (args != 0 && (formal[0] != BUSTER_TYPE_INT || literals->values[*literal] == BUSTER_CHECK_NONE)))
+        {
+            return false;
+        }
+        CheckInputWindowRow rows[2];
+        if (args != 0)
+        {
+            check_node_window_int_entry(rows, literals->values[*literal], tokens[first + 1], false);
+        }
+        check_node_window_call_entry(rows + args, object, tokens[first], args);
+        if (!reader->window_call_omit_reference)
+        {
+            rows[args].flags |= BUSTER_CHECK_WINDOW_CALL_REFERENCE;
+        }
+        const CheckValue value = { .type = BUSTER_TYPE_INT, .category = CHECK_RVALUE, .flags = BUSTER_CHECK_SIDE_EFFECT };
+        const uint32_t made = check_input_window_publish(reader, batch, returned, value, rows, args + 1, operands + 1);
+        if (made != BUSTER_CHECK_NONE)
+        {
+            reader->output->token_nodes[returned] = made;
+            reader->query_types[returned] = BUSTER_TYPE_INT;
+            reader->first_value[returned] = BUSTER_CHECK_NONE;
+            *identifier += 1;
+            *literal += args;
+            if (reader->window_call_log) fprintf(stderr, "call-row: token=%u argc=%u object=%u\n", returned, args, object);
+        }
+        return made != BUSTER_CHECK_NONE;
+    }
     uint32_t value = 0;
     bool admitted;
     if (name)
@@ -2180,6 +2281,14 @@ static void check_input_expressions_coded_range(CheckInputReader* reader, uint32
     // original root's operand even for a rejected return. The shadow and the graph-numbering probe compare graph nodes.
     const bool window = reader->pp->options.node_window && coded && begin == 0 && stop == count && !timed && front == NULL &&
