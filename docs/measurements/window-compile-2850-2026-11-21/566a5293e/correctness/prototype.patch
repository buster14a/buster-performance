+void check_node_window_call_entry(CheckInputWindowRow* row, uint32_t object, uint32_t token, uint32_t count)
+{
+    *row = (CheckInputWindowRow){ .value = object | (uint64_t)count << 32, .token = token, .kind = BUSTER_TYPED_CALL,
+                                 .class = BUSTER_TYPED_CLASS_I32, .flags = BUSTER_CHECK_WINDOW_CALL };
+}
