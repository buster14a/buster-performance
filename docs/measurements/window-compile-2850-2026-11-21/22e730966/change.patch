+// A parsed declaration may carry the braced initializer to its semicolon through a specifier
+// chain, or discard its values at an intervening declarator. Follow the same coded actions
+// as the ordinary expression walk. Other forms stay with the complete declaration reader.
+static bool check_body_static_discards(const CheckInputReader* reader, uint32_t assignment,
+                                       uint32_t term, bool* emit)
+{
+    const Parser* parser = reader->parser;
+    uint32_t token = parser->tree.parents[assignment];
+    while (token < parser->tokens.count && token != term)
+    {
+        const uint32_t code = (reader->visits[token] & BUSTER_CHECK_EXPRESSION_CODE_MASK) >> BUSTER_CHECK_EXPRESSION_CODE_SHIFT;
+        if (code == CHECK_INPUT_CODE_DROP || !(reader->visits[token] & BUSTER_CHECK_EXPRESSION_ACTS))
+        {
+            *emit = false;
+            return true;
+        }
+        if (code != CHECK_INPUT_CODE_LIST && code != CHECK_INPUT_CODE_SEPARATOR) return false;
+        token = parser->tree.parents[token];
+    }
+    const uint32_t end_code = (reader->visits[term] & BUSTER_CHECK_EXPRESSION_CODE_MASK) >> BUSTER_CHECK_EXPRESSION_CODE_SHIFT;
+    if (token != term || end_code != CHECK_INPUT_CODE_TERMINATOR || reader->conditions[term]) return false;
+    *emit = true;
+    return true;
+}
