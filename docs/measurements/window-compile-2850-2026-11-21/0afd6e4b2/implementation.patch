+// When every marked declaration is a named function, object or enumerator, a diagnostic needs an
+// identifier bound to that declaration at a different token. Repeated declarations binding themselves
+// still contribute availability contexts, which are prepared before this test.
+static bool check_input_deprecated_named_use(const CheckInput* input, const uint64_t* marked, uint32_t count)
+{
+    for (uint32_t word = 0; word < (count + 63u) / 64; word += 1)
+    {
+        for (uint64_t bits = marked[word]; bits != 0; bits &= bits - 1)
+        {
+            const uint32_t token = word * 64 + (uint32_t)__builtin_ctzll(bits);
+            if (input->declarations[token] != token)
+            {
+                return true;
+            }
+        }
+    }
+    return false;
+}
