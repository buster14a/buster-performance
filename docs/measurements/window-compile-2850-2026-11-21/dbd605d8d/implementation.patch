@@ -676,6 +676,59 @@ static void check_test_graph_break(CheckTest* test, CheckGraph* graph, uint32_t
 
 #define BUSTER_CHECK_TEST_GRAPH_RULES 19u
 
+// Exercise both writers across the compact distance boundary, then compare every absolute
+// edge after a scalar or vector widening and check the last partial vector's untouched suffix.
+static void check_test_near_graph_edges(CheckTest* test)
+{
+    enum { nodes = 545, vector_start = 511 };
+    const uint32_t none = BUSTER_CHECK_NONE;
+    for (uint32_t exceptional = 0; exceptional < 4; exceptional += 1)
+    {
+        uint8_t packed[nodes];
+        uint32_t second[nodes], third[nodes], expected_second[nodes], expected_third[nodes];
+        CheckGraph graph = { .near_edges = packed, .operand1 = second, .operand2 = third };
+        for (uint32_t i = 0; i < nodes; i += 1)
+        {
+            second[i] = third[i] = UINT32_MAX - 1;
+            expected_second[i] = i == 127 ? 0 : i > 1 && i % 2 != 0 ? i - 2 : none;
+            expected_third[i] = i > 0 && i % 3 == 0 ? i - 1 : none;
+        }
+        if (exceptional == 1)
+        {
+            expected_second[128] = 0;
+        }
+        if (exceptional == 2)
+        {
+            expected_third[519] = 509;
+        }
+        if (exceptional == 3)
+        {
+            expected_second[259] = 1;
+        }
+        for (uint32_t i = 0; i < vector_start; i += 1)
+        {
+            check_graph_write_edges(&graph, i, expected_second[i], expected_third[i]);
+        }
+        for (uint32_t i = vector_start; i < nodes - 1; i += 16)
+        {
+            const __mmask16 live = (__mmask16)_bzhi_u32(UINT16_MAX, nodes - 1 - i);
+            check_graph_write_edge_block(&graph, i, live, _mm512_maskz_loadu_epi32(live, expected_second + i),
+                                         _mm512_maskz_loadu_epi32(live, expected_third + i));
+        }
+        bool same = (graph.near_edges != NULL) == (exceptional == 0) && second[nodes - 1] == UINT32_MAX - 1 && third[nodes - 1] == UINT32_MAX - 1;
+        for (uint32_t i = 0; i < nodes - 1; i += 1)
+        {
+            same = same && check_graph_second(&graph, i) == expected_second[i] && check_graph_third(&graph, i) == expected_third[i];
+        }
+        for (uint32_t i = 0; i < nodes - 1; i += 16)
+        {
+            same = same && _mm512_cmpeq_epi32_mask(check_graph_load_edge_block(&graph, i, 1, UINT16_MAX), _mm512_loadu_si512(expected_second + i)) == UINT16_MAX &&
+                   _mm512_cmpeq_epi32_mask(check_graph_load_edge_block(&graph, i, 2, UINT16_MAX), _mm512_loadu_si512(expected_third + i)) == UINT16_MAX;
+        }
+        check_test_expect(test, same, "two compact operands preserve absent, near and exceptional edges");
+    }
+}
+
 // #530: check_graph_validate against its definition (check_test_graph_validate_definition), on random graphs of every count to 70
 // and of 4,099 nodes, with and without the exact path's sideband nodes, the optional byte columns and tag history: each
