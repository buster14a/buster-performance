+// Publish sixteen validated uses together when each has an ordinary, typed declaration and
+// the source walk captured no earlier value. The caller retains event order for every other case.
+static bool check_input_binding_publish_batch(CheckInputReader* reader, const uint32_t* resolved, const uint32_t* uses)
+{
+    const CBindings* events = &reader->bindings;
+    const __m512i zero = _mm512_setzero_si512();
+    const __m512i event = _mm512_loadu_si512(uses);
+    const __m512i handles = _mm512_i32gather_epi32(event, resolved, 4);
+    const __m512i keys = _mm512_i32gather_epi32(event, events->key, 4);
+    if (_mm512_cmpeq_epi32_mask(handles, zero) != 0 ||
+        _mm512_cmpge_epu32_mask(keys, _mm512_set1_epi32((int)events->name_capacity)) != 0)
+    {
+        return false;
+    }
+    const __m512i slots = _mm512_sub_epi32(handles, _mm512_set1_epi32(1));
+    const __m512i decls = _mm512_i32gather_epi32(slots, events->declaration, 4);
+    const __m512i tokens = _mm512_i32gather_epi32(event, events->declaration, 4);
+    const __m512i types = _mm512_i32gather_epi32(decls, reader->declared_types, 4);
+    const __m512i captured = _mm512_i32gather_epi32(tokens, reader->declared_types, 4);
+    const __m512i kinds = check_input_gather_bytes(UINT16_MAX, slots, events->kind);
+    // Nonzero types at every source and zeros at every destination also prove no scatter
+    // overwrites another lane's source declaration. Duplicate destinations take the scalar path.
+    if (_mm512_cmpneq_epi32_mask(_mm512_or_si512(captured, _mm512_conflict_epi32(tokens)), zero) != 0 ||
+        _mm512_cmpeq_epi32_mask(types, zero) != 0 || _mm512_cmpeq_epi32_mask(kinds, _mm512_set1_epi32(C_BINDING_TYPEDEF)) != 0)
+    {
+        return false;
+    }
+    if (reader->incomplete_array_types != NULL)
+    {
+        const __mmask16 live = check_input_rare_lanes(reader, UINT16_MAX, _mm512_slli_epi32(decls, 2), (const uint8_t*)reader->incomplete_array_types);
+        const __m512i arr = _mm512_mask_i32gather_epi32(zero, live, decls, reader->incomplete_array_types, 4);
+        if (_mm512_cmpneq_epi32_mask(arr, zero) != 0)
+        {
+            return false;
+        }
+    }
+    _mm512_i32scatter_epi32(reader->output->declarations, tokens, decls, 4);
+    _mm512_i32scatter_epi32(reader->declared_types, tokens, types, 4);
+    return true;
+}
