+// A single node describes its whole list. Only genuine multi-value tokens need tail and length.
+static inline CheckInputValues check_input_values_at(const CheckInputReader* reader, uint32_t token)
+{
+    const uint32_t first = reader->first_value[token];
+    if (first == BUSTER_CHECK_NONE) return (CheckInputValues){ BUSTER_CHECK_NONE, BUSTER_CHECK_NONE, 0 };
+    if (reader->value_tails == NULL) return (CheckInputValues){ first, reader->last_value[token], reader->value_counts[token] };
+    if ((first >> 31) == 0) return (CheckInputValues){ first, first, 1 };
+    const CheckInputValueTail tail = reader->value_tails[token];
+    return (CheckInputValues){ first & INT32_MAX, tail.last, tail.count };
+}
+
+static inline void check_input_values_write(CheckInputReader* reader, uint32_t token, uint32_t first, uint32_t last, uint32_t count)
+{
+    if (reader->value_tails == NULL)
+    {
+        reader->first_value[token] = first;
+        reader->last_value[token] = last;
+        reader->value_counts[token] = count;
+    }
+    else if (count > 1 && first != BUSTER_CHECK_NONE)
+    {
+        reader->first_value[token] = first | UINT32_C(0x80000000);
+        reader->value_tails[token] = (CheckInputValueTail){ last, count };
+    }
+    else reader->first_value[token] = first;
+}
