+
+static void check_program_object_access(const CheckProgram* program, uint8_t* access, uint8_t* defined, bool scalar);
+
+// Refers to external names by their original object handles, independent of a temporarily assigned SymbolId.
+static uint64_t check_live_control_symbol(const CheckProgram* p, uint64_t symbol)
+{
+    return symbol != 0 && symbol <= p->symbol_count ? p->symbol_objects[symbol-1] : symbol;
+}
+static void check_live_control_rows(const char* arm,const CheckProgram* p,uint32_t close,const Tier0Function* f,const Tier0Code* code)
+{
+    fprintf(stderr,"control-native-%s\t%u\t%u\t%u\t",arm,close,f->parameter_count,f->count);
+    for (uint32_t i=0;i<f->count;i+=1)
+    {
+        const uint64_t val=tier0_global_kind(f->kinds[i]) ? check_live_control_symbol(p,f->values[i]) : f->values[i];
+        fprintf(stderr,"%x:%x:%llx,",f->kinds[i],f->classes[i],(unsigned long long)val);
+    }
+    fprintf(stderr,"\t");
+    for(uint32_t c=0;c<f->call_count;c+=1) fprintf(stderr,"%llu:%u,",(unsigned long long)check_live_control_symbol(p,f->call_targets[c]),f->call_argument_counts[c]);
+    fprintf(stderr,"\t%u:%u:%u\t",code->error,code->count,code->branch_count);
+    for(uint32_t r=0;r<code->reference_count;r+=1)
+    {
+        const LinkReference ref=code->references[r];
+        fprintf(stderr,"%u:%u:%u:%llu:%lld,",ref.instruction,ref.field,ref.kind,(unsigned long long)check_live_control_symbol(p,ref.target),(long long)ref.addend);
+    }
+    fprintf(stderr,"\t");
+    X86Instruction* records=malloc((size_t)(code->count+1)*sizeof(*records));
+    uint32_t* offsets=malloc((size_t)(code->count+1)*sizeof(*offsets));
+    uint32_t* ends=malloc(BUSTER_X86_ENCODER_FIXUP_CAPACITY(code->reference_count)*sizeof(*ends));
+    const size_t cap=BUSTER_X86_ENCODER_CAPACITY(code->count);
+    uint8_t* bytes=malloc(cap+1);
+    if (!records || !offsets || !ends || !bytes) abort();
+    memcpy(records,code->records,(size_t)code->count*sizeof(*records));
+    const BranchSizing sizing=size_branches(records,code->count,code->branches,code->targets,code->branch_count,offsets);
+    if (sizing.error!=BRANCH_SIZING_OK) abort();
+    const int64_t n=x86_encode(records,code->count,bytes,cap,0,ends);
+    for (int64_t j=0;j<n;j+=1) fprintf(stderr,"%02x",bytes[j]);
+    fprintf(stderr,"\t");
+    uint32_t ordinal=0;
+    for (uint32_t j=0;j<code->reference_count;j+=1)
+    {
+        const LinkReference ref=code->references[j];
+        const uint32_t distance=x86_fixup_distance(records[ref.instruction].form,ref.field);
+        if (j!=0 && ref.instruction!=code->references[j-1].instruction) ordinal+=1;
+        fprintf(stderr,"%u:%u:%llu:%lld,",ends[ordinal]-distance,ref.kind,(unsigned long long)check_live_control_symbol(p,ref.target),
+                (long long)(ref.addend-(link_fixup_kinds[ref.kind].pc_relative?distance:0)));
+    }
+    fprintf(stderr,"\n");
+    free(records); free(offsets); free(ends); free(bytes);
+}
+static void check_live_control_native(CheckProgram* p,CheckInputReader* reader,uint32_t opening,uint32_t close,CheckControl* entries,
+                                      uint32_t entry_count,uint32_t count,uint32_t* refs,uint32_t ref_count,Arena* scratch)
+{
+    static uint32_t seen;
+    seen+=1;
+    const char* step=getenv("BUSTER_CONTROL_NATIVE_STRIDE");
+    const char* maximum=getenv("BUSTER_CONTROL_NATIVE_MAX");
+    if ((step && (seen-1) % (uint32_t)strtoul(step,NULL,10)!=0) || (maximum && seen>(uint32_t)strtoul(maximum,NULL,10))) return;
+    const CheckInput* in=p->input;
+    p->target=reader->pp->options.target;
+    const uint32_t declaration=check_sparse_get(in->body_declarations,opening);
+    if(declaration>=in->token_count) return;
+    const uint32_t own=in->objects[declaration];
+    if(own==0 || own>=p->object_count) return;
+    CheckProgramBody body={.opening=opening,.declaration=declaration,.object=own,.first=0,.count=count,.entry_count=entry_count,.reference_count=ref_count};
+    p->bodies=&body;
+    p->body_count=1;
+    p->controls=entries;
+    p->control_count=count;
+    p->references=refs;
+    p->reference_count=ref_count;
+    p->object_symbols=BUSTER_ARENA_PUSH_ARRAY(scratch,SymbolId,p->object_count);
+    p->object_declarations=BUSTER_ARENA_PUSH_ARRAY(scratch,uint32_t,p->object_count);
+    p->symbol_objects=BUSTER_ARENA_PUSH_ARRAY(scratch,uint32_t,(uint64_t)ref_count+1);
+    if (!p->object_symbols || !p->object_declarations || !p->symbol_objects) abort();
+    memset(p->object_symbols,0,(size_t)p->object_count*sizeof(*p->object_symbols));
+    for(uint32_t obj=0;obj<p->object_count;obj+=1) p->object_declarations[obj]=obj-1;
+    for(uint32_t r=0;r<ref_count;r+=1)
+    {
+        if(refs[r]==0 || refs[r]>=p->object_count) return;
+        p->object_symbols[refs[r]]=++p->symbol_count;
+        p->symbol_objects[p->symbol_count-1]=refs[r];
+    }
+    if(!p->object_symbols[own]){p->object_symbols[own]=++p->symbol_count;p->symbol_objects[p->symbol_count-1]=own;}
+    if (!(x86_encoder_initialize() && x86_semantics_initialize() && x86_zen5_initialize() && tier0_initialize())) abort();
+    Arena temporary = {0};
+    Arena* output=in->source_body_output;
+    if (output==NULL) {temporary=arena_reserve(UINT64_C(1)<<34);output=&temporary;}
+    const uint64_t mark=output->length;
+    CheckProgramLowered lowered;
+    const bool ok=check_program_lower(&lowered,p,false,output,scratch);
+    if (ok && in->source_bodies != NULL)
+    {
+        Tier0Function* f=lowered.functions;
+        if (lowered.runtime_symbol_count!=0 || lowered.table_count!=0 || lowered.label_symbol_count!=0 || f->x87 || f->int128 ||
+            f->asm_body_count!=0 || f->hidden_copy!=0) {arena_pop_to(output,mark); return;}
+        uint32_t* objects=BUSTER_ARENA_PUSH_ARRAY(output,uint32_t,p->symbol_count);
+        if (objects==NULL) abort();
+        memcpy(objects,p->symbol_objects,p->symbol_count*sizeof(*objects));
+        CheckControl* controls=BUSTER_ARENA_PUSH_ARRAY(output,CheckControl,count);
+        if (controls==NULL) abort();
+        memcpy(controls,entries,(size_t)count*sizeof(*controls));
+        if (!check_input_source_add(in->source_bodies,(CheckSourceBody){ .function=f,.objects=objects,.symbols=p->symbol_count,
+                                        .controls=controls,.control_count=count,.entry_count=entry_count,.references=ref_count,.opening=opening },output)) abort();
+        return;
+    }
+    if(ok)
+    {
+        Tier0Function* f=lowered.functions;
+        uint8_t* access = BUSTER_ARENA_PUSH_ARRAY(scratch,uint8_t,(uint64_t)p->symbol_count+1);
+        uint8_t* defined = BUSTER_ARENA_PUSH_ARRAY(scratch,uint8_t,p->object_count);
+        if (access==NULL||defined==NULL) abort();
+        check_program_object_access(p,access,defined,false);
+        f->symbol_access=access;
+        f->symbol_count=p->symbol_count+1;
+        const Tier0Code code=tier0_compile(f,scratch);
+        check_live_control_rows("local",p,close,f,&code);
+    }
+    else if (in->source_bodies == NULL) fprintf(stderr,"control-native-declined\t%u\t%u\t%s\n",close,lowered.status,lowered.reason?lowered.reason:"");
+    if (in->source_bodies!=NULL) arena_pop_to(output,mark);
+    else arena_release(&temporary);
+}
+
+
+static bool check_live_control_bind(const CheckSourceBody* saved,const CheckProgram* program,Tier0Function* function,Arena* output)
+{
+    *function=*saved->function;
+    uint64_t* values=BUSTER_ARENA_PUSH_ARRAY(output,uint64_t,(uint64_t)function->count+1);
+    SymbolId* targets=BUSTER_ARENA_PUSH_ARRAY(output,SymbolId,(uint64_t)function->call_count+1);
+    if(values==NULL || targets==NULL) return false;
+    for(uint32_t i=0;i<function->count;i+=1)
+    {
+        uint64_t value=function->values[i];
+        if(tier0_global_kind(function->kinds[i]))
+        {
+            if(value==0 || value>saved->symbols) return false;
+            value=program->object_symbols[saved->objects[value-1]];
+            if(value==0) return false;
+        }
+        values[i]=value;
+    }
+    for(uint32_t c=0;c<function->call_count;c+=1)
+    {
+        const SymbolId symbol=function->call_targets[c];
+        if(symbol>saved->symbols) return false;
+        targets[c]=symbol==0?0:program->object_symbols[saved->objects[symbol-1]];
+        if(symbol!=0 && targets[c]==0) return false;
+    }
+    function->values=values;
+    function->call_targets=targets;
+    return true;
+}
