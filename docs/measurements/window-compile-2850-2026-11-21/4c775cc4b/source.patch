diff --git a/src/buster/compiler/c_check_source_control_program.c b/src/buster/compiler/c_check_source_control_program.c
new file mode 100644
index 000000000..61a47a3cb
--- /dev/null
+++ b/src/buster/compiler/c_check_source_control_program.c
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+// Emit the ordinary control tape and per-body object dependencies before the source checker retires its graph.
+// The ordinary record uses the same function-local node numbering. Its references are independently sorted.
+static void check_source_control_record(const char* arm, uint32_t close, const CheckControl* entries, uint32_t count,
+                                        uint32_t first_node, const uint32_t* refs, uint32_t ref_count)
+{
+    fprintf(stderr, "source-control-%s\t%u\t%u\t%u", arm, close, count, ref_count);
+    for (uint32_t i = 0; i < count; i += 1)
+    {
+        const CheckControl entry = entries[i];
+        const uint32_t node = entry.node == BUSTER_CHECK_NONE || entry.kind == CHECK_CONTROL_LIFETIME ? entry.node : entry.node - first_node;
+        fprintf(stderr, "\t%u,%u,%u,%u", (uint32_t)entry.kind, entry.token, node, entry.target);
+    }
+    fprintf(stderr, "\trefs");
+    for (uint32_t i = 0; i < ref_count; i += 1) fprintf(stderr, ",%u", refs[i]);
+    fputc('\n', stderr);
+}
+
+static void check_source_control_oracle(const CheckProgram* p, const Parser* parser)
+{
+    uint32_t body = 0, node = 0;
+    for (uint32_t t = 0; t < parser->tokens.count; t += 1)
+    {
+        if (parser->tree.parents[t] < parser->tokens.count) continue;
+        const uint32_t first = node;
+        while (node < p->input->graph.count && p->input->graph.tokens[node] <= t) node += 1;
+        if (body < p->body_count && parser->tree.parents[p->bodies[body].opening] == t)
+        {
+            const CheckProgramBody* b = p->bodies + body++;
+            check_source_control_record("whole", t, p->controls + b->first, b->count, first,
+                                        b->reference_count == 0 ? NULL : p->references + b->reference_first, b->reference_count);
+        }
+    }
+}
+
+static void check_live_control_native(CheckProgram* program, CheckInputReader* reader, uint32_t opening, uint32_t close,
+                                      CheckControl* entries,uint32_t entry_count,uint32_t count,uint32_t* references,uint32_t reference_count,Arena* scratch);
+
+static void check_source_control_function(CheckSourceControlUnit* unit, CheckInputReader* reader,
+                                          CheckStream* stream, uint32_t close, Arena* scratch)
+{
+    const Parser* parser = reader->parser;
+    const CheckInput* input = reader->output;
+    uint32_t opening = BUSTER_CHECK_NONE;
+    for (uint32_t t = reader->first_child[close]; t != BUSTER_CHECK_NONE; t = reader->next_child[t])
+        if (parser->tree.roles[t] == PARSE_ROLE_OPEN_BODY) opening = t;
+    if (opening >= close) return;
+    for (uint32_t t = opening + 1; t < close; t += 1)
+    {
+        const uint8_t role = parser->tree.roles[t], kind = parser->tokens.kinds[t];
+        if (role == PARSE_ROLE_LABEL || role == PARSE_ROLE_CLOSE_CASE || kind == PARSE_KIND_SWITCH ||
+            role == PARSE_ROLE_CLOSE_ATTRIBUTE_SPECIFIER || role == PARSE_ROLE_CLOSE_ATTRIBUTE ||
+            check_sparse_get(input->initializer_begins, t) != BUSTER_CHECK_NONE) return;
+    }
+    for (uint32_t i = 0; i < input->asm_count; i += 1)
+        if (input->asm_statements[i].statement - opening < close - opening) return;
+    for (uint32_t i = 0; i < input->region_count; i += 1)
+        if (input->regions[i].opening - opening < close - opening) return;
+    for (uint32_t i = 0; i < input->vla_count; i += 1)
+        if (input->vlas[i].declaration - opening < close - opening) return;
+    for (uint32_t i = 0; i < input->cleanup_count; i += 1)
+        if (input->cleanups[i].declaration - opening < close - opening) return;
+    const CheckGraph* graph = &input->graph;
+    if (graph->overload_count != 0 || stream->overload_address_count != 0) return;
+    for (uint32_t i = 0; i < graph->count; i += 1)
+        if (graph->ops[i] >= CHECK_OP_BUILTIN_UNARY ||
+            (graph->ops[i] == CHECK_OP_CALL && (graph->members[i] & BUSTER_CHECK_LIBRARY_CALL) != 0)) return;
+    const uint32_t names = input->token_count + 1;
+    const uint32_t slots = graph->count + 1;
+    const uint32_t capacity = (close - opening + 1) * 8 + 16;
+    CheckProgram p = { .input = input, .stream = stream, .parser = parser, .types = reader->types,
+                       .object_count = names, .identifiers = reader->pp->table };
+    CheckControlWriter writer = { .program = &p, .parser = parser, .first = unit->first, .last = unit->last,
+                                   .next = unit->next, .previous = unit->previous, .token_first = unit->token_head,
+                                   .planned = unit->planned, .capacity = capacity, .fold_capacity = slots,
+                                   .switch_scratch = scratch, .region_final = BUSTER_CHECK_NONE };
+    uint32_t* links = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, slots);
+    uint32_t* marks = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, slots);
+    uint64_t* refs = BUSTER_ARENA_PUSH_ARRAY(scratch, uint64_t, slots);
+    uint64_t* sorted = BUSTER_ARENA_PUSH_ARRAY(scratch, uint64_t, slots);
+    uint32_t* canonical = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, slots);
+    writer.fold_stack = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, slots);
+    writer.labels = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, capacity);
+    writer.entries = BUSTER_ARENA_PUSH_ARRAY(scratch, CheckControl, capacity);
+    writer.tasks = BUSTER_ARENA_PUSH_ARRAY(scratch, CheckControlTask, capacity);
+    writer.dropped_ranges = BUSTER_ARENA_PUSH_ARRAY(scratch, uint64_t, capacity);
+    writer.static_initializers = BUSTER_ARENA_PUSH_ARRAY(scratch, uint64_t, ((uint64_t)slots + 63) / 64);
+    if (!links || !marks || !refs || !sorted || !canonical || !writer.fold_stack || !writer.labels ||
+        !writer.entries || !writer.tasks || !writer.dropped_ranges || !writer.static_initializers) exit(2);
+    memset(unit->token_head + opening, 0xff, ((uint64_t)close - opening + 1) * sizeof(uint32_t));
+    for (uint32_t j = graph->count; j != 0; )
+    {
+        const uint32_t i = --j, token = graph->tokens[i];
+        if (token >= opening && token <= close) { links[i] = unit->token_head[token]; unit->token_head[token] = i; }
+    }
+    writer.node_next = links;
+    check_control_build(&writer, opening);
+    if (p.status != CHECK_PROGRAM_OK) return;
+    memset(marks, 0, slots * sizeof(uint32_t));
+    const uint32_t count = check_program_references(&p, writer.entries, writer.entry_count, close + 1,
+                                                     unit->seen, marks, writer.fold_stack, refs, unit->needed);
+    if (p.status != CHECK_PROGRAM_OK) return;
+    uint32_t varying = 0;
+    for (uint32_t i = 1; i < count; i += 1) varying |= (uint32_t)((refs[i] ^ refs[0]) >> 32);
+    const uint64_t* order = c_bindings_sort(refs, sorted, count, true, varying);
+    for (uint32_t i = 0; i < count; i += 1) canonical[i] = (uint32_t)(order[i] >> 32);
+    if (input->source_bodies == NULL) check_source_control_record("local", close, writer.entries, writer.count, 0, canonical, count);
+    if (input->source_bodies != NULL || getenv("BUSTER_LOCAL_CONTROL_NATIVE") != NULL)
+        check_live_control_native(&p,reader,opening,close,writer.entries,writer.entry_count,writer.count,canonical,count,scratch);
+}
