+static uint64_t check_body_fingerprint(const TypeTable* types, const CheckGraph* g, const CheckStream* stream, uint32_t first, uint32_t end, uint32_t close)
+{
+    uint64_t h = UINT64_C(14695981039346656037);
+    const char* const chosen = getenv("BUSTER_BODY_DIFF_TOKEN");
+    const bool dump = chosen != NULL && strtoul(chosen, NULL, 10) == close;
+#define BUSTER_BODY_FIELD(x) do { uint64_t field = (uint64_t)(x); h = (h ^ field) * UINT64_C(1099511628211); \
+    if (dump) fprintf(stderr, "body-field\t%u\t%s\t%016llx\n", j - first, #x, (unsigned long long)field); } while (0)
+    for (uint32_t j = first; j < end; j += 1)
+    {
+        const CheckValue v = check_stream_value(stream, j);
+        const uint32_t edge[3] = { g->operand0[j],g->operand1[j],g->operand2[j] };
+        for (uint32_t k = 0; k < 3; k += 1) BUSTER_BODY_FIELD(edge[k] == BUSTER_CHECK_NONE ? BUSTER_CHECK_NONE : edge[k] - first);
+        BUSTER_BODY_FIELD(g->contexts[j]); BUSTER_BODY_FIELD(g->source_positions != NULL ? g->source_positions[j] : BUSTER_CHECK_NONE);
+        BUSTER_BODY_FIELD(g->warning_suppressed != NULL ? g->warning_suppressed[j] : 0);
+        BUSTER_BODY_FIELD(g->fp_environments != NULL ? g->fp_environments[j] : g->fp_contract_default);
+        BUSTER_BODY_FIELD(g->argument_counts[j]); BUSTER_BODY_FIELD(stream->constant_evaluated != NULL && stream->constant_evaluated[j]);
+        BUSTER_BODY_FIELD(g->ops[j]); BUSTER_BODY_FIELD(g->tokens[j]); BUSTER_BODY_FIELD(check_body_type_fingerprint(types,g->types[j])); BUSTER_BODY_FIELD(g->members[j]);
+        BUSTER_BODY_FIELD(check_body_value_fingerprint(types,v,first));
+        if (g->ops[j] == CHECK_OP_VALUE)
+            BUSTER_BODY_FIELD(check_body_value_fingerprint(types,check_graph_leaf_value(g,j),first));
+        const CheckNodeConversions* conv = stream->conversions + j;
+        for (uint32_t k = 0; k < 3; k += 1)
+        {
+            BUSTER_BODY_FIELD(check_body_type_fingerprint(types,conv->operands[k].type)); BUSTER_BODY_FIELD(conv->operands[k].flags);
+        }
+        BUSTER_BODY_FIELD(check_body_type_fingerprint(types,conv->store.type)); BUSTER_BODY_FIELD(conv->store.flags);
+        if (g->ops[j] != CHECK_OP_VARARGS)
+            for (uint32_t k = 0; k < g->argument_counts[j]; k += 1)
+            {
+                BUSTER_BODY_FIELD(g->argument_nodes[g->argument_offsets[j]+k]-first);
+                BUSTER_BODY_FIELD(g->argument_tokens != NULL ? g->argument_tokens[g->argument_offsets[j]+k] : BUSTER_CHECK_NONE);
+                const CheckConversion c = stream->argument_conversions[g->argument_offsets[j] + k];
+                BUSTER_BODY_FIELD(check_body_type_fingerprint(types,c.type)); BUSTER_BODY_FIELD(c.flags);
+            }
+        BUSTER_BODY_FIELD(stream->diagnostics[j]); BUSTER_BODY_FIELD(stream->diagnostic_operands[j]);
+        BUSTER_BODY_FIELD(stream->warnings[j]); BUSTER_BODY_FIELD(stream->warning_ignored[j]); BUSTER_BODY_FIELD(stream->member_offsets[j]);
+    }
+    for (uint32_t i = 0; i < g->x86_count; i += 1)
+    {
+        const CheckX86Call* e = g->x86_calls + i;
+        const uint32_t j = e->node;
+        if (j < first || j >= end) continue;
+        BUSTER_BODY_FIELD(1);
+        BUSTER_BODY_FIELD(e->node - first);
+        BUSTER_BODY_FIELD(e->info != NULL ? e->info->name_length : 0);
+        if (e->info != NULL) for (uint32_t k = 0; k < e->info->name_length; k += 1) BUSTER_BODY_FIELD(e->info->name[k]);
+        BUSTER_BODY_FIELD(e->required_ice_arguments);
+        BUSTER_BODY_FIELD(e->ice_arguments);
+        BUSTER_BODY_FIELD(e->reachability);
+        BUSTER_BODY_FIELD(e->unselected_context);
+        BUSTER_BODY_FIELD(e->constant_evaluated_context);
+        BUSTER_BODY_FIELD(e->runtime_diagnostic_suppressed);
+    }
+    for (uint32_t i = 0; i < stream->report_count; i += 1)
+    {
+        const CheckReport* e = stream->reports + i;
+        const uint32_t j = e->node;
+        if (j < first || j >= end) continue;
+        BUSTER_BODY_FIELD(2);
+        BUSTER_BODY_FIELD(e->node - first);
+        BUSTER_BODY_FIELD(e->token);
+        BUSTER_BODY_FIELD(e->message);
+        BUSTER_BODY_FIELD(e->diagnostic);
+        BUSTER_BODY_FIELD(e->fault);
+    }
+    for (uint32_t i = 0; i < stream->effect_count; i += 1)
+    {
+        const CheckStoreEffect* e = stream->effects + i;
+        const uint32_t j = e->node;
+        if (j < first || j >= end) continue;
+        BUSTER_BODY_FIELD(3);
+        BUSTER_BODY_FIELD(e->node - first);
+        BUSTER_BODY_FIELD(check_body_value_fingerprint(types,e->value,first));
+        BUSTER_BODY_FIELD(check_body_value_fingerprint(types,e->destination,first));
+        BUSTER_BODY_FIELD(e->runtime_builtin);
+        BUSTER_BODY_FIELD(e->evaluated_operands);
+        BUSTER_BODY_FIELD(e->warnings);
+        BUSTER_BODY_FIELD(e->warning_operands);
+        BUSTER_BODY_FIELD(e->unsupported);
+    }
+    for (uint32_t i = 0; i < stream->varargs_count; i += 1)
+    {
+        const CheckVarargsEffect* e = stream->varargs + i;
+        const uint32_t j = e->node;
+        if (j < first || j >= end) continue;
+        BUSTER_BODY_FIELD(4);
+        BUSTER_BODY_FIELD(e->node - first);
+        BUSTER_BODY_FIELD(check_body_type_fingerprint(types,e->requested_type));
+        BUSTER_BODY_FIELD(e->evaluated_operands);
+        BUSTER_BODY_FIELD(e->warnings);
+        BUSTER_BODY_FIELD(e->mutates_list);
+        BUSTER_BODY_FIELD(e->microsoft);
+    }
+    for (uint32_t i = 0; i < stream->misc_count; i += 1)
+    {
+        const CheckBuiltinMiscEffect* e = stream->misc + i;
+        const uint32_t j = e->node;
+        if (j < first || j >= end) continue;
+        BUSTER_BODY_FIELD(5);
+        BUSTER_BODY_FIELD(e->node - first);
+        BUSTER_BODY_FIELD(check_body_value_fingerprint(types,e->constant_value,first));
+        BUSTER_BODY_FIELD(e->constant_evaluated_operands);
+        BUSTER_BODY_FIELD(e->evaluated_operands);
+        BUSTER_BODY_FIELD(e->warnings);
+        BUSTER_BODY_FIELD(e->unsupported);
+        BUSTER_BODY_FIELD(e->frame_level);
+        BUSTER_BODY_FIELD(e->alignment);
+        BUSTER_BODY_FIELD(e->alignment_offset);
+        BUSTER_BODY_FIELD(e->runtime_builtin);
+        BUSTER_BODY_FIELD(e->constraint);
+        BUSTER_BODY_FIELD(e->warning_operands);
+        BUSTER_BODY_FIELD(e->prefetch_rw);
+        BUSTER_BODY_FIELD(e->prefetch_locality);
+        BUSTER_BODY_FIELD(e->terminates);
+        BUSTER_BODY_FIELD(e->reads_memory);
+        BUSTER_BODY_FIELD(e->writes_memory);
+        BUSTER_BODY_FIELD(e->allocates_stack);
+        BUSTER_BODY_FIELD(e->alignment_offset_known);
+        BUSTER_BODY_FIELD(e->cpu_test);
+    }
+    for (uint32_t i = 0; i < stream->floating_count; i += 1)
+    {
+        const CheckBuiltinFloatEffect* e = stream->floating + i;
+        const uint32_t j = e->node;
+        if (j < first || j >= end) continue;
+        BUSTER_BODY_FIELD(6);
+        BUSTER_BODY_FIELD(e->node - first);
+        for (uint32_t k = 0; k < 2; k += 1)
+        {
+            BUSTER_BODY_FIELD(check_body_value_fingerprint(types,e->converted_arguments[k],first));
+        }
+        BUSTER_BODY_FIELD(e->math_kind);
+        BUSTER_BODY_FIELD(check_body_type_fingerprint(types,e->errno_pointer_type));
+        BUSTER_BODY_FIELD(check_body_type_fingerprint(types,e->floating_type));
+        BUSTER_BODY_FIELD(e->evaluated_operands);
+        BUSTER_BODY_FIELD(e->definite_operands);
+        BUSTER_BODY_FIELD(e->selected_selector);
+        BUSTER_BODY_FIELD(e->class_mask);
+        BUSTER_BODY_FIELD(e->unsupported);
+        BUSTER_BODY_FIELD(e->warnings);
+        BUSTER_BODY_FIELD(e->runtime_builtin);
+        BUSTER_BODY_FIELD(e->evaluation);
+        BUSTER_BODY_FIELD(e->folded);
+        BUSTER_BODY_FIELD(e->reads_memory);
+        BUSTER_BODY_FIELD(e->compiler_barrier);
+        BUSTER_BODY_FIELD(e->reads_fp_environment);
+        BUSTER_BODY_FIELD(e->may_raise_fp_exceptions);
+        BUSTER_BODY_FIELD(e->may_raise_inexact);
+        BUSTER_BODY_FIELD(e->may_set_errno);
+    }
+    for (uint32_t i = 0; i < stream->query_count; i += 1)
+    {
+        const CheckBuiltinQueryEffect* e = stream->queries + i;
+        const uint32_t j = e->node;
+        if (j < first || j >= end) continue;
