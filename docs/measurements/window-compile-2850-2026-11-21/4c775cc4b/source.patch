+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+
+// A verification slice for an ordinary translation unit. A function borrows the reader's immutable
+// source/type columns. Its local graph owns its renumbered edges, and the checker owns its result
+// until all the result fields have been compared with the whole-unit stream.
+typedef struct CheckBodyResidency
+{
+    uint32_t open, close;
+    uint32_t first, end, nodes;
+} CheckBodyResidency;
+
+#include "c_check_body_fingerprint.c"
+static void check_body_whole_fingerprints(const TypeTable* types, const Parser* parser, const CheckGraph* g, const CheckStream* stream)
+{
+    uint32_t node = 0;
+    for (uint32_t t = 0; t < parser->tokens.count; t += 1)
+    {
+        if (parser->tree.parents[t] >= parser->tokens.count)
+        {
+            const uint32_t first = node;
+            while (node < g->count && g->tokens[node] <= t) node += 1;
+            if (parser->tree.roles[t] == PARSE_ROLE_CLOSE_BODY || getenv("BUSTER_CHECK_SOURCE_DECLARATIONS") != NULL)
+                fprintf(stderr, "body-whole-row\t%u\t%u\t%016llx\n", t, node-first,
+                        (unsigned long long)check_body_fingerprint(types,g,stream,first,node,t));
+        }
+    }
+}
+
+static uint32_t check_body_residency_owner(const CheckBodyResidency* bodies, uint32_t count, uint32_t token)
+{
+    uint32_t low = 0, high = count;
+    while (low < high)
+    {
+        const uint32_t mid = low + (high - low) / 2;
+        if (bodies[mid].close < token) low = mid + 1;
+        else high = mid;
+    }
+    return low < count && bodies[low].open <= token ? low : BUSTER_CHECK_NONE;
+}
+
+static bool check_body_residency_graph(const CheckGraph* g, const CheckBodyResidency* body, Arena* arena, CheckGraph* view)
+{
+    const uint32_t first = body->first, end = body->end, size = end - first;
+    for (uint32_t i = 0; i < g->overload_count; i += 1)
+        if (g->overload_calls[i].node >= first && g->overload_calls[i].node < end) return false;
+    uint32_t first_leaf = BUSTER_CHECK_NONE, leaves = 0, first_arg = BUSTER_CHECK_NONE, args = 0;
+    for (uint32_t node = first; node < end; node += 1)
+    {
+        const CheckOp op = g->ops[node];
+        if (op >= CHECK_OP_BUILTIN_UNARY && op != CHECK_OP_BUILTIN_ATOMIC) return false;
+        const uint32_t children[] = {g->operand0[node], g->operand1[node], g->operand2[node]};
+        for (uint32_t i = 0; i < 3; i += 1)
+            if (children[i] != BUSTER_CHECK_NONE && children[i] < first) return false;
+        if (op == CHECK_OP_VALUE)
+        {
+            const uint32_t slot = g->leaf_slots[node];
+            if ((g->leaf_records != NULL ? g->leaf_records[slot].overload_head : g->dense_leaves[slot].overload_head) != 0) return false;
+            if (first_leaf == BUSTER_CHECK_NONE) first_leaf = g->leaf_slots[node];
+            if (g->leaf_slots[node] != first_leaf + leaves++) return false;
+        }
+        if (g->argument_counts[node] != 0)
+        {
+            if (op != CHECK_OP_CALL && op != CHECK_OP_BUILTIN_ATOMIC) return false;
+            if (first_arg == BUSTER_CHECK_NONE) first_arg = g->argument_offsets[node];
+            if (g->argument_offsets[node] != first_arg + args) return false;
+            for (uint32_t i = 0; i < g->argument_counts[node]; i += 1)
+            {
+                const uint32_t child = g->argument_nodes[first_arg + args + i];
+                if (child < first || child >= node) return false;
+            }
+            args += g->argument_counts[node];
+        }
+    }
+    uint32_t* cols = BUSTER_ARENA_PUSH_ARRAY(arena, uint32_t, (uint64_t)size * 5 + args);
+    if (cols == NULL) return false;
+    *view = (CheckGraph){
+        .marked_members = g->marked_members, .marked_member_count = g->marked_member_count,
+        .availability_contexts = g->availability_contexts,
+        .ns_constant_string = g->ns_constant_string, .cfstring_class = g->cfstring_class,
+        .ops = g->ops + first, .tokens = g->tokens + first,
+        .operand0 = cols, .operand1 = cols + size, .operand2 = cols + 2 * size,
+        .leaf_slots = cols + 3 * size, .types = g->types + first, .members = g->members + first,
+        .contexts = g->contexts != NULL ? g->contexts + first : NULL,
+        .const_values = g->const_values, .fp_environments = g->fp_environments != NULL ? g->fp_environments + first : NULL,
+        .fp_contract_default = g->fp_contract_default,
+        .warning_suppressed = g->warning_suppressed != NULL ? g->warning_suppressed + first : NULL,
+        .system_tokens = g->system_tokens, .system_token_count = g->system_token_count,
+        .tag_completions = g->tag_completions, .transparent_unions = g->transparent_unions, .tag_completion_count = g->tag_completion_count,
+        .source_positions = g->source_positions != NULL ? g->source_positions + first : NULL, .extensions = g->extensions,
+        .count = size, .capacity = size, .leaf_count = leaves,
+        .leaf_records = leaves != 0 && g->leaf_records != NULL ? g->leaf_records + first_leaf : NULL,
+        .leaf_payloads = g->leaf_payloads, .leaf_payload_count = g->leaf_payload_count, .leaf_payload_capacity = g->leaf_payload_capacity,
+        .dense_leaves = leaves != 0 && g->dense_leaves != NULL ? g->dense_leaves + first_leaf : NULL,
+        .argument_offsets = cols + 4 * size, .argument_counts = g->argument_counts + first,
+        .argument_nodes = args != 0 ? cols + 5 * size : NULL,
+        .argument_tokens = args != 0 && g->argument_tokens != NULL ? g->argument_tokens + first_arg : NULL,
+        .argument_count = args, .argument_capacity = args,
+    };
+    uint32_t vector = 0;
+    while (vector < g->vector_member_count && g->vector_members[vector].node < first) vector += 1;
+    uint32_t stop = vector;
+    while (stop < g->vector_member_count && g->vector_members[stop].node < end) stop += 1;
+    if (stop > vector)
+    {
+        view->vector_member_count = view->vector_member_capacity = stop - vector;
+        view->vector_members = BUSTER_ARENA_PUSH_ARRAY(arena, CheckVectorCall, view->vector_member_count);
+        if (view->vector_members == NULL) return false;
+        for (uint32_t i = 0; i < view->vector_member_count; i += 1)
+        {
+            view->vector_members[i] = g->vector_members[vector + i];
+            view->vector_members[i].node -= first;
+        }
+    }
+    uint32_t builtin = 0;
+    while (builtin < g->builtin_count && g->builtin_calls[builtin].node < first) builtin += 1;
+    uint32_t past = builtin;
+    while (past < g->builtin_count && g->builtin_calls[past].node < end) past += 1;
+    if (past > builtin)
+    {
+        view->builtin_count = view->builtin_capacity = past - builtin;
+        view->builtin_calls = BUSTER_ARENA_PUSH_ARRAY(arena, CheckBuiltinCall, view->builtin_count);
+        if (view->builtin_calls == NULL) return false;
+        for (uint32_t i = 0; i < view->builtin_count; i += 1)
+        {
+            view->builtin_calls[i] = g->builtin_calls[builtin + i];
+            view->builtin_calls[i].node -= first;
+        }
+    }
+    for (uint32_t j = 0; j < size; j += 1)
+    {
+        const uint32_t i = first + j;
+        view->operand0[j] = g->operand0[i] != BUSTER_CHECK_NONE ? g->operand0[i] - first : BUSTER_CHECK_NONE;
+        view->operand1[j] = g->operand1[i] != BUSTER_CHECK_NONE ? g->operand1[i] - first : BUSTER_CHECK_NONE;
+        view->operand2[j] = g->operand2[i] != BUSTER_CHECK_NONE ? g->operand2[i] - first : BUSTER_CHECK_NONE;
+        view->leaf_slots[j] = g->leaf_slots[i] != BUSTER_CHECK_NONE ? g->leaf_slots[i] - first_leaf : BUSTER_CHECK_NONE;
+        view->argument_offsets[j] = g->argument_counts[i] != 0 ? g->argument_offsets[i] - first_arg : 0;
+    }
+    for (uint32_t i = 0; i < args; i += 1) view->argument_nodes[i] = g->argument_nodes[first_arg + i] - first;
+    return true;
+}
+
+static bool check_body_value_equal(CheckValue a, CheckValue b, uint32_t first)
+{
+    if (b.fault != CHECK_FAULT_NONE) b.fault_node += first;
+    return a.type == b.type && a.category == b.category && a.flags == b.flags && a.constant_kind == b.constant_kind &&
+           a.integer == b.integer && memcmp(&a.floating, &b.floating, 10) == 0 && memcmp(&a.imaginary, &b.imaginary, 10) == 0 &&
+           a.object == b.object && a.overload_head == b.overload_head && a.offset == b.offset && a.bit_width == b.bit_width &&
+           a.fault == b.fault && a.fault_node == b.fault_node && a.object_bit_offset == b.object_bit_offset;
+}
+
+static bool check_body_atomic_equal(const CheckBuiltinAtomicEffect* a, const CheckBuiltinAtomicEffect* b, uint32_t first)
+{
+    return a->node == first + b->node && check_body_value_equal(a->object_address, b->object_address, first) &&
+           check_body_value_equal(a->store_value, b->store_value, first) && memcmp(a->answers, b->answers, sizeof(a->answers)) == 0 &&
+           a->object_type == b->object_type && a->value_type == b->value_type && a->object_size == b->object_size &&
+           a->required_alignment == b->required_alignment && a->minimum_alignment == b->minimum_alignment && a->evaluated_operands == b->evaluated_operands &&
+           a->success_order == b->success_order && a->failure_order == b->failure_order && a->known_orders == b->known_orders &&
+           a->warnings == b->warnings && a->warning_operands == b->warning_operands && a->unsupported == b->unsupported &&
+           a->runtime_builtin == b->runtime_builtin && a->fence_scope == b->fence_scope && a->alignment_known == b->alignment_known &&
+           a->volatile_access == b->volatile_access && a->reads_memory == b->reads_memory && a->writes_memory == b->writes_memory &&
+           a->rmw == b->rmw && a->compiler_barrier == b->compiler_barrier && a->late_completion == b->late_completion &&
+           a->query_size == b->query_size && a->query_pointer == b->query_pointer && a->space_target == b->space_target;
+}
+
+static bool check_body_effects_equal(const CheckStream* all, const CheckStream* part, uint32_t first, uint32_t end)
+{
+    uint32_t j = 0;
+    for (uint32_t k = 0; k < all->atomic_count; k += 1)
+    {
+        const CheckBuiltinAtomicEffect* effect = all->atomics + k;
+        if (effect->node >= first && effect->node < end)
+        {
+            if (j == part->atomic_count || !check_body_atomic_equal(effect, part->atomics + j, first)) return false;
+            j += 1;
+        }
+    }
+    return j == part->atomic_count;
+}
+
+static bool check_body_residency_equal(const CheckStream* all, const CheckStream* part, uint32_t first, uint32_t j)
+{
+    const uint32_t i = first + j;
+    const CheckValue a = check_stream_value(all, i);
+    const CheckValue b = check_stream_value(part, j);
+    for (uint32_t arg = 0; arg < part->graph->argument_counts[j]; arg += 1)
+    {
+        if (memcmp(all->argument_conversions + all->graph->argument_offsets[i] + arg,
+                   part->argument_conversions + part->graph->argument_offsets[j] + arg,
+                   sizeof(*all->argument_conversions)) != 0) return false;
+    }
+    if ((all->constant_evaluated != NULL && all->constant_evaluated[i]) !=
+        (part->constant_evaluated != NULL && part->constant_evaluated[j])) return false;
+    return check_body_value_equal(a, b, first) &&
+           memcmp(all->conversions + i, part->conversions + j, sizeof(*all->conversions)) == 0 &&
+           all->diagnostics[i] == part->diagnostics[j] && all->diagnostic_operands[i] == part->diagnostic_operands[j] &&
+           all->warnings[i] == part->warnings[j] && all->warning_ignored[i] == part->warning_ignored[j] &&
+           all->member_offsets[i] == part->member_offsets[j];
+}
+
+static bool check_body_residency_run(const Parser* parser, TypeTable* types, const CheckGraph* g, const CheckStream* ordinary, FILE* log)
+{
+    const uint32_t tokens = parser->tokens.count;
+    Arena graph = arena_reserve(1ull << 36), checked = arena_reserve(1ull << 36), scratch = arena_reserve(1ull << 36);
+    CheckBodyResidency* bodies = calloc(tokens / 2 + 1, sizeof(*bodies));
+    bool ok = bodies != NULL && graph.base != NULL && checked.base != NULL && scratch.base != NULL;
+    uint32_t n = 0, max_tokens = 0, max_nodes = 0, accepted = 0, acted = 0, largest_accepted = 0, atomics = 0, other = 0, split = 0, fail = 0;
+    for (uint32_t t = 0; ok && t < tokens; t += 1)
+    {
+        uint32_t c = parser->tree.parents[t];
+        if (parser->tree.roles[t] == PARSE_ROLE_OPEN_BODY && c > t && c < tokens && parser->tree.roles[c] == PARSE_ROLE_CLOSE_BODY)
+        {
+            bodies[n++] = (CheckBodyResidency){ .open=t, .close=c, .first=BUSTER_CHECK_NONE };
+            if (c - t + 1 > max_tokens) max_tokens = c - t + 1;
+            t = c;
+        }
+    }
+    for (uint32_t i = 0; ok && i < g->count; i += 1)
+    {
+        const uint32_t b = check_body_residency_owner(bodies, n, g->tokens[i]);
+        if (b == BUSTER_CHECK_NONE) { other += 1; continue; }
+        if (bodies[b].nodes++ == 0) bodies[b].first = i;
+        bodies[b].end = i + 1;
+    }
+    for (uint32_t b = 0; ok && b < n; b += 1)
+    {
+        const CheckBodyResidency* row = bodies + b;
+        if (row->nodes > max_nodes) max_nodes = row->nodes;
+        if (row->nodes == 0) continue;
+        if (row->end - row->first != row->nodes) { split += 1; continue; }
+        CheckGraph view;
+        if (check_body_residency_graph(g, row, &graph, &view))
+        {
+            CheckStream local;
+            if (!check_graph_run(types, &view, &checked, &scratch, &(CheckOptions){ 0 }, &local))
+            {
+                if (fail++ < 5) fprintf(log,"residency-check-failed\tbody=%u\tstatus=%u\tnode=%u\n",b,local.status,local.failed_node);
+            }
+            else
+            {
+                uint32_t j = 0; while (j < view.count && check_body_residency_equal(ordinary,&local,row->first,j)) j += 1;
+                if (j != view.count)
+                {
+                    if (fail++ < 5) fprintf(log,"residency-row-diff\tbody=%u\tfirst=%u\tlocal=%u\top=%u\n",b,row->first,j,view.ops[j]);
+                }
+                else if (!check_body_effects_equal(ordinary, &local, row->first, row->end))
+                {
+                    if (fail++ < 5) fprintf(log, "residency-atomic-diff\tbody=%u\n", b);
+                }
+                else
+                {
+                    accepted += 1;
+                    acted += j;
+                    atomics += local.atomic_count;
+                    if (j > largest_accepted) largest_accepted = j;
+                }
+            }
+        }
+        arena_pop_to(&graph, 0);
+        arena_pop_to(&checked, 0);
+        arena_pop_to(&scratch, 0);
+    }
+    fprintf(log,"residency-summary\ttokens=%u\tbodies=%u\tlargest-body-tokens=%u\tnodes=%u\toutside-body=%u\tlargest-body-nodes=%u\tnoncontiguous-bodies=%u\tchecked-bodies=%u\tchecked-nodes=%u\tlargest-checked=%u\tchecked-atomics=%u\tfailures=%u\tgraph-peak=%llu\tstream-peak=%llu\tscratch-peak=%llu\n",
+           tokens,n,max_tokens,g->count,other,max_nodes,split,accepted,acted,largest_accepted,atomics,fail,(unsigned long long)graph.peak,(unsigned long long)checked.peak,(unsigned long long)scratch.peak);
+    fprintf(log, "residency-pages\tgraph-bytes=%llu\tstream-bytes=%llu\tscratch-bytes=%llu\n",
+            (unsigned long long)check_body_residency_mapped(&graph), (unsigned long long)check_body_residency_mapped(&checked),
+            (unsigned long long)check_body_residency_mapped(&scratch));
+    free(bodies); arena_release(&graph); arena_release(&checked); arena_release(&scratch);
+    return ok && fail == 0;
+}
diff --git a/src/buster/compiler/c_check_body_source.c b/src/buster/compiler/c_check_body_source.c
new file mode 100644
index 000000000..9928bd60d
--- /dev/null
+++ b/src/buster/compiler/c_check_body_source.c
@@ -0,0 +1,248 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+#include "c_check_body_fingerprint.c"
+
+// Indexes keyed by original parser coordinates. These source columns survive graph retirement.
+typedef struct CheckSourceControlUnit
+{
+    uint32_t* first;
+    uint32_t* last;
+    uint32_t* next;
+    uint32_t* previous;
+    uint32_t* token_head;
+    uint32_t* seen;
+    uint8_t* needed;
+    uint64_t* planned;
+} CheckSourceControlUnit;
+
+static void check_source_control_function(CheckSourceControlUnit* unit, CheckInputReader* reader,
+                                          CheckStream* stream, uint32_t close, Arena* scratch);
+
+static bool check_body_source_one(CheckInputReader* top, uint32_t begin, uint32_t stop, uint32_t close,
+                                  Arena* graph, Arena* checked, Arena* scratch, uint32_t* made, CheckSourceControlUnit* controls)
+{
+    CheckInputReader reader = *top;
+    CheckInput input = *top->output;
+    // A single active source root may intern a derived type. The translation-unit type table owns it
+    // across graph retirement, including array decay required by a later static assertion.
+    reader.output = &input;
+    reader.arena = graph;
+    reader.scratch = scratch;
+    reader.warning_query_arena = graph;
+    reader.warning_events = (CheckWarningBuffer){ .arena = graph };
+    reader.source_warning_keys.arena = graph;
+    reader.source_warning_keys.borrowed = true;
+    reader.literal_warnings.arena = graph;
+    reader.literal_warnings.borrowed = true;
+    reader.warning_index_ready = false;
+    reader.warning_index = BUSTER_ARENA_PUSH_ARRAY(graph, uint16_t, (uint64_t)reader.warning_index_base * 2);
+    reader.const_warning_capacity = 0;
+    input.reports = BUSTER_ARENA_PUSH_ARRAY(graph, CheckInputReport, 1);
+    input.report_count = 0;
+    input.report_capacity = 1;
+    input.warning_events = (CheckWarningEvents){ 0 };
+    const uint32_t tokens = stop - begin;
+    uint32_t extra = 0;
+    for (uint32_t i = begin; i < stop; i += 1)
+    {
+        const uint8_t kind = reader.parser->tokens.kinds[reader.postorder[i]];
+        extra += kind == PARSE_KIND_L_SQUARE ? 8 : kind == PARSE_KIND_SIZEOF ? 4 : 0;
+    }
+    if (tokens > UINT32_MAX - extra) return false;
+    const uint32_t room = tokens + extra;
+    CheckGraph shape = top->output->graph;
+    shape.capacity = room;
+    uint32_t* next = BUSTER_ARENA_PUSH_ARRAY(graph, uint32_t, room);
+    if (next == NULL || input.reports == NULL || reader.warning_index == NULL) return false;
+#define BUSTER_BODY_COLUMN(field, n) do { if (shape.field != NULL) { \
+        shape.field = arena_push_array(graph, (n), sizeof(*shape.field), 64); \
+        if (shape.field == NULL) return false; \
+        memset(shape.field, 0, (uint64_t)(n) * sizeof(*shape.field)); } } while (0)
+    BUSTER_BODY_COLUMN(ops, room); BUSTER_BODY_COLUMN(tokens, room); BUSTER_BODY_COLUMN(types, room); BUSTER_BODY_COLUMN(members, room);
+    BUSTER_BODY_COLUMN(operand0, room); BUSTER_BODY_COLUMN(operand1, room); BUSTER_BODY_COLUMN(operand2, room);
+    BUSTER_BODY_COLUMN(leaf_slots, room); BUSTER_BODY_COLUMN(contexts, room); BUSTER_BODY_COLUMN(source_positions, room);
+    BUSTER_BODY_COLUMN(warning_suppressed, room); BUSTER_BODY_COLUMN(fp_environments, room); BUSTER_BODY_COLUMN(recorded_pure, room);
+    BUSTER_BODY_COLUMN(argument_offsets, room); BUSTER_BODY_COLUMN(argument_counts, room); BUSTER_BODY_COLUMN(argument_nodes, tokens);
+    BUSTER_BODY_COLUMN(argument_tokens, tokens); BUSTER_BODY_COLUMN(leaf_records, room);
+    if (shape.leaf_payloads != NULL)
+    {
+        shape.leaf_payloads = BUSTER_ARENA_PUSH_ARRAY(graph, CheckValue, room);
+        if (shape.leaf_payloads == NULL) return false;
+    }
+    BUSTER_BODY_COLUMN(dense_leaves, room);
+#undef BUSTER_BODY_COLUMN
+    CheckDeferredExpressionPart part = { .begin = 0, .end = tokens, .capacity = room, .leaf_capacity = room };
+    if (!check_deferred_expression_graph(&part, &shape, next, graph)) return false;
+    input.graph = part.graph;
+#define BUSTER_BODY_SIDELIST(field, counter, Type, local_limit) do { \
+        const uint32_t limit = (local_limit); \
+        input.graph.counter##_capacity = shape.counter##_capacity < limit ? shape.counter##_capacity : limit; \
+        if (input.graph.counter##_capacity != 0) { \
+            input.graph.field = BUSTER_ARENA_PUSH_ARRAY(graph, Type, input.graph.counter##_capacity); \
+            if (input.graph.field == NULL) return false; } } while (0)
+    BUSTER_BODY_SIDELIST(varargs_calls, varargs, CheckVarargsCall, tokens);
+    BUSTER_BODY_SIDELIST(x86_calls, x86, CheckX86Call, tokens);
+    BUSTER_BODY_SIDELIST(overload_calls, overload, CheckOverloadCall, tokens);
+    BUSTER_BODY_SIDELIST(region_proofs, region_proof, CheckRegionProof, tokens);
+    BUSTER_BODY_SIDELIST(region_steps, region_step, CheckRegionProofStep, tokens <= UINT32_MAX / 9 ? 9 * tokens : UINT32_MAX);
+#undef BUSTER_BODY_SIDELIST
+
+    input.graph.const_values = &input.const_values;
+    reader.value_next = next;
+    check_input_expressions_coded_range(&reader, begin, stop);
+    if (input.resource || input.report_count != 0)
+    {
+        fprintf(stderr,"body-source-decline\tclose=%u\tresource=%u\treports=%u\ttype-error=%u\tnodes=%u\n",
+                close,input.resource,input.report_count,reader.types->last_error,input.graph.count);
+        return false;
+    }
+    check_graph_record_finish(&input.graph);
+    CheckStream stream;
+    if (!check_graph_run(top->types, &input.graph, checked, scratch, &(CheckOptions){ 0 }, &stream))
+    {
+        fprintf(stderr,"body-source-decline\tclose=%u\tstatus=%u\tnode=%u\n",close,stream.status,stream.failed_node);
+        return false;
+    }
+    if (input.source_bodies == NULL && getenv("BUSTER_BODY_DISCARD_RESULT") == NULL) fprintf(stderr,"body-source-row\t%u\t%u\t%016llx\n", close, input.graph.count,
+            (unsigned long long)check_body_fingerprint(top->types, &input.graph, &stream, 0, input.graph.count, close));
+    if (controls != NULL && reader.parser->tree.roles[close] == PARSE_ROLE_CLOSE_BODY)
+        check_source_control_function(controls, &reader, &stream, close, scratch);
+    *made = input.graph.count;
+    return true;
+}
+
+// This verification entry stops before the ordinary expression graph is filled. File-scope binding and
+// token/type columns are retained, and only audited complete function trees enter the local expression producer.
+static void check_body_source_run(CheckInputReader* reader)
+{
+    Arena graph = arena_reserve(1ull << 36), checked = arena_reserve(1ull << 36), scratch = arena_reserve(1ull << 36);
+    const uint32_t count = reader->parser->tokens.count;
+    const Parser* parser = reader->parser;
+    Arena indexes = arena_reserve(UINT64_C(1) << 34);
+    CheckSourceControlUnit unit = { 0 };
+    CheckSourceControlUnit* controls = NULL;
+    if (getenv("BUSTER_SOURCE_CONTROLS") != NULL)
+    {
+        const uint64_t slots = (uint64_t)count + 1;
+#define BUSTER_CONTROL_INDEX(field, Type, length) unit.field = BUSTER_ARENA_PUSH_ARRAY(&indexes, Type, length); if (unit.field == NULL) exit(2)
+        BUSTER_CONTROL_INDEX(first, uint32_t, slots);
+        BUSTER_CONTROL_INDEX(last, uint32_t, slots);
+        BUSTER_CONTROL_INDEX(next, uint32_t, slots);
+        BUSTER_CONTROL_INDEX(previous, uint32_t, slots);
+        BUSTER_CONTROL_INDEX(token_head, uint32_t, slots);
+        BUSTER_CONTROL_INDEX(seen, uint32_t, slots);
+        BUSTER_CONTROL_INDEX(needed, uint8_t, slots);
+        BUSTER_CONTROL_INDEX(planned, uint64_t, (slots + 63) / 64);
+#undef BUSTER_CONTROL_INDEX
+        memset(unit.seen, 0, slots * sizeof(uint32_t));
+        memset(unit.planned, 0, ((slots + 63) / 64) * sizeof(uint64_t));
+        controls = &unit;
+    }
+    uint32_t begin = 0, admitted = 0, bodies = 0, produced = 0, skipped = 0, nodes = 0, biggest = 0;
+    bool safe = true;
+    const bool include_declarations = getenv("BUSTER_CHECK_SOURCE_DECLARATIONS") != NULL;
+    const bool explore = getenv("BUSTER_CHECK_BODY_ADMIT_ALL") != NULL;
+    for (uint32_t i = 0; i < count; i += 1)
+    {
+        const uint32_t t = reader->postorder[i];
+        safe = safe && check_deferred_expression_parallel(reader, t);
+        if (parser->tree.parents[t] >= count)
+        {
+            if (include_declarations || parser->tree.roles[t] == PARSE_ROLE_CLOSE_BODY)
+            {
+                bodies += 1;
+                if (safe || explore)
+                {
+                    uint32_t made = 0;
+                    admitted += 1;
+                    if (check_body_source_one(reader, begin, i + 1, t, &graph, &checked, &scratch, &made, controls))
+                    {
+                        produced += 1; nodes += made; biggest = biggest > made ? biggest : made;
+                    }
+                    else skipped += 1;
+                    arena_pop_to(&graph, 0); arena_pop_to(&checked, 0); arena_pop_to(&scratch, 0);
+                }
+            }
+            begin = i + 1;
+            safe = true;
+        }
+    }
+    fprintf(stderr,"body-source-summary\tunit-graph-capacity=%u\tbodies=%u\tadmitted=%u\tproduced=%u\tdeclined=%u\tnodes=%u\tlargest-checked=%u\tunit-graph-nodes=%u\tgraph-peak=%llu\tstream-peak=%llu\tscratch-peak=%llu\n",
+            reader->output->graph.capacity,bodies,admitted,produced,skipped,nodes,biggest,reader->output->graph.count,(unsigned long long)graph.peak,(unsigned long long)checked.peak,(unsigned long long)scratch.peak);
+    fprintf(stderr,"body-source-pages\tgraph=%llu\tstream=%llu\tscratch=%llu\n",
+            (unsigned long long)check_body_residency_mapped(&graph),(unsigned long long)check_body_residency_mapped(&checked),
+            (unsigned long long)check_body_residency_mapped(&scratch));
+    arena_release(&indexes);
+    arena_release(&graph);arena_release(&checked);arena_release(&scratch);
+    exit(produced > 0 && begin == count && (!include_declarations || skipped == 0) ? 0 : 1);
+}
+
+static void check_control_source_native(CheckInputReader* reader)
+{
+    Arena graph = arena_reserve(1ull << 36), checked = arena_reserve(1ull << 36), scratch = arena_reserve(1ull << 36);
+    const uint32_t count = reader->parser->tokens.count;
+    const Parser* parser = reader->parser;
+    CheckInput* in = reader->output;
+    in->source_bodies = BUSTER_ARENA_PUSH_ARRAY(reader->arena, CheckSourceBodies, 1);
+    if (in->source_bodies == NULL) abort();
+    *in->source_bodies = (CheckSourceBodies){0};
+    in->source_body_output = reader->arena;
+    Arena indexes = arena_reserve(UINT64_C(1) << 34);
+    CheckSourceControlUnit unit = { 0 };
+    CheckSourceControlUnit* controls = NULL;
+    if (true)
+    {
+        const uint64_t slots = (uint64_t)count + 1;
+#define BUSTER_CONTROL_INDEX(field, Type, length) unit.field = BUSTER_ARENA_PUSH_ARRAY(&indexes, Type, length); if (unit.field == NULL) exit(2)
+        BUSTER_CONTROL_INDEX(first, uint32_t, slots);
+        BUSTER_CONTROL_INDEX(last, uint32_t, slots);
+        BUSTER_CONTROL_INDEX(next, uint32_t, slots);
+        BUSTER_CONTROL_INDEX(previous, uint32_t, slots);
+        BUSTER_CONTROL_INDEX(token_head, uint32_t, slots);
+        BUSTER_CONTROL_INDEX(seen, uint32_t, slots);
+        BUSTER_CONTROL_INDEX(needed, uint8_t, slots);
+        BUSTER_CONTROL_INDEX(planned, uint64_t, (slots + 63) / 64);
+#undef BUSTER_CONTROL_INDEX
+        memset(unit.seen, 0, slots * sizeof(uint32_t));
+        memset(unit.planned, 0, ((slots + 63) / 64) * sizeof(uint64_t));
+        controls = &unit;
+    }
+    uint32_t begin = 0, selected = 0, local = 0, bodies = 0;
+    for (uint32_t i=0; i<count; i+=1)
+    {
+        const uint32_t t=reader->postorder[i];
+        if (parser->tree.parents[t]<count) continue;
+        bool done=false;
+        if (parser->tree.roles[t]==PARSE_ROLE_CLOSE_BODY)
+        {
+            bodies+=1;
+            uint32_t open=t;
+            while(open!=0 && !(parser->tokens.kinds[open]==PARSE_KIND_L_BRACE && parser->tree.parents[open]==t)) open-=1;
+            const bool shape = open != 0;
+            if (shape)
+            {
+                uint32_t low=t, high=t;
+                for (uint32_t j=begin; j<=i; j+=1)
+                {
+                    const uint32_t k=reader->postorder[j];
+                    if(k<low) low=k;
+                    if(k>high) high=k;
+                }
+                uint32_t* columns[]={in->token_nodes,reader->first_value,reader->last_value,reader->value_counts};
+                const uint32_t n=high-low+1;
+                uint32_t* save=BUSTER_ARENA_PUSH_ARRAY(&graph,uint32_t,(uint64_t)n*4);
+                if (save==NULL) abort();
+                for (uint32_t k=0;k<4;k+=1) memcpy(save+(uint64_t)k*n,columns[k]+low,(size_t)n*sizeof(*save));
+                uint32_t made=0;
+                done = check_body_source_one(reader,begin,i+1,t,&graph,&checked,&scratch,&made,controls) && check_input_source_body(in->source_bodies,open)!=NULL;
+                for (uint32_t k=0;k<4;k+=1) memcpy(columns[k]+low,save+(uint64_t)k*n,(size_t)n*sizeof(*save));
+                if (done) {selected+=1;local+=made;}
+                arena_pop_to(&graph,0);arena_pop_to(&checked,0);arena_pop_to(&scratch,0);
+            }
+        }
+        if (!done) check_input_expressions_coded_range(reader,begin,i+1);
+        begin=i+1;
+    }
+    if (getenv("BUSTER_CONTROL_SOURCE_AUDIT") != NULL) fprintf(stderr,"control-source-summary\tbodies=%u\tselected=%u\tlocal-graph-nodes=%u\tunit-graph-capacity=%u\tunit-graph-nodes=%u\n",bodies,selected,local,in->graph.capacity,in->graph.count);
+    arena_release(&indexes);arena_release(&graph);arena_release(&checked);arena_release(&scratch);
+}
