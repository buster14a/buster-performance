+// For a loaded pointer lvalue, an ordinary -> whose base carries no constant or fault produces
+// the same member lvalue for each use of its pointer type, member name and source flags. Keep
+// successful results in this run alone. A source position earlier than the proof runs the action
+// again because the pointed-to tag may still be incomplete there.
+typedef struct CheckMemberFact CheckMemberFact;
+struct CheckMemberFact
+{
+    TypeId pointer;
+    uint32_t name;
+    uint32_t flags;
+    uint32_t position;
+    TypeId result_type;
+    uint32_t result_flags;
+    uint32_t offset;
+};
+
+#define BUSTER_CHECK_MEMBER_FACTS 256u
+
+static inline CheckMemberFact* check_graph_member_fact(const CheckGraph* graph, const CheckStream* stream, uint32_t node, CheckMemberFact* facts)
+{
+    const uint32_t operand = graph->operand0[node];
+    if (operand >= node || stream->value_categories[operand] != CHECK_LVALUE || stream->payload_rows[operand] != 0 ||
+        (stream->value_constants[operand] != CHECK_CONSTANT_ADDRESS && stream->value_constants[operand] != CHECK_CONSTANT_NONE) ||
+        (stream->constant_evaluated != NULL && stream->constant_evaluated[node] != 0))
+    {
+        return NULL;
+    }
+    const uint32_t name = graph->members[node];
+    const TypeId pointer = stream->value_types[operand];
+    return facts + ((name ^ (type_index(pointer) * 31u)) & (BUSTER_CHECK_MEMBER_FACTS - 1));
+}
+
+static bool check_graph_member_take(const CheckGraph* graph, CheckStream* stream, uint32_t node, const CheckMemberFact* fact)
+{
+    const uint32_t operand = graph->operand0[node];
+    const TypeId pointer = stream->value_types[operand];
+    const uint32_t position = graph->source_positions != NULL ? graph->source_positions[node] : BUSTER_CHECK_NONE;
+    const bool taken = pointer != 0 && fact->pointer == pointer && fact->name == graph->members[node] &&
+                       fact->flags == stream->value_flags[operand] && position >= fact->position;
+    if (taken)
+    {
+        stream->value_types[node] = fact->result_type;
+        stream->value_flags[node] = fact->result_flags;
+        stream->value_categories[node] = CHECK_LVALUE;
+        stream->conversions[node].operands[0] = (CheckConversion){ .type = type_unqualified(pointer), .flags = BUSTER_CHECK_CONVERT_LVALUE };
+        stream->member_offsets[node] = fact->offset;
+        stream->statistics.scalar_nodes += 1;
+    }
+    return taken;
+}
+
+static void check_graph_member_publish(const TypeTable* types, const CheckGraph* graph, const CheckStream* stream, uint32_t node, CheckMemberFact* fact)
+{
+    const uint32_t operand = graph->operand0[node];
+    const TypeId pointer = stream->value_types[operand];
+    const CheckConversion conversion = stream->conversions[node].operands[0];
+    if (type_is_valid(types, pointer) && type_kind(types, pointer) == BUSTER_TYPE_KIND_POINTER &&
+        (type_kind(types, type_element(types, pointer)) == BUSTER_TYPE_KIND_STRUCT ||
+         type_kind(types, type_element(types, pointer)) == BUSTER_TYPE_KIND_UNION) &&
+        conversion.type == type_unqualified(pointer) && conversion.flags == BUSTER_CHECK_CONVERT_LVALUE &&
+        stream->diagnostics[node] == CHECK_DIAG_NONE && stream->warnings[node] == 0 &&
+        stream->value_constants[node] == CHECK_CONSTANT_NONE && stream->value_categories[node] == CHECK_LVALUE &&
+        stream->value_objects[node] == 0 && stream->payload_rows[node] == 0 && stream->member_offsets[node] <= UINT32_MAX)
+    {
+        *fact = (CheckMemberFact){
+            .pointer = pointer, .name = graph->members[node], .flags = stream->value_flags[operand],
+            .position = graph->source_positions != NULL ? graph->source_positions[node] : BUSTER_CHECK_NONE,
+            .result_type = stream->value_types[node], .result_flags = stream->value_flags[node], .offset = (uint32_t)stream->member_offsets[node],
+        };
+    }
+}
