+// A file-scope braced initializer already subjects its elements to constant evaluation and their destination
+// conversions. Its semicolon has no expression result. Only omit its otherwise redundant cast for a checked
+// integer rvalue without an exceptional payload, overload or side effect.
+static inline bool check_input_static_list(const CheckInputReader* reader, uint32_t token, uint32_t count)
+{
+    const Parser* parser = reader->parser;
+    return count > 1 && reader->pp->options.native_static_operands && token != 0 &&
+           parser->tree.parents[token] == BUSTER_PARSE_NONE && parser->tree.roles[token] == PARSE_ROLE_TERMINATOR &&
+           parser->tree.roles[token - 1] == PARSE_ROLE_CLOSE_INITIALIZER &&
+           reader->output->graph.leaf_records != NULL && reader->output->graph.dense_leaves == NULL;
+}
+
+static inline bool check_input_static_integer(const CheckGraph* graph, uint32_t slot)
+{
+    const CheckGraphLeaf* leaf = graph->leaf_records + slot;
+    return leaf->row == 0 && leaf->category == CHECK_RVALUE && leaf->constant_kind == CHECK_CONSTANT_INTEGER &&
+           leaf->overload_head == 0 && (leaf->flags & (BUSTER_CHECK_ICE | BUSTER_CHECK_SIDE_EFFECT)) == BUSTER_CHECK_ICE;
+}
