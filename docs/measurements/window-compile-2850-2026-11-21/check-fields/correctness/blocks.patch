+// Compact non-overloaded leaves own their conversion and value columns. A block can publish a valid
+// rowless leaf before its preceding actions: it references no node, changes no type and appends no
+// payload. A type that is not valid at block entry stays on the ordinary path at its own position.
+static uint32_t check_graph_leaf_blocks(TypeTable* types, const CheckGraph* graph, CheckStream* stream, CheckValue* arguments, Arena* scratch)
+{
+    uint32_t node = 0;
+    uint32_t slot = 0;
+    for (; graph->count - node >= 16; node += 16)
+    {
+        const __m512i ops = _mm512_loadu_si512(graph->ops + node);
+        uint32_t leaves = _mm512_cmpeq_epi32_mask(ops, _mm512_set1_epi32(CHECK_OP_VALUE));
+        uint32_t pending = 0xffff;
+        while (leaves != 0)
+        {
+            const uint32_t bit = leaves & (0u - leaves);
+            const uint32_t at = node + (uint32_t)_tzcnt_u32(bit);
+            const CheckGraphLeaf* leaf = graph->leaf_records + slot++;
+            if (leaf->row == 0 && leaf->integer == 0 && type_is_valid(types, leaf->type))
+            {
+                stream->value_types[at] = leaf->type;
+                stream->value_flags[at] = leaf->flags;
+                stream->value_objects[at] = leaf->object;
+                stream->value_categories[at] = leaf->category;
+                stream->value_constants[at] = leaf->constant_kind;
+                stream->conversions[at].operands[0].type = leaf->type;
+                pending ^= bit;
+            }
+            leaves ^= bit;
+        }
+        stream->statistics.vector_nodes += 16u - (uint32_t)_mm_popcnt_u32(pending);
+        while (pending != 0)
+        {
+            const uint32_t at = node + (uint32_t)_tzcnt_u32(pending);
+            if (graph->ops[at] == CHECK_OP_VALUE)
+            {
+                check_graph_leaf(types, graph, stream, at);
+            }
+            else
+            {
+                check_graph_scalar_node(types, graph, stream, at, arguments, scratch);
+            }
+            pending &= pending - 1;
+        }
+    }
+    return node;
+}
