+// An address interns the next type after the block begins. The earlier reference to its future
+// id is invalid, and the later one sees the newly created pointer. Nonzero payloads interleave
+// with rowless values, including an unknown condition that still carries its operand's effect.
+static void check_test_leaf_fact_barrier(CheckTest* test, Arena* storage, Arena* scratch)
+{
+    const uint64_t mark = storage->length;
+    CheckTestTypes owner = { 0 };
+    Arena output = arena_reserve(1u << 20);
+    CheckGraph graph;
+    const bool ready = output.base != NULL && check_test_types_open(&owner) && check_graph_initialize(&graph, storage, 32, 0);
+    check_test_expect(test, ready, "fresh output and graph for compact leaf type barrier");
+    if (ready)
+    {
+        TypeTable* types = &owner.table;
+        const TypeId next = types->types.count << BUSTER_TYPE_INDEX_SHIFT;
+        const uint32_t early = check_test_leaf(&graph, 0, (CheckValue){ .type = next });
+        const uint32_t x = check_test_leaf(&graph, 1, (CheckValue){ .type = BUSTER_TYPE_INT, .category = CHECK_LVALUE, .object = 1 });
+        const uint32_t before = check_test_leaf(&graph, 2, check_test_integer(BUSTER_TYPE_INT, 3));
+        const uint32_t address = check_graph_add(&graph, CHECK_OP_ADDRESS, 3, x, BUSTER_CHECK_NONE, BUSTER_CHECK_NONE);
+        const uint32_t late = check_test_leaf(&graph, 4, (CheckValue){ .type = next });
+        const uint32_t effect = check_test_leaf(&graph, 5, (CheckValue){ .type = BUSTER_TYPE_INT, .flags = BUSTER_CHECK_SIDE_EFFECT });
+        const uint32_t condition = check_graph_add(&graph, CHECK_OP_CONDITION, 6, effect, BUSTER_CHECK_NONE, BUSTER_CHECK_NONE);
+        for (uint32_t token = 7; token < 32; ++token)
+        {
+            check_test_leaf(&graph, token, check_test_integer(BUSTER_TYPE_INT, token % 3 != 0 ? 0 : token));
+        }
+        const CheckOptions options = { .fresh_output = true, .verify = true };
+        CheckStream stream;
+        const bool checked = check_graph_run(types, &graph, &output, scratch, &options, &stream);
+        check_test_expect(test, checked, "fresh bounded leaf run checks");
+        if (checked)
+        {
+            check_test_expect(test, stream.diagnostics[early] == CHECK_DIAG_INVALID_TYPE && check_stream_type(&stream, early) == 0 &&
+                              stream.conversions[early].operands[0].type == next, "future type is invalid before the ordinary address action");
+            check_test_expect(test, check_stream_type(&stream, address) == next && check_stream_type(&stream, late) == next &&
+                              stream.diagnostics[late] == CHECK_DIAG_NONE && stream.conversions[late].operands[0].type == next, "future type is valid after the ordinary address action");
+            check_test_expect(test, stream.payload_rows[before] == 1 && check_stream_value(&stream, before).integer == 3,
+                              "first payload keeps graph order in a partly published block");
+            check_test_expect(test, check_stream_flags(&stream, condition) == BUSTER_CHECK_SIDE_EFFECT &&
+                              stream.conversions[condition].operands[0].type == BUSTER_TYPE_INT, "an unknown int condition retains side effects and its operand conversion");
+        }
+    }
+    check_test_types_close(&owner);
+    arena_release(&output);
+    arena_pop_to(storage, mark);
+}
