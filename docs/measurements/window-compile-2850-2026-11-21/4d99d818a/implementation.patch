+++ b/src/buster/compiler/c_check_integer_rows.c
@@ -0,0 +1,200 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+
+// Checked columns for ordinary integer expressions. A store can retain a source's address payload even
+// when its result is no longer constant. Arithmetic with an unknown input, in contrast, has no value
+// payload of its own. The general C action handles bit-fields, faults, folds and contextual conversions.
+typedef enum CheckIntegerInput
+{
+    CHECK_INTEGER_INPUT_REJECT,
+    CHECK_INTEGER_INPUT_UNKNOWN,
+    CHECK_INTEGER_INPUT_LITERAL,
+} CheckIntegerInput;
+
+static CheckIntegerInput check_graph_integer_input(const CheckStream* stream, uint32_t node)
+{
+    const uint32_t row = stream->payload_rows[node];
+    const uint32_t flags = stream->value_flags[node];
+    const uint32_t category = stream->value_categories[node];
+    const uint32_t constant = stream->value_constants[node];
+    const uint32_t ordinary = BUSTER_CHECK_SIDE_EFFECT | BUSTER_CHECK_MODIFICATION;
+    const uint32_t designator = ordinary | BUSTER_CHECK_NONNULL_ADDRESS | BUSTER_CHECK_REGISTER | BUSTER_CHECK_REGISTER_NAME | BUSTER_CHECK_STATIC_OBJECT;
+    CheckIntegerInput result = CHECK_INTEGER_INPUT_REJECT;
+    if (row == 0 || stream->payloads[row - 1].fault == CHECK_FAULT_NONE)
+    {
+        if (category == CHECK_RVALUE && constant == CHECK_CONSTANT_INTEGER && (flags & ~(BUSTER_CHECK_ICE | BUSTER_CHECK_LITERAL_ZERO)) == 0)
+        {
+            result = CHECK_INTEGER_INPUT_LITERAL;
+        }
+        else if (category == CHECK_RVALUE && row == 0 && constant == CHECK_CONSTANT_NONE && (flags & ~ordinary) == 0)
+        {
+            result = CHECK_INTEGER_INPUT_UNKNOWN;
+        }
+        else if (category == CHECK_LVALUE && (constant == CHECK_CONSTANT_ADDRESS || constant == CHECK_CONSTANT_NONE) && (flags & ~designator) == 0)
+        {
+            result = CHECK_INTEGER_INPUT_UNKNOWN;
+        }
+    }
+    return result;
+}
+
+static bool check_graph_integer_type(TypeId type)
+{
+    return type >= BUSTER_TYPE_BOOL && type <= BUSTER_TYPE_UINT128 && type_qualifiers(type) == 0;
+}
+
+static bool check_graph_integer_store(TypeTable* types, const CheckGraph* graph, CheckStream* stream, uint32_t node)
+{
+    const CheckOp op = graph->ops[node];
+    const bool store = op == CHECK_OP_ASSIGN;
+    const uint32_t left = graph->operand0[node];
+    const uint32_t source = store ? graph->operand1[node] : left;
+    bool taken = left < node && source < node;
+    if (taken)
+    {
+        const TypeId target = store ? stream->value_types[left] : graph->types[node];
+        taken = check_graph_integer_type(target) && check_graph_integer_type(stream->value_types[source]) &&
+                (!store || (stream->value_categories[left] == CHECK_LVALUE && check_graph_integer_input(stream, left) != CHECK_INTEGER_INPUT_REJECT)) &&
+                check_graph_integer_input(stream, source) != CHECK_INTEGER_INPUT_REJECT;
+        if (taken)
+        {
+            CheckValue value;
+            check_stream_value_to(stream, source, &value);
+            uint32_t flags = BUSTER_CHECK_CONVERT_ASSIGNMENT;
+            if (value.category == CHECK_LVALUE)
+            {
+                value.category = CHECK_RVALUE;
+                value.constant_kind = CHECK_CONSTANT_NONE;
+                value.flags &= ~(BUSTER_CHECK_REGISTER | BUSTER_CHECK_REGISTER_NAME | BUSTER_CHECK_VOLATILE_PART);
+                flags |= BUSTER_CHECK_CONVERT_LVALUE;
+            }
+            check_action_convert_plain(types, &value, target, node);
+            if (store)
+            {
+                value.flags &= ~(BUSTER_CHECK_ICE | BUSTER_CHECK_GNU_ICE_FORM | BUSTER_CHECK_FLOAT_LITERAL | BUSTER_CHECK_ICE_UNEVALUATED);
+                value.flags |= BUSTER_CHECK_SIDE_EFFECT | BUSTER_CHECK_MODIFICATION | (stream->value_flags[left] & BUSTER_CHECK_INHERITED);
+            }
+            check_stream_set_value_flags(stream, node, &value, check_value_source_flags(op, value.flags));
+            CheckNodeConversions conversions = { 0 };
+            conversions.operands[0].type = target;
+            conversions.operands[store].type = target;
+            conversions.operands[store].flags = flags;
+            stream->conversions[node] = conversions;
+        }
+    }
+    return taken;
+}
+
+// The promoted builtin codes and their integer conversion table also drive the vector type kernels.
+// Under these guards there is no integer fold, short-circuit fold, enum diagnostic or source-time load.
+static bool check_graph_integer_operation(TypeTable* types, const CheckGraph* graph, CheckStream* stream, uint32_t node)
+{
+    const CheckOp op = graph->ops[node];
+    const bool unary = op <= CHECK_OP_BIT_NOT || op == CHECK_OP_CONDITION;
+    const bool logical = op == CHECK_OP_NOT || op == CHECK_OP_CONDITION || op == CHECK_OP_LOGICAL_AND || op == CHECK_OP_LOGICAL_OR;
+    const uint32_t a = graph->operand0[node];
+    const uint32_t b = unary ? a : graph->operand1[node];
+    bool taken = a < node && b < node;
+    if (taken)
+    {
+        const TypeId left = stream->value_types[a];
+        const TypeId right = stream->value_types[b];
+        taken = (check_graph_integer_type(left) && check_graph_integer_type(right)) ||
+                (unary && logical && type_qualifiers(left) == 0 && type_is_valid(types, left) && type_kind(types, left) == BUSTER_TYPE_KIND_POINTER);
+        if (taken)
+        {
+            const CheckIntegerInput left_input = check_graph_integer_input(stream, a);
+            const CheckIntegerInput right_input = unary ? left_input : check_graph_integer_input(stream, b);
+            taken = left_input != CHECK_INTEGER_INPUT_REJECT && right_input != CHECK_INTEGER_INPUT_REJECT &&
+                    (left_input == CHECK_INTEGER_INPUT_UNKNOWN || right_input == CHECK_INTEGER_INPUT_UNKNOWN) &&
+                    (!logical || (left_input == CHECK_INTEGER_INPUT_UNKNOWN && right_input == CHECK_INTEGER_INPUT_UNKNOWN)) &&
+                    (right_input != CHECK_INTEGER_INPUT_LITERAL || op < CHECK_OP_DIVIDE || op > CHECK_OP_SHIFT_RIGHT);
+        }
+        if (taken)
+        {
+            TypeId lt = left;
+            TypeId rt = right;
+            uint32_t lf = stream->value_categories[a] == CHECK_LVALUE ? BUSTER_CHECK_CONVERT_LVALUE : 0;
+            uint32_t rf = stream->value_categories[b] == CHECK_LVALUE ? BUSTER_CHECK_CONVERT_LVALUE : 0;
+            if (!logical)
+            {
+                lt = BUSTER_TYPE_BUILTIN(type_promotion_codes[type_index(left)]);
+                rt = BUSTER_TYPE_BUILTIN(type_promotion_codes[type_index(right)]);
+                lf |= lt != left ? BUSTER_CHECK_CONVERT_PROMOTION : 0;
+                rf |= rt != right ? BUSTER_CHECK_CONVERT_PROMOTION : 0;
+                if (!unary && op != CHECK_OP_SHIFT_LEFT && op != CHECK_OP_SHIFT_RIGHT)
+                {
+                    const uint32_t pair = ((type_index(lt) & 7u) << 3) | (type_index(rt) & 7u);
+                    const TypeId common = BUSTER_TYPE_BUILTIN(type_integer_codes[pair]);
+                    lf |= lt != common ? BUSTER_CHECK_CONVERT_ARITHMETIC : 0;
+                    rf |= rt != common ? BUSTER_CHECK_CONVERT_ARITHMETIC : 0;
+                    lt = common;
+                    rt = common;
+                }
+            }
+            CheckNodeConversions conversions = { 0 };
+            conversions.operands[0].type = lt;
+            conversions.operands[0].flags = lf;
+            if (!unary)
+            {
+                conversions.operands[1].type = rt;
+                conversions.operands[1].flags = rf;
+            }
+            stream->conversions[node] = conversions;
+            stream->value_types[node] = logical || (op >= CHECK_OP_LESS && op <= CHECK_OP_NOT_EQUAL) ? BUSTER_TYPE_INT : lt;
+            stream->value_flags[node] = (stream->value_flags[a] | stream->value_flags[b]) & BUSTER_CHECK_INHERITED;
+            stream->value_objects[node] = 0;
+            stream->value_constants[node] = CHECK_CONSTANT_NONE;
+            stream->value_categories[node] = CHECK_RVALUE;
+        }
+    }
+    return taken;
+}
+
+// The source loop can cross whole blocks of leaves. Classify the first block containing a nonleaf on demand.
+typedef struct CheckIntegerBlock
+{
+    uint32_t first;
+    uint32_t candidates;
+    uint32_t stores;
+} CheckIntegerBlock;
+
+static CheckIntegerBlock check_graph_integer_block(const CheckGraph* graph, uint32_t first)
+{
+    const uint32_t count = graph->count - first < 16 ? graph->count - first : 16;
+    const __mmask16 live = (__mmask16)((1u << count) - 1);
+    const __m512i op = _mm512_maskz_loadu_epi32(live, graph->ops + first);
+    const __mmask16 arithmetic = _mm512_mask_cmpge_epi32_mask(live, op, _mm512_set1_epi32(CHECK_OP_POSITIVE)) &
+                                 _mm512_cmple_epi32_mask(op, _mm512_set1_epi32(CHECK_OP_LOGICAL_OR));
+    const __mmask16 stores = (_mm512_mask_cmpge_epi32_mask(live, op, _mm512_set1_epi32(CHECK_OP_INITIALIZE)) &
+                              _mm512_cmple_epi32_mask(op, _mm512_set1_epi32(CHECK_OP_CONVERT))) |
+                             _mm512_mask_cmpeq_epi32_mask(live, op, _mm512_set1_epi32(CHECK_OP_ASSIGN));
+    const CheckIntegerBlock block = {
+        .first = first,
+        .candidates = arithmetic | stores | _mm512_mask_cmpeq_epi32_mask(live, op, _mm512_set1_epi32(CHECK_OP_CONDITION)),
+        .stores = stores,
+    };
+    return block;
+}
+
+// The ordinary checker retains one copy of its scalar fallback. Only the candidate operators call into this transfer.
+static __attribute__((noinline)) bool check_graph_integer_row(TypeTable* types, const CheckGraph* graph, CheckStream* stream, uint32_t node, bool store)
+{
+    bool taken = (stream->constant_evaluated == NULL || stream->constant_evaluated[node] == 0) &&
+                 ((graph->fp_environments != NULL ? graph->fp_environments[node] : graph->fp_contract_default) & BUSTER_CHECK_FP_ENV_ACCESS) == 0;
+    if (taken)
+    {
+        taken = store ? check_graph_integer_store(types, graph, stream, node) : check_graph_integer_operation(types, graph, stream, node);
+    }
+    if (taken)
+    {
+        if (!stream->zero_columns)
+        {
+            stream->diagnostics[node] = CHECK_DIAG_NONE;
+            stream->warnings[node] = 0;
+        }
+        stream->member_offsets[node] = 0;
+        stream->statistics.scalar_nodes += 1;
+    }
+    return taken;
+}
