diff --git a/src/buster/compiler/c_check_body_fingerprint.c b/src/buster/compiler/c_check_body_fingerprint.c
new file mode 100644
index 000000000..47e704416
--- /dev/null
+++ b/src/buster/compiler/c_check_body_fingerprint.c
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+#ifndef BUSTER_CHECK_BODY_FINGERPRINT
+#define BUSTER_CHECK_BODY_FINGERPRINT
+// Account resident pages in the three verifier mappings after every body has released its logical
+// allocations. The committed extent includes huge-page padding past the final allocation.
+static uint64_t check_body_residency_mapped(const Arena* arena)
+{
+    if (arena->mapping_bytes == 0 || arena->committed == 0) return 0;
+    const uintptr_t start = (uintptr_t)arena->base - arena->mapping_offset;
+    const uintptr_t end = ((uintptr_t)arena->base + arena->peak + BUSTER_ARENA_HUGE_PAGE_BYTES - 1) &
+                          ~(uintptr_t)(BUSTER_ARENA_HUGE_PAGE_BYTES - 1);
+    const uint64_t bytes = end - start < arena->committed ? end - start : arena->committed;
+    const uint64_t pages = (bytes + BUSTER_ARENA_PAGE_BYTES - 1) / BUSTER_ARENA_PAGE_BYTES;
+    uint8_t* resident = malloc(pages);
+    uint64_t count = 0;
+    if (resident == NULL || mincore(arena->base - arena->mapping_offset, bytes, resident) != 0)
+    {
+        free(resident);
+        return UINT64_MAX;
+    }
+    for (uint64_t i = 0; i < pages; i += 1) count += resident[i] & 1;
+    free(resident);
+    return count * BUSTER_ARENA_PAGE_BYTES;
+}
+
+// A checked function can request a derived pointer type before the whole-unit producer would have.
+// Compare each semantic type by its C key and nominal tag, ignoring its insertion slot.
+static uint64_t check_body_type_fingerprint(const TypeTable* table, TypeId type)
+{
+    const uint32_t i = type_index(type);
+    if (i < BUSTER_TYPE_BUILTIN_COUNT) return type;
+    if (i >= table->types.count) return UINT64_MAX - type;
+    const TypeColumns* c = &table->types;
+    const uint8_t kind = c->kind[i];
+    uint64_t h = UINT64_C(14695981039346656037);
+#define BUSTER_BODY_TYPE(x) h = (h ^ (uint64_t)(x)) * UINT64_C(1099511628211)
+    BUSTER_BODY_TYPE(kind); BUSTER_BODY_TYPE(type_qualifiers(type)); BUSTER_BODY_TYPE(c->flags[i]); BUSTER_BODY_TYPE(c->code[i]);
+    BUSTER_BODY_TYPE(c->size[i]); BUSTER_BODY_TYPE(c->alignment_log2[i]); BUSTER_BODY_TYPE(c->extent[i]);
+    BUSTER_BODY_TYPE(check_body_type_fingerprint(table,c->base[i]));
+    if (kind == BUSTER_TYPE_KIND_STRUCT || kind == BUSTER_TYPE_KIND_UNION || kind == BUSTER_TYPE_KIND_ENUM)
+    {
+        BUSTER_BODY_TYPE(c->index[i]);
+    }
+    else if (kind == BUSTER_TYPE_KIND_FUNCTION)
+    {
+        BUSTER_BODY_TYPE(type_function_info(table,i));
+        for (uint32_t n = 0; n < c->extent[i]; n += 1)
+        {
+            BUSTER_BODY_TYPE(check_body_type_fingerprint(table,table->parameters.type[c->index[i]+n]));
+            BUSTER_BODY_TYPE(type_parameter_abi(table,type,n));
+        }
+    }
+#undef BUSTER_BODY_TYPE
+    return h;
+}
+
+static uint64_t check_body_fingerprint(const TypeTable* types, const CheckGraph* g, const CheckStream* stream, uint32_t first, uint32_t end, uint32_t close)
+{
+    uint64_t h = UINT64_C(14695981039346656037);
+    const char* const chosen = getenv("BUSTER_BODY_DIFF_TOKEN");
+    const bool dump = chosen != NULL && strtoul(chosen, NULL, 10) == close;
+#define BUSTER_BODY_FIELD(x) do { uint64_t field = (uint64_t)(x); h = (h ^ field) * UINT64_C(1099511628211); \
+    if (dump) fprintf(stderr, "body-field\t%u\t%s\t%016llx\n", j - first, #x, (unsigned long long)field); } while (0)
+    for (uint32_t j = first; j < end; j += 1)
+    {
+        const CheckValue v = check_stream_value(stream, j);
+        const uint32_t edge[3] = { g->operand0[j],g->operand1[j],g->operand2[j] };
+        for (uint32_t k = 0; k < 3; k += 1) BUSTER_BODY_FIELD(edge[k] == BUSTER_CHECK_NONE ? BUSTER_CHECK_NONE : edge[k] - first);
+        BUSTER_BODY_FIELD(g->contexts[j]); BUSTER_BODY_FIELD(g->source_positions != NULL ? g->source_positions[j] : BUSTER_CHECK_NONE);
+        BUSTER_BODY_FIELD(g->warning_suppressed != NULL ? g->warning_suppressed[j] : 0);
+        BUSTER_BODY_FIELD(g->fp_environments != NULL ? g->fp_environments[j] : g->fp_contract_default);
+        BUSTER_BODY_FIELD(g->argument_counts[j]); BUSTER_BODY_FIELD(stream->constant_evaluated != NULL && stream->constant_evaluated[j]);
+        BUSTER_BODY_FIELD(g->ops[j]); BUSTER_BODY_FIELD(g->tokens[j]); BUSTER_BODY_FIELD(check_body_type_fingerprint(types,g->types[j])); BUSTER_BODY_FIELD(g->members[j]);
+        BUSTER_BODY_FIELD(check_body_type_fingerprint(types,v.type)); BUSTER_BODY_FIELD(v.category); BUSTER_BODY_FIELD(v.flags); BUSTER_BODY_FIELD(v.constant_kind);
+        BUSTER_BODY_FIELD(v.integer); BUSTER_BODY_FIELD(v.integer >> 64); BUSTER_BODY_FIELD(v.object); BUSTER_BODY_FIELD(v.overload_head);
+        BUSTER_BODY_FIELD(v.offset); BUSTER_BODY_FIELD(v.bit_width); BUSTER_BODY_FIELD(v.fault); BUSTER_BODY_FIELD(v.object_bit_offset);
+        if (v.fault != CHECK_FAULT_NONE) BUSTER_BODY_FIELD(v.fault_node - first);
+        for (uint32_t k = 0; k < 10; k += 1)
+        {
+            BUSTER_BODY_FIELD(((const uint8_t*)&v.floating)[k]); BUSTER_BODY_FIELD(((const uint8_t*)&v.imaginary)[k]);
+        }
+        const CheckNodeConversions* conv = stream->conversions + j;
+        for (uint32_t k = 0; k < 3; k += 1)
+        {
+            BUSTER_BODY_FIELD(check_body_type_fingerprint(types,conv->operands[k].type)); BUSTER_BODY_FIELD(conv->operands[k].flags);
+        }
+        BUSTER_BODY_FIELD(check_body_type_fingerprint(types,conv->store.type)); BUSTER_BODY_FIELD(conv->store.flags);
+        if (g->ops[j] != CHECK_OP_VARARGS)
+            for (uint32_t k = 0; k < g->argument_counts[j]; k += 1)
+            {
+                BUSTER_BODY_FIELD(g->argument_nodes[g->argument_offsets[j]+k]-first);
+                BUSTER_BODY_FIELD(g->argument_tokens != NULL ? g->argument_tokens[g->argument_offsets[j]+k] : BUSTER_CHECK_NONE);
+                const CheckConversion c = stream->argument_conversions[g->argument_offsets[j] + k];
+                BUSTER_BODY_FIELD(check_body_type_fingerprint(types,c.type)); BUSTER_BODY_FIELD(c.flags);
+            }
+        BUSTER_BODY_FIELD(stream->diagnostics[j]); BUSTER_BODY_FIELD(stream->diagnostic_operands[j]);
+        BUSTER_BODY_FIELD(stream->warnings[j]); BUSTER_BODY_FIELD(stream->warning_ignored[j]); BUSTER_BODY_FIELD(stream->member_offsets[j]);
+    }
+#undef BUSTER_BODY_FIELD
+    return h;
+}
+#endif
diff --git a/src/buster/compiler/c_check_body_published.c b/src/buster/compiler/c_check_body_published.c
new file mode 100644
index 000000000..204b8b0f9
--- /dev/null
+++ b/src/buster/compiler/c_check_body_published.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+
+// Research transport for two invocations on one identically preprocessed translation unit. Save a body's
+// checked operations and unresolved declaration identity, then let the ordinary unit assign its symbol.
+typedef struct CheckBodyPublished
+{
+    uint32_t close;
+    uint32_t declaration;
+    uint32_t target_object;
+    uint32_t count;
+    uint32_t parameters;
+    uint32_t arguments;
+    uint32_t first_argument;
+    uint8_t variadic;
+    uint8_t kinds[96];
+    uint8_t classes[96];
+    uint64_t values[96];
+    uint8_t local_classes[6];
+    uint8_t local_flags[6];
+    AbiLocation incoming[6];
+    uint8_t argument_classes[6];
+    AbiLocation outgoing[6];
+    AbiCall call;
+    AbiReturn result;
+} CheckBodyPublished;
+
+static CheckBodyPublished check_body_capture(uint32_t close, uint32_t declaration, const Tier0Function* f)
+{
+    CheckBodyPublished row = { .close=close, .declaration=declaration, .count=f->count, .parameters=f->parameter_count,
+                               .result=f->result, .arguments=f->argument_count };
+    memcpy(row.kinds,f->kinds,f->count);
+    memcpy(row.classes,f->classes,f->count);
+    memcpy(row.values,f->values,f->count*sizeof(*f->values));
+    memcpy(row.incoming,f->parameters,f->parameter_count*sizeof(*f->parameters));
+    memcpy(row.local_classes,f->local_classes,f->parameter_count);
+    if (f->call_count)
+    {
+        row.target_object=f->call_targets[0];
+        row.call=f->calls[0];
+        memcpy(row.outgoing,f->argument_locations,f->argument_count*sizeof(*f->argument_locations));
+        memcpy(row.argument_classes,f->argument_classes,f->argument_count);
+    }
+    return row;
+}
+
+static void check_body_save_publication(const char* file, const CheckBodyPublished* row)
+{
+    FILE* out=fopen(file,"ab");
+    if (out==NULL || fwrite(row,sizeof(*row),1,out)!=1 || fclose(out)!=0) abort();
+}
+
+static bool check_body_bind(const CheckBodyPublished* r, const CheckProgram* program, Tier0Function* function, Arena* output)
+{
+    SymbolId* symbol=NULL;
+    if (r->target_object!=0)
+    {
+        if (r->target_object>=program->object_count || program->object_symbols[r->target_object]==0) return false;
+        symbol=BUSTER_ARENA_PUSH_ARRAY(output,SymbolId,1);
+        if (symbol==NULL) abort();
+        *symbol=program->object_symbols[r->target_object];
+    }
+    *function=(Tier0Function){.kinds=r->kinds,.classes=r->classes,.values=r->values,.count=r->count,
+        .parameters=r->incoming,.local_classes=r->local_classes,.local_flags=r->local_flags,.local_count=r->parameters,
+        .parameter_count=r->parameters,.result=r->result,.call_count=symbol!=NULL,.argument_count=r->arguments,
+        .calls=&r->call,.call_targets=symbol,.call_first=&r->first_argument,.call_argument_counts=&r->arguments,
+        .call_variadic=&r->variadic,.argument_locations=r->outgoing,.argument_classes=r->argument_classes};
+    return true;
+}
+
+static bool check_body_published(const char* file, const CheckProgram* program, uint32_t b, Tier0Function* function, Arena* output)
+{
+    const uint32_t declaration=program->bodies[b].declaration;
+    const uint32_t close=program->parser->tree.parents[program->bodies[b].opening];
+    // A research-only file of complete rows, generated earlier in this process's invocation harness.
+    // Each thread has its own cursor. The frozen source may be compiled twice in one process.
+    static _Thread_local CheckBodyPublished* rows;
+    static _Thread_local size_t count;
+    if (rows==NULL)
+    {
+        FILE* in=fopen(file,"rb");
+        if (in==NULL || fseek(in,0,SEEK_END)!=0) abort();
+        const long length=ftell(in);
+        if (length < 0 || (size_t)length%sizeof(*rows)!=0 || fseek(in,0,SEEK_SET)!=0) abort();
+        count=(size_t)length/sizeof(*rows);
+        rows=calloc(count+1,sizeof(*rows));
+        if (rows==NULL || fread(rows,sizeof(*rows),count,in)!=count || fclose(in)!=0) abort();
+    }
+    size_t lo=0,hi=count;
+    while(lo<hi)
+    {
+        const size_t mid=lo+(hi-lo)/2;
+        if(rows[mid].close<close) lo=mid+1;
+        else hi=mid;
+    }
+    if (lo==count || rows[lo].close!=close || rows[lo].declaration!=declaration) return false;
+    const CheckBodyPublished* r=rows+lo;
+    if (!check_body_bind(r,program,function,output)) return false;
+    fprintf(stderr,"body-ops-published\t%u\t%u\t%u\n",close,r->count,r->target_object!=0);
+    return true;
+}
+
+static bool check_body_build_record(const Parser* parser, const TypeTable* types, const CheckInput* input, const CheckStream* stream,
+                                    uint32_t open, uint32_t close, CheckBodyPublished* output, const InternTable* audit, Arena* scratch);
+
+static bool check_body_direct(const CheckProgram* program, uint32_t b, Tier0Function* function, Arena* output)
+{
+    const uint32_t open = program->bodies[b].opening;
+    const uint32_t close = program->parser->tree.parents[open];
+    CheckBodyPublished record;
+    if (!check_body_build_record(program->parser,program->types,program->input,program->stream,open,close,&record,NULL,NULL)) return false;
+    CheckBodyPublished* saved = BUSTER_ARENA_PUSH_ARRAY(output,CheckBodyPublished,1);
+    if (saved==NULL) abort();
+    *saved=record;
+    if (!check_body_bind(saved,program,function,output)) return false;
+    if (getenv("BUSTER_BODY_DIRECT_AUDIT")!=NULL) fprintf(stderr,"body-ops-direct\t%u\t%u\t%u\n",close,record.count,record.target_object!=0);
+    return true;
+}
diff --git a/src/buster/compiler/c_check_body_residency.c b/src/buster/compiler/c_check_body_residency.c
new file mode 100644
index 000000000..8316867d0
--- /dev/null
+++ b/src/buster/compiler/c_check_body_residency.c
@@ -0,0 +1,270 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+
+// A verification slice for an ordinary translation unit. A function borrows the reader's immutable
+// source/type columns. Its local graph owns its renumbered edges, and the checker owns its result
+// until all the result fields have been compared with the whole-unit stream.
+typedef struct CheckBodyResidency
+{
+    uint32_t open, close;
+    uint32_t first, end, nodes;
+} CheckBodyResidency;
+
+#include "c_check_body_fingerprint.c"
+static void check_body_whole_fingerprints(const TypeTable* types, const Parser* parser, const CheckGraph* g, const CheckStream* stream)
+{
+    uint32_t node = 0;
+    for (uint32_t t = 0; t < parser->tokens.count; t += 1)
+    {
+        if (parser->tree.parents[t] >= parser->tokens.count)
+        {
+            const uint32_t first = node;
+            while (node < g->count && g->tokens[node] <= t) node += 1;
+            if (parser->tree.roles[t] == PARSE_ROLE_CLOSE_BODY)
+                fprintf(stderr, "body-whole-row\t%u\t%u\t%016llx\n", t, node-first,
+                        (unsigned long long)check_body_fingerprint(types,g,stream,first,node,t));
+        }
+    }
+}
+
+static uint32_t check_body_residency_owner(const CheckBodyResidency* bodies, uint32_t count, uint32_t token)
+{
+    uint32_t low = 0, high = count;
+    while (low < high)
+    {
+        const uint32_t mid = low + (high - low) / 2;
+        if (bodies[mid].close < token) low = mid + 1;
+        else high = mid;
+    }
+    return low < count && bodies[low].open <= token ? low : BUSTER_CHECK_NONE;
+}
+
+static bool check_body_residency_graph(const CheckGraph* g, const CheckBodyResidency* body, Arena* arena, CheckGraph* view)
+{
+    const uint32_t first = body->first, end = body->end, size = end - first;
+    for (uint32_t i = 0; i < g->overload_count; i += 1)
+        if (g->overload_calls[i].node >= first && g->overload_calls[i].node < end) return false;
+    uint32_t first_leaf = BUSTER_CHECK_NONE, leaves = 0, first_arg = BUSTER_CHECK_NONE, args = 0;
+    for (uint32_t node = first; node < end; node += 1)
+    {
+        const CheckOp op = g->ops[node];
+        if (op >= CHECK_OP_BUILTIN_UNARY && op != CHECK_OP_BUILTIN_ATOMIC) return false;
+        const uint32_t children[] = {g->operand0[node], g->operand1[node], g->operand2[node]};
+        for (uint32_t i = 0; i < 3; i += 1)
+            if (children[i] != BUSTER_CHECK_NONE && children[i] < first) return false;
+        if (op == CHECK_OP_VALUE)
+        {
+            const uint32_t slot = g->leaf_slots[node];
+            if ((g->leaf_records != NULL ? g->leaf_records[slot].overload_head : g->dense_leaves[slot].overload_head) != 0) return false;
+            if (first_leaf == BUSTER_CHECK_NONE) first_leaf = g->leaf_slots[node];
+            if (g->leaf_slots[node] != first_leaf + leaves++) return false;
+        }
+        if (g->argument_counts[node] != 0)
+        {
+            if (op != CHECK_OP_CALL && op != CHECK_OP_BUILTIN_ATOMIC) return false;
+            if (first_arg == BUSTER_CHECK_NONE) first_arg = g->argument_offsets[node];
+            if (g->argument_offsets[node] != first_arg + args) return false;
+            for (uint32_t i = 0; i < g->argument_counts[node]; i += 1)
+            {
+                const uint32_t child = g->argument_nodes[first_arg + args + i];
+                if (child < first || child >= node) return false;
+            }
+            args += g->argument_counts[node];
+        }
+    }
+    uint32_t* cols = BUSTER_ARENA_PUSH_ARRAY(arena, uint32_t, (uint64_t)size * 5 + args);
+    if (cols == NULL) return false;
+    *view = (CheckGraph){
+        .marked_members = g->marked_members, .marked_member_count = g->marked_member_count,
+        .availability_contexts = g->availability_contexts,
+        .ns_constant_string = g->ns_constant_string, .cfstring_class = g->cfstring_class,
+        .ops = g->ops + first, .tokens = g->tokens + first,
+        .operand0 = cols, .operand1 = cols + size, .operand2 = cols + 2 * size,
+        .leaf_slots = cols + 3 * size, .types = g->types + first, .members = g->members + first,
+        .contexts = g->contexts != NULL ? g->contexts + first : NULL,
+        .const_values = g->const_values, .fp_environments = g->fp_environments != NULL ? g->fp_environments + first : NULL,
+        .fp_contract_default = g->fp_contract_default,
+        .warning_suppressed = g->warning_suppressed != NULL ? g->warning_suppressed + first : NULL,
+        .system_tokens = g->system_tokens, .system_token_count = g->system_token_count,
+        .tag_completions = g->tag_completions, .transparent_unions = g->transparent_unions, .tag_completion_count = g->tag_completion_count,
+        .source_positions = g->source_positions != NULL ? g->source_positions + first : NULL, .extensions = g->extensions,
+        .count = size, .capacity = size, .leaf_count = leaves,
+        .leaf_records = leaves != 0 && g->leaf_records != NULL ? g->leaf_records + first_leaf : NULL,
+        .leaf_payloads = g->leaf_payloads, .leaf_payload_count = g->leaf_payload_count, .leaf_payload_capacity = g->leaf_payload_capacity,
+        .dense_leaves = leaves != 0 && g->dense_leaves != NULL ? g->dense_leaves + first_leaf : NULL,
+        .argument_offsets = cols + 4 * size, .argument_counts = g->argument_counts + first,
+        .argument_nodes = args != 0 ? cols + 5 * size : NULL,
+        .argument_tokens = args != 0 && g->argument_tokens != NULL ? g->argument_tokens + first_arg : NULL,
+        .argument_count = args, .argument_capacity = args,
+    };
+    uint32_t vector = 0;
+    while (vector < g->vector_member_count && g->vector_members[vector].node < first) vector += 1;
+    uint32_t stop = vector;
+    while (stop < g->vector_member_count && g->vector_members[stop].node < end) stop += 1;
+    if (stop > vector)
+    {
+        view->vector_member_count = view->vector_member_capacity = stop - vector;
+        view->vector_members = BUSTER_ARENA_PUSH_ARRAY(arena, CheckVectorCall, view->vector_member_count);
+        if (view->vector_members == NULL) return false;
+        for (uint32_t i = 0; i < view->vector_member_count; i += 1)
+        {
+            view->vector_members[i] = g->vector_members[vector + i];
+            view->vector_members[i].node -= first;
+        }
+    }
+    uint32_t builtin = 0;
+    while (builtin < g->builtin_count && g->builtin_calls[builtin].node < first) builtin += 1;
+    uint32_t past = builtin;
+    while (past < g->builtin_count && g->builtin_calls[past].node < end) past += 1;
+    if (past > builtin)
+    {
+        view->builtin_count = view->builtin_capacity = past - builtin;
+        view->builtin_calls = BUSTER_ARENA_PUSH_ARRAY(arena, CheckBuiltinCall, view->builtin_count);
+        if (view->builtin_calls == NULL) return false;
+        for (uint32_t i = 0; i < view->builtin_count; i += 1)
+        {
+            view->builtin_calls[i] = g->builtin_calls[builtin + i];
+            view->builtin_calls[i].node -= first;
+        }
+    }
+    for (uint32_t j = 0; j < size; j += 1)
+    {
+        const uint32_t i = first + j;
+        view->operand0[j] = g->operand0[i] != BUSTER_CHECK_NONE ? g->operand0[i] - first : BUSTER_CHECK_NONE;
+        view->operand1[j] = g->operand1[i] != BUSTER_CHECK_NONE ? g->operand1[i] - first : BUSTER_CHECK_NONE;
+        view->operand2[j] = g->operand2[i] != BUSTER_CHECK_NONE ? g->operand2[i] - first : BUSTER_CHECK_NONE;
+        view->leaf_slots[j] = g->leaf_slots[i] != BUSTER_CHECK_NONE ? g->leaf_slots[i] - first_leaf : BUSTER_CHECK_NONE;
+        view->argument_offsets[j] = g->argument_counts[i] != 0 ? g->argument_offsets[i] - first_arg : 0;
+    }
+    for (uint32_t i = 0; i < args; i += 1) view->argument_nodes[i] = g->argument_nodes[first_arg + i] - first;
+    return true;
+}
+
+static bool check_body_value_equal(CheckValue a, CheckValue b, uint32_t first)
+{
+    if (b.fault != CHECK_FAULT_NONE) b.fault_node += first;
+    return a.type == b.type && a.category == b.category && a.flags == b.flags && a.constant_kind == b.constant_kind &&
+           a.integer == b.integer && memcmp(&a.floating, &b.floating, 10) == 0 && memcmp(&a.imaginary, &b.imaginary, 10) == 0 &&
+           a.object == b.object && a.overload_head == b.overload_head && a.offset == b.offset && a.bit_width == b.bit_width &&
+           a.fault == b.fault && a.fault_node == b.fault_node && a.object_bit_offset == b.object_bit_offset;
+}
+
+static bool check_body_atomic_equal(const CheckBuiltinAtomicEffect* a, const CheckBuiltinAtomicEffect* b, uint32_t first)
+{
+    return a->node == first + b->node && check_body_value_equal(a->object_address, b->object_address, first) &&
+           check_body_value_equal(a->store_value, b->store_value, first) && memcmp(a->answers, b->answers, sizeof(a->answers)) == 0 &&
+           a->object_type == b->object_type && a->value_type == b->value_type && a->object_size == b->object_size &&
+           a->required_alignment == b->required_alignment && a->minimum_alignment == b->minimum_alignment && a->evaluated_operands == b->evaluated_operands &&
+           a->success_order == b->success_order && a->failure_order == b->failure_order && a->known_orders == b->known_orders &&
+           a->warnings == b->warnings && a->warning_operands == b->warning_operands && a->unsupported == b->unsupported &&
+           a->runtime_builtin == b->runtime_builtin && a->fence_scope == b->fence_scope && a->alignment_known == b->alignment_known &&
+           a->volatile_access == b->volatile_access && a->reads_memory == b->reads_memory && a->writes_memory == b->writes_memory &&
+           a->rmw == b->rmw && a->compiler_barrier == b->compiler_barrier && a->late_completion == b->late_completion &&
+           a->query_size == b->query_size && a->query_pointer == b->query_pointer && a->space_target == b->space_target;
+}
+
+static bool check_body_effects_equal(const CheckStream* all, const CheckStream* part, uint32_t first, uint32_t end)
+{
+    uint32_t j = 0;
+    for (uint32_t k = 0; k < all->atomic_count; k += 1)
+    {
+        const CheckBuiltinAtomicEffect* effect = all->atomics + k;
+        if (effect->node >= first && effect->node < end)
+        {
+            if (j == part->atomic_count || !check_body_atomic_equal(effect, part->atomics + j, first)) return false;
+            j += 1;
+        }
+    }
+    return j == part->atomic_count;
+}
+
+static bool check_body_residency_equal(const CheckStream* all, const CheckStream* part, uint32_t first, uint32_t j)
+{
+    const uint32_t i = first + j;
+    const CheckValue a = check_stream_value(all, i);
+    const CheckValue b = check_stream_value(part, j);
+    for (uint32_t arg = 0; arg < part->graph->argument_counts[j]; arg += 1)
+    {
+        if (memcmp(all->argument_conversions + all->graph->argument_offsets[i] + arg,
+                   part->argument_conversions + part->graph->argument_offsets[j] + arg,
+                   sizeof(*all->argument_conversions)) != 0) return false;
+    }
+    if ((all->constant_evaluated != NULL && all->constant_evaluated[i]) !=
+        (part->constant_evaluated != NULL && part->constant_evaluated[j])) return false;
+    return check_body_value_equal(a, b, first) &&
+           memcmp(all->conversions + i, part->conversions + j, sizeof(*all->conversions)) == 0 &&
+           all->diagnostics[i] == part->diagnostics[j] && all->diagnostic_operands[i] == part->diagnostic_operands[j] &&
+           all->warnings[i] == part->warnings[j] && all->warning_ignored[i] == part->warning_ignored[j] &&
+           all->member_offsets[i] == part->member_offsets[j];
+}
+
+static bool check_body_residency_run(const Parser* parser, TypeTable* types, const CheckGraph* g, const CheckStream* ordinary, FILE* log)
+{
+    const uint32_t tokens = parser->tokens.count;
+    Arena graph = arena_reserve(1ull << 36), checked = arena_reserve(1ull << 36), scratch = arena_reserve(1ull << 36);
+    CheckBodyResidency* bodies = calloc(tokens / 2 + 1, sizeof(*bodies));
+    bool ok = bodies != NULL && graph.base != NULL && checked.base != NULL && scratch.base != NULL;
+    uint32_t n = 0, max_tokens = 0, max_nodes = 0, accepted = 0, acted = 0, largest_accepted = 0, atomics = 0, other = 0, split = 0, fail = 0;
+    for (uint32_t t = 0; ok && t < tokens; t += 1)
+    {
+        uint32_t c = parser->tree.parents[t];
+        if (parser->tree.roles[t] == PARSE_ROLE_OPEN_BODY && c > t && c < tokens && parser->tree.roles[c] == PARSE_ROLE_CLOSE_BODY)
+        {
+            bodies[n++] = (CheckBodyResidency){ .open=t, .close=c, .first=BUSTER_CHECK_NONE };
+            if (c - t + 1 > max_tokens) max_tokens = c - t + 1;
+            t = c;
+        }
+    }
+    for (uint32_t i = 0; ok && i < g->count; i += 1)
+    {
+        const uint32_t b = check_body_residency_owner(bodies, n, g->tokens[i]);
+        if (b == BUSTER_CHECK_NONE) { other += 1; continue; }
+        if (bodies[b].nodes++ == 0) bodies[b].first = i;
+        bodies[b].end = i + 1;
+    }
+    for (uint32_t b = 0; ok && b < n; b += 1)
+    {
+        const CheckBodyResidency* row = bodies + b;
+        if (row->nodes > max_nodes) max_nodes = row->nodes;
+        if (row->nodes == 0) continue;
+        if (row->end - row->first != row->nodes) { split += 1; continue; }
+        CheckGraph view;
+        if (check_body_residency_graph(g, row, &graph, &view))
+        {
+            CheckStream local;
+            if (!check_graph_run(types, &view, &checked, &scratch, &(CheckOptions){ 0 }, &local))
+            {
+                if (fail++ < 5) fprintf(log,"residency-check-failed\tbody=%u\tstatus=%u\tnode=%u\n",b,local.status,local.failed_node);
+            }
+            else
+            {
+                uint32_t j = 0; while (j < view.count && check_body_residency_equal(ordinary,&local,row->first,j)) j += 1;
+                if (j != view.count)
+                {
+                    if (fail++ < 5) fprintf(log,"residency-row-diff\tbody=%u\tfirst=%u\tlocal=%u\top=%u\n",b,row->first,j,view.ops[j]);
+                }
+                else if (!check_body_effects_equal(ordinary, &local, row->first, row->end))
+                {
+                    if (fail++ < 5) fprintf(log, "residency-atomic-diff\tbody=%u\n", b);
+                }
+                else
+                {
+                    accepted += 1;
+                    acted += j;
+                    atomics += local.atomic_count;
+                    if (j > largest_accepted) largest_accepted = j;
+                }
+            }
+        }
+        arena_pop_to(&graph, 0);
+        arena_pop_to(&checked, 0);
+        arena_pop_to(&scratch, 0);
+    }
+    fprintf(log,"residency-summary\ttokens=%u\tbodies=%u\tlargest-body-tokens=%u\tnodes=%u\toutside-body=%u\tlargest-body-nodes=%u\tnoncontiguous-bodies=%u\tchecked-bodies=%u\tchecked-nodes=%u\tlargest-checked=%u\tchecked-atomics=%u\tfailures=%u\tgraph-peak=%llu\tstream-peak=%llu\tscratch-peak=%llu\n",
+           tokens,n,max_tokens,g->count,other,max_nodes,split,accepted,acted,largest_accepted,atomics,fail,(unsigned long long)graph.peak,(unsigned long long)checked.peak,(unsigned long long)scratch.peak);
+    fprintf(log, "residency-pages\tgraph-bytes=%llu\tstream-bytes=%llu\tscratch-bytes=%llu\n",
+            (unsigned long long)check_body_residency_mapped(&graph), (unsigned long long)check_body_residency_mapped(&checked),
+            (unsigned long long)check_body_residency_mapped(&scratch));
+    free(bodies); arena_release(&graph); arena_release(&checked); arena_release(&scratch);
+    return ok && fail == 0;
+}
diff --git a/src/buster/compiler/c_check_body_source.c b/src/buster/compiler/c_check_body_source.c
new file mode 100644
index 000000000..f23e2d96a
--- /dev/null
+++ b/src/buster/compiler/c_check_body_source.c
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+#include "c_check_body_fingerprint.c"
+
+static void check_body_source_operations(CheckInputReader* reader, const CheckInput* input, const CheckStream* stream, uint32_t close, Arena* scratch);
+
+static bool check_body_source_one(CheckInputReader* top, uint32_t begin, uint32_t stop, uint32_t close,
+                                  Arena* graph, Arena* checked, Arena* scratch, uint32_t* made)
+{
+    CheckInputReader reader = *top;
+    CheckInput input = *top->output;
+    TypeTable types = *top->types;
+    types.types.capacity = types.types.count;
+    types.parameters.capacity = types.parameters.count;
+    types.changes = NULL;
+    reader.types = &types;
+    reader.output = &input;
+    reader.arena = graph;
+    reader.scratch = scratch;
+    reader.warning_query_arena = graph;
+    reader.warning_events = (CheckWarningBuffer){ .arena = graph };
+    reader.source_warning_keys.arena = graph;
+    reader.source_warning_keys.borrowed = true;
+    reader.literal_warnings.arena = graph;
+    reader.literal_warnings.borrowed = true;
+    reader.warning_index_ready = false;
+    reader.warning_index = BUSTER_ARENA_PUSH_ARRAY(graph, uint16_t, (uint64_t)reader.warning_index_base * 2);
+    reader.const_warning_capacity = 0;
+    input.reports = BUSTER_ARENA_PUSH_ARRAY(graph, CheckInputReport, 1);
+    input.report_count = 0;
+    input.report_capacity = 1;
+    input.warning_events = (CheckWarningEvents){ 0 };
+    const uint32_t tokens = stop - begin;
+    uint32_t extra = 0;
+    for (uint32_t i = begin; i < stop; i += 1)
+    {
+        const uint8_t kind = reader.parser->tokens.kinds[reader.postorder[i]];
+        extra += kind == PARSE_KIND_L_SQUARE ? 8 : kind == PARSE_KIND_SIZEOF ? 4 : 0;
+    }
+    if (tokens > UINT32_MAX - extra) return false;
+    const uint32_t room = tokens + extra;
+    CheckGraph shape = top->output->graph;
+    shape.capacity = room;
+    uint32_t* next = BUSTER_ARENA_PUSH_ARRAY(graph, uint32_t, room);
+    if (next == NULL || input.reports == NULL || reader.warning_index == NULL) return false;
+#define BUSTER_BODY_COLUMN(field, n) do { if (shape.field != NULL) { \
+        shape.field = arena_push_array(graph, (n), sizeof(*shape.field), 64); \
+        if (shape.field == NULL) return false; \
+        memset(shape.field, 0, (uint64_t)(n) * sizeof(*shape.field)); } } while (0)
+    BUSTER_BODY_COLUMN(ops, room); BUSTER_BODY_COLUMN(tokens, room); BUSTER_BODY_COLUMN(types, room); BUSTER_BODY_COLUMN(members, room);
+    BUSTER_BODY_COLUMN(operand0, room); BUSTER_BODY_COLUMN(operand1, room); BUSTER_BODY_COLUMN(operand2, room);
+    BUSTER_BODY_COLUMN(leaf_slots, room); BUSTER_BODY_COLUMN(contexts, room); BUSTER_BODY_COLUMN(source_positions, room);
+    BUSTER_BODY_COLUMN(warning_suppressed, room); BUSTER_BODY_COLUMN(fp_environments, room); BUSTER_BODY_COLUMN(recorded_pure, room);
+    BUSTER_BODY_COLUMN(argument_offsets, room); BUSTER_BODY_COLUMN(argument_counts, room); BUSTER_BODY_COLUMN(argument_nodes, tokens);
+    BUSTER_BODY_COLUMN(argument_tokens, tokens); BUSTER_BODY_COLUMN(leaf_records, room); BUSTER_BODY_COLUMN(leaf_payloads, room);
+    BUSTER_BODY_COLUMN(dense_leaves, room);
+#undef BUSTER_BODY_COLUMN
+    CheckDeferredExpressionPart part = { .begin = 0, .end = tokens, .capacity = room, .leaf_capacity = room };
+    if (!check_deferred_expression_graph(&part, &shape, next, graph)) return false;
+    input.graph = part.graph;
+#define BUSTER_BODY_SIDELIST(field, counter, Type, local_limit) do { \
+        const uint32_t limit = (local_limit); \
+        input.graph.counter##_capacity = shape.counter##_capacity < limit ? shape.counter##_capacity : limit; \
+        if (input.graph.counter##_capacity != 0) { \
+            input.graph.field = BUSTER_ARENA_PUSH_ARRAY(graph, Type, input.graph.counter##_capacity); \
+            if (input.graph.field == NULL) return false; } } while (0)
+    BUSTER_BODY_SIDELIST(varargs_calls, varargs, CheckVarargsCall, tokens);
+    BUSTER_BODY_SIDELIST(x86_calls, x86, CheckX86Call, tokens);
+    BUSTER_BODY_SIDELIST(overload_calls, overload, CheckOverloadCall, tokens);
+    BUSTER_BODY_SIDELIST(region_proofs, region_proof, CheckRegionProof, tokens);
+    BUSTER_BODY_SIDELIST(region_steps, region_step, CheckRegionProofStep, tokens <= UINT32_MAX / 9 ? 9 * tokens : UINT32_MAX);
+#undef BUSTER_BODY_SIDELIST
+
+    input.graph.const_values = &input.const_values;
+    reader.value_next = next;
+    check_input_expressions_coded_range(&reader, begin, stop);
+    if (input.resource || input.report_count != 0) return false;
+    check_graph_record_finish(&input.graph);
+    CheckStream stream;
+    if (!check_graph_run(top->types, &input.graph, checked, scratch, &(CheckOptions){ 0 }, &stream)) return false;
+    if (getenv("BUSTER_BODY_SOURCE_OPS") != NULL) check_body_source_operations(&reader,&input,&stream,close,scratch);
+    fprintf(stderr,"body-source-row\t%u\t%u\t%016llx\n", close, input.graph.count,
+            (unsigned long long)check_body_fingerprint(top->types, &input.graph, &stream, 0, input.graph.count, close));
+    *made = input.graph.count;
+    return true;
+}
+
+// This verification entry stops before the ordinary expression graph is filled. File-scope binding and
+// token/type columns are retained, and only audited complete function trees enter the local expression producer.
+static void check_body_source_run(CheckInputReader* reader)
+{
+    Arena graph = arena_reserve(1ull << 36), checked = arena_reserve(1ull << 36), scratch = arena_reserve(1ull << 36);
+    const uint32_t count = reader->parser->tokens.count;
+    const Parser* parser = reader->parser;
+    uint32_t begin = 0, admitted = 0, bodies = 0, produced = 0, skipped = 0, nodes = 0, biggest = 0;
+    bool safe = true;
+    const bool explore = getenv("BUSTER_CHECK_BODY_ADMIT_ALL") != NULL;
+    for (uint32_t i = 0; i < count; i += 1)
+    {
+        const uint32_t t = reader->postorder[i];
+        safe = safe && check_deferred_expression_parallel(reader, t);
+        if (parser->tree.parents[t] >= count)
+        {
+            if (parser->tree.roles[t] == PARSE_ROLE_CLOSE_BODY)
+            {
+                bodies += 1;
+                if (safe || explore)
+                {
+                    uint32_t made = 0;
+                    admitted += 1;
+                    if (check_body_source_one(reader, begin, i + 1, t, &graph, &checked, &scratch, &made))
+                    {
+                        produced += 1; nodes += made; biggest = biggest > made ? biggest : made;
+                    }
+                    else skipped += 1;
+                    arena_pop_to(&graph, 0); arena_pop_to(&checked, 0); arena_pop_to(&scratch, 0);
+                }
+            }
+            begin = i + 1;
+            safe = true;
+        }
+    }
+    fprintf(stderr,"body-source-summary\tunit-graph-capacity=%u\tbodies=%u\tadmitted=%u\tproduced=%u\tdeclined=%u\tnodes=%u\tlargest-checked=%u\tunit-graph-nodes=%u\tgraph-peak=%llu\tstream-peak=%llu\tscratch-peak=%llu\n",
+            reader->output->graph.capacity,bodies,admitted,produced,skipped,nodes,biggest,reader->output->graph.count,(unsigned long long)graph.peak,(unsigned long long)checked.peak,(unsigned long long)scratch.peak);
+    fprintf(stderr,"body-source-pages\tgraph=%llu\tstream=%llu\tscratch=%llu\n",
+            (unsigned long long)check_body_residency_mapped(&graph),(unsigned long long)check_body_residency_mapped(&checked),
+            (unsigned long long)check_body_residency_mapped(&scratch));
+    arena_release(&graph);arena_release(&checked);arena_release(&scratch);
+    exit(produced > 0 && begin == count ? 0 : 1);
+}
diff --git a/src/buster/compiler/c_check_body_source_operations.c b/src/buster/compiler/c_check_body_source_operations.c
new file mode 100644
index 000000000..8c07ce770
--- /dev/null
+++ b/src/buster/compiler/c_check_body_source_operations.c
@@ -0,0 +1,229 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+
+// Source-first experiment. These bounded arrays become the validator's and selector's actual input while
+// the reader's checked body is alive. A rejected expression produces no row.
+typedef struct CheckBodyReturnOps
+{
+    uint8_t kinds[96];
+    uint8_t classes[96];
+    uint64_t values[96];
+    uint32_t objects[6];
+    uint8_t local_classes[6];
+    uint32_t parameters;
+    const TypeTable* types;
+    const Parser* parser;
+    AbiCall call;
+    AbiLocation outgoing[6];
+    uint8_t argument_classes[6];
+    uint32_t args;
+    SymbolId target;
+    IdentId target_name;
+    uint32_t count;
+} CheckBodyReturnOps;
+
+static bool check_body_return_append(CheckBodyReturnOps* ops, uint8_t kind, uint8_t class, uint64_t value)
+{
+    if (ops->count == BUSTER_ARRAY_LENGTH(ops->kinds)) return false;
+    const uint32_t i = ops->count++;
+    ops->kinds[i] = kind;
+    ops->classes[i] = class;
+    ops->values[i] = value;
+    return true;
+}
+
+static const uint8_t check_body_gp[6] = { BUSTER_ABI_RDI, BUSTER_ABI_RSI, BUSTER_ABI_RDX, BUSTER_ABI_RCX, BUSTER_ABI_R8, BUSTER_ABI_R9 };
+
+static uint8_t check_body_scalar(const TypeTable* types, TypeId type)
+{
+    if (type_extended_qualifiers(types,type) != 0 || (type_qualifiers(type) & BUSTER_TYPE_VOLATILE) != 0) return UINT8_MAX;
+    const uint8_t kind = type_kind(types,type);
+    uint32_t bits = 0;
+    bool sign = false;
+    if (kind == BUSTER_TYPE_KIND_POINTER) return BUSTER_TYPED_CLASS_U64;
+    if (!check_action_integer_type(types,type,&bits,&sign) || (bits != 8 && bits != 16 && bits != 32 && bits != 64)) return UINT8_MAX;
+    return check_lower_type_class(types,type);
+}
+
+static bool check_body_plain_function(const TypeTable* types, TypeId type)
+{
+    return type_kind(types,type) == BUSTER_TYPE_KIND_FUNCTION && type_function_abi_kind(types,type) == TYPE_FUNCTION_ABI_SYSV &&
+           type_function_extended_abi(types,type) == 0 && !type_function_has_parameter_abis(types,type) &&
+           (types->types.flags[type_index(type)] & (BUSTER_TYPE_FLAG_PROTOTYPE | BUSTER_TYPE_FLAG_VARIADIC)) == BUSTER_TYPE_FLAG_PROTOTYPE &&
+           check_body_scalar(types,type_return(types,type)) != UINT8_MAX;
+}
+
+static bool check_body_return_operand(const CheckGraph* graph, const CheckStream* stream, uint32_t node,
+                                      CheckBodyReturnOps* ops, uint32_t depth)
+{
+    if (node >= graph->count || depth > 48) return false;
+    const CheckValue v = check_stream_value(stream, node);
+    const TypeTable* types = ops->types;
+    const uint8_t class = check_body_scalar(types,v.type);
+    if (class == UINT8_MAX || v.fault != CHECK_FAULT_NONE || stream->diagnostics[node] != 0 ||
+        (v.flags & (BUSTER_CHECK_BIT_FIELD | BUSTER_CHECK_FP_ENVIRONMENT | BUSTER_CHECK_VOLATILE_PART)) != 0) return false;
+    const CheckOp op = graph->ops[node];
+    if (v.constant_kind == CHECK_CONSTANT_INTEGER && v.category == CHECK_RVALUE && (v.flags & BUSTER_CHECK_SIDE_EFFECT) == 0)
+    {
+        const uint32_t width = 8u << ((class - 1) / 2);
+        uint64_t bits = v.integer;
+        if (width < 64)
+        {
+            const uint64_t mask = (UINT64_C(1) << width) - 1;
+            bits &= mask;
+            if ((class & 1) != 0 && (bits >> (width - 1)) != 0) bits |= ~mask;
+        }
+        return check_body_return_append(ops,BUSTER_TYPED_CONST,class,bits);
+    }
+    if (op == CHECK_OP_VALUE && v.category == CHECK_LVALUE)
+    {
+        for (uint32_t p = 0; p < ops->parameters; p += 1)
+            if (v.object == ops->objects[p] && v.offset == 0 && class == ops->local_classes[p]) return check_body_return_append(ops,BUSTER_TYPED_LOCAL,class,p);
+        return false;
+    }
+    if (op == CHECK_OP_CALL && ops->target == 0)
+    {
+        const uint32_t callee = graph->operand0[node];
+        if (callee >= graph->count || graph->ops[callee] != CHECK_OP_VALUE) return false;
+        const CheckValue target = check_stream_value(stream,callee);
+        if (target.category != CHECK_FUNCTION || target.constant_kind != CHECK_CONSTANT_ADDRESS || target.object == 0 || target.offset != 0 ||
+            (target.flags & (BUSTER_CHECK_SIDE_EFFECT | BUSTER_CHECK_FP_ENVIRONMENT)) != 0) return false;
+        const uint32_t t = graph->tokens[callee];
+        const Parser* parser = ops->parser;
+        if (t >= parser->tokens.count || parser->tokens.kinds[t] != PARSE_KIND_IDENTIFIER) return false;
+        if (!check_body_plain_function(ops->types,target.type)) return false;
+        uint32_t n = 0;
+        const TypeId* args = type_parameters(ops->types,target.type,&n);
+        if (n != graph->argument_counts[node] || n > 6) return false;
+        ops->target = target.object;
+        ops->target_name = parser->tokens.names[t];
+        ops->args = n;
+        ops->call = (AbiCall){.integer_registers = (uint8_t)n, .stack_alignment_log2 = 4, .result = { .kind = BUSTER_ABI_RESULT_REGISTERS,
+                    .part_bytes = 8, .registers = {BUSTER_ABI_RAX,BUSTER_ABI_REGISTER_NONE} }};
+        for (uint32_t a = 0; a < n; a += 1)
+        {
+            const uint32_t index = graph->argument_offsets[node] + a;
+            if (check_body_scalar(types,args[a]) == UINT8_MAX || args[a] != stream->argument_conversions[index].type ||
+                check_body_scalar(types,check_stream_type(stream,graph->argument_nodes[index])) != check_body_scalar(types,args[a]) ||
+                !check_body_return_operand(graph,stream,graph->argument_nodes[index],ops,depth + 1)) return false;
+            ops->argument_classes[a] = check_body_scalar(types,args[a]);
+            ops->outgoing[a] = (AbiLocation){.kind=BUSTER_ABI_LOCATION_REGISTERS, .registers = {check_body_gp[a],BUSTER_ABI_REGISTER_NONE}};
+        }
+        return check_body_return_append(ops,BUSTER_TYPED_CALL,class,0);
+    }
+    if (op == CHECK_OP_CONVERT || op == CHECK_OP_CAST || op == CHECK_OP_POSITIVE)
+    {
+        if (check_body_scalar(types,check_stream_type(stream,graph->operand0[node])) != class) return false;
+        return check_body_return_operand(graph, stream, graph->operand0[node], ops, depth + 1);
+    }
+    if (op == CHECK_OP_DEREFERENCE || op == CHECK_OP_ARROW)
+    {
+        const uint32_t a = graph->operand0[node];
+        if (a >= graph->count || type_kind(types,check_stream_type(stream,a)) != BUSTER_TYPE_KIND_POINTER) return false;
+        const uint64_t offset = op == CHECK_OP_ARROW ? stream->member_offsets[node] : 0;
+        if ((offset & 7) != 0 || check_lower_segment_override(types,v.type) != 0 ||
+            !check_body_return_operand(graph,stream,a,ops,depth + 1)) return false;
+        if (offset != 0 && !(check_body_return_append(ops,BUSTER_TYPED_CONST,BUSTER_TYPED_CLASS_U64,offset / 8) &&
+                             check_body_return_append(ops,BUSTER_TYPED_PTR_ADD,BUSTER_TYPED_CLASS_U64,1))) return false;
+        return check_body_return_append(ops,BUSTER_TYPED_LOAD,class,check_lower_access_value(types,class,v.type));
+    }
+    if (op == CHECK_OP_NEGATIVE || op == CHECK_OP_BIT_NOT)
+        return check_body_return_operand(graph, stream, graph->operand0[node], ops, depth + 1) &&
+               check_body_return_append(ops,op == CHECK_OP_NEGATIVE ? BUSTER_TYPED_NEG : BUSTER_TYPED_NOT,class,0);
+    if (op != CHECK_OP_ADD && op != CHECK_OP_SUBTRACT && op != CHECK_OP_MULTIPLY && op != CHECK_OP_BIT_AND &&
+        op != CHECK_OP_BIT_OR && op != CHECK_OP_BIT_XOR && (op < CHECK_OP_LESS || op > CHECK_OP_NOT_EQUAL)) return false;
+    if (type_kind(types,v.type) == BUSTER_TYPE_KIND_POINTER || check_body_scalar(types,check_stream_type(stream,graph->operand0[node])) != class ||
+        check_body_scalar(types,check_stream_type(stream,graph->operand1[node])) != class) return false;
+    return check_body_return_operand(graph, stream, graph->operand0[node], ops, depth + 1) &&
+           check_body_return_operand(graph, stream, graph->operand1[node], ops, depth + 1) &&
+           check_body_return_append(ops,check_lower_binary(op),class,0);
+}
+
+static void check_body_operations_row(const char* path, uint32_t close, IdentId own, const Tier0Function* function,
+                                      const Tier0Code* code, const InternTable* names, IdentId target, const CheckProgram* program)
+{
+    if (code->error != TIER0_OK || function->count > 96 || code->count >= 256 || code->branch_count != 0 || code->reference_count > 1) return;
+    fprintf(stderr,"body-ops-%s\t%u\t%.*s\t%u\t%u\t",path,close,(int)intern_length(names,own),intern_bytes(names,own),function->parameter_count,function->count);
+    for (uint32_t i = 0; i < function->count; i += 1)
+        fprintf(stderr,"%02x:%02x:%016llx,",function->kinds[i],function->classes[i],(unsigned long long)function->values[i]);
+    fprintf(stderr,"\t");
+    uint8_t bytes[BUSTER_X86_ENCODER_CAPACITY(256)];
+    uint32_t ends[256];
+    const int64_t length = x86_encode(code->records, code->count, bytes, sizeof(bytes), 0, ends);
+    for (int64_t i = 0; i < length; i += 1) fprintf(stderr,"%02x",bytes[i]);
+    fprintf(stderr,"\t");
+    if (code->reference_count != 0)
+    {
+        const LinkReference ref = code->references[0];
+        const uint32_t distance = x86_fixup_distance(code->records[ref.instruction].form,ref.field);
+        if (program != NULL && ref.target != 0 && ref.target <= program->symbol_count)
+        {
+            const uint32_t object = program->symbol_objects[ref.target - 1];
+            if (object < program->object_count)
+            {
+                const uint32_t decl = program->object_declarations[object];
+                if (decl < program->parser->tokens.count) target = program->parser->tokens.names[decl];
+            }
+        }
+        fprintf(stderr,"%u:%u:%lld:%.*s",ends[0] - distance,ref.kind,(long long)(ref.addend - (link_fixup_kinds[ref.kind].pc_relative ? distance : 0)),
+                (int)intern_length(names,target),intern_bytes(names,target));
+    }
+    fprintf(stderr,"\n");
+}
+
+static bool check_body_build_record(const Parser* parser, const TypeTable* types, const CheckInput* input, const CheckStream* stream,
+                                    uint32_t open, uint32_t close, CheckBodyPublished* output, const InternTable* audit, Arena* scratch)
+{
+    if (open == 0 || open + 3 >= close || parser->tokens.kinds[open + 1] != PARSE_KIND_RETURN || parser->tokens.kinds[close - 1] != PARSE_KIND_SEMI) return false;
+    for (uint32_t t = open + 2; t < close - 1; t += 1)
+        if (parser->tokens.kinds[t] == PARSE_KIND_SEMI || parser->tokens.kinds[t] == PARSE_KIND_L_BRACE) return false;
+    const uint32_t decl = check_sparse_get(input->body_declarations, open);
+    if (decl >= input->token_count) return false;
+    const TypeId type = input->declared_types[decl];
+    if (!check_body_plain_function(types,type)) return false;
+    CheckBodyReturnOps ops = {.types=types, .parser=parser};
+    const TypeId* types_of = type_parameters(types,type,&ops.parameters);
+    if (ops.parameters > 6) return false;
+    uint32_t param = check_sparse_get(input->parameters, open);
+    AbiLocation locations[6];
+    uint8_t local_flags[6] = { 0 };
+    const uint32_t first = 0;
+    const uint8_t va = 0;
+    for (uint32_t p = 0; p < ops.parameters; p += 1)
+    {
+        if (param >= input->token_count || check_body_scalar(types,types_of[p]) == UINT8_MAX || check_sparse_get(input->parameters,param) != p) return false;
+        ops.objects[p] = input->objects[param];
+        ops.local_classes[p] = check_body_scalar(types,types_of[p]);
+        locations[p] = (AbiLocation){ .kind = BUSTER_ABI_LOCATION_REGISTERS, .registers = {check_body_gp[p],BUSTER_ABI_REGISTER_NONE} };
+        param = check_sparse_get(input->parameter_next,param);
+    }
+    const uint32_t root = input->token_nodes[open+1];
+    if (!check_body_return_operand(&input->graph,stream,root,&ops,0) || check_body_scalar(types,check_stream_type(stream,root)) != check_body_scalar(types,type_return(types,type)) ||
+        !check_body_return_append(&ops,BUSTER_TYPED_RETURN,check_body_scalar(types,type_return(types,type)),0)) return false;
+    Tier0Function function = { .kinds = ops.kinds, .classes = ops.classes, .values = ops.values, .count = ops.count,
+         .parameter_count = ops.parameters, .parameters = locations, .local_count = ops.parameters, .local_classes = ops.local_classes, .local_flags = local_flags,
+         .call_count = ops.target == 0 ? 0 : 1, .calls=&ops.call, .call_targets=&ops.target, .call_first=&first, .call_argument_counts=&ops.args,
+         .call_variadic=&va, .argument_locations=ops.outgoing, .argument_classes=ops.argument_classes, .argument_count=ops.args,
+         .result = { .kind = BUSTER_ABI_RESULT_REGISTERS, .part_bytes = 8, .registers = { BUSTER_ABI_RAX,BUSTER_ABI_REGISTER_NONE } } };
+    *output = check_body_capture(close,decl,&function);
+    if (audit != NULL)
+    {
+        if (!(x86_encoder_initialize() && x86_semantics_initialize() && x86_zen5_initialize() && tier0_initialize())) abort();
+        const Tier0Check checked = tier0_validate(&function);
+        if (checked.error != TIER0_OK) { fprintf(stderr,"body-ops-invalid\t%u\t%s\n", close, checked.rule); return false; }
+        const Tier0Code code = tier0_compile(&function,scratch);
+        check_body_operations_row("source",close,parser->tokens.names[decl],&function,&code,audit,ops.target_name,NULL);
+    }
+    return true;
+}
+
+static void check_body_source_operations(CheckInputReader* reader, const CheckInput* input, const CheckStream* stream, uint32_t close, Arena* scratch)
+{
+    const Parser* parser = reader->parser;
+    uint32_t open = close;
+    while (open != 0 && !(parser->tokens.kinds[open] == PARSE_KIND_L_BRACE && parser->tree.parents[open] == close)) open -= 1;
+    CheckBodyPublished row;
+    if (!check_body_build_record(parser,reader->types,input,stream,open,close,&row,reader->pp->table,scratch)) return;
+    const char* save = getenv("BUSTER_BODY_WRITE_PUBLICATION");
+    if (save != NULL) check_body_save_publication(save,&row);
+}
