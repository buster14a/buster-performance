+
+static SymbolId check_source_runtime_target(const CheckSourceBody* saved,const CheckProgram* program,CheckLowerWriter* writer,SymbolId symbol)
+{
+    if(symbol==0) return 0;
+    if(symbol<=saved->symbols) return program->object_symbols[saved->objects[symbol-1]];
+    const uint32_t ordinal=symbol-saved->symbols-1;
+    return ordinal<saved->runtime_count?check_lower_runtime(writer,(CheckLowerRuntime)saved->runtime_order[ordinal]):0;
+}
+
+static bool check_live_control_bind(const CheckSourceBody* saved,const CheckProgram* program,Tier0Function* function,uint32_t body,CheckLowerWriter* writer,Arena* output)
+{
+    *function=*saved->function;
+    uint64_t* values=BUSTER_ARENA_PUSH_ARRAY(output,uint64_t,(uint64_t)function->count+1);
+    SymbolId* targets=BUSTER_ARENA_PUSH_ARRAY(output,SymbolId,(uint64_t)function->call_count+1);
+    if(values==NULL || targets==NULL) return false;
+    for(uint32_t r=0;r<saved->runtime_count;r+=1)
+        check_lower_runtime(writer,(CheckLowerRuntime)saved->runtime_order[r]);
+    const SymbolId copy=check_source_runtime_target(saved,program,writer,function->hidden_copy);
+    if(function->hidden_copy!=0 && copy==0) return false;
+    function->hidden_copy=copy;
+    uint32_t first_table=0;
+    if (saved->table_count!=0)
+    {
+        first_table=check_lower_table_of(writer->tables,writer->table_count,body,program->bodies[body].first+saved->tables[0].control);
+        if (first_table>=writer->table_count || saved->table_count>writer->table_count-first_table ||
+            saved->case_count>writer->label_symbol_capacity-writer->output->label_symbol_count) return false;
+        const uint32_t first_label=writer->tables[first_table].first_label;
+        for (uint32_t k=0;k<saved->case_count;k+=1)
+            writer->output->label_symbols[writer->output->label_symbol_count++]=BUSTER_CHECK_LOWER_CASE_SYMBOL | (first_label+saved->case_ordinals[k]);
+    }
+    for(uint32_t i=0;i<function->count;i+=1)
+    {
+        uint64_t value=function->values[i];
+        if(tier0_global_kind(function->kinds[i]))
+        {
+            const uint64_t table=value-saved->table_symbol;
+            if(table<saved->table_count) value=(uint64_t)writer->provisional_tables+first_table+table;
+            else
+            {
+                if(value==0 || value>saved->symbols) return false;
+                value=program->object_symbols[saved->objects[value-1]];
+                if(value==0) return false;
+            }
+        }
+        values[i]=value;
+    }
+    for(uint32_t c=0;c<function->call_count;c+=1)
+    {
+        const SymbolId symbol=function->call_targets[c];
+        targets[c]=check_source_runtime_target(saved,program,writer,symbol);
+        if(symbol!=0 && targets[c]==0) return false;
+    }
+    function->values=values;
+    function->call_targets=targets;
+    return true;
+}
