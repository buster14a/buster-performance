+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+// Emit the ordinary control tape and per-body object dependencies before the source checker retires its graph.
+// The ordinary record uses the same function-local node numbering. Its references are independently sorted.
+static void check_source_control_record(const char* arm, uint32_t close, const CheckControl* entries, uint32_t count,
+                                        uint32_t first_node, const uint32_t* refs, uint32_t ref_count, const CheckProgram* program)
+{
+    fprintf(stderr, "source-control-%s\t%u\t%u\t%u", arm, close, count, ref_count);
+    for (uint32_t i = 0; i < count; i += 1)
+    {
+        const CheckControl entry = entries[i];
+        const uint32_t node = entry.node == BUSTER_CHECK_NONE || entry.kind == CHECK_CONTROL_LIFETIME ? entry.node : entry.node - first_node;
+        fprintf(stderr, "\t%u,%u,%u,%u", (uint32_t)entry.kind, entry.token, node,
+                entry.kind == CHECK_CONTROL_INITIALIZE ? program->initializers->declaration_tokens[entry.target] :
+                entry.kind == CHECK_CONTROL_CASE ? program->cases[entry.target].token : entry.target);
+    }
+    fprintf(stderr, "\trefs");
+    for (uint32_t i = 0; i < ref_count; i += 1) fprintf(stderr, ",%u", refs[i]);
+    fputc('\n', stderr);
+}
+
+static void check_source_control_oracle(const CheckProgram* p, const Parser* parser)
+{
+    uint32_t body = 0, node = 0;
+    for (uint32_t t = 0; t < parser->tokens.count; t += 1)
+    {
+        if (parser->tree.parents[t] < parser->tokens.count) continue;
+        const uint32_t first = node;
+        while (node < p->input->graph.count && p->input->graph.tokens[node] <= t) node += 1;
+        if (body < p->body_count && parser->tree.parents[p->bodies[body].opening] == t)
+        {
+            const CheckProgramBody* b = p->bodies + body++;
+            check_source_control_record("whole", t, p->controls + b->first, b->count, first,
+                                        b->reference_count == 0 ? NULL : p->references + b->reference_first, b->reference_count, p);
+        }
+    }
+}
+
+static void check_live_control_native(CheckSourceControlUnit* unit, CheckProgram* program, CheckInputReader* reader, uint32_t opening, uint32_t close,
+                                      CheckControl* entries,uint32_t entry_count,uint32_t count,uint32_t* references,uint32_t reference_count,Arena* scratch);
+
+static bool check_source_control_labels(CheckSourceControlUnit* unit, const CheckInput* input, Arena* output)
+{
+    CheckProgram p = { .input = input };
+    if (!check_program_labelled_objects(&p, output)) return false;
+    unit->object_labelled = p.object_labelled;
+    return true;
+}
