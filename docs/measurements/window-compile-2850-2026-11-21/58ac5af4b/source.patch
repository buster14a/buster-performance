+        fprintf(stderr,"control-source-decline\t%u\t%s\t%u\t%u\n",close,kind,detail,input->graph.count);
+}
+#define BUSTER_SOURCE_CONTROL_DECLINE(why, detail) do { check_source_control_decline(input,close,why,detail); return; } while(0)
+static void check_source_control_function(CheckSourceControlUnit* unit, CheckInputReader* reader,
+                                          CheckStream* stream, uint32_t close, Arena* output, Arena* scratch)
+{
+    const Parser* parser = reader->parser;
+    const CheckInput* input = reader->output;
+    uint32_t opening = BUSTER_CHECK_NONE;
+    for (uint32_t t = reader->first_child[close]; t != BUSTER_CHECK_NONE; t = reader->next_child[t])
+        if (parser->tree.roles[t] == PARSE_ROLE_OPEN_BODY) opening = t;
+    if (opening >= close) BUSTER_SOURCE_CONTROL_DECLINE("opening",0);
+    uint32_t case_count = 0;
+    for (uint32_t t = opening + 1; t < close; t += 1)
+    {
+        const uint8_t role = parser->tree.roles[t], kind = parser->tokens.kinds[t];
+        case_count += role == PARSE_ROLE_CLOSE_CASE;
+        if (kind == PARSE_KIND_AMPAMP && role == PARSE_ROLE_PREFIX) BUSTER_SOURCE_CONTROL_DECLINE("attribute-or-label-address",role);
+    }
+    for (uint32_t i = 0; i < input->asm_count; i += 1)
+        if (input->asm_statements[i].statement - opening < close - opening) BUSTER_SOURCE_CONTROL_DECLINE("asm_statements",i);
+    for (uint32_t i = 0; i < input->region_count; i += 1)
+        if (input->regions[i].opening - opening < close - opening) BUSTER_SOURCE_CONTROL_DECLINE("regions",i);
+    for (uint32_t i = 0; i < input->vla_count; i += 1)
+        if (input->vlas[i].declaration - opening < close - opening) BUSTER_SOURCE_CONTROL_DECLINE("vlas",i);
+    for (uint32_t i = 0; i < input->cleanup_count; i += 1)
+        if (input->cleanups[i].declaration - opening < close - opening) BUSTER_SOURCE_CONTROL_DECLINE("cleanups",i);
+    const CheckGraph* graph = &input->graph;
+    if (graph->overload_count != 0 || stream->overload_address_count != 0) BUSTER_SOURCE_CONTROL_DECLINE("overload",0);
+    for (uint32_t i = 0; i < graph->count; i += 1)
+        if (graph->ops[i] == CHECK_OP_STATEMENT_VALUE ||
+            (graph->ops[i] == CHECK_OP_BUILTIN_MISC && (graph->members[i] == CBUILTIN_CFSTRING_MAKE_CONSTANT_STRING ||
+                                                         graph->members[i] == CBUILTIN_NSSTRING_MAKE_CONSTANT_STRING))) BUSTER_SOURCE_CONTROL_DECLINE("builtin",graph->ops[i]);
+    CheckInitializers plans = { .token_count = input->token_count };
+    for (uint32_t token = check_sparse_next(input->initializer_begins, opening, close); token < close;
+         token = check_sparse_next(input->initializer_begins, token + 1, close)) plans.count += 1;
+    uint32_t* plan_next = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, plans.count + 1);
+    plans.plans = BUSTER_ARENA_PUSH_ARRAY(output, CheckInitializer, plans.count + 1);
+    plans.declaration_tokens = BUSTER_ARENA_PUSH_ARRAY(output, uint32_t, plans.count + 1);
+    if (!plan_next || !plans.plans || !plans.declaration_tokens) exit(2);
+    uint32_t at = 0;
+    for (uint32_t token = check_sparse_next(input->initializer_begins, opening, close); token < close;
+         token = check_sparse_next(input->initializer_begins, token + 1, close))
+    {
+        const uint32_t begin = check_sparse_get(input->initializer_begins, token);
+        const uint32_t end = check_sparse_get(input->initializer_ends, token);
+        if (end > close || begin >= end || check_init_object_candidate(input, reader->types, token)) BUSTER_SOURCE_CONTROL_DECLINE("init-shape",token);
+        if (!check_initializer_plan_warnings(reader->types, parser, input->token_nodes, stream, input->strings,
+                input->string_count, input->string_ids, input->declared_types[token], begin, end,
+                check_input_bit(input->declaration_bits, token, BUSTER_CHECK_BITS_STATIC), false, true,
+                output, scratch, plans.plans + at, graph, NULL, NULL, NULL, NULL)) BUSTER_SOURCE_CONTROL_DECLINE("init-plan",token);
