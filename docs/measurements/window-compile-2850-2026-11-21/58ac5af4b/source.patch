+    const uint32_t slots = graph->count + 1;
+    const uint32_t capacity = (close - opening + 1) * 8 + 16;
+    CheckProgram p = { .input = input, .stream = stream, .parser = parser, .types = reader->types,
+                       .object_count = names, .object_labelled=unit->object_labelled, .initializers = &plans, .identifiers = reader->pp->table };
+    check_program_plans(&p, parser, &plans, unit->plan_first, unit->planned, plan_next, unit->parent_cache);
+    if (p.status != CHECK_PROGRAM_OK) BUSTER_SOURCE_CONTROL_DECLINE("control-failure",p.status);
+    CheckControlWriter writer = { .program = &p, .parser = parser, .first = unit->first, .last = unit->last,
+                                   .next = unit->next, .previous = unit->previous, .token_first = unit->token_head,
+                                   .planned = unit->planned, .plan_first = unit->plan_first, .plan_next = plan_next, .capacity = capacity, .fold_capacity = slots,
+                                   .switch_scratch = scratch, .region_final = BUSTER_CHECK_NONE };
+    writer.case_first = unit->case_first;
+    writer.case_map = unit->case_map;
+    writer.source_labels = unit->source_labels;
+    writer.label_positions = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, capacity);
+    uint32_t* case_next = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, case_count + 1);
+    p.cases = BUSTER_ARENA_PUSH_ARRAY(scratch, CheckProgramCase, case_count + 1);
+    writer.case_next = case_next;
+    writer.switch_capacity = case_count / 4;
+    writer.switches = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, writer.switch_capacity + 1);
+    if (!writer.label_positions || !case_next || !p.cases || !writer.switches) exit(2);
+    if (case_count != 0) memset(unit->case_map + opening, 0xff, (close - opening + 1) * sizeof(uint32_t));
+    memset(unit->case_first + opening, 0xff, (close - opening + 1) * sizeof(uint32_t));
+    for (uint32_t t = opening + 1; t < close && p.status == CHECK_PROGRAM_OK; t += 1)
+    {
+        if ((parser->tokens.kinds[t] == PARSE_KIND_SWITCH || parser->tree.roles[t] == PARSE_ROLE_CLOSE_CASE) &&
