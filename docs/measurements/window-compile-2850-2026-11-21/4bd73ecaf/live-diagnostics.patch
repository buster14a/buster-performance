+static bool check_body_diagnostic_control(CheckInputReader* reader, CheckInput* input, const CheckStream* stream, uint32_t closing,
+                                          CheckBodyDiagnosticIndex* index, CheckProgram* program, CheckProgramBody* body, Arena* scratch)
+{
+    const Parser* p = reader->parser;
+    uint32_t opening = reader->first_child[closing];
+    while (opening < closing && p->tree.roles[opening] != PARSE_ROLE_OPEN_BODY) opening = reader->next_child[opening];
+    if (opening >= closing || input->region_count != 0) return false;
+    const uint32_t declaration = check_sparse_get(input->body_declarations, opening);
+    if (declaration >= input->token_count) return false;
+    for (uint32_t i = opening; i <= closing; ++i)
+    {
+        if (p->tokens.kinds[i] == PARSE_KIND_SWITCH || p->tree.roles[i] == PARSE_ROLE_CLOSE_CASE ||
+            p->tree.roles[i] == PARSE_ROLE_LABEL || p->tree.roles[i] == PARSE_ROLE_CLOSE_ASM) return false;
+    }
+    for (uint32_t i = 0; i < input->cleanup_count; ++i)
+        if (input->cleanups[i].declaration >= opening && input->cleanups[i].declaration <= closing) return false;
+    for (uint32_t i = 0; i < input->vla_count; ++i)
+        if (input->vlas[i].body == opening) return false;
+    const uint32_t graph_count=input->graph.count;
+    const uint64_t capacity=(uint64_t)(closing-opening+1)*8+16;
+    if (capacity > UINT32_MAX) return false;
+    CheckControlWriter writer = {
+        .parser=p, .program=program, .first=index->first, .last=index->last, .next=index->next, .previous=index->previous,
+        .token_first=index->token_first, .planned=index->planned, .region_final=BUSTER_CHECK_NONE, .switch_scratch=scratch,
+        .capacity=(uint32_t)capacity, .fold_capacity=graph_count+1,
+    };
+    writer.entries=BUSTER_ARENA_PUSH_ARRAY(scratch,CheckControl,capacity);
+    writer.tasks=BUSTER_ARENA_PUSH_ARRAY(scratch,CheckControlTask,capacity);
+    writer.labels=BUSTER_ARENA_PUSH_ARRAY(scratch,uint32_t,capacity);
+    writer.dropped_ranges=BUSTER_ARENA_PUSH_ARRAY(scratch,uint64_t,(uint64_t)closing-opening+2);
+    writer.fold_stack=BUSTER_ARENA_PUSH_ARRAY(scratch,uint32_t,(uint64_t)graph_count+1);
+    writer.static_initializers=BUSTER_ARENA_PUSH_ARRAY(scratch,uint64_t,((uint64_t)graph_count+64)/64);
+    uint32_t* node_next=BUSTER_ARENA_PUSH_ARRAY(scratch,uint32_t,(uint64_t)graph_count+1);
+    if (!writer.entries || !writer.tasks || !writer.labels || !writer.dropped_ranges || !writer.fold_stack ||
+        !writer.static_initializers || !node_next) return false;
+    writer.node_next=node_next;
+    memset(index->token_first+opening,0xff,((uint64_t)closing-opening+1)*sizeof(uint32_t));
+    for (uint32_t n=graph_count; n-- > 0;)
+    {
+        uint32_t token=input->graph.tokens[n];
+        if (token>=opening && token<=closing) {node_next[n]=index->token_first[token];index->token_first[token]=n;}
+    }
+    *program=(CheckProgram){.input=input,.stream=stream,.types=reader->types,.parser=p,.identifiers=reader->pp->table,
+                            .status=CHECK_PROGRAM_OK,.token=BUSTER_CHECK_NONE,.diagnostic_position=BUSTER_CHECK_NONE,.bodies=body,.body_count=1};
+    const uint32_t name=p->tokens.names[declaration];
+    *body=(CheckProgramBody){.declaration=declaration,.opening=opening,.object=input->objects[declaration],
+        .is_main=intern_length(program->identifiers,name)==4 && memcmp(intern_bytes(program->identifiers,name),"main",4)==0};
+    check_control_build(&writer,opening);
+    body->count=writer.count;body->entry_count=writer.entry_count;
+    program->controls=writer.entries;program->control_count=writer.count;
+    program->dropped_ranges=writer.dropped_ranges;program->dropped_range_count=writer.dropped_range_count;
+    CheckReturnFacts facts={0};
+    check_program_return_flow(&writer,body,&facts,check_body_return_baseline!=CHECK_WARNING_IGNORE,true);
+    arena_release(&facts.storage);
+    return program->status==CHECK_PROGRAM_OK;
+}
