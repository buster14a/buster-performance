+static bool check_body_publish_local(CheckInputReader* reader, CheckInput* input, const CheckStream* stream,
+                                     uint32_t begin, uint32_t closing, CheckBodyDiagnosticIndex* index, Arena* output, Arena* scratch)
+{
+    const Parser* p = reader->parser;
+    Preprocessor* pp = reader->pp;
+    const bool quiet = pp->options.suppress_warnings;
+    input->implicit_function_count = 0; input->kr_diagnostic_count = 0;
+    input->packed_member_count = 0; input->fp_pragma_count = 0;
+    input->visibility_pragmas = NULL; input->pack_pragmas = NULL;
+    input->pragma_warnings = (CheckWarningEvents){0};
+    input->constant_warning_count = 0; input->constant_warnings_prepared = true;
+    if (!check_input_warning_graph(input,p,reader->types,stream,output,scratch)) return false;
+    if (!check_driver_reports_from(p,p,pp,pp->output.count,input,stream,reader->types,NULL,NULL,NULL,0,NULL,0,
+                                   quiet,NULL,begin,scratch)) return false;
+    if (!check_driver_warning_events_from(p,pp,input,reader->types,stream,&input->warning_events,NULL,pp->output.count,scratch) ||
+        !check_driver_warning_events_from(p,pp,input,reader->types,stream,&stream->warning_events,NULL,pp->output.count,scratch)) return false;
+    check_driver_x86_reports(p,p,pp,input,stream,reader->types,quiet);
+    CheckProgram local;
+    CheckProgram* program=NULL;
+    CheckProgramBody body;
+    if (!quiet && p->tree.roles[closing] == PARSE_ROLE_CLOSE_BODY)
+    {
+        if (check_body_diagnostic_control(reader,input,stream,closing,index,&local,&body,scratch))
+        {
+            program=&local; ++index->controls;
+            check_driver_return_reports(p,p,pp,program,UINT64_MAX,check_body_return_baseline,false);
+        }
+        else ++index->other_bodies;
+    }
+    if (!quiet && input->graph.count != 0)
+    {
+        check_common_resources.fail_at=UINT32_MAX;
+        check_common_contexts=(CheckCommonContexts){0};
+        CheckWarningSpelling spell={0};
+        const CheckCommonEnabled enabled={
+            .sign_compare=check_common_enabled(pp,input,CHECK_WARNING_ID_SIGN_COMPARE,true),
+            .out_of_range=check_common_enabled(pp,input,CHECK_WARNING_ID_TAUTOLOGICAL_OUT_OF_RANGE_COMPARE,false),
+            .self_assign=check_common_enabled(pp,input,CHECK_WARNING_ID_SELF_ASSIGN,true),
+            .enum_cast=input->enum_names, .const_values=&input->const_values,
+            .atomic_access=reader->types->atomic_records && check_common_enabled(pp,input,CHECK_WARNING_ID_ATOMIC_ACCESS,false),
+        };
+        CheckCommonCandidates candidates={.count=input->graph.count};
+        CheckCommonFacts facts={0};
+        if (!check_common_candidates_build(&input->graph,scratch,&candidates) ||
+            !check_common_facts(input,stream,reader->types,p,program,&enabled,NULL,&candidates,scratch,&facts)) return false;
+        check_common_self_assigns(p,pp,input,stream,reader->types,&spell,&facts,scratch);
+        check_common_graph_warnings(p,pp,input,stream,reader->types,&spell,&facts,program,NULL,scratch);
+        check_common_format(p,pp,input,stream,reader->types,&spell,program,&candidates,scratch);
+        check_common_return_stack(p,pp,input,stream,reader->types,&candidates,scratch);
+        check_common_contexts=(CheckCommonContexts){0};
+    }
+    return true;
+}
+
+static bool check_body_publish_unit(CheckInputReader* r, Arena* scratch)
+{
+    CheckInput* input=r->output;Preprocessor* pp=r->pp; const Parser* p=r->parser;
+    const bool quiet=pp->options.suppress_warnings;
+    if (!check_driver_reports(p,p,pp,pp->output.count,input,NULL,r->types,NULL,NULL,NULL,0,NULL,0,quiet,NULL,scratch))return false;
+    if (!check_driver_warning_events_from(p,pp,input,r->types,NULL,&input->warning_events,NULL,pp->output.count,scratch))return false;
+    if (!quiet)
+    {
+        check_common_empty_bodies(p,pp,input,scratch);
+        check_common_dangling_else(p,pp,input,scratch);
+        check_common_shift_op_parentheses(p,pp,input,scratch);
+    }
+    check_common_chained_comparisons(p,pp,input,scratch);
+    return true;
+}
