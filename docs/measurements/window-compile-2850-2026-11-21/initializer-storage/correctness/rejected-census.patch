+typedef struct InitializerSlotProbe InitializerSlotProbe;
+struct InitializerSlotProbe
+{
+    uint32_t count;
+    uint8_t* marks[2];
+    uint64_t reads[2], writes[2], empty_reads[2], before_reads[2];
+    struct InitializerSlotProbe* next;
+    uint64_t owners[2][4][2];
+    const char* path;
+};
+static InitializerSlotProbe* initializer_probe_unit;
+static void check_initializer_probe_write(const InitializerSlotProbe* p, FILE* out)
+{
+    for(uint32_t f=0;f<2;f++)
+    {
+        uint32_t unique_reads=0,unique_writes=0,untouched=0,lines=0,pages=0;
+        for(uint32_t i=0;i<=p->count;i++)
+        {
+            uint8_t m=p->marks[f][i];
+            unique_reads+=(m&1)!=0;unique_writes+=(m&2)!=0;untouched+=m==0;
+            if ((i%16)==0)
+            {
+                uint8_t any=0;for(uint32_t j=i;j<=p->count && j<i+16;j++) any|=p->marks[f][j];
+                lines+=(any&2)!=0;
+            }
+            if ((i%1024)==0)
+            {
+                uint8_t any=0;for(uint32_t j=i;j<=p->count && j<i+1024;j++) any|=p->marks[f][j];
+                pages+=(any&2)!=0;
+            }
+        }
+        fprintf(out,"%s %u %" PRIu64 " %" PRIu64 " %" PRIu64 " %" PRIu64 " %u %u %u %u %u\n",
+                f==0?"declarations":"finish_heads",p->count+1,p->reads[f],p->writes[f],p->empty_reads[f],p->before_reads[f],
+                unique_reads,unique_writes,untouched,lines,pages);
+    }
+    for (uint32_t has=0;has<2;has++) for (uint32_t tag=0;tag<4;tag++) for (uint32_t visit=0;visit<2;visit++)
+        if (p->owners[has][tag][visit]) fprintf(out,"owner_condition %u %u %u %" PRIu64 "\n",has,tag,visit,p->owners[has][tag][visit]);
+}
+static void check_initializer_probe_finish(void)
+{
+    FILE* out=fopen(initializer_probe_unit->path,"w");if(!out) abort();
+    for(InitializerSlotProbe* p=initializer_probe_unit;p;p=p->next) check_initializer_probe_write(p,out);
+    fclose(out);
+}
+static void check_initializer_probe_begin(CheckInputReader* reader,uint32_t count)
+{
+    const char* path=getenv("BUSTER_INITIALIZER_SLOTS");if(!path) return;
+    InitializerSlotProbe* p=calloc(1,sizeof(*p));if(!p) abort();
+    p->marks[0]=calloc((size_t)count+1,1);p->marks[1]=calloc((size_t)count+1,1);
+    if(!p->marks[0] || !p->marks[1]) abort();
+    p->count=count;p->path=path;reader->slot_probe=p;
+    if(!initializer_probe_unit) {initializer_probe_unit=p;atexit(check_initializer_probe_finish);}
+    else {InitializerSlotProbe* last=initializer_probe_unit;while(last->next) last=last->next;last->next=p;}
+}
+static uint32_t* check_initializer_probe(const CheckInputReader* reader,uint32_t f,uint32_t token,bool write)
+{
+    uint32_t* value=(f?reader->initializer_finish_heads:reader->initializer_declarations)+token;
+    InitializerSlotProbe* p=reader->slot_probe;
+    if (p)
+    {
+        if(token>p->count) abort();
+        if(write) {p->writes[f]++;p->marks[f][token]|=2u;}
+        else { if (f==0) p->owners[*value!=BUSTER_CHECK_NONE][reader->initializers[token]&3u][(reader->visits[token]&BUSTER_CHECK_RESOLVE_DECLARATION)!=0]++;
+               p->reads[f]++;p->empty_reads[f]+=*value==BUSTER_CHECK_NONE;p->before_reads[f]+=(p->marks[f][token]&2u)==0;p->marks[f][token]|=1u;}
+    }
+    return value;
+}
