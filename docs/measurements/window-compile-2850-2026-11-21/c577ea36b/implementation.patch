+        check_test_expect(test, !check_graph_validate(&graph, pure, &state, &failed) && failed == changed,
+                          "the inline overload flag agrees with the extended value");
+        leaves[changed].detail = UINT32_MAX;
+        check_test_expect(test, !check_graph_validate(&graph, pure, &state, &failed) && failed == changed,
+                          "an invalid wide leaf index is rejected at its own node");
+    }
+    arena_pop_to(storage, mark);
