+static bool check_source_file_data(CheckSourceControlUnit* unit, CheckInputReader* reader, CheckStream* stream,
+                                   uint32_t close, Arena* output, Arena* scratch)
+{
+    CheckInput* in = reader->output;
+    const uint32_t decl = unit->file_decl;
+    const uint32_t begin = check_sparse_get(in->initializer_begins, decl);
+    const uint32_t end = check_sparse_get(in->initializer_ends, decl);
+    if (begin <= unit->file_first || begin >= end || end > close + 1 || stream->report_count != 0 ||
+        stream->warning_count != 0 || in->graph.const_warning_count != 0 || reader->warning_events.count != 0 ||
+        check_init_object_candidate(in, reader->types, decl)) return false;
+    for (uint32_t i=0;i<in->graph.count;i+=1)
+    {
+        const uint32_t token = in->graph.tokens[i];
+        if (token - begin >= end - begin && in->graph.ops[i] != CHECK_OP_INITIALIZE &&
+            !(in->graph.ops[i] == CHECK_OP_CAST && token == close)) return false;
+        if (in->graph.ops[i] == CHECK_OP_ADD && token > 0 && token + 1 < in->token_count &&
+            (reader->parser->tokens.kinds[token-1] == PARSE_KIND_STRING || reader->parser->tokens.kinds[token+1] == PARSE_KIND_STRING)) return false;
+    }
+    CheckWarningBuffer warnings = { .arena = reader->arena };
+    CheckInitWarningSink sink = { .events = &warnings };
+    CheckInitWarningCollector collector = { .sink = &sink };
+    check_initializers_noderef(&sink, in, decl);
+    CheckInitializer plan;
+    if (!check_initializer_plan_warnings(reader->types, reader->parser, in->token_nodes, stream, in->strings,
+            in->string_count, in->string_ids, in->declared_types[decl], begin, end, true, false, true,
+            output, scratch, &plan, &in->graph, &collector, NULL, NULL, NULL) ||
+        plan.warning_count != 0 || warnings.count != 0 || plan.label_differences ||
+        plan.changed_integers || plan.enum_values) return false;
+    if (plan.floating_values)
+    {
+        // Ordinary brace diagnostics inspect a floating part converted to an integer.
+        // Admit direct literals stored into floating fields; leave all other conversions with the unit.
+        for (uint32_t i = 0; i < plan.count; i += 1)
+        {
+            const CheckInitPart* part = plan.parts + i;
+            if (part->kind != CHECK_INIT_VALUE || part->node >= stream->count) continue;
+            const TypeId source_type = check_stream_type(stream, part->node);
+            if (check_action_kind(reader->types, source_type) == BUSTER_TYPE_KIND_FLOATING &&
+                (check_action_kind(reader->types, part->conversion.type) != BUSTER_TYPE_KIND_FLOATING ||
+                 in->graph.ops[part->node] != CHECK_OP_VALUE)) return false;
+        }
+    }
+    CheckInitializers plans = { .count = 1, .plans = &plan, .declaration_tokens = &unit->file_decl };
+    CheckProgram p = { .types = reader->types, .stream = stream, .input = in, .initializers = &plans,
+                       .object_count = in->token_count+1 };
+    const uint64_t mark = in->source_body_output->length;
+    CheckInputLiteralTable* pending = NULL;
+    if (!check_live_static_objects(unit, &p, in->source_body_output, scratch, &pending))
+    {
+        arena_pop_to(in->source_body_output, mark);
+        return false;
+    }
+    check_live_static_publish(unit->persistent, pending);
+    return true;
+}
