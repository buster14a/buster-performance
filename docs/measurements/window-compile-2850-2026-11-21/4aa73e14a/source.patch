+    if (nodes <= g->capacity && arguments <= g->argument_capacity) return true;
+    uint64_t next = (uint64_t)g->capacity * 2, args = (uint64_t)g->argument_capacity * 2;
+    if (next < nodes) next = nodes;
+    if (args < arguments) args = arguments;
+    if (next > reader->grow_graph_limit) next = reader->grow_graph_limit;
+    if (args > reader->grow_argument_limit) args = reader->grow_argument_limit;
+    if (next < nodes || args < arguments) return false;
+    CheckGraph storage;
+    if (!check_graph_initialize(&storage, reader->arena, (uint32_t)next, (uint32_t)args)) return false;
+    storage.argument_tokens = BUSTER_ARENA_PUSH_ARRAY(reader->arena, uint32_t, args);
+    storage.recorded_pure = BUSTER_ARENA_PUSH_ARRAY(reader->arena, uint8_t, next);
+    storage.warning_suppressed = BUSTER_ARENA_PUSH_ARRAY(reader->arena, uint8_t, next);
+    if (g->fp_environments != NULL) storage.fp_environments = BUSTER_ARENA_PUSH_ARRAY(reader->arena, uint8_t, next);
+    uint32_t* links = BUSTER_ARENA_PUSH_ARRAY(reader->arena, uint32_t, next);
+    if (!storage.argument_tokens || !storage.recorded_pure || !storage.warning_suppressed ||
+        (g->fp_environments != NULL && storage.fp_environments == NULL) || links == NULL) return false;
+    memset(storage.warning_suppressed, 0, next);
+    if (storage.fp_environments != NULL) memset(storage.fp_environments, 0, next);
+#define CHECK_MOVE_GRAPH(field, amount) do {     memcpy(storage.field, g->field, (uint64_t)(amount) * sizeof(*g->field));     g->field = storage.field; } while (0)
+    CHECK_MOVE_GRAPH(ops, g->count); CHECK_MOVE_GRAPH(tokens, g->count);
+    CHECK_MOVE_GRAPH(operand0, g->count); CHECK_MOVE_GRAPH(operand1, g->count); CHECK_MOVE_GRAPH(operand2, g->count);
+    CHECK_MOVE_GRAPH(types, g->count); CHECK_MOVE_GRAPH(contexts, g->count); CHECK_MOVE_GRAPH(members, g->count);
+    CHECK_MOVE_GRAPH(leaf_slots, g->count); CHECK_MOVE_GRAPH(leaf_records, g->leaf_count);
+    CHECK_MOVE_GRAPH(leaf_payloads, g->leaf_payload_count); CHECK_MOVE_GRAPH(source_positions, g->count);
+    CHECK_MOVE_GRAPH(argument_counts, g->count); CHECK_MOVE_GRAPH(argument_offsets, g->count);
+    CHECK_MOVE_GRAPH(argument_nodes, g->argument_count); CHECK_MOVE_GRAPH(argument_tokens, g->argument_count);
+    CHECK_MOVE_GRAPH(recorded_pure, g->count); CHECK_MOVE_GRAPH(warning_suppressed, g->count);
+    if (g->fp_environments != NULL) CHECK_MOVE_GRAPH(fp_environments, g->count);
+#undef CHECK_MOVE_GRAPH
+    memcpy(links, reader->value_next, (uint64_t)g->count * sizeof(uint32_t));
+    reader->value_next = links;
+    g->capacity = storage.capacity;
+    g->leaf_payload_capacity = storage.leaf_payload_capacity;
+    g->argument_capacity = storage.argument_capacity;
+    return true;
+}
