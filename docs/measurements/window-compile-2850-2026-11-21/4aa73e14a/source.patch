+// This root covers an unbroken source interval. Its reservation depends only on the
+// source kinds in the interval. Count the two expanding kinds in the same vector.
+static uint64_t check_source_extra_nodes(const uint8_t* kinds, uint32_t count)
+{
+    uint64_t extra = 0;
+    for (uint32_t at = 0; at < count; at += 64)
+    {
+        const uint32_t n = count - at;
+        const __mmask64 valid = n >= 64 ? UINT64_MAX : _bzhi_u64(UINT64_MAX, n);
+        const __m512i k = _mm512_maskz_loadu_epi8(valid, kinds + at);
+        const uint64_t subs = _mm512_mask_cmpeq_epi8_mask(valid, k, _mm512_set1_epi8(PARSE_KIND_L_SQUARE));
+        const uint64_t queries = _mm512_mask_cmpeq_epi8_mask(valid, k, _mm512_set1_epi8(PARSE_KIND_SIZEOF));
+        extra += 8ull * __builtin_popcountll(subs) + 4ull * __builtin_popcountll(queries);
+    }
+    return extra;
+}
