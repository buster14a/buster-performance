+static void check_live_control_native(CheckSourceControlUnit* unit,CheckProgram* p,CheckInputReader* reader,uint32_t opening,uint32_t close,CheckControl* entries,
+                                      uint32_t entry_count,uint32_t count,uint32_t* refs,uint32_t ref_count,CheckControlWriter* writer, const CheckWarningBuffer* initializer_events, Arena* scratch)
+{
+    // The caller prepares these tables before starting any unit workers. In a checker-only
+    // entry point without them, the ordinary reader keeps the body.
+    if (!x86_encoder_initialized || !x86_semantics_initialized || !x86_zen5_initialized || !tier0_initialized) return;
+    const char* step = getenv("BUSTER_CONTROL_NATIVE_STRIDE");
+    const char* maximum = getenv("BUSTER_CONTROL_NATIVE_MAX");
+    if (step != NULL || maximum != NULL)
+    {
+        static _Thread_local uint32_t seen;
+        const uint32_t stride = step != NULL ? (uint32_t)strtoul(step, NULL, 10) : 1;
+        seen += 1;
+        if (stride == 0 || (seen - 1) % stride != 0 || (maximum != NULL && seen > (uint32_t)strtoul(maximum, NULL, 10))) return;
+    }
+    const CheckInput* in=p->input;
+    p->target=reader->pp->options.target;
+    p->frame_pointer=predefines_frame_pointer(&reader->pp->options.predefines);
+    p->probe_stack=predefines_stack_clash(&reader->pp->options.predefines);
+    const uint32_t declaration=check_sparse_get(in->body_declarations,opening);
+    if(declaration>=in->token_count) return;
+    const uint32_t own=in->objects[declaration];
+    if(own==0 || own>=p->object_count) return;
+    CheckProgramBody body={.opening=opening,.declaration=declaration,.object=own,.first=0,.count=count,.entry_count=entry_count,.reference_count=ref_count};
+    const IdentId name=reader->parser->tokens.names[declaration];
+    body.is_main=intern_length(p->identifiers,name)==4 && memcmp(intern_bytes(p->identifiers,name),"main",4)==0;
+    p->bodies=&body;
+    p->body_count=1;
+    p->controls=entries;
+    p->control_count=count;
+    p->references=refs;
+    p->reference_count=ref_count;
+    if (unit->object_symbols == NULL)
+    {
+        Arena* arena=unit->native_metadata;
+        unit->object_symbols=BUSTER_ARENA_PUSH_ARRAY(arena,uint32_t,p->object_count);
+        unit->object_declarations=BUSTER_ARENA_PUSH_ARRAY(arena,uint32_t,p->object_count);
+        unit->defined_functions=BUSTER_ARENA_PUSH_ARRAY(arena,uint8_t,p->object_count);
+        unit->declaring=BUSTER_ARENA_PUSH_ARRAY(arena,uint32_t,(uint64_t)in->token_count+16);
+        if (!unit->object_symbols || !unit->object_declarations || !unit->defined_functions || !unit->declaring) abort();
+        memset(unit->object_symbols,0,(size_t)p->object_count*sizeof(*unit->object_symbols));
+        memset(unit->defined_functions,0,p->object_count);
+        for (uint32_t object=0;object<p->object_count;object+=1) unit->object_declarations[object]=object-1;
+        unit->declaring_count=check_program_declaring(in->declarations,&in->initializer_nodes,0,in->token_count,unit->declaring,false);
+        arena_pop_to(arena,(uint64_t)((uint8_t*)(unit->declaring+unit->declaring_count)-arena->base));
+        const uint32_t limit = in->token_count;
+        const uint32_t needs_unit = BUSTER_CHECK_PROGRAM_ATTRIBUTE_NAKED | BUSTER_CHECK_PROGRAM_ATTRIBUTE_TARGET |
+                                    BUSTER_CHECK_PROGRAM_ATTRIBUTE_INTERRUPT | BUSTER_CHECK_PROGRAM_ATTRIBUTE_REALIGN |
+                                    BUSTER_CHECK_PROGRAM_ATTRIBUTE_PATCHABLE | BUSTER_CHECK_PROGRAM_ATTRIBUTE_RETURNS_TWICE;
+        for (uint32_t first = check_sparse_wide_present(in->attributes) ? check_input_attributed_next(in->attributes, 0, limit) : limit; first < limit;
+             first = check_input_attributed_next(in->attributes, first + 16, limit))
+        {
+            uint32_t lanes = check_input_attributed_group(in->attributes, first, limit);
+            for (; lanes != 0; lanes &= lanes - 1)
+            {
+                const uint32_t token = first + (uint32_t)__builtin_ctz(lanes);
+                if (in->declaration_kinds[token] != C_BINDING_FUNCTION) continue;
+                const CheckInputAttributes* attributes = check_input_attributes_at(in, token);
+                bool special = (check_program_attribute_bits(attributes) & needs_unit) != 0;
+                for (uint32_t n = 0; !special && attributes != NULL && n < attributes->count; n += 1)
+                {
+                    const CheckInputAttribute* attribute = attributes->records + n;
+                    special = !attribute->ignored && !attribute->subject_ignored && attribute->kind == CHECK_ATTRIBUTE_CALLING_CONVENTION &&
+                              attribute->value == CHECK_CALL_NO_CALLER_SAVED;
+                }
+                const uint32_t object = in->objects[token];
+                if (special && object != 0 && object < p->object_count)
+                {
+                    if (unit->special_functions == NULL)
+                    {
+                        const uint64_t words = ((uint64_t)p->object_count + 63) / 64;
+                        unit->special_functions = BUSTER_ARENA_PUSH_ARRAY(arena, uint64_t, words);
+                        if (unit->special_functions == NULL) abort();
+                        memset(unit->special_functions, 0, words * sizeof(uint64_t));
+                    }
+                    unit->special_functions[object / 64] |= UINT64_C(1) << (object % 64);
+                }
+            }
+        }
+        for(uint32_t t=0;t<in->token_count;t+=1)
+        {
+            if(reader->parser->tree.roles[t]!=PARSE_ROLE_OPEN_BODY) continue;
+            const uint32_t decl=check_sparse_get(in->body_declarations,t);
+            if(decl<in->token_count && in->objects[decl]<p->object_count) unit->defined_functions[in->objects[decl]]=1;
+        }
+    }
+    // The unit-level program owns frame, target and redeclaration attributes that are absent from a local function.
+    // Include earlier declarations in the lookup so a definition or call cannot lose its inherited ABI.
+    if (unit->special_functions != NULL)
+    {
+        if ((unit->special_functions[own / 64] >> (own % 64)) & 1) return;
+        for (uint32_t r = 0; r < ref_count; r += 1)
+        {
+            const uint32_t object = refs[r];
+            if (object < p->object_count && ((unit->special_functions[object / 64] >> (object % 64)) & 1)) return;
+        }
+    }
+    if (unit->local_map==NULL)
+    {
+        unit->local_map=BUSTER_ARENA_PUSH_ARRAY(unit->native_metadata,uint32_t,p->object_count);
+        unit->type_cache=BUSTER_ARENA_PUSH_ARRAY(unit->native_metadata,CheckSourceTypeCache,1);
+        if (!unit->local_map || !unit->type_cache) abort();
+        memset(unit->local_map,0xff,(size_t)p->object_count*sizeof(*unit->local_map));
+        *unit->type_cache=(CheckSourceTypeCache){ .storage=&unit->native_types, .abi_storage=&unit->native_abi };
+    }
+    p->source_types=unit->type_cache;
