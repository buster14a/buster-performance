+static bool check_source_graph_room(CheckInputReader* reader, uint32_t begin, uint32_t end)
+{
+    const CheckGraph* graph = &reader->output->graph;
+    const uint32_t span = end - begin;
+    uint64_t nodes = (uint64_t)graph->count + span;
+    const uint64_t args = (uint64_t)graph->argument_count + span;
+    for (uint32_t i = begin; i < end; i += 1)
