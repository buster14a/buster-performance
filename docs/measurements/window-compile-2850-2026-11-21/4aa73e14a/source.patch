+// These six masks connect syntax and semantic producers to the local control consumer.
+// local_graph contains roots whose statement expressions or VLAs still need unit nodes.
+static uint64_t check_source_word_range(uint32_t word, uint32_t begin, uint32_t end)
+{
+    const uint32_t first = word << 6;
+    const uint32_t low = begin > first ? begin - first : 0;
+    const uint32_t high = end - first < 64 ? end - first : 64;
+    return _bzhi_u64(UINT64_MAX, high) & (UINT64_MAX << low);
+}
