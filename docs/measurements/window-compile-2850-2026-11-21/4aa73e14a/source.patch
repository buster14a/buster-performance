+static bool check_source_needs_global(const CheckSourceControlMasks* marks, uint32_t begin, uint32_t end, bool body)
+{
+    if (body && ((marks[begin >> 6].vla_bodies >> (begin & 63)) & 1)) return true;
+    for (uint32_t word = begin >> 6; (word << 6) < end; word += 1)
+    {
+        const CheckSourceControlMasks* m = marks + word;
+        const uint64_t used = m->local_graph | (body ? m->local_control | m->addresses : 0);
+        if (used & check_source_word_range(word, begin, end)) return true;
+    }
+    return false;
