diff --git a/src/buster/compiler/c_check_source_control_program.c b/src/buster/compiler/c_check_source_control_program.c
new file mode 100644
index 000000000..af6d8463c
--- /dev/null
+++ b/src/buster/compiler/c_check_source_control_program.c
@@ -0,0 +1,234 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+// Emit the ordinary control tape and per-body object dependencies before the source checker retires its graph.
+// The ordinary record uses the same function-local node numbering. Its references are independently sorted.
+static void check_source_control_record(const char* arm, uint32_t close, const CheckControl* entries, uint32_t count,
+                                        uint32_t first_node, const uint32_t* refs, uint32_t ref_count, const CheckProgram* program)
+{
+    fprintf(stderr, "source-control-%s\t%u\t%u\t%u", arm, close, count, ref_count);
+    for (uint32_t i = 0; i < count; i += 1)
+    {
+        const CheckControl entry = entries[i];
+        const uint32_t node = entry.node == BUSTER_CHECK_NONE || entry.kind == CHECK_CONTROL_LIFETIME ? entry.node : entry.node - first_node;
+        fprintf(stderr, "\t%u,%u,%u,%u", (uint32_t)entry.kind, entry.token, node,
+                entry.kind == CHECK_CONTROL_INITIALIZE ? program->initializers->declaration_tokens[entry.target] :
+                entry.kind == CHECK_CONTROL_CASE ? program->cases[entry.target].token : entry.target);
+    }
+    fprintf(stderr, "\trefs");
+    for (uint32_t i = 0; i < ref_count; i += 1) fprintf(stderr, ",%u", refs[i]);
+    fputc('\n', stderr);
+}
+
+// Fingerprint initializer parts and switch cases that a body's ordered control accesses after its graph is retired.
+static void check_source_control_details(const char* arm, const CheckProgram* p, uint32_t opening, uint32_t close,
+                                         uint32_t first_node, uint32_t case_first, uint32_t case_end)
+{
+    const CheckInitializers* inits = p->initializers;
+    const uint32_t n = inits == NULL ? 0 : inits->count;
+    uint32_t lo = 0, hi = n;
+    while (lo < hi)
+    {
+        const uint32_t mid = lo + (hi - lo) / 2;
+        if (inits->declaration_tokens[mid] < opening) lo = mid + 1;
+        else hi = mid;
+    }
+    for (uint32_t i = lo; i < n && inits->declaration_tokens[i] < close; i += 1)
+    {
+        const CheckInitializer* plan = inits->plans + i;
+        uint64_t h = UINT64_C(14695981039346656037);
+#define BUSTER_DETAIL(x) h = (h ^ (uint64_t)(x)) * UINT64_C(1099511628211)
+        BUSTER_DETAIL(check_body_type_fingerprint(p->types, plan->type)); BUSTER_DETAIL(plan->object_size);
+        BUSTER_DETAIL(plan->status); BUSTER_DETAIL(plan->warning_count); BUSTER_DETAIL(plan->warning_token);
+        BUSTER_DETAIL(plan->floating_values); BUSTER_DETAIL(plan->changed_integers); BUSTER_DETAIL(plan->enum_values); BUSTER_DETAIL(plan->label_differences);
+        for (uint32_t j = 0; j < plan->count; j += 1)
+        {
+            const CheckInitPart* part = plan->parts + j;
+            BUSTER_DETAIL(part->kind); BUSTER_DETAIL(check_body_type_fingerprint(p->types, part->type));
+            BUSTER_DETAIL(part->node == BUSTER_CHECK_NONE ? part->node : part->node - first_node);
+            BUSTER_DETAIL(part->token); BUSTER_DETAIL(part->overload_candidate); BUSTER_DETAIL(part->bit_offset);
+            BUSTER_DETAIL(part->bit_width); BUSTER_DETAIL(part->byte_count);
+            BUSTER_DETAIL(check_body_value_fingerprint(p->types, part->value, first_node));
+            BUSTER_DETAIL(check_body_type_fingerprint(p->types, part->conversion.type)); BUSTER_DETAIL(part->conversion.flags);
+            if (part->kind == CHECK_INIT_BYTES)
+                for (uint64_t k = 0; k < part->byte_count; k += 1) { BUSTER_DETAIL(part->bytes[k]); }
+        }
+        fprintf(stderr, "source-plan-%s\t%u\t%u\t%u\t%016llx\n", arm, close, inits->declaration_tokens[i], plan->count, (unsigned long long)h);
+    }
+    for (uint32_t i = case_first; i < case_end; i += 1)
+    {
+        const CheckProgramCase* item = p->cases + i;
+        uint64_t h = UINT64_C(14695981039346656037);
+        BUSTER_DETAIL(check_body_type_fingerprint(p->types, item->type)); BUSTER_DETAIL(item->owner); BUSTER_DETAIL(item->target);
+        BUSTER_DETAIL(item->fallback); BUSTER_DETAIL(item->range);
+        BUSTER_DETAIL(item->lower); BUSTER_DETAIL(item->lower >> 64); BUSTER_DETAIL(item->upper); BUSTER_DETAIL(item->upper >> 64);
+        if (item->wide_lower != NULL || item->wide_upper != NULL)
+        {
+            uint32_t width = 0; bool sign = false;
+            if (!check_wide_type(p->types, item->type, &width, &sign)) exit(2);
+            for (uint32_t limb = 0; limb < check_wide_count(width); limb += 1)
+            {
+                BUSTER_DETAIL(item->wide_lower == NULL ? 0 : item->wide_lower[limb]);
+                BUSTER_DETAIL(item->wide_upper == NULL ? 0 : item->wide_upper[limb]);
+            }
+        }
+        fprintf(stderr, "source-case-%s\t%u\t%u\t%016llx\n", arm, close, item->token, (unsigned long long)h);
+    }
+#undef BUSTER_DETAIL
+}
+
+static void check_source_control_oracle(const CheckProgram* p, const Parser* parser)
+{
+    uint32_t body = 0, node = 0, case_at = 0;
+    for (uint32_t t = 0; t < parser->tokens.count; t += 1)
+    {
+        if (parser->tree.parents[t] < parser->tokens.count) continue;
+        const uint32_t first = node;
+        while (node < p->input->graph.count && p->input->graph.tokens[node] <= t) node += 1;
+        if (body < p->body_count && parser->tree.parents[p->bodies[body].opening] == t)
+        {
+            const CheckProgramBody* b = p->bodies + body++;
+            const uint32_t first_case = case_at;
+            while (case_at < p->case_count && p->cases[case_at].token <= t) case_at += 1;
+            check_source_control_details("whole", p, b->opening, t, first, first_case, case_at);
+            check_source_control_record("whole", t, p->controls + b->first, b->count, first,
+                                        b->reference_count == 0 ? NULL : p->references + b->reference_first, b->reference_count, p);
+        }
+    }
+}
+
+static bool check_source_control_labels(CheckSourceControlUnit* unit, const CheckInput* input, Arena* output)
+{
+    CheckProgram p = { .input = input };
+    if (!check_program_labelled_objects(&p, output)) return false;
+    unit->object_labelled = p.object_labelled;
+    return true;
+}
+
+static void check_source_control_function(CheckSourceControlUnit* unit, CheckInputReader* reader,
+                                          CheckStream* stream, uint32_t close, Arena* output, Arena* scratch)
+{
+    const Parser* parser = reader->parser;
+    const CheckInput* input = reader->output;
+    uint32_t opening = BUSTER_CHECK_NONE;
+    for (uint32_t t = reader->first_child[close]; t != BUSTER_CHECK_NONE; t = reader->next_child[t])
+        if (parser->tree.roles[t] == PARSE_ROLE_OPEN_BODY) opening = t;
+    if (opening >= close) { fprintf(stderr,"source-refusal\t%u\t%u\t%u\t%u\n", close, input->graph.count, (unsigned)__LINE__, stream->report_count); return; }
+    uint32_t case_count = 0;
+    for (uint32_t t = opening + 1; t < close; t += 1)
+    {
+        const uint8_t role = parser->tree.roles[t], kind = parser->tokens.kinds[t];
+        case_count += role == PARSE_ROLE_CLOSE_CASE;
+        if (kind == PARSE_KIND_AMPAMP && role == PARSE_ROLE_PREFIX) { fprintf(stderr,"source-refusal\t%u\t%u\t%u\t%u\n", close, input->graph.count, (unsigned)__LINE__, stream->report_count); return; }
+    }
+    for (uint32_t i = 0; i < input->asm_count; i += 1)
+        if (input->asm_statements[i].statement - opening < close - opening) { fprintf(stderr,"source-refusal\t%u\t%u\t%u\t%u\n", close, input->graph.count, (unsigned)__LINE__, stream->report_count); return; }
+    for (uint32_t i = 0; i < input->region_count; i += 1)
+        if (input->regions[i].opening - opening < close - opening) { fprintf(stderr,"source-refusal\t%u\t%u\t%u\t%u\n", close, input->graph.count, (unsigned)__LINE__, stream->report_count); return; }
+    for (uint32_t i = 0; i < input->vla_count; i += 1)
+        if (input->vlas[i].declaration - opening < close - opening) { fprintf(stderr,"source-refusal\t%u\t%u\t%u\t%u\n", close, input->graph.count, (unsigned)__LINE__, stream->report_count); return; }
+    for (uint32_t i = 0; i < input->cleanup_count; i += 1)
+        if (input->cleanups[i].declaration - opening < close - opening) { fprintf(stderr,"source-refusal\t%u\t%u\t%u\t%u\n", close, input->graph.count, (unsigned)__LINE__, stream->report_count); return; }
+    const CheckGraph* graph = &input->graph;
+    if (graph->overload_count != 0 || stream->overload_address_count != 0) { fprintf(stderr,"source-refusal\t%u\t%u\t%u\t%u\n", close, input->graph.count, (unsigned)__LINE__, stream->report_count); return; }
+    for (uint32_t i = 0; i < graph->count; i += 1)
+        if (graph->ops[i] == CHECK_OP_STATEMENT_VALUE ||
+            (graph->ops[i] == CHECK_OP_BUILTIN_MISC && (graph->members[i] == CBUILTIN_CFSTRING_MAKE_CONSTANT_STRING ||
+                                                        graph->members[i] == CBUILTIN_NSSTRING_MAKE_CONSTANT_STRING))) { fprintf(stderr,"source-refusal\t%u\t%u\t%u\t%u\n", close, input->graph.count, (unsigned)__LINE__, stream->report_count); return; }
+    CheckInitializers plans = { .token_count = input->token_count };
+    for (uint32_t token = check_sparse_next(input->initializer_begins, opening, close); token < close;
+         token = check_sparse_next(input->initializer_begins, token + 1, close)) plans.count += 1;
+    uint32_t* plan_next = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, plans.count + 1);
+    plans.plans = BUSTER_ARENA_PUSH_ARRAY(output, CheckInitializer, plans.count + 1);
+    plans.declaration_tokens = BUSTER_ARENA_PUSH_ARRAY(output, uint32_t, plans.count + 1);
+    if (!plan_next || !plans.plans || !plans.declaration_tokens) exit(2);
+    uint32_t at = 0;
+    for (uint32_t token = check_sparse_next(input->initializer_begins, opening, close); token < close;
+         token = check_sparse_next(input->initializer_begins, token + 1, close))
+    {
+        const uint32_t begin = check_sparse_get(input->initializer_begins, token);
+        const uint32_t end = check_sparse_get(input->initializer_ends, token);
+        if (end > close || begin >= end || check_init_object_candidate(input, reader->types, token)) { fprintf(stderr,"source-refusal\t%u\t%u\t%u\t%u\n", close, input->graph.count, (unsigned)__LINE__, stream->report_count); return; }
+        if (!check_initializer_plan_warnings(reader->types, parser, input->token_nodes, stream, input->strings,
+                input->string_count, input->string_ids, input->declared_types[token], begin, end,
+                check_input_bit(input->declaration_bits, token, BUSTER_CHECK_BITS_STATIC), false, true,
+                output, scratch, plans.plans + at, graph, NULL, NULL, NULL, NULL)) { fprintf(stderr,"source-refusal\t%u\t%u\t%u\t%u\n", close, input->graph.count, (unsigned)__LINE__, stream->report_count); return; }
+        plans.declaration_tokens[at++] = token;
+    }
+    const uint32_t names = input->token_count + 1;
+    const uint32_t slots = graph->count + 1;
+    const uint32_t capacity = (close - opening + 1) * 8 + 16;
+    CheckProgram p = { .input = input, .stream = stream, .parser = parser, .types = reader->types,
+                       .object_count = names, .object_labelled = unit->object_labelled, .initializers = &plans, .identifiers = reader->pp->table };
+    check_program_plans(&p, parser, &plans, unit->plan_first, unit->planned, plan_next, unit->parent_cache);
+    if (p.status != CHECK_PROGRAM_OK) { fprintf(stderr,"source-refusal\t%u\t%u\t%u\t%u\n", close, input->graph.count, (unsigned)__LINE__, stream->report_count); return; }
+    CheckControlWriter writer = { .program = &p, .parser = parser, .first = unit->first, .last = unit->last,
+                                   .next = unit->next, .previous = unit->previous, .token_first = unit->token_head,
+                                   .planned = unit->planned, .plan_first = unit->plan_first, .plan_next = plan_next, .capacity = capacity, .fold_capacity = slots,
+                                   .switch_scratch = scratch, .region_final = BUSTER_CHECK_NONE };
+    writer.case_first = unit->case_first;
+    writer.case_map = unit->case_map;
+    writer.source_labels = unit->source_labels;
+    writer.label_positions = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, capacity);
+    uint32_t* case_next = BUSTER_ARENA_PUSH_ARRAY(scratch, uint32_t, case_count + 1);
+    p.cases = BUSTER_ARENA_PUSH_ARRAY(scratch, CheckProgramCase, case_count + 1);
+    writer.case_next = case_next;
