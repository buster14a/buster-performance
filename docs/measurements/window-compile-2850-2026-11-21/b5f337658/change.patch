+            {
+                BUSTER_DETAIL(item->wide_lower == NULL ? 0 : item->wide_lower[limb]);
+                BUSTER_DETAIL(item->wide_upper == NULL ? 0 : item->wide_upper[limb]);
+            }
+        }
+        fprintf(stderr, "source-case-%s\t%u\t%u\t%016llx\n", arm, close, item->token, (unsigned long long)h);
+    }
+#undef BUSTER_DETAIL
