+static bool check_input_window_member(CheckInputReader* reader, CheckInputBatch* batch, uint32_t token, uint32_t base)
+{
+    const Parser* parser = reader->parser;
+    CheckInput* input = reader->output;
+    const uint32_t parent = parser->tree.parents[token];
+    const uint32_t position = check_input_batch_place(batch, base);
+    if (position == BUSTER_CHECK_NONE || position + 1 != batch->count || batch->forms[position] != CHECK_INPUT_FORM_LEAF ||
+        batch->members[position] != 0 || token == 0 || batch->tokens[position] != token - 1 || parent >= input->token_count ||
+        parser->tokens.kinds[token - 1] != PARSE_KIND_IDENTIFIER || parser->tree.parents[token - 1] != token ||
+        input->diagnostic_limits != NULL || input->deferred_tokens != NULL || reader->pp->options.expression_timing || reader->pp->options.node_front != 0 ||
+        !reader->pp->options.published_unused_only || (reader->constant_contexts != NULL && reader->constant_contexts[token] != 0) ||
+        reader->lane || reader->expression_declined != NULL || input->graph.fp_environments != NULL ||
+        input->overload_heads != NULL || input->noderef_member_count != 0 || input->noderef_declaration_count != 0 ||
+        reader->pp->options.predefines.debug || reader->pp->options.predefines.debug_modules ||
+        input->musttail_count != 0 || reader->expression_limit < input->token_count || parser->errors != 0)
+    {
+        return false;
+    }
+    const uint32_t role = parser->tree.roles[parent];
+    const bool expression = (role >= PARSE_ROLE_PREFIX && role <= PARSE_ROLE_ASSIGN) || role == PARSE_ROLE_COMMA ||
+                            role == PARSE_ROLE_RETURN || role == PARSE_ROLE_OPEN_CALL || role == PARSE_ROLE_OPEN_SUBSCRIPT ||
+                            role == PARSE_ROLE_OPEN_GROUP || role == PARSE_ROLE_OPEN_CONDITION || role == PARSE_ROLE_SEPARATOR;
+    if (!expression)
+    {
+        return false;
+    }
+    const uint32_t leaf = batch->leaf_slots[position];
+    const CheckGraphLeaf* pointer = input->graph.leaf_records + leaf;
+    const uint32_t declared = input->declarations[token - 1];
+    if (pointer->object == 0 || declared >= input->token_count || pointer->object != declared + 1 ||
+        pointer->category != CHECK_LVALUE || pointer->constant_kind != CHECK_CONSTANT_ADDRESS ||
+        pointer->flags != BUSTER_CHECK_NONNULL_ADDRESS || pointer->row != 0 || pointer->integer != 0 || pointer->overload_head != 0 ||
+        !type_is_valid(reader->types, pointer->type) || type_kind(reader->types, pointer->type) != BUSTER_TYPE_KIND_POINTER || type_qualifiers(pointer->type) != 0 ||
+        input->declaration_kinds[declared] != C_BINDING_OBJECT || check_sparse_get(input->declaration_bodies, declared) >= input->token_count ||
+        check_input_bit(input->declaration_bits, declared, BUSTER_CHECK_BITS_THREAD_LOCAL) || check_input_attributes_at(input, declared) != NULL)
+    {
+        return false;
+    }
+    const TypeTable* types = reader->types;
+    const TypeId record = type_element(types, pointer->type);
+    const uint8_t kind = type_kind(types, record);
+    if ((kind != BUSTER_TYPE_KIND_STRUCT && kind != BUSTER_TYPE_KIND_UNION) || type_qualifiers(record) != 0 ||
+        !type_is_complete(types, record) || reader->tag_completions[types->types.index[type_index(record)]] > token)
+    {
+        return false;
+    }
+    uint64_t bits = 0;
+    uint32_t qualifiers = 0;
+    const uint32_t name = parser->tokens.names[token + 1];
+    const uint32_t member = type_lookup_member(types, record, name, &bits, &qualifiers);
+    const uint32_t tag = types->types.index[type_index(record)];
+    if (member == 0 || member == BUSTER_TYPE_MEMBER_UNKNOWN || member - types->tags.member_begin[tag] >= types->tags.member_count[tag] ||
+        types->members.name[member] != name || types->members.flags[member] != 0 ||
+        qualifiers != 0 || (bits & 7) != 0 || check_marked_member(input->marked_members, input->marked_member_count, member) != NULL)
+    {
+        return false;
+    }
+    const TypeId field = types->members.type[member];
+    const uint8_t field_kind = type_kind(types, field);
+    if (type_qualifiers(field) != 0 || ((field < BUSTER_TYPE_BOOL || field > BUSTER_TYPE_ULLONG) && field_kind != BUSTER_TYPE_KIND_POINTER) ||
+        !check_input_window_member_context(reader, parent))
+    {
+        return false;
+    }
+    CheckInputWindowSummary* summaries = check_input_window_room(reader->arena, input->window_summaries, input->window_count,
+                                                                 &input->window_capacity, 1, sizeof(*summaries));
+    if (summaries == NULL)
+    {
+        return false;
+    }
+    input->window_summaries = summaries;
+    CheckInputWindowRow* tape = check_input_window_room(reader->arena, input->window_rows, input->window_row_count,
+                                                        &input->window_row_capacity, 1, sizeof(*tape));
+    if (tape == NULL)
+    {
+        return false;
+    }
+    input->window_rows = tape;
+    check_node_window_member_pointer(tape + input->window_row_count, pointer->object, token - 1);
+    summaries[input->window_count] = (CheckInputWindowSummary){ .node = base, .first = input->window_row_count, .count = 1, .member = member };
+    input->window_row_count += 1;
+    input->window_count += 1;
+    input->window_nodes += 2;
+    batch->members[position] = input->window_count;
+    batch->tokens[position] = token;
+    const CheckValue value = { .type = field, .category = CHECK_LVALUE, .flags = BUSTER_CHECK_NONNULL_ADDRESS };
+    check_input_batch_set_leaf(reader, batch, base, &value);
+    return true;
+}
