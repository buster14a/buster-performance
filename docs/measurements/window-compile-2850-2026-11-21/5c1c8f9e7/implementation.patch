diff --git a/src/buster/compiler/c_check_source_arithmetic.c b/src/buster/compiler/c_check_source_arithmetic.c
new file mode 100644
index 000000000..789983d6a
--- /dev/null
+++ b/src/buster/compiler/c_check_source_arithmetic.c
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 David Gonzalez Martin. See LICENSE and LICENSING.md.
+
+// A source leaf or unknown result that carries no inherited flag or fault. Four low bits identify a builtin
+// integer. The operand's value category and constant status distinguish a read and a possible integer fold.
+#define BUSTER_SOURCE_INT_CODE 15u
+#define BUSTER_SOURCE_INT_LVALUE 16u
+#define BUSTER_SOURCE_INT_LITERAL 32u
+#define BUSTER_SOURCE_INT_NEEDED 64u
+#define BUSTER_SOURCE_INT_CHECKED 128u
+
+typedef struct CheckSourceIntegerProof
+{
+    uint32_t node;
+    uint32_t a;
+    uint32_t b;
+    uint8_t op;
+    uint8_t left;
+    uint8_t right;
+    uint8_t result;
+    uint8_t lt;
+    uint8_t rt;
+    uint8_t lf;
+    uint8_t rf;
+} CheckSourceIntegerProof;
+
+struct CheckSourceArithmetic
+{
+    uint8_t* words;
+    CheckSourceIntegerProof* proofs;
+    uint32_t limit;
+    uint32_t count;
+    uint32_t next;
+    uint32_t taken;
+    uint32_t chains;
+    uint32_t candidates;
+    uint32_t source_leaves;
+    bool audit;
+    bool consumed;
+};
+
+static uint8_t check_source_integer_word(TypeId type, uint32_t flags, uint32_t category, uint32_t constant, bool fault)
+{
+    uint8_t result = 0;
+    if (type >= BUSTER_TYPE_BOOL && type <= BUSTER_TYPE_UINT128 && type_qualifiers(type) == 0 && !fault)
+    {
+        if (category == CHECK_RVALUE && constant == CHECK_CONSTANT_INTEGER && (flags & ~(BUSTER_CHECK_ICE | BUSTER_CHECK_LITERAL_ZERO)) == 0)
+            result = (uint8_t)type_index(type) | BUSTER_SOURCE_INT_LITERAL;
+        else if (category == CHECK_RVALUE && constant == CHECK_CONSTANT_NONE && flags == 0)
+            result = (uint8_t)type_index(type);
+        else if (category == CHECK_LVALUE && (constant == CHECK_CONSTANT_ADDRESS || constant == CHECK_CONSTANT_NONE) &&
+                 (flags & ~(BUSTER_CHECK_NONNULL_ADDRESS | BUSTER_CHECK_REGISTER | BUSTER_CHECK_REGISTER_NAME | BUSTER_CHECK_STATIC_OBJECT)) == 0)
+            result = (uint8_t)type_index(type) | BUSTER_SOURCE_INT_LVALUE;
+    }
+    return result;
+}
+
+// Run before the pending expression is stored in its wide graph columns. It consumes source leaf words and
+// earlier results from this very producer, publishing the output type and final conversions for both operands.
+static __attribute__((noinline)) void check_source_integer_append(CheckSourceArithmetic* source, uint32_t node, CheckOp op, uint32_t a, uint32_t b)
+{
+    while (source->count != 0 && source->proofs[source->count-1].node >= node) source->count -= 1;
+    const bool unary = op <= CHECK_OP_BIT_NOT || op == CHECK_OP_CONDITION;
+    b = unary ? a : b;
+    if (a >= node || b >= node || source->count == source->limit) return;
+    source->candidates += 1;
+    const uint8_t left = source->words[a] & 63u;
+    const uint8_t right = source->words[b] & 63u;
+    const bool ak = (left & BUSTER_SOURCE_INT_LITERAL) != 0;
+    const bool bk = (right & BUSTER_SOURCE_INT_LITERAL) != 0;
+    const bool logical = op == CHECK_OP_NOT || op == CHECK_OP_CONDITION || op == CHECK_OP_LOGICAL_AND || op == CHECK_OP_LOGICAL_OR;
+    if (left == 0 || right == 0 || (ak && bk) || (logical && (ak || bk)) || (bk && op >= CHECK_OP_DIVIDE && op <= CHECK_OP_SHIFT_RIGHT)) return;
+
+    uint8_t lt = left & BUSTER_SOURCE_INT_CODE, rt = right & BUSTER_SOURCE_INT_CODE;
+    uint8_t lf = (left & BUSTER_SOURCE_INT_LVALUE) != 0 ? BUSTER_CHECK_CONVERT_LVALUE : 0;
+    uint8_t rf = (right & BUSTER_SOURCE_INT_LVALUE) != 0 ? BUSTER_CHECK_CONVERT_LVALUE : 0;
+    if (!logical)
+    {
+        const uint8_t lp = type_promotion_codes[lt], rp = type_promotion_codes[rt];
+        lf |= lp != lt ? BUSTER_CHECK_CONVERT_PROMOTION : 0;
+        rf |= rp != rt ? BUSTER_CHECK_CONVERT_PROMOTION : 0;
+        lt = lp;
+        rt = rp;
+        if (!unary && op != CHECK_OP_SHIFT_LEFT && op != CHECK_OP_SHIFT_RIGHT)
+        {
+            const uint8_t common = type_integer_codes[((lt & 7u) << 3) | (rt & 7u)];
+            lf |= lt != common ? BUSTER_CHECK_CONVERT_ARITHMETIC : 0;
+            rf |= rt != common ? BUSTER_CHECK_CONVERT_ARITHMETIC : 0;
+            lt = common;
+            rt = common;
+        }
+    }
+    const uint8_t result = logical || (op >= CHECK_OP_LESS && op <= CHECK_OP_NOT_EQUAL) ? BUSTER_TYPE_CODE_INT : lt;
+    source->proofs[source->count++] = (CheckSourceIntegerProof){ .node=node,.a=a,.b=b,.op=(uint8_t)op,.left=left,.right=right,.result=result,
+        .lt=lt,.rt=unary ? 0 : rt,.lf=lf,.rf=unary ? 0 : rf };
+    if (source->audit && ((source->words[a] | source->words[b]) & BUSTER_SOURCE_INT_CHECKED)) source->chains += 1;
+    source->words[a] |= BUSTER_SOURCE_INT_NEEDED;
+    source->words[b] |= BUSTER_SOURCE_INT_NEEDED;
+    // The high bit distinguishes the producer's own derived value until the checker begins consuming the source tape.
+    source->words[node] = result | BUSTER_SOURCE_INT_CHECKED;
+}
+
+static void check_source_integer_leaf(CheckSourceArithmetic* source, const CheckStream* stream, uint32_t node)
+{
+    const uint32_t row = stream->payload_rows[node];
+    source->words[node] = BUSTER_SOURCE_INT_CHECKED | check_source_integer_word(stream->value_types[node],stream->value_flags[node],
+        stream->value_categories[node],stream->value_constants[node],row != 0 && stream->payloads[row-1].fault != CHECK_FAULT_NONE);
+}
+
+// A selected source row is consumed after its actual dependencies. Changes to an edge, operator, constant
+// context, FP access or either operand's checked shape leave the node to its normal scalar action.
+static __attribute__((noinline)) bool check_source_integer_take(CheckSourceArithmetic* source, const CheckGraph* graph, CheckStream* stream, uint32_t node)
+{
+    const CheckSourceIntegerProof* p = source->proofs + source->next++;
+    const uint32_t a = p->a, b = p->b;
+    const bool unary = p->op <= CHECK_OP_BIT_NOT || p->op == CHECK_OP_CONDITION;
+    bool taken = graph->ops[node] == p->op && graph->operand0[node] == a && (unary || graph->operand1[node] == b) &&
+                 source->words[a] == (BUSTER_SOURCE_INT_CHECKED | p->left) && source->words[b] == (BUSTER_SOURCE_INT_CHECKED | p->right) &&
+                 (stream->constant_evaluated == NULL || stream->constant_evaluated[node] == 0) &&
+                 ((graph->fp_environments != NULL ? graph->fp_environments[node] : graph->fp_contract_default) & BUSTER_CHECK_FP_ENV_ACCESS) == 0;
+    if (taken)
+    {
+        stream->value_types[node] = BUSTER_TYPE_BUILTIN(p->result);
+        stream->value_flags[node] = 0;
+        stream->value_objects[node] = 0;
+        stream->value_categories[node] = CHECK_RVALUE;
+        stream->value_constants[node] = CHECK_CONSTANT_NONE;
+        stream->diagnostics[node] = CHECK_DIAG_NONE;
+        stream->warnings[node] = 0;
+        stream->member_offsets[node] = 0;
+        stream->conversions[node] = (CheckNodeConversions){.operands={{.type=BUSTER_TYPE_BUILTIN(p->lt),.flags=p->lf},{.type=BUSTER_TYPE_BUILTIN(p->rt),.flags=p->rf}}};
+        stream->statistics.scalar_nodes += 1;
+        source->words[node] = BUSTER_SOURCE_INT_CHECKED | p->result;
+        source->taken += 1;
+    }
+    else source->words[node] = 0;
+    return taken;
+}
