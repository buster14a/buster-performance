+    state->arguments += (uint32_t)_mm512_reduce_add_epi32(arguments);
+    state->maximum_effects += (uint32_t)__builtin_popcount(_mm512_mask_cmpeq_epi32_mask(lanes, ops, _mm512_set1_epi32(CHECK_OP_BUILTIN_OVERFLOW)));
