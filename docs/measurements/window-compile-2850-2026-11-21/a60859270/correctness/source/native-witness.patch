+// The ordinary object driver compiles some parts before the next part is lowered. Record the exact
+// native columns where they are handed to code generation, before those arenas are recycled.
+static void check_source_witness_body(CheckProgramLowered* lowered, uint32_t b, uint32_t declaration,
+                                      const Tier0Function* f, const uint32_t* tokens)
+{
+    FILE* witness = open_memstream(lowered->witness_rows + b, lowered->witness_sizes + b);
+    if (witness == NULL) abort();
+    const bool sources = tokens != NULL;
+    const uint32_t counts[] = {declaration, f->count, f->local_count, f->call_count,
+                               f->argument_count, sources};
+    fwrite(counts, sizeof(counts), 1, witness);
+#define BUSTER_SOURCE_WITNESS(column, length) do { \
+    if ((length) != 0) fwrite((column), sizeof(*(column)), (length), witness); \
+} while (0)
+    BUSTER_SOURCE_WITNESS(f->kinds, f->count);
+    BUSTER_SOURCE_WITNESS(f->classes, f->count);
+    BUSTER_SOURCE_WITNESS(f->values, f->count);
+    if (sources) BUSTER_SOURCE_WITNESS(tokens, f->count);
+    BUSTER_SOURCE_WITNESS(f->local_classes, f->local_count);
+    BUSTER_SOURCE_WITNESS(f->local_flags, f->local_count);
+    BUSTER_SOURCE_WITNESS(f->call_targets, f->call_count);
+    BUSTER_SOURCE_WITNESS(f->call_first, f->call_count);
+    BUSTER_SOURCE_WITNESS(f->call_argument_counts, f->call_count);
+    BUSTER_SOURCE_WITNESS(f->call_variadic, f->call_count);
+    BUSTER_SOURCE_WITNESS(f->argument_classes, f->argument_count);
+#undef BUSTER_SOURCE_WITNESS
+    if (ferror(witness) || fclose(witness) != 0) abort();
+}
