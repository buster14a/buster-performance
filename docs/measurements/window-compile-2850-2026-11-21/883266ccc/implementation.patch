 // declarator, not at its name: a bound in `typedef int T[sizeof(T)]` still sees the outer T. A block declaration's
 // interval ends at its enclosing brace. Other scopes, or specifiers this pass cannot read, leave the unit to the
 // scalar parser. The bracket matching uses K4's not-yet-live waiting array and never walks nested scopes per token.
+// A block carries only its sixteen external openers. K1 already computes the
+// local opener lane and relative depth. Deep blocks keep their scalar edges.
+BUSTER_INLINE uint32_t parse_enclosing(const ParseKernels* kernels, uint32_t token)
+{
+    if (kernels->block_enclosing)
+    {
+        const ParseBracketBlock* block = kernels->bracket_blocks + token / 64;
+        if (!block->dense_enclosing)
+        {
+            const uint32_t lane = token % 64;
+            const uint32_t opener = block->opener_lanes[lane];
+            return opener < 64 ? (token & ~63u) + opener : block->preceding[(uint32_t)(15 + block->relative_depths[lane]) & 15u];
+        }
+    }
+    return kernels->enclosing[token];
+}
