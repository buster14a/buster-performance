+            check_program_bit_set(writer->region_known, at);
+        }
+        parent = at;
+        answered = true;
+        at = next;
+    }
+    if (writer->region_work != NULL)
+    {
+        *writer->region_work += steps;
+    }
+    *stop = stop_label;
+    *repeat = repeat_label;
+}
