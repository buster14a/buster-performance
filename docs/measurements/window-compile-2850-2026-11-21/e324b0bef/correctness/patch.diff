diff --git a/src/buster/compiler/c_check_tier1_driver_test.c b/src/buster/compiler/c_check_tier1_driver_test.c
index 4868874df..5ba9b8b3b 100644
--- a/src/buster/compiler/c_check_tier1_driver_test.c
