+static void type_deferred_counted_pointer(TypeTestTally* tally)
+{
+    TypeTestTable source = { 0 };
+    TypeTestTable copy = { 0 };
+    if (type_test_expect(tally, type_test_table_open(&source, 64), "counted pointer", "the table couldn't be made"))
+    {
+        TypeTable* table = &source.table;
+        const TypeId pointer = type_pointer(table, BUSTER_TYPE_INT);
+        TypeMember pair[] = { type_test_member(1, BUSTER_TYPE_INT, BUSTER_TYPE_NOT_BIT_FIELD), type_test_member(2, pointer, BUSTER_TYPE_NOT_BIT_FIELD) };
+        pair[0].count_kind = BUSTER_TYPE_COUNTED_BY;
+        pair[1].count_kind = BUSTER_TYPE_SIZED_BY;
+        const TypeRecordAttributes attributes = { 0 };
+        const TypeId other = type_tag(table, BUSTER_TYPE_KIND_STRUCT, 11);
+        type_test_expect(tally, type_record_define(table, other, pair, 2, attributes) && table->members.first_counted_pointer == 0,
+                         "counted pointer", "a nonpointer or sized_by member enabled the use walk");
+
+        const TypeViewMark before = type_view_mark(table);
+        pair[0].count_kind = BUSTER_TYPE_COUNT_NONE;
+        pair[1].count_kind = BUSTER_TYPE_COUNTED_BY;
+        const TypeId counted = type_tag(table, BUSTER_TYPE_KIND_STRUCT, 12);
+        const uint32_t first = table->members.count + 1;
+        type_test_expect(tally, type_record_define(table, counted, pair, 2, attributes) && table->members.first_counted_pointer == first,
+                         "counted pointer", "the first counted pointer was not recorded");
+        const TypeViewMark after = type_view_mark(table);
+        pair[1].count_kind = BUSTER_TYPE_COUNTED_BY_OR_NULL;
+        const TypeId optional = type_tag(table, BUSTER_TYPE_KIND_STRUCT, 13);
+        type_test_expect(tally, type_record_define(table, optional, pair, 2, attributes) && type_view_reset(table, after) &&
+                         table->members.first_counted_pointer == first, "counted pointer", "reset discarded a surviving counted pointer");
+
+        copy.arena = arena_reserve(UINT64_C(1) << 24);
+        copy.index_arena = arena_reserve(UINT64_C(1) << 24);
+        type_test_expect(tally, type_copy(&copy.table, table, &copy.arena, &copy.index_arena, (TypeCapacity){ 0 }) &&
+                         copy.table.members.first_counted_pointer == first, "counted pointer", "a lane copy lost its counted pointer");
+        type_test_expect(tally, type_view_reset(table, before) && table->members.first_counted_pointer == 0,
+                         "counted pointer", "a discarded declaration left its counted pointer behind");
+        const TypeId restored = type_tag(table, BUSTER_TYPE_KIND_STRUCT, 14);
+        type_test_expect(tally, type_record_define(table, restored, pair, 2, attributes) && table->members.first_counted_pointer == first,
+                         "counted pointer", "a counted_by_or_null pointer was not recorded after reset");
+        type_test_table_close(&copy);
+        type_test_table_close(&source);
+    }
+}
