index 000000000..c8fd84724
--- /dev/null
+++ b/tests/checker/node-window-call-decay.c
@@ -0,0 +1,8 @@
+extern int narrow(int);
+extern long wide(long);
+
+long result(int value)
+{
+    narrow(value);
+    return wide((long)value) + 1;
+}
