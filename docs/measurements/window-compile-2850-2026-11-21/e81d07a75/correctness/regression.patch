@@ -6246,8 +6246,48 @@ static void node_window_test_compile(CheckTest* test, bool assignments)
     lower_source_close(&plain);
 }
 
+// The compactable narrow call first materializes a function pointer. The later wide call remains in the graph.
+static TypeId node_window_test_long_callee(const CheckCorpusPath* path)
+{
+    const CheckGraph* graph = &path->input.graph;
+    for (uint32_t node = 0; node < graph->count; node += 1)
+    {
+        if (graph->ops[node] == CHECK_OP_CALL && check_stream_value(&path->stream, node).type == BUSTER_TYPE_LONG)
+        {
+            return path->stream.conversions[node].operands[0].type;
+        }
+    }
+    return 0;
+}
+
+static void node_window_test_call_decay(CheckTest* test)
+{
+    char file[PATH_MAX];
+    snprintf(file, sizeof(file), "%s/checker/node-window-call-decay.c", check_test_fixture_root);
+    char* options[] = { "-nostdinc" };
+    static LowerSource plain;
+    static LowerSource window;
+    const bool opened_plain = lower_source_open(&plain, file, options, BUSTER_ARRAY_LENGTH(options), 0);
+    const bool opened_window = lower_source_open(&window, file, options, BUSTER_ARRAY_LENGTH(options), BUSTER_LOWER_SOURCE_WINDOW_CALLS);
+    const bool prepared = opened_plain && opened_window && plain.prepared && window.prepared;
+    check_test_expect(test, prepared, "node-window prepares both function-decay ordering paths");
+    if (prepared)
+    {
+        const TypeId reference = node_window_test_long_callee(&plain.path);
+        check_test_expect(test, plain.path.input.window_count == 0 && window.path.input.window_count == 1 && window.path.input.window_nodes == 4,
+                          "node-window retains exactly the first simple call from the decay ordering fixture");
+        check_test_expect(test, reference != 0 && node_window_test_long_callee(&window.path) == reference,
+                          "the later ordinary call retains its original callee conversion type");
+        check_test_expect(test, plain.path.types.types.count == window.path.types.types.count,
+                          "the first compacted call preserves the complete canonical type slot count");
+    }
+    lower_source_close(&window);
+    lower_source_close(&plain);
+}
+
 static __attribute__((noinline)) void check_test_node_census(CheckTest* test)
 {
+    node_window_test_call_decay(test);
     node_window_test_compile(test, false);
     node_window_test_compile(test, true);
     char directory[] = "/tmp/buster-node-census-XXXXXX";
diff --git a/tests/checker/node-window-call-decay.c b/tests/checker/node-window-call-decay.c
