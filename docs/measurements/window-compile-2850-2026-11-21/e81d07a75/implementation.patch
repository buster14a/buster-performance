+        if (!check_input_window_call_type(types,formal[a],false)) return false;
+        if (local ? !check_input_window_typed_local(reader, identifiers,identifier,formal[a]) : formal[a]!=BUSTER_TYPE_INT || literals->values[literal]==BUSTER_CHECK_NONE) return false;
