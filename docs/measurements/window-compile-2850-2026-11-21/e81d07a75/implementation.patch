+static bool check_input_window_call_attributes(CheckInputReader* reader, uint32_t declaration, uint32_t object, uint32_t call_token)
+{
+    const CheckInput* input = reader->output;
+    if (declaration >= input->token_count || (input->function_flags[declaration] & (CHECK_INPUT_FUNCTION_INLINE | CHECK_INPUT_FUNCTION_NORETURN)) != 0)
+    {
+        return true;
+    }
+    const CheckSparseWide attributes = input->attributes;
+    if (!check_sparse_wide_present(attributes))
+    {
+        return false;
+    }
+    if (object > input->token_count)
+    {
+        return true;
+    }
+    if (reader->window_attributed_objects == NULL)
+    {
+        const uint32_t words = (input->token_count >> 6) + 1;
+        uint64_t* bits = BUSTER_ARENA_PUSH_ARRAY(reader->scratch, uint64_t, words);
+        if (bits == NULL)
+        {
+            return true;
+        }
+        memset(bits, 0, (size_t)words * sizeof(*bits));
+        for (uint32_t first = check_input_attributed_next(attributes, 0, input->token_count); first < input->token_count;
+             first = check_input_attributed_next(attributes, first + 16, input->token_count))
+        {
+            for (uint32_t selected = check_input_attributed_group(attributes, first, input->token_count); selected != 0; selected &= selected - 1)
+            {
+                const uint32_t token = first + (uint32_t)__builtin_ctz(selected);
+                const uint32_t attributed = input->objects[token];
+                if (attributed <= input->token_count)
+                {
+                    bits[attributed >> 6] |= UINT64_C(1) << (attributed & 63);
+                    if (check_input_attribute_of(check_input_attributes_at(input, token), CHECK_ATTRIBUTE_FLATTEN) != NULL &&
+                        !check_input_window_mark_flattened(reader, attributed))
+                    {
+                        return true;
+                    }
+                }
+            }
+        }
+        reader->window_attributed_objects = bits;
+    }
+    return (reader->window_attributed_objects[object >> 6] >> (object & 63) & 1u) != 0 ||
+           check_input_window_flattened_at(reader, call_token);
+}
