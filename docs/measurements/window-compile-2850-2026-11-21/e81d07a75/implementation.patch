+                                                  word + 1 - previous, sizeof(*known));
+        if (known == NULL) return false;
+        memset(known + previous, 0, (size_t)(input->window_decay_words - previous) * sizeof(*known));
+        input->window_known_decays = known;
+    }
+    const bool needs_decay = (input->window_known_decays[word] & bit) == 0 && type_find_pointer(types, fn) == 0;
+    if (needs_decay)
+    {
+        CheckFunctionDecay* space = check_input_window_room(reader->arena, graph->function_decays, graph->function_decay_count,
+                                                            &input->function_decay_capacity, 1, sizeof(*space));
+        if (space == NULL) return false;
+        graph->function_decays = space;
+    }
+    const uint32_t made=check_input_window_publish(reader,batch,root,value,rows,n+1+drop,n+3);
+    if (made==BUSTER_CHECK_NONE) return false;
+    input->window_known_decays[word] |= bit;
+    if (needs_decay)
+    {
+        graph->function_decays[graph->function_decay_count++] = (CheckFunctionDecay){.node = made, .function = fn};
