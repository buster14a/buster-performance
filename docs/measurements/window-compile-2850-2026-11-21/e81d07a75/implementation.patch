+// A call with one action per argument. The ordinary postorder includes the commas for multiargument calls.
+static uint32_t check_input_window_call_first(const CheckInputReader* reader, const uint32_t* tokens, const uint32_t* classes,
+                                              uint32_t start, uint32_t end)
+{
+    if (end <= start || check_input_window_code(classes,end-1) != CHECK_INPUT_CODE_CALL) return end;
+    const Parser* p = reader->parser;
+    const uint32_t root = tokens[end], close = tokens[end-1];
+    if (close == 0 || p->tokens.kinds[close] != PARSE_KIND_R_PAREN || p->tree.parents[close] != root) return end;
+    const bool statement = check_input_window_code(classes,end) == CHECK_INPUT_CODE_TERMINATOR;
+    uint32_t open = close - 1, args = 0;
+    if (p->tokens.kinds[open] != PARSE_KIND_L_PAREN)
+    {
+        while (open > 0 && args < BUSTER_CHECK_WINDOW_CALL_ARGUMENTS)
+        {
+            const uint8_t kind = p->tokens.kinds[open];
+            if (kind != PARSE_KIND_IDENTIFIER && kind != PARSE_KIND_NUMBER) return end;
+            ++args;
+            --open;
+            if (p->tokens.kinds[open] == PARSE_KIND_L_PAREN) break;
+            if (open == 0 || p->tokens.kinds[open] != PARSE_KIND_COMMA) return end;
+            --open;
+        }
+    }
+    if (open == 0 || p->tokens.kinds[open] != PARSE_KIND_L_PAREN || p->tokens.kinds[open-1] != PARSE_KIND_IDENTIFIER) return end;
+    if (statement)
+    {
+        if (root!=close+1 || p->tokens.kinds[root]!=PARSE_KIND_SEMI || reader->conditions[root]!=0 ||
+            p->tree.roles[root]!=PARSE_ROLE_TERMINATOR || p->tree.parents[root]>=p->tokens.count) return end;
+        const uint32_t parent=p->tree.parents[root];
+        if (p->tree.roles[parent]!=PARSE_ROLE_CLOSE_BODY && p->tree.roles[parent]!=PARSE_ROLE_CLOSE_BLOCK) return end;
+        const CheckInput* in=reader->output;
+        const uint32_t region=in->region_count?in->expression_regions[parent]:0;
+        if (region && in->regions[region-1].final_statement==root) return end;
+    }
+    else if (root+2!=open || p->tokens.kinds[root]!=PARSE_KIND_RETURN || close+1>=p->tokens.count || p->tokens.kinds[close+1]!=PARSE_KIND_SEMI)
+        return end;
+    uint32_t first=end-1, expected=close;
+    while (first>start && tokens[first]!=open-1)
+    {
+        --first;
+        uint32_t code=check_input_window_code(classes,first);
+        if (code==CHECK_INPUT_CODE_LIST || code==CHECK_INPUT_CODE_SEPARATOR) continue;
+        if (code!=CHECK_INPUT_CODE_IDENTIFIER && code!=CHECK_INPUT_CODE_LITERAL) return end;
+        const uint32_t want=expected==close ? (args ? close-1 : open-1) : expected==open+1 ? open-1 : expected-2;
+        if (tokens[first]!=want) return end;
+        expected=want;
+    }
+    return expected==open-1 ? first : end;
+}
