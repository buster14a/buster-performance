+static bool check_input_window_call_type(const TypeTable* types, TypeId type, bool void_ok)
+{
+    if (type == 0 || type != type_unqualified(type)) return false;
+    const uint8_t kind = type_kind(types,type);
+    return (void_ok && type==BUSTER_TYPE_VOID) || (kind==BUSTER_TYPE_KIND_POINTER && type_kind(types,type_element(types,type))!=BUSTER_TYPE_KIND_FUNCTION) ||
+           (kind==BUSTER_TYPE_KIND_INTEGER && type_size(types,type)<=8);
