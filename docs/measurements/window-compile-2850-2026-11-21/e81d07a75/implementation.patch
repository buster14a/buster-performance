+// Declarations of the same function can carry separate attributes. The ordinary target-feature pass
+// resolves them by object identity. Its flatten caller check can reject a wholly unannotated callee.
+static bool check_input_window_mark_flattened(CheckInputReader* reader, uint32_t object)
+{
+    const CheckInput* input = reader->output;
+    const uint32_t words = (input->token_count >> 6) + 1;
+    if (reader->window_flattened_bodies == NULL)
+    {
+        reader->window_flattened_bodies = BUSTER_ARENA_PUSH_ARRAY(reader->scratch, uint64_t, words);
+        if (reader->window_flattened_bodies != NULL)
+        {
+            memset(reader->window_flattened_bodies, 0, (size_t)words * sizeof(*reader->window_flattened_bodies));
+        }
+    }
+    const bool room = reader->window_flattened_bodies != NULL;
+    for (uint32_t open = room ? check_sparse_next(input->body_declarations, 0, input->token_count) : input->token_count;
+         open < input->token_count; open = check_sparse_next(input->body_declarations, open + 1, input->token_count))
+    {
+        const uint32_t definition = check_sparse_get(input->body_declarations, open);
+        const uint32_t close = reader->parser->tree.parents[open];
+        if (definition < input->token_count && input->objects[definition] == object && close < input->token_count)
+        {
+            reader->window_flattened_bodies[close >> 6] |= UINT64_C(1) << (close & 63);
+        }
+    }
+    return room;
+}
+
+static bool check_input_window_flattened_at(const CheckInputReader* reader, uint32_t token)
+{
+    const Parser* parser = reader->parser;
+    bool flattened = false;
+    if (reader->window_flattened_bodies != NULL)
+    {
+        for (uint32_t at = token, steps = 0; at < parser->tokens.count && steps < parser->tokens.count; steps += 1)
+        {
+            const uint8_t role = parser->tree.roles[at];
+            const uint32_t parent = parser->tree.parents[at];
+            if (role == PARSE_ROLE_CLOSE_BODY || role == PARSE_ROLE_OPEN_BODY)
+            {
+                const uint32_t close = role == PARSE_ROLE_CLOSE_BODY ? at : parent;
+                flattened = close < parser->tokens.count && (reader->window_flattened_bodies[close >> 6] >> (close & 63) & 1u) != 0;
+                break;
+            }
+            if (parent == at) { break; }
+            at = parent;
+        }
+    }
+    return flattened;
+}
