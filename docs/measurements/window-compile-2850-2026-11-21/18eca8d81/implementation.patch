+// Compare every parent, depth and role of a freshly preprocessed translation unit.
+static bool parse_test_packed_parent_source(const char* source, uint32_t length, uint32_t nest, bool tiled)
+{
+    const PPOptions options = { .language = { .standard = 2017, .gnu = true }, .no_standard_includes = true };
+    InternTable table = { 0 };
+    Preprocessor pp = { 0 };
+    Parser trees[2] = { 0 };
+    bool ok = intern_initialize(&table) && pp_initialize(&pp, &options, &table) &&
+              pp_run_source(&pp, "packed-parents.c", (const uint8_t*)source, length);
+    for (uint32_t i = 0; ok && i < BUSTER_ARRAY_LENGTH(trees); i += 1)
+    {
+        const ParseOptions parsing = { .tree_only = true, .byte_depths = i != 0 };
+        ok = parse_initialize(&trees[i], &parsing, options.language) && parse_translation_unit(&trees[i], &pp);
+    }
+    const char* difference = ok ? parse_test_parse_difference(&trees[0], &trees[1]) : "parse";
+    ok = ok && difference == NULL && !trees[0].tree.byte_depths && trees[1].tree.byte_depths == (nest < 255) &&
+         (trees[1].kernels.parent_tile_count >= 2) == tiled && trees[1].kernels.absolute_check_depths == (nest < 63);
+    if (!ok)
+    {
+        parse_test_report("packed parent indices at %u nested parentheses: %s\n", nest, difference != NULL ? difference : "representation");
+    }
+    parse_release(&trees[0]);
+    parse_release(&trees[1]);
+    pp_release(&pp);
+    intern_release(&table);
+    return ok;
+}
+
+// File-scope declarations cross two tiles and many 256-token index boundaries. The
+// last source crosses two tile boundaries inside a single expression.
+static uint32_t parse_test_packed_parent_indices(void)
+{
+    enum { declarations = 3072 };
+    static const uint32_t nests[] = { 0, 63, 254, 255, 259, 519 };
+    static const char declaration[] = "int x;\n";
+    static const char prefix[] = "int f(int x){return ";
+    char source[declarations * (sizeof(declaration) - 1) + sizeof(prefix) + 2 * 519 + 8];
+    uint32_t first = 0;
+    for (uint32_t d = 0; d < declarations; d += 1)
+    {
+        memcpy(source + first, declaration, sizeof(declaration) - 1);
+        first += sizeof(declaration) - 1;
+    }
+    memcpy(source + first, prefix, sizeof(prefix) - 1);
+    first += sizeof(prefix) - 1;
+    uint32_t failures = 0;
+    for (uint32_t n = 0; n < BUSTER_ARRAY_LENGTH(nests); n += 1)
+    {
+        const uint32_t nest = nests[n];
+        memset(source + first, '(', nest);
+        source[first + nest] = 'x';
+        memset(source + first + nest + 1, ')', nest);
+        memcpy(source + first + 2 * nest + 1, ";}\n", 3);
+        failures += !parse_test_packed_parent_source(source, first + 2 * nest + 4, nest, nest < 255);
+    }
+    first = sizeof(prefix) - 1;
+    memcpy(source, prefix, first);
+    for (uint32_t i = 0; i < 5000; i += 1)
+    {
+        memcpy(source + first, "x+", 2);
+        first += 2;
+    }
+    memcpy(source + first, "x;}\n", 4);
+    failures += !parse_test_packed_parent_source(source, first + 4, 0, true);
+
+    // More than 32 successively shallower closing parentheses are visible to the
+    // first boundary. Byte depths remain eligible while the parent pass falls back.
+    first = 0;
+    for (uint32_t i = 0; i < 1340; i += 1)
+    {
+        memcpy(source + first, declaration, sizeof(declaration) - 1);
+        first += sizeof(declaration) - 1;
+    }
+    memcpy(source + first, prefix, sizeof(prefix) - 1);
+    first += sizeof(prefix) - 1;
+    memset(source + first, '(', 80);
+    source[first + 80] = 'x';
+    memset(source + first + 81, ')', 80);
+    memcpy(source + first + 161, ";}\n", 3);
+    first += 164;
+    for (uint32_t i = 0; i < 1500; i += 1)
+    {
+        memcpy(source + first, declaration, sizeof(declaration) - 1);
+        first += sizeof(declaration) - 1;
+    }
+    failures += !parse_test_packed_parent_source(source, first, 80, false);
+    return failures;
+}
