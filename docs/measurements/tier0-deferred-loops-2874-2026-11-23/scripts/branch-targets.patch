From 03a5ad7e60479ecb3ac330c55f3e2cfe8646bb85 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 23 Nov 2026 16:38:41 +0000
Subject: [PATCH] Tier 0: emission's branch targets resolved after its blocks
 (#2874)

Emission gathered its branches' target positions once a block (#975's
64-bit gather of the positions), with or without a branch in the block:
about 46 thousand gathers on sqlite3.c. A template branch's target now
goes into its column as its entry, with a bit no record index has
(BUSTER_TIER0_TARGET_ENTRY), and tier0_branch_targets puts each entry's
position in its place once every block, deferred entry and the epilogue
are written: one 16-lane gather a column of 16 targets, about 1,700 on
sqlite3.c. The prologue's and the deferred entries' targets are record
indices already, and kept.

The mask of a step's lanes keeps all 16 while 16 or more targets are
left: _bzhi_u32 reads its index's low byte alone, so a count of 270
left once kept 14. test-tier0's branch chain takes 271 entries as well
as 13 for it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EgbxngDHhCG4YpQkQHQURG
Signed-off-by: David Gonzalez Martin <davidgmbb@gmail.com>
---
 docs/tier0.md                    |  5 ++++-
 src/buster/compiler/tier0.c      | 34 +++++++++++++++++++++++-------
 src/buster/compiler/tier0_test.c | 36 ++++++++++++++++++++------------
 3 files changed, 53 insertions(+), 22 deletions(-)

diff --git a/docs/tier0.md b/docs/tier0.md
index 308f3405f..ce42c9062 100644
--- a/docs/tier0.md
+++ b/docs/tier0.md
@@ -1671,7 +1671,10 @@ homes, and whether its four cases' words differ in the template alone (uniform).
    to its hole indices for the second block of a register, one `vpermb`, one blend and one 64-byte store. A lane of an
    absorbed or deferred entry, or past the last, stores too; the later lanes, the deferred entries and the epilogue
    write over it. The choice requests are compressed into their columns (`vpcompress`), their contexts read from the
-   expanded records. The branches, then the templates' references, follow in entry order by their masks' bits. The
+   expanded records. The branches, then the templates' references, follow in entry order by their masks' bits. A
+   template branch's target goes in as its entry (with a bit no record index has), and its position takes its place
+   once every block is done, 16 targets a gather (`tier0_branch_targets`): one gather of the positions a block, with or
+   without a branch in it, cost more (#2874). The
    deferred entries are written after the blocks, in order, from measuring's list, each over what the lanes stored at
    its place; their references go to a column of their own and then into the templates' by instruction, from the end,
    so that the references stay in the entries' order (#2874). A function with deep entries writes its deferred
diff --git a/src/buster/compiler/tier0.c b/src/buster/compiler/tier0.c
index e44c07419..67d777ea7 100644
--- a/src/buster/compiler/tier0.c
+++ b/src/buster/compiler/tier0.c
@@ -15123,6 +15123,25 @@ static Tier0Counts tier0_measure_vector(const Tier0Function* function, Tier0Entr
                                         : tier0_measure_vector_entries(function, entries, homes, prologue, false, false);
 }
 
+// A template branch's target as emission's blocks write it (tier0_emit_vector_entries): its entry with this bit, which no
+// record index has, until tier0_branch_targets puts the entry's position in its place.
+#define BUSTER_TIER0_TARGET_ENTRY 0x80000000u
+
+// The template branches' targets, entries (BUSTER_TIER0_TARGET_ENTRY) until every block is done, made their positions,
+// 16 targets a gather; the others (the prologue's, a deferred entry's) are record indices already, and kept.
+static void tier0_branch_targets(uint32_t* targets, uint32_t count, const uint32_t* positions)
+{
+    for (uint32_t first = 0; first < count; first += 16)
+    {
+        // (bzhi reads its index's low byte alone: a count of 256 or more left must not wrap.)
+        const __mmask16 lanes = count - first >= 16 ? (__mmask16)0xffff : (__mmask16)_bzhi_u32(0xffff, count - first);
+        const __m512i target = _mm512_maskz_loadu_epi32(lanes, targets + first);
+        const __mmask16 entries = lanes & _mm512_test_epi32_mask(target, _mm512_set1_epi32((int32_t)BUSTER_TIER0_TARGET_ENTRY));
+        const __m512i entry = _mm512_andnot_si512(_mm512_set1_epi32((int32_t)BUSTER_TIER0_TARGET_ENTRY), target);
+        _mm512_mask_storeu_epi32(targets + first, lanes, _mm512_mask_i32gather_epi32(target, entries, entry, positions, 4));
+    }
+}
+
 // One lane of emission: entry i's template expanded from `pair` (its hole block in the low 256 bits, or in the high ones
 // for an odd lane, whose indices take 32 more), stored at its position, and its choice record's reg, rm, index and mode
 // bytes put in dword `lane` of `fields`. A lane of an absorbed or deferred entry, or past the entries, expands its word's
@@ -15249,8 +15268,10 @@ static inline __attribute__((always_inline)) void tier0_emit_vector_entries(cons
             requests += (uint32_t)__builtin_popcount(choice);
         }
         // #892: the branches' records and targets stored compressed, as the choices' columns are — each lane's
-        // (position + branch field) and its target's position, the targets gathered under the branch mask, rather than
-        // a lane-at-a-time loop whose exit mispredicts. Both columns have room for 8 past the last branch.
+        // (position + branch field) and its target's entry, rather than a lane-at-a-time loop whose exit mispredicts.
+        // Both columns have room for 8 past the last branch. A target entry carries BUSTER_TIER0_TARGET_ENTRY, and its
+        // position takes its place once every block is done (tier0_branch_targets, #2874): one gather a block (#975's,
+        // of the positions), with or without a branch in it, cost more than one a column of 16 targets.
         const __mmask8 branch = template & _mm512_test_epi64_mask(word, _mm512_set1_epi64((int64_t)BUSTER_TIER0_WORD_BRANCH));
         const __m512i branch_position = _mm512_cvtepu32_epi64(_mm256_loadu_si256((const __m256i*)(positions + first)));
         const __m512i branch_field = _mm512_and_si512(_mm512_srli_epi64(word, BUSTER_TIER0_WORD_BRANCH_SHIFT), _mm512_set1_epi64(3));
@@ -15258,12 +15279,8 @@ static inline __attribute__((always_inline)) void tier0_emit_vector_entries(cons
                             _mm256_maskz_compress_epi32(branch, _mm512_cvtepi64_epi32(_mm512_add_epi64(branch_position, branch_field))));
         const __mmask8 branch_end = _mm512_test_epi64_mask(word, _mm512_set1_epi64((int64_t)BUSTER_TIER0_WORD_END));
         const __m512i branch_target = _mm512_mask_mov_epi64(_mm512_and_si512(current, _mm512_set1_epi64(0xffffffff)), branch_end, _mm512_set1_epi64(count));
-        // #975: `_mm512_mask_i64gather_epi32` expands to `__builtin_ia32_gatherdiv16si`, which neither the checker's
-        // catalogue nor the backend's rows (there is no VPGATHERQD row) have, so the compiler could not check or lower
-        // this file. The 64-bit gather is the measure pass's, and a position's low half is the whole value.
-        const __m512i target_qwords = _mm512_mask_i64gather_epi64(_mm512_setzero_si512(), branch, branch_target, positions, 4);
-        const __m256i target_position = _mm512_cvtepi64_epi32(target_qwords);
-        _mm256_storeu_si256((__m256i*)(targets + branches), _mm256_maskz_compress_epi32(branch, target_position));
+        const __m512i target_entry = _mm512_or_si512(branch_target, _mm512_set1_epi64(BUSTER_TIER0_TARGET_ENTRY));
+        _mm256_storeu_si256((__m256i*)(targets + branches), _mm256_maskz_compress_epi32(branch, _mm512_cvtepi64_epi32(target_entry)));
         branches += (uint32_t)__builtin_popcount(branch);
         // The references and, in a function with deep entries, the deferred entries, in entry order: a call's references
         // come where its records do. Another function's deferred entries are written after the blocks.
@@ -15342,6 +15359,7 @@ static inline __attribute__((always_inline)) void tier0_emit_vector_entries(cons
     }
     writer.count = positions[count];
     tier0_emit_epilogue(function, frame, &writer);
+    tier0_branch_targets(targets, branches, positions);
     // An asm body's own branches (#1839) are a deferred entry's, written after the branches of the entries after it.
     bool body_branches = false;
     for (uint32_t b = 0; b < function->asm_body_count && function->asm_bodies != 0; b += 1)
diff --git a/src/buster/compiler/tier0_test.c b/src/buster/compiler/tier0_test.c
index ca22d8aac..d7b88c1be 100644
--- a/src/buster/compiler/tier0_test.c
+++ b/src/buster/compiler/tier0_test.c
@@ -6741,23 +6741,27 @@ static void tier0_test_entry_repetitions(Tier0TestTally* tally)
 // for every branch, its own entry's first record and the first record of the entry it goes to, or the epilogue's for a
 // return's jump to the function's end: 12 branches, 8 and 4 in the emitter's two blocks, so that the last store writes
 // its reserved tail, against the positions both paths publish (Tier0Code.entry_records).
-static void tier0_test_branches(Tier0TestTally* tally)
+// A chain of `entries` jumps, each to the next, the last two returns: its branches' records and targets, the entries' first
+// records. 271 entries make 270 branches, whose count's low byte (14) is under a vector's 16 targets: #2874's resolution
+// of the targets after emission (tier0_branch_targets) once wrapped there.
+#define BUSTER_TIER0_TEST_CHAIN_MOST 512
+static void tier0_test_branch_chain(Tier0TestTally* tally, uint32_t entries)
 {
-    enum { ENTRIES = 13, BRANCHES = 12 };
-    Tier0TestEntry chain[ENTRIES];
-    for (uint32_t e = 0; e + 2 < (uint32_t)ENTRIES; e += 1)
+    const uint32_t branches = entries - 1;
+    Tier0TestEntry chain[BUSTER_TIER0_TEST_CHAIN_MOST];
+    for (uint32_t e = 0; e + 2 < entries; e += 1)
     {
         chain[e] = (Tier0TestEntry){ BUSTER_TYPED_JUMP, BUSTER_TYPED_CLASS_VOID, e + 1 };
     }
     // The last entry's return needs no jump: it falls into the epilogue. This one's goes to the function's end.
-    chain[ENTRIES - 2] = (Tier0TestEntry){ BUSTER_TYPED_RETURN, BUSTER_TYPED_CLASS_VOID, 0 };
-    chain[ENTRIES - 1] = (Tier0TestEntry){ BUSTER_TYPED_RETURN, BUSTER_TYPED_CLASS_VOID, 0 };
-    uint8_t kinds[ENTRIES];
-    uint8_t classes[ENTRIES];
-    uint64_t values[ENTRIES];
+    chain[entries - 2] = (Tier0TestEntry){ BUSTER_TYPED_RETURN, BUSTER_TYPED_CLASS_VOID, 0 };
+    chain[entries - 1] = (Tier0TestEntry){ BUSTER_TYPED_RETURN, BUSTER_TYPED_CLASS_VOID, 0 };
+    uint8_t kinds[BUSTER_TIER0_TEST_CHAIN_MOST];
+    uint8_t classes[BUSTER_TIER0_TEST_CHAIN_MOST];
+    uint64_t values[BUSTER_TIER0_TEST_CHAIN_MOST];
     static const uint8_t local_classes[1] = { BUSTER_TYPED_CLASS_U64 };
     static const uint8_t local_flags[1] = { 0 };
-    Tier0Function function = tier0_test_stack_function(chain, ENTRIES, kinds, classes, values, local_classes, local_flags, 0);
+    Tier0Function function = tier0_test_stack_function(chain, entries, kinds, classes, values, local_classes, local_flags, 0);
     function.entry_records = true;
     Arena arena = arena_reserve(UINT64_C(1) << 20);
     const Tier0Check check = tier0_validate(&function);
@@ -6767,14 +6771,14 @@ static void tier0_test_branches(Tier0TestTally* tally)
                                               tier0_test_same_code(&scalar, &vector),
                                    "branches", "the chain: rule \"%s\" at %u, errors %d and %d, or the paths differ", check.rule != 0 ? check.rule : "", check.node,
                                    scalar.error, vector.error);
-    ready = ready && tier0_test_expect(tally, vector.entry_count == (uint32_t)ENTRIES && vector.branch_count == (uint32_t)BRANCHES && vector.entry_records != 0 &&
+    ready = ready && tier0_test_expect(tally, vector.entry_count == entries && vector.branch_count == branches && vector.entry_records != 0 &&
                                                   x86_validate(vector.records, vector.count) == vector.count &&
                                                   branch_sizing_validate(vector.records, vector.count, vector.branches, vector.targets, vector.branch_count).error ==
                                                       BRANCH_SIZING_OK,
                                        "branches", "%u entries, %u branches, or an invalid record or column", vector.entry_count, vector.branch_count);
-    for (uint32_t k = 0; ready && k < (uint32_t)BRANCHES; k += 1)
+    for (uint32_t k = 0; ready && k < branches; k += 1)
     {
-        const uint32_t target = k + 1 < (uint32_t)BRANCHES ? k + 1 : (uint32_t)ENTRIES;
+        const uint32_t target = k + 1 < branches ? k + 1 : entries;
         ready = tier0_test_expect(tally, vector.branches[k] == vector.entry_records[k] && vector.targets[k] == vector.entry_records[target],
                                   "branches", "branch %u: record %u (entry %u's is %u), target %u (entry %u's is %u)", k, vector.branches[k], k,
                                   vector.entry_records[k], vector.targets[k], target, vector.entry_records[target]);
@@ -6782,6 +6786,12 @@ static void tier0_test_branches(Tier0TestTally* tally)
     arena_release(&arena);
 }
 
+static void tier0_test_branches(Tier0TestTally* tally)
+{
+    tier0_test_branch_chain(tally, 13);
+    tier0_test_branch_chain(tally, 271);
+}
