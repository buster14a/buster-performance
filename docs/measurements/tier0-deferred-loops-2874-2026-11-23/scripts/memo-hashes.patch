     }
-    for (uint32_t k = 0; k < deferred_count; k += 1)
+    // The deferred entries eight at a time (#2874): the calls' keys in the thread's table (tier0_call_memo_key) and their
+    // hashes in one vector (tier0_call_memo_hashes), their slots' lines fetched; then each entry in order. A call the
