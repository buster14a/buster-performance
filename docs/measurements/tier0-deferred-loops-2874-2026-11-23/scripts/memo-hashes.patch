     }
     __m512i carry = _mm512_set1_epi64(prologue);
     for (uint32_t first = 0; first < count; first += 8)
@@ -15315,9 +15369,9 @@ static inline __attribute__((always_inline)) void tier0_emit_vector_entries(cons
         {
