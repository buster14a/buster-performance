         const __m512i length = _mm512_maskz_and_epi64(template, _mm512_srli_epi64(word, BUSTER_TIER0_WORD_LENGTH_SHIFT), seven);
-        _mm256_storeu_si256((__m256i*)(lengths + first), _mm512_cvtepi64_epi32(length));
