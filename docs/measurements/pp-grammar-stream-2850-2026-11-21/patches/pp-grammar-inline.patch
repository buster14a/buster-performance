diff --git a/src/buster/compiler/c_preprocessor_impl.c b/src/buster/compiler/c_preprocessor_impl.c
index d956fa69f..2a2757989 100644
--- a/src/buster/compiler/c_preprocessor_impl.c
+++ b/src/buster/compiler/c_preprocessor_impl.c
@@ -14654,8 +14654,81 @@ static bool pp_diagnostic_warning_visible(Preprocessor* pp, uint32_t location, u
 // Gives each identifier of output tokens [begin, end) that is a keyword in the language mode its keyword's kind, 64 tokens
 // at a time: one compare finds the identifiers, and for each 16, one compare their ids below the table's size, and two
 // vpermi2b look their kinds up in pp->keyword_kinds's halves, one picked by bit 7 of the id.
+static uint32_t pp_resolve_grammar_range(Preprocessor* pp, uint32_t begin, uint32_t end)
+{
+    if (pp->grammar_kinds==NULL) pp->grammar_block(pp->grammar_owner,pp);
+    if (pp->grammar_block==NULL) return begin;
+    if (begin!=*pp->grammar_progress || end>pp->grammar_limit) {
+        *pp->grammar_failed=true;pp->grammar_block=NULL;
+        return begin;
+    }
+    const __m512i grammar0=_mm512_load_si512(pp->grammar_table);
+    const __m512i grammar1=_mm512_load_si512(pp->grammar_table+64);
+    const __m512i grammar2=_mm512_load_si512(pp->grammar_table+128);
+    const __m512i grammar3=_mm512_load_si512(pp->grammar_table+192);
+    PPTokens* out = &pp->output;
+    const __m512i table0 = _mm512_loadu_si512(pp->keyword_kinds);
+    const __m512i table1 = _mm512_loadu_si512(pp->keyword_kinds + 64);
+    const __m512i table2 = _mm512_loadu_si512(pp->keyword_kinds + 128);
+    const __m512i table3 = _mm512_loadu_si512(pp->keyword_kinds + 192);
+    for (uint32_t i = begin; i < end; i += 64)
+    {
+        const __mmask64 valid = end - i >= 64 ? ~0ull : _bzhi_u64(~0ull, end - i);
+        const __m512i kinds = _mm512_maskz_loadu_epi8(valid, out->kinds + i);
+        const uint64_t special = _mm512_mask_cmpeq_epi8_mask(valid,kinds,_mm512_set1_epi8(C_TOKEN_HASH)) |
+            _mm512_mask_cmpeq_epi8_mask(valid,kinds,_mm512_set1_epi8((char)BUSTER_PP_KIND_PRAGMA_END)) |
+            _mm512_mask_cmpeq_epi8_mask(valid,kinds,_mm512_set1_epi8(C_TOKEN_COLONCOLON));
+        if (special != 0) {
+            *pp->grammar_failed=true;pp->grammar_block=NULL;
+            return i;
+        }
+        // A rare existing keyword is a name too. The low table is consulted only for raw identifiers.
+        const uint64_t existing = _mm512_mask_cmpge_epu8_mask(valid,kinds,_mm512_set1_epi8(BUSTER_PP_KIND_KEYWORD)) &
+                                  _mm512_mask_cmplt_epu8_mask(valid,kinds,_mm512_set1_epi8((char)BUSTER_PP_KIND_PRAGMA_END));
+        const uint64_t identifiers = _mm512_mask_cmpeq_epi8_mask(valid, kinds, _mm512_set1_epi8(C_TOKEN_RAW_IDENTIFIER));
+        __m512i resolved=kinds;
+        if ((identifiers|existing) != 0) {
+            __m512i looked = _mm512_setzero_si512();
+            uint64_t small = 0;
+            for (uint32_t group = 0; group < 4; group += 1)
+            {
+                const __mmask16 lanes = (__mmask16)(identifiers >> (group * 16));
+                const uint32_t offset=group*16;
+                const __m512i values = _mm512_maskz_loadu_epi32((__mmask16)((identifiers|existing)>>offset),out->values+i+offset);
+                _mm512_mask_storeu_epi32(pp->grammar_names+i+offset,(__mmask16)(valid>>offset),values);
+                const __mmask16 keywords = _mm512_mask_cmplt_epu32_mask(lanes, values, _mm512_set1_epi32(BUSTER_PP_KEYWORD_TABLE));
+                const __m128i indices = _mm512_cvtepi32_epi8(values);
+                const __m512i wide = _mm512_zextsi128_si512(indices);
+                const __m128i lower = _mm512_castsi512_si128(_mm512_permutex2var_epi8(table0, wide, table1));
+                const __m128i upper = _mm512_castsi512_si128(_mm512_permutex2var_epi8(table2, wide, table3));
+                const __m128i kinds_here = _mm_mask_blend_epi8(_mm_movepi8_mask(indices), lower, upper);
+                looked = group == 0 ? _mm512_inserti32x4(looked, kinds_here, 0)
+                       : group == 1 ? _mm512_inserti32x4(looked, kinds_here, 1)
+                       : group == 2 ? _mm512_inserti32x4(looked, kinds_here, 2)
+                                    : _mm512_inserti32x4(looked, kinds_here, 3);
+                small |= (uint64_t)keywords << (group * 16);
+            }
+            _mm512_mask_storeu_epi8(out->kinds+i,small,looked);
+            resolved=_mm512_mask_mov_epi8(kinds,small,looked);
+        } else {
+            for (uint32_t group=0;group<4;group++) {
+                const uint32_t offset=group*16;
+                _mm512_mask_storeu_epi32(pp->grammar_names+i+offset,(__mmask16)(valid>>offset),_mm512_setzero_si512());
+            }
+        }
+        const __m512i low=_mm512_permutex2var_epi8(grammar0,resolved,grammar1);
+        const __m512i high=_mm512_permutex2var_epi8(grammar2,resolved,grammar3);
+        _mm512_mask_storeu_epi8(pp->grammar_kinds+i,valid,_mm512_mask_blend_epi8(_mm512_movepi8_mask(resolved),low,high));
+        const __m512i flags=_mm512_and_si512(_mm512_maskz_loadu_epi8(valid,out->flags+i),_mm512_set1_epi8((char)pp->grammar_flag_mask));
+        _mm512_mask_storeu_epi8(pp->grammar_flags+i,valid,flags);
+        *pp->grammar_progress=i+(end-i<64?end-i:64);
+    }
+    return end;
+}
+
 static void pp_resolve_keywords_range(Preprocessor* pp, uint32_t begin, uint32_t end)
 {
+    if (pp->grammar_block!=NULL && begin<end) begin=pp_resolve_grammar_range(pp,begin,end);
     PPTokens* out = &pp->output;
     const __m512i table0 = _mm512_loadu_si512(pp->keyword_kinds);
     const __m512i table1 = _mm512_loadu_si512(pp->keyword_kinds + 64);
