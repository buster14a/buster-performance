+                for (int f=2;f>=0;f--) close(front_event[f]);
+                fprintf(stderr,"front-group tokens=%u grammar=%u semantic=%u deferred=%u"
+                        " pp-enabled=%lu pp-running=%lu pp-user=%lu pp-kernel=%lu pp-instructions=%lu"
+                        " front-enabled=%lu front-running=%lu front-user=%lu front-kernel=%lu front-instructions=%lu\n",
