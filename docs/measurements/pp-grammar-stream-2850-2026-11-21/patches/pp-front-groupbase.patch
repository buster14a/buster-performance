+        const bool sample_front = getenv("BUSTER_TEST_FRONT_GROUP") != NULL;
+        int front_event[3] = {-1,-1,-1};
+        uint64_t pp_sample[6] = {0}, parse_sample[6] = {0};
+        if (sample_front)
+        {
+            // One group starts and stops together. Its first two counters partition counted
+            // cycles by privilege level. Its third counts all retired instructions.
+            struct perf_event_attr attribute = {
+                .size = sizeof(attribute), .type = PERF_TYPE_HARDWARE,
+                .read_format = PERF_FORMAT_GROUP | PERF_FORMAT_TOTAL_TIME_ENABLED | PERF_FORMAT_TOTAL_TIME_RUNNING,
+            };
+            for (uint32_t e=0;e<3;e++)
+            {
+                attribute.config = e<2 ? PERF_COUNT_HW_CPU_CYCLES : PERF_COUNT_HW_INSTRUCTIONS;
+                attribute.exclude_kernel = e==0;
+                attribute.exclude_user = e==1;
+                attribute.disabled = e==0;
+                front_event[e] = (int)syscall(__NR_perf_event_open,&attribute,0,-1,e==0?-1:front_event[0],0);
+                if (front_event[e]<0) abort();
+            }
+            if (ioctl(front_event[0],PERF_EVENT_IOC_RESET,PERF_IOC_FLAG_GROUP) ||
+                ioctl(front_event[0],PERF_EVENT_IOC_ENABLE,PERF_IOC_FLAG_GROUP)) abort();
+        }
         ready = pp_run_input(pp, path);
+        if (sample_front && read(front_event[0],pp_sample,sizeof(pp_sample))!=(ssize_t)sizeof(pp_sample)) abort();
         // A fatal before the main file is entered (a --predefines file that can't be read, #2828) has no unit
