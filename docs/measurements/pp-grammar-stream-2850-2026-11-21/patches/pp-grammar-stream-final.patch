 // Parses the unit the preprocessor `pp` produced (pp_run's output). Returns false if it has errors or the parser ran out
 // of memory (parser->fatal); the diagnostics are in parser->diagnostics (parse_print_diagnostics prints them).
+
+#define BUSTER_GRAMMAR_STREAM_LIMIT (1u << 20)
+
+// Called by the preprocessor as it resolves the final keyword kinds. Straight runs retain their
+// original PP index. A pragma, split colon, nonmonotone callback or larger unit uses the ordinary
+// conversion. These dedicated writable padded columns belong to the parser.
+static void parse_grammar_block(void* owner, Preprocessor* pp, uint32_t index, uint32_t count, __m512i kinds)
+{
+    Parser* parser = owner;
+    ParseTokens* stream = &parser->grammar_stream;
+    const uint64_t live = _bzhi_u64(UINT64_MAX, count);
+    const uint64_t special = _mm512_mask_cmpeq_epi8_mask(live, kinds, _mm512_set1_epi8(C_TOKEN_HASH)) |
+                             _mm512_mask_cmpeq_epi8_mask(live, kinds, _mm512_set1_epi8((char)BUSTER_PP_KIND_PRAGMA_END)) |
+                             _mm512_mask_cmpeq_epi8_mask(live, kinds, _mm512_set1_epi8(C_TOKEN_COLONCOLON));
+    bool accepted = index == stream->count && index <= BUSTER_GRAMMAR_STREAM_LIMIT && count <= BUSTER_GRAMMAR_STREAM_LIMIT-index && special == 0;
+    if (accepted && stream->kinds == NULL) {
+        const uint64_t room = 2 * BUSTER_GRAMMAR_STREAM_LIMIT + 64;
+        const uint64_t entries[] = { room,room,room };
+        const uint64_t widths[] = { 1,4,1 };
+        void** columns[] = { (void**)&stream->kinds,(void**)&stream->names,(void**)&stream->flags };
+        accepted = parse_columns(parser,17,3,entries,widths,columns);
+    }
+    if (!accepted) {
+        parser->grammar_failed = true;
+        pp->grammar_block = NULL;
+        return;
+    }
+    const __m512i low = _mm512_permutex2var_epi8(_mm512_load_si512(parse_kind_table),kinds,_mm512_load_si512(parse_kind_table+64));
+    const __m512i high = _mm512_permutex2var_epi8(_mm512_load_si512(parse_kind_table+128),kinds,_mm512_load_si512(parse_kind_table+192));
+    _mm512_mask_storeu_epi8(stream->kinds+index,live,_mm512_mask_blend_epi8(_mm512_movepi8_mask(kinds),low,high));
+    _mm512_mask_storeu_epi8(stream->flags+index,live,
+         _mm512_and_si512(_mm512_maskz_loadu_epi8(live,pp->output.flags+index),_mm512_set1_epi8((char)BUSTER_PARSE_PP_FLAGS)));
+    const uint64_t names = _mm512_mask_cmpeq_epi8_mask(live,kinds,_mm512_set1_epi8(C_TOKEN_RAW_IDENTIFIER)) |
+        (_mm512_mask_cmpge_epu8_mask(live,kinds,_mm512_set1_epi8(BUSTER_PP_KIND_KEYWORD)) &
+         _mm512_mask_cmplt_epu8_mask(live,kinds,_mm512_set1_epi8((char)BUSTER_PP_KIND_PRAGMA_END)));
+    for (uint32_t group=0;group*16<count;group++) {
+        const uint32_t offset=16*group;
+        const __m512i values=_mm512_maskz_loadu_epi32((__mmask16)(names>>offset),pp->output.values+index+offset);
+        _mm512_mask_storeu_epi32(stream->names+index+offset,(__mmask16)(live>>offset),values);
+    }
+    stream->count += count;
+}
+
+BUSTER_PARSER_ENTRY __attribute__((unused)) void parse_grammar_begin(Parser* parser, Preprocessor* pp)
+{
+    const char* mode = getenv("BUSTER_TEST_PP_GRAMMAR_STREAM");
+    parser->grammar_mode = mode == NULL ? 0 : (uint32_t)atoi(mode);
+    if (parser->grammar_mode != 0 && !pp->options.scalar && arena_reservation_limit() == BUSTER_ARENA_MAX_CAPACITY) {
+        parser->grammar_stream = (ParseTokens){0};
+        parser->grammar_failed = false;
+        pp->grammar_owner = parser;
+        pp->grammar_block = parse_grammar_block;
+    }
+}
