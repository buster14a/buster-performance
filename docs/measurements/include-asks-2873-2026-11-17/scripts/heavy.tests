== Compare main.c's checking and its functions and objects with clang's
# #129: the compiler's own main.c, with build.sh's flags for a plain -march=znver5 build whatever this run's host,
# sanitizer and fuzzing, and -DBUSTER_COMPLETE_DRIVER=1 for the whole compiler rather than the driver unit's code
# (the unit docs/c-lowering.md measures; docs/commands/build.md): checked by both paths, which must agree, and
# accepted as clang -fsyntax-only accepts it, and its -c object must define what clang -O0 -c's does, but for the
# documented reasons. The one file must be compared, except in the TSan and MSan rows: it is 4,864,411 preprocessed
# tokens (on 2026-11-10), and at 6,323,682 its two paths held 7.5 GiB resident unsanitized and TSan's shadow took the
# same check past 20 GiB, beyond the hosted runner (docs/ci.md). Every other row and the 9700X still run it.
if [ "${BUSTER_SANITIZER:-none}" != thread ] && [ "${BUSTER_SANITIZER:-none}" != memory ]; then
unset CPATH C_INCLUDE_PATH
mapfile -d '' -t flags < <(env -u BUSTER_SANITIZER -u BUSTER_SANITIZER_OPTIMIZATION -u BUSTER_FUZZ_AVAILABLE -u BUSTER_FUZZ_ENTRY \
  BUSTER_HOST_ARCH=znver5 BUSTER_DEBUG_INFO=0 ./build.sh print-compile-flags --config Release)
test "${#flags[@]}" -gt 0
"$BUSTER_COMPILER" test-checker-corpus --clang clang --symbols-minimum 1 "${flags[@]}" -DBUSTER_COMPLETE_DRIVER=1 src/buster/compiler/main.c
else
printf 'SKIP: main.c checking comparison (sanitizer memory budget; docs/ci.md)\n'
exit 77
fi
== Compile main.c by -c, its referenced definitions and all of them, by both paths
# #129 and #619: the compiler's own main.c, with build.sh's flags for a plain -march=znver5 build whatever this
# run's host, sanitizer and fuzzing, and -DBUSTER_COMPLETE_DRIVER=1 for the whole compiler (the unit
# docs/c-lowering.md measures), by -c, which lowers what its roots
# reach, and by --lower-all, which lowers every definition but C's inline-only ones, the header intrinsics of
# features znver5 lacks among them; each with --verify's checks of every function's records. The scalar path's
# --lower-all object must be the vector path's, byte for byte. A compile takes 10 GiB under TSan and 6.6 GiB under
# MSan, so those rows skip it here and run it alone after the suite (the workflow's "Compile main.c alone under TSan
# or MSan" step); every other row and the 9700X still run it here.
if [ "${BUSTER_SANITIZER:-none}" != thread ] && [ "${BUSTER_SANITIZER:-none}" != memory ]; then
unset CPATH C_INCLUDE_PATH
mapfile -d '' -t flags < <(env -u BUSTER_SANITIZER -u BUSTER_SANITIZER_OPTIMIZATION -u BUSTER_FUZZ_AVAILABLE -u BUSTER_FUZZ_ENTRY \
  BUSTER_HOST_ARCH=znver5 BUSTER_DEBUG_INFO=0 ./build.sh print-compile-flags --config Release)
test "${#flags[@]}" -gt 0
objects=$(mktemp -d)
"$BUSTER_COMPILER" --lanes 1 --verify -c "${flags[@]}" -o "$objects/selected.o" -DBUSTER_COMPLETE_DRIVER=1 src/buster/compiler/main.c
"$BUSTER_COMPILER" --lanes 1 --verify --lower-all -c "${flags[@]}" -o "$objects/all.o" -DBUSTER_COMPLETE_DRIVER=1 src/buster/compiler/main.c
"$BUSTER_COMPILER" --scalar --lanes 1 --verify --lower-all -c "${flags[@]}" -o "$objects/all-scalar.o" -DBUSTER_COMPLETE_DRIVER=1 src/buster/compiler/main.c
cmp "$objects/all.o" "$objects/all-scalar.o"
rm -r "$objects"
else
printf 'SKIP: main.c -c compiles (the TSan/MSan rows run them alone after the suite; docs/ci.md)\n'
exit 77
fi
