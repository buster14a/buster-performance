+// follows its path's bytes in a second run, in memory that can be read: a '/' or a dot there, past the path's end,
+// changes nothing.
+static bool pp_test_component_keys(void)
+{
+    static const struct
+    {
+        const char* path;
+        uint32_t component;
+        const char* name;
+        const char* tail;
+    } cases[] = {
+        { "d/bits/a.h", 4, "bits", "/b" },
+        { "d/b/a.h", 1, "b", "/" },
