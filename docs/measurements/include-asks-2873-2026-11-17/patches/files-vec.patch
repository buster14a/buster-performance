+// A search directory asked for a subdirectory (FileCacheDirectory.component_names, #2873). After BUSTER_FILE_CACHE_ASKING_MISSES failed
+// probes under one first component of a search directory, the cache asks the directory for the component, once: a stat
+// of the component's own path. A directory without it then gives ENOENT for every path under it, without an open. Every
+// search finds what it finds with the asks off: the same cache with asking_misses 0 gives the same paths, files and
+// errors, and opens every candidate an answer spared. What an ask can't rule out is still opened: a component the
+// directory has, a regular file by its name (ENOTDIR, which counts no miss), another spelling of a component it lacks, a
+// name it begins with and one that begins with it, "." and "..", and a component longer than a name can be. A dangling
+// link and a name past ASCII are asked for as any other, and a name without a '/' never. A directory counts
+// BUSTER_FILE_CACHE_COMPONENTS components, of names up to BUSTER_FILE_CACHE_COMPONENT_NAME bytes: one past either is
+// opened every time, and a component's count stops at 255, so that it is asked for once. A second unit that shares the
+// cache uses the answers at once. A directory with a listing is asked nothing more: its listing answers
+// (file_cache_listed_absent).
+static bool pp_test_directory_asks(const char* directory)
+{
+    char first[4200];
+    char second[4200];
+    char have[4300];
+    char bits[4300];
+    char path[4400];
+    snprintf(first, sizeof(first), "%s/ask-first", directory);
+    snprintf(second, sizeof(second), "%s/ask-second", directory);
+    snprintf(have, sizeof(have), "%s/have", first);
+    snprintf(bits, sizeof(bits), "%s/bits", second);
+    bool result = mkdir(first, 0700) == 0 && mkdir(second, 0700) == 0 && mkdir(have, 0700) == 0 && mkdir(bits, 0700) == 0;
+    snprintf(path, sizeof(path), "%s/inner.h", have);
+    result = result && pp_test_write_file(path, "int inner;\n");
+    snprintf(path, sizeof(path), "%s/plain", first);
+    result = result && pp_test_write_file(path, "int plain;\n");
+    snprintf(path, sizeof(path), "%s/gone", first);
+    result = result && symlink("nowhere", path) == 0;
+    static const char* const headers[] = { "a.h", "b.h", "c.h", "d.h", "e.h" };
+    for (uint32_t i = 0; result && i < BUSTER_ARRAY_LENGTH(headers); i += 1)
+    {
+        snprintf(path, sizeof(path), "%s/%s", bits, headers[i]);
+        result = pp_test_write_file(path, "int header;\n");
+    }
+    // Two paths under a component longer than a name can be.
+    char long_names[2][304];
+    for (uint32_t i = 0; i < 2; i += 1)
+    {
+        memset(long_names[i], 'a', 298);
+        memcpy(long_names[i] + 298, i == 0 ? "/a.h" : "/b.h", 5);
+    }
+    // Each search with the candidates the asking unit opens, the asks it makes and the candidates an answer spares it.
+    static const struct
+    {
+        const char* name;
+        uint8_t opens;
+        uint8_t asks;
+        uint8_t answered;
+    } steps[] = {
+        // `first` has no `bits`: it is asked at the component's third miss and answers from the fourth search on.
+        { "bits/a.h", 2, 0, 0 },
+        { "bits/b.h", 2, 0, 0 },
+        { "bits/c.h", 2, 1, 0 },
+        { "bits/d.h", 1, 0, 1 },
+        // Headers `second`'s `bits` lacks: `second` is asked at the third, has the component, and is opened each time.
+        { "bits/x.h", 1, 0, 1 },
+        { "bits/y.h", 1, 0, 1 },
+        { "bits/z.h", 1, 1, 1 },
+        { "bits/w.h", 1, 0, 1 },
+        // A component neither has; another spelling of it, a name it begins with and one that begins with it are other
+        // components.
+        { "none/a.h", 2, 0, 0 },
+        { "none/b.h", 2, 0, 0 },
+        { "none/c.h", 2, 2, 0 },
+        { "none/d.h", 0, 0, 2 },
+        { "None/a.h", 2, 0, 0 },
+        { "non/a.h", 2, 0, 0 },
+        { "nonesuch/a.h", 2, 0, 0 },
+        // A component `first` has, with a header and without: asked, it has it, and its paths are opened.
+        { "have/inner.h", 1, 0, 0 },
+        { "have/x.h", 2, 0, 0 },
+        { "have/y.h", 2, 0, 0 },
+        { "have/z.h", 2, 2, 0 },
+        { "have/w.h", 1, 0, 1 },
+        // A regular file by the component's name in `first`: ENOTDIR there, which is no miss.
+        { "plain/a.h", 2, 0, 0 },
+        { "plain/b.h", 2, 0, 0 },
+        { "plain/c.h", 2, 1, 0 },
+        { "plain/d.h", 1, 0, 1 },
+        // A dangling link by the component's name in `first`.
+        { "gone/a.h", 2, 0, 0 },
+        { "gone/b.h", 2, 0, 0 },
+        { "gone/c.h", 2, 2, 0 },
+        { "gone/d.h", 0, 0, 2 },
+        // "." and ".." are no components to ask for, whatever follows them; a name of two bytes with one dot is.
+        { "./none/e.h", 2, 0, 0 },
+        { "./none/f.h", 2, 0, 0 },
+        { "./none/g.h", 2, 0, 0 },
+        { "./none/h.h", 2, 0, 0 },
+        { "../ask-second/bits/a.h", 1, 0, 0 },
+        { "../nowhere/a.h", 2, 0, 0 },
+        { "../nowhere/b.h", 2, 0, 0 },
+        { "../nowhere/c.h", 2, 0, 0 },
+        { "../nowhere/d.h", 2, 0, 0 },
+        { ".a/a.h", 2, 0, 0 },
+        { ".a/b.h", 2, 0, 0 },
+        { ".a/c.h", 2, 2, 0 },
+        { ".a/d.h", 0, 0, 2 },
+        { "a./a.h", 2, 0, 0 },
+        { "a./b.h", 2, 0, 0 },
+        { "a./c.h", 2, 2, 0 },
+        { "a./d.h", 0, 0, 2 },
+        // A name past ASCII.
+        { "\xc3\xa9/a.h", 2, 0, 0 },
+        { "\xc3\xa9/b.h", 2, 0, 0 },
+        { "\xc3\xa9/c.h", 2, 2, 0 },
+        { "\xc3\xa9/d.h", 0, 0, 2 },
+        // Names in the directories themselves.
+        { "zz.h", 2, 0, 0 },
+        { "yy.h", 2, 0, 0 },
+        { "xx.h", 2, 0, 0 },
+        { "ww.h", 2, 0, 0 },
+        // The long component's two paths (ENAMETOOLONG).
+        { 0, 2, 0, 0 },
+        { 0, 2, 0, 0 },
+        // A name of as many bytes as a slot holds, and one of a byte more, which is not counted.
+        { "fifteen-bytes-x/a.h", 2, 0, 0 },
+        { "fifteen-bytes-x/b.h", 2, 0, 0 },
+        { "fifteen-bytes-x/c.h", 2, 2, 0 },
+        { "fifteen-bytes-x/d.h", 0, 0, 2 },
+        { "sixteen-bytes-xy/a.h", 2, 0, 0 },
+        { "sixteen-bytes-xy/b.h", 2, 0, 0 },
+        { "sixteen-bytes-xy/c.h", 2, 0, 0 },
+        { "sixteen-bytes-xy/d.h", 2, 0, 0 },
+    };
+    const char* const directories[] = { first, second };
+    PPOptions options = {
+        .language = {
+            .standard = 2023,
+        },
+        .no_standard_includes = true,
+        .include_directories = directories,
+        .include_directory_count = BUSTER_ARRAY_LENGTH(directories),
+        .quiet = true,
+    };
+    // Units 0 (asks) and 1 (the asks off) search every name, with listings off; unit 2 shares unit 0's cache; units 3
+    // (asks and listings) and 4 (both off) search until the directories are listed, and after.
+    static InternTable tables[5];
+    static Preprocessor units[5];
+    for (uint32_t u = 0; u < 5; u += 1)
+    {
+        units[u] = (Preprocessor){ 0 };
+        options.files = u == 2 ? units[0].cache : 0;
+        result = result && intern_initialize(&tables[u]) && pp_initialize(&units[u], &options, u == 2 ? &tables[0] : &tables[u]);
+    }
+    if (result)
+    {
+        units[0].cache->listing_misses = 0;
+        units[1].cache->listing_misses = 0;
+        units[1].cache->asking_misses = 0;
+        units[4].cache->listing_misses = 0;
+        units[4].cache->asking_misses = 0;
+    }
+    uint64_t expected_opens = 0;
+    uint64_t expected_asks = 0;
+    uint64_t expected_answered = 0;
+    uint32_t long_name = 0;
+    // After the table's steps, the slots: `first` counts ten components by then and `second` eleven, of
+    // BUSTER_FILE_CACHE_COMPONENTS. Four paths under each of c00 to c05: `first` has slots for c00 to c04 and `second`
+    // for c00 to c03, and a component without a slot is opened every time. Then 260 headers `second`'s `bits` lacks: a
+    // component's count stops at 255, and the directory is not asked for it again.
+    const uint32_t table = (uint32_t)BUSTER_ARRAY_LENGTH(steps);
+    const uint32_t crowded = 6 * 4;
+    const uint32_t repeated = 260;
+    for (uint32_t s = 0; result && s < table + crowded + repeated; s += 1)
+    {
+        char generated[32];
+        const bool crowd = s >= table && s < table + crowded;
+        const uint32_t group = crowd ? (s - table) / 4 : 0;
+        const uint32_t turn = crowd ? (s - table) % 4 : 0;
+        const uint32_t counted = (group <= 4) + (group <= 3);
+        if (crowd)
+        {
+            snprintf(generated, sizeof(generated), "c%02u/%c.h", group, 'a' + (int)turn);
+        }
+        else
+        {
+            snprintf(generated, sizeof(generated), "bits/m%03u.h", s >= table ? s - table - crowded : 0);
+        }
+        const char* name = s < table ? steps[s].name : generated;
+        if (name == 0)
+        {
+            name = long_names[long_name];
+            long_name += 1;
+        }
+        expected_opens += s < table ? steps[s].opens : crowd ? (turn == 3 ? 2 - counted : 2) : 1;
+        expected_asks += s < table ? steps[s].asks : crowd && turn == 2 ? counted : 0;
+        expected_answered += s < table ? steps[s].answered : crowd ? (turn == 3 ? counted : 0) : 1;
+        uint32_t found[2];
+        uint32_t files[2];
+        for (uint32_t u = 0; u < 2; u += 1)
+        {
+            files[u] = pp_find_include(&units[u], (const uint8_t*)name, (uint32_t)strlen(name), true, false, BUSTER_PP_NONE, BUSTER_PP_NONE, &found[u],
+                                       BUSTER_PP_NONE);
+        }
+        result = (files[0] == BUSTER_PP_NONE) == (files[1] == BUSTER_PP_NONE) && found[0] == found[1] && units[0].probes.opens == expected_opens &&
+                 units[0].probes.asks == expected_asks && units[0].probes.listed == expected_answered && units[0].probes.listings == 0 &&
+                 units[1].probes.opens == expected_opens + expected_answered && units[1].probes.asks == 0 && units[1].probes.listed == 0;
+        if (!result)
+        {
+            printf("directory asks: %.40s: found %u/%u in %u/%u, opens %lu/%lu, asks %lu/%lu, answered %lu/%lu, the opens without asks %lu/%lu\n", name,
+                   files[0] != BUSTER_PP_NONE, files[1] != BUSTER_PP_NONE, found[0], found[1], (unsigned long)units[0].probes.opens, (unsigned long)expected_opens,
+                   (unsigned long)units[0].probes.asks, (unsigned long)expected_asks, (unsigned long)units[0].probes.listed, (unsigned long)expected_answered,
+                   (unsigned long)units[1].probes.opens, (unsigned long)(expected_opens + expected_answered));
+        }
+    }
+    result = result && pp_test_same_lookups(&units[0], &units[1]);
+    // The unit that shares the cache: `first` answers for `bits` at once, and both answer for `none`, without an ask.
+    if (result)
+    {
+        uint32_t found;
+        const uint32_t header = pp_find_include(&units[2], (const uint8_t*)"bits/e.h", 8, true, false, BUSTER_PP_NONE, BUSTER_PP_NONE, &found, BUSTER_PP_NONE);
+        const uint64_t opens = units[2].probes.opens;
+        const uint32_t absent = pp_find_include(&units[2], (const uint8_t*)"none/z.h", 8, true, false, BUSTER_PP_NONE, BUSTER_PP_NONE, &found, BUSTER_PP_NONE);
+        result = header != BUSTER_PP_NONE && opens == 1 && absent == BUSTER_PP_NONE && units[2].probes.opens == 1 && units[2].probes.listed == 3 &&
+                 units[2].probes.asks == 0 && units[2].files[units[2].file_count - 2].error == ENOENT && units[2].files[units[2].file_count - 1].error == ENOENT;
+        if (!result)
+        {
+            printf("directory asks: the shared cache: opens %lu, answered %lu, asks %lu\n", (unsigned long)units[2].probes.opens,
+                   (unsigned long)units[2].probes.listed, (unsigned long)units[2].probes.asks);
+        }
+    }
+    // With listings: `none` is asked for and answered; names in the directories themselves then bring each to its
+    // BUSTER_FILE_CACHE_LISTING_MISSES-th miss and its listing, which answers the names after them and every component
+    // from then on, so that a listed directory is asked for nothing; a directory that isn't listed (this file system's
+    // lookups a listing can't answer for) is asked as before.
+    struct statfs system;
+    const bool listable = result && statfs(first, &system) == 0 && file_cache_exact_names((uint64_t)system.f_type);
+    const uint32_t misses = BUSTER_FILE_CACHE_LISTING_MISSES;
+    static const char* const before[] = { "none/a.h", "none/b.h", "none/c.h", "none/d.h" };
+    static const char* const after[] = { "none/e.h", "have/v.h", "have/w.h", "have/u.h", "have/t.h" };
+    const uint32_t flat = 40;
+    const uint32_t count = (uint32_t)BUSTER_ARRAY_LENGTH(before) + flat + (uint32_t)BUSTER_ARRAY_LENGTH(after);
+    expected_opens = 0;
+    expected_asks = 0;
+    expected_answered = 0;
+    uint64_t plain_opens = 0;
+    for (uint32_t c = 0; result && c < count; c += 1)
+    {
+        char header[64];
+        const uint32_t q = c - (uint32_t)BUSTER_ARRAY_LENGTH(before);
+        const uint32_t a = q - flat;
+        const bool is_before = c < BUSTER_ARRAY_LENGTH(before);
+        const bool is_flat = !is_before && q < flat;
+        snprintf(header, sizeof(header), "q%02u.h", is_flat ? q : 0);
+        const char* name = is_before ? before[c] : is_flat ? header : after[a];
+        // Each directory has three misses from `none` before the names in it: its listing comes at the name that is
+        // its `misses`-th, and answers from the next.
+        const bool listed = listable && is_flat && q + 3 >= misses;
+        const bool late = listable && !is_before && !is_flat;
+        uint32_t opens = 2;
+        uint32_t asks = 0;
+        uint32_t answered = 0;
+        if (is_before)
+        {
+            opens = c == 3 ? 0 : 2;
+            asks = c == 2 ? 2 : 0;
+            answered = c == 3 ? 2 : 0;
+        }
+        else if (is_flat)
+        {
+            opens = listed ? 0 : 2;
+            answered = listed ? 2 : 0;
+        }
+        else if (a == 0)
+        {
+            opens = 0;
+            answered = 2;
+        }
+        else
+        {
+            // `have` in `first`, which has it, and in `second`, which lacks it: the listing answers for `second`, or it
+            // is asked at the third miss.
+            opens = late ? 1 : a == 4 ? 1 : 2;
+            asks = late ? 0 : a == 3 ? 2 : 0;
+            answered = late ? 1 : a == 4 ? 1 : 0;
+        }
+        expected_opens += opens;
+        expected_asks += asks;
+        expected_answered += answered;
+        plain_opens += opens + answered;
+        uint32_t found[2];
+        uint32_t files[2];
+        for (uint32_t u = 0; u < 2; u += 1)
+        {
+            files[u] = pp_find_include(&units[3 + u], (const uint8_t*)name, (uint32_t)strlen(name), true, false, BUSTER_PP_NONE, BUSTER_PP_NONE, &found[u],
+                                       BUSTER_PP_NONE);
+        }
+        const uint32_t looks = !is_before && (!is_flat || q + 4 >= misses) ? 2 : 0;
+        result = (files[0] == BUSTER_PP_NONE) == (files[1] == BUSTER_PP_NONE) && found[0] == found[1] && units[3].probes.opens == expected_opens &&
+                 units[3].probes.asks == expected_asks && units[3].probes.listed == expected_answered && units[3].probes.listings == looks &&
+                 units[4].probes.opens == plain_opens && units[4].probes.asks == 0 && units[4].probes.listed == 0 && units[4].probes.listings == 0;
+        if (!result)
+        {
+            printf("directory asks: with listings, %s: found %u/%u in %u/%u, opens %lu/%lu, asks %lu/%lu, answered %lu/%lu, listings %lu/%u, the opens without either %lu/%lu\n",
+                   name, files[0] != BUSTER_PP_NONE, files[1] != BUSTER_PP_NONE, found[0], found[1], (unsigned long)units[3].probes.opens, (unsigned long)expected_opens,
+                   (unsigned long)units[3].probes.asks, (unsigned long)expected_asks, (unsigned long)units[3].probes.listed, (unsigned long)expected_answered,
+                   (unsigned long)units[3].probes.listings, looks, (unsigned long)units[4].probes.opens, (unsigned long)plain_opens);
+        }
+    }
+    result = result && pp_test_same_lookups(&units[3], &units[4]);
+    for (uint32_t u = 5; u > 0; u -= 1)
+    {
+        pp_release(&units[u - 1]);
+    }
+    for (uint32_t u = 0; u < 5; u += 1)
+    {
+        intern_release(&tables[u]);
+    }
+    for (uint32_t i = 0; i < BUSTER_ARRAY_LENGTH(headers); i += 1)
+    {
+        snprintf(path, sizeof(path), "%s/%s", bits, headers[i]);
+        unlink(path);
+    }
+    snprintf(path, sizeof(path), "%s/inner.h", have);
+    unlink(path);
+    snprintf(path, sizeof(path), "%s/plain", first);
+    unlink(path);
+    snprintf(path, sizeof(path), "%s/gone", first);
+    unlink(path);
+    rmdir(have);
+    rmdir(bits);
+    rmdir(first);
+    rmdir(second);
+    printf("directory asks: %s (%s; a component a directory lacks, one it has, a file, a dangling link, other spellings, dots, a name past ASCII, a long "
+           "one, the slots, a shared cache, listings)\n",
+           result ? "as expected" : "WRONG", listable ? "listed" : "this file system's directories aren't listed");
+    return result;
+}
