diff --git a/src/buster/compiler/c_direct_cc.c b/src/buster/compiler/c_direct_cc.c
index 4523010c3..be43d8cc6 100644
--- a/src/buster/compiler/c_direct_cc.c
+++ b/src/buster/compiler/c_direct_cc.c
@@ -1839,6 +1839,26 @@ _Static_assert(sizeof(FastVal) == 32u, "expression stack entry size");
 #define BUSTER_FVAL_WORD_HEAD(type, kind, lvalue, union_byte) \
     ((uint64_t)(uint32_t)(type) | ((uint64_t)(uint8_t)(kind) << 32) | ((uint64_t)(uint8_t)(lvalue) << 48) | ((uint64_t)(uint8_t)(union_byte) << 56))
 #define BUSTER_FVAL_WORD_TAIL(marks, seq_ident) ((uint64_t)(uint8_t)(marks) | ((uint64_t)(uint32_t)(seq_ident) << 32))
+// A value moved between the stacks a word at a time: a value just pushed was written in 8-byte words (a name's, an
+// integer literal's) or whole (a reduction's result), so each 8-byte load takes its bytes from one store, where a
+// 32-byte copy's single load spans several and waits for them to retire. The empty asm keeps Clang from joining the
+// four loads into that one load again.
+static inline __attribute__((always_inline)) void fval_move_words(FastVal* dst, const FastVal* src)
+{
+    uint64_t w0;
+    uint64_t w1;
+    uint64_t w2;
+    uint64_t w3;
+    memcpy(&w0, (const uint8_t*)src, 8);
+    memcpy(&w1, (const uint8_t*)src + 8, 8);
+    memcpy(&w2, (const uint8_t*)src + 16, 8);
+    memcpy(&w3, (const uint8_t*)src + 24, 8);
+    __asm__("" : "+r"(w0), "+r"(w1), "+r"(w2), "+r"(w3));
+    memcpy((uint8_t*)dst, &w0, 8);
+    memcpy((uint8_t*)dst + 8, &w1, 8);
+    memcpy((uint8_t*)dst + 16, &w2, 8);
+    memcpy((uint8_t*)dst + 24, &w3, 8);
+}
 _Static_assert(offsetof(FastVal, kind) == 4u && offsetof(FastVal, reg) == 5u && offsetof(FastVal, is_lvalue) == 6u &&
                offsetof(FastVal, is_func_sym) == 7u && offsetof(FastVal, imm) == 8u && offsetof(FastVal, sym_idx) == 16u &&
                offsetof(FastVal, bf_off) == 20u && offsetof(FastVal, marks) == 24u && offsetof(FastVal, op) == 25u &&
@@ -9092,7 +9112,7 @@ static inline __attribute__((always_inline)) void fast_cc_expr_compile(FastCCSta
                 cc->pos += 1u;
                 // Push final argument
                 if (ex.vsp < 2u || ex.arg_sp >= 128u) { fast_cc_bail(cc, "call arg stack"); break; }
-                ex.call_args[ex.arg_sp++] = ex.vstack[--ex.vsp];
+                ex.vsp -= 1u; fval_move_words(ex.call_args + ex.arg_sp, ex.vstack + ex.vsp); ex.arg_sp += 1u;
                 const uint32_t argc = ex.arg_sp - cop.lbl0;
                 ex.call_open = cop.lbl2;
                 fast_expr_finish_call(&ex, cop.lbl0, argc);
@@ -9237,7 +9257,7 @@ static inline __attribute__((always_inline)) void fast_cc_expr_compile(FastCCSta
                 if (ex.vsp < 1u || ex.arg_sp >= 128u) { fast_cc_bail(cc, "call arg overflow"); break; }
                 // Spill argument if it holds a register so subsequent args can use all scratch regs!
                 fval_spill_one(&ex, &ex.vstack[ex.vsp - 1u]);
-                ex.call_args[ex.arg_sp++] = ex.vstack[--ex.vsp];
+                ex.vsp -= 1u; fval_move_words(ex.call_args + ex.arg_sp, ex.vstack + ex.vsp); ex.arg_sp += 1u;
                 ops[osp - 1u].extra += 1u;
                 ops[osp - 1u].seq_mid = BUSTER_FSEQ_MARK_IF(&ex, logging);
                 cc->pos += 1u;
