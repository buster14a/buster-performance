diff --git a/src/buster/compiler/c_direct_lex.c b/src/buster/compiler/c_direct_lex.c
index 5cf5b25d1..4e9d71e64 100644
--- a/src/buster/compiler/c_direct_lex.c
+++ b/src/buster/compiler/c_direct_lex.c
@@ -40,6 +40,12 @@
 #define BUSTER_DIRECT_HOT
 #endif
 
+// Struct zeroing and copies in 32-byte stores (#3577): Clang zeroes a record over 64 bytes with 64-byte stores at
+// whatever offset the frame gives it, and on Zen 5 a 64-byte store that isn't 32-byte aligned doesn't forward some of
+// its bytes in the next cache line to a later load (it waits until the store retires); a 32-byte store forwards at any
+// offset. The declarations read their declarator's and specifiers' results right after zeroing them.
+#define BUSTER_DIRECT_STORES32 __attribute__((target("prefer-256-bit")))
+
