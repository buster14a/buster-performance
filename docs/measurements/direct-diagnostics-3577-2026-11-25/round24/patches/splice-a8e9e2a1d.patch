+// A position right after a plain newline, one with no backslash or blank before it: a line certainly starts there.
+#define BUSTER_FAST_PLAIN_LINE_START(base, at) \
+    ((at) > (base) && (at)[-1] == '\n' && ((at) - 1 == (base) || ((at)[-2] != '\\' && (fast_char_class[(at)[-2]] & 8u) == 0)))
+
+// Whether a conditional whose '#' is at `at` is no directive to the full pipeline: back over its line's leading blanks
+// and over each line splice before them (a backslash, blanks, a newline, as c_lexer.c's escaped_newline_size takes
+// them), its logical line has other text before it. A splice with blanks between its backslash and newline (the full
+// pipeline's warning) answers yes too, so the unit leaves; text before the '#' on its own physical line (a comment's)
+// answers no, as the skip's masks decide that line. Cold: the skip asks it only where a conditional's '#' isn't right
+// after a plain newline, as its masks take a backslash right before a newline for a splice already (#3577).
+static __attribute__((noinline, cold)) bool fast_line_continues(const uint8_t* base, const uint8_t* at)
+{
+    const uint8_t* p = at;
+    bool through = false;
+    uint32_t answer = 0;
+    while (answer == 0)
+    {
+        while (p > base && (fast_char_class[p[-1]] & 8u) != 0)
+        {
+            p -= 1;
+        }
+        if (p > base && p[-1] == '\n')
+        {
+            const uint8_t* q = p - 1;
+            while (q > base && (fast_char_class[q[-1]] & 8u) != 0)
+            {
+                q -= 1;
+            }
+            const bool splice = q > base && q[-1] == '\\';
+            const bool tight = q == p - 1 || (q == p - 2 && p[-2] == '\r');
+            answer = !splice ? 1u : !tight ? 2u : 0u;
+            through = true;
+            p = splice ? q - 1 : p;
+        }
+        else
+        {
+            answer = p > base && through && p != at ? 2u : 1u;
+        }
+    }
+    return answer == 2u;
+}
