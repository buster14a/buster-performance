                             .seq_ident = id,
                         };
diff --git a/src/buster/compiler/c_direct_lex.c b/src/buster/compiler/c_direct_lex.c
index 43fdcecc5..826f52e68 100644
--- a/src/buster/compiler/c_direct_lex.c
+++ b/src/buster/compiler/c_direct_lex.c
@@ -3790,7 +3790,25 @@ static bool fast_pp_expand_buffer(FastPP* pp, const FastTok* in_toks, uint32_t i
                     else
                     {
                         const FastIdentEntry* ae = pp->idents.entries + arg.data;
-                        val = pp->feature_query(pp->feature_context, query, (const uint8_t*)(pp->idents.strings + ae->str_offset), ae->length);
+                        // MEASUREMENT ONLY: main 20f3573ee's answers, so that the unit's tokens are main's.
+                        const char* s = pp->idents.strings + ae->str_offset;
+                        (void)query;
+                        if (pkw == FPP_KW_HAS_BUILTIN)
+                        {
+                            val = (strcmp(s, "__builtin_clzll") == 0 || strcmp(s, "__builtin_offsetof") == 0 ||
+                                   strcmp(s, "__builtin_va_start") == 0 || strcmp(s, "__builtin_va_arg") == 0 ||
+                                   strcmp(s, "__builtin_va_end") == 0 || strcmp(s, "__builtin_va_copy") == 0 ||
+                                   strcmp(s, "__builtin_inff") == 0 || strcmp(s, "__builtin_expect") == 0 ||
+                                   strcmp(s, "__builtin_constant_p") == 0 || strcmp(s, "__builtin_unreachable") == 0) ? 1u : 0u;
+                        }
+                        else if (pkw == FPP_KW_HAS_ATTRIBUTE)
+                        {
+                            static const char* const attrs[] = { "noinline", "__noinline__", "always_inline", "__always_inline__", "unused", "__unused__",
+                                "packed", "__packed__", "aligned", "__aligned__", "fallthrough", "__fallthrough__", "noreturn", "__noreturn__",
+                                "format", "__format__", "nonnull", "__nonnull__", "pure", "__pure__", "const", "__const__", "malloc", "__malloc__",
+                                "deprecated", "__deprecated__", "visibility", "__visibility__", "weak", "__weak__", "alias", "__alias__" };
+                            for (uint32_t ai = 0; ai < sizeof(attrs) / sizeof(attrs[0]); ai += 1) { val |= strcmp(s, attrs[ai]) == 0 ? 1u : 0u; }
+                        }
                         ef->pos += 3u;
                     }
                 }
