+static int fast_pp_dir_fd(FastPP* pp, uint32_t d)
+{
+    if (pp->dir_states[d] == BUSTER_FPP_DIR_UNOPENED)
+    {
+        const int fd = open(pp->dirs[d], O_PATH | O_DIRECTORY | O_CLOEXEC);
