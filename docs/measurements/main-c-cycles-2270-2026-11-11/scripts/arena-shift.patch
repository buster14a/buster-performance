diff --git a/src/buster/compiler/lane.c b/src/buster/compiler/lane.c
index b172e7e..d5b7177 100644
--- a/src/buster/compiler/lane.c
+++ b/src/buster/compiler/lane.c
@@ -590,6 +590,34 @@ static Arena arena_reserve_policy(uint64_t capacity, uint64_t small, bool bounde
             arena_failure = (ArenaFailure){ .bytes = requested, .error = errno };
         }
     }
+    // #2270 experiment (not for merging): BUSTER_ARENA_SHIFT=SEED (1 or more) starts each arena this reserves a
+    // pseudo-random multiple of 64 bytes below 4 KiB past its base, a different one per reservation and seed, so that
+    // the arenas' data move against each other and against the cache sets; their pages stay where they were. Only arenas
+    // of 1 GiB or more, which no unit fills (some smaller ones are pushed to their exact capacity).
+    if (result.base != 0)
+    {
+        static int arena_shift_seed = -1;
+        static uint64_t arena_shift_count;
+        if (arena_shift_seed < 0)
+        {
+            const char* text = getenv("BUSTER_ARENA_SHIFT");
+            arena_shift_seed = text != 0 ? atoi(text) : 0;
+        }
+        if (arena_shift_seed > 0)
+        {
+            uint64_t h = (uint64_t)arena_shift_seed * 0x9E3779B97F4A7C15ull + (arena_shift_count + 1) * 0xBF58476D1CE4E5B9ull;
+            arena_shift_count += 1;
+            h ^= h >> 31;
+            h *= 0x94D049BB133111EBull;
+            h ^= h >> 29;
+            const uint64_t shift = (h & 63) * 64;
+            if (result.capacity >= (UINT64_C(1) << 30))
+            {
+                result.length = shift;
+                result.peak = result.peak > shift ? result.peak : shift;
+            }
+        }
+    }
     return result;
 }
 
