+static BUSTER_BAKED_UNIT uint64_t tier0_template_words[BUSTER_TIER0_TEMPLATE_CAPACITY + 2];
 // Per form, what x86_choice_instruction does with it as a chosen form: its immediate's bytes, and whether it takes no
