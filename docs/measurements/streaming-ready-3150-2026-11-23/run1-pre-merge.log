        if [ $f = sqlite ]; then args="--predefines /tmp/buster-2830-claude/corpus/provenance/gnu17-pinned-predefines.txt -std=gnu17 -nostdinc -isystem /tmp/buster-2830-claude/corpus/headers/usr/lib/clang/23/include -isystem /tmp/buster-2830-claude/corpus/headers/usr/local/include -isystem /tmp/buster-2830-claude/corpus/headers/usr/include /tmp/buster-2830-claude/corpus/sqlite/sqlite3.c"; else args="-Itree/src -fwrapv -funsigned-char -fno-strict-aliasing --predefines out/compile/predefines.h tree/src/buster/compiler/main.c"; fi
        taskset -c 2 perf stat -x, -e cycles:u,instructions:u,task-clock -o out/compile/perf.txt -- /tmp/buster-2830-claude/bin/$name -c --tier1 -march=$march $args -o out/compile/t.o > /dev/null 2>&1
