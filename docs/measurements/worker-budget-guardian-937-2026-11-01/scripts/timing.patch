@@ -277,6 +279,25 @@ static bool worker_budget_child_fds(int read_fd, int write_fd, int control, int
 // through storage reserved before borrowing: GNU make initializes at most the pipe capacity before starting jobs.
 // Additional bytes taken here do no work and are returned with the original lease; every partial write keeps its
 // unwritten suffix. A temporary IO failure must retain ownership, never turn an error acknowledgement into lost slots.
+
+// Temporary #937 instrumentation: one lease's acquire and release costs, off unless the environment names the variable.
+static uint64_t worker_budget_timing_now(void)
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC_RAW, &now);
+    return (uint64_t)now.tv_sec * UINT64_C(1000000000) + (uint64_t)now.tv_nsec;
+}
+
+static bool worker_budget_timing_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0)
+    {
+        enabled = getenv("BUSTER_WORKER_BUDGET_TIMING") != 0;
+    }
+    return enabled != 0;
+}
