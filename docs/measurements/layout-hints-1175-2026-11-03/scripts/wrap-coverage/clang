#!/bin/bash
# Source-based coverage of every compile and link of build/compiler (#1175's bias counts).
cov=1
for a in "$@"; do
    case "$a" in -E|-dM|-dumpmachine|-###|-emit-llvm|-print-*|--version|-v|assembler) cov=0 ;; esac
done
if [ $cov = 1 ]; then
    exec /usr/lib/llvm-23/bin/clang "$@" -fprofile-instr-generate -fcoverage-mapping -mno-sse4a
fi
exec /usr/lib/llvm-23/bin/clang "$@"
