#!/bin/bash
# Adds --emit-relocs to link steps only, for BOLT's instrumentation; code and layout are unchanged.
link=1
for a in "$@"; do
    case "$a" in -c|-E|-S|-dM|-dumpmachine|-###|-emit-llvm|-print-*|--version|-v) link=0 ;; esac
done
if [ $link = 1 ]; then
    exec /usr/lib/llvm-23/bin/clang "$@" -Wl,--emit-relocs
fi
exec /usr/lib/llvm-23/bin/clang "$@"
