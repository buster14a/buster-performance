+            {
+                fprintf(stderr, "  phi v%u:", in->phi_values[k]);
+                for (uint32_t o = in->phi_operand_offsets[k]; o < in->phi_operand_offsets[k + 1]; o += 1) fprintf(stderr, " v%d", (int)in->phi_operands[o]);
