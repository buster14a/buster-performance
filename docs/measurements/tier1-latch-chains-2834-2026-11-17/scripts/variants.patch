+static void tier1_cfg_test_latch_chain(Tier1CfgTestTally* tally, Arena* output, Arena* scratch)
+{
+    static Tier1CfgTestBuilder builder;
+    memset(&builder, 0, sizeof(builder));
+    builder.block_count = 7;
+    const uint32_t instructions[] = { 2, 1, 1, 1, 1, 1, 1 };
+    for (uint32_t b = 0; b < builder.block_count; b += 1)
+    {
+        builder.instructions[b] = instructions[b];
+    }
+    builder.registers[0] = (uint32_t)(getenv("T2834REGS") != 0 ? strtoul(getenv("T2834REGS"), 0, 0) : 0x000f);
+    builder.scratch[0] = 11;
+    const uint32_t edges[][2] = {
+        { 0, 4 },
+        { 1, 2 },
+        { 6, 2 },
+        { 2, 4 },
+        { 2, 3 },
+        { 4, 5 },
+        { 5, 1 },
+        { 5, 6 },
+    };
+    for (uint32_t k = 0; k < BUSTER_ARRAY_LENGTH(edges); k += 1)
+    {
+        tier1_cfg_test_edge(&builder, edges[k][0], edges[k][1]);
+    }
+    const uint32_t all = builder.registers[0];
+    const uint32_t s0 = tier1_cfg_test_value(&builder, 0, 0, 0, all);
+    const uint32_t t0 = tier1_cfg_test_value(&builder, 0, 1, 0, all);
+    const uint32_t x = tier1_cfg_test_value(&builder, 1, 0, 0, all);
+    const uint32_t e = tier1_cfg_test_value(&builder, 5, 0, 0, all);
+    const uint32_t n1 = tier1_cfg_test_value(&builder, 6, 0, 0, all);
+    tier1_cfg_test_definition_use(&builder, s0);
+    tier1_cfg_test_definition_use(&builder, t0);
+    tier1_cfg_test_definition_use(&builder, x);
+    tier1_cfg_test_definition_use(&builder, e);
+    tier1_cfg_test_definition_use(&builder, n1);
+    const uint32_t n_h = builder.value_count + 2;
+    const uint32_t l_h = builder.value_count + 3;
+    const uint32_t jn_operands[] = { n_h, n1 };
+    const uint32_t jn = tier1_cfg_test_phi(&builder, 2, 0, jn_operands);
+    const uint32_t jl_operands[] = { l_h, e };
+    const uint32_t jl = tier1_cfg_test_phi(&builder, 2, 0, jl_operands);
+    const uint32_t hn_operands[] = { s0, jn };
+    const uint32_t hn = tier1_cfg_test_phi(&builder, 4, 0, hn_operands);
+    const uint32_t hl_operands[] = { t0, jl };
+    const uint32_t hl = tier1_cfg_test_phi(&builder, 4, 0, hl_operands);
+    tier1_cfg_test_expect(tally, hn == n_h && hl == l_h, "latch chain: phi ids");
+    tier1_cfg_test_use(&builder, hn, 4, 0, true);
+    tier1_cfg_test_use(&builder, hl, 5, 0, true);
+    tier1_cfg_test_use(&builder, e, 6, 0, true);
+    tier1_cfg_test_use(&builder, hn, 6, 0, true);
+    tier1_cfg_test_use(&builder, jn, 3, 0, true);
+    const uint64_t saved = output->length;
+    Tier1CfgInput input;
+    const bool built = tier1_cfg_test_build(&builder, output, &input);
+    tier1_cfg_test_expect(tally, built, "latch chain: built");
+    for (uint32_t path = 0; built && path < 2; path += 1)
+    {
+        const uint64_t mark = output->length;
+        Tier1CfgAllocation result = { 0 };
+        const Tier1CfgError error = path == 0 ? tier1_cfg_allocate(&input, output, scratch, &result) : tier1_cfg_allocate_scalar(&input, output, scratch, &result);
+        Tier1CfgCheck check;
+        const bool allocated = error == TIER1_CFG_OK && tier1_cfg_verify(&input, &result, scratch, &check);
+        tier1_cfg_test_expect(tally, allocated, "latch chain: allocated");
+        if (getenv("T2834") != 0)
+        {
+            for (uint32_t k = 0; allocated && k < BUSTER_ARRAY_LENGTH(edges); k += 1)
+            {
+                fprintf(stderr, "path %u edge %u->%u moves %u\n", path, edges[k][0], edges[k][1], tier1_cfg_test_edge_moves(&input, &result, edges[k][0], edges[k][1]));
+            }
+            for (uint32_t i = 0; allocated && i < result.intervals.count; i += 1)
+            {
+                fprintf(stderr, "  iv %u v%u [%u,%u) hint %d:", i, result.intervals.values[i], result.intervals.starts[i], result.intervals.ends[i], (int)result.intervals.hint_intervals[i]);
+                for (uint32_t f = result.allocation.fragment_offsets[i]; f < result.allocation.fragment_offsets[i + 1]; f += 1)
+                {
+                    fprintf(stderr, " [%u,%u)k%u r%u", result.allocation.starts[f], result.allocation.ends[f], result.allocation.kinds[f], result.allocation.registers[f]);
+                }
+                fprintf(stderr, "\n");
+            }
+        }
+        arena_pop_to(output, mark);
+    }
+    arena_pop_to(output, saved);
+}
