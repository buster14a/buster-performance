+    uint32_t v = 0;
+    for (uint32_t node = 0; node < function->instruction_count; node += 1)
+    {
+        const bool value = plan->covered[node] == 0 && function->type[node] != IR_VOID && function->type[node] != IR_F80;
+        if (value)
+        {
+            nodes[v] = node;
+            v += 1;
+        }
+    }
+    const uint32_t base = 2 * (in->block_count - function->block_count);
+    fprintf(stderr, "== debug2834 blocks %u values %u (%u) base %u positions %u intervals %u\n", in->block_count, in->value_count, v, base, in->position_count, cfg->intervals.count);
+    for (uint32_t b = 0; b < in->block_count; b += 1)
+    {
+        if (in->block_starts[b + 1] > lo && in->block_starts[b] < hi)
+        {
+            fprintf(stderr, "block %u [%u,%u) preds", b, in->block_starts[b], in->block_starts[b + 1]);
+            for (uint32_t p = in->predecessor_offsets[b]; p < in->predecessor_offsets[b + 1]; p += 1) fprintf(stderr, " %u", in->predecessors[p]);
+            fprintf(stderr, " succs");
+            for (uint32_t s = in->successor_offsets[b]; s < in->successor_offsets[b + 1]; s += 1) fprintf(stderr, " %u", in->successors[s]);
+            fprintf(stderr, "\n");
