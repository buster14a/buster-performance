== Test the preprocessor on the repository's translation units against clang [2 CPUs]
# --clang also preprocesses each unit with clang -E, with clang's predefines for its options, and compares the
# tokens. -target and its triple (clang's default) go to both. clang's runs go to the job's clang server where it built
# one (#2071), compared as the cases' parts' are, but the guard counts' (-print-stats, LLVM's counters), as children.
mapfile -d '' -t host_flags < <(./build.sh print-host-flags)
test "${#host_flags[@]}" -gt 0
"$BUSTER_COMPILER" test-preprocessor --clang -target x86_64-pc-linux-gnu "${host_flags[@]}" -Isrc -fwrapv -funsigned-char -DBUSTER_COMPLETE_DRIVER=1 src/buster/compiler/main.c src/buster/compiler/*_benchmark.c ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
== Test the caret display against clang
# #2376: tests/carets' command lines, each run by this compiler and by clang with carets on, as both have them by
# default; their exit statuses and diagnostics, source lines, gutters and carets among them, must be the same bytes.
"$BUSTER_COMPILER" test-carets
== Test the preprocessor's cases against clang (part 1 of 4)
# --clang also preprocesses each case with clang -E and compares the tokens. --part deals the checks (the cases,
# the header sets, the predefines' option sets in four slices, the fuzz batch's own checks and each of its modes)
# to 4 parts by their weights (pp_test_sections), one CPU each, which the runner packs beside the other commands:
# whole, on 2 CPUs, the command took 295 s on a hosted runner and 44 s on the 9700X, the list's longest. The four
# parts together run each check once. A part's fuzz workers and clang processes run on its CPU (--jobs, and
# test_process_cpus from BUSTER_PARALLEL_CPUS); the fuzz cases don't depend on --jobs. The oracle cache's clang runs, the
# fuzz batch's and the checks' own (the history's and system warnings' diagnostics, the directives' commands) go to the
# job's clang server where it built one (#2071), and with BUSTER_DRIVER_DIFFERENTIAL each also runs as before: a
# difference fails the command. A forked part stops its own server as it ends, so that its CPU time is the command's.
# The release fixture's wrapper script and the predefines' shell commands, through other programs, the location option's
# nested runs of the compiler and the guard counts (-print-stats, LLVM's counters) run their clang as before.
"$BUSTER_COMPILER" test-preprocessor --clang --jobs "$BUSTER_PARALLEL_CPUS" --part 1/4 ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
# --part's refusals, each before any check runs: no value, a part outside 1 to N, N past the checks' 128, other than
# digits on either side of one '/', and a second --part.
if "$BUSTER_COMPILER" test-preprocessor --part; then exit 1; fi
for part in '' 4 0/4 5/4 1/0 1/129 x/4 1/ /4 1/4/4 '1/ 4' 1/+4 +1/4 ' 1/4'; do
    if "$BUSTER_COMPILER" test-preprocessor --part "$part"; then exit 1; fi
done
if "$BUSTER_COMPILER" test-preprocessor --part 1/4 --part 2/4; then exit 1; fi
== Test the preprocessor's cases against clang (part 2 of 4)
"$BUSTER_COMPILER" test-preprocessor --clang --jobs "$BUSTER_PARALLEL_CPUS" --part 2/4 ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
== Test the preprocessor's cases against clang (part 3 of 4)
"$BUSTER_COMPILER" test-preprocessor --clang --jobs "$BUSTER_PARALLEL_CPUS" --part 3/4 ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
== Test the preprocessor's cases against clang (part 4 of 4)
"$BUSTER_COMPILER" test-preprocessor --clang --jobs "$BUSTER_PARALLEL_CPUS" --part 4/4 ${BUSTER_CLANG_SERVER:+--clang-server "$BUSTER_CLANG_SERVER"} ${BUSTER_DRIVER_DIFFERENTIAL:+--differential}
== Test the C lexer as C++
# The C++ and the two raw-string modes were one heading, the x86-64 MSan row's floor (959 s on the slowest CPU,
# #2658's lever 5); as three, the runner packs them apart (`costs split` gave each its share of the heading's cost).
"$BUSTER_COMPILER" test-lexer --cplusplus
== Test the C lexer with C11's raw-string prefixes
"$BUSTER_COMPILER" test-lexer --raw-strings
== Test the C lexer with the R and LR raw-string prefixes
"$BUSTER_COMPILER" test-lexer --raw-strings-c99
== Test the C lexer without digraphs and // comments, as c89
"$BUSTER_COMPILER" test-lexer --no-digraphs --no-line-comments
== Test the C lexer without digraphs, as -fno-digraphs
"$BUSTER_COMPILER" test-lexer --no-digraphs
== Test the C lexer without // comments, as C94
"$BUSTER_COMPILER" test-lexer --no-line-comments
== Test the C lexer
"$BUSTER_COMPILER" test-lexer
== Compare a frozen preprocessor corpus subset with Clang
# The runner hooks hold the shared host lock for this whole job. This copy is readable by the runner, unlike
# the original bundle under /home/david. Verify the manifests and every input/header byte first.
corpus=$BUSTER_CORPUS
export SOURCE_DATE_EPOCH=1792454400
printf '%s  %s\n' \
  391e729af6587355050881752558e790299cfe638c7dc7803bd028a8535ebcbd "$corpus/MANIFESTS.sha256" \
  8e6e646951cbd08c07bbc76ff46d6796a83a58e9b1c4959278b60193718cd10c "$corpus/manifests/headers.sha256" \
  e307b836448ef20e603a617a4b5023831c72ff5f307f614c50f4f8833088717c "$corpus/manifests/headers-bundle.sha256" \
  9179b7ad7db7366d12a214b562e478ac703e7ec0376f38f4516756bcf7ee0047 "$corpus/manifests/sqlite.sha256" \
  bf593a94954f3ed9431dd12e60233ec0229f7226a1fc270a701614a20f86baeb "$corpus/manifests/libc.sha256" \
  89dbe35f0324cf08d0cb9cf31ecf15092fc20783a9e470e80e5f41b1d48251d3 "$corpus/manifests/musl-generated.sha256" | sha256sum --check --status
(cd "$corpus/headers/usr" && sha256sum --check --status "$corpus/manifests/headers.sha256")
(cd "$corpus/headers" && sha256sum --check --status "$corpus/manifests/headers-bundle.sha256")
(cd "$corpus/sqlite" && sha256sum --check --status "$corpus/manifests/sqlite.sha256")
(cd "$corpus/libc" && sha256sum --check --status "$corpus/manifests/libc.sha256")
(cd "$corpus/musl-generated" && sha256sum --check --status "$corpus/manifests/musl-generated.sha256")
for entry in headers:headers-bundle libc:libc sqlite:sqlite musl-generated:musl-generated; do
  root="$corpus/${entry%:*}"
  manifest="$corpus/manifests/${entry#*:}.sha256"
  test "$(find "$root" -type f -printf '.\n' | wc -l)" -eq "$(wc -l < "$manifest")"
  test -z "$(find "$root" ! -type d ! -type f -print -quit)"
done
system=(-nostdinc -isystem "$corpus/headers/usr/lib/clang/23/include" -isystem "$corpus/headers/usr/local/include" -isystem "$corpus/headers/usr/include")
musl="$corpus/libc/musl"
"$BUSTER_COMPILER" test-preprocessor --compare-clang --clang clang -march=znver5 "${system[@]}" "$corpus/sqlite/sqlite3.c" --report build/oracle-sqlite.tsv
awk -F '\t' 'NR > 1 { counts[$1]++ } END { exit !(counts["identical"] == 1 && NR == 2) }' build/oracle-sqlite.tsv
"$BUSTER_COMPILER" test-preprocessor --compare-clang --clang clang -march=znver5 "${system[@]}" --files-from tests/preprocessor-oracle/libc-subset.txt --root "$corpus/libc" --report build/oracle-libc.tsv
awk -F '\t' 'NR > 1 { counts[$1]++ } END { exit !(counts["identical"] == 5 && counts["skipped"] == 2 && NR == 8) }' build/oracle-libc.tsv
"$BUSTER_COMPILER" test-preprocessor --compare-clang --clang clang -march=znver5 -std=c99 -ffreestanding -nostdinc -D_XOPEN_SOURCE=700 -Os -pipe \
  -I "$musl/arch/x86_64" -I "$musl/arch/generic" -I "$corpus/musl-generated/obj/src/internal" -I "$musl/src/include" -I "$musl/src/internal" -I "$corpus/musl-generated/obj/include" -I "$musl/include" \
  --files-from tests/preprocessor-oracle/musl-subset.txt --root "$musl" --report build/oracle-musl.tsv
awk -F '\t' 'NR > 1 { counts[$1]++ } END { exit !(counts["identical"] == 4 && NR == 5) }' build/oracle-musl.tsv
== Test the independent preprocessor fuzz harness in C23
"$BUSTER_COMPILER" test-preprocessor-fuzz --std c23
== Test the independent preprocessor fuzz harness in C17
"$BUSTER_COMPILER" test-preprocessor-fuzz --std c17
== Test the preprocessor directive tables
"$BUSTER_COMPILER" test-preprocessor --tables src
